01528jsd","name":"deploy","comment":null,"parentId":null,"content":[],"pathElements":["record-and-playback"],"extension":"sh","language":"SHELL","importedModuleNames":[]},"acm000001529jsd":{"type":"CodeCompilationUnit","id":"acm000001529jsd","name":"notes-playback","comment":null,"parentId":null,"content":[],"pathElements":["record-and-playback","notes","scripts"],"extension":"nginx","language":"SHELL","importedModuleNames":[]},"acm000001531jsd":{"type":"ControlElement","id":"acm000001531jsd","name":"file","comment":"Check if our SSL root Certificate Authority key and certificate are available, create them if not","startLine":163,"endLine":165,"calleeNames":["open","join","read"]},"acm000001532jsd":{"type":"ControlElement","id":"acm000001532jsd","name":"master_gateway","comment":"A NAT gateway between our public \"Internet\" and the actual Internet\n\nBBB's default STUN server is stun.l.google.com:19302, so we run\ncoturn and configure the master gateway to mimic it.\n\nIt also operates an ACME server and mimics acme-v02.api.letsencrypt.org,\nso our test servers can run certbot to get their SSL certificates.\nUse the first host address on the subnet for our master gateway\nThe rest of them will be available for assignment with DHCP","startLine":273,"endLine":497,"calleeNames":["isinstance","TypeError","list","hosts","str","file","dumps","ubuntu_node"]},"acm000001533jsd":{"type":"ControlElement","id":"acm000001533jsd","name":"initialization_server","comment":"Use dhcp-identifier: mac because I'm still having problems with\ncloned GNS3 ubuntu nodes using the same client identifiers; it's\na cloud-init issue.","startLine":508,"endLine":526,"calleeNames":["ubuntu_node"]},"acm000001534jsd":{"type":"ControlElement","id":"acm000001534jsd","name":"turn_server","comment":"Use dhcp-identifier: mac because I'm still having problems with\ncloned GNS3 ubuntu nodes using the same client identifiers; it's\na cloud-init issue.","startLine":530,"endLine":577,"calleeNames":["append","ubuntu_node"]},"acm000001535jsd":{"type":"ControlElement","id":"acm000001535jsd","name":"BBB_client","comment":"Use dhcp-identifier: mac because I'm still having problems with\ncloned GNS3 ubuntu nodes using the same client identifiers; it's\na cloud-init issue.","startLine":581,"endLine":642,"calleeNames":["file","append","check_output","strip","decode","split","ubuntu_node"]},"acm000001536jsd":{"type":"ControlElement","id":"acm000001536jsd","name":"client_NAT_gateway","comment":"","startLine":648,"endLine":737,"calleeNames":["ip_interface","list","hosts","str","ubuntu_node"]},"acm000001537jsd":{"type":"ControlElement","id":"acm000001537jsd","name":"server_NAT_gateway","comment":"","startLine":746,"endLine":859,"calleeNames":["endswith","isinstance","TypeError","list","hosts","str","ubuntu_node"]},"acm000001538jsd":{"type":"ControlElement","id":"acm000001538jsd","name":"BBB_server_standalone","comment":"A BigBlueButton server without an associated NAT gateway","startLine":863,"endLine":964,"calleeNames":["print","exit","startswith","get","raise_for_status","file","append","head","join","ubuntu_node"]},"acm000001539jsd":{"type":"ControlElement","id":"acm000001539jsd","name":"BBB_server","comment":"","startLine":968,"endLine":989,"calleeNames":["BBB_server_standalone","link","depends_on","node_names","switch","server_NAT_gateway"]},"acm000001540jsd":{"type":"CodeCompilationUnit","id":"acm000001540jsd","name":"gns3-bbb","comment":"!/usr/bin/python3\n\nScript to setup a GNS3 project for testing BigBlueButton.\n\nThe project will be centered around a dummy public subnet with both\nthe bare metal system and most virtual nodes connected to it using\nvirtual NAT gateways. Servers can be created with the --no-nat\nswitch to connect them directly to the dummy public subnet.\n\n\"stun.l.google.com\" is mimicked with a fake DNS entry so that\nBigBlueButton servers see the dummy public subnet as their public IP\naddress.\n\nsmallstep.com's step-ca server is used to run an ACME Certificate\nAuthority in a manner compatible with certbot, allowing bbb-install\nto run certbot normally. The CA's root certificate and key are\nexpected to be in the script's directory and are created (using\nopenssl) if they don't exist. The root certificate is then\ninstalled and trusted on all Ubuntu nodes created by this script.\n\nAll the Ubuntu nodes will be configured to accept the user's public\nssh key and entire authorized_keys file for ssh access.\n\nBigBlueButton servers with NAT gateways will be configured to forward\nport 22 to the server, while the NAT gateway listens for ssh\non port 2222.\n\nThe NAT gateway between the bare metal machine and the dummy public\nsubnet is given the same name (for ssh access) as the GNS3 project\n(default \"BigBlueButton\"). This node also operates the step-ca and\nstun.l.google.com servers.\n\nThe first time the script is run, the required infrastructure nodes\nare created. The --public-subnet switch can be specified at this\ntime, and the public subnet's CIDR prefix will also be saved.\n\nIf the machine running the script is configured to use an APT http\nproxy, that proxy will also be used by the created nodes.\n\nThe gns3 library provides \"declarative\" functions that only create\nnodes if they don't already exist, and we use this feature\nthroughout the script. Running the script on a pre-built network\nshould change nothing. A single node can be rebuilt by deleting it\nand rerunning the script.\nRUNTIME DEPENDENCIES\n\ngenisoimage must be installed\nopenssl must be installed\n\nUSAGE\n\n./gns3-bbb.py focal-260 (to install a released server)\n./gns3-bbb.py focal-e41349 (to install a server based on a git commit)\n./gns3-bbb.py testclient (to install a test client)\n\nBy default, the GNS3 project is called \"BigBlueButton\". If the\nproject infrastructure (switches and NAT gateways) doesn't exist, it\nwill be created.\n\nThe '-d' option deletes a single server and its associated subnet and NAT nodes.\n\nThe '--delete-everything' switch deletes EVERYTHING in an existing project.\n\nSee the comments in NPDC/GNS3/gns3.py for more options and how\nauthentication is done.\n\nWe use an Ubuntu cloud image and a client image created using the\nGNS3/ubuntu.py script in BrentBaccala's NPDC github repository.","parentId":"acm000001541jsd","content":["acm000001531jsd","acm000001532jsd","acm000001533jsd","acm000001534jsd","acm000001535jsd","acm000001536jsd","acm000001537jsd","acm000001538jsd","acm000001539jsd"],"pathElements":["bigbluebutton-tests","gns3"],"extension":"py","language":"PYTHON3","importedModuleNames":["NPDC.GNS3.gns3","sys","os","json","ipaddress","requests","argparse","subprocess"]},"acm000001541jsd":{"type":"CodePackage","id":"acm000001541jsd","name":"gns3","comment":"","parentId":"acm000001542jsd","content":["acm000001540jsd"]},"acm000001542jsd":{"type":"CodePackage","id":"acm000001542jsd","name":"bigbluebutton-tests","comment":"","parentId":null,"content":["acm000001541jsd"]},"acm000001544jsd":{"type":"CodeCompilationUnit","id":"acm000001544jsd","name":"Bezier","comment":null,"parentId":"acm000001549jsd","content":["acm000001586jsd"],"pathElements":["akka-bbb-apps","src","main","scala","org","bigbluebutton","core","util","jhotdraw"],"extension":"java","language":"JAVA","importedModuleNames":["java.awt.geom","java.util"]},"acm000001545jsd":{"type":"CodePackage","id":"acm000001545jsd","name":"org","comment":null,"parentId":null,"content":["acm000001546jsd","acm000005864jsd"]},"acm000001546jsd":{"type":"CodePackage","id":"acm000001546jsd","name":"bigbluebutton","comment":null,"parentId":"acm000001545jsd","content":["acm000006306jsd","acm000006322jsd","acm000006331jsd","acm000006339jsd","acm000006344jsd","acm000001547jsd","acm000001778jsd","acm000001783jsd","acm000002412jsd","acm000002544jsd","acm000004834jsd","acm000004957jsd","acm000004975jsd","acm000005681jsd","acm000006355jsd"]},"acm000001547jsd":{"type":"CodePackage","id":"acm000001547jsd","name":"core","comment":nu