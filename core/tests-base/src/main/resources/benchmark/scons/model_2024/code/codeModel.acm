"]},"acm000001704jsd":{"type":"ControlElement","id":"acm000001704jsd","name":"__init__","comment":"","startLine":61,"endLine":63,"calleeNames":["update"]},"acm000001705jsd":{"type":"ClassUnit","id":"acm000001705jsd","name":"PlatformSDK","comment":"A subclass for trying to find installed Platform SDK directories.","compilationUnitId":"acm000001712jsd","parentDatatypeId":null,"startLine":136,"endLine":143,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001704jsd"]},"acm000001706jsd":{"type":"ControlElement","id":"acm000001706jsd","name":"get_installed_sdks","comment":"We may be asked to update multiple construction environments with\nSDK information. When doing this, we check on-disk for whether\nthe SDK has 'mfc' and 'atl' subdirectories. Since going to disk\nis expensive, cache results by directory.","startLine":285,"endLine":298,"calleeNames":["debug","get_sdk_dir","append"]},"acm000001707jsd":{"type":"ControlElement","id":"acm000001707jsd","name":"set_sdk_by_directory","comment":"","startLine":308,"endLine":332,"calleeNames":["debug","join","exists","append","PrependENVPath"]},"acm000001708jsd":{"type":"ControlElement","id":"acm000001708jsd","name":"get_sdk_by_version","comment":"","startLine":334,"endLine":338,"calleeNames":["UserError","get_installed_sdks","get"]},"acm000001709jsd":{"type":"ControlElement","id":"acm000001709jsd","name":"get_default_sdk","comment":"Set up the default Platform/Windows SDK.","startLine":340,"endLine":345,"calleeNames":["get_installed_sdks"]},"acm000001710jsd":{"type":"ControlElement","id":"acm000001710jsd","name":"mssdk_setup_env","comment":"print \"No MSVS_VERSION: this is likely to be a bug\"","startLine":347,"endLine":398,"calleeNames":["debug","subst","UserError","get_sdk_by_version","get_sdk_dir","get_vs_by_version","get_default_sdk","set_sdk_by_directory"]},"acm000001711jsd":{"type":"ControlElement","id":"acm000001711jsd","name":"mssdk_exists","comment":"","startLine":402,"endLine":406,"calleeNames":["get_installed_sdks","len"]},"acm000001712jsd":{"type":"CodeCompilationUnit","id":"acm000001712jsd","name":"sdk","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nMS Compilers: detect the Platform/Windows SDK PSDK 2003 R1 is the earliest version detected.\nSDK Checks. This is of course a mess as everything else on MS platforms. Here\nis what we do to detect the SDK:\n\nFor Windows SDK >= 6.0: just look into the registry entries:\nHKLM\\Software\\Microsoft\\Microsoft SDKs\\Windows\nAll the keys in there are the available versions.\n\nFor Platform SDK before 6.0 (2003 server R1 and R2, etc...), there does not\nseem to be any sane registry key, so the precise location is hardcoded.\n\nFor versions below 2003R1, it seems the PSDK is included with Visual Studio?\nVC++ Professional comes with the SDK, VC++ Express does not.\n\nOf course, all this changed again after Express was phased out (2005).\nLocation of the SDK (checked for 6.1 only)","parentId":"acm000001835jsd","content":["acm000001701jsd","acm000001703jsd","acm000001705jsd","acm000001706jsd","acm000001707jsd","acm000001708jsd","acm000001709jsd","acm000001710jsd","acm000001711jsd"],"pathElements":["Tool","MSCommon"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","SCons.Errors","SCons.Util","common.debug","common.read_reg"]},"acm000001713jsd":{"type":"ClassUnit","id":"acm000001713jsd","name":"MSVCUnsupportedHostArch","comment":"","compilationUnitId":"acm000001768jsd","parentDatatypeId":null,"startLine":75,"endLine":76,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001714jsd":{"type":"ClassUnit","id":"acm000001714jsd","name":"MSVCUnsupportedTargetArch","comment":"","compilationUnitId":"acm000001768jsd","parentDatatypeId":null,"startLine":78,"endLine":79,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001715jsd":{"type":"ClassUnit","id":"acm000001715jsd","name":"MSVCScriptNotFound","comment":"","compilationUnitId":"acm000001768jsd","parentDatatypeId":null,"startLine":81,"endLine":82,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001716jsd":{"type":"ClassUnit","id":"acm000001716jsd","name":"MSVCUseSettingsError","comment":"internal exceptions","compilationUnitId":"acm000001768jsd","parentDatatypeId":null,"startLine":84,"endLine":85,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001717jsd":{"type":"ClassUnit","id":"acm000001717jsd","name":"UnsupportedVersion","comment":"","compilationUnitId":"acm000001768jsd","parentDatatypeId":null,"startLine":89,"endLine":90,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001718jsd":{"type":"ClassUnit","id":"acm000001718jsd","name":"BatchFileExecutionError","comment":"undefined object for dic