OLLAMA_HOST=http://localhost:11434
OLLAMA_USER=
OLLAMA_PASSWORD=
OLLAMA_TOKEN=
OPENAI_ORGANIZATION_ID=
OPENAI_API_KEY=
SEED=

# Stanford CoreNLP Microservice
MICROSERVICE_URL=
NLP_PROVIDER_SOURCE=
SCNLP_SERVICE_USER=
SCNLP_SERVICE_PASSWORD=

# Customizations
# Directory of the LLM and embedding caches (default: .cache-llm/)
LLM_CACHE_DIR=
OPENAI_MODEL_NAME=
OLLAMA_MODEL_NAME=
MODEL_NAME_NER=

# NEO4J CONFIGURATION
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Toggle persistence: true, false
NEO4J_ENABLED=true
# LLM cache backends (llm-access); see https://github.com/ArDoCo/llm-access#caching
# Comma-separated cache types, primary first: LOCAL, REDIS, REST_REDIS (default: LOCAL)
#CACHE_HIERARCHY=LOCAL
# Conflicts between cache layers: NONE, ERROR, OVERWRITE (default: NONE)
#CACHE_REPLACEMENT_STRATEGY=NONE
#REDIS_URL=redis://localhost:6379
#REST_REDIS_URI=http://localhost:8080
#REST_REDIS_USERNAME=
#REST_REDIS_PASSWORD=
