sage*initMessage,PdGraph*graph)","comment":"","startLine":32,"endLine":35,"calleeNames":[]},"acm000001993jsd":{"type":"ControlElement","id":"acm000001993jsd","name":"::~DspAdd()","comment":"nothing to do","startLine":37,"endLine":39,"calleeNames":[]},"acm000001994jsd":{"type":"ControlElement","id":"acm000001994jsd","name":"DspAdd::onInletConnectionUpdate(unsignedintinletIndex)","comment":"","startLine":41,"endLine":44,"calleeNames":[]},"acm000001995jsd":{"type":"ControlElement","id":"acm000001995jsd","name":"DspAdd::toString()","comment":"","startLine":46,"endLine":51,"calleeNames":[]},"acm000001996jsd":{"type":"ControlElement","id":"acm000001996jsd","name":"DspAdd::processMessage(intinletIndex,PdMessage*message)","comment":"","startLine":53,"endLine":57,"calleeNames":[]},"acm000001997jsd":{"type":"ControlElement","id":"acm000001997jsd","name":"DspAdd::processSignal(DspObject*dspObject,intfromIndex,inttoIndex)","comment":"","startLine":59,"endLine":63,"calleeNames":[]},"acm000001998jsd":{"type":"ControlElement","id":"acm000001998jsd","name":"DspAdd::processScalar(DspObject*dspObject,intfromIndex,inttoIndex)","comment":"","startLine":65,"endLine":69,"calleeNames":[]},"acm000001999jsd":{"type":"CodeAssembly","id":"acm000001999jsd","name":"DspAdd","comment":null,"parentId":null,"content":["acm000001991jsd","acm000001992jsd","acm000001993jsd","acm000001994jsd","acm000001995jsd","acm000001996jsd","acm000001997jsd","acm000001998jsd"],"language":"CPP","importedModuleNames":[]},"acm000002000jsd":{"type":"ControlElement","id":"acm000002000jsd","name":"*DspBandpassFilter::newObject(PdMessage*initMessage,PdGraph*graph)","comment":"Copyright 2009,2010,2011,2012 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License,