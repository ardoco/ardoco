acm000002059jsd","name":"DspDivide","comment":null,"parentId":null,"content":["acm000002051jsd","acm000002052jsd","acm000002053jsd","acm000002054jsd","acm000002055jsd","acm000002056jsd","acm000002057jsd","acm000002058jsd"],"language":"CPP","importedModuleNames":[]},"acm000002060jsd":{"type":"ControlElement","id":"acm000002060jsd","name":"*DspEnvelope::newObject(PdMessage*initMessage,PdGraph*graph)","comment":"Copyright 2009,2010,2011 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nBy default, the analysis window size is 1024 samples.","startLine":30,"endLine":32,"calleeNames":[]},"acm000002061jsd":{"type":"ControlElement","id":"acm000002061jsd","name":"::DspEnvelope(PdMessage*initMessage,PdGraph*graph)","comment":"","startLine":34,"endLine":70,"calleeNames":[]},"acm000002062jsd":{"type":"ControlElement","id":"acm000002062jsd","name":"::~DspEnvelope()","comment":"if two parameters are provided, set the window size and window interval\nif one parameter is provided, set the window size\notherwise, use default values for the window size and interval\nNOTE(mhroth): I haven't thought very much if this fix could be better done. The issue is that\nif the blocksize is large (e.g., larger than the windowInterval), then env~ will never send\na message. With more logic, a block size larger than the window size could be accomodated. But\nI am too lazy to consider this option at the moment. Thus, currently the window size and interval\nmust be at least as large as the block size.","startLine":72,"endLine":75,"calleeNames":[]},"acm000002063jsd":{"type":"ControlElement","id":"acm000002063jsd","name":"DspEnvelope::toString()","comment":"","startLine":77,"endLine":81,"calleeNames":[]},"acm000002064jsd":{"type":"ControlElement","id":"acm000002064jsd","name":"DspEnvelope::setWindowInterval(intnewInterval)","comment":"","startLine":83,"endLine":95,"calleeNames":[]},"acm000002065jsd":{"type":"ControlElement","id":"acm000002065jsd","name":"DspEnvelope::initBuffers()","comment":"windowInterval is a multiple of blockSize. Awesome :)\nwindowInterval is closer to the smaller multiple of blockSize\nwindowInterval is closer to the larger multiple of blockSize\nensure that the buffer is big enough to take the number of whole blocks needed to fill it","startLine":97,"endLine":116,"calleeNames":[]},"acm000002066jsd":{"type":"ControlElement","id":"acm000002066jsd","name":"DspEnvelope::processSignal(DspObject*dspObject,intfromIndex,inttoIndex)","comment":"calcualte the hanning window coefficients\nnormalise the hanning coefficients such that they represent a normalised weighted averaging\nwindowSize and windowInterval are constrained to be multiples of the block size","startLine":119,"endLine":153,"calleeNames":[]},"acm000002067jsd":{"type":"CodeAssembly","id":"acm000002067jsd","name":"DspEnvelope","comment":null,"parentId":null,"content":["acm000002060jsd","acm000002061jsd","acm000002062jsd","acm000002063jsd","acm000002064jsd","acm000002065jsd","acm000002066jsd"],"language":"CPP","importedModuleNames":[]},"acm000002068jsd":{"type":"ControlElement","id":"acm000002068jsd","name":"::DspFilter(intnumMessageInlets,PdGraph*graph)","comment":"Copyright 2011,2012 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  Z