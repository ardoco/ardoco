et_pdir_vswhere_queries","comment":"","startLine":1255,"endLine":1258,"calleeNames":["debug"]},"acm000001742jsd":{"type":"ControlElement","id":"acm000001742jsd","name":"find_vc_pdir_vswhere","comment":"Find the MSVC product directory using the vswhere program. Args: msvc_version: MSVC version to search for env: optional to look up VSWHERE variable Returns: MSVC install dir or None Raises: UnsupportedVersion: if the version is not known by this file","startLine":1263,"endLine":1334,"calleeNames":["_vswhere_update_msvc_map","get","debug","repr","UnsupportedVersion","msvc_version_pdir_vswhere_kind","append","msvc_version_register_kind"]},"acm000001743jsd":{"type":"ControlElement","id":"acm000001743jsd","name":"find_vc_pdir_registry","comment":"Find the MSVC product directory using the registry. Args: msvc_version: MSVC version to search for Returns: MSVC install dir or None Raises: UnsupportedVersion: if the version is not known by this file","startLine":1338,"endLine":1437,"calleeNames":["get","debug","repr","UnsupportedVersion","is_win64","read_reg","lower","endswith","join","exists","msvc_version_pdir_registry_kind","append","msvc_version_register_kind"]},"acm000001744jsd":{"type":"ControlElement","id":"acm000001744jsd","name":"find_vc_pdir","comment":"Find the MSVC product directory for the given version. Use find_vc_pdir_vsvwhere for msvc versions 14.1 and later. Use find_vc_pdir_registry for msvc versions 14.0 and earlier. Args: msvc_version: str msvc version (major.minor, e.g. 10.0) env: optional to look up VSWHERE variable Returns: str: Path found in registry, or None Raises: UnsupportedVersion: if the version is not known by this file. UnsupportedVersion inherits from VisualCException.\nregister find_vc_pdir function with Kind routines\nin case of unknown msvc_version (just in case)","startLine":1439,"endLine":1481,"calleeNames":["find_vc_pdir_vswhere","debug","repr","find_vc_pdir_registry","UnsupportedVersion"]},"acm000001745jsd":{"type":"ControlElement","id":"acm000001745jsd","name":"_reset_vc_pdir","comment":"","startLine":1487,"endLine":1494,"calleeNames":["debug"]},"acm000001746jsd":{"type":"ControlElement","id":"acm000001746jsd","name":"find_batch_file","comment":"Find the location of the batch script which should set up the compiler for any TARGET_ARCH whose compilers were installed by Visual Studio/VCExpress In newer (2017+) compilers, make use of the fact there are vcvars scripts named with a host_target pair that calls vcvarsall.bat properly, so use that and return an empty argument.\nfilter out e.g. \"Exp\" from the version name","startLine":1496,"endLine":1568,"calleeNames":["float","get_msvc_version_numeric","int","join","msvc_version_is_vcforpython","exists","debug"]},"acm000001747jsd":{"type":"ControlElement","id":"acm000001747jsd","name":"find_batch_file_sdk","comment":"Find the location of the sdk batch script which should set up the compiler for any TARGET_ARCH whose compilers were installed by Visual Studio/VCExpress","startLine":1570,"endLine":1587,"calleeNames":["get_installed_sdks","get_sdk_vc_script","debug","join","exists"]},"acm000001748jsd":{"type":"ControlElement","id":"acm000001748jsd","name":"_reset_installed_vcs","comment":"","startLine":1591,"endLine":1594,"calleeNames":["debug"]},"acm000001749jsd":{"type":"ControlElement","id":"acm000001749jsd","name":"_check_files_exist_in_vc_dir","comment":"Return status of finding batch file and cl.exe to use. Locates required vcvars batch files and cl in the vc_dir depending on TARGET_ARCH, HOST_ARCH and the msvc version. TARGET_ARCH and HOST_ARCH can be extracted from the passed env, unless the env is None, in which case the native platform is assumed for the host and all associated targets. Args: env: Environment a construction environment, usually if this is passed its because there is a desired TARGET_ARCH to be used when searching for a cl.exe vc_dir: str the path to the VC dir in the MSVC installation msvc_version: str msvc version (major.minor, e.g. 10.0) Returns: bool:\nFind the host, target, and all candidate (host, target) platform combinations:","startLine":1602,"endLine":1758,"calleeNames":["get_host_target","debug","float","get_msvc_version_numeric","int","join","open","readlines","strip","get","exists","msvc_version_is_vcforpython","walk","str"]},"acm000001750jsd":{"type":"ControlElement","id":"acm000001750jsd","name":"get_installed_vcs","comment":"the installed vcs cache is cleared if new vc roots are discovered","startLine":1760,"endLine":1804,"calleeNames":["debug","_vswhere_update_msvc_map","get","find_vc_pdir","_check_files_exist_in_vc_dir","append","str"]},"acm000001751jsd":{"type":"ControlElement","id":"acm000001751jsd","name":"reset_installed_vcs","comment":"Make it try again to find VC. This is just for the tests.","startLine":1806,"endLine":1811,"calleeNames":["_reset_installed_vcs","_reset_vc_pdir","reset","_reset"]},"acm000001752jsd":{"type":"ControlElement","id":"acm000001752jsd","name":"msvc_default_version","comment":"Get default msvc version.","startLine":1813,"endLine":1818,"calleeNames":["get_installed_vcs","debug","repr"]},"acm000001753jsd":{"type":"ControlElement","id":"acm000001753jsd","name":"get_installed_vcs_components","comment":"Test suite convenience function: return list of installed msvc version component tuples","startLine":1820,"endLine":1824,"calleeNames":["get_installed_vcs","msvc_version_components"]},"acm000001754jsd":{"type":"ControlElement","id":"acm000001754jsd","name":"_check_cl_exists_in_script_env","comment":"Find cl.exe in the script environment path.","startLine":1826,"endLine":1837,"calleeNames":["join","exists","debug"]},"acm000001755jsd":{"type":"ControlElement","id":"acm000001755jsd","name":"script_env","comment":"","startLine":1859,"endLine":1918,"calleeNames":["read_script_env_cache","get","Path","exists","_skip_sendtelemetry","get_output","parse_output","splitlines","match","append","join","_check_cl_exists_in_script_env","debug","repr","msvc_scripterror_handler","BatchFileExecutionError","write_script_env_cache"]},"acm000001756jsd":{"type":"ControlElement","id":"acm000001756jsd","name":"get_default_version","comment":"","startLine":1920,"endLine":1950,"calleeNames":["get","debug","warn","msvc_default_version","repr"]},"acm000001757jsd":{"type":"ControlElement","id":"acm000001757jsd","name":"msvc_setup_env_once","comment":"","startLine":1952,"endLine":1968,"calleeNames":["register_setup","msvc_setup_env","register_iserror","format","msvc_notfound_handler"]},"acm000001758jsd":{"type":"ControlElement","id":"acm000001758jsd","name":"msvc_find_valid_batch_script","comment":"Find and execute appropriate batch script to set up build env. The MSVC build environment depends heavily on having the shell environment set. SCons does not inherit that, and does not count on that being set up correctly anyway, so it tries to find the right MSVC batch script, or the right arguments to the generic batch script vcvarsall.bat, and run that, so we have a valid environment to build in. There are dragons here: the batch scripts don't fail (see comments elsewhere), they just leave you with a bad setup, so try hard to get it right.\nFind the product directory","startLine":1970,"endLine":2106,"calleeNames":["find_vc_pdir","debug","get_host_target","find_batch_file","str","append","msvc_script_arguments_has_uwp","msvc_version_skip_uwp_target","repr","msvc_script_arguments","script_env","_check_cl_exists_in_script_env","find_batch_file_sdk","format","get_installed_vcs","msvc_notfound_handler"]},"acm000001759jsd":{"type":"ControlElement","id":"acm000001759jsd","name":"get_use_script_use_settings","comment":"use_script use_settings return values action\nvalue ignored (value, None) use script or bypass detection\nundefined value not None (False, value) use dictionary\nundefined undefined/None (True, None) msvc detection\nNone (documentation) or evaluates False (code): bypass detection\nneed to distinguish between undefined and None","startLine":2108,"endLine":2131,"calleeNames":["get"]},"acm000001760jsd":{"type":"ControlElement","id":"acm000001760jsd","name":"msvc_setup_env","comment":"","startLine":2133,"endLine":2197,"calleeNames":["debug","get_default_version","msvc_setup_env_user","set_nodefault","get_use_script_use_settings","is_String","strip","exists","MSVCScriptNotFound","subst","repr","script_env","msvc_find_valid_batch_script","is_Dict","MSVCUseSettingsError","warn","items","WhereIs","get","PrependENVPath"]},"acm000001761jsd":{"type":"ControlElement","id":"acm000001761jsd","name":"msvc_exists","comment":"","startLine":2199,"endLine":2206,"calleeNames":["get_installed_vcs","len","debug","repr"]},"acm000001762jsd":{"type":"ControlElement","id":"acm000001762jsd","name":"msvc_setup_env_user","comment":"","startLine":2208,"endLine":2240,"calleeNames":["debug","repr","is_String"]},"acm000001763jsd":{"type":"ControlElement","id":"acm000001763jsd","name":"msvc_setup_env_tool","comment":"","startLine":2242,"endLine":2249,"calleeNames":["register_tool","msvc_exists","msvc_setup_env_user"]},"acm000001764jsd":{"type":"ControlElement","id":"acm000001764jsd","name":"msvc_sdk_versions","comment":"","startLine":2251,"endLine":2269,"calleeNames":["debug","repr","msvc_default_version","msvc_extended_version_components","MSVCArgumentError","get_msvc_sdk_version_list"]},"acm000001765jsd":{"type":"ControlElement","id":"acm000001765jsd","name":"msvc_toolset_versions","comment":"","startLine":2271,"endLine":2293,"calleeNames":["debug","repr","msvc_default_version","MSVCArgumentError","find_vc_pdir","_msvc_toolset_versions_internal"]},"acm000001766jsd":{"type":"ControlElement","id":"acm000001766jsd","name":"msvc_toolset_versions_spectre","comment":"","startLine":2295,"endLine":2317,"calleeNames":["debug","repr","msvc_default_version","MSVCArgumentError","find_vc_pdir","_msvc_toolset_versions_spectre_internal"]},"acm000001767jsd":{"type":"ControlElement","id":"acm000001767jsd","name":"msvc_query_version_toolset","comment":"Returns an msvc version and a toolset version given a version specification. This is an EXPERIMENTAL proxy for using a toolset version to perform msvc instance selection. This function will be removed when toolset version is taken into account during msvc instance selection. Search for an installed Visual Studio instance that supports the specified version. When the specified version contains a component suffix (e.g., Exp), the msvc version is returned and the toolset version is None. No search if performed. When the specified version does not contain a component suffix, the version is treated as a toolset version specification. A search is performed for the first msvc instance that contains the toolset version. Only Visual Studio 2017 and later support toolset arguments. For Visual Studio 2015 and earlier, the msvc version is returned and the toolset version is None. Args: version: str The version specification may be an msvc version or a toolset version. prefer_newest: bool True: prefer newer Visual Studio instances. False: prefer the \"native\" Visual Studio instance first. If the native Visual Studio instance is not detected, prefer newer Visual Studio instances. Returns: tuple: A tuple containing the msvc version and the msvc toolset version. The msvc toolset version may be None. Raises: MSVCToolsetVersionNotFound: when the specified version is not found. MSVCArgumentError: when argument validation fails.","startLine":2319,"endLine":2469,"calleeNames":["debug","repr","msvc_default_version","msvc_extended_version_components","MSVCArgumentError","startswith","format","set","add","find_vc_pdir","_msvc_toolset_internal","msvc_notfound_handler","MSVCToolsetVersionNotFound"]},"acm000001768jsd":{"type":"CodeCompilationUnit","id":"acm000001768jsd","name":"vc","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nMS Compilers: Visual C/C++ detection and configuration. # TODO: # * supported arch for versions: for old versions of batch file without # argument, giving bogus argument cannot be detected, so we have to hardcode # this here # * print warning when msvc version specified but not found # * find out why warning do not print # * test on 64 bits XP + VS 2005 (and VS 6 if possible) # * SDK # * Assembly\nexternal exceptions","parentId":"acm000001835jsd","content":["acm000001713jsd","acm000001714jsd","acm000001715jsd","acm000001716jsd","acm000001717jsd","acm000001718jsd","acm000001723jsd","acm000001724jsd","acm000001725jsd","acm000001726jsd","acm000001727jsd","acm000001728jsd","acm000001729jsd","acm000001730jsd","acm000001731jsd","acm000001732jsd","acm000001733jsd","acm000001734jsd","acm000001735jsd","acm000001736jsd","acm000001737jsd","acm000001738jsd","acm000001739jsd","acm000001740jsd","acm000001741jsd","acm000001742jsd","acm000001743jsd","acm000001744jsd","acm000001745jsd","acm000001746jsd","acm000001747jsd","acm000001748jsd","acm000001749jsd","acm000001750jsd","acm000001751jsd","acm0000