date","close"]},"acm000002471jsd":{"type":"ControlElement","id":"acm000002471jsd","name":"PrintSolution","comment":"Writes a solution file\nVisual Studio 2022 is considered to be version 17.\nVisual Studio 2019 is considered to be version 16.\nVisual Studio 2015 and 2017 are both considered to be version 15.","startLine":1609,"endLine":1732,"calleeNames":["write","splitext","len","get","replace","relpath","locals","index","sorted","keys","dumps","b64encode","decode"]},"acm000002472jsd":{"type":"ControlElement","id":"acm000002472jsd","name":"Build","comment":"","startLine":265,"endLine":276,"calleeNames":["open","InternalError","str","UserHeader","UserProject","close"]},"acm000002473jsd":{"type":"ClassUnit","id":"acm000002473jsd","name":"_GenerateV7DSW","comment":"Generates a Solution file for MSVS .NET","compilationUnitId":"acm000002495jsd","parentDatatypeId":null,"startLine":1494,"endLine":1741,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002469jsd","acm000002470jsd","acm000002471jsd","acm000002472jsd"]},"acm000002474jsd":{"type":"ControlElement","id":"acm000002474jsd","name":"PrintWorkspace","comment":"writes a DSW file","startLine":1777,"endLine":1781,"calleeNames":["relpath","write","locals"]},"acm000002475jsd":{"type":"ControlElement","id":"acm000002475jsd","name":"Build","comment":"","startLine":265,"endLine":276,"calleeNames":["open","InternalError","str","UserHeader","UserProject","close"]},"acm000002476jsd":{"type":"ClassUnit","id":"acm000002476jsd","name":"_GenerateV6DSW","comment":"Generates a Workspace file for MSVS 6.0","compilationUnitId":"acm000002495jsd","parentDatatypeId":null,"startLine":1774,"endLine":1790,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002474jsd","acm000002475jsd"]},"acm000002477jsd":{"type":"ControlElement","id":"acm000002477jsd","name":"xmlify","comment":"do this first","startLine":60,"endLine":67,"calleeNames":["replace"]},"acm000002478jsd":{"type":"ControlElement","id":"acm000002478jsd","name":"processIncludes","comment":"Process a CPPPATH list in includes, given the env, target and source. Returns a list of directory paths. These paths are absolute so we avoid putting pound-prefixed paths in a Visual Studio project file.\nWork-in-progress\nindividual elements each get a globally unique identifier.\nhowever, there also are some \"well known\" guids that either\nrepresent something, or are used as a namespace to base\ngenerating guids that should be \"in\" the namespace\nNAMESPACE_PROJECT = uuid.UUID(\"{D9BD5916-F055-4D77-8C69-9448E02BF433}\")\nNAMESPACE_SLN_GROUP = uuid.UUID(\"{2D0C29E0-512F-47BE-9AC4-F4CAE74AE16E}\")\nNAMESPACE_INTERNAL = uuid.UUID(\"{BAA4019E-6D67-4EF1-B3CB-AE6CD82E4060}\")\nKinds of projects, as used in solution files\nPROJECT_KIND_C = \"{8BC9CEB8-8B4A-11D0-8D11-00A0C91BC942}\"\nPROJECT_KIND_PCL = \"{786C830F-07A1-408B-BD7F-6EE04809D6DB}\"\nNAMESPACE_PRJ_FOLDER = \"{66A26720-8FB5-11D2-AA7E-00C04F688DDE}\"\nNAMESPACE_SLN_FOLDER = \"{2150E333-8FDC-42A3-9474-1A3956D46DE8}\"\nNAMESPACE_TEST = \"{3AC096D0-A1C2-E12C-1390-A8335801FDAB}\"","startLine":70,"endLine":77,"calleeNames":["Dir","PathList","subst_path"]},"acm000002479jsd":{"type":"ControlElement","id":"acm000002479jsd","name":"processFlags","comment":"If /std:c++XX is in flags then we need to ensure /Zc:__cplusplus is in flags to tell intellisense to respect our specified standard","startLine":95,"endLine":103,"calleeNames":["any","startswith","append","subst"]},"acm000002480jsd":{"type":"ControlElement","id":"acm000002480jsd","name":"_generateGUID","comment":"Generates a GUID for the sln file to use. The uuid5 function is used to combine an existing namespace uuid - the one VS uses for C projects (external_makedile_guid) - and a combination of the solution file name (slnfile) and the project name (name). We just need uniqueness/repeatability. Returns (str) \"displayable\" GUID, already wrapped in braces\nNormalize the slnfile path to a Windows path (\\ separators) so\nthe generated file has a consistent GUID even if we generate\nit on a non-Windows platform.","startLine":108,"endLine":124,"calleeNames":["normpath","str","uuid5","UUID","upper"]},"acm000002481jsd":{"type":"ControlElement","id":"acm000002481jsd","name":"msvs_parse_version","comment":"Split a Visual Studio version, which may in fact be something like '7.0Exp', into is version number (returned as a float) and trailing \"suite\" portion.\nThis is how we re-invoke SCons from inside MSVS Project files.\nThe problem is that we might have been invoked as either scons.bat\nor scons.py. If we were invoked directly as scons.py, then we could\nuse sys.argv[0] to find the SCons \"executable,\" but that doesn't work\nif we were invoked as scons.bat, which uses \"python -c\" to execute\nthings and ends up with \"-c\" as sys.argv[0]. Consequently, we have\nthe MSVS Project file invoke SCons the same way that scons.bat does,\nwhich works regardless of how we were invoked.","startLine":130,"endLine":137,"calleeNames":["match","groups","float"]},"acm000002482jsd":{"type":"ControlElement","id":"acm000002482jsd","name":"getExecScriptMain","comment":"","startLine":147,"endLine":160,"calleeNames":["get","locals","xmlify"]},"acm000002483jsd":{"type":"ControlElement","id":"acm000002483jsd","name":"splitFully","comment":"","startLine":177,"endLine":183,"calleeNames":["split","splitFully"]},"acm000002484jsd":{"type":"ControlElement","id":"acm000002484jsd","name":"makeHierarchy","comment":"Break a list of files into a hierarchy; for each value, if it is a string, then it is a file. If it is a dictionary, it is a folder. The string is the original path of the file.","startLine":185,"endLine":202,"calleeNames":["splitFully","len"]},"acm000002485jsd":{"type":"ControlElement","id":"acm000002485jsd","name":"GenerateDSP","comment":"Generates a Project file based on the version of MSVS that is being used","startLine":1793,"endLine":1807,"calleeNames":["msvs_parse_version","_GenerateV10DSP","Build","_GenerateV7DSP","_GenerateV6DSP"]},"acm000002486jsd":{"type":"ControlElement","id":"acm000002486jsd","name":"GenerateDSW","comment":"Generates a Solution/Workspace file based on the version of MSVS that is being used","startLine":1809,"endLine":1820,"calleeNames":["msvs_parse_version","_GenerateV7DSW","Build","_GenerateV6DSW"]},"acm000002487jsd":{"type":"ControlElement","id":"acm000002487jsd","name":"GetMSVSProjectSuffix","comment":"","startLine":1828,"endLine":1829,"calleeNames":[]},"acm000002488jsd":{"type":"ControlElement","id":"acm000002488jsd","name":"GetMSVSSolutionSuffix","comment":"","startLine":1831,"endLine":1832,"calleeNames":[]},"acm000002489jsd":{"type":"ControlElement","id":"acm000002489jsd","name":"GenerateProject","comment":"generate the dsp file, according to the version of MSVS.","startLine":1834,"endLine":1867,"calleeNames":["srcnode","open","str","print","write","get_abspath","close","GenerateDSP","get","GenerateDSW"]},"acm000002490jsd":{"type":"ControlElement","id":"acm000002490jsd","name":"GenerateSolution","comment":"","startLine":1869,"endLine":1870,"calleeNames":["GenerateDSW"]},"acm000002491jsd":{"type":"ControlElement","id":"acm000002491jsd","name":"projectEmitter","comment":"Sets up the DSP dependencies.\ntodo: Not sure what sets source to what user has passed as target,\nbut this is what happens. When that is fixed, we also won't have\nto make the user always append env['MSVSPROJECTSUFFIX'] to target.\nmake sure the suffix is correct for the version of MSVS we're running.","startLine":1872,"endLine":1975,"calleeNames":["splitext","str","subst","xmlify","join","processDefines","get","processIncludes","is_String","is_List","get_abspath","InternalError","Value","File","srcnode","solutionEmitter","msvs_parse_version","append"]},"acm000002492jsd":{"type":"ControlElement","id":"acm000002492jsd","name":"solutionEmitter","comment":"Sets up the DSW dependencies.\ntodo: Not sure what sets