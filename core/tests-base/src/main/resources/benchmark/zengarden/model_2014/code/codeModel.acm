 Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\n[hip~], [hip~ float] A one-tap IIR filter: y[i] = a * (y[i-1] + x[i] - x[i-1])","compilationUnitId":null,"parentDatatypeId":null,"startLine":32,"endLine":45,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001414jsd":{"type":"ControlElement","id":"acm000001414jsd","name":"DspHighpassFilter::toString()","comment":"","startLine":47,"endLine":49,"calleeNames":[]},"acm000001415jsd":{"type":"ControlElement","id":"acm000001415jsd","name":"*DspHighpassFilter::getObjectLabel()","comment":"","startLine":51,"endLine":53,"calleeNames":[]},"acm000001416jsd":{"type":"CodeAssembly","id":"acm000001416jsd","name":"DspHighpassFilter","comment":null,"parentId":null,"content":["acm000001413jsd","acm000001414jsd","acm000001415jsd"],"language":"CPP","importedModuleNames":[]},"acm000001417jsd":{"type":"ClassUnit","id":"acm000001417jsd","name":"DspImplicitAdd","comment":"Copyright 2012 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nThis object is a stripped down version of DspAdd used soley for the purposes of summing two DSP vectors together as a a part of the implicit add step.","compilationUnitId":null,"parentDatatypeId":null,"startLine":32,"endLine":44,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001418jsd":{"type":"ControlElement","id":"acm000001418jsd","name":"*DspImplicitAdd::getObjectLabel()","comment":"","startLine":46,"endLine":48,"calleeNames":[]},"acm000001419jsd":{"type":"ControlElement","id":"acm000001419jsd","name":"DspImplicitAdd::toString()","comment":"","startLine":50,"endLine":52,"calleeNames":[]},"acm000001420jsd":{"type":"CodeAssembly","id":"acm000001420jsd","name":"DspImplicitAdd","comment":null,"parentId":null,"content":["acm000001417jsd","acm000001418jsd","acm000001419jsd"],"language":"CPP","importedModuleNames":[]},"acm000001421jsd":{"type":"ClassUnit","id":"acm000001421jsd","name":"DspInlet","comment":"Copyright 2010,2011,2012 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\n[inlet~]\n<code>DspInlet</code> uses much the same strategy of buffer replacement as <code>DspOutlet</code>. In this case, the parent-graph's inlet buffer replaces this object's outlet buffer. Thus, when the parent graph fills its inlet buffer, this object's outlet buffer is immediately filled and no further computations must be done.","compilationUnitId":null,"parentDatatypeId":null,"startLine":36,"endLine":55,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001422jsd":{"type":"ControlElement","id":"acm000001422jsd","name":"DspInlet::canSetBufferAtOutlet(unsignedintoutletIndex)","comment":"[inlet~] does nothing with audio","startLine":57,"endLine":59,"calleeNames":[]},"acm000001423jsd":{"type":"ControlElement","id":"acm000001423jsd","name":"DspInlet::doesProcessAudio()","comment":"","startLine":61,"endLine":63,"calleeNames":[]},"acm000001424jsd":{"type":"ControlElement","id":"acm000001424jsd","name":"DspInlet::toString()","comment":"","startLine":65,"endLine":67,"calleeNames":[]},"acm000001425jsd":{"type":"ControlElement","id":"acm000001425jsd","name":"*DspInlet::getObjectLabel()","comment":"","startLine":69,"endLine":71,"calleeNames":[]},"acm000001426jsd":{"type":"ControlElement","id":"acm000001426jsd","name":"DspInlet::getObjectType()","comment":"","startLine":73,"endLine":75,"calleeNames":[]},"acm000001427jsd":{"type":"CodeAssembly","id":"acm000001427jsd","name":"DspInlet","comment":null,"parentId":null,"content":["acm000001421jsd","acm000001422jsd","acm000001423jsd","acm000001424jsd","acm000001425jsd","acm000001426jsd"],"language":"CPP","importedModuleNames":[]},"acm000001428jsd":{"type":"ClassUnit","id":"acm000001428jsd","name":"anonymous","comment":"Copyright 2009 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at y