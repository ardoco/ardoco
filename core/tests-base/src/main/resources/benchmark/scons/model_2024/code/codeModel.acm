0002914jsd","acm000002922jsd","acm000002928jsd","acm000002934jsd","acm000002940jsd","acm000002945jsd","acm000002948jsd","acm000002952jsd","acm000002955jsd","acm000002962jsd","acm000002963jsd","acm000002964jsd","acm000002965jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["io","os","sys","types","unittest","unittest.mock","subprocess.PIPE","typing.Optional","SCons.Action","SCons.Environment","SCons.Errors","SCons.Action.scons_subproc_run","SCons.Util.sctyping.ExecutorType","TestCmd"]},"acm000002967jsd":{"type":"ClassUnit","id":"acm000002967jsd","name":"_Null","comment":"","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":117,"endLine":118,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002968jsd":{"type":"ControlElement","id":"acm000002968jsd","name":"__init__","comment":"","startLine":137,"endLine":139,"calleeNames":["super","__init__"]},"acm000002969jsd":{"type":"ControlElement","id":"acm000002969jsd","name":"src_suffixes","comment":"","startLine":141,"endLine":142,"calleeNames":["list","keys"]},"acm000002970jsd":{"type":"ControlElement","id":"acm000002970jsd","name":"add_action","comment":"Add a suffix-action pair to the mapping.","startLine":144,"endLine":147,"calleeNames":[]},"acm000002971jsd":{"type":"ControlElement","id":"acm000002971jsd","name":"__call__","comment":"return ext","startLine":149,"endLine":178,"calleeNames":["src_suffixes","map","match_splitext","UserError","repr","list","str","__call__","keys"]},"acm000002972jsd":{"type":"ClassUnit","id":"acm000002972jsd","name":"DictCmdGenerator","comment":"This is a callable class that can be used as a command generator function. It holds on to a dictionary mapping file suffixes to Actions. It uses that dictionary to return the proper action based on the file suffix of the source file.","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":130,"endLine":178,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002968jsd","acm000002969jsd","acm000002970jsd","acm000002971jsd"]},"acm000002973jsd":{"type":"ControlElement","id":"acm000002973jsd","name":"__call__","comment":"return ext","startLine":149,"endLine":178,"calleeNames":["src_suffixes","map","match_splitext","UserError","repr","list","str","__call__","keys"]},"acm000002974jsd":{"type":"ClassUnit","id":"acm000002974jsd","name":"CallableSelector","comment":"A callable dictionary that will, in turn, call the value it finds if it can.","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":180,"endLine":187,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002973jsd"]},"acm000002975jsd":{"type":"ControlElement","id":"acm000002975jsd","name":"__call__","comment":"return ext","startLine":149,"endLine":178,"calleeNames":["src_suffixes","map","match_splitext","UserError","repr","list","str","__call__","keys"]},"acm000002976jsd":{"type":"ClassUnit","id":"acm000002976jsd","name":"DictEmitter","comment":"A callable dictionary that maps file suffixes to emitters. When called, it finds the right emitter in its dictionary for the suffix of the first source file, and calls that emitter to get the right lists of targets and sources to return. If there's no emitter for the suffix in its dictionary, the original target and source are returned.","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":189,"endLine":201,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002975jsd"]},"acm000002977jsd":{"type":"ControlElement","id":"acm000002977jsd","name":"__call__","comment":"return ext","startLine":149,"endLine":178,"calleeNames":["src_suffixes","map","match_splitext","UserError","repr","list","str","__call__","keys"]},"acm000002978jsd":{"type":"ClassUnit","id":"acm000002978jsd","name":"ListEmitter","comment":"A callable list of emitters that calls each in sequence, returning the result.","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":203,"endLine":210,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002977jsd"]},"acm000002979jsd":{"type":"ControlElement","id":"acm000002979jsd","name":"__init__","comment":"","startLine":137,"endLine":139,"calleeNames":["super","__init__"]},"acm000002980jsd":{"type":"ControlElement","id":"acm000002980jsd","name":"warn","comment":"","startLine":234,"endLine":242,"calleeNames":["keys","warn"]},"acm000002981jsd":{"type":"ClassUnit","id":"acm000002981jsd","name":"OverrideWarner","comment":"A class for warning about keyword arguments that we use as overrides in a Builder call. This class exists to handle the fact that a single Builder call can actually invoke multiple builders. This class only emits the warnings once, no matter how many Builders are invoked.","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":221,"endLine":242,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002979jsd","acm000002980jsd"]},"acm000002982jsd":{"type":"ControlElement","id":"acm000002982jsd","name":"__init__","comment":"","startLine":137,"endLine":139,"calleeNames":["super","__init__"]},"acm000002983jsd":{"type":"ControlElement","id":"acm000002983jsd","name":"__call__","comment":"return ext","startLine":149,"endLine":178,"calleeNames":["src_suffixes","map","match_splitext","UserError","repr","list","str","__call__","keys"]},"acm000002984jsd":{"type":"ControlElement","id":"acm000002984jsd","name":"__eq__","comment":"","startLine":361,"endLine":362,"calleeNames":[]},"acm000002985jsd":{"type":"ControlElement","id":"acm000002985jsd","name":"__lt__","comment":"","startLine":364,"endLine":365,"calleeNames":[]},"acm000002986jsd":{"type":"ControlElement","id":"acm000002986jsd","name":"__le__","comment":"","startLine":367,"endLine":368,"calleeNames":[]},"acm000002987jsd":{"type":"ControlElement","id":"acm000002987jsd","name":"__gt__","comment":"","startLine":370,"endLine":371,"calleeNames":[]},"acm000002988jsd":{"type":"ControlElement","id":"acm000002988jsd","name":"__ge__","comment":"","startLine":373,"endLine":374,"calleeNames":[]},"acm000002989jsd":{"type":"ClassUnit","id":"acm000002989jsd","name":"EmitterProxy","comment":"This is a callable class that can act as a Builder emitter. It holds on to a string that is a key into an Environment dictionary, and will look there at actual build time to see if it holds a callable. If so, we will call that as the actual emitter.","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":335,"endLine":374,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002982jsd","acm000002983jsd","acm000002984jsd","acm000002985jsd","acm000002986jsd","acm000002987jsd","acm000002988jsd"]},"acm000002990jsd":{"type":"ControlElement","id":"acm000002990jsd","name":"__init__","comment":"","startLine":137,"endLine":139,"calleeNames":["super","__init__"]},"acm000002991jsd":{"type":"ControlElement","id":"acm000002991jsd","name":"__bool__","comment":"","startLine":446,"endLine":447,"calleeNames":["InternalError"]},"acm000002992jsd":{"type":"ControlElement","id":"acm000002992jsd","name":"get_name","comment":"Attempts to get the name of the Builder. Look at the BUILDERS variable of env, expecting it to be a dictionary containing this Builder, and return the key of the dictionary. If there's no key, then return a directly-configured name (if there is one) or the name of the class (by default).","startLine":449,"endLine":464,"calleeNames":["list","index","values","keys","str"]},"acm000002993jsd":{"type":"ControlElement","id":"acm000002993jsd","name":"__eq__","comment":"","startLine":361,"endLine":362,"calleeNames":[]},"acm000002994jsd":{"type":"ControlElement","id":"acm000002994jsd","name":"splitext","comment":"","startLine":469,"endLine":476,"calleeNames":["src_suffixes","match_splitext"]},"acm000002995jsd":{"type":"ControlElement","id":"acm000002995jsd","name":"_adjustixes","comment":"","startLine":478,"endLine":494,"calleeNames":["is_List","suppress","fspath","is_String","adjustixes","append"]},"acm000002996jsd":{"type":"ControlElement","id":"acm000002996jsd","name":"_create_nodes","comment":"Create and return lists of target and source nodes.","startLine":496,"endLine":558,"calleeNames":["get_src_suffix","get_factory","_adjustixes","arg2nodes","get_prefix","get_suffix","UserError","splitext","t_from_s","is_derived","builder_set","append","emitter"]},"acm000002997jsd":{"type":"ControlElement","id":"acm000002997jsd","name":"_execute","comment":"We now assume that target and source are lists or None.\nIf there is more than one target ensure that if we need to reset\nthe implicit list to new scan of dependency all targets implicit lists\nare cleared. (SCons GH Issue #2811 and MongoDB SERVER-33111)\nCheck for errors with the specified target/source lists.\nThe targets are fine, so find or make the appropriate Executor to\nbuild this particular list of targets from this particular list of\nsources.","startLine":560,"endLine":638,"calleeNames":["src_builder_sources","len","zip","extend","_execute","NodeList","warn","_create_nodes","_node_errors","get_executor","add_sources","UserError","get_name","list","map","batch_key","GetBatchExecutor","add_batch","Executor","AddBatchExecutor","getcwd","builder_set","env_set","add_source","set_executor","set_explicit","get"]},"acm000002998jsd":{"type":"ControlElement","id":"acm000002998jsd","name":"__call__","comment":"return ext","startLine":149,"endLine":178,"calleeNames":["src_suffixes","map","match_splitext","UserError","repr","list","str","__call__","keys"]},"acm000002999jsd":{"type":"ControlElement","id":"acm000002999jsd","name":"adjust_suffix","comment":"","startLine":674,"endLine":677,"calleeNames":[]},"acm000003000jsd":{"type":"ControlElement","id":"acm000003000jsd","name":"get_prefix","comment":"","startLine":679,"endLine":683,"calleeNames":["callable","prefix","subst"]},"acm000003001jsd":{"type":"ControlElement","id":"acm000003001jsd","name":"set_suffix","comment":"","startLine":685,"endLine":688,"calleeNames":["callable","adjust_suffix"]},"acm000003002jsd":{"type":"ControlElement","id":"acm000003002jsd","name":"get_suffix","comment":"","startLine":690,"endLine":694,"calleeNames":["callable","suffix","subst"]},"acm000003003jsd":{"type":"ControlElement","id":"acm000003003jsd","name":"set_src_suffix","comment":"","startLine":696,"endLine":701,"calleeNames":["is_List","callable","adjust_suffix"]},"acm000003004jsd":{"type":"ControlElement","id":"acm000003004jsd","name":"get_src_suffix","comment":"Get the first src_suffix in the list of src_suffixes.","startLine":703,"endLine":708,"calleeNames":["src_suffixes"]},"acm000003005jsd":{"type":"ControlElement","id":"acm000003005jsd","name":"add_emitter","comment":"Add a suffix-emitter mapping to this Builder. This assumes that emitter has been initialized with an appropriate dictionary type, and will throw a TypeError if not, so the caller is responsible for knowing that this is an appropriate method to call for the Builder in question.","startLine":710,"endLine":718,"calleeNames":[]},"acm000003006jsd":{"type":"ControlElement","id":"acm000003006jsd","name":"add_src_builder","comment":"Add a new Builder to the list of src_builders. This requires wiping out cached values so that the computed lists of source suffixes get re-calculated.","startLine":720,"endLine":728,"calleeNames":["append"]},"acm000003007jsd":{"type":"ControlElement","id":"acm000003007jsd","name":"_get_sdict","comment":"Returns a dictionary mapping all of the source suffixes of all src_builders of this Builder to the underlying Builder that should be called first. This dictionary is used for each target specified, so we save a lot of extra computation by memoizing it for each construction environment. Note that this is re-computed each time, not cached, because there might be changes to one of our source Builders (or one of their source Builders, and so on, and so on...) that we can't \"see.\" The underlying methods we call cache their computed values, though, so we hope repeatedly aggregating them into a dictionary like this won't be too big a hit. We may need to look for a better way to do this if performance data show this has turned into a significant bottleneck.","startLine":730,"endLine":754,"calleeNames":["get_src_builders","src_suffixes"]},"acm000003008jsd":{"type":"ControlElement","id":"acm000003008jsd","name":"src_builder_sources","comment":"","startLine":756,"endLine":797,"calleeNames":["_get_sdict","src_suffixes","list","set","map","flatten","is_String","match_src_suffix","subst","get_src_suffix","_adjustixes","append","_execute","len","extend","get_factory","arg2nodes"]},"acm000003009jsd":{"type":"ControlElement","id":"acm000003009jsd","name":"_get_src_builders_key","comment":"","startLine":799,"endLine":800,"calleeNames":["id"]},"acm000003010jsd":{"type":"ControlElement","id":"acm000003010jsd","name":"get_src_builders","comment":"Returns the list of source Builders for this Builder. This exists mainly to look up Builders referenced as strings in the 'BUILDER' variable of the construction environment and cache the result.","startLine":803,"endLine":833,"calleeNames":["id","is_String","append"]},"acm000003011jsd":{"type":"ControlElement","id":"acm000003011jsd","name":"_subst_src_suffixes_key","comment":"","startLine":835,"endLine":836,"calleeNames":["id"]},"acm000003012jsd":{"type":"ControlElement","id":"acm000003012jsd","name":"subst_src_suffixes","comment":"The suffix list may contain construction variable expansions, so we have to evaluate the individual strings. To avoid doing this over and over, we memoize the results for each construction environment.","startLine":839,"endLine":859,"calleeNames":["id","subst"]},"acm000003013jsd":{"type":"ControlElement","id":"acm000003013jsd","name":"src_suffixes","comment":"","startLine":141,"endLine":142,"calleeNames":["list","keys"]},"acm000003014jsd":{"type":"ClassUnit","id":"acm000003014jsd","name":"BuilderBase","comment":"Base class for Builders, objects that create output nodes (files) from input nodes (files).","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":376,"endLine":879,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002990jsd","acm000002991jsd","acm000002992jsd","acm000002993jsd","acm000002994jsd","acm000002995jsd","acm000002996jsd","acm000002997jsd","acm000002998jsd","acm000002999jsd","acm000003000jsd","acm000003001jsd","acm000003002jsd","acm000003003jsd","acm000003004jsd","acm000003005jsd","acm000003006jsd","acm000003007jsd","acm000003008jsd","acm000003009jsd","acm000003010jsd","acm000003011jsd","acm000003012jsd","acm000003013jsd"]},"acm000003015jsd":{"type":"ControlElement","id":"acm000003015jsd","name":"__init__","comment":"","startLine":137,"endLine":139,"calleeNames":["super","__init__"]},"acm000003016jsd":{"type":"ControlElement","id":"acm000003016jsd","name":"add_action","comment":"Add a suffix-action pair to the mapping.","startLine":144,"endLine":147,"calleeNames":[]},"acm000003017jsd":{"type":"ClassUnit","id":"acm000003017jsd","name":"CompositeBuilder","comment":"A Builder Proxy whose main purpose is to always have a DictCmdGenerator as its action, and to provide access to the DictCmdGenerator's add_action() method.","compilationUnitId":"acm000003022jsd","parentDatatypeId":null,"startLine":881,"endLine":899,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003015jsd","acm000003016jsd"]},"acm000003018jsd":{"type":"ControlElement","id":"acm000003018jsd","name":"match_splitext","comment":"","startLine":122,"endLine":128,"calleeNames":["len","max","splitext"]},"acm000003019jsd":{"type":"ControlElement","id":"acm000003019jsd","name":"Builder","comment":"A factory for builder objects.","startLine":244,"endLine":284,"calleeNames":["UserError","CommandGeneratorAction","get","is_Dict","DictCmdGenerator","src_suffixes","Action","is_String","get_environment_var","EmitterProxy","DictEmitter","is_List","ListEmitter","BuilderBase","CompositeBuilder"]},"acm000003020jsd":{"type":"ControlElement","id":"acm000003020jsd","name":"_node_errors","comment":"Validate that the lists of target and source nodes are legal for this builder and environment. Raise errors or issue warnings as appropriate.\nFirst, figure out if there are any errors in the way the targets\nwere specified.\nCheck for errors when the environments are different\nNo error if environments are the same Environment instance\nCheck OverrideEnvironment case - no error if wrapped Environments\nare the same instance, and overrides lists match\nTODO(batch): list constructed each time!","startLine":286,"endLine":333,"calleeNames":["UserError","has_explicit_builder","getattr","get_contents","genstring","warn","decode","get_name","get_executor","get_all_targets","list","map","len"]},"acm000003021jsd":{"type":"ControlElement","id":"acm000003021jsd","name":"is_a_Builder","comment":"\"Returns True if the specified obj is one of our Builder classes. The test is complicated a bit by the fact that CompositeBuilder is a proxy, not a subclass of BuilderBase.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":901,"endLine":909,"calleeNames":["isinstance","callable"]},"acm000003022jsd":{"type":"CodeCompilationUnit","id":"acm000003022jsd","name":"Builder","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons.Builder Builder object subsystem. A Builder object is a callable that encapsulates information about how to execute actions to create a target Node (file) from source Nodes (files), and how to create those dependencies for tracking. The main entry point here is the Builder() factory method. This provides a procedural interface that creates the right underlying Builder object based on the keyword arguments supplied and the types of the arguments. The goal is for this external interface to be simple enough that the vast majority of users can create new Builders as necessary to support building new types of files in their configurations, without having to dive any deeper into this subsystem. The base class here is BuilderBase. This is a concrete base class which does, in fact, represent the Builder objects that we (or users) create. There is also a proxy that looks like a Builder: CompositeBuilder This proxies for a Builder with an action that is actually a dictionary that knows how to map file suffixes to a specific action. This is so that we can invoke different actions (compilers, compile options) for different flavors of source files. Builders and their proxies have the following public interface methods used by other modules: - __call__() THE public interface. Calling a Builder object (with the use of internal helper methods) sets up the target and source dependencies, appropriate mapping to a specific action, and the environment manipulation necessary for overridden construction variable. This also takes care of warning about possible mistakes in keyword arguments. - add_emitter() Adds an emitter for a specific file suffix, used by some Tool modules to specify that (for example) a yacc invocation on a .y can create a .h *and* a .c file. - add_action() Adds an action for a specific file suffix, heavily used by Tool modules to add their specific action(s) for turning a source file into an object file to the global static and shared object file Builders. There are the following methods for internal use within this module: - _execute() The internal method that handles the heavily lifting when a Builder is called. This is used so that the __call__() methods can set up warning about possible mistakes in keyword-argument overrides, and *then* execute all of the steps necessary so that the warnings only occur once. - get_name() Returns the Builder's name within a specific Environment, primarily used to try to return helpful information in error messages. - adjust_suffix() - get_prefix() - get_suffix() - get_src_suffix() - set_src_suffix() Miscellaneous stuff for handling the prefix and suffix manipulation we use in turning source file names into target file names.","parentId":"acm000004231jsd","content":["acm000002967jsd","acm000002972jsd","acm000002974jsd","acm000002976jsd","acm000002978jsd","acm000002981jsd","acm000002989jsd","acm000003014jsd","acm000003017jsd","acm000003018jsd","acm000003019jsd","acm000003020jsd","acm000003021jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["os","collections.UserDict","collections.UserList","contextlib.suppress","typing.Optional","SCons.Action","SCons.Debug","SCons.Executor","SCons.Memoize","SCons.Util","SCons.Warnings","SCons.Debug.logInstanceCreation","SCons.Errors.InternalError","SCons.Errors.UserError","SCons.Util.sctyping.ExecutorType"]},"acm000003023jsd":{"type":"ControlElement","id":"acm000003023jsd","name":"__init__","comment":"","startLine":74,"endLine":84,"calleeNames":["items","FS"]},"acm000003024jsd":{"type":"ControlElement","id":"acm000003024jsd","name":"subst","comment":"","startLine":85,"endLine":90,"calleeNames":["is_String","get","group","sub"]},"acm000003025jsd":{"type":"ControlElement","id":"acm000003025jsd","name":"subst_target_source","comment":"","startLine":91,"endLine":94,"calleeNames":["scons_subst"]},"acm000003026jsd":{"type":"ControlElement","id":"acm000003026jsd","name":"subst_list","comment":"","startLine":95,"endLine":97,"calleeNames":["scons_subst_list"]},"acm000003027jsd":{"type":"ControlElement","id":"acm000003027jsd","name":"arg2nodes","comment":"","startLine":98,"endLine":108,"calleeNames":["is_List","is_String","factory","subst","append"]},"acm000003028jsd":{"type":"ControlElement","id":"acm000003028jsd","name":"get_factory","comment":"","startLine":109,"endLine":110,"calleeNames":[]},"acm000003029jsd":{"type":"ControlElement","id":"acm000003029jsd","name":"get_scanner","comment":"","startLine":111,"endLine":112,"calleeNames":[]},"acm000003030jsd":{"type":"ControlElement","id":"acm000003030jsd","name":"Dictionary","comment":"","startLine":113,"endLine":114,"calleeNames":[]},"acm000003031jsd":{"type":"ControlElement","id":"acm000003031jsd","name":"autogenerate","comment":"","startLine":115,"endLine":116,"calleeNames":[]},"acm000003032jsd":{"type":"ControlElement","id":"acm000003032jsd","name":"__setitem__","comment":"","startLine":117,"endLine":118,"calleeNames":[]},"acm000003033jsd":{"type":"ControlElement","id":"acm000003033jsd","name":"__getitem__","comment":"","startLine":119,"endLine":120,"calleeNames":[]},"acm000003034jsd":{"type":"ControlElement","id":"acm000003034jsd","name":"__contains__","comment":"","startLine":121,"en