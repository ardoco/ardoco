he Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000001925jsd","content":[],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Action"]},"acm000001837jsd":{"type":"ControlElement","id":"acm000001837jsd","name":"register_custom_handler","comment":"Register a custom handler for SCons function actions.","startLine":38,"endLine":40,"calleeNames":[]},"acm000001838jsd":{"type":"ControlElement","id":"acm000001838jsd","name":"register_custom_rule_mapping","comment":"Register a function to call for a given rule.","startLine":43,"endLine":45,"calleeNames":[]},"acm000001839jsd":{"type":"ControlElement","id":"acm000001839jsd","name":"register_custom_rule","comment":"Allows specification of Ninja rules from inside SCons files.","startLine":48,"endLine":68,"calleeNames":["join","get_path"]},"acm000001840jsd":{"type":"ControlElement","id":"acm000001840jsd","name":"register_custom_pool","comment":"Allows the creation of custom Ninja pools","startLine":71,"endLine":73,"calleeNames":[]},"acm000001841jsd":{"type":"ControlElement","id":"acm000001841jsd","name":"set_build_node_callback","comment":"","startLine":76,"endLine":78,"calleeNames":["is_conftest"]},"acm000001842jsd":{"type":"ControlElement","id":"acm000001842jsd","name":"get_generic_shell_command","comment":"Since this function is a rule mapping provider, it must return a list of dependencies,\nand usually this would be the path to a tool, such as a compiler, used for this rule.\nHowever this function is to generic to be able to reliably extract such deps\nfrom the command, so we return a placeholder empty list. It should be noted that\ngenerally this function will not be used solely and is more like a template to generate\nthe basics for a custom provider which may have more specific options for a provider\nfunction for a custom NinjaRuleMapping.","startLine":81,"endLine":96,"calleeNames":["generate_command","get_command_env"]},"acm000001843jsd":{"type":"ControlElement","id":"acm000001843jsd","name":"CheckNinjaCompdbExpand","comment":"Configure check testing if ninja's compdb can expand response files\nTODO: When would this be false?\nrule CMD_RSP command = $cmd @$out.rsp > fake_output.txt description = Building $out rspfile = $out.rsp rspfile_content = $rspc build fake_output.txt: CMD_RSP fake_input.txt cmd = echo pool = console rspc = \"test\"","startLine":99,"endLine":120,"calleeNames":["Message","TryAction","dedent","Result"]},"acm000001844jsd":{"type":"ControlElement","id":"acm000001844jsd","name":"get_command","comment":"pylint: disable=too-many-branches\nGet the command to execute for node.","startLine":123,"endLine":217,"calleeNames":["get_executor","get_targets_sources","isinstance","_generate","str","get_comstr","get","provider","get_env","list","get_dependencies","subst","exists","append","endswith","WhereIs","Exception","get_order_only","get_outputs","get_inputs","get_rule"]},"acm000001845jsd":{"type":"ControlElement","id":"acm000001845jsd","name":"gen_get_response_file_command","comment":"Generate a response file command provider for rule name.\nIf win32 using the environment with a response file command will cause\nninja to fail to create the response file. Additionally since these rules\ngenerally are not piping through cmd.exe /c any environment variables will\nmake CreateProcess fail to start.\n\nOn POSIX we can still set environment variables even for compile\ncommands so we do so.","startLine":220,"endLine":288,"calleeNames":["hasattr","process","str","replace","generate_command","split","subst","index","Exception","format","get_comstr","join","get_command_env","items","get_env","get","len"]},"acm000001846jsd":{"type":"CodeCompilationUnit","id":"acm000001846jsd","name":"Methods","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000001925jsd","content":["acm000001837jsd","acm000001838jsd","acm000001839jsd","acm000001840jsd","acm000001841jsd","acm000001842jsd","acm000001843jsd","acm000001844jsd","acm000001845jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames