"get_env_bool","repr"]},"acm000006173jsd":{"type":"ClassUnit","id":"acm000006173jsd","name":"get_env_boolTestCase","comment":"","compilationUnitId":"acm000006179jsd","parentDatatypeId":null,"startLine":1135,"endLine":1169,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006169jsd","acm000006170jsd","acm000006171jsd","acm000006172jsd"]},"acm000006174jsd":{"type":"ControlElement","id":"acm000006174jsd","name":"test_missing","comment":"","startLine":1136,"endLine":1142,"calleeNames":["get_env_bool","repr"]},"acm000006175jsd":{"type":"ControlElement","id":"acm000006175jsd","name":"test_true","comment":"","startLine":1144,"endLine":1152,"calleeNames":["get_env_bool","repr"]},"acm000006176jsd":{"type":"ControlElement","id":"acm000006176jsd","name":"test_false","comment":"","startLine":1154,"endLine":1162,"calleeNames":["get_env_bool","repr"]},"acm000006177jsd":{"type":"ControlElement","id":"acm000006177jsd","name":"test_default","comment":"","startLine":1164,"endLine":1169,"calleeNames":["get_env_bool","repr"]},"acm000006178jsd":{"type":"ClassUnit","id":"acm000006178jsd","name":"get_os_env_boolTestCase","comment":"","compilationUnitId":"acm000006179jsd","parentDatatypeId":null,"startLine":1172,"endLine":1206,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006174jsd","acm000006175jsd","acm000006176jsd","acm000006177jsd"]},"acm000006179jsd":{"type":"CodeCompilationUnit","id":"acm000006179jsd","name":"UtilTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThese Util classes have no unit tests. Some don't make sense to test?\nDisplayEngine, Delegate, MethodWrapper, UniqueList, Unbuffered, Null, NullSeq","parentId":"acm000006271jsd","content":["acm000006097jsd","acm000006099jsd","acm000006141jsd","acm000006144jsd","acm000006155jsd","acm000006159jsd","acm000006162jsd","acm000006168jsd","acm000006173jsd","acm000006178jsd"],"pathElements":["Util"],"extension":"py","language":"PYTHON3","importedModuleNames":["functools","hashlib","io","os","sys","unittest","unittest.mock","warnings","collections.UserDict","collections.UserList","collections.UserString","collections.namedtuple","typing.Union","TestCmd","SCons.Errors","SCons.compat","SCons.Util.ALLOWED_HASH_FORMATS","SCons.Util.AddPathIfNotExists","SCons.Util.AppendPath","SCons.Util.CLVar","SCons.Util.LogicalLines","SCons.Util.NodeList","SCons.Util.PrependPath","SCons.Util.Proxy","SCons.Util.Selector","SCons.Util.WhereIs","SCons.Util.adjustixes","SCons.Util.containsAll","SCons.Util.containsAny","SCons.Util.containsOnly","SCons.Util.dictify","SCons.Util.display","SCons.Util.flatten","SCons.Util.get_env_bool","SCons.Util.get_environment_var","SCons.Util.get_native_path","SCons.Util.get_os_env_bool","SCons.Util.hash_collect","SCons.Util.hash_signature","SCons.Util.is_Dict","SCons.Util.is_List","SCons.Util.is_String","SCons.Util.is_Tuple","SCons.Util.print_tree","SCons.Util.render_tree","SCons.Util.set_hash_format","SCons.Util.silent_intern","SCons.Util.splitext","SCons.Util.to_String","SCons.Util.to_bytes","SCons.Util.to_str","SCons.Util.hashes._attempt_init_of_python_3_9_hash_object","SCons.Util.hashes._attempt_get_hash_function","SCons.Util.hashes._get_hash_object","SCons.Util.hashes._set_allowed_viable_default_hashes","tempfile"]},"acm000006180jsd":{"type":"ControlElement","id":"acm000006180jsd","name":"__bool__","comment":"","startLine":196,"endLine":197,"calleeNames":["bool"]},"acm000006181jsd":{"type":"ControlElement","id":"acm000006181jsd","name":"__str__","comment":"","startLine":199,"endLine":200,"calleeNames":["join","map"]},"acm000006182jsd":{"type":"ControlElement","id":"acm000006182jsd","name":"__iter__","comment":"","startLine":202,"endLine":203,"calleeNames":["iter"]},"acm000006183jsd":{"type":"ControlElement","id":"acm000006183jsd","name":"__call__","comment":"","startLine":205,"endLine":207,"calleeNames":["x","__class__"]},"acm000006184jsd":{"type":"ControlElement","id":"acm000006184jsd","name":"__getattr__","comment":"Returns a NodeList of `name` from each member.","startLine":209,"endLine":212,"calleeNames":["getattr","__class__"]},"acm000006185jsd":{"type":"ControlElement","id":"acm000006185jsd","name":"__getitem__","comment":"Returns one item, forces a `NodeList` if `index` is a slice.\nTODO: annotate return how? Union[] - don't know type of single item","startLine":214,"endLine":219,"calleeNames":["isinstance","__class__"]},"acm000006186jsd":{"type":"ClassUnit","id":"acm000006186jsd","name":"NodeList","comment":"A list of Nodes with special attribute retrieval. Unlike an ordinary list, access to a member's attribute returns a `NodeList` containing the same attribute for each member. Although this can hold any object, it is intended for use when processing Nodes, where fetching an attribute of each member is very commone, for example getting the content signature of each node. The term \"attribute\" here includes the string representation. >>> someList = NodeList([' foo ', ' bar ']) >>> someList.strip() ['foo', 'bar']","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":181,"endLine":219,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006180jsd","acm000006181jsd","acm000006182jsd","acm000006183jsd","acm000006184jsd","acm000006185jsd"]},"acm000006187jsd":{"type":"ControlElement","id":"acm000006187jsd","name":"__call__","comment":"","startLine":205,"endLine":207,"calleeNames":["x","__class__"]},"acm000006188jsd":{"type":"ControlElement","id":"acm000006188jsd","name":"set_mode","comment":"","startLine":244,"endLine":245,"calleeNames":[]},"acm000006189jsd":{"type":"ClassUnit","id":"acm000006189jsd","name":"DisplayEngine","comment":"A callable class used to display SCons messages.","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":222,"endLine":245,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006187jsd","acm000006188jsd"]},"acm000006190jsd":{"type":"ControlElement","id":"acm000006190jsd","name":"__init__","comment":"Wrap an object as a Proxy object","startLine":589,"endLine":591,"calleeNames":[]},"acm000006191jsd":{"type":"ControlElement","id":"acm000006191jsd","name":"__getattr__","comment":"Returns a NodeList of `name` from each member.","startLine":209,"endLine":212,"calleeNames":["getattr","__class__"]},"acm000006192jsd":{"type":"ControlElement","id":"acm000006192jsd","name":"get","comment":"Retrieve the entire wrapped object","startLine":601,"endLine":603,"calleeNames":[]},"acm000006193jsd":{"type":"ControlElement","id":"acm000006193jsd","name":"__eq__","comment":"","startLine":605,"endLine":608,"calleeNames":["issubclass"]},"acm000006194jsd":{"type":"ClassUnit","id":"acm000006194jsd","name":"Proxy","comment":"A simple generic Proxy class, forwarding all calls to subject. This means you can take an object, let's call it `'obj_a``, and wrap it in this Proxy class, with a statement like this:: proxy_obj = Proxy(obj_a) Then, if in the future, you do something like this:: x = proxy_obj.var1 since the :class:`Proxy` class does not have a :attr:`var1` attribute (but presumably ``obj_a`` does), the request actually is equivalent to saying:: x = obj_a.var1 Inherit from this class to create a Proxy. With Python 3.5+ this does *not* work transparently for :class:`Proxy` subclasses that use special dunder method names, because those names are now bound to the class, not the individual instances. You now need to know in advance which special method names you want to pass on to the underlying Proxy object, and specifically delegate their calls like this:: class Foo(Proxy): __str__ = Delegate('__str__')","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":558,"endLine":608,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006190jsd","acm000006191jsd","acm000006192jsd","acm000006193jsd"]},"acm000006195jsd":{"type":"ControlElement","id":"acm000006195jsd","name":"__init__","comment":"Wrap an object as a Proxy object","startLine":589,"endLine":591,"calleeNames":[]},"acm000006196jsd":{"type":"ControlElement","id":"acm000006196jsd","name":"__get__","comment":"attempt to load the windows registry module:","startLine":621,"endLine":625,"calleeNames":["isinstance","getattr"]},"acm000006197jsd":{"type":"ClassUnit","id":"acm000006197jsd","name":"Delegate","comment":"A Python Descriptor class that delegates attribute fetches to an underlying wrapped subject of a Proxy. Typical use:: class Foo(Proxy): __str__ = Delegate('__str__')","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":611,"endLine":625,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006195jsd","acm000006196jsd"]},"acm000006198jsd":{"type":"ControlElement","id":"acm000006198jsd","name":"__init__","comment":"Wrap an object as a Proxy object","startLine":589,"endLine":591,"calleeNames":[]},"acm000006199jsd":{"type":"ControlElement","id":"acm000006199jsd","name":"__add__","comment":"","startLine":903,"endLine":904,"calleeNames":["super","__add__","CLVar"]},"acm000006200jsd":{"type":"ControlElement","id":"acm000006200jsd","name":"__radd__","comment":"","startLine":906,"endLine":907,"calleeNames":["super","__radd__","CLVar"]},"acm000006201jsd":{"type":"ControlElement","id":"acm000006201jsd","name":"__iadd__","comment":"","startLine":909,"endLine":910,"calleeNames":["super","__iadd__","CLVar"]},"acm000006202jsd":{"type":"ControlElement","id":"acm000006202jsd","name":"__str__","comment":"","startLine":199,"endLine":200,"calleeNames":["join","map"]},"acm000006203jsd":{"type":"ClassUnit","id":"acm000006203jsd","name":"CLVar","comment":"A container for command-line construction variables. Forces the use of a list of strings intended as command-line arguments. Like :class:`collections.UserList`, but the argument passed to the initializter will be processed by the :func:`Split` function, which includes special handling for string types: they will be split into a list of words, not coereced directly to a list. The same happens if a string is added to a :class:`CLVar`, which allows doing the right thing with both :func:`Append`/:func:`Prepend` methods, as well as with pure Python addition, regardless of whether adding a list or a string to a construction variable. Side effect: spaces will be stripped from individual string arguments. If you need spaces preserved, pass strings containing spaces inside a list argument. >>> u = UserList(\"--some --opts and args\") >>> print(len(u), repr(u)) 22 ['-', '-', 's', 'o', 'm', 'e', ' ', '-', '-', 'o', 'p', 't', 's', ' ', 'a', 'n', 'd', ' ', 'a', 'r', 'g', 's'] >>> c = CLVar(\"--some --opts and args\") >>> print(len(c), repr(c)) 4 ['--some', '--opts', 'and', 'args'] >>> c += \" strips spaces \" >>> print(len(c), repr(c)) 6 ['--some', '--opts', 'and', 'args', 'strips', 'spaces'] >>> c += [\" does not split or strip \"] 7 ['--some', '--opts', 'and', 'args', 'strips', 'spaces', ' does not split or strip ']","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":869,"endLine":915,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006198jsd","acm000006199jsd","acm000006200jsd","acm000006201jsd","acm000006202jsd"]},"acm000006204jsd":{"type":"ControlElement","id":"acm000006204jsd","name":"__call__","comment":"","startLine":205,"endLine":207,"calleeNames":["x","__class__"]},"acm000006205jsd":{"type":"ClassUnit","id":"acm000006205jsd","name":"Selector","comment":"A callable dict for file suffix lookup. Often used to associate actions or emitters with file types. Depends on insertion order being preserved so that :meth:`get_suffix` calls always return the first suffix added.","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":918,"endLine":954,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006204jsd"]},"acm000006206jsd":{"type":"ControlElement","id":"acm000006206jsd","name":"__init__","comment":"Wrap an object as a Proxy object","startLine":589,"endLine":591,"calleeNames":[]},"acm000006207jsd":{"type":"ControlElement","id":"acm000006207jsd","name":"readlines","comment":"","startLine":1101,"endLine":1102,"calleeNames":["list","logical_lines"]},"acm000006208jsd":{"type":"ClassUnit","id":"acm000006208jsd","name":"LogicalLines","comment":"Wrapper class for the :func:`logical_lines` function. Allows us to read all \"logical\" lines at once from a given file object.","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":1092,"endLine":1102,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006206jsd","acm000006207jsd"]},"acm000006209jsd":{"type":"ControlElement","id":"acm000006209jsd","name":"__init__","comment":"Wrap an object as a Proxy object","startLine":589,"endLine":591,"calleeNames":[]},"acm000006210jsd":{"type":"ControlElement","id":"acm000006210jsd","name":"__make_unique","comment":"","startLine":1117,"endLine":1120,"calleeNames":["uniquer_hashables"]},"acm000006211jsd":{"type":"ControlElement","id":"acm000006211jsd","name":"__repr__","comment":"","startLine":1122,"endLine":1124,"calleeNames":["__make_unique","super","__repr__"]},"acm000006212jsd":{"type":"ControlElement","id":"acm000006212jsd","name":"__lt__","comment":"","startLine":1126,"endLine":1128,"calleeNames":["__make_unique","super","__lt__"]},"acm000006213jsd":{"type":"ControlElement","id":"acm000006213jsd","name":"__le__","comment":"","startLine":1130,"endLine":1132,"calleeNames":["__make_unique","super","__le__"]},"acm000006214jsd":{"type":"ControlElement","id":"acm000006214jsd","name":"__eq__","comment":"","startLine":605,"endLine":608,"calleeNames":["issubclass"]},"acm000006215jsd":{"type":"ControlElement","id":"acm000006215jsd","name":"__ne__","comment":"","startLine":1138,"endLine":1140,"calleeNames":["__make_unique","super","__ne__"]},"acm000006216jsd":{"type":"ControlElement","id":"acm000006216jsd","name":"__gt__","comment":"","startLine":1142,"endLine":1144,"calleeNames":["__make_unique","super","__gt__"]},"acm000006217jsd":{"type":"ControlElement","id":"acm000006217jsd","name":"__ge__","comment":"__contains__ doesn't need to worry about uniquing, inherit","startLine":1146,"endLine":1148,"calleeNames":["__make_unique","super","__ge__"]},"acm000006218jsd":{"type":"ControlElement","id":"acm000006218jsd","name":"__len__","comment":"","startLine":1152,"endLine":1154,"calleeNames":["__make_unique","super","__len__"]},"acm000006219jsd":{"type":"ControlElement","id":"acm000006219jsd","name":"__getitem__","comment":"Returns one item, forces a `NodeList` if `index` is a slice.\nTODO: annotate return how? Union[] - don't know type of single item","startLine":214,"endLine":219,"calleeNames":["isinstance","__class__"]},"acm000006220jsd":{"type":"ControlElement","id":"acm000006220jsd","name":"__setitem__","comment":"","startLine":1160,"endLine":1162,"calleeNames":["super","__setitem__"]},"acm000006221jsd":{"type":"ControlElement","id":"acm000006221jsd","name":"__add__","comment":"","startLine":903,"endLine":904,"calleeNames":["super","__add__","CLVar"]},"acm000006222jsd":{"type":"ControlElement","id":"acm000006222jsd","name":"__radd__","comment":"","startLine":906,"endLine":907,"calleeNames":["super","__radd__","CLVar"]},"acm000006223jsd":{"type":"ControlElement","id":"acm000006223jsd","name":"__iadd__","comment":"","startLine":909,"endLine":910,"calleeNames":["super","__iadd__","CLVar"]},"acm000006224jsd":{"type":"ControlElement","id":"acm000006224jsd","name":"__mul__","comment":"","startLine":1181,"endLine":1184,"calleeNames":["super","__mul__"]},"acm000006225jsd":{"type":"ControlElement","id":"acm000006225jsd","name":"__rmul__","comment":"","startLine":1186,"endLine":1189,"calleeNames":["super","__rmul__"]},"acm000006226jsd":{"type":"ControlElement","id":"acm000006226jsd","name":"__imul__","comment":"","startLine":1191,"endLine":1194,"calleeNames":["super","__imul__"]},"acm000006227jsd":{"type":"ControlElement","id":"acm000006227jsd","name":"append","comment":"","startLine":1196,"endLine":1198,"calleeNames":["super","append"]},"acm000006228jsd":{"type":"ControlElement","id":"acm000006228jsd","name":"insert","comment":"","startLine":1200,"endLine":1202,"calleeNames":["super","insert"]},"acm000006229jsd":{"type":"ControlElement","id":"acm000006229jsd","name":"count","comment":"","startLine":1204,"endLine":1206,"calleeNames":["__make_unique","super","count"]},"acm000006230jsd":{"type":"ControlElement","id":"acm000006230jsd","name":"index","comment":"","startLine":1208,"endLine":1210,"calleeNames":["__make_unique","super","index"]},"acm000006231jsd":{"type":"ControlElement","id":"acm000006231jsd","name":"reverse","comment":"TODO: Py3.8: def sort(self, /, *args, **kwds):","startLine":1212,"endLine":1214,"calleeNames":["__make_unique","super","reverse"]},"acm000006232jsd":{"type":"ControlElement","id":"acm000006232jsd","name":"sort","comment":"","startLine":1217,"endLine":1219,"calleeNames":["__make_unique","super","sort"]},"acm000006233jsd":{"type":"ControlElement","id":"acm000006233jsd","name":"extend","comment":"","startLine":1221,"endLine":1223,"calleeNames":["super","extend"]},"acm000006234jsd":{"type":"ClassUnit","id":"acm000006234jsd","name":"UniqueList","comment":"A list which maintains uniqueness. Uniquing is lazy: rather than being enforced on list changes, it is fixed up on access by those methods which need to act on a unique list to be correct. That means things like membership tests don't have to eat the uniquing time.","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":1105,"endLine":1223,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006209jsd","acm000006210jsd","acm000006211jsd","acm000006212jsd","acm000006213jsd","acm000006214jsd","acm000006215jsd","acm000006216jsd","acm000006217jsd","acm000006218jsd","acm000006219jsd","acm000006220jsd","acm000006221jsd","acm000006222jsd","acm000006223jsd","acm000006224jsd","acm000006225jsd","acm000006226jsd","acm000006227jsd","acm000006228jsd","acm000006229jsd","acm000006230jsd","acm000006231jsd","acm000006232jsd","acm000006233jsd"]},"acm000006235jsd":{"type":"ControlElement","id":"acm000006235jsd","name":"__init__","comment":"Wrap an object as a Proxy object","startLine":589,"endLine":591,"calleeNames":[]},"acm000006236jsd":{"type":"ControlElement","id":"acm000006236jsd","name":"write","comment":"Stdout might be connected to a pipe that has been closed\nby now. The most likely reason for the pipe being closed\nis that the user has press ctrl-c. It this is the case,\nthen SCons is currently shutdown. We therefore ignore\nIOError's here so that SCons can continue and shutdown\nproperly so that the .sconsign is correctly written\nbefore SCons exits.","startLine":1234,"endLine":1244,"calleeNames":["suppress","write","flush"]},"acm000006237jsd":{"type":"ControlElement","id":"acm000006237jsd","name":"writelines","comment":"","startLine":1246,"endLine":1249,"calleeNames":["suppress","writelines","flush"]},"acm000006238jsd":{"type":"ControlElement","id":"acm000006238jsd","name":"__getattr__","comment":"Returns a NodeList of `name` from each member.","startLine":209,"endLine":212,"calleeNames":["getattr","__class__"]},"acm000006239jsd":{"type":"ClassUnit","id":"acm000006239jsd","name":"Unbuffered","comment":"A proxy that wraps a file object, flushing after every write. Delegates everything else to the wrapped object.","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":1226,"endLine":1252,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006235jsd","acm000006236jsd","acm000006237jsd","acm000006238jsd"]},"acm000006240jsd":{"type":"ControlElement","id":"acm000006240jsd","name":"__init__","comment":"Wrap an object as a Proxy object","startLine":589,"endLine":591,"calleeNames":[]},"acm000006241jsd":{"type":"ControlElement","id":"acm000006241jsd","name":"format","comment":"Search from record's logger up to its parents:","startLine":1336,"endLine":1348,"calleeNames":["getLogger","format"]},"acm000006242jsd":{"type":"ClassUnit","id":"acm000006242jsd","name":"DispatchingFormatter","comment":"Logging formatter which dispatches to various formatters.","compilationUnitId":"acm000006270jsd","parentDatatypeId":null,"startLine":1329,"endLine":1348,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006240jsd","acm000006241jsd"]},"acm000006243jsd":{"type":"ControlElement","id":"acm000006243jsd","name":"dictify","comment":"","startLine":120,"endLine":124,"calleeNames":["update","zip"]},"acm000006244jsd":{"type":"ControlElement","id":"acm000006244jsd","name":"containsAny","comment":"Check whether string `s` contains ANY of the items in `pat`.","startLine":139,"endLine":141,"calleeNames":["any"]},"acm000006245jsd":{"type":"ControlElement","id":"acm000006245jsd","name":"containsAll","comment":"Check whether string `s` contains ALL of the items in `pat`.","startLine":143,"endLine":145,"calleeNames":["all"]},"acm000006246jsd":{"type":"ControlElement","id":"acm000006246jsd","name":"containsOnly","comment":"Check whether string `s` contains ONLY items in `pat`.\nTODO: Verify this method is STILL faster than os.path.splitext","startLine":147,"endLine":152,"calleeNames":[]},"acm000006247jsd":{"type":"ControlElement","id":"acm000006247jsd","name":"splitext","comment":"Split `path` into a (root, ext) pair. Same as :mod:`os.path.splitext` but faster.","startLine":156,"endLine":167,"calleeNames":["rightmost_separator","rfind","isdigit"]},"acm000006248jsd":{"type":"ControlElement","id":"acm000006248jsd","name":"updrive","comment":"Make the drive letter (if any) upper case. This is useful because Windows is inconsistent on the case of the drive letter, which can cause inconsistencies when calculating command signatures.","startLine":169,"endLine":179,"calleeNames":["splitdrive","upper"]},"acm000006249jsd":{"type":"ControlElement","id":"acm000006249jsd","name":"render_tree","comment":"Render a tree of nodes into an ASCII tree view. Args: root: the root node of the tree child_func: the function called to get the children of a node prune: don't visit the same node twice margin: the format of the left margin to use for children of *root*. Each entry represents a column where a true value will display a vertical bar and a false one a blank. visited: a dictionary of visited nodes in the current branch if *prune* is false, or in the whole tree if *prune* is true.","startLine":252,"endLine":298,"calleeNames":["str","child_func","copy","enumerate","append","len","render_tree","pop"]},"acm000006250jsd":{"type":"ControlElement","id":"acm000006250jsd","name":"IDX","comment":"Generate in index into strings from the tree legends. These are always a choice between two, so bool works fine.\nunicode line drawing chars:","startLine":300,"endLine":305,"calleeNames":["bool"]},"acm000006251jsd":{"type":"ControlElement","id":"acm000006251jsd","name":"print_tree","comment":"Print a tree of nodes. This is like func:`render_tree`, except it prints lines directly instead of creating a string representation in memory, so that huge trees can be handled. Args: root: the root node of the tree child_func: the function called to get the children of a node prune: don't visit the same node twice showtags: print status information to the left of each node line The default is false (value 0). A value of 2 will also print a legend for the margin tags. margin: the format of the left margin to use for children of *root*. Each entry represents a column, where a true value will display a vertical bar and a false one a blank. visited: a dictionary of visited nodes in the current branch if *prune* is false, or in the whole tree if *prune* is true. lastChild: this is the last leaf of a branch singleLineDraw: use line-drawing characters rather than ASCII.","startLine":320,"endLine":447,"calleeNames":["str","write","IDX","exists","rexists","has_explicit_builder","has_builder","is_up_to_date","list","map","child_func","join","append","print_tree","len","pop"]},"acm000006252jsd":{"type":"ControlElement","id":"acm000006252jsd","name":"do_flatten","comment":"pylint: disable=redefined-outer-name,redefined-builtin","startLine":450,"endLine":461,"calleeNames":["isinstance","append","do_flatten"]},"acm000006253jsd":{"type":"ControlElement","id":"acm000006253jsd","name":"flatten","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nFlatten a sequence to a non-nested list. Converts either a single scalar or a nested sequence to a non-nested list. Note that :func:`flatten` considers strings to be scalars instead of sequences like pure Python would.","startLine":464,"endLine":485,"calleeNames":["isinstance","append","do_flatten"]},"acm000006254jsd":{"type":"ControlElement","id":"acm000006254jsd","name":"flatten_sequence","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nFlatten a sequence to a non-nested list. Same as :func:`flatten`, but it does not handle the single scalar case. This is slightly more efficient when one knows that the sequence to flatten can not be a scalar.","startLine":488,"endLine":507,"calleeNames":["isinstance","append","do_flatten"]},"acm000006255jsd":{"type":"ControlElement","id":"acm000006255jsd","name":"semi_deepcopy_dict","comment":"","startLine":523,"endLine":526,"calleeNames":["semi_deepcopy","items"]},"acm000006256jsd":{"type":"ControlElement","id":"acm000006256jsd","name":"_semi_deepcopy_list","comment":"","startLine":528,"endLine":529,"calleeNames":["semi_deepcopy"]},"acm000006257jsd":{"type":"ControlElement","id":"acm000006257jsd","name":"_semi_deepcopy_tuple","comment":"","startLine":531,"endLine":532,"calleeNames":["tuple","map"]},"acm000006258jsd":{"type":"ControlElement","id":"acm000006258jsd","name":"semi_deepcopy","comment":"","startLine":541,"endLine":555,"calleeNames":["get","type","copier","hasattr","callable","__semi_deepcopy__","isinstance","__class__","semi_deepcopy_dict","_semi_deepcopy_list"]},"acm000006259jsd":{"type":"ControlElement","id":"acm000006259jsd","name":"Split","comment":"Returns a list of file names or other objects. If *arg* is a string, it will be split on whitespace within the string. If *arg* is already a list, the list will be returned untouched. If *arg* is any other type of object, it will be returned in a single-item list. >>> print(Split(\" this is a string \")) ['this', 'is', 'a', 'string'] >>> print(Split([\"stringlist\", \" preserving \", \" spaces \"])) ['stringlist', ' preserving ', ' spaces ']","startLine":847,"endLine":866,"calleeNames":["is_List","is_Tuple","is_String","split"]},"acm000006260jsd":{"type":"ControlElement","id":"acm000006260jsd","name":"adjustixes","comment":"Adjust filename prefixes and suffixes as needed. Add `prefix` to `fname` if specified. Add `suffix` to `fname` if specified and if `ensure_suffix` is ``True``\nHandle the odd case where the filename = the prefix.\nIn that case, we still want to add the prefix to the file\nOnly append a suffix if the suffix we're going to add isn't already\nthere, and if either we've been asked to ensure the specific suffix\nis present or there's no suffix on it at all.\nAlso handle the odd case where the filename = the suffix.\nin that case we still want to append the suffix\nFrom Tim Peters,\nhttps://code.activestate.com/recipes/52560\nASPN: Python Cookbook: Remove duplicates from a sequence\n(Also in the printed Python Cookbook.)\nUpdated. This algorithm is used by some scanners and tools.","startLine":971,"endLine":993,"calleeNames":["split","normpath","startswith","join","endswith","splitext"]},"acm000006261jsd":{"type":"ControlElement","id":"acm000006261jsd","name":"unique","comment":"Return a list of the elements in seq without duplicates, ignoring order. For best speed, all sequence elements should be hashable. Then :func:`unique` will usually work in linear time. If not possible, the sequence elements should enjoy a total ordering, and if ``list(s).sort()`` doesn't raise ``TypeError`` it is assumed that they do enjoy a total ordering. Then :func:`unique` will usually work in O(N*log2(N)) time. If that's not possible either, the sequence elements must support equality-testing. Then :func:`unique` will usually work in quadratic time. >>> mylist = unique([1, 2, 3, 1, 2, 3]) >>> print(sorted(mylist)) [1, 2, 3] >>> mylist = unique(\"abcabc\") >>> print(sorted(mylist)) ['a', 'b', 'c'] >>> mylist = unique(([1, 2], [2, 3], [1, 2])) >>> print(sorted(mylist)) [[1, 2], [2, 3]]\nTry using a dict first, as that's the fastest and will usually\nwork. If it doesn't work, it will usually fail quickly, so it\nusually doesn't cost much to *try* it. It requires that all the\nsequence elements be hashable, and support equality comparison.\nTODO: should be even faster: return(list(set(seq)))\nWe couldn't hash all the elements (got a TypeError).\nNext fastest is to sort, which brings the equal elements together;\nthen duplicates are easy to weed out in a single pass.\nNOTE: Python's list.sort() was designed to be efficient in the\npresence of many duplicate elements. This isn't true of all\nsort functions in all languages or libraries, so this approach\nis more effective in Python than it may be elsewhere.","startLine":1002,"endLine":1065,"calleeNames":["suppress","list","fromkeys","len","sorted","append"]},"acm000006262jsd":{"type":"ControlElement","id":"acm000006262jsd","name":"uniquer_hashables","comment":"Recipe 19.11 \"Reading Lines with Continuation Characters\",\nby Alex Martelli, straight from the Python CookBook (2nd edition).","startLine":1070,"endLine":1071,"calleeNames":["list","fromkeys"]},"acm000006263jsd":{"type":"ControlElement","id":"acm000006263jsd","name":"logical_lines","comment":"","startLine":1075,"endLine":1089,"calleeNames":["rstrip","endswith","append","joiner"]},"acm000006264jsd":{"type":"ControlElement","id":"acm000006264jsd","name":"make_path_relative","comment":"Converts an absolute path name to a relative pathname.","startLine":1254,"endLine":1266,"calleeNames":["isabs","splitdrive","compile","findall"]},"acm000006265jsd":{"type":"ControlElement","id":"acm000006265jsd","name":"silent_intern","comment":"Intern a string without failing. Perform :mod:`sys.intern` on the passed argument and return the result. If the input is ineligible for interning the original argument is returned and no exception is thrown.","startLine":1269,"endLine":1279,"calleeNames":["intern"]},"acm000006266jsd":{"type":"ControlElement","id":"acm000006266jsd","name":"cmp","comment":"A cmp function because one is no longer available in Python3.","startLine":1282,"endLine":1284,"calleeNames":[]},"acm000006267jsd":{"type":"ControlElement","id":"acm000006267jsd","name":"print_time","comment":"Hack to return a value from Main if can't import Main.\nthis specifically violates the rule of Util not depending on other\nparts of SCons in order to work around other import-loop issues.\n\npylint: disable=redefined-outer-name,import-outside-toplevel","startLine":1287,"endLine":1294,"calleeNames":[]},"acm000006268jsd":{"type":"ControlElement","id":"acm000006268jsd","name":"wait_for_process_to_die","comment":"Wait for specified process to die, or alternatively kill it NOTE: This function operates best with psutil pypi package TODO: Add timeout which raises exception\nwait for the process to fully killed\npylint: disable=import-outside-toplevel\nif psutil is not installed we can do this the hard way\npylint: disable=import-outside-toplevel\nFrom: https://stackoverflow.com/questions/1741972/how-to-use-different-formatters-with-the-same-logging-handler-in-python","startLine":1297,"endLine":1326,"calleeNames":["process_iter","sleep","OpenProcess","CloseHandle","kill"]},"acm000006269jsd":{"type":"ControlElement","id":"acm000006269jsd","name":"sanitize_shell_env","comment":"Sanitize all values in *execution_env* The execution environment (typically comes from ``env['ENV']``) is propagated to the shell, and may need to be cleaned first. Args: execution_env: The shell environment variables to be propagated to the spawned shell. Returns: sanitized dictionary of env variables (similar to what you'd get from :data:`os.environ`)\nEnsure that the ENV values are all strings:","startLine":1351,"endLine":1380,"calleeNames":["items","is_List","flatten_sequence","join","map","str"]},"acm000006270jsd":{"type":"CodeCompilationUnit","id":"acm000006270jsd","name":"__init__","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons utility functions This package contains routines for use by other parts of SCons. Candidates for inclusion here are routines that do not need other parts of SCons (other than Util), and have a reasonable chance of being useful in multiple places, rather then being topical only to one module/package.\nWarning: SCons.Util may not be able to import other parts of SCons\nglobally without hitting import loops, as various modules import\nSCons.Util themselves. If a top-level import fails, try a local import.\nIf local imports work, please annotate them for pylint (and for human\nreaders) to know why, with:\nimportstuff # pylint: disable=import-outside-toplevel\n\nBe aware that Black will break this if the annotated line is too long -\nwhich it almost certainly will be. It will split it like this:\nfrom SCons.Errors import (\nSConsEnvironmentError,\n) # pylint: disable=import-outside-toplevel\nThat's syntactically valid as far as Python goes, but pylint will not\nrecorgnize the annotation comment unless it's on the first line, like:\nfrom SCons.Errors import ( # pylint: disable=import-outside-toplevel\nSConsEnvironmentError,\n)\n(issue filed on this upstream, for now just be aware)\nUtil split into a package. Make sure things that used to work\nwhen importing just Util itself still work:","parentId":"acm000006271jsd","content":["acm000006186jsd","acm000006189jsd","acm000006194jsd","acm000006197jsd","acm000006203jsd","acm000006205jsd","acm000006208jsd","acm000006234jsd","acm000006239jsd","acm000006242jsd","acm000006243jsd","acm000006244jsd","acm000006245jsd","acm000006246jsd","acm000006247jsd","acm000006248jsd","acm000006249jsd","acm000006250jsd","acm000006251jsd","acm000006252jsd","acm000006253jsd","acm000006254jsd","acm000006255jsd","acm000006256jsd","acm000006257jsd","acm000006258jsd","acm000006259jsd","acm000006260jsd","acm000006261jsd","acm000006262jsd","acm000006263jsd","acm000006264jsd","acm000006265jsd","acm000006266jsd","acm000006267jsd","acm000006268jsd","acm000006269jsd"],"pathElements":["Util"],"extension":"py","language":"PYTHON3","importedModuleNames":["copy","hashlib","logging","os","re","sys","time","collections.UserDict","collections.UserList","collections.deque","contextlib.suppress","types.MethodType","types.FunctionType","typing.Optional","typing.Union","typing.Any","typing.List","logging.Formatter","sctypes.DictTypes","sctypes.ListTypes","sctypes.SequenceTypes","sctypes.StringTypes","sctypes.BaseStringTypes","sctypes.Null","sctypes.NullSeq","sctypes.is_Dict","sctypes.is_List","sctypes.is_Sequence","sctypes.is_Tuple","sctypes.is_String","sctypes.is_Scalar","sctypes.to_String","sctypes.to_String_for_subst","sctypes.to_String_for_signature","sctypes.to_Text","sctypes.to_bytes","sctypes.to_str","sctypes.get_env_bool","sctypes.get_os_env_bool","sctypes.get_environment_var","hashes.ALLOWED_HASH_FORMATS","hashes.DEFAULT_HASH_FORMATS","hashes.get_hash_format","hashes.set_hash_format","hashes.get_current_hash_algorithm_used","hashes.hash_signature","hashes.hash_file_signature","hashes.hash_collect","hashes.MD5signature","hashes.MD5filesignature","hashes.MD5collect","envs.MethodWrapper","envs.PrependPath","envs.AppendPath","envs.AddPathIfNotExists","envs.AddMethod","filelock.FileLock","filelock.SConsLockFailure","SCons.Script.Main.print_time"]},"acm000006271jsd":{"type":"CodePackage","id":"acm000006271jsd","name":"Util","comment":"","parentId":null,"content":["acm000006018jsd","acm000006027jsd","acm000006042jsd","acm000006073jsd","acm000006074jsd","acm000006094jsd","acm000006179jsd","acm000006270jsd"]},"acm000006272jsd":{"type":"ControlElement","id":"acm000006272jsd","name":"rearrange_cache_entries","comment":"Move cache files if prefix length changed. Move the existing cache files to new directories of the appropriate name length and clean up the old directories.","startLine":41,"endLine":65,"calleeNames":["print","set","iglob","join","basename","upper","add","mkdir","rename","rmdir"]},"acm000006273jsd":{"type":"ControlElement","id":"acm000006273jsd","name":"main","comment":"","startLine":93,"endLine":168,"calleeNames":["ArgumentParser","add_argument","replace","dict","vars","items","parse_args","isdir","RuntimeError","chdir","exists","range","set","issubset","listdir","open","load","get","print","dumps","walk","len","dump"]},"acm000006274jsd":{"type":"CodeCompilationUnit","id":"acm000006274jsd","name":"ConfigureCache","comment":"! /usr/bin/env python\n\nSCons - a Software Constructor\n\nMIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nShow or convert the configuration of an SCons cache directory. A cache of derived files is stored by file signature. The files are split into directories named by the first few digits of the signature. The prefix length used for directory names can be changed by this script.","parentId":"acm000006296jsd","content":["acm000006272jsd","acm000006273jsd"],"pathElements":["Utilities"],"extension":"py","language":"PYTHON3","importedModuleNames":["argparse","glob","json","os"]},"acm000006275jsd":{"type":"ControlElement","id":"acm000006275jsd","name":"__setitem__","comment":"","startLine":57,"endLine":59,"calleeNames":[]},"acm000006276jsd":{"type":"ControlElement","id":"acm000006276jsd","name":"__getitem__","comment":"","startLine":61,"endLine":62,"calleeNames":["get"]},"acm000006277jsd":{"type":"ClassUnit","id":"acm000006277jsd","name":"Flagger","comment":"","compilationUnitId":"acm000006294jsd","parentDatatypeId":null,"startLine":54,"endLine":62,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006275jsd","acm000006276jsd"]},"acm000006278jsd":{"type":"ControlElement","id":"acm000006278jsd","name":"__init__","comment":"","startLine":267,"endLine":269,"calleeNames":[]},"acm000006279jsd":{"type":"ControlElement","id":"acm000006279jsd","name":"__call__","comment":"The *dbm modules stick their own file suffixes on the names\nthat are passed in. This causes us to jump through some\nhoops here.\nTry opening the specified file name. Example:\nSPECIFIED OPENED BY self.dbm.open()\n--------- -------------------------\n.sconsign => .sconsign.dblite\n.sconsign.dblite => .sconsign.dblite.dblite\nThat didn't work, so try opening the base name,\nso that if they actually passed in 'sconsign.dblite'\n(for example), the dbm module will put the suffix back\non for us and open it anyway.\nThat didn't work either. See if the file name\nthey specified even exists (independent of the dbm\nsuffix-mangling).\nthis is a touch only, we don't use it here.\nNope, that file doesn't even exist, so report that\nfact back.","startLine":271,"endLine":328,"calleeNames":["open","splitext","write","exc_info","printentries","sorted","keys"]},"acm000006280jsd":{"type":"ControlElement","id":"acm000006280jsd","name":"printentries","comment":"","startLine":238,"endLine":263,"calleeNames":["write","print","nodeinfo_string","printfield","sorted","keys"]},"acm000006281jsd":{"type":"ClassUnit","id":"acm000006281jsd","name":"Do_SConsignDB","comment":"","compilationUnitId":"acm000006294jsd","parentDatatypeId":null,"startLine":266,"endLine":336,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006278jsd","acm000006279jsd","acm000006280jsd"]},"acm000006282jsd":{"type":"ControlElement","id":"acm000006282jsd","name":"my_whichdb","comment":"","startLine":43,"endLine":51,"calleeNames":["open","whichdb"]},"acm000006283jsd":{"type":"ControlElement","id":"acm000006283jsd","name":"default_mapper","comment":"Stringify an entry that doesn't have an explicit mapping. Args: entry: entry name: field name Returns: str","startLine":74,"endLine":89,"calleeNames":["eval","str"]},"acm000006284jsd":{"type":"ControlElement","id":"acm000006284jsd","name":"map_action","comment":"Stringify an action entry and signature. Args: entry: action entry second argument is not used Returns: str","startLine":92,"endLine":108,"calleeNames":[]},"acm000006285jsd":{"type":"ControlElement","id":"acm000006285jsd","name":"map_timestamp","comment":"Stringify a timestamp entry. Args: entry: timestamp entry second argument is not used Returns: str","startLine":111,"endLine":129,"calleeNames":["ctime","str"]},"acm000006286jsd":{"type":"ControlElement","id":"acm000006286jsd","name":"map_bkids","comment":"Stringify an implicit entry. Args: entry: second argument is not used Returns: str\nadd warning to result rather than direct print so it will line up","startLine":132,"endLine":161,"calleeNames":["len","format","nodeinfo_string","zip","join"]},"acm000006287jsd":{"type":"ControlElement","id":"acm000006287jsd","name":"field","comment":"","startLine":175,"endLine":183,"calleeNames":["get","mapper"]},"acm000006288jsd":{"type":"ControlElement","id":"acm000006288jsd","name":"nodeinfo_raw","comment":"This just formats the dictionary, which we would normally use str() to do, except that we want the keys sorted for deterministic output.","startLine":186,"endLine":201,"calleeNames":["__getstate__","sorted","keys","append","repr","get","join"]},"acm000006289jsd":{"type":"ControlElement","id":"acm000006289jsd","name":"nodeinfo_cooked","comment":"","startLine":204,"endLine":218,"calleeNames":["repr","field","join"]},"acm000006290jsd":{"type":"ControlElement","id":"acm000006290jsd","name":"printfield","comment":"","startLine":224,"endLine":235,"calleeNames":["field","print"]},"acm000006291jsd":{"type":"ControlElement","id":"acm000006291jsd","name":"printentries","comment":"","startLine":238,"endLine":263,"calleeNames":["write","print","nodeinfo_string","printfield","sorted","keys"]},"acm000006292jsd":{"type":"ControlElement","id":"acm000006292jsd","name":"Do_SConsignDir","comment":"#############################################################################","startLine":339,"endLine":357,"calleeNames":["open","Dir","write","printentries"]},"acm000006293jsd":{"type":"ControlElement","id":"acm000006293jsd","name":"main","comment":"","startLine":361,"endLine":481,"calleeNames":["getopt","write","str","print","exit","append","get","import_module","Do_SConsignDB","Do_Call","my_whichdb","Do_SConsignDir"]},"acm000006294jsd":{"type":"CodeCompilationUnit","id":"acm000006294jsd","name":"sconsign","comment":"! /usr/bin/env python\n\nSCons - a Software Constructor\n\nMIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nUtility script to dump information from SCons signature database.","parentId":"acm000006296jsd","content":["acm000006277jsd","acm000006281jsd","acm000006282jsd","acm000006283jsd","acm000006284jsd","acm000006285jsd","acm000006286jsd","acm000006287jsd","acm000006288jsd","acm000006289jsd","acm000006290jsd","acm000006291jsd","acm000006292jsd","acm000006293jsd"],"pathElements":["Utilities"],"extension":"py","language":"PYTHON3","importedModuleNames":["getopt","importlib","os","sys","dbm.whichdb","time","pickle","SCons.compat","SCons.SConsign"]},"acm000006295jsd":{"type":"CodeCompilationUnit","id":"acm000006295jsd","name":"__init__","comment":"","parentId":"acm000006296jsd","content":[],"pathElements":["Utilities"],"extension":"py","language":"PYTHON3","importedModuleNames":[]},"acm000006296jsd":{"type":"CodePackage","id":"acm000006296jsd","name":"Utilities","comment":"","parentId":null,"content":["acm000006274jsd","acm000006294jsd","acm000006295jsd"]},"acm000006297jsd":{"type":"ControlElement","id":"acm000006297jsd","name":"_text2bool","comment":"Convert boolean-like string to boolean. If *val* looks like it expresses a bool-like value, based on the :const:`TRUE_STRINGS` and :const:`FALSE_STRINGS` tuples, return the appropriate value. This is usable as a converter function for SCons Variables. Raises: ValueError: if *val* cannot be converted to boolean.","startLine":45,"endLine":63,"calleeNames":["lower","ValueError"]},"acm000006298jsd":{"type":"ControlElement","id":"acm000006298jsd","name":"_validator","comment":"Validate that the value of *key* in *env* is a boolean. Parmaeter *val* is not used in the check. Usable as a validator function for SCons Variables. Raises: KeyError: if *key* is not set in *env* UserError: if the value of *key* is not ``True`` or ``False``.","startLine":66,"endLine":80,"calleeNames":["UserError"]},"acm000006299jsd":{"type":"ControlElement","id":"acm000006299jsd","name":"BoolVariable","comment":"Return a tuple describing a boolean SCons Variable. The input parameters describe a boolean option. Returns a tuple including the correct converter and validator. The *help* text will have ``(yes|no)`` automatically appended to show the valid values. The result is usable as input to :meth:`Add`.","startLine":83,"endLine":92,"calleeNames":[]},"acm000006300jsd":{"type":"CodeCompilationUnit","id":"acm000006300jsd","name":"BoolVariable","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nVariable type for true/false Variables. Usage example:: opts = Variables() opts.Add(BoolVariable('embedded', 'build for an embedded system', False)) ... if env['embedded']: ...","parentId":"acm000006394jsd","content":["acm000006297jsd","acm000006298jsd","acm000006299jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["typing.Tuple","typing.Callable","SCons.Errors"]},"acm000006301jsd":{"type":"ControlElement","id":"acm000006301jsd","name":"test_BoolVariable","comment":"Test BoolVariable creation","startLine":30,"endLine":40,"calleeNames":["Variables","Add","BoolVariable"]},"acm000006302jsd":{"type":"ControlElement","id":"acm000006302jsd","name":"test_converter","comment":"Test the BoolVariable converter","startLine":42,"endLine":81,"calleeNames":["Variables","Add","BoolVariable","converter"]},"acm000006303jsd":{"type":"ControlElement","id":"acm000006303jsd","name":"test_validator","comment":"Test the BoolVariable validator","startLine":83,"endLine":113,"calleeNames":["Variables","Add","BoolVariable","validator"]},"acm000006304jsd":{"type":"ClassUnit","id":"acm000006304jsd","name":"BoolVariableTestCase","comment":"","compilationUnitId":"acm000006305jsd","parentDatatypeId":null,"startLine":29,"endLine":113,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006301jsd","acm000006302jsd","acm000006303jsd"]},"acm000006305jsd":{"type":"CodeCompilationUnit","id":"acm000006305jsd","name":"BoolVariableTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000006394jsd","content":["acm000006304jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.Errors","SCons.Variables"]},"acm000006306jsd":{"type":"ControlElement","id":"acm000006306jsd","name":"_validator","comment":"","startLine":53,"endLine":56,"calleeNames":["UserError"]},"acm000006307jsd":{"type":"ControlElement","id":"acm000006307jsd","name":"EnumVariable","comment":"Return a tuple describing an enumaration SCons Variable. The input parameters describe an option with only certain values allowed. Returns A tuple including an appropriate converter and validator. The result is usable as input to :meth:`Add`. *key* and *default* are passed directly on to :meth:`Add`. *help* is the descriptive part of the help text, and will have the allowed values automatically appended. *allowed_values* is a list of strings, which are the allowed values for this option. The *map*-dictionary may be used for converting the input value into canonical values (e.g. for aliases). The value of *ignorecase* defines the behaviour of the validator: * 0: the validator/converter are case-sensitive. * 1: the validator/converter are case-insensitive. * 2: the validator/converter is case-insensitive and the converted value will always be lower-case. The *validator* tests whether the value is in the list of allowed values. The *converter* converts input values according to the given *map*-dictionary (unmapped input values are returned unchanged).","startLine":59,"endLine":104,"calleeNames":["join","_validator","lower","get"]},"acm000006308jsd":{"type":"CodeCompilationUnit","id":"acm000006308jsd","name":"EnumVariable","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nVariable type for enumeration Variables. Enumeration variables allow selection of one from a specified set of values. Usage example:: opts = Variables() opts.Add( EnumVariable( 'debug', help='debug output and symbols', default='no', allowed_values=('yes', 'no', 'full'), map={}, ignorecase=2, ) ) ... if env['debug'] == 'full': ...","parentId":"acm000006394jsd","content":["acm000006306jsd","acm000006307jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["typing.Tuple","typing.Callable","SCons.Errors"]},"acm000006309jsd":{"type":"ControlElement","id":"acm000006309jsd","name":"test_EnumVariable","comment":"Test EnumVariable creation","startLine":30,"endLine":42,"calleeNames":["Variables","Add","EnumVariable"]},"acm000006310jsd":{"type":"ControlElement","id":"acm000006310jsd","name":"test_converter","comment":"Test the EnumVariable converter","startLine":44,"endLine":128,"calleeNames":["Variables","Add","EnumVariable","converter","items"]},"acm000006311jsd":{"type":"ControlElement","id":"acm000006311jsd","name":"test_validator","comment":"Test the EnumVariable validator","startLine":130,"endLine":189,"calleeNames":["Variables","Add","EnumVariable","validator","items"]},"acm000006312jsd":{"type":"ClassUnit","id":"acm000006312jsd","name":"EnumVariableTestCase","comment":"","compilationUnitId":"acm000006313jsd","parentDatatypeId":null,"startLine":29,"endLine":189,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006309jsd","acm000006310jsd","acm000006311jsd"]},"acm000006313jsd":{"type":"CodeCompilationUnit","id":"acm000006313jsd","name":"EnumVariableTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000006394jsd","content":["acm000006312jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.Errors","SCons.Variables"]},"acm000006314jsd":{"type":"ControlElement","id":"acm000006314jsd","name":"__init__","comment":"","startLine":64,"endLine":70,"calleeNames":["super","__init__","sorted"]},"acm000006315jsd":{"type":"ControlElement","id":"acm000006315jsd","name":"__cmp__","comment":"","startLine":72,"endLine":73,"calleeNames":[]},"acm000006316jsd":{"type":"ControlElement","id":"acm000006316jsd","name":"__eq__","comment":"","startLine":75,"endLine":76,"calleeNames":[]},"acm000006317jsd":{"type":"ControlElement","id":"acm000006317jsd","name":"__ge__","comment":"","startLine":78,"endLine":79,"calleeNames":[]},"acm000006318jsd":{"type":"ControlElement","id":"acm000006318jsd","name":"__gt__","comment":"","startLine":81,"endLine":82,"calleeNames":[]},"acm000006319jsd":{"type":"ControlElement","id":"acm000006319jsd","name":"__le__","comment":"","startLine":84,"endLine":85,"calleeNames":[]},"acm000006320jsd":{"type":"ControlElement","id":"acm000006320jsd","name":"__lt__","comment":"","startLine":87,"endLine":88,"calleeNames":[]},"acm000006321jsd":{"type":"ControlElement","id":"acm000006321jsd","name":"__str__","comment":"","startLine":90,"endLine":97,"calleeNames":["len","sort","join"]},"acm000006322jsd":{"type":"ControlElement","id":"acm000006322jsd","name":"prepare_to_store","comment":"","startLine":99,"endLine":100,"calleeNames":["__str__"]},"acm000006323jsd":{"type":"ClassUnit","id":"acm000006323jsd","name":"_ListVariable","comment":"","compilationUnitId":"acm000006326jsd","parentDatatypeId":null,"startLine":63,"endLine":100,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006314jsd","acm000006315jsd","acm000006316jsd","acm000006317jsd","acm000006318jsd","acm000006319jsd","acm000006320jsd","acm000006321jsd","acm000006322jsd"]},"acm000006324jsd":{"type":"ControlElement","id":"acm000006324jsd","name":"_converter","comment":"def _validator(key, val, env) -> None:\n\n# TODO: write validator for pgk list\npass","startLine":102,"endLine":116,"calleeNames":["split","get","ValueError","join","_ListVariable"]},"acm000006325jsd":{"type":"ControlElement","id":"acm000006325jsd","name":"ListVariable","comment":"Return a tuple describing a list SCons Variable. The input parameters describe a 'list' option. Returns a tuple including the correct converter and validator. The result is usable for input to :meth:`Add`. *help* will have text appended indicating the legal values (not including any extra names from *map*). *map* can be used to map alternative names to the ones in *names* - that is, a form of alias. A 'list' option may either be 'all', 'none' or a list of names (separated by commas).","startLine":125,"endLine":146,"calleeNames":["join","is_List","_converter"]},"acm000006326jsd":{"type":"CodeCompilationUnit","id":"acm000006326jsd","name":"ListVariable","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nVariable type for list Variables. A 'list' option may either be 'all', 'none' or a list of names separated by comma. After the option has been processed, the option value holds either the named list elements, all list elements or no list elements at all. Usage example:: list_of_libs = Split('x11 gl qt ical') opts = Variables() opts.Add( ListVariable( 'shared', help='libraries to build as shared libraries', default='all', elems=list_of_libs, ) ) ... for lib in list_of_libs: if lib in env['shared']: env.SharedObject(...) else: env.Object(...)\nKnown Bug: This should behave like a Set-Type, but does not really,\nsince elements can occur twice.","parentId":"acm000006394jsd","content":["acm000006323jsd","acm000006324jsd","acm000006325jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["collections","typing.Tuple","typing.Callable","SCons.Util"]},"acm000006327jsd":{"type":"ControlElement","id":"acm000006327jsd","name":"test_ListVariable","comment":"Test ListVariable creation","startLine":31,"endLine":50,"calleeNames":["Variables","Add","ListVariable","repr"]},"acm000006328jsd":{"type":"ControlElement","id":"acm000006328jsd","name":"test_converter","comment":"Test the ListVariable converter","startLine":52,"endLine":109,"calleeNames":["Variables","Add","ListVariable","converter","str"]},"acm000006329jsd":{"type":"ControlElement","id":"acm000006329jsd","name":"test_copy","comment":"Test copying a ListVariable like an Environment would","startLine":111,"endLine":120,"calleeNames":["Variables","Add","ListVariable","converter","__class__","copy"]},"acm000006330jsd":{"type":"ClassUnit","id":"acm000006330jsd","name":"ListVariableTestCase","comment":"","compilationUnitId":"acm000006331jsd","parentDatatypeId":null,"startLine":30,"endLine":120,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006327jsd","acm000006328jsd","acm000006329jsd"]},"acm000006331jsd":{"type":"CodeCompilationUnit","id":"acm000006331jsd","name":"ListVariableTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000006394jsd","content":["acm000006330jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["copy","unittest","SCons.Errors","SCons.Variables"]},"acm000006332jsd":{"type":"ControlElement","id":"acm000006332jsd","name":"_converter","comment":"","startLine":62,"endLine":69,"calleeNames":["lower"]},"acm000006333jsd":{"type":"ControlElement","id":"acm000006333jsd","name":"_validator","comment":"NB: searchfunc is currently undocumented and unsupported\nTODO write validator, check for path","startLine":72,"endLine":83,"calleeNames":["searchfunc","exists","UserError"]},"acm000006334jsd":{"type":"ControlElement","id":"acm000006334jsd","name":"PackageVariable","comment":"Return a tuple describing a package list SCons Variable. The input parameters describe a 'package list' option. Returns a tuple including the correct converter and validator appended. The result is usable as input to :meth:`Add` . A 'package list' option may either be 'all', 'none' or a pathname string. This information is appended to *help*.\nNB: searchfunc is currently undocumented and unsupported","startLine":86,"endLine":101,"calleeNames":["join","_validator"]},"acm000006335jsd":{"type":"CodeCompilationUnit","id":"acm000006335jsd","name":"PackageVariable","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nVariable type for package Variables. To be used whenever a 'package' may be enabled/disabled and the package path may be specified. Given these options :: x11=no (disables X11 support) x11=yes (will search for the package installation dir) x11=/usr/local/X11 (will check this path for existence) Can be used as a replacement for autoconf's ``--with-xxx=yyy`` :: opts = Variables() opts.Add( PackageVariable( key='x11', help='use X11 installed here (yes = search some places)', default='yes' ) ) ... if env['x11'] == True: dir = ... # search X11 in some standard places ... env['x11'] = dir if env['x11']: ... # build with x11 ...","parentId":"acm000006394jsd","content":["acm000006332jsd","acm000006333jsd","acm000006334jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["typing.Tuple","typing.Callable","SCons.Errors","os"]},"acm000006336jsd":{"type":"ControlElement","id":"acm000006336jsd","name":"test_PackageVariable","comment":"Test PackageVariable creation","startLine":32,"endLine":42,"calleeNames":["Variables","Add","PackageVariable","repr"]},"acm000006337jsd":{"type":"ControlElement","id":"acm000006337jsd","name":"test_converter","comment":"Test the PackageVariable converter","startLine":44,"endLine":83,"calleeNames":["Variables","Add","PackageVariable","converter","str"]},"acm000006338jsd":{"type":"ControlElement","id":"acm000006338jsd","name":"test_validator","comment":"Test the PackageVariable validator","startLine":85,"endLine":109,"calleeNames":["Variables","Add","PackageVariable","TestCmd","write","workpath","validator"]},"acm000006339jsd":{"type":"ClassUnit","id":"acm000006339jsd","name":"PackageVariableTestCase","comment":"","compilationUnitId":"acm000006340jsd","parentDatatypeId":null,"startLine":31,"endLine":109,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006336jsd","acm000006337jsd","acm000006338jsd"]},"acm000006340jsd":{"type":"CodeCompilationUnit","id":"acm000006340jsd","name":"PackageVariableTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000006394jsd","content":["acm000006339jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.Errors","SCons.Variables","TestCmd"]},"acm000006341jsd":{"type":"ControlElement","id":"acm000006341jsd","name":"PathAccept","comment":"Accepts any path, no checking done.","startLine":86,"endLine":88,"calleeNames":[]},"acm000006342jsd":{"type":"ControlElement","id":"acm000006342jsd","name":"PathIsDir","comment":"Validator to check if Path is a directory.","startLine":91,"endLine":98,"calleeNames":["isdir","isfile","UserError"]},"acm000006343jsd":{"type":"ControlElement","id":"acm000006343jsd","name":"PathIsDirCreate","comment":"Validator to check if Path is a directory, creating it if it does not exist.","startLine":101,"endLine":111,"calleeNames":["makedirs","UserError"]},"acm000006344jsd":{"type":"ControlElement","id":"acm000006344jsd","name":"PathIsFile","comment":"Validator to check if Path is a file","startLine":114,"endLine":121,"calleeNames":["isfile","isdir","UserError"]},"acm000006345jsd":{"type":"ControlElement","id":"acm000006345jsd","name":"PathExists","comment":"Validator to check if Path exists","startLine":124,"endLine":128,"calleeNames":["exists","UserError"]},"acm000006346jsd":{"type":"ControlElement","id":"acm000006346jsd","name":"__call__","comment":"Return a tuple describing a path list SCons Variable. The input parameters describe a 'path list' option. Returns a tuple with the correct converter and validator appended. The result is usable for input to :meth:`Add`. The *default* option specifies the default path to use if the user does not specify an override with this option. *validator* is a validator, see this file for examples","startLine":130,"endLine":149,"calleeNames":["is_List","is_Tuple"]},"acm000006347jsd":{"type":"ClassUnit","id":"acm000006347jsd","name":"_PathVariableClass","comment":"","compilationUnitId":"acm000006348jsd","parentDatatypeId":null,"startLine":83,"endLine":149,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006341jsd","acm000006342jsd","acm000006343jsd","acm000006344jsd","acm000006345jsd","acm000006346jsd"]},"acm000006348jsd":{"type":"CodeCompilationUnit","id":"acm000006348jsd","name":"PathVariable","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nVariable type for path Variables. To be used whenever a user-specified path override setting should be allowed. Arguments to PathVariable are: * *key* - name of this option on the command line (e.g. \"prefix\") * *help* - help string for option * *default* - default value for this option * *validator* - [optional] validator for option value. Predefined are: * *PathAccept* - accepts any path setting; no validation * *PathIsDir* - path must be an existing directory * *PathIsDirCreate* - path must be a dir; will create * *PathIsFile* - path must be a file * *PathExists* - path must exist (any type) [default] The *validator* is a function that is called and which should return True or False to indicate if the path is valid. The arguments to the validator function are: (*key*, *val*, *env*). *key* is the name of the option, *val* is the path specified for the option, and *env* is the environment to which the Options have been added. Usage example:: opts = Variables() opts.Add( PathVariable( 'qtdir', help='where the root of Qt is installed', default=qtdir, validator=PathIsDir, ) ) opts.Add( PathVariable( 'qt_includes', help='where the Qt includes are installed', default='$qtdir/includes', validator=PathIsDirCreate, ) ) opts.Add( PathVariable( 'qt_libraries', help='where the Qt library is installed', default='$qtdir/lib', ) )","parentId":"acm000006394jsd","content":["acm000006347jsd"],"pathElements":["Variables"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","os.path","typing.Tuple","typing.Callable","SCons.Errors"]},"acm000006349jsd":{"type":"ControlElement","id":"acm000006349jsd","name":"test_PathVariable","comment":"Test PathVariable creation","startLine":33,"endLine":45,"calleeNames":["Variables","Add","PathVariable","repr"]},"acm000006350jsd":{"type":"ControlElement","id":"acm000006350jsd","name":"test_PathExists","comment":"Test the PathExists validator","startLine":47,"endLine":68,"calleeNames":["Variables","Add","PathVariable","TestCmd","write","validator","workpath","str","Exception"]},"acm000006351jsd":{"type":"ControlElement","id":"acm000006351jsd","name":"test_PathIsDir","comment":"Test the PathIsDir validator","startLine":70,"endLine":100,"calleeNames":["Variables","Add","PathVariable","TestCmd","subdir","write","validator","workpath","str","Exception"]},"acm000006352jsd":{"type":"ControlElement","id":"acm000006352jsd","name":"test_PathIsDirCreate","comment":"Test the PathIsDirCreate validator","startLine":102,"endLine":133,"calleeNames":["Variables","Add","PathVariable","TestCmd","write","workpath","validator","isdir","str","Exception"]},"acm000006353jsd":{"type":"ControlElement","id":"acm000006353jsd","name":"test_PathIsFile","comment":"Test the PathIsFile validator","startLine":135,"endLine":165,"calleeNames":["Variables","Add","PathVariable","TestCmd","subdir","write","validator","workpath","str","Exception"]},"acm000006354jsd":{"type":"ControlElement","id":"acm000006354jsd","name":"test_PathAccept","comment":"Test the PathAccept validator","startLine":167,"endLine":187,"calleeNames":["Variables","Add","PathVariable","TestCmd","subdir","write","validator","workpath"]},"acm000006355jsd":{"type":"ControlElement","id":"acm000006355jsd","name":"test_validator","comment":"Test the PathVariable validator argument","startLine":189,"endLine":228,"calleeNames":["Variables","Add","PathVariable","TestCmd","write","validator","workpath","str","Exception"]},"acm000006356jsd":{"type":"ClassUnit","id":"acm000006356jsd","name":"PathVariableTestCase","comment":"","compilationUnitId":"acm000006357jsd","parentDatatypeId":null,"startLine":32,"endLine":228,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006349jsd","acm000006350jsd","acm000006351jsd","acm000006352jsd","acm000006353jsd","acm000006354jsd","acm000006355jsd"]},"acm000006357jsd":{"type":"CodeCompilationUnit","id":"acm000006357jsd","name":"PathVariableTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\