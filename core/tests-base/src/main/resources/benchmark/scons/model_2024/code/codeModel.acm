ization for RPCGEN tools. Three normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000002768jsd","content":["acm000002600jsd","acm000002601jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Builder.Builder","SCons.Util"]},"acm000002603jsd":{"type":"ControlElement","id":"acm000002603jsd","name":"get_cmd","comment":"","startLine":49,"endLine":54,"calleeNames":["is_List","get_abspath"]},"acm000002604jsd":{"type":"ControlElement","id":"acm000002604jsd","name":"build_rpm","comment":"create a temporary rpm build root.","startLine":56,"endLine":97,"calleeNames":["join","dirname","get_abspath","exists","rmtree","makedirs","Prepend","Popen","get_cmd","to_str","read","wait","BuildError","str","compile","findall","zip","basename","get_path","copy"]},"acm000002605jsd":{"type":"ControlElement","id":"acm000002605jsd","name":"string_rpm","comment":"","startLine":99,"endLine":103,"calleeNames":["get_cmd"]},"acm000002606jsd":{"type":"ControlElement","id":"acm000002606jsd","name":"generate","comment":"Add Builders and construction variables for rpm to an Environment.","startLine":113,"endLine":124,"calleeNames":["SetDefault","CLVar"]},"acm000002607jsd":{"type":"ControlElement","id":"acm000002607jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":126,"endLine":127,"calleeNames":["Detect"]},"acm000002608jsd":{"type":"CodeCompilationUnit","id":"acm000002608jsd","name":"rpm","comment":"SCons.Tool.rpm Tool-specific initialization for rpm. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method. The rpm tool calls the rpmbuild command. The first and only argument should a tar.gz consisting of the source file and a specfile.\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000002768jsd","content":["acm000002603jsd","acm000002604jsd","acm000002605jsd","acm000002606jsd","acm000002607jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","re","shutil","subprocess","SCons.Builder","SCons.Node.FS","SCons.Util","SCons.Action","SCons.Defaults"]},"acm000002609jsd":{"type":"ControlElement","id":"acm000002609jsd","name":"defaultMachine","comment":"Return the canonicalized machine name.\nThis should be the most reliable way to get the default arch\nSomething went wrong, try again by looking up platform.machine()\nTry to lookup the string in the canon table","startLine":440,"endLine":458,"calleeNames":["check_output","rstrip","to_str","defaultMachine","machine"]},"acm000002610jsd":{"type":"ControlElement","id":"acm000002610jsd","name":"defaultSystem","comment":"Return the canonicalized system name.","startLine":460,"endLine":468,"calleeNames":["system"]},"acm000002611jsd":{"type":"ControlElement","id":"acm000002611jsd","name":"defaultNames","comment":"Return the canonicalized machine and system name.","startLine":470,"endLine":472,"calleeNames":["defaultMachine","defaultSystem"]},"acm000002612jsd":{"type":"ControlElement","id":"acm000002612jsd","name":"updateRpmDicts","comment":"Read the given rpmrc file with RPM definitions and update the info dictionaries in the file pyfile with it. The arguments will usually be 'rpmrc.in' from a recent RPM source tree, and 'rpmutils.py' referring to this script itself. See also usage() below.\nRead old rpmutils.py file\nRead current rpmrc.in file\nParse for data\nAllowed section names that get parsed\nSkip comments\nHave we met this section before?\nNo, so insert it\nInsert data\nWrite new rpmutils.py file\nWrite data sections to single dictionaries","startLine":474,"endLine":532,"calleeNames":["open","readlines","rstrip","replace","lstrip","startswith","strip","split","len","write","items","sorted","keys","join"]},"acm000002613jsd":{"type":"ControlElement","id":"acm000002613jsd","name":"usage","comment":"","startLine":534,"endLine":535,"calleeNames":["print"]},"acm000002614jsd":{"type":"ControlElement","id":"acm000002614jsd","name":"main","comment":"","startLine":537,"endLine":543,"calleeNames":["len","usage","exit","updateRpmDicts"]},"acm000002615jsd":{"type":"CodeCompilationUnit","id":"acm000002615jsd","name":"rpmutils","comment":"SCons.Tool.rpmutils.py RPM specific helper routines for general usage in the test framework and SCons core modules. Since we check for the RPM package target name in several places, we have to know which machine/system name RPM will use for the current hardware setup. The following dictionaries and functions try to mimic the exact naming rules of the RPM source code. They were directly derived from the file \"rpmrc.in\" of the version rpm-4.9.1.3. For updating to a more recent version of RPM, this Python script can be used standalone. The usage() function below shows the exact syntax.\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000002768jsd","content":["acm000002609jsd","acm000002610jsd","acm000002611jsd","acm000002612jsd","acm000002613jsd","acm000002614jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["platform","subprocess","SCons.Util","sys"]},"acm000002616jsd":{"type":"ControlElement","id":"acm000002616jsd","name":"generate","comment":"Add Builders and construction variables for ar to an Environment.","startLine":42,"endLine":59,"calleeNames":["createStaticLibBuilder","Detect","CLVar"]},"acm000002617jsd":{"type":"ControlElement","id":"acm000002617jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":61,"endLine":62,"calleeNames":["Detect"]},"acm000002618jsd":{"type":"CodeCompilationUnit","id":"acm000002618jsd","name":"sgiar","comment":"SCons.Tool.sgiar Tool-specific initialization for SGI ar (library archive). If CC exists, static libraries should be built with it, so the prelinker has a chance to resolve C++ template instantiations. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVID