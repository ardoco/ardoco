    {
      "id": "claim_0024c4904c674073b1fee2c543bc78be",
      "statement": "ARDoCo's goal is to connect architecture documentation and models with Traceability Link Recovery (TLR) while identifying missing or deviating elements (inconsistencies): trace links are created first, then used to detect inconsistencies; recent approaches such as LiSSA leverage LLMs and Information Retrieval for generic TLR.",
      "evidence": [
        {
          "resource": "repo://README.md#L9-L13",
          "version": "repo-lines-v1:sha256:ffaea551207fbf0eadf6f65e3912ba5add1bc6ddac29d3c26962e70682cf8883:"
        },
