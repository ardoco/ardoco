sd":{"type":"ClassUnit","id":"acm000002036jsd","name":"CompDBTEMPFILE","comment":"","compilationUnitId":"acm000002045jsd","parentDatatypeId":null,"startLine":112,"endLine":114,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002035jsd"]},"acm000002037jsd":{"type":"ControlElement","id":"acm000002037jsd","name":"changed_since_last_build_node","comment":"Dummy decider to force always building","startLine":62,"endLine":64,"calleeNames":[]},"acm000002038jsd":{"type":"ControlElement","id":"acm000002038jsd","name":"make_emit_compilation_DB_entry","comment":"Effectively this creates a lambda function to capture: * command line * source * target :param comstr: unevaluated command line :return: an emitter which has captured the above","startLine":67,"endLine":109,"calleeNames":["Action","__CompilationDbNode","__COMPILATIONDB_Entry","AlwaysBuild","NoCache","append"]},"acm000002039jsd":{"type":"ControlElement","id":"acm000002039jsd","name":"compilation_db_entry_action","comment":"Create a dictionary with evaluated command line, target, source and store that info as an attribute on the target (Which has been stored in __COMPILATION_DB_ENTRIES array :param target: target node(s) :param source: source node(s) :param env: Environment for use building this node :param kw: :return: None","startLine":117,"endLine":143,"calleeNames":["strfunction","Dir","write"]},"acm000002040jsd":{"type":"ControlElement","id":"acm000002040jsd","name":"write_compilation_db","comment":"","startLine":146,"endLine":178,"calleeNames":["subst","read","srcnode","fnmatch","append","open","dump","write"]},"acm000002041jsd":{"type":"ControlElement","id":"acm000002041jsd","name":"scan_compilation_db","comment":"","startLine":181,"endLine":182,"calleeNames":[]},"acm000002042jsd":{"type":"ControlElement","id":"acm000002042jsd","name":"compilation_db_emitter","comment":"fix up the source/targets\nSomeone called env.CompilationDatabase('my_targetname.json')\nDefault target name is compilation_db.json\nNo source should have been passed. Drop it.","startLine":185,"endLine":200,"calleeNames":["len"]},"acm000002043jsd":{"type":"ControlElement","id":"acm000002043jsd","name":"generate","comment":"","startLine":203,"endLine":264,"calleeNames":["createObjBuilders","get","chain","product","ListEmitter","make_emit_compilation_DB_entry","Builder","Action","Scanner"]},"acm000002044jsd":{"type":"ControlElement","id":"acm000002044jsd","name":"exists","comment":"","startLine":267,"endLine":268,"calleeNames":[]},"acm000002045jsd":{"type":"CodeCompilationUnit","id":"acm000002045jsd","name":"compilation_db","comment":"MIT License\n\nCopyright 2020 MongoDB Inc.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nCompilation Database Implements the ability for SCons to emit a compilation database for a project. See https://clang.llvm.org/docs/JSONCompilationDatabase.html for details on what a compilation database is, and why you might want one. The only user visible entry point here is ``env.CompilationDatabase``. This method takes an optional *target* to name the file that should hold the compilation database, otherwise, the file defaults to ``compile_commands.json``, the name that most clang tools search for by default.\nTODO: Is there a better way to do this than this global? Right now this exists so that the\nemitter we add can record all of the things it emits, so that the scanner for the top level\ncompilation database can access the complete list, and also so that the writer has easy\naccess to write all of the files. But it seems clunky. How can the emitter and the scanner\ncommunicate more gracefully?","parentId":"acm000002768jsd","content":["acm000002034jsd","acm000002036jsd","acm000002037jsd","acm000002038jsd","acm000002039jsd","acm000002040jsd","acm000002041jsd","acm000002042jsd","acm000002043jsd","acm000002044jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["json","itertools","fnmatch","SCons","SCons.Platform.TempFileMunge","cxx.CXXSuffixes","cc.CSuffixes","asm.ASSuffixes","asm.ASPPSuffixes"]},"acm000002046jsd":{"type":"ControlElement","id":"acm000002046jsd","name":"generate","comment":"Add Builders and construction variables for compaq visual fortran to an Environment.","startLine":36,"endLine":49,"calleeNames":["generate"]},"acm000002047jsd":{"type":"ControlElement","id":"acm000002047jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":51,"endLine":52,"calleeNames":["Detect"]},"acm000002048jsd":{"type":"CodeCompilationUnit","id":"acm000002048jsd","name":"cvf","comment":"SCons.Tool.cvf Tool-specific initialization for the Compaq Visual Fortran compiler.\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout