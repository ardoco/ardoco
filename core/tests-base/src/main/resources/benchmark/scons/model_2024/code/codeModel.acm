ght notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000001981jsd","content":["acm000001968jsd"],"pathElements":["Tool","packaging"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Tool.packaging.stripinstallbuilder","SCons.Tool.packaging.putintopackageroot"]},"acm000001970jsd":{"type":"ControlElement","id":"acm000001970jsd","name":"package","comment":"","startLine":33,"endLine":38,"calleeNames":["set_suffix","stripinstallbuilder","putintopackageroot","bld"]},"acm000001971jsd":{"type":"CodeCompilationUnit","id":"acm000001971jsd","name":"zip","comment":"SCons.Tool.Packaging.zip The zip SRC packager.\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000001981jsd","content":["acm000001970jsd"],"pathElements":["Tool","packaging"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Tool.packaging.stripinstallbuilder","SCons.Tool.packaging.putintopackageroot"]},"acm000001972jsd":{"type":"ControlElement","id":"acm000001972jsd","name":"Tag","comment":"Tag a file with the given arguments. Just sets the accordingly named attribute on the file object. TODO: FIXME\nXXX: sanity checks\nhmm, sometimes the target list is a list of a list\nmake sure it is flattened prior to processing.\nTODO: perhaps some bug ?!?\nall file tags have to start with PACKAGING_, so we can later\ndifferentiate between \"normal\" object attributes and the\npackaging attributes. As the user should not be bothered with\nthat, the prefix will be added here if missing.","startLine":47,"endLine":86,"calleeNames":["UserError","is_List","Flatten","items","startswith","Tag"]},"acm000001973jsd":{"type":"ControlElement","id":"acm000001973jsd","name":"Package","comment":"Entry point for the package tool.\ncheck if we need to find the source files ourselves\ndecide which types of packages shall be built. Can be defined through\nfour mechanisms: command line argument, keyword argument,\nenvironment argument and default selection (zip or tar.gz) in that\norder.","startLine":88,"endLine":195,"calleeNames":["FindInstalledFiles","UserError","get","GetOption","is_List","split","import_module","SConsEnvironmentError","str","load_packager","len","extend","arg2nodes","pop","package","getfullargspec","remove","join","Alias"]},"acm000001974jsd":{"type":"ControlElement","id":"acm000001974jsd","name":"generate","comment":"","startLine":202,"endLine":218,"calleeNames":["AddOption"]},"acm000001975jsd":{"type":"ControlElement","id":"acm000001975jsd","name":"exists","comment":"","startLine":221,"endLine":222,"calleeNames":[]},"acm000001976jsd":{"type":"ControlElement","id":"acm000001976jsd","name":"options","comment":"Internal utility functions\n","startLine":225,"endLine":232,"calleeNames":["AddVariables","EnumVariable","list","map"]},"acm000001977jsd":{"type":"ControlElement","id":"acm000001977jsd","name":"copy_attr","comment":"Copies the special packaging file attributes from f1 to f2.","startLine":238,"endLine":248,"calleeNames":["hasattr","startswith","Tag","GetTag"]},"acm000001978jsd":{"type":"ControlElement","id":"acm000001978jsd","name":"putintopackageroot","comment":"Copies all source files to the directory given in pkgroot. If honor_install_location is set and the copied source file has an PACKAGING_INSTALL_LOCATION attribute, the PACKAGING_INSTALL_LOCATION is used as the new name of the source file under pkgroot. The source file will not be copied if it is already under the the pkgroot directory. All attributes of the source file will be copied to the new file. Note: Uses CopyAs builder.\nmake sure the packageroot is a Dir object.","startLine":250,"endLine":290,"calleeNames":["is_String","Dir","is_List","File","is_under","append","GetTag","make_path_relative","get_path","CopyAs","copy_attr"]},"acm000001979jsd":{"type":"ControlElement","id":"acm000001979jsd","name":"stripinstallbuilder","comment":"Strips the install builder action from the source list and stores the final installation location as the \"PACKAGING_INSTALL_LOCATION\" of the source of the source file. This effectively removes the final installed files from the source list while remembering the installation location. It also warns about files which have no install builder attached.","startLine":293,"endLine":322,"calleeNames":["has_builder","hasattr","len","has_no_install_location","warn","append","copy_attr","Tag","get_path"]},"acm000001980jsd":{"type":"CodeCompilationUnit","id":"acm000001980jsd"