    {
      "id": "claim_6ba4853a84014a8184f8708579b953e5",
      "statement": "The repository is a monorepo whose root POM io.github.ardoco:parent (version 2.1.0-SNAPSHOT via ${revision}, MIT license) aggregates three module trees, each with its own aggregator POM: core (io.github.ardoco.core:parent-core — framework with common and text-provider-json, pipeline-core, tests-base), tlr (io.github.ardoco.tlr:parent-tlr — pipeline-tlr, stages-tlr with code-traceability, connection-generator, connection-generator-ner, model-provider, recommendation-generator, text-extraction, text-preprocessing, plus tests-tlr), and inconsistency-detection (io.github.ardoco.id:parent-id — pipeline-id, stages-id with inconsistency-detection, tests-inconsistency).",
      "evidence": [
        {
