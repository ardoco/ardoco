ndLine":508,"calleeNames":[]},"acm000001346jsd":{"type":"ClassUnit","id":"acm000001346jsd","name":"ArrayArithmetic","comment":"Copyright 2010,2011,2012 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nThe Accelerate framework is a library of tuned vector operations\n__ARM_NEON__ is defined by the compiler if the arguments \"-mfloat-abi=softfp -mfpu=neon\" are passed.\nThis class offers static inline functions for computing basic arithmetic with float arrays. It offers a central place for optimised implementations of common compute-intensive operations. In all SSE cases, input vectors can be (16-byte) unaligned, but output vectors must be aligned.","compilationUnitId":null,"parentDatatypeId":null,"startLine":42,"endLine":513,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001337jsd","acm000001338jsd","acm000001339jsd","acm000001340jsd","acm000001341jsd","acm000001342jsd","acm000001343jsd","acm000001344jsd","acm000001345jsd"]},"acm000001347jsd":{"type":"CodeAssembly","id":"acm000001347jsd","name":"ArrayArithmetic","comment":null,"parentId":null,"content":["acm000001346jsd"],"language":"CPP","importedModuleNames":[]},"acm000001348jsd":{"type":"ControlElement","id":"acm000001348jsd","name":"*getZeroBuffer()","comment":"If a buffer is available, it is reserved with a number of dependencies. Otherwise a new buffer is created.\nThe reference count of the buffer is reduced by one, possibly made available for other objects.\nAdd to the reserve cound of the given buffer.\nResizes all buffers in the pool (reserved and available).\nvoid resizeBuffers(unsigned int newBufferSize);","startLine":50,"endLine":50,"calleeNames":[]},"acm000001349jsd":{"type":"ControlElement","id":"acm000001349jsd","name":"getNumReservedBuffers()","comment":"","startLine":52,"endLine":52,"calleeNames":[]},"acm000001350jsd":{"type":"ControlElement","id":"acm000001350jsd","name":"getNumAvailableBuffers()","comment":"","startLine":53,"endLine":53,"calleeNames":[]},"acm000001351jsd":{"type":"ControlElement","id":"acm000001351jsd","name":"getNumTotalBuffers()","comment":"","startLine":54,"endLine":54,"calleeNames":[]},"acm000001352jsd":{"type":"ClassUnit","id":"acm000001352jsd","name":"BufferPool","comment":"Copyright 2012 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.","compilationUnitId":null,"parentDatatypeId":null,"startLine":30,"endLine":66,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001348jsd","acm000001349jsd","acm000001350jsd","acm000001351jsd"]},"acm000001353jsd":{"type":"CodeAssembly","id":"acm000001353jsd","name":"BufferPool","comment":null,"parentId":null,"content":["acm000001352jsd"],"language":"CPP","importedModuleNames":[]},"acm000001354jsd":{"type":"ClassUnit","id":"acm000001354jsd","name":"DeclareList","comment":"Copyright 2010,2011 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nA DeclareList is resonsible for keeping track of [declare]d paths. It maintains ownership of all path strings by copying them, and may modify them in order to maintain presentation consistency. Ultimately, it is a list of paths where abstractions may be found. The DeclareList only maintains full paths. If a path is [declare]d as a relative path, then it will be resolved to a pull path relative to the root path of the original patch. NOTE(mhroth): currently it does not do duplicate checking for given paths, though it probably should","compilationUnitId":null,"parentDatatypeId":null,"startLine":38,"endLine":64,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001355jsd":{"type":"CodeAssembly","id":"acm000001355jsd","name":"DeclareList","comment":null,"parentId":null,"content":["acm000001354jsd"],"language":"CPP","importedModuleNames":[]},"acm000001356jsd":{"type":"ClassUnit","id":"acm000001356jsd","name":"DelayReceiver","comment":"Copyright 2010 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\n<code>DelayReceiver</code> is a subclass of <code>DspObject</code> which implements some basic functionality which is used to treat <code>DspDelayRead</code> and <code>DspVariableDelay</code> as the same kind of object. This is because both of these objects are connected to <code>DspDelayWrite</code>s in the same way and it is convenient to treat them similarly as well. NOTE(mhroth): In a better world it might make more sense to implement <code>DelayReceiver</code> as an Java-style interface. But this isn't working for me very well in C++... :-/","compilationUnitId":null,"parentDatatypeId":null,"startLine":38,"endLine":49,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001357jsd":{"type":"CodeAssembly","id":"acm000001357jsd","name":"DelayReceiver","comment":null,"parentId":null,"content":["acm000001356jsd"],"language":"CPP","importedModuleNames":[]},"acm000001358jsd":{"type":"ControlElement","id":"acm000001358jsd","name":"doesProcessAudio()","comment":"This object doesn't do anything with audio, it only provides buffers. It should not be included\nin the dsp list","startLine":40,"endLine":40,"calleeNames":[]},"acm000001359jsd":{"type":"ControlEleme