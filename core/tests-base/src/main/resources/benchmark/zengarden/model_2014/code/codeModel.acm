001944jsd":{"type":"ClassUnit","id":"acm000001944jsd","name":"PdAbstractionDataBase","comment":"Copyright 2014 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nThis class is used to register memory mapped abstractions so that the PdFileParser can find them while parsing a patch. Every PdContext has its own PdAbstractionDatabase instance. The user can register / unregister memorymapped abstractions using the ZenGarden functions declared in ZenGarden.h: - zg_context_register_memorymapped_abstraction - zg_context_unregister_memorymapped_abstraction","compilationUnitId":null,"parentDatatypeId":null,"startLine":39,"endLine":55,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001945jsd":{"type":"CodeAssembly","id":"acm000001945jsd","name":"PdAbstractionDataBase","comment":null,"parentId":null,"content":["acm000001944jsd"],"language":"CPP","importedModuleNames":[]},"acm000001946jsd":{"type":"ControlElement","id":"acm000001946jsd","name":"lock()","comment":"Attach the given <code>graph</code> to this <code>context</code>, also registering all necessary objects, and computing the dsp object compute order if necessary.","startLine":73,"endLine":73,"calleeNames":[]},"acm000001947jsd":{"type":"ControlElement","id":"acm000001947jsd","name":"unlock()","comment":"","startLine":74,"endLine":74,"calleeNames":[]},"acm000001948jsd":{"type":"ControlElement","id":"acm000001948jsd","name":"*getBufferPool()","comment":"The registered callback function for sending data outside of the graph.\nRegister an object label and its associated factory method.\nUnregister an object label.","startLine":212,"endLine":212,"calleeNames":[]},"acm000001949jsd":{"type":"ClassUnit","id":"acm000001949jsd","name":"PdContext","comment":"Copyright 2010,2011 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nThe <code>PdContext</code> is a container for a set of <code>PdGraph</code>s operating in a common environment. The <code>PdContext</code> tracks all relevent global variables.","compilationUnitId":null,"parentDatatypeId":null,"startLine":52,"endLine":286,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001946jsd","acm000001947jsd","acm000001948jsd"]},"acm000001950jsd":{"type":"CodeAssembly","id":"acm000001950jsd","name":"PdContext","comment":null,"parentId":null,"content":["acm000001949jsd"],"language":"CPP","importedModuleNames":[]},"acm000001951jsd":{"type":"ClassUnit","id":"acm000001951jsd","name":"PdFileParser","comment":"Copyright 2010,2011 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nThe class parses a Pd file and iterates through each message, returning <code>NULL</code> when  no more are available. Messages are returned as strings (<code>char*</code>), which represent the entire logical message (though the original message may have been broken up over several lines in the file.","compilationUnitId":null,"parentDatatypeId":null,"startLine":43,"endLine":75,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001952jsd":{"type":"CodeAssembly","id":"acm000001952jsd","name":"PdFileParser","comment":null,"parentId":null,"content":["acm000001951jsd"],"language":"CPP","importedModuleNames":[]},"acm000001953jsd":{"type":"ClassUnit","id":"acm000001953jsd","name":"anonymous","comment":"","compilationUnitId":null,"parentDatatypeId":null,"startLine":37,"endLine":40,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001954jsd":{"type":"ClassUnit","id":"acm000001954jsd","name":"MessageAtom","comment":"Copyright 2009,2011,2012 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.","compilationUnitId":null,"parentDatatypeId":null,"startLine":35,"endLine":41,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001953jsd"]},"acm000001955jsd":{"type":"ControlElement","id":"acm000001955jsd","name":"numBytes(unsignedintx)","comment":"Resolve arguments in a string with a given argument list into the given <code>buffer</code> with <code>bufferLength</code>.  The <code>offset</code> parameter adjusts the resolution of the <code>$</code> argument. In the case of message boxes, <code>$0</code> refers to the graph id, which is the first argument in a graph's list of arguments. For all other objects, <code>$1</code> refers to the first (0th) element of the argument. The offset is used to distinguish between these cases, by offsetting the argument index resolution.\nConverts symbolic elements referring to message element types (e.g., float or f) to those types. For instance, if an element has a symbolic value of \"float\", then that element is converted into one of type <code>FLOAT</code>.\nInitialise the message with a string, arguments, and a resolution buffer. The string will be resolved into the buffer using the arguments. Any resolved strings in the message will point into the resolution buffer. The buffer is generally intended to be a temporary storage for such strings while objects are created.\nAdds elements to the message by tokenizing the given string. If a token is numeric then it is automatically resolved to a float. Otherwise the string is interpreted as a symbol. Note that the <code>initString</code> is tokenized and should be provided in a buffer which may be edited.\nSets the given message element to a FLOAT or SYMBOL depending on contents of string.\nGet the global timestamp of this message (in milliseconds).\nSet the global timestamp of this message (in milliseconds).\nNOTE(mhroth): necessary?\nReturns a copy of the message to the heap. Messages usually only exist temporarily on the stack and should be copied to the heap if it should persist. Symbol pointers are copied independently to the heap.\nThe message memory is freed from the heap, including symbols.\nCreate a string representation of the message. Suitable for use by the print object. The resulting string must be <code>free()</code>ed by the caller.\nConvenience function to determine if a particular message element is a float.\nConvenience function to get the float value from a particular message element. The user is responsible for checking that the indexed <code>MessageElement</code> is truly a float. This function does not check for the existence of the message element.\nConvenience function to set a message element to a float value. This function does not check for the existence of a message element.\nReturns the number of bytes in a PdMessage structure with <code>x</code> number of elements.","startLine":146,"endLine":148,"calleeNames":[]},"acm000001956jsd":{"type":"ClassUnit","id":"acm000001956jsd","name":"PdMessage","comment":"Implements a Pd message.","compilationUnitId":null,"parentDatatypeId":null,"startLine":45,"endLine":163,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001955jsd"]},"acm000001957jsd":{"type":"CodeAssembly","id":"acm000001957jsd","name":"PdMessage","comment":null,"parentId":null,"content":["acm000001954jsd","acm000001956jsd"],"language":"CPP","importedModuleNames":[]},"acm000001958jsd":{"type":"ClassUnit","id":"acm000001958jsd","name":"RemoteMessageReceiver","comment":"Copyright 2010 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nThis is a superclass of all <code>MessageObject</code>s which receive messages remotely. This includes objects such as <code>MessageReceive</code> and <code>MessageNotein</code>.","compilationUnitId":null,"parentDatatypeId":null,"startLine":32,"endLine":43,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001959jsd":{"type":"CodeAssembly","id":"acm000001959jsd","name":"RemoteMessageReceiver","comment":null,"parentId":null,"content":["acm000001958jsd"],"language":"CPP","importedModuleNames":[]},"acm000001960jsd":{"type":"ControlElement","id":"acm000001960jsd","name":"millisecondsToSamples(floatdelayInMs,floatsampleRate)","comment":"","startLine":36,"endLine":38,"calleeNames":[]},"acm000001961jsd":{"type":"ClassUnit","id":"acm000001961jsd","name":"StaticUtils","comment":"Copyright 2009,2011 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.","compilationUnitId":null,"parentDatatypeId":null,"startLine":31,"endLine":51,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001960jsd"]},"acm000001962jsd":{"type":"CodeAssembly","id":"acm000001962jsd","name":"StaticUtils","comment":null,"parentId":null,"content":["acm000001961jsd"],"language":"CPP","importedModuleNames":[]},"acm000001963jsd":{"type":"ControlElement","id":"acm000001963jsd","name":"~TableReceiverInterface()","comment":"nothing to do","startLine":35,"endLine":35,"calleeNames":[]},"acm000001964jsd":{"type":"ClassUnit","id":"acm000001964jsd","name":"TableReceiverInterface","comment":"Copyright 2010 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.  You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\nThis class has a similar function to DelayReceiver in that it is an interface for all objects which interact with MessageTables. This includes DspTableRead, DspTablePlay, DspTableRead4, MessageTableRead, and MessageTableWrite.","compilationUnitId":null,"parentDatatypeId":null,"startLine":33,"endLine":40,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001963jsd"]},"acm000001965jsd":{"type":"CodeAssembly","id":"acm000001965jsd","name":"TableReceiverInterface","comment":null,"parentId":null,"content":["acm000001964jsd"],"language":"CPP","importedModuleNames":[]},"acm000001966jsd":{"type":"ControlElement","id":"acm000001966jsd","name":"::BufferPool(unsignedshortsize)","comment":"Copyright 2012 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.","startLine":26,"endLine":31,"calleeNames":[]},"acm000001967jsd":{"type":"ControlElement","id":"acm000001967jsd","name":"::~BufferPool()","comment":"zero the zero buffer!\nfree all buffers, reserved and available","startLine":33,"endLine":43,"calleeNames":[]},"acm000001968jsd":{"type":"ControlElement","id":"acm000001968jsd","name":"*BufferPool::getBuffer(unsignedintnumDependencies)","comment":"","startLine":45,"endLine":57,"calleeNames":[]},"acm000001969jsd":{"type":"ControlElement","id":"acm000001969jsd","name":"BufferPool::releaseBuffer(float*buffer)","comment":"printf(\"%i/%i buffer used.\\n\", getNumReservedBuffers(), getNumTotalBuffers());\nan object may try to release the zero buffer. This should not be possible.","startLine":59,"endLine":75,"calleeNames":[]},"acm000001970jsd":{"type":"ControlElement","id":"acm000001970jsd","name":"BufferPool::reserveBuffer(float*buffer,unsignedintreserveCount)","comment":"printf(\"%i/%i buffer used.\\n\", getNumReservedBuffers(), getNumTotalBuffers());\nif the buffer is not in the reserved pool, nothing changes. Untracked buffers are left alone.\nno need to reserve the zero buffer","startLine":77,"endLine":89,"calleeNames":[]},"acm000001971jsd":{"type":"CodeAssembly","id":"acm000001971jsd","name":"BufferPool","comment":null,"parentId":null,"content":["acm000001966jsd","acm000001967jsd","acm000001968jsd","acm000001969jsd","acm000001970jsd"],"language":"CPP","importedModuleNames":[]},"acm000001972jsd":{"type":"ControlElement","id":"acm000001972jsd","name":"::DeclareList()","comment":"Copyright 2010,2011 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.","startLine":27,"endLine":29,"calleeNames":[]},"acm000001973jsd":{"type":"ControlElement","id":"acm000001973jsd","name":"::~DeclareList()","comment":"nothing to do","startLine":31,"endLine":33,"calleeNames":[]},"acm000001974jsd":{"type":"ControlElement","id":"acm000001974jsd","name":"DeclareList::addPath(constchar*path)","comment":"","startLine":35,"endLine":55,"calleeNames":[]},"acm000001975jsd":{"type":"ControlElement","id":"acm000001975jsd","name":"DeclareList::isFullPath(constchar*path)","comment":"if the path is full, then just add it to the list\nif a trailing slash exists, then it can be added to the list\nif no trailing slash exists, then one must be added\nif it is not a full path, then make it relative to the root path\nfront is root path\nif no trailing slash exists, then one should be added","startLine":57,"endLine":59,"calleeNames":[]},"acm000001976jsd":{"type":"ControlElement","id":"acm000001976jsd","name":"DeclareList::hasTrailingSlash(constchar*path)","comment":"","startLine":61,"endLine":63,"calleeNames":[]},"acm000001977jsd":{"type":"ControlElement","id":"acm000001977jsd","name":"*DeclareList::getRootPath()","comment":"","startLine":65,"endLine":67,"calleeNames":[]},"acm000001978jsd":{"type":"ControlElement","id":"acm000001978jsd","name":"DeclareList::getIterator()","comment":"","startLine":69,"endLine":71,"calleeNames":[]},"acm000001979jsd":{"type":"ControlElement","id":"acm000001979jsd","name":"DeclareList::getEnd()","comment":"","startLine":73,"endLine":75,"calleeNames":[]},"acm000001980jsd":{"type":"CodeAssembly","id":"acm000001980jsd","name":"DeclareList","comment":null,"parentId":null,"content":["acm000001972jsd","acm000001973jsd","acm000001974jsd","acm000001975jsd","acm000001976jsd","acm000001977jsd","acm000001978jsd","acm000001979jsd"],"language":"CPP","importedModuleNames":[]},"acm000001981jsd":{"type":"ControlElement","id":"acm000001981jsd","name":"::DelayReceiver(intnumMessageInlets,intnumDspInlets,intnumMessageOutlets,intnumDspOutlets,PdGraph*graph)","comment":"Copyright 2010 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 o