sIds":[],"content":[]},"acm000001445jsd":{"type":"ControlElement","id":"acm000001445jsd","name":"DspNoise::toString()","comment":"","startLine":48,"endLine":50,"calleeNames":[]},"acm000001446jsd":{"type":"ControlElement","id":"acm000001446jsd","name":"*DspNoise::getObjectLabel()","comment":"","startLine":52,"endLine":54,"calleeNames":[]},"acm000001447jsd":{"type":"CodeAssembly","id":"acm000001447jsd","name":"DspNoise","comment":null,"parentId":null,"content":["acm000001444jsd","acm000001445jsd","acm000001446jsd"],"language":"CPP","importedModuleNames":[]},"acm000001448jsd":{"type":"ControlElement","id":"acm000001448jsd","name":"shouldDistributeMessageToInlets()","comment":"The nominal constructor.\nThis constructor is used exclusively by <code>PdGraph</code>. <code>DspObject</code> requires the blocksize in order to instantiate, however <code>PdGraph</code> is a subclass of <code>DspObject</code> and thus the fields of the latter are not yet initialised when the fomer fields are filled in.\nOverride MessageObject::shouldDistributeMessageToInlets()","startLine":67,"endLine":67,"calleeNames":[]},"acm000001449jsd":{"type":"ControlElement","id":"acm000001449jsd","name":"canSetBufferAtOutlet(unsignedintoutletIndex)","comment":"Process audio buffers in this block.\nReturns the connection type of the given outlet.\nGet and set buffers at inlets and outlets.\nReturn true if a buffer from the Buffer Pool should set set at the given outlet. False otherwise.","startLine":83,"endLine":83,"calleeNames":[]},"acm000001450jsd":{"type":"ControlElement","id":"acm000001450jsd","name":"doesProcessAudio()","comment":"","startLine":90,"endLine":90,"calleeNames":[]},"acm000001451jsd":{"type":"ControlElement","id":"acm000001451jsd","name":"getNumInlets()","comment":"","startLine":96,"endLine":98,"calleeNames":[]},"acm000001452jsd":{"type":"ControlElement","id":"acm000001452jsd","name":"getNumOutlets()","comment":"","startLine":99,"endLine":101,"calleeNames":[]},"acm000001453jsd":{"type":"C