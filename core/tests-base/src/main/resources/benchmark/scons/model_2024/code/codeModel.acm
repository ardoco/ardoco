mes to use LaTeXAction, and BibTeXAction.\nThis routine is called with two actions. In this file for DVI builds\nwith LaTeXAction and from the pdflatex.py with PDFLaTeXAction\nset this up now for the case where the user requests a different extension\nfor the target filename","startLine":192,"endLine":492,"calleeNames":["splitext","str","split","abspath","modify_env_var","join","get_text_contents","search","isfile","sum","File","get_csig","print","clear_memoized_values","new_ninfo","int","subst","XXXLaTeXAction","open","read","decode","findall","list","keys","append","find","BibTeXAction","check_file_error_message","check_content_hash","BiberAction","MakeIndexAction","MakeNclAction","MakeGlossaryAction","MakeAcronymsAction","Action","MakeNewGlossaryAction","move"]},"acm000002667jsd":{"type":"ControlElement","id":"acm000002667jsd","name":"LaTeXAuxAction","comment":"","startLine":494,"endLine":496,"calleeNames":["InternalLaTeXAuxAction"]},"acm000002668jsd":{"type":"ControlElement","id":"acm000002668jsd","name":"is_LaTeX","comment":"Scan a file list to decide if it's TeX- or LaTeX-flavored.\nWe need to scan files that are included in case the\n\\documentclass command is in them.\nget path list from both env['TEXINPUTS'] and env['ENV']['TEXINPUTS']","startLine":502,"endLine":570,"calleeNames":["modify_env_var","is_List","split","print","get_text_contents","search","extend","findall","FindFile","is_LaTeX"]},"acm000002669jsd":{"type":"ControlElement","id":"acm000002669jsd","name":"TeXLaTeXFunction","comment":"A builder for TeX and LaTeX that scans the source file to decide the \"flavor\" of the source and then executes the appropriate program.\nfind these paths for use in is_LaTeX to search for included files","startLine":573,"endLine":590,"calleeNames":["split","str","abspath","is_LaTeX","LaTeXAuxAction","check_file_error_message","TeXAction"]},"acm000002670jsd":{"type":"ControlElement","id":"acm000002670jsd","name":"TeXLaTeXStrFunction","comment":"A strfunction for TeX and LaTeX that scans the source file to decide the \"flavor\" of the source and then returns the appropriate command string.\nfind these paths for use in is_LaTeX to search for included files","startLine":592,"endLine":608,"calleeNames":["GetOption","split","str","abspath","is_LaTeX","subst"]},"acm000002671jsd":{"type":"ControlElement","id":"acm000002671jsd","name":"tex_eps_emitter","comment":"An emitter for TeX and LaTeX sources when executing tex or latex. It will accept .ps and .eps graphics files","startLine":610,"endLine":617,"calleeNames":["tex_emitter_core"]},"acm000002672jsd":{"type":"ControlElement","id":"acm000002672jsd","name":"tex_pdf_emitter","comment":"An emitter for TeX and LaTeX sources when executing pdftex or pdflatex. It will accept graphics files of types .pdf, .jpg, .png, .gif, and .tif","startLine":619,"endLine":626,"calleeNames":["tex_emitter_core"]},"acm000002673jsd":{"type":"ControlElement","id":"acm000002673jsd","name":"ScanFiles","comment":"For theFile (a Node) update any file_tests and search for graphics files then find all included files and call ScanFiles recursively for each of them","startLine":628,"endLine":675,"calleeNames":["get_text_contents","print","str","range","len","search","findall","insert","append","join","group","extend","FindFile","ScanFiles"]},"acm000002674jsd":{"type":"ControlElement","id":"acm000002674jsd","name":"tex_emitter_core","comment":"An emitter for TeX and LaTeX sources. For LaTeX sources we try and find the common created files that are needed on subsequent runs of latex to finish tables of contents, bibliographies, indices, lists of figures, and hyperlink references.","startLine":677,"endLine":838,"calleeNames":["splitext","str","split","join","abspath","SideEffect","print","Clean","get_text_contents","range","len","append","modify_env_var","is_List","ScanFiles","exists","glob","copy","finditer","group","isfile","open","read","findall","remove"]},"acm000002675jsd":{"type":"ControlElement","id":"acm000002675jsd","name":"generate","comment":"Add Builders and construction variables for TeX to an Environment.","startLine":843,"endLine":860,"calleeNames":["Action","AppendUnique","generate_common","generate","add_action","add_emitter"]},"acm000002676jsd":{"type":"ControlElement","id":"acm000002676jsd","name":"generate_darwin","comment":"","startLine":862,"endLine":875,"calleeNames":["system","AppendENVPath"]},"acm000002677jsd":{"type":"ControlElement","id":"acm000002677jsd","name":"generate_common","comment":"Add internal Builders and construction variables for LaTeX to an Environment.\nAdd OSX system paths so TeX tools can be found\nwhen a list of tools is given the exists() method is not called\nA generic tex file Action, sufficient for all tex files.\nAn Action to build a latex file. This might be needed more\nthan once if we are dealing with labels and bibtex.\nDefine an action to run BibTeX on a file.\nDefine an action to run Biber on a file.\nDefine an action to run MakeIndex on a file.\nDefine an action to run MakeIndex on a file for nomenclatures.\nDefine an action to run MakeIndex on a file for glossaries.\nDefine an action to run MakeIndex on a file for acronyms.\nSome Linux platforms have pdflatex set up in a way\nthat requires that the HOME environment variable be set.\nAdd it here if defined.","startLine":877,"endLine":988,"calleeNames":["generate_darwin","Action","get","system","CLVar"]},"acm000002678jsd":{"type":"ControlElement","id":"acm000002678jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":990,"endLine":992,"calleeNames":["generate_darwin","Detect"]},"acm000002679jsd":{"type":"CodeCompilationUnit","id":"acm000002679jsd","name":"tex","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool-specific initialization for TeX. Generates .dvi files from .tex files There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.","parentId":"acm000002768jsd","content":["acm000002664jsd","acm000002665jsd","acm000002666jsd","acm000002667jsd","acm000002668jsd","acm000002669jsd","acm000002670jsd","acm000002671jsd","acm000002672jsd","acm000002673jsd","acm000002674jsd","acm000002675jsd","acm000002676jsd","acm000002677jsd","acm000002678jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os.path","re","shutil","sys","platform","glob","SCons.Action","SCons.Node","SCons.Node.FS","SCons.Util","SCons.Scanner.LaTeX","dvi"]},"acm000002680jsd":{"type":"ControlElement","id":"acm000002680jsd","name":"_do_subst","comment":"Fetch the node contents and replace all instances of the keys with their values. For example, if subs is {'%VERSION%': '1.2345', '%BASE%': 'MyProg', '%prefix%': '/bin'}, then all instances of %VERSION% in the file will be replaced with 1.2345 and so forth.","startLine":56,"endLine":76,"calleeNames":["get_text_contents","replace","bytearray"]},"acm000002681jsd":{"type":"ControlElement","id":"acm000002681jsd","name":"_action","comment":"prepare the line separator","startLine":79,"endLine":134,"calleeNames":["is_String","isinstance","get_text_contents","UserError","repr","to_bytes","is_Dict","list","items","is_Sequence","callable","value","subst","str","append","get","open","get_path","write","_do_subst","close"]},"acm000002682jsd":{"type":"ControlElement","id":"acm000002682jsd","name":"_strfunc","comment":"","startLine":137,"endLine":138,"calleeNames":[]},"acm000002683jsd":{"type":"ControlElement","id":"acm000002683jsd","name":"_convert_list_R","comment":"","startLine":141,"endLine":148,"calleeNames":["is_Sequence","_convert_list_R","isinstance","append","Value"]},"acm000002684jsd":{"type":"ControlElement","id":"acm000002684jsd","name":"_convert_list","comment":"","startLine":151,"endLine":156,"calleeNames":["len","UserError","_convert_list_R"]},"acm000002685jsd":{"type":"ControlElement","id":"acm000002685jsd","name":"generate","comment":"os.linesep","startLine":181,"endLine":189,"calleeNames":["get"]},"acm000002686jsd":{"type":"ControlElement","id":"acm000002686jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":192,"endLine":193,"calleeNames":[]},"acm000002687jsd":{"type":"CodeCompilationUnit","id":"acm000002687jsd","name":"textfile","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTextfile/Substfile builder for SCons. Create file 'target' which typically is a textfile. The 'source' may be any combination of strings, Nodes, or lists of same. A 'linesep' will be put between any part written and defaults to os.linesep. The only difference between the Textfile builder and the Substfile builder is that strings are converted to Value() nodes for the former and File() nodes for the latter. To insert files in the former or strings in the latter, wrap them in a File() or Value(), respectively. The values of SUBST_DICT first have any construction variables expanded (its keys are not expanded). If a value of SUBST_DICT is a python callable function, it is called and the result is expanded as the value. Values are substituted in a \"random\" order; if any substitution could be further expanded by another substitution, it is unpredictable whether the expansion will occur.","parentId":"acm000002768jsd","content":["acm000002680jsd","acm000002681jsd","acm000002682jsd","acm000002683jsd","acm000002684jsd","acm000002685jsd","acm000002686jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons","SCons.Node.Node","SCons.Node.Python.Value","SCons.Util.is_String","SCons.Util.is_Sequence","SCons.Util.is_Dict","SCons.Util.to_bytes"]},"acm000002688jsd":{"type":"ControlElement","id":"acm000002688jsd","name":"generate","comment":"Add Builders and construction variables for ar to an Environment.","startLine":36,"endLine":44,"calleeNames":["findIt","createStaticLibBuilder","CLVar"]},"acm000002689jsd":{"type":"ControlElement","id":"acm000002689jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":46,"endLine":47,"calleeNames":["findIt"]},"acm000002690jsd":{"type":"CodeCompilationUnit","id":"acm000002690jsd","name":"tlib","comment":"SCons.Tool.tlib XXX\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000002768jsd","content":["acm000002688jsd","acm000002689jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Tool","SCons.Tool.bcc32","SCons.Util"]},"acm000002691jsd":{"type":"ControlElement","id":"acm000002691jsd","name":"__init__","comment":"","startLine":34,"endLine":35,"calleeNames":[]},"acm000002692jsd":{"type":"ControlElement","id":"acm000002692jsd","name":"Det