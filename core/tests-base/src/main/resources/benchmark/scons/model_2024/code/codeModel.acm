omment":"","startLine":185,"endLine":186,"calleeNames":[]},"acm000005936jsd":{"type":"ControlElement","id":"acm000005936jsd","name":"set_bsig","comment":"","startLine":188,"endLine":189,"calleeNames":[]},"acm000005937jsd":{"type":"ControlElement","id":"acm000005937jsd","name":"set_csig","comment":"","startLine":191,"endLine":192,"calleeNames":[]},"acm000005938jsd":{"type":"ControlElement","id":"acm000005938jsd","name":"store_csig","comment":"","startLine":194,"endLine":195,"calleeNames":[]},"acm000005939jsd":{"type":"ControlElement","id":"acm000005939jsd","name":"store_bsig","comment":"","startLine":197,"endLine":198,"calleeNames":[]},"acm000005940jsd":{"type":"ControlElement","id":"acm000005940jsd","name":"is_up_to_date","comment":"","startLine":200,"endLine":201,"calleeNames":[]},"acm000005941jsd":{"type":"ControlElement","id":"acm000005941jsd","name":"__str__","comment":"","startLine":203,"endLine":204,"calleeNames":[]},"acm000005942jsd":{"type":"ControlElement","id":"acm000005942jsd","name":"postprocess","comment":"","startLine":206,"endLine":208,"calleeNames":["set"]},"acm000005943jsd":{"type":"ControlElement","id":"acm000005943jsd","name":"get_executor","comment":"","startLine":210,"endLine":236,"calleeNames":["hasattr","extend","children","Executor"]},"acm000005944jsd":{"type":"ControlElement","id":"acm000005944jsd","name":"get_internal_path","comment":"Should only be used (currently) by TaskmasterTestCase.test_cached_execute_target_unlink_fails","startLine":238,"endLine":242,"calleeNames":["str"]},"acm000005945jsd":{"type":"ClassUnit","id":"acm000005945jsd","name":"Node","comment":"","compilationUnitId":"acm000005966jsd","parentDatatypeId":null,"startLine":41,"endLine":242,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005912jsd","acm000005913jsd","acm000005914jsd","acm000005915jsd","acm000005916jsd","acm000005917jsd","acm000005918jsd","acm000005919jsd","acm000005920jsd","acm000005921jsd","acm000005922jsd","acm000005923jsd","acm000005924jsd","acm000005925jsd","acm000005926jsd","acm000005927jsd","acm000005928jsd","acm000005929jsd","acm000005930jsd","acm000005931jsd","acm000005932jsd","acm000005933jsd","acm000005934jsd","acm000005935jsd","acm000005936jsd","acm000005937jsd","acm000005938jsd","acm000005939jsd","acm000005940jsd","acm000005941jsd","acm000005942jsd","acm000005943jsd","acm000005944jsd"]},"acm000005946jsd":{"type":"ClassUnit","id":"acm000005946jsd","name":"OtherError","comment":"","compilationUnitId":"acm000005966jsd","parentDatatypeId":null,"startLine":245,"endLine":246,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000005947jsd":{"type":"ClassUnit","id":"acm000005947jsd","name":"MyException","comment":"","compilationUnitId":"acm000005966jsd","parentDatatypeId":null,"startLine":249,"endLine":250,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000005948jsd":{"type":"ControlElement","id":"acm000005948jsd","name":"test_next_task","comment":"Test fetching the next task","startLine":255,"endLine":542,"calleeNames":["Node","Taskmaster","next_task","prepare","execute","executed","postprocess","get_state","build","set_state","get_target","reverse"]},"acm000005949jsd":{"type":"ControlElement","id":"acm000005949jsd","name":"test_make_ready_out_of_date","comment":"Test the Task.make_ready() method's list of out-of-date Nodes","startLine":544,"endLine":589,"calleeNames":["make_ready","extend","MyTask","Node","Taskmaster","next_task"]},"acm000005950jsd":{"type":"ControlElement","id":"acm000005950jsd","name":"test_make_ready_exception","comment":"Test handling exceptions from Task.make_ready()","startLine":591,"endLine":604,"calleeNames":["MyException","Node","Taskmaster","next_task","repr","str"]},"acm000005951jsd":{"type":"ControlElement","id":"acm000005951jsd","name":"test_needs_execute","comment":"Test that we can't instantiate a Task subclass without needs_execute We should be getting: TypeError: Can't instantiate abstract class MyTask with abstract methods needs_execute","startLine":606,"endLine":619,"calleeNames":["Node","Taskmaster","assertRaises","next_task"]},"acm000005952jsd":{"type":"ControlElement","id":"acm000005952jsd","name":"test_make_ready_all","comment":"Test the make_ready_all() method","startLine":621,"endLine":680,"calleeNames":["Node","Taskmaster","next_task","get_target"]},"acm000005953jsd":{"type":"ControlElement","id":"acm000005953jsd","name":"test_children_errors","comment":"Test errors when fetching the children of a node.","startLine":682,"endLine":707,"calleeNames":["StopError","exit","StopNode","Taskmaster","next_task","repr","str","ExitNode"]},"acm000005954jsd":{"type":"ControlElement","id":"acm000005954jsd","name":"test_cycle_detection","comment":"Test detecting dependency cycles","startLine":709,"endLine":723,"calleeNames":["Node","Taskmaster","next_task","str"]},"acm000005955jsd":{"type":"ControlElement","id":"acm000005955jsd","name":"test_next_top_level_candidate","comment":"Test the next_top_level_candidate() method","startLine":725,"endLine":737,"calleeNames":["Node","Taskmaster","next_task","fail_stop","list","map"]},"acm000005956jsd":{"type":"ControlElement","id":"acm000005956jsd","name":"test_stop","comment":"Test the stop() method Both default and overridden in a subclass.","startLine":739,"endLine":779,"calleeNames":["Node","Taskmaster","next_task","prepare","execute","executed","postprocess","stop","MyTM"]},"acm000005957jsd":{"type":"ControlElement","id":"acm000005957jsd","name":"test_executed","comment":"Test when a task has been executed","startLine":781,"endLine":830,"calleeNames":["Node","Taskmaster","next_task","set_state","executed","get_state"]},"acm000005958jsd":{"type":"ControlElement","id":"acm000005958jsd","name":"test_prepare","comment":"Test preparation of multiple Nodes for a task","startLine":832,"endLine":937,"calleeNames":["Node","Taskmaster","next_task","get_executor","prepare","set_state","exception_set","str","Exception","extend","children","ExceptionExecutor","AssertionError"]},"acm000005959jsd":{"type":"ControlElement","id":"acm000005959jsd","name":"test_execute","comment":"Test executing a task","startLine":939,"endLine":1035,"calleeNames":["Node","Taskmaster","next_task","execute","fail","len","exc_info","isinstance","type"]},"acm000005960jsd":{"type":"ControlElement","id":"acm000005960jsd","name":"test_cached_execute","comment":"Test executing a task with cached targets\nIn issue #2720 Alexei Klimkin detected that the previous\nworkflow for execute() led to problems in a multithreaded build.\nWe have:\ntask.prepare()\ntask.execute()\ntask.executed()\n-> node.visited()\nfor the Serial flow, but\n- Parallel - - Worker -\ntask.prepare()\nrequestQueue.put(task)\ntask = requestQueue.get()\ntask.execute()\nresultQueue.put(task)\ntask = resultQueue.get()\ntask.executed()\n->node.visited()\nin parallel. Since execute() used to call built() when a target\nwas cached, it could unblock dependent nodes before the binfo got\nrestored again in visited(). This resulted in spurious\n\"file not found\" build errors, because files fetched from cache would\nbe seen as not up to date and wouldn't be scanned for implicit\ndependencies.\n\nThe following test ensures that execute() only marks targets as cached,\nbut the actual call to built() happens in executed() only.\nLike this, the binfo should still be intact after calling execute()...","startLine":1037,"endLine":1079,"calleeNames":["Node","Taskmaster","next_task","prepare","execute","hasattr"]},"acm000005961jsd":{"type":"ControlElement","id":"acm000005961jsd","name":"test_cached_execute_target_unlink_fails","comment":"Test executing a task with cached targets where unlinking one of the targets fail","startLine":1081,"endLine":1127,"calleeNames":["Node","DummyFS","append","Taskmaster","next_task","prepare","execute","assertTrue","len","assertEqual"]},"acm000005962jsd":{"type":"ControlElement","id":"acm000005962jsd","name":"test_exception","comment":"Test generic Taskmaster exception handling","startLine":1130,"endLine":1213,"calleeNames":["Node","Taskmaster","next_task","exception_set","str","exception_raise","exc_info","type","extract_tb"]},"acm000005963jsd":{"type":"ControlElement","id":"acm000005963jsd","name":"test_postprocess","comment":"Test postprocessing targets to give them a chance to clean up","startLine":1215,"endLine":1239,"calleeNames":["Node","Taskmaster","next_task","postprocess"]},"acm000005964jsd":{"type":"ControlElement","id":"acm000005964jsd","name":"test_trace","comment":"Test Taskmaster tracing","startLine":1241,"endLine":1315,"calleeNames":["StringIO","Node","Taskmaster","next_task","prepare","execute","postprocess","set_state","getvalue","detailed_diff"]},"acm000005965jsd":{"type":"ClassUnit","id":"acm000005965jsd","name":"TaskmasterTestCase","comment":"","compilationUnitId":"acm000005966jsd","parentDatatypeId":null,"startLine":253,"endLine":1315,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005948jsd","acm000005949jsd","acm000005950jsd","acm000005951jsd","acm000005952jsd","acm000005953jsd","acm000005954jsd","acm000005955jsd","acm000005956jsd","acm000005957jsd","acm000005958jsd","acm000005959jsd","acm000005960jsd","acm000005961jsd","acm000005962jsd","acm000005963jsd","acm000005964jsd"]},"acm000005966jsd":{"type":"CodeCompilationUnit","id":"acm000005966jsd","name":"TaskmasterTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000006009jsd","content":["acm000005945jsd","acm000005946jsd","acm000005947jsd","acm000005965jsd"],"pathElements":["Taskmaster"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.compat","sys","unittest","SCons.Taskmaster","SCons.Errors","TestCommon","SCons.Warnings","io"]},"acm000005967jsd":{"type":"ControlElement","id":"acm000005967jsd","name":"__init__","comment":"Instantiates a Taskmaster.Stats object, initializing all appropriate counters to zero.","startLine":84,"endLine":95,"calleeNames":[]},"acm000005968jsd":{"type":"ClassUnit","id":"acm000005968jsd","name":"Stats","comment":"A simple class for holding statistics about the disposition of a Node by the Taskmaster. If we're collecting statistics, each Node processed by the Taskmaster gets one of these attached, in which case the Taskmaster records its decision each time it processes the Node. (Ideally, that's just once per Node.)","compilationUnitId":"acm000006008jsd","parentDatatypeId":null,"startLine":76,"endLine":95,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005967jsd"]},"acm000005969jsd":{"type":"ControlElement","id":"acm000005969jsd","name":"__init__","comment":"Instantiates a Taskmaster.Stats object, initializing all appropriate counters to zero.","startLine":84,"endLine":95,"calleeNames":[]},"acm000005970jsd":{"type":"ControlElement","id":"acm000005970jsd","name":"trace_message","comment":"This grabs the name of the function which calls trace_message()","startLine":142,"endLine":145,"calleeNames":["_getframe","debug","tm_trace_node"]},"acm000005971jsd":{"type":"ControlElement","id":"acm000005971jsd","name":"display","comment":"Hook to allow the calling interface to display a message. This hook gets called as part of preparing a task for execution (that is, a Node to be built). As part of figuring out what Node should be built next, the actual target list may be altered, along with a message describing the alteration. The calling interface can subclass Task and provide a concrete implementation of this method to see those messages.","startLine":147,"endLine":158,"calleeNames":[]},"acm000005972jsd":{"type":"ControlElement","id":"acm000005972jsd","name":"prepare","comment":"Called just before the task is executed. This is mainly intended to give the target Nodes a chance to unlink underlying files and make all necessary directories before the Action is actually called to build the targets.","startLine":160,"endLine":205,"calleeNames":["trace_message","exception_raise","display","get_executor","prepare","get_action_targets","print"]},"acm000005973jsd":{"type":"ControlElement","id":"acm000005973jsd","name":"get_target","comment":"Fetch the target being built or updated by this task.","startLine":207,"endLine":210,"calleeNames":[]},"acm000005974jsd":{"type":"ControlElement","id":"acm000005974jsd","name":"needs_execute","comment":"","startLine":213,"endLine":214,"calleeNames":[]},"acm000005975jsd":{"type":"ControlElement","id":"acm000005975jsd","name":"execute","comment":"Called to execute the task. This method is called from multiple threads in a parallel build, so only do thread safe stuff here. Do thread unsafe stuff in prepare(), executed() or failed().","startLine":216,"endLine":263,"calleeNames":["trace_message","retrieve_from_cache","append","len","unlink","get_internal_path","warn","build","push_to_cache","exc_info","ExplicitExit","convert_to_BuildError"]},"acm000005976jsd":{"type":"ControlElement","id":"acm000005976jsd","name":"executed_without_callbacks","comment":"Called when the task has been successfully executed and the Taskmaster instance doesn't want to call the Node's callback methods.","startLine":265,"endLine":279,"calleeNames":["trace_message","get_state","set_state"]},"acm000005977jsd":{"type":"ControlElement","id":"acm000005977jsd","name":"executed_with_callbacks","comment":"Called when the task has been successfully executed and the Taskmaster instance wants to call the Node's callback methods. This may have been a do-nothing operation (to preserve build order), so we must check the node's state before deciding whether it was \"built\", in which case we call the appropriate Node method. In any event, we always call \"visited()\", which will handle any post-visit actions that must take place regardless of whether or not the target was an actual built target or a source Node.","startLine":281,"endLine":310,"calleeNames":["trace_message","get_state","set_state","built","visited","hasattr","release_target_info"]},"acm000005978jsd":{"type":"ControlElement","id":"acm000005978jsd","name":"failed","comment":"Default action when a task fails: stop the build. Note: Although this function is normally invoked on nodes in the executing state, it might also be invoked on up-to-date nodes when using Configure().","startLine":314,"endLine":322,"calleeNames":["fail_stop"]},"acm000005979jsd":{"type":"ControlElement","id":"acm000005979jsd","name":"fail_stop","comment":"Explicit stop-the-build failure. This sets failure status on the target nodes and all of their dependent parent nodes. Note: Although this function is normally invoked on nodes in the executing state, it might also be invoked on up-to-date nodes when using Configure().","startLine":324,"endLine":350,"calleeNames":["trace_message","will_not_build","set_state","stop"]},"acm000005980jsd":{"type":"ControlElement","id":"acm000005980jsd","name":"fail_continue","comment":"Explicit continue-the-build failure. This sets failure status on the target nodes and all of their dependent parent nodes. Note: Although this function is normally invoked on nodes in the executing state, it might also be invoked on up-to-date nodes when using Configure().","startLine":352,"endLine":367,"calleeNames":["trace_message","will_not_build","set_state"]},"acm000005981jsd":{"type":"ControlElement","id":"acm000005981jsd","name":"make_ready_all","comment":"Marks all targets in a task ready for execution. This is used when the interface needs every target Node to be visited--the canonical example being the \"scons -c\" option.","startLine":369,"endLine":385,"calleeNames":["trace_message","disambiguate","set_state"]},"acm000005982jsd":{"type":"ControlElement","id":"acm000005982jsd","name":"make_ready_current","comment":"Marks all targets in a task ready for execution if any target is not current. This is the default behavior for building only what's necessary.","startLine":387,"endLine":430,"calleeNames":["write","trace_message","disambiguate","make_ready","has_builder","is_up_to_date","BuildError","append","set_state","visited","hasattr","release_target_info"]},"acm000005983jsd":{"type":"ControlElement","id":"acm000005983jsd","name":"postprocess","comment":"Post-processes a task after it's been executed. This examines all the targets just built (or not, we don't care if the build was successful, or even if there was no build because everything was up-to-date) to see if they have any waiting parent Nodes, or Nodes waiting on a common side effect, that can be put back on the candidates list.","startLine":434,"endLine":497,"calleeNames":["trace_message","set","discard","get","get_state","set_state","append","items","postprocess"]},"acm000005984jsd":{"type":"ControlElement","id":"acm000005984jsd","name":"exc_info","comment":"Returns info about a recorded exception.","startLine":508,"endLine":512,"calleeNames":[]},"acm000005985jsd":{"type":"ControlElement","id":"acm000005985jsd","name":"exc_clear","comment":"Clears any recorded exception. This also changes the \"exception_raise\" attribute to point to the appropriate do-nothing method.","startLine":514,"endLine":522,"calleeNames":[]},"acm000005986jsd":{"type":"ControlElement","id":"acm000005986jsd","name":"exception_set","comment":"Records an exception to be raised at the appropriate time. This also changes the \"exception_raise\" attribute to point to the method that will, in fact","startLine":524,"endLine":534,"calleeNames":["exc_info"]},"acm000005987jsd":{"type":"ControlElement","id":"acm000005987jsd","name":"_no_exception_to_raise","comment":"","startLine":536,"endLine":537,"calleeNames":[]},"acm000005988jsd":{"type":"ControlElement","id":"acm000005988jsd","name":"_exception_raise","comment":"Raises a pending exception that was recorded while getting a Task ready for execution.","startLine":539,"endLine":557,"calleeNames":["exc_info","isinstance","with_traceback","exc_type"]},"acm000005989jsd":{"type":"ClassUnit","id":"acm000005989jsd","name":"Task","comment":"SCons build engine abstract task class. This controls the interaction of the actual building of node and the rest of the engine. This is expected to handle all of the normally-customizable aspects of controlling a build, so any given application *should* be able to do what it wants by sub-classing this class and overriding methods as appropriate. If an application needs to customize something by sub-classing Taskmaster (or some other build engine class), we should first try to migrate that functionality into this class. Note that it's generally a good idea for sub-classes to call these methods explicitly to update state, etc., rather than roll their own interaction with Taskmaster from scratch.","compilationUnitId":"acm000006008jsd","parentDatatypeId":null,"startLine":114,"endLine":557,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005969jsd","acm000005970jsd","acm000005971jsd","acm000005972jsd","acm000005973jsd","acm000005974jsd","acm000005975jsd","acm000005976jsd","acm000005977jsd","acm000005978jsd","acm000005979jsd","acm000005980jsd","acm000005981jsd","acm000005982jsd","acm000005983jsd","acm000005984jsd","acm000005985jsd","acm000005986jsd","acm000005987jsd","acm000005988jsd"]},"acm000005990jsd":{"type":"ControlElement","id":"acm000005990jsd","name":"needs_execute","comment":"","startLine":213,"endLine":214,"calleeNames":[]},"acm000005991jsd":{"type":"ClassUnit","id":"acm000005991jsd","name":"AlwaysTask","comment":"","compilationUnitId":"acm000006008jsd","parentDatatypeId":null,"startLine":565,"endLine":578,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005990jsd"]},"acm000005992jsd":{"type":"ControlElement","id":"acm000005992jsd","name":"needs_execute","comment":"","startLine":213,"endLine":214,"calleeNames":[]},"acm000005993jsd":{"type":"ClassUnit","id":"acm000005993jsd","name":"OutOfDateTask","comment":"","compilationUnitId":"acm000006008jsd","parentDatatypeId":null,"startLine":580,"endLine":587,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005992jsd"]},"acm000005994jsd":{"type":"ControlElement","id":"acm000005994jsd","name":"__init__","comment":"Instantiates a Taskmaster.Stats object, initializing all appropriate counters to zero.","startLine":84,"endLine":95,"calleeNames":[]},"acm000005995jsd":{"type":"ControlElement","id":"acm000005995jsd","name":"configure_trace","comment":"This handles the command line option --taskmastertrace= It can be: - : output to stdout <filename> : output to a file False/None : Do not trace\nTODO: May want to switch format to something like this.\nlog_format = (\n'%(relativeCreated)05dms'\n':%(relfilename)s'\n':%(funcName)s'\n'#%(lineno)s'\n': %(message)s'\n)","startLine":626,"endLine":677,"calleeNames":["Formatter","isinstance","StreamHandler","FileHandler","getLogger","setLevel","addHandler","setFormatter","DispatchingFormatter"]},"acm000005996jsd":{"type":"ControlElement","id":"acm000005996jsd","name":"find_next_candidate","comment":"Returns the next candidate Node for (potential) evaluation. The candidate list (really a stack) initially consists of all of the top-level (command line) targets provided when the Taskmaster was initialized. While we walk the DAG, visiting Nodes, all the children that haven't finished processing get pushed on to the candidate list. Each child can then be popped and examined in turn for whether *their* children are all up-to-date, in which case a Task will be created for their actual evaluation and potential building. Here is where we also allow candidate Nodes to alter the list of Nodes that should be examined. This is used, for example, when invoking SCons in a source directory. A source directory Node can return its corresponding build directory Node, essentially saying, \"Hey, you really need to build this thing over here instead.\"","startLine":679,"endLine":713,"calleeNames":["pop","alter_targets","append","extend","order"]},"acm000005997jsd":{"type":"ControlElement","id":"acm000005997jsd","name":"no_next_candidate","comment":"Stops Taskmaster processing by not returning a next candidate. Note that we have to clean-up the Taskmaster candidate list because the cycle detection depends on the fact all nodes have been processed somehow.","startLine":715,"endLine":727,"calleeNames":["will_not_build"]},"acm000005998jsd":{"type":"ControlElement","id":"acm000005998jsd","name":"_validate_pending_children","comment":"Validate the content of the pending_children set. Assert if an internal error is found. This function is used strictly for debugging the taskmaster by checking that no invariants are violated. It is not used in normal operation. The pending_children set is used to detect cycles in the dependency graph. We call a \"pending child\" a child that is found in the \"pending\" state when checking the dependencies of its parent node. A pending child can occur when the Taskmaster completes a loop through a cycle. For example, let's imagine a graph made of three nodes (A, B and C) making a cycle. The evaluation starts at node A. The Taskmaster first considers whether node A's child B is up-to-date. Then, recursively, node B needs to check whether node C is up-to-date. This leaves us with a dependency graph looking like:: Next candidate \\ \\ Node A (Pending) --> Node B(Pending) --> Node C (NoState) ^ | | | +-------------------------------------+ Now, when the Taskmaster examines the Node C's child Node A, it finds that Node A is in the \"pending\" state. Therefore, Node A is a pending child of node C. Pending children indicate that the Taskmaster has potentially loop back through a cycle. We say potentially because it could also occur when a DAG is evaluated in parallel. For example, consider the following graph:: Node A (Pending) --> Node B(Pending) --> Node C (Pending) --> ... | ^ | | +----------> Node D (NoState) --------+ / Next candidate / The Taskmaster first evaluates the nodes A, B, and C and starts building some children of node C. Assuming, that the maximum parallel level has not been reached, the Taskmaster will examine Node D. It will find that Node C is a pending child of Node D. In summary, evaluating a graph with a cycle will always involve a pending child at one point. A pending child might indicate either a cycle or a diamond-shaped DAG. Only a fraction of the nodes ends-up being a \"pending child\" of another node. This keeps the pending_children set small in practice. We can differentiate between the two cases if we wait until the end of the build. At this point, all the pending children nodes due to a diamond-shaped DAG will have been properly built (or will have failed to build). But, the pending children involved in a cycle will still be in the pending state. The taskmaster removes nodes from the pending_children set as soon as a pending_children node moves out of the pending state. This also helps to keep the pending_children set small.","startLine":729,"endLine":804,"calleeNames":["str","len"]},"acm000005999jsd":{"type":"ControlElement","id":"acm000005999jsd","name":"tm_trace_node","comment":"","startLine":806,"endLine":809,"calleeNames":["get_state","repr","str"]},"acm000006000jsd":{"type":"ControlElement","id":"acm000006000jsd","name":"_find_next_ready_node","comment":"Finds the next node that is ready to be built. This is *the* main guts of the DAG walk. We loop through the list of candidates, looking for something that has no un-built children (i.e., that is a leaf Node or has dependencies that are all leaf Nodes or up-to-date). Candidate Nodes are re-scanned (both the target Node itself and its sources, which are always scanned in the context of a given target) to discover implicit dependencies. A Node that must wait for some children to be built will be put back on the candidates list after the children have finished building. A Node that has been put back on the candidates list in this way may have itself (or its sources) re-scanned, in order to handle generated header files (e.g.) and the implicit dependencies therein. Note that this method does not do any signature calculation or up-to-date check itself. All of that is handled by the Task class. This is purely concerned with the dependency graph walk.","startLine":811,"endLine":1013,"calleeNames":["write","debug","next_candidate","disambiguate","get_state","hasattr","Stats","append","tm_trace_node","set_state","get_executor","get_all_children","exc_info","ExplicitExit","set","chain","get_all_prerequisites","add","len","reverse","extend","order","get_action_targets","add_to_waiting_parents","repr","str","get_action_side_effects","add_to_waiting_s_e"]},"acm000006001jsd":{"type":"ControlElement","id":"acm000006001jsd","name":"next_task","comment":"Returns the next task to be executed. This simply asks for the next Node to be evaluated, and then wraps it in the specific Task subclass with which we were initialized.","startLine":1015,"endLine":1048,"calleeNames":["_find_next_ready_node","get_executor","get_all_targets","tasker","make_ready","exc_info","exception_set"]},"acm000006002jsd":{"type":"ControlElement","id":"acm000006002jsd","name":"will_not_build","comment":"Perform clean-up about nodes that will never be built. Invokes a user defined function on all of these nodes (including all of their parents).","startLine":1050,"endLine":1093,"calleeNames":["set","debug","tm_trace_node","len","pop","node_func"]},"acm000006003jsd":{"type":"ControlElement","id":"acm000006003jsd","name":"stop","comment":"Stops the current build completely.","startLine":1095,"endLine":1099,"calleeNames":[]},"acm000006004jsd":{"type":"ControlElement","id":"acm000006004jsd","name":"cleanup","comment":"Check for dependency cycles.","startLine":1101,"endLine":1128,"calleeNames":["find_cycle","set","get_state","join","map","repr","UserError"]},"acm000006005jsd":{"type":"ClassUnit","id":"acm000006005jsd","name":"Taskmaster","comment":"The Taskmaster for walking the dependency DAG.","compilationUnitId":"acm000006008jsd","parentDatatypeId":null,"startLine":604,"endLine":1128,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005994jsd","acm000005995jsd","acm000005996jsd","acm000005997jsd","acm000005998jsd","acm000005999jsd","acm000006000jsd","acm000006001jsd","acm000006002jsd","acm000006003jsd","acm000006004jsd"]},"acm000006006jsd":{"type":"ControlElement","id":"acm000006006jsd","name":"dump_stats","comment":"","startLine":109,"endLine":111,"calleeNames":["sorted","str","print"]},"acm000006007jsd":{"type":"ControlElement","id":"acm000006007jsd","name":"find_cycle","comment":"","startLine":590,"endLine":601,"calleeNames":["add","append","find_cycle","pop"]},"acm000006008jsd":{"type":"CodeCompilationUnit","id":"acm000006008jsd","name":"__init__","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nGeneric Taskmaster module for the SCons build engine. This module contains the primary interface(s) between a wrapping user interface and the SCons build engine. There are two key classes here: Taskmaster This is the main engine for walking the dependency graph and calling things to decide what does or doesn't need to be built. Task This is the base class for allowing a wrapping interface to decide what does or doesn't actually need to be done. The intention is for a wrapping interface to subclass this as appropriate for different types of behavior it may need. The canonical example is the SCons native Python interface, which has Task subclasses that handle its specific behavior, like printing \"'foo' is up to date\" when a top-level target doesn't need to be built, and handling the -c option by removing targets as its \"build\" action. There is also a separate subclass for suppressing this output when the -q option is used. The Taskmaster instantiates a Task object for each (set of) target(s) that it decides need to be evaluated and/or built.","parentId":"acm000006009jsd","content":["acm000005968jsd","acm000005989jsd","acm000005991jsd","acm000005993jsd","acm000006005jsd","acm000006006jsd","acm000006007jsd"],"pathElements":["Taskmaster"],"extension":"py","language":"PYTHON3","importedModuleNames":["io","sys","abc.ABC","abc.abstractmethod","itertools.chain","logging","SCons.Errors","SCons.Node","SCons.Warnings","SCons.Util.DispatchingFormatter"]},"acm000006009jsd":{"type":"CodePackage","id":"acm000006009jsd","name":"Taskmaster","comment":"","parentId":null,"content":["acm000005842jsd","acm000005911jsd","acm000005966jsd","acm000006008jsd"]},"acm000006010jsd":{"type":"ControlElement","id":"acm000006010jsd","name":"__init__","comment":"","startLine":241,"endLine":247,"calleeNames":["setattr"]},"acm000006011jsd":{"type":"ControlElement","id":"acm000006011jsd","name":"__call__","comment":"","startLine":249,"endLine":251,"calleeNames":["method"]},"acm000006012jsd":{"type":"ControlElement","id":"acm000006012jsd","name":"clone","comment":"Returns an object that re-binds the underlying \"method\" to the specified new object.\nThe original idea for AddMethod() came from the\nfollowing post to the ActiveState Python Cookbook:\n\nASPN: Python Cookbook : Install bound methods in an instance\nhttps://code.activestate.com/recipes/223613\n\nChanged as follows:\n* Switched the installmethod() \"object\" and \"function\" arguments,\nso the order reflects that the left-hand side is the thing being\n\"assigned to\" and the right-hand side is the value being assigned.\n* The instance/class detection is changed a bit, as it's all\nnew-style classes now with Py3.\n* The by-hand construction of the function object from renamefunction()\nis not needed, the remaining bit is now used inline in AddMethod.","startLine":253,"endLine":258,"calleeNames":["__class__"]},"acm000006013jsd":{"type":"ClassUnit","id":"acm000006013jsd","name":"MethodWrapper","comment":"A generic Wrapper class that associates a method with an object. As part of creating this MethodWrapper object an attribute with the specified name (by default, the name of the supplied method) is added to the underlying object. When that new \"method\" is called, our :meth:`__call__` method adds the object as the first argument, simulating the Python behavior of supplying \"self\" on method calls. We hang on to the name by which the method was added to the underlying base class so that we can provide a method to \"clone\" ourselves onto a new underlying object being copied (without which we wouldn't need to save that info).","compilationUnitId":"acm000006018jsd","parentDatatypeId":null,"startLine":227,"endLine":258,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006010jsd","acm000006011jsd","acm000006012jsd"]},"acm000006014jsd":{"type":"ControlElement","id":"acm000006014jsd","name":"PrependPath","comment":"Prepend *newpath* path elements to *oldpath*. Will only add any particular path once (leaving the first one it encounters and ignoring the rest, to preserve path order), and will :mod:`os.path.normpath` and :mod:`os.path.normcase` all paths to help assure this. This can also handle the case where *oldpath* is a list instead of a string, in which case a list will be returned instead of a string. For example: >>> p = PrependPath(\"/foo/bar:/foo\", \"/biz/boom:/foo\") >>> print(p) /biz/boom:/foo:/foo/bar If *delete_existing* is ``False``, then adding a path that exists will not move it to the beginning; it will stay where it is in the list. >>> p = PrependPath(\"/foo/bar:/foo\", \"/biz/boom:/foo\", delete_existing=False) >>> print(p) /biz/boom:/foo/bar:/foo If *canonicalize* is not ``None``, it is applied to each element of *newpath* before use.","startLine":19,"endLine":106,"calleeNames":["is_List","is_Tuple","split","is_String","list","map","normpath","normcase","append","reverse","insert","join"]},"acm000006015jsd":{"type":"ControlElement","id":"acm000006015jsd","name":"AppendPath","comment":"Append *newpath* path elements to *oldpath*. Will only add any particular path once (leaving the last one it encounters and ignoring the rest, to preserve path order), and will :mod:`os.path.normpath` and :mod:`os.path.normcase` all paths to help assure this. This can also handle the case where *oldpath* is a list instead of a string, in which case a list will be returned instead of a string. For example: >>> p = AppendPath(\"/foo/bar:/foo\", \"/biz/boom:/foo\") >>> print(p) /foo/bar:/biz/boom:/foo If *delete_existing* is ``False``, then adding a path that exists will not move it to the end; it will stay where it is in the list. >>> p = AppendPath(\"/foo/bar:/foo\", \"/biz/boom:/foo\", delete_existing=False) >>> print(p) /foo/bar:/foo:/biz/boom If *canonicalize* is not ``None``, it is applied to each element of *newpath* before use.","startLine":109,"endLine":196,"calleeNames":["is_List","is_Tuple","split","is_String","list","map","append","normpath","normcase","reverse","join"]},"acm000006016jsd":{"type":"ControlElement","id":"acm000006016jsd","name":"AddPathIfNotExists","comment":"Add a path element to a construction variable. `key` is looked up in `env_dict`, and `path` is added to it if it is not already present. `env_dict[key]` is assumed to be in the format of a PATH variable: a list of paths separated by `sep` tokens. >>> env = {'PATH': '/bin:/usr/bin:/usr/local/bin'} >>> AddPathIfNotExists(env, 'PATH', '/opt/bin') >>> print(env['PATH']) /opt/bin:/bin:/usr/bin:/usr/local/bin","startLine":199,"endLine":224,"calleeNames":["is_List","split","normcase","list","map","join"]},"acm000006017jsd":{"type":"ControlElement","id":"acm000006017jsd","name":"AddMethod","comment":"Add a method to an object. Adds *function* to *obj* if *obj* is a class object. Adds *function* as a bound method if *obj* is an instance object. If *obj* looks like an environment instance, use :class:`~SCons.Util.MethodWrapper` to add it. If *name* is supplied it is used as the name of *function*. Although this works for any class object, the intent as a public API is to be used on Environment, to be able to add a method to all construction environments; it is preferred to use ``env.AddMethod`` to add to an individual environment. >>> class A: ... ... >>> a = A() >>> def f(self, x, y): ... self.z = x + y >>> AddMethod(A, f, \"add\") >>> a.add(2, 4) >>> print(a.z) 6 >>> a.data = ['a', 'b', 'c', 'd', 'e', 'f'] >>> AddMethod(a, lambda self, i: self.data[i], \"listIndex\") >>> print(a.listIndex(3)) d\n\"rename\"\nobj is an instance, so it gets a bound method.\nobj is a class\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":277,"endLine":329,"calleeNames":["FunctionType","hasattr","MethodWrapper","append","MethodType","setattr"]},"acm000006018jsd":{"type":"CodeCompilationUnit","id":"acm000006018jsd","name":"envs","comment":"SPDX-License-Identifier: MIT\n\nCopyright The SCons Foundation\nSCons environment utility functions. Routines for working with environments and construction variables that don't need the specifics of the Environment class.","parentId":"acm000006271jsd","content":["acm000006013jsd","acm000006014jsd","acm000006015jsd","acm000006016jsd","acm000006017jsd"],"pathElements":["Util"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","types.MethodType","types.FunctionType","typing.Union","typing.Callable","typing.Optional","typing.Any","sctypes.is_List","sctypes.is_Tuple","sctypes.is_String"]},"acm000006019jsd":{"type":"ClassUnit","id":"acm000006019jsd","name":"SConsLockFailure","comment":"Lock failure exception.","compilationUnitId":"acm000006027jsd","parentDatatypeId":null,"startLine":38,"endLine":39,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000006020jsd":{"type":"ControlElement","id":"acm000006020jsd","name":"__init__","comment":"It isn't completely obvious where to put the lockfile.\nThis scheme depends on diffrent processes using the same path\nto the lockfile, since the lockfile is the magic resource,\nnot the file itself. getcwd() is no good for testcases, each of\nwhich run in a unique test directory. tempfile is no good,\nas those are (intentionally) unique per process.\nOur simple first guess is just put it where the file is.","startLine":74,"endLine":95,"calleeNames":["ValueError"]},"acm000006021jsd":{"type":"ControlElement","id":"acm000006021jsd","name":"acquire_lock","comment":"Acquire the lock, if possible. If the lock is in use, check again every *delay* seconds. Continue until lock acquired or *timeout* expires.","startLine":97,"endLine":121,"calleeNames":["perf_counter","open","SConsLockFailure","sleep","release_lock"]},"acm000006022jsd":{"type":"ControlElement","id":"acm000006022jsd","name":"release_lock","comment":"Release the lock by deleting the lockfile.","startLine":123,"endLine":128,"calleeNames":["close","unlink"]},"acm000006023jsd":{"type":"ControlElement","id":"acm000006023jsd","name":"__enter__","comment":"Context manager entry: acquire lock if not holding.","startLine":130,"endLine":134,"calleeNames":["acquire_lock"]},"acm000006024jsd":{"type":"ControlElement","id":"acm000006024jsd","name":"__exit__","comment":"Context manager exit: release lock if holding.","startLine":136,"endLine":139,"calleeNames":["release_lock"]},"acm000006025jsd":{"type":"ControlElement","id":"acm000006025jsd","name":"__repr__","comment":"Nicer display if someone repr's the lock class.","startLine":141,"endLine":149,"calleeNames":[]},"acm000006026jsd":{"type":"ClassUnit","id":"acm000006026jsd","name":"FileLock","comment":"Lock a file using a lockfile. Locking for the case where multiple processes try to hit an externally shared resource that cannot depend on locking within a single SCons process. SCons does not have a lot of those, but caches come to mind. Cross-platform safe, does not use any OS-specific features. Provides context manager support, or can be called with :meth:`acquire_lock` and :meth:`release_lock`. Lock can be a write lock, which is held until released, or a read lock, which releases immediately upon aquisition - the interesting thing being to not read a file which somebody else may be writing, TODO: Should default timeout be None (non-blocking), or 0 (block forever), or some arbitrary number? Arguments: file: name of file to lock. Only used to build the lockfile name. timeout: optional time (sec) to give up trying. If ``None``, quit now if we failed to get the lock (non-blocking). If 0, block forever (well, a long time). delay: optional delay between tries [default 0.05s] writer: if True, obtain the lock for safe writing. If False (default), just wait till the lock is available, give it back right away. Raises: SConsLockFailure: if the operation \"timed out\", including the non-blocking mode.","compilationUnitId":"acm000006027jsd","parentDatatypeId":null,"startLine":42,"endLine":149,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006020jsd","acm000006021jsd","acm000006022jsd","acm000006023jsd","acm000006024jsd","acm000006025jsd"]},"acm000006027jsd":{"type":"CodeCompilationUnit","id":"acm000006027jsd","name":"filelock","comment":"MIT License\n\nCopyright The SCons Foundation\nSCons file locking functions. Simple-minded filesystem-based locking. Provides a context manager which acquires a lock (or at least, permission) on entry and releases it on exit. Usage:: from SCons.Util.filelock import FileLock with FileLock(\"myfile.txt\", writer=True) as lock: print(f\"Lock on {lock.file} acquired.\") # work with the file as it is now locked\nTODO: things to consider.\nIs raising an exception the right thing for failing to get lock?\nIs a filesystem lockfile scheme sufficient for our needs?\n- or is it better to put locks on the actual file (fcntl/windows-based)?\n... Is that even viable in the case of a remote (network) file?\nIs this safe enough? Or do we risk dangling lockfiles?\nPermission issues in case of multi-user. This *should* be okay,\nthe cache usually goes in user's homedir, plus you already have\nenough rights for the lockfile if the dir lets you create the cache.\nNeed a forced break-lock method?\nThe lock attributes could probably be made opaque. Showed one visible\nin the example above, but not sure the benefit of that.","parentId":"acm000006271jsd","content":["acm000006019jsd","acm000006026jsd"],"pathElements":["Util"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","time","typing.Optional"]},"acm000006028jsd":{"type":"ControlElement","id":"acm000006028jsd","name":"_attempt_init_of_python_3_9_hash_object","comment":"Initialize hash function with non-security indicator. In Python 3.9 and onwards, :mod:`hashlib` constructors accept a keyword argument *usedforsecurity*, which, if set to ``False``, lets us continue to use algorithms that have been deprecated either by FIPS or by Python itself, as the MD5 algorithm SCons prefers is not being used for security purposes as much as a short, 32 char hash that is resistant to accidental collisions. In prior versions of python, :mod:`hashlib` returns a native function wrapper, which errors out when it's queried for the optional parameter, so this function wraps that call. It can still throw a ValueError if the initialization fails due to FIPS compliance issues, but that is assumed to be the responsibility of the caller.\nhttps://stackoverflow.com/a/11887885 details how to check versions\nwith the \"packaging\" library. However, for our purposes, checking\nthe version is greater than or equal to 3.9 is good enough, as the API\nis guaranteed to have support for the 'usedforsecurity' flag in 3.9. See\nhttps://docs.python.org/3/library/hashlib.html#:~:text=usedforsecurity\nfor the version support notes.\nNote that this can throw a ValueError in FIPS-enabled versions of\nLinux prior to 3.9. The OpenSSL hashlib will throw on first init here,\nbut it is assumed to be responsibility of the caller to diagnose the\nValueError & potentially display the error to screen.","startLine":26,"endLine":62,"calleeNames":["hash_function_object"]},"acm000006029jsd":{"type":"ControlElement","id":"acm000006029jsd","name":"_set_allowed_viable_default_hashes","comment":"Check if the default hash algorithms can be called. This util class is sometimes called prior to setting the user-selected hash algorithm, meaning that on FIPS-compliant systems the library would default-initialize MD5 and throw an exception in set_hash_format. A common case is using the SConf options, which can run prior to main, and thus ignore the options.hash_format variable. This function checks the DEFAULT_HASH_FORMATS and sets the ALLOWED_HASH_FORMATS to only the ones that can be called. In Python >= 3.9 this will always default to MD5 as in Python 3.9 there is an optional attribute \"usedforsecurity\" set for the method. Throws if no allowed hash formats are detected.","startLine":65,"endLine":111,"calleeNames":["getattr","_attempt_init_of_python_3_9_hash_object","append","len","SConsEnvironmentError"]},"acm000006030jsd":{"type":"ControlElement","id":"acm000006030jsd","name":"get_hash_format","comment":"Retrieves the hash format or ``None`` if not overridden. A return value of ``None`` does not guarantee that MD5 is being used; instead, it means that the default precedence order documented in :func:`SCons.Util.set_hash_format` is respected.","startLine":117,"endLine":125,"calleeNames":[]},"acm000006031jsd":{"type":"ControlElement","id":"acm000006031jsd","name":"_attempt_get_hash_function","comment":"Wrapper used to try to initialize a hash function given. If successful, returns the name of the hash function back to the user. Otherwise returns None.\nIf attempt_init_of_python_3_9 throws, this is typically due to FIPS\nbeing enabled. However, if we get to this point, the viable hash\nfunction check has either been bypassed or otherwise failed to\nproperly restrict the user to only the supported functions.\nAs such throw the UserError as an internal assertion-like error.","startLine":128,"endLine":147,"calleeNames":["getattr","_attempt_init_of_python_3_9_hash_object"]},"acm000006032jsd":{"type":"ControlElement","id":"acm000006032jsd","name":"set_hash_format","comment":"Sets the default hash format used by SCons. If `hash_format` is ``None`` or an empty string, the default is determined by this function. Currently the default behavior is to use the first available format of the following options: MD5, SHA1, SHA256.","startLine":150,"endLine":242,"calleeNames":["lower","UserError","join","_attempt_get_hash_function"]},"acm000006033jsd":{"type":"ControlElement","id":"acm000006033jsd","name":"get_current_hash_algorithm_used","comment":"Returns the current hash algorithm name used. Where the python version >= 3.9, this is expected to return md5. If python's version is <= 3.8, this returns md5 on non-FIPS-mode platforms, and sha1 or sha256 on FIPS-mode Linux platforms. This function is primarily useful for testing, where one expects a value to be one of N distinct hashes, and therefore the test needs to know which hash to select.","startLine":252,"endLine":262,"calleeNames":[]},"acm000006034jsd":{"type":"ControlElement","id":"acm000006034jsd","name":"_get_hash_object","comment":"Allocates a hash object using the requested hash format. Args: hash_format: Hash format to use. Returns: hashlib object.\npylint: disable=import-outside-toplevel\npylint: disable=import-outside-toplevel","startLine":265,"endLine":297,"calleeNames":["UserError","_attempt_init_of_python_3_9_hash_object","getattr","hasattr"]},"acm000006035jsd":{"type":"ControlElement","id":"acm000006035jsd","name":"hash_signature","comment":"Generate hash signature of a string Args: s: either string or bytes. Normally should be bytes hash_format: Specify to override default hash format Returns: String of hex digits representing the signature","startLine":300,"endLine":317,"calleeNames":["_get_hash_object","update","to_bytes","str","hexdigest"]},"acm000006036jsd":{"type":"ControlElement","id":"acm000006036jsd","name":"hash_file_signature","comment":"Generate the md5 signature of a file Args: fname: file to hash chunksize: chunk size to read hash_format: Specify to override default hash format Returns: String of Hex digits representing the signature","startLine":320,"endLine":344,"calleeNames":["_get_hash_object","open","read","update","to_bytes","hexdigest"]},"acm000006037jsd":{"type":"ControlElement","id":"acm000006037jsd","name":"hash_collect","comment":"Collects a list of signatures into an aggregate signature. Args: signatures: a list of signatures hash_format: Specify to override default hash format Returns: the aggregate signature","startLine":347,"endLine":362,"calleeNames":["len","hash_signature","join"]},"acm000006038jsd":{"type":"ControlElement","id":"acm000006038jsd","name":"_show_md5_warning","comment":"Shows a deprecation warning for various MD5 functions.\npylint: disable=import-outside-toplevel","startLine":368,"endLine":380,"calleeNames":["warn"]},"acm000006039jsd":{"type":"ControlElement","id":"acm000006039jsd","name":"MD5signature","comment":"Deprecated. Use :func:`hash_signature` instead.","startLine":383,"endLine":387,"calleeNames":["_show_md5_warning","hash_signature"]},"acm000006040jsd":{"type":"ControlElement","id":"acm000006040jsd","name":"MD5filesignature","comment":"Deprecated. Use :func:`hash_file_signature` instead.","startLine":390,"endLine":394,"calleeNames":["_show_md5_warning","hash_file_signature"]},"acm000006041jsd":{"type":"ControlElement","id":"acm000006041jsd","name":"MD5collect","comment":"Deprecated. Use :func:`hash_collect` instead.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":397,"endLine":401,"calleeNames":["_show_md5_warning","hash_collect"]},"acm000006042jsd":{"type":"CodeCompilationUnit","id":"acm000006042jsd","name":"hashes","comment":"SPDX-License-Identifier: MIT\n\nCopyright The SCons Foundation\nSCons hash utility routines. Routines for working with content and signature hashes.\nDefault hash function and format. SCons-internal.","parentId":"acm000006271jsd","content":["acm000006028jsd","acm000006029jsd","acm000006030jsd","acm000006031jsd","acm000006032jsd","acm000006033jsd","acm000006034jsd","acm000006035jsd","acm000006036jsd","acm000006037jsd","acm000006038jsd","acm000006039jsd","acm000006040jsd","acm000006041jsd"],"pathElements":["Util"],"extension":"py","language":"PYTHON3","importedModuleNames":["functools","hashlib","sys","typing.Optional","typing.Union","sctypes.to_bytes"]},"acm000006043jsd":{"type":"ControlElement","id":"acm000006043jsd","name":"__new__","comment":"","startLine":114,"endLine":117,"calleeNames":["vars","super","__new__"]},"acm000006044jsd":{"type":"ControlElement","id":"acm000006044jsd","name":"__init__","comment":"","startLine":119,"endLine":120,"calleeNames":[]},"acm000006045jsd":{"type":"ControlElement","id":"acm000006045jsd","name":"__call__","comment":"","startLine":122,"endLine":123,"calleeNames":[]},"acm000006046jsd":{"type":"ControlElement","id":"acm000006046jsd","name":"__repr__","comment":"","startLine":125,"endLine":126,"calleeNames":[]},"acm000006047jsd":{"type":"ControlElement","id":"acm000006047jsd","name":"__bool__","comment":"","startLine":128,"endLine":129,"calleeNames":[]},"acm000006048jsd":{"type":"ControlElement","id":"acm000006048jsd","name":"__getattr__","comment":"","startLine":131,"endLine":132,"calleeNames":[]},"acm000006049jsd":{"type":"ControlElement","id":"acm000006049jsd","name":"__setattr__","comment":"","startLine":134,"endLine":135,"calleeNames":[]},"acm000006050jsd":{"type":"ControlElement","id":"acm000006050jsd","name":"__delattr__","comment":"","startLine":137,"endLine":138,"calleeNames":[]},"acm000006051jsd":{"type":"ClassUnit","id":"acm000006051jsd","name":"Null","comment":"Null objects always and reliably 'do nothing'.","compilationUnitId":"acm000006073jsd","parentDatatypeId":null,"startLine":111,"endLine":138,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006043jsd","acm000006044jsd","acm000006045jsd","acm000006046jsd","acm000006047jsd","acm000006048jsd","acm000006049jsd","acm000006050jsd"]},"acm000006052jsd":{"type":"ControlElement","id":"acm000006052jsd","name":"__len__","comment":"","startLine":144,"endLine":145,"calleeNames":[]},"acm000006053jsd":{"type":"ControlElement","id":"acm000006053jsd","name":"__iter__","comment":"","startLine":147,"endLine":148,"calleeNames":["iter"]},"acm000006054jsd":{"type":"ControlElement","id":"acm000006054jsd","name":"__getitem__","comment":"","startLine":150,"endLine":151,"calleeNames":[]},"acm000006055jsd":{"type":"ControlElement","id":"acm000006055jsd","name":"__delitem__","comment":"","startLine":153,"endLine":154,"calleeNames":[]},"acm000006056jsd":{"type":"ControlElement","id":"acm000006056jsd","name":"__setitem__","comment":"","startLine":156,"endLine":157,"calleeNames":[]},"acm000006057jsd":{"type":"ClassUnit","id":"acm000006057jsd","name":"NullSeq","comment":"A Null object that can also be iterated over.","compilationUnitId":"acm000006073jsd","parentDatatypeId":null,"startLine":141,"endLine":157,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006052jsd","acm000006053jsd","acm000006054jsd","acm000006055jsd","acm000006056jsd"]},"acm000006058jsd":{"type":"ControlElement","id":"acm000006058jsd","name":"is_Dict","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nCheck if object is a dict.","startLine":54,"endLine":58,"calleeNames":["isinstance"]},"acm000006059jsd":{"type":"ControlElement","id":"acm000006059jsd","name":"is_List","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nCheck if object is a list.","startLine":61,"endLine":65,"calleeNames":["isinstance"]},"acm000006060jsd":{"type":"ControlElement","id":"acm000006060jsd","name":"is_Sequence","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nCheck if object is a sequence.","startLine":68,"endLine":72,"calleeNames":["isinstance"]},"acm000006061jsd":{"type":"ControlElement","id":"acm000006061jsd","name":"is_Tuple","comment":"pylint: disable=redefined-builtin\nCheck if object is a tuple.","startLine":75,"endLine":79,"calleeNames":["isinstance"]},"acm000006062jsd":{"type":"ControlElement","id":"acm000006062jsd","name":"is_String","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nCheck if object is a string.","startLine":82,"endLine":86,"calleeNames":["isinstance"]},"acm000006063jsd":{"type":"ControlElement","id":"acm000006063jsd","name":"is_Scalar","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nCheck if object is a scalar: not a container or iterable.\nProfiling shows that there is an impressive speed-up of 2x\nwhen explicitly checking for strings instead of just not\nsequence when the argument (i.e. obj) is already a string.\nBut, if obj is a not string then it is twice as fast to\ncheck only for 'not sequence'. The following code therefore\nassumes that the obj argument is a string most of the time.\nUpdate: now using collections.abc.Iterable for the 2nd check.\nNote: None is considered a \"scalar\" for this check, which is correct\nfor the usage in SCons.Environment._add_cppdefines.\nFrom Dinu C. Gherman,\nPython Cookbook, second edition, recipe 6.17, p. 277.\nAlso: https://code.activestate.com/recipes/68205\nASPN: Python Cookbook: Null Object Design Pattern","startLine":89,"endLine":102,"calleeNames":["isinstance"]},"acm000006064jsd":{"type":"ControlElement","id":"acm000006064jsd","name":"to_bytes","comment":"Convert object to bytes.\nif already bytes return.","startLine":160,"endLine":167,"calleeNames":["isinstance","bytes"]},"acm000006065jsd":{"type":"ControlElement","id":"acm000006065jsd","name":"to_str","comment":"Convert object to string.\nGeneric convert-to-string functions. The wrapper\nto_String_for_signature() will use a for_signature() method if the\nspecified object has one.","startLine":170,"endLine":176,"calleeNames":["is_String","str"]},"acm000006066jsd":{"type":"ControlElement","id":"acm000006066jsd","name":"to_String","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nReturn a string version of obj. Use this for data likely to be well-behaved. Use :func:`to_Text` for unknown file data that needs to be decoded.\nEarly out when already a string!\nobj.data can only be a regular string. Please see the UserString initializer.","startLine":184,"endLine":204,"calleeNames":["isinstance","str"]},"acm000006067jsd":{"type":"ControlElement","id":"acm000006067jsd","name":"to_String_for_subst","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nReturn a string version of obj for subst usage.\nNote that the test cases are sorted by order of probability.\nobj.data can only a regular string. Please see the UserString initializer.","startLine":207,"endLine":227,"calleeNames":["isinstance","join","to_String_for_subst","str"]},"acm000006068jsd":{"type":"ControlElement","id":"acm000006068jsd","name":"to_String_for_signature","comment":"pylint: disable=redefined-outer-name,redefined-builtin\nReturn a string version of obj for signature usage. Like :func:`to_String_for_subst` but has special handling for scons objects that have a :meth:`for_signature` method, and for dicts.\npprint will output dictionary in key sorted order\nwith py3.5 the order was randomized. Depending on dict order\nwhich was undefined until py3.6 (where it's by insertion order)\nwas not wise.\nTODO: Change code when floor is raised to PY36","startLine":230,"endLine":249,"calleeNames":["isinstance","pformat","to_String_for_subst","f"]},"acm000006069jsd":{"type":"ControlElement","id":"acm000006069jsd","name":"to_Text","comment":"Return bytes data converted to text. Useful for whole-file reads where the data needs some interpretation, particularly for Scanners. Attempts to figure out what the encoding of the text is based upon the BOM bytes, and then decodes the contents so that it's a valid python string.","startLine":252,"endLine":285,"calleeNames":["startswith","decode","len","getpreferredencoding"]},"acm000006070jsd":{"type":"ControlElement","id":"acm000006070jsd","name":"get_env_bool","comment":"Convert a construction variable to bool. If the value of *name* in dict-like object *env* is 'true', 'yes', 'y', 'on' (case insensitive) or anything convertible to int that yields non-zero, return ``True``; if 'false', 'no', 'n', 'off' (case insensitive) or a number that converts to integer zero return ``False``. Otherwise, or if *name* is not found, return the value of *default*. Args: env: construction environment, or any dict-like object. name: name of the variable. default: value to return if *name* not in *env* or cannot be converted (default: False).","startLine":288,"endLine":317,"calleeNames":["bool","int","str","lower"]},"acm000006071jsd":{"type":"ControlElement","id":"acm000006071jsd","name":"get_os_env_bool","comment":"Convert an external environment variable to boolean. Like :func:`get_env_bool`, but uses :attr:`os.environ` as the lookup dict.","startLine":320,"endLine":325,"calleeNames":["get_env_bool"]},"acm000006072jsd":{"type":"ControlElement","id":"acm000006072jsd","name":"get_environment_var","comment":"Return undecorated construction variable string. Determine if *varstr* looks like a reference to a single environment variable, like ``\"$FOO\"`` or ``\"${FOO}\"``. If so, return that variable with no decorations, like ``\"FOO\"``. If not, return ``None``.","startLine":331,"endLine":346,"calleeNames":["match","to_String","group"]},"acm000006073jsd":{"type":"CodeCompilationUnit","id":"acm000006073jsd","name":"sctypes","comment":"SPDX-License-Identifier: MIT\n\nCopyright The SCons Foundation\nVarious SCons utility functions Routines which check types and do type conversions.\nFunctions for deciding if things are like various types, mainly to\nhandle UserDict, UserList and UserString like their underlying types.\n\nYes, all of this manual testing breaks polymorphism, and the real\nPythonic way to do all of this would be to just try it and handle the\nexception, but handling the exception when it's not the right type is\noften too slow.\nA trick is used to speed up these functions. Default arguments are\nused to take a snapshot of the global functions and constants used\nby these functions. This transforms accesses to global variables into\nlocal variable accesses (i.e. LOAD_FAST instead of LOAD_GLOBAL).\nSince checkers dislike this, it's now annotated for pylint, to flag\n(mostly for other readers of this code) we're doing this intentionally.\nTODO: experts affirm this is still faster, but maybe check if worth it?","parentId":"acm000006271jsd","content":["acm000006051jsd","acm000006057jsd","acm000006058jsd","acm000006059jsd","acm000006060jsd","acm000006061jsd","acm000006062jsd","acm000006063jsd","acm000006064jsd","acm000006065jsd","acm000006066jsd","acm000006067jsd","acm000006068jsd","acm000006069jsd","acm000006070jsd","acm000006071jsd","acm000006072jsd"],"pathElements":["Util"],"extension":"py","language":"PYTHON3","importedModuleNames":["codecs","os","pprint","re","typing.Optional","collections.UserDict","collections.UserList","collections.UserString","collections.deque","collections.abc.MappingView","collections.abc.Iterable"]},"acm000006074jsd":{"type":"CodeCompilationUnit","id":"acm000006074jsd","name":"sctyping","comment":"SPDX-License-Identifier: MIT\n\nCopyright The SCons Foundation\nVarious SCons type aliases. For representing complex types across the entire repo without risking circular dependencies, we take advantage of TYPE_CHECKING to import modules in an tool-only environment. This allows us to introduce hinting that resolves as expected in IDEs without clashing at runtime. For consistency, it's recommended to ALWAYS use these aliases in a type-hinting context, even if the type is actually expected to be resolved in a given file.\nBecause we don't have access to TypeAlias until 3.10, we have to utilize\n'Union' for all aliases. As it expects at least two entries, anything that\nis only represented with a single type needs to list itself twice.","parentId":"acm000006271jsd","content":[],"pathElements":["Util"],"extension":"py","language":"PYTHON3","importedModuleNames":["typing.Union","typing.TYPE_CHECKING"]},"acm000006075jsd":{"type":"ControlElement","id":"acm000006075jsd","name":"__init__","comment":"","startLine":66,"endLine":71,"calleeNames":[]},"acm000006076jsd":{"type":"ControlElement","id":"acm000006076jsd","name":"do_append","comment":"","startLine":73,"endLine":74,"calleeNames":[]},"acm000006077jsd":{"type":"ControlElement","id":"acm000006077jsd","name":"do_print","comment":"","startLine":76,"endLine":77,"calleeNames":[]},"acm000006078jsd":{"type":"ControlElement","id":"acm000006078jsd","name":"enable","comment":"","startLine":79,"endLine":83,"calleeNames":[]},"acm000006079jsd":{"type":"ControlElement","id":"acm000006079jsd","name":"do_nothing","comment":"","startLine":85,"endLine":86,"calleeNames":[]},"acm000006080jsd":{"type":"ClassUnit","id":"acm000006080jsd","name":"Stats","comment":"","compilationUnitId":"acm000006094jsd","parentDatatypeId":null,"startLine":65,"endLine":86,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006075jsd","acm000006076jsd","acm000006077jsd","acm000006078jsd","acm000006079jsd"]},"acm000006081jsd":{"type":"ControlElement","id":"acm000006081jsd","name":"__init__","comment":"","startLine":66,"endLine":71,"calleeNames":[]},"acm000006082jsd":{"type":"ControlElement","id":"acm000006082jsd","name":"do_append","comment":"","startLine":73,"endLine":74,"calleeNames":[]},"acm000006083jsd":{"type":"ControlElement","id":"acm000006083jsd","name":"do_print","comment":"","startLine":76,"endLine":77,"calleeNames":[]},"acm000006084jsd":{"type":"ClassUnit","id":"acm000006084jsd","name":"CountStats","comment":"","compilationUnitId":"acm000006094jsd","parentDatatypeId":null,"startLine":89,"endLine":121,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006081jsd","acm000006082jsd","acm000006083jsd"]},"acm000006085jsd":{"type":"ControlElement","id":"acm000006085jsd","name":"do_append","comment":"","startLine":73,"endLine":74,"calleeNames":[]},"acm000006086jsd":{"type":"ControlElement","id":"acm000006086jsd","name":"do_print","comment":"","startLine":76,"endLine":77,"calleeNames":[]},"acm000006087jsd":{"type":"ClassUnit","id":"acm000006087jsd","name":"MemStats","comment":"","compilationUnitId":"acm000006094jsd","parentDatatypeId":null,"startLine":124,"endLine":132,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006085jsd","acm000006086jsd"]},"acm000006088jsd":{"type":"ControlElement","id":"acm000006088jsd","name":"__init__","comment":"","startLine":66,"endLine":71,"calleeNames":[]},"acm000006089jsd":{"type":"ControlElement","id":"acm000006089jsd","name":"total_times","comment":"","startLine":141,"endLine":147,"calleeNames":[]},"acm000006090jsd":{"type":"ControlElement","id":"acm000006090jsd","name":"add_command","comment":"","startLine":149,"endLine":154,"calleeNames":["print"]},"acm000006091jsd":{"type":"ClassUnit","id":"acm000006091jsd","name":"TimeStats","comment":"","compilationUnitId":"acm000006094jsd","parentDatatypeId":null,"startLine":135,"endLine":154,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006088jsd","acm000006089jsd","acm000006090jsd"]},"acm000006092jsd":{"type":"ControlElement","id":"acm000006092jsd","name":"add_stat_type","comment":"Add a statistic type to the global collection","startLine":58,"endLine":62,"calleeNames":["UserWarning"]},"acm000006093jsd":{"type":"ControlElement","id":"acm000006093jsd","name":"write_scons_stats_file","comment":"Actually write the JSON file with debug information. Depending which of : count, time, action-timestamps,memory their information will be written.\nHave to import where used to avoid import loop\npylint: disable=import-outside-toplevel\nprint(f\"DUMPING JSON FILE: {JSON_OUTPUT_FILE}\")","startLine":162,"endLine":217,"calleeNames":["zip","join","str","now","isoformat","node","open","write","dumps"]},"acm000006094jsd":{"type":"CodeCompilationUnit","id":"acm000006094jsd","name":"stats","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons statistics routines. This package provides a way to gather various statistics during an SCons run and dump that info in several formats Additionally, it probably makes sense to do stderr/stdout output of those statistics here as well There are basically two types of stats: 1. Timer (start/stop/time) for specific event. These events can be hierarchical. So you can record the children events of some parent. Think program compile could contain the total Program builder time, which could include linking, and stripping the executable 2. Counter. Counting the number of events and/or objects created. This would likely only be reported at the end of a given SCons run, though it might be useful to query during a run.","parentId":"acm000006271jsd","content":["acm000006080jsd","acm000006084jsd","acm000006087jsd","acm000006091jsd","acm000006092jsd","acm000006093jsd"],"pathElements":["Util"],"extension":"py","language":"PYTHON3","importedModuleNames":["abc.ABC","platform","json","sys","datetime.datetime","SCons.Debug","SCons.Script.BUILD_TARGETS","SCons.Script.COMMAND_LINE_TARGETS","SCons.Script.ARGUMENTS","SCons.Script.ARGLIST"]},"acm000006095jsd":{"type":"ControlElement","id":"acm000006095jsd","name":"__init__","comment":"","startLine":88,"endLine":89,"calleeNames":[]},"acm000006096jsd":{"type":"ControlElement","id":"acm000006096jsd","name":"write","comment":"","startLine":91,"endLine":92,"calleeNames":[]},"acm000006097jsd":{"type":"ClassUnit","id":"acm000006097jsd","name":"OutBuffer","comment":"","compilationUnitId":"acm000006179jsd","parentDatatypeId":null,"startLine":87,"endLine":92,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006095jsd","acm000006096jsd"]},"acm000006098jsd":{"type":"ControlElement","id":"acm000006098jsd","name":"test_dictify","comment":"Test the dictify() function","startLine":96,"endLine":105,"calleeNames":["dictify"]},"acm000006099jsd":{"type":"ClassUnit","id":"acm000006099jsd","name":"dictifyTestCase","comment":"","compilationUnitId":"acm000006179jsd","parentDatatypeId":null,"startLine":95,"endLine":105,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006098jsd"]},"acm000006100jsd":{"type":"ControlElement","id":"acm000006100jsd","name":"__init__","comment":"","startLine":88,"endLine":89,"calleeNames":[]},"acm000006101jsd":{"type":"ControlElement","id":"acm000006101jsd","name":"__str__","comment":"","startLine":120,"endLine":121,"calleeNames":[]},"acm000006102jsd":{"type":"ControlElement","id":"acm000006102jsd","name":"exists","comment":"","startLine":123,"endLine":124,"calleeNames":[]},"acm000006103jsd":{"type":"ControlElement","id":"acm000006103jsd","name":"rexists","comment":"","startLine":126,"endLine":127,"calleeNames":[]},"acm000006104jsd":{"type":"ControlElement","id":"acm000006104jsd","name":"has_builder","comment":"","startLine":129,"endLine":130,"calleeNames":[]},"acm000006105jsd":{"type":"ControlElement","id":"acm000006105jsd","name":"has_explicit_builder","comment":"","startLine":132,"endLine":133,"calleeNames":[]},"acm000006106jsd":{"type":"ControlElement","id":"acm000006106jsd","name":"side_effect","comment":"","startLine":135,"endLine":136,"calleeNames":[]},"acm000006107jsd":{"type":"ControlElement","id":"acm000006107jsd","name":"precious","comment":"","startLine":138,"endLine":139,"calleeNames":[]},"acm000006108jsd":{"type":"ControlElement","id":"acm000006108jsd","name":"always_build","comment":"","startLine":141,"endLine":142,"calleeNames":[]},"acm000006109jsd":{"type":"ControlElement","id":"acm000006109jsd","name":"is_up_to_date","comment":"","startLine":144,"endLine":145,"calleeNames":[]},"acm000006110jsd":{"type":"ControlElement","id":"acm000006110jsd","name":"noclean","comment":"","startLine":147,"endLine":148,"calleeNames":[]},"acm000006111jsd":{"type":"ClassUnit","id":"acm000006111jsd","name":"Node","comment":"","compilationUnitId":"acm000006179jsd","parentDatatypeId":null,"startLine":114,"endLine":148,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006100jsd","acm000006101jsd","acm000006102jsd","acm000006103jsd","acm00000