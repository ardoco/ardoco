ingjfilename,jlongnativePtr)","comment":"","startLine":142,"endLine":150,"calleeNames":[]},"acm000001563jsd":{"type":"ControlElement","id":"acm000001563jsd","name":"Java_me_rjdj_zengarden_ZGContext_registerReceiver(JNIEnv*env,jobjectjobj,jstringjreceiverName,jlongnativePtr)","comment":"","startLine":152,"endLine":157,"calleeNames":[]},"acm000001564jsd":{"type":"ControlElement","id":"acm000001564jsd","name":"Java_me_rjdj_zengarden_ZGContext_unregisterReceiver(JNIEnv*env,jobjectjobj,jstringjreceiverName,jlongnativePtr)","comment":"","startLine":159,"endLine":164,"calleeNames":[]},"acm000001565jsd":{"type":"ControlElement","id":"acm000001565jsd","name":"Java_me_rjdj_zengarden_ZGContext_sendMessage(JNIEnv*env,jobjectjobj,jstringjreceiverName,jobjectjmessage,jlongnativePtr)","comment":"","startLine":166,"endLine":173,"calleeNames":[]},"acm000001566jsd":{"type":"ControlElement","id":"acm000001566jsd","name":"Java_me_rjdj_zengarden_ZGContext_process(JNIEnv*env,jobjectjobj,jintnumInputChannels,jshortArrayjinputBuffer,jintnumOutputChannels,jshortArrayjoutputBuffer,jintblockSize,jlongnativePtr)","comment":"","startLine":175,"endLine":187,"calleeNames":[]},"acm000001567jsd":{"type":"CodeAssembly","id":"acm000001567jsd","name":"zgcontext","comment":null,"parentId":null,"content":["acm000001557jsd","acm000001558jsd","acm000001559jsd","acm000001560jsd","acm000001561jsd","acm000001562jsd","acm000001563jsd","acm000001564jsd","acm000001565jsd","acm000001566jsd"],"language":"CPP","importedModuleNames":[]},"acm000001568jsd":{"type":"ControlElement","id":"acm000001568jsd","name":"hiBit(constuint32u)const","comment":"Methods\ninitialize with a simple uint32\nor array\nauto-initialize with /dev/urandom or time() and clock()\ncopy\nDo NOT use for CRYPTOGRAPHY without securely hashing several returned\nvalues together, otherwise the generator state can be learned after\nreading 624 consecutive values.\nAccess to 32-bit random numbers\ninteger in [0,2^32-1]\ninteger in [0,n] for n < 2^32\nreal number in [0,1]\nreal number in [0,n]\nreal number in [0,1)\nreal number in [0,n)\nreal number in (0,1)\nreal number in (0,n)\nsame as rand()\nAccess to 53-bit random numbers (capacity of IEEE double precision)\nreal number in [0,1)\nAccess to nonuniform random number distributions\nRe-seeding functions with same behavior as initializers\nSaving and loading generator state\nto array of size SAVE\nfrom such array","startLine":128,"endLine":128,"calleeNames":[]},"acm000001569jsd":{"type":"ControlElement","id":"acm000001569jsd","name":"loBit(constuint32u)const","comment":"","startLine":129,"endLine":129,"calleeNames":[]},"acm000001570jsd":{"type":"ControlElement","id":"acm000001570jsd","name":"loBits(constuint32u)const","comment":"","startLine":130,"endLine":130,"calleeNames":[]},"acm000001571jsd":{"type":"ControlElement","id":"acm000001571jsd","name":"mixBits(constuint32u,constuint32v)const","comment":"","startLine":131,"endLine":132,"calleeNames":[]},"acm000001572jsd":{"type":"ControlElement","id":"acm000001572jsd","name":"magic(constuint32u)const","comment":"","startLine":133,"endLine":134,"calleeNames":[]},"acm000001573jsd":{"type":"ControlElement","id":"acm000001573jsd","name":"twist(constuint32m,constuint32s0,constuint32s1)const","comment":"","startLine":135,"endLine":136,"calleeNames":[]},"acm000001574jsd":{"type":"ClassUnit","id":"acm000001574jsd","name":"MTRand","comment":"MersenneTwister.h\nMersenne Twister random number generator -- a C++ class MTRand\nBased on code by Makoto Matsumoto, Takuji Nishimura, and Shawn Cokus\nRichard J. Wagner  v1.1  28 September 2009  wagnerr@umich.edu\nThe Mersenne Twister is an algorithm for generating random numbers.  It\nwas designed with consideration of the flaws in various other generators.\nThe period, 2^19937-1, and the order of equidistribution, 623 dimensions,\nare far greater.  The generator is also fast; it avoids multiplication and\ndivision, and it benefits from caches and pipelines.  For more information\nsee the inventors' web page at\nhttp://www.math.sci.hiroshima-u.ac.jp/~m-mat/MT/emt.html\nReference\nM. Matsumoto and T. Nishimura, \"Mersenne Twister: A 623-Dimensionally\nEquidistributed Uniform Pseudo-Random Number Generator\", ACM Transactions on\nModeling and Computer Simulation, Vol. 8, No. 1, January 1998, pp 3-30.\nCopyright (C) 1997 - 2002, Makoto Matsumoto and Takuji Nishimura,\nCopyright (C) 2000 - 2009, Richard J. Wagner\nAll rights reserved.\n\nRedistribution and use in source and binary forms, with or without\nmodification, are permitted provided that the following conditions\nare met:\n\n1. Redistributions of source code must retain the above copyright\nnotice, this list of conditions and the following disclaimer.\n\n2. Redistributions in binary form must reproduce the above copyright\nnotice, this list of conditions and the following disclaimer in the\ndocumentation and/or other materials provided with the distribution.\n\n3. The names of its contributors may not be used to endorse or promote\nproducts derived from this software without specific prior written\npermission.\n\nTHIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\"\nAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE\nIMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE\nARE DISCLAIMED.  IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE\nLIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\nCONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\nSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\nINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\nCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\nARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\nPOSSIBILITY OF SUCH DAMAGE.\nThe original code included the following notice:\n\nWhen you use this, send an email to: m-mat@math.sci.hiroshima-u.ac.jp\nwith an appropriate reference to your work.\n\nIt would be nice to CC: wagnerr@umich.edu and Cokus@math.washington.edu\nwhen you write.\nNot thread safe (unless auto-initialization is avoided and each thread has\nits own MTRand object)\nData","compilationUnitId":null,"parentDatatypeId":null,"startLine":70,"endLine":138,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001568jsd","acm000001569jsd","acm000001570jsd","acm000001571jsd","acm000001572jsd","acm000001573jsd"]},"acm000001575jsd":{"type":"ControlElement","id":"acm000001575jsd","name":"MTRand::hash(time_tt,clock_tc)","comment":"Functions are defined in order of usage to assist inlining","startLine":142,"endLine":165,"calleeNames":[]},"acm000001576jsd":{"type":"ControlElement","id":"acm000001576jsd","name":"MTRand::initialize(constuint32seed)","comment":"","startLine":167,"endLine":182,"calleeNames":[]},"acm000001577jsd":{"type":"ControlElement","id":"acm000001577jsd","name":"MTRand::reload()","comment":"","startLine":184,"endLine":198,"calleeNames":[]},"acm000001578jsd":{"type":"ControlElement","id":"acm000001578jsd","name":"MTRand::seed(constuint32oneSeed)","comment":"","startLine":200,"endLine":205,"calleeNames":[]},"acm000001579jsd":{"type":"ControlElement","id":"acm000001579jsd","name":"MTRand::seed(uint32*constbigSeed,constuint32seedLength)","comment":"","startLine":207,"endLine":240,"calleeNames":[]},"acm000001580jsd":{"type":"ControlElement","id":"acm000001580jsd","name":"MTRand::seed()","comment":"MSB is 1, assuring non-zero initial array","startLine":242,"endLine":263,"calleeNames":[]},"acm000001581jsd":{"type":"ControlElement","id":"acm000001581jsd","name":"MTRand::MTRand(constuint32oneSeed)","comment":"","startLine":265,"endLine":266,"calleeNames":[]},"acm000001582jsd":{"type":"ControlElement","id":"acm000001582jsd","name":"MTRand::MTRand(uint32*constbigSeed,constuint32seedLength)","comment":"","startLine":268,"endLine":269,"calleeNames":[]},"acm0000015