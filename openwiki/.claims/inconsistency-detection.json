    {
      "id": "claim_cb68711e53ab4a14a9f7dcedadba23c3",
      "statement": "TEAM detection removes recommended instances that are linked as first endpoints of ConnectionState instance links and candidates sharing words with linked instances, accumulates ELEMENT_WITH_NO_TRACE_LINK and MULTIPLE_OVERLAPPING_RECOMMENDED_INSTANCES support into MissingElementInconsistencyCandidates, and emits one TextEntityAbsentFromModelInconsistency per distinct candidate word with 1-based sentence number and RI probability as confidence when support reaches minSupport (default 1).",
      "evidence": [
        {
          "resource": "repo://inconsistency-detection/stages-id/inconsistency-detection/src/main/java/edu/kit/kastel/mcse/ardoco/id/MissingElementInconsistencyCandidate.java#L13-L43",
