acm000003092jsd","acm000003093jsd","acm000003094jsd","acm000003095jsd","acm000003096jsd","acm000003097jsd","acm000003098jsd"]},"acm000003100jsd":{"type":"ControlElement","id":"acm000003100jsd","name":"setUp","comment":"","startLine":1483,"endLine":1491,"calleeNames":["Builder"]},"acm000003101jsd":{"type":"ControlElement","id":"acm000003101jsd","name":"test___init__","comment":"Test CompositeBuilder creation","startLine":1493,"endLine":1502,"calleeNames":["Environment","Builder","builder","isinstance"]},"acm000003102jsd":{"type":"ControlElement","id":"acm000003102jsd","name":"test_target_action","comment":"Test CompositeBuilder setting of target builder actions","startLine":1504,"endLine":1515,"calleeNames":["Environment","builder","isinstance"]},"acm000003103jsd":{"type":"ControlElement","id":"acm000003103jsd","name":"test_multiple_suffix_error","comment":"Test the CompositeBuilder multiple-source-suffix error","startLine":1517,"endLine":1530,"calleeNames":["Environment","builder","str"]},"acm000003104jsd":{"type":"ControlElement","id":"acm000003104jsd","name":"test_source_ext_match","comment":"Test the CompositeBuilder source_ext_match argument","startLine":1532,"endLine":1541,"calleeNames":["Environment","Builder","builder","build"]},"acm000003105jsd":{"type":"ControlElement","id":"acm000003105jsd","name":"test_suffix_variable","comment":"Test CompositeBuilder defining action suffixes through a variable","startLine":1543,"endLine":1568,"calleeNames":["Environment","Builder","builder","isinstance","build","print","add_action"]},"acm000003106jsd":{"type":"ControlElement","id":"acm000003106jsd","name":"test_src_builder","comment":"Testing Builders with src_builder\nThese used to be MultiStepBuilder objects until we\neliminated it as a separate class","startLine":811,"endLine":865,"calleeNames":["Environment","Builder","MyAction","builder2","str","list","map","builder6"]},"acm000003107jsd":{"type":"ClassUnit","id":"acm000003107jsd","name":"CompositeBuilderTestCase","comment":"","compilationUnitId":"acm000003109jsd","parentDatatypeId":null,"startLine":1481,"endLine":1655,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003100jsd","acm000003101jsd","acm000003102jsd","acm000003103jsd","acm000003104jsd","acm000003105jsd","acm000003106jsd"]},"acm000003108jsd":{"type":"ControlElement","id":"acm000003108jsd","name":"Func","comment":"","startLine":30,"endLine":31,"calleeNames":[]},"acm000003109jsd":{"type":"CodeCompilationUnit","id":"acm000003109jsd","name":"BuilderTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nDefine a null function for use as a builder action.\nWhere this is defined in the file seems to affect its\nbyte-code contents, so try to minimize changes by\ndefining it here, before we even import anything.","parentId":"acm000004231jsd","content":["acm000003042jsd","acm000003046jsd","acm000003063jsd","acm000003065jsd","acm000003099jsd","acm000003107jsd","acm000003108jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.compat","collections.UserList","io","os.path","re","sys","unittest","TestCmd","SCons.Action","SCons.Builder","SCons.Environment","SCons.Errors","SCons.Subst","SCons.Util","SCons.Util.sctyping.ExecutorType","SCons.Warnings","pathlib.Path","SCons.Scanner"]},"acm000003110jsd":{"type":"ControlElement","id":"acm000003110jsd","name":"__init__","comment":"Initialize a CacheDir object. The cache configuration is stored in the object. It is read from the config file in the supplied path if one exists, if not the config file is created and the default config is written, as well as saved in the object.","startLine":136,"endLine":154,"calleeNames":["dict","_readconfig"]},"acm000003111jsd":{"type":"ControlElement","id":"acm000003111jsd","name":"_readconfig","comment":"Read the cache config. If directory or config file do not exist, create. Take advantage of Py3 capability in os.makedirs() and in file open(): just try the operation and handle failure appropriately. Omit the check for old cache format, assume that's old enough there will be none of those left to worry about. :param path: path to the cache directory","startLine":157,"endLine":193,"calleeNames":["join","makedirs","SConsEnvironmentError","open","dump","load"]},"acm000003112jsd":{"type":"ControlElement","id":"acm000003112jsd","name":"CacheDebug","comment":"","startLine":195,"endLine":211,"calleeNames":["close","open","register","write","split"]},"acm000003113jsd":{"type":"ControlElement","id":"acm000003113jsd","name":"copy_from_cache","comment":"Copy a file from cache.","startLine":214,"endLine":219,"calleeNames":["copy","copy2"]},"acm000003114jsd":{"type":"ControlElement","id":"acm000003114jsd","name":"copy_to_cache","comment":"Copy a file to cache. Just use the FS copy2 (\"with metadata\") method, except do an additional check and if necessary a chmod to ensure the cachefile is writeable, to forestall permission problems if the cache entry is later updated.","startLine":222,"endLine":236,"calleeNames":["copy2","S_IMODE","stat","chmod"]},"acm000003115jsd":{"type":"ControlElement","id":"acm000003115jsd","name":"hit_ratio","comment":"","startLine":239,"endLine":240,"calleeNames":[]},"acm000003116jsd":{"type":"ControlElement","id":"acm000003116jsd","name":"misses","comment":"","startLine":243,"endLine":244,"calleeNames":[]},"acm000003117jsd":{"type":"ControlElement","id":"acm000003117jsd","name":"is_enabled","comment":"","startLine":246,"endLine":247,"calleeNames":[]},"acm000003118jsd":{"type":"ControlElement","id":"acm000003118jsd","name":"is_readonly","comment":"","startLine":249,"endLine":250,"calleeNames":[]},"acm000003119jsd":{"type":"ControlElement","id":"acm000003119jsd","name":"get_cachedir_csig","comment":"","startLine":252,"endLine":255,"calleeNames":["cachepath","exists","hash_file_signature"]},"acm000003120jsd":{"type":"ControlElement","id":"acm000003120jsd","name":"cachepath","comment":"Return where to cache a file. Given a Node, obtain the configured cache directory and the path to the cached file, which is generated from the node's build signature. If caching is not enabled for the None, return a tuple of None.","startLine":257,"endLine":271,"calleeNames":["is_enabled","get_cachedir_bsig","upper","join"]},"acm000003121jsd":{"type":"ControlElement","id":"acm000003121jsd","name":"retrieve","comment":"Retrieve a node from cache. Returns True if a successful retrieval resulted. This method is called from multiple threads in a parallel build, so only do thread safe stuff here. Do thread unsafe stuff in built(). Note that there's a special trick here with the execute flag (one that's not normally done for other actions). Basically if the user requested a no_exec (-n) build, then SCons.Action.execute_actions is set to 0 and when any action is called, it does its showing but then just returns zero instead of actually calling the action execution operation. The problem for caching is that if the file does NOT exist in cache then the CacheRetrieveString won't return anything to show for the task, but the Action.__call__ won't call CacheRetrieveFunc; instead it just returns zero, which makes the code below think that the file *was* successfully retrieved from the cache, therefore it doesn't do any subsequent building. However, the CacheRetrieveString didn't print anything because it didn't actually exist in the cache, and no more build actions will be performed, so the user just sees nothing. The fix is to tell Action.__call__ to always execute the CacheRetrieveFunc and then have the latter explicitly check SCons.Action.execute_actions itself.","startLine":273,"endLine":313,"calleeNames":["is_enabled","get_build_env","CacheRetrieveSilent","build","CacheRetrieve"]},"acm000003122jsd":{"type":"ControlElement","id":"acm000003122jsd","name":"push","comment":"","startLine":315,"endLine":318,"calleeNames":["is_readonly","is_enabled","CachePush","get_build_env"]},"acm000003123jsd":{"type":"ControlElement","id":"acm000003123jsd","name":"push_if_forced","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":320,"endLine":322,"calleeNames":["push"]},"acm000003124jsd":{"type":"ClassUnit","id":"acm000003124jsd","name":"CacheDir","comment":"","compilationUnitId":"acm000003128jsd","parentDatatypeId":null,"startLine":134,"endLine":322,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003110jsd","acm000003111jsd","acm000003112jsd","acm000003113jsd","acm000003114jsd","acm000003115jsd","acm000003116jsd","acm000003117jsd","acm000003118jsd","acm000003119jsd","acm000003120jsd","acm000003121jsd","acm000003122jsd","acm000003123jsd"]},"acm000003125jsd":{"type":"ControlElement","id":"acm000003125jsd","name":"CacheRetrieveFunc","comment":"","startLine":46,"endLine":68,"calleeNames":["get_CacheDir","cachepath","exists","CacheDebug","islink","symlink","readlink","get_internal_path","copy_from_cache","utime","stat","chmod","S_IMODE"]},"acm000003126jsd":{"type":"ControlElement","id":"acm000003126jsd","name":"CacheRetrieveString","comment":"","startLine":70,"endLine":77,"calleeNames":["get_CacheDir","cachepath","exists","get_internal_path"]},"acm000003127jsd":{"type":"ControlElement","id":"acm000003127jsd","name":"CachePushFunc","comment":"","startLine":83,"endLine":129,"calleeNames":["get_CacheDir","cachepath","exists","CacheDebug","makedirs","str","SConsEnvironmentError","islink","get_internal_path","symlink","readlink","copy_to_cache","rename","warn"]},"acm000003128jsd":{"type":"CodeCompilationUnit","id":"acm000003128jsd","name":"CacheDir","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nCacheDir support","parentId":"acm000004231jsd","content":["acm000003124jsd","acm000003125jsd","acm000003126jsd","acm000003127jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["atexit","json","os","stat","sys","uuid","SCons.Action","SCons.Errors","SCons.Warnings","SCons"]},"acm000003129jsd":{"type":"ControlElement","id":"acm000003129jsd","name":"__call__","comment":"","startLine":38,"endLine":42,"calleeNames":["get"]},"acm000003130jsd":{"type":"ControlElement","id":"acm000003130jsd","name":"genstring","comment":"","startLine":43,"endLine":44,"calleeNames":["str"]},"acm000003131jsd":{"type":"ControlElement","id":"acm000003131jsd","name":"get_contents","comment":"","startLine":45,"endLine":46,"calleeNames":["bytearray"]},"acm000003132jsd":{"type":"ClassUnit","id":"acm000003132jsd","name":"Action","comment":"","compilationUnitId":"acm000003160jsd","parentDatatypeId":null,"startLine":37,"endLine":46,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003129jsd","acm000003130jsd","acm000003131jsd"]},"acm000003133jsd":{"type":"ControlElement","id":"acm000003133jsd","name":"__init__","comment":"","startLine":49,"endLine":54,"calleeNames":[]},"acm000003134jsd":{"type":"ClassUnit","id":"acm000003134jsd","name":"Builder","comment":"","compilationUnitId":"acm000003160jsd","parentDatatypeId":null,"startLine":48,"endLine":54,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003133jsd"]},"acm000003135jsd":{"type":"ControlElement","id":"acm000003135jsd","name":"__init__","comment":"","startLine":49,"endLine":54,"calleeNames":[]},"acm000003136jsd":{"type":"ControlElement","id":"acm000003136jsd","name":"Override","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000003137jsd":{"type":"ControlElement","id":"acm000003137jsd","name":"get_CacheDir","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000003138jsd":{"type":"ClassUnit","id":"acm000003138jsd","name":"Environment","comment":"","compilationUnitId":"acm000003160jsd","parentDatatypeId":null,"startLine":56,"endLine":62,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003135jsd","acm000003136jsd","acm000003137jsd"]},"acm000003139jsd":{"type":"ControlElement","id":"acm000003139jsd","name":"setUp","comment":"","startLine":68,"endLine":74,"calleeNames":["TestCmd","FS","CacheDir"]},"acm000003140jsd":{"type":"ControlElement","id":"acm000003140jsd","name":"File","comment":"","startLine":76,"endLine":83,"calleeNames":["File","builder_set","Builder","Environment"]},"acm000003141jsd":{"type":"ControlElement","id":"acm000003141jsd","name":"tearDown","comment":"Should that be shutil.rmtree?","startLine":85,"endLine":87,"calleeNames":["remove","join","rmdir"]},"acm000003142jsd":{"type":"ClassUnit","id":"acm000003142jsd","name":"BaseTestCase","comment":"Base fixtures common to our other unittest classes.","compilationUnitId":"acm000003160jsd","parentDatatypeId":null,"startLine":64,"endLine":87,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003139jsd","acm000003140jsd","acm000003141jsd"]},"acm000003143jsd":{"type":"ControlElement","id":"acm000003143jsd","name":"test_cachepath","comment":"Test the cachepath() method\nVerify how the cachepath() method determines the name\nof the file in cache.","startLine":94,"endLine":113,"calleeNames":["File","cachepath","join","upper"]},"acm000003144jsd":{"type":"ClassUnit","id":"acm000003144jsd","name":"CacheDirTestCase","comment":"Test calling CacheDir code directly.","compilationUnitId":"acm000003160jsd","parentDatatypeId":null,"startLine":90,"endLine":113,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003143jsd"]},"acm000003145jsd":{"type":"ControlElement","id":"acm000003145jsd","name":"setUp","comment":"","startLine":68,"endLine":74,"calleeNames":["TestCmd","FS","CacheDir"]},"acm000003146jsd":{"type":"ControlElement","id":"acm000003146jsd","name":"tearDown","comment":"Should that be shutil.rmtree?","startLine":85,"endLine":87,"calleeNames":["remove","join","rmdir"]},"acm000003147jsd":{"type":"ControlElement","id":"acm000003147jsd","name":"test_throws_correct_on_OSError","comment":"Test that the correct error is thrown when cache directory cannot be created.","startLine":128,"endLine":140,"calleeNames":["join","mkdir","chmod","CacheDir","str","format","rmtree"]},"acm000003148jsd":{"type":"ControlElement","id":"acm000003148jsd","name":"test_throws_correct_when_failed_to_write_configfile","comment":"","startLine":143,"endLine":172,"calleeNames":["Unserializable","join","remove","_readconfig","str","format"]},"acm000003149jsd":{"type":"ControlElement","id":"acm000003149jsd","name":"test_raise_environment_error_on_invalid_json","comment":"","startLine":174,"endLine":188,"calleeNames":["join","open","read","write","CacheDir","str","format"]},"acm000003150jsd":{"type":"ClassUnit","id":"acm000003150jsd","name":"ExceptionTestCase","comment":"Test that the correct exceptions are thrown by CacheDir.\nDon't inherit from BaseTestCase, we're by definition trying to\nbreak things so we really want a clean slate for each test.","compilationUnitId":"acm000003160jsd","parentDatatypeId":null,"startLine":115,"endLine":188,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003145jsd","acm000003146jsd","acm000003147jsd","acm000003148jsd","acm000003149jsd"]},"acm000003151jsd":{"type":"ControlElement","id":"acm000003151jsd","name":"retrieve_succeed","comment":"","startLine":198,"endLine":200,"calleeNames":["append"]},"acm000003152jsd":{"type":"ControlElement","id":"acm000003152jsd","name":"retrieve_fail","comment":"","startLine":202,"endLine":204,"calleeNames":["append"]},"acm000003153jsd":{"type":"ControlElement","id":"acm000003153jsd","name":"push","comment":"","startLine":206,"endLine":208,"calleeNames":["append"]},"acm000003154jsd":{"type":"ControlElement","id":"acm000003154jsd","name":"test_CacheRetrieve","comment":"Test the CacheRetrieve() function","startLine":210,"endLine":236,"calleeNames":["File","retrieve_from_cache"]},"acm000003155jsd":{"type":"ControlElement","id":"acm000003155jsd","name":"test_CacheRetrieveSilent","comment":"Test the CacheRetrieveSilent() function","startLine":238,"endLine":265,"calleeNames":["File","retrieve_from_cache"]},"acm000003156jsd":{"type":"ControlElement","id":"acm000003156jsd","name":"test_CachePush","comment":"Test the CachePush() function","startLine":267,"endLine":300,"calleeNames":["workpath","File","push_to_cache","write","visited","clear"]},"acm000003157jsd":{"type":"ControlElement","id":"acm000003157jsd","name":"test_warning","comment":"Test raising a warning if we can't copy a file to cache.","startLine":302,"endLine":334,"calleeNames":["TestCmd","warningAsException","enableWarningClass","workpath","write","File","push_to_cache","suppressWarningClass"]},"acm000003158jsd":{"type":"ControlElement","id":"acm000003158jsd","name":"test_no_strfunction","comment":"Test handling no strfunction() for an action.","startLine":336,"endLine":361,"calleeNames":["File","retrieve_from_cache"]},"acm000003159jsd":{"type":"ClassUnit","id":"acm000003159jsd","name":"FileTestCase","comment":"Test calling CacheDir code through Node.FS.File interfaces.\nThese tests were originally in Nodes/FSTests.py and got moved\nwhen the CacheDir support was refactored into its own module.\nLook in the history for Node/FSTests.py if any of this needs\nto be re-examined.","compilationUnitId":"acm000003160jsd","parentDatatypeId":null,"startLine":190,"endLine":361,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003151jsd","acm000003152jsd","acm000003153jsd","acm000003154jsd","acm000003155jsd","acm000003156jsd","acm000003157jsd","acm000003158jsd"]},"acm000003160jsd":{"type":"CodeCompilationUnit","id":"acm000003160jsd","name":"CacheDirTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000004231jsd","content":["acm000003132jsd","acm000003134jsd","acm000003138jsd","acm000003142jsd","acm000003144jsd","acm000003150jsd","acm000003159jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["os.path","shutil","sys","unittest","tempfile","stat","TestCmd.TestCmd","SCons.CacheDir","SCons.Node.FS"]},"acm000003161jsd":{"type":"ControlElement","id":"acm000003161jsd","name":"CheckBuilder","comment":"Configure check to see if the compiler works. Note that this uses the current value of compiler and linker flags, make sure $CFLAGS, $CPPFLAGS and $LIBS are set correctly. \"language\" should be \"C\" or \"C++\" and is used to select the compiler. Default is \"C\". \"text\" may be used to specify the code to be build. Returns an empty string for success, an error message for failure.\nint main(void) { return 0; }","startLine":111,"endLine":136,"calleeNames":["_lang2suffix","Display","BuildProg","_YesNoResult"]},"acm000003162jsd":{"type":"ControlElement","id":"acm000003162jsd","name":"CheckCC","comment":"Configure check for a working C compiler. This checks whether the C compiler, as defined in the $CC construction variable, can compile a C source file. It uses the current $CCCOM value too, so that it can test against non working flags.","startLine":138,"endLine":156,"calleeNames":["Display","_check_empty_program","_YesNoResult"]},"acm000003163jsd":{"type":"ControlElement","id":"acm000003163jsd","name":"CheckSHCC","comment":"Configure check for a working shared C compiler. This checks whether the C compiler, as defined in the $SHCC construction variable, can compile a C source file. It uses the current $SHCCCOM value too, so that it can test against non working flags.","startLine":158,"endLine":176,"calleeNames":["Display","_check_empty_program","_YesNoResult"]},"acm000003164jsd":{"type":"ControlElement","id":"acm000003164jsd","name":"CheckCXX","comment":"Configure check for a working CXX compiler. This checks whether the CXX compiler, as defined in the $CXX construction variable, can compile a CXX source file. It uses the current $CXXCOM value too, so that it can test against non working flags.","startLine":178,"endLine":196,"calleeNames":["Display","_check_empty_program","_YesNoResult"]},"acm000003165jsd":{"type":"ControlElement","id":"acm000003165jsd","name":"CheckSHCXX","comment":"Configure check for a working shared CXX compiler. This checks whether the CXX compiler, as defined in the $SHCXX construction variable, can compile a CXX source file. It uses the current $SHCXXCOM value too, so that it can test against non working flags.","startLine":198,"endLine":216,"calleeNames":["Display","_check_empty_program","_YesNoResult"]},"acm000003166jsd":{"type":"ControlElement","id":"acm000003166jsd","name":"_check_empty_program","comment":"Return 0 on success, 1 otherwise.\nThe compiler construction variable is not set or empty","startLine":218,"endLine":231,"calleeNames":["_lang2suffix","CompileSharedObject","CompileProg"]},"acm000003167jsd":{"type":"ControlElement","id":"acm000003167jsd","name":"CheckFunc","comment":"Configure check for a function \"function_name\". \"language\" should be \"C\" or \"C++\" and is used to select the compiler. Default is \"C\". Optional \"header\" can be defined to define a function prototype, include a header file or anything else that comes before main(). Optional \"funcargs\" can be defined to define an argument list for the generated function invocation. Sets HAVE_function_name in context.havedict according to the result. Note that this uses the current value of compiler and linker flags, make sure $CFLAGS, $CPPFLAGS and $LIBS are set correctly. Returns an empty string for success, an error message for failure. .. versionchanged:: 4.7.0 The ``funcargs`` parameter was added.\nRemarks from autoconf:\n- Don't include <ctype.h> because on OSF/1 3.0 it includes <sys/types.h>\nwhich includes <sys/select.h> which contains a prototype for select.\nSimilarly for bzero.\n- assert.h is included to define __stub macros and hopefully few\nprototypes, which can conflict with char $1(); below.\n- Override any gcc2 internal prototype to avoid an error.\n- We use char for the function declaration because int might match the\nreturn type of a gcc2 builtin and then its argument prototype would\nstill apply.\n- The GNU C library defines this for functions which it implements to\nalways fail with ENOSYS. Some functions are actually named something\nstarting with __ and the normal name is an alias.\n#ifdef __cplusplus extern \"C\" #endif char %s(void);","startLine":234,"endLine":313,"calleeNames":["_lang2suffix","Display","BuildProg","_YesNoResult"]},"acm000003168jsd":{"type":"ControlElement","id":"acm000003168jsd","name":"CheckHeader","comment":"Configure check for a C or C++ header file \"header_name\". Optional \"header\" can be defined to do something before including the header file (unusual, supported for consistency). \"language\" should be \"C\" or \"C++\" and is used to select the compiler. Default is \"C\". Sets HAVE_header_name in context.havedict according to the result. Note that this uses the current value of compiler and linker flags, make sure $CFLAGS and $CPPFLAGS are set correctly. Returns an empty string for success, an error message for failure.\nWhy compile the program instead of just running the preprocessor?\nIt is possible that the header file exists, but actually using it may\nfail (e.g., because it depends on other header files). Thus this test is\nmore strict. It may require using the \"header\" argument.\n\nUse <> by default, because the check is normally used for system header\nfiles. SCons passes '\"\"' to overrule this.\nInclude \"confdefs.h\" first, so that the header can use HAVE_HEADER_H.","startLine":316,"endLine":361,"calleeNames":["_lang2suffix","Display","CompileProg","_YesNoResult"]},"acm000003169jsd":{"type":"ControlElement","id":"acm000003169jsd","name":"CheckType","comment":"Configure check for a C or C++ type \"type_name\". Optional \"header\" can be defined to include a header file. \"language\" should be \"C\" or \"C++\" and is used to select the compiler. Default is \"C\". Sets HAVE_type_name in context.havedict according to the result. Note that this uses the current value of compiler and linker flags, make sure $CFLAGS, $CPPFLAGS and $LIBS are set correctly. Returns an empty string for success, an error message for failure.\nInclude \"confdefs.h\" first, so that the header can use HAVE_HEADER_H.\nRemarks from autoconf about this test:\n- Grepping for the type in include files is not reliable (grep isn't\nportable anyway).\n- Using \"TYPE my_var;\" doesn't work for const qualified types in C++.\nAdding an initializer is not valid for some C++ classes.\n- Using the type as parameter to a function either fails for K&$ C or for\nC++.\n- Using \"TYPE *my_var;\" is valid in C for some types that are not\ndeclared (struct something).\n- Using \"sizeof(TYPE)\" is valid when TYPE is actually a variable.\n- Using the previous two together works reliably.","startLine":364,"endLine":424,"calleeNames":["_lang2suffix","Display","BuildProg","_YesNoResult","open","write","close"]},"acm000003170jsd":{"type":"ControlElement","id":"acm000003170jsd","name":"CheckTypeSize","comment":"This check can be used to get the size of a given type, or to check whether the type is of expected size. Arguments: - type : str the type to check - includes : sequence list of headers to include in the test code before testing the type - language : str 'C' or 'C++' - expect : int if given, will test wether the type has the given number of bytes. If not given, will automatically find the size. Returns: status : int 0 if the check failed, or the found size of the type if the check succeeded.\nInclude \"confdefs.h\" first, so that the header can use HAVE_HEADER_H.","startLine":426,"endLine":527,"calleeNames":["_lang2suffix","Display","CompileProg","_Have","_LogFailed","Message","RunProg","int"]},"acm000003171jsd":{"type":"ControlElement","id":"acm000003171jsd","name":"CheckDeclaration","comment":"Checks whether symbol is declared. Use the same test as autoconf, that is test whether the symbol is defined as a macro or can be used as an r-value. Arguments: symbol : str the symbol to check includes : str Optional \"header\" can be defined to include a header file. language : str only C and C++ supported. Returns: status : bool True if the check failed, False if succeeded.\nInclude \"confdefs.h\" first, so that the header can use HAVE_HEADER_H.","startLine":529,"endLine":578,"calleeNames":["_lang2suffix","Display","CompileProg","_YesNoResult"]},"acm000003172jsd":{"type":"ControlElement","id":"acm000003172jsd","name":"CheckMember","comment":"Configure check for a C or C++ member \"aggregate_member\". Optional \"header\" can be defined to include a header file. \"language\" should be \"C\" or \"C++\" and is used to select the compiler. Default is \"C\". Note that this uses the current value of compiler and linker flags, make sure $CFLAGS, $CPPFLAGS and $LIBS are set correctly. Arguments: aggregate_member : str the member to check. For example, 'struct tm.tm_gmtoff'. includes : str Optional \"header\" can be defined to include a header file. language : str only C and C++ supported. Returns the status (0 or False = Passed, True/non-zero = Failed).","startLine":581,"endLine":635,"calleeNames":["_lang2suffix","Display","split","len","BuildProg","_YesNoResult"]},"acm000003173jsd":{"type":"ControlElement","id":"acm000003173jsd","name":"CheckLib","comment":"Configure check for a C or C++ libraries \"libs\". Searches through the list of libraries, until one is found where the test succeeds. Tests if \"func_name\" or \"call\" exists in the library. Note: if it exists in another library the test succeeds anyway! Optional \"header\" can be defined to include a header file. If not given a default prototype for \"func_name\" is added. Optional \"extra_libs\" is a list of library names to be added after \"lib_name\" in the build command. To be used for libraries that \"lib_name\" depends on. Optional \"call\" replaces the call to \"func_name\" in the test code. It must consist of complete C statements, including a trailing \";\". Both \"func_name\" and \"call\" arguments are optional, and in that case, just linking against the libs is tested. \"language\" should be \"C\" or \"C++\" and is used to select the compiler. Default is \"C\". Note that this uses the current value of compiler and linker flags, make sure $CFLAGS, $CPPFLAGS and $LIBS are set correctly. Returns an empty string for success, an error message for failure.\nInclude \"confdefs.h\" first, so that the header can use HAVE_HEADER_H.","startLine":637,"endLine":742,"calleeNames":["find","_lang2suffix","Display","extend","AppendLIBS","PrependLIBS","BuildProg","_YesNoResult","SetLIBS"]},"acm000003174jsd":{"type":"ControlElement","id":"acm000003174jsd","name":"CheckProg","comment":"Configure check for a specific program. Check whether program prog_name exists in path. If it is found, returns the path for it, otherwise returns None.","startLine":744,"endLine":757,"calleeNames":["Display","WhereIs"]},"acm000003175jsd":{"type":"ControlElement","id":"acm000003175jsd","name":"_YesNoResult","comment":"","startLine":764,"endLine":780,"calleeNames":["_Have","Display","_LogFailed"]},"acm000003176jsd":{"type":"ControlElement","id":"acm000003176jsd","name":"_Have","comment":"","startLine":783,"endLine":823,"calleeNames":["upper","sub","isinstance","str","open","write","close","hasattr"]},"acm000003177jsd":{"type":"ControlElement","id":"acm000003177jsd","name":"_LogFailed","comment":"Write to the log about a failed program. Add line numbers, so that error messages can be understood.\nremove trailing empty line","startLine":826,"endLine":841,"calleeNames":["Log","split","len"]},"acm000003178jsd":{"type":"ControlElement","id":"acm000003178jsd","name":"_lang2suffix","comment":"Convert a language name to a suffix. When \"lang\" is empty or None C is assumed. Returns a tuple (lang, suffix, None) when it works. For an unrecognized language returns (None, None, msg). Where: - lang = the unified language name - suffix = the suffix, including the leading dot - msg = an error message\nvim: set sw=4 et sts=4 tw=79 fo+=l:\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":844,"endLine":861,"calleeNames":[]},"acm000003179jsd":{"type":"CodeCompilationUnit","id":"acm000003179jsd","name":"Conftest","comment":"MIT License\n\nCopyright The SCons Foundation\nCopyright (c) 2003 Stichting NLnet Labs\nCopyright (c) 2001, 2002, 2003 Steven Knight\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\nPUBLIC VARIABLES\n","parentId":"acm000004231jsd","content":["acm000003161jsd","acm000003162jsd","acm000003163jsd","acm000003164jsd","acm000003165jsd","acm000003166jsd","acm000003167jsd","acm000003168jsd","acm000003169jsd","acm000003170jsd","acm000003171jsd","acm000003172jsd","acm000003173jsd","acm000003174jsd","acm000003175jsd","acm000003176jsd","acm000003177jsd","acm000003178jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["re"]},"acm000003180jsd":{"type":"ControlElement","id":"acm000003180jsd","name":"__init__","comment":"Squirrels away the arguments and expansion value of a #define macro function for later evaluation when we must actually expand a value that uses it.","startLine":185,"endLine":197,"calleeNames":["split"]},"acm000003181jsd":{"type":"ControlElement","id":"acm000003181jsd","name":"__call__","comment":"Evaluates the expansion of a #define macro function called with the specified values.\nCreate a dictionary that maps the macro arguments to the\ncorresponding values in this \"call.\" We'll use this when we\neval() the expansion so that arguments will get expanded to\nthe right values.","startLine":199,"endLine":215,"calleeNames":["len","ValueError","zip","repr","join","eval","globals"]},"acm000003182jsd":{"type":"ClassUnit","id":"acm000003182jsd","name":"FunctionEvaluator","comment":"Handles delayed evaluation of a #define function call.","compilationUnitId":"acm000003220jsd","parentDatatypeId":null,"startLine":182,"endLine":215,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003180jsd","acm000003181jsd"]},"acm000003183jsd":{"type":"ControlElement","id":"acm000003183jsd","name":"__init__","comment":"Squirrels away the arguments and expansion value of a #define macro function for later evaluation when we must actually expand a value that uses it.","startLine":185,"endLine":197,"calleeNames":["split"]},"acm000003184jsd":{"type":"ControlElement","id":"acm000003184jsd","name":"__call__","comment":"Evaluates the expansion of a #define macro function called with the specified values.\nCreate a dictionary that maps the macro arguments to the\ncorresponding values in this \"call.\" We'll use this when we\neval() the expansion so that arguments will get expanded to\nthe right values.","startLine":199,"endLine":215,"calleeNames":["len","ValueError","zip","repr","join","eval","globals"]},"acm000003185jsd":{"type":"ControlElement","id":"acm000003185jsd","name":"process_file","comment":"Pre-processes a file. This is the main internal entry point.","startLine":284,"endLine":290,"calleeNames":["_process_tuples","tupleize","read_file"]},"acm000003186jsd":{"type":"ControlElement","id":"acm000003186jsd","name":"process_contents","comment":"Pre-processes a file contents. Is used by tests","startLine":292,"endLine":298,"calleeNames":["_process_tuples","tupleize"]},"acm000003187jsd":{"type":"ControlElement","id":"acm000003187jsd","name":"_process_tuples","comment":"","startLine":300,"endLine":313,"calleeNames":["copy","initialize_result","pop","finalize_result"]},"acm000003188jsd":{"type":"ControlElement","id":"acm000003188jsd","name":"tupleize","comment":"Turns the contents of a file into a list of easily-processed tuples describing the CPP lines in the file. The first element of each tuple is the line's preprocessor directive (#if, #include, #define, etc., minus the initial '#'). The remaining elements are specific to the type of directive, as pulled apart by the regular expression.","startLine":315,"endLine":325,"calleeNames":["_match_tuples","_parse_tuples"]},"acm000003189jsd":{"type":"ControlElement","id":"acm000003189jsd","name":"_parse_tuples","comment":"","startLine":327,"endLine":331,"calleeNames":["sub","findall","Cleanup_CPP_Expressions"]},"acm000003190jsd":{"type":"ControlElement","id":"acm000003190jsd","name":"_match_tuples","comment":"","startLine":333,"endLine":340,"calleeNames":["match","append","groups"]},"acm000003191jsd":{"type":"ControlElement","id":"acm000003191jsd","name":"save","comment":"Pushes the current dispatch table on the stack and re-initializes the current dispatch table to the default.","startLine":344,"endLine":350,"calleeNames":["append","copy"]},"acm000003192jsd":{"type":"ControlElement","id":"acm000003192jsd","name":"restore","comment":"Pops the previous dispatch table off the stack and makes it the current one.\nUtility methods.","startLine":352,"endLine":358,"calleeNames":["pop"]},"acm000003193jsd":{"type":"ControlElement","id":"acm000003193jsd","name":"do_nothing","comment":"Null method for when we explicitly want the action for a specific preprocessor directive to do nothing.","startLine":362,"endLine":367,"calleeNames":[]},"acm000003194jsd":{"type":"ControlElement","id":"acm000003194jsd","name":"scons_current_file","comment":"","startLine":369,"endLine":370,"calleeNames":[]},"acm000003195jsd":{"type":"ControlElement","id":"acm000003195jsd","name":"eval_expression","comment":"Evaluates a C preprocessor expression. This is done by converting it to a Python equivalent and eval()ing it in the C preprocessor namespace we use to track #define values.","startLine":372,"endLine":384,"calleeNames":["CPP_to_Python","join","eval"]},"acm000003196jsd":{"type":"ControlElement","id":"acm000003196jsd","name":"initialize_result","comment":"","startLine":386,"endLine":387,"calleeNames":[]},"acm000003197jsd":{"type":"ControlElement","id":"acm000003197jsd","name":"finalize_result","comment":"","startLine":389,"endLine":390,"calleeNames":[]},"acm000003198jsd":{"type":"ControlElement","id":"acm000003198jsd","name":"find_include_file","comment":"Finds the #include file for a given preprocessor tuple.","startLine":392,"endLine":404,"calleeNames":["join","isfile"]},"acm000003199jsd":{"type":"ControlElement","id":"acm000003199jsd","name":"read_file","comment":"Start and stop processing include lines.","startLine":406,"endLine":408,"calleeNames":["open","to_Text","read"]},"acm000003200jsd":{"type":"ControlElement","id":"acm000003200jsd","name":"start_handling_includes","comment":"Causes the PreProcessor object to start processing #import, #include and #include_next lines. This method will be called when a #if, #ifdef, #ifndef or #elif evaluates True, or when we reach the #else in a #if, #ifdef, #ifndef or #elif block where a condition already evaluated False.","startLine":412,"endLine":427,"calleeNames":[]},"acm000003201jsd":{"type":"ControlElement","id":"acm000003201jsd","name":"stop_handling_includes","comment":"Causes the PreProcessor object to stop processing #import, #include and #include_next lines. This method will be called when a #if, #ifdef, #ifndef or #elif evaluates False, or when we reach the #else in a #if, #ifdef, #ifndef or #elif block where a condition already evaluated True.","startLine":429,"endLine":443,"calleeNames":[]},"acm000003202jsd":{"type":"ControlElement","id":"acm000003202jsd","name":"_do_if_else_condition","comment":"Common logic for evaluating the conditions on #if, #ifdef and #ifndef lines.","startLine":449,"endLine":463,"calleeNames":["save","start_handling_includes","stop_handling_includes"]},"acm000003203jsd":{"type":"ControlElement","id":"acm000003203jsd","name":"do_ifdef","comment":"Default handling of a #ifdef line.","startLine":465,"endLine":469,"calleeNames":["_do_if_else_condition"]},"acm000003204jsd":{"type":"ControlElement","id":"acm000003204jsd","name":"do_ifndef","comment":"Default handling of a #ifndef line.","startLine":471,"endLine":475,"calleeNames":["_do_if_else_condition"]},"acm000003205jsd":{"type":"ControlElement","id":"acm000003205jsd","name":"do_if","comment":"Default handling of a #if line.","startLine":477,"endLine":481,"calleeNames":["_do_if_else_condition","eval_expression"]},"acm000003206jsd":{"type":"ControlElement","id":"acm000003206jsd","name":"do_elif","comment":"Default handling of a #elif line.","startLine":483,"endLine":491,"calleeNames":["eval_expression","start_handling_includes"]},"acm000003207jsd":{"type":"ControlElement","id":"acm000003207jsd","name":"do_else","comment":"Default handling of a #else line.","startLine":493,"endLine":497,"calleeNames":[]},"acm000003208jsd":{"type":"ControlElement","id":"acm000003208jsd","name":"do_endif","comment":"Default handling of a #endif line.","startLine":499,"endLine":503,"calleeNames":["restore"]},"acm000003209jsd":{"type":"ControlElement","id":"acm000003209jsd","name":"do_define","comment":"Default handling of a #define line.\nhandle \"defined\" chain \"! (defined (A) || defined (B)\" ...","startLine":505,"endLine":522,"calleeNames":["int","eval_expression","FunctionEvaluator"]},"acm000003210jsd":{"type":"ControlElement","id":"acm000003210jsd","name":"do_undef","comment":"Default handling of a #undef line.","startLine":524,"endLine":529,"calleeNames":[]},"acm000003211jsd":{"type":"ControlElement","id":"acm000003211jsd","name":"do_import","comment":"Default handling of a #import line.\nXXX finish this -- maybe borrow/share logic from do_include()...?","startLine":531,"endLine":536,"calleeNames":[]},"acm000003212jsd":{"type":"ControlElement","id":"acm000003212jsd","name":"do_include","comment":"Default handling of a #include line.","startLine":538,"endLine":564,"calleeNames":["resolve_include","find_include_file","append","tupleize","read_file"]},"acm000003213jsd":{"type":"ControlElement","id":"acm000003213jsd","name":"resolve_include","comment":"Resolve a tuple-ized #include line. This handles recursive expansion of values without \"\" or <> surrounding the name until an initial \" or < is found, to handle #include FILE where FILE is a #define somewhere else.","startLine":586,"endLine":618,"calleeNames":["strip","replace","search","group","callable","split","s"]},"acm000003214jsd":{"type":"ControlElement","id":"acm000003214jsd","name":"all_include","comment":"","startLine":620,"endLine":623,"calleeNames":["append","resolve_include"]},"acm000003215jsd":{"type":"ClassUnit","id":"acm000003215jsd","name":"PreProcessor","comment":"The main workhorse class for handling C pre-processing.","compilationUnitId":"acm000003220jsd","parentDatatypeId":null,"startLine":232,"endLine":623,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003183jsd","acm000003184jsd","acm000003185jsd","acm000003186jsd","acm000003187jsd","acm000003188jsd","acm000003189jsd","acm000003190jsd","acm000003191jsd","acm000003192jsd","acm000003193jsd","acm000003194jsd","acm000003195jsd","acm000003196jsd","acm000003197jsd","acm000003198jsd","acm000003199jsd","acm000003200jsd","acm000003201jsd","acm000003202jsd","acm000003203jsd","acm000003204jsd","acm000003205jsd","acm000003206jsd","acm000003207jsd","acm000003208jsd","acm000003209jsd","acm000003210jsd","acm000003211jsd","acm000003212jsd","acm000003213jsd","acm000003214jsd"]},"acm000003216jsd":{"type":"ControlElement","id":"acm000003216jsd","name":"__init__","comment":"Squirrels away the arguments and expansion value of a #define macro function for later evaluation when we must actually expand a value that uses it.","startLine":185,"endLine":197,"calleeNames":["split"]},"acm000003217jsd":{"type":"ClassUnit","id":"acm000003217jsd","name":"DumbPreProcessor","comment":"A preprocessor that ignores all #if/#elif/#else/#endif directives and just reports back *all* of the #include files (like the classic SCons scanner did). This is functionally equivalent to using a regular expression to find all of the #include lines, only slower. It exists mainly as an example of how the main PreProcessor class can be sub-classed to tailor its behavior.","compilationUnitId":"acm000003220jsd","parentDatatypeId":null,"startLine":626,"endLine":640,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003216jsd"]},"acm000003218jsd":{"type":"ControlElement","id":"acm000003218jsd","name":"Cleanup_CPP_Expressions","comment":"Second \"subsystem\" of regular expressions that we set up:\n\nStuff to translate a C preprocessor expression (as found on a #if or\n#elif line) into an equivalent Python expression that we can eval().\n\nA dictionary that maps the C representation of Boolean operators\nto their Python equivalents.","startLine":111,"endLine":112,"calleeNames":["sub"]},"acm000003219jsd":{"type":"ControlElement","id":"acm000003219jsd","name":"CPP_to_Python","comment":"Converts a C pre-processor expression into an equivalent Python expression that can be evaluated.","startLine":164,"endLine":172,"calleeNames":["sub"]},"acm000003220jsd":{"type":"CodeCompilationUnit","id":"acm000003220jsd","name":"cpp","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons C Pre-Processor module\nFirst \"subsystem\" of regular expressions that we set up:\n\nStuff to turn the C preprocessor directives in a file's contents into\na list of tuples that we can process easily.\n\nA table of regular expressions that fetch the arguments from the rest of\na C preprocessor line. Different directives have different arguments\nthat we want to fetch, using the regular expressions to which the lists\nof preprocessor directives map.","parentId":"acm000004231jsd","content":["acm000003182jsd","acm000003215jsd","acm000003217jsd","acm000003218jsd","acm000003219jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["os","re","SCons.Util"]},"acm000003221jsd":{"type":"ControlElement","id":"acm000003221jsd","name":"setUp","comment":"","startLine":444,"endLine":447,"calleeNames":["cpp_class"]},"acm000003222jsd":{"type":"ControlElement","id":"acm000003222jsd","name":"test_basic","comment":"Test basic #include scanning","startLine":449,"endLine":453,"calleeNames":["process_contents"]},"acm000003223jsd":{"type":"ControlElement","id":"acm000003223jsd","name":"test_substitution","comment":"Test substitution of #include files using CPP variables","startLine":455,"endLine":459,"calleeNames":["process_contents"]},"acm000003224jsd":{"type":"ControlElement","id":"acm000003224jsd","name":"test_ifdef","comment":"Test basic #ifdef processing","startLine":461,"endLine":465,"calleeNames":["process_contents"]},"acm000003225jsd":{"type":"ControlElement","id":"acm000003225jsd","name":"test_if_boolean","comment":"Test #if with Boolean values","startLine":467,"endLine":471,"calleeNames":["process_contents"]},"acm000003226jsd":{"type":"ControlElement","id":"acm000003226jsd","name":"test_if_defined","comment":"Test #if defined() idioms","startLine":473,"endLine":477,"calleeNames":["process_contents"]},"acm000003227jsd":{"type":"ControlElement","id":"acm000003227jsd","name":"test_expression","comment":"Test #if with arithmetic expressions","startLine":479,"endLine":483,"calleeNames":["process_contents"]},"acm000003228jsd":{"type":"ControlElement","id":"acm000003228jsd","name":"test_undef","comment":"Test #undef handling","startLine":485,"endLine":489,"calleeNames":["process_contents"]},"acm000003229jsd":{"type":"ControlElement","id":"acm000003229jsd","name":"test_macro_function","comment":"Test using macro functions to express file names","startLine":491,"endLine":495,"calleeNames":["process_contents"]},"acm000003230jsd":{"type":"ControlElement","id":"acm000003230jsd","name":"test_token_pasting","comment":"Test token-pasting to construct file names","startLine":497,"endLine":501,"calleeNames":["process_contents"]},"acm000003231jsd":{"type":"ControlElement","id":"acm000003231jsd","name":"test_no_space","comment":"Test no space between #include and the quote","startLine":503,"endLine":507,"calleeNames":["process_contents"]},"acm000003232jsd":{"type":"ControlElement","id":"acm000003232jsd","name":"test_nested_ifs","comment":"","startLine":509,"endLine":512,"calleeNames":["process_contents"]},"acm000003233jsd":{"type":"ControlElement","id":"acm000003233jsd","name":"test_ifndef","comment":"Test basic #ifndef processing","startLine":514,"endLine":518,"calleeNames":["process_contents"]},"acm000003234jsd":{"type":"ControlElement","id":"acm000003234jsd","name":"test_if_defined_no_space","comment":"Test #if(defined, i.e.without space but parenthesis","startLine":520,"endLine":524,"calleeNames":["process_contents"]},"acm000003235jsd":{"type":"ControlElement","id":"acm000003235jsd","name":"test_if_no_space","comment":"Test #if(, i.e. without space but parenthesis","startLine":526,"endLine":530,"calleeNames":["process_contents"]},"acm000003236jsd":{"type":"ClassUnit","id":"acm000003236jsd","name":"cppTestCase","comment":"","compilationUnitId":"acm000003249jsd","parentDatatypeId":null,"startLine":443,"endLine":530,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003221jsd","acm000003222jsd","acm000003223jsd","acm000003224jsd","acm000003225jsd","acm000003226jsd","acm000003227jsd","acm000003228jsd","acm000003229jsd","acm000003230jsd","acm000003231jsd","acm000003232jsd","acm000003233jsd","acm000003234jsd","acm000003235jsd"]},"acm000003237jsd":{"type":"ControlElement","id":"acm000003237jsd","name":"setUp","comment":"","startLine":444,"endLine":447,"calleeNames":["cpp_class"]},"acm000003238jsd":{"type":"ClassUnit","id":"acm000003238jsd","name":"cppAllTestCase","comment":"","compilationUnitId":"acm000003249jsd","parentDatatypeId":null,"startLine":533,"endLine":538,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003237jsd"]},"acm000003239jsd":{"type":"ClassUnit","id":"acm000003239jsd","name":"PreProcessorTestCase","comment":"","compilationUnitId":"acm000003249jsd","parentDatatypeId":null,"startLine":540,"endLine":640,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003240jsd":{"type":"ClassUnit","id":"acm000003240jsd","name":"DumbPreProcessorTestCase","comment":"","compilationUnitId":"acm000003249jsd","parentDatatypeId":null,"startLine":642,"endLine":786,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003241jsd":{"type":"ControlElement","id":"acm000003241jsd","name":"setUp","comment":"","startLine":444,"endLine":447,"calleeNames":["cpp_class"]},"acm000003242jsd":{"type":"ControlElement","id":"acm000003242jsd","name":"tearDown","comment":"","startLine":817,"endLine":820,"calleeNames":["chdir","rmtree","remove"]},"acm000003243jsd":{"type":"ControlElement","id":"acm000003243jsd","name":"strip_initial_spaces","comment":"","startLine":822,"endLine":829,"calleeNames":["split","match","group","len","join","map"]},"acm000003244jsd":{"type":"ControlElement","id":"acm000003244jsd","name":"write","comment":"","startLine":831,"endLine":833,"calleeNames":["open","write","strip_initial_spaces"]},"acm000003245jsd":{"type":"ControlElement","id":"acm000003245jsd","name":"test_basic","comment":"Test basic #include scanning","startLine":449,"endLine":453,"calleeNames":["process_contents"]},"acm000003246jsd":{"type":"ControlElement","id":"acm000003246jsd","name":"test_current_file","comment":"Test use of the .current_file attribute\n\\ #include <f2.h>\n\\ #include \"f3.h\"\n\\","startLine":850,"endLine":874,"calleeNames":["write","super","__init__","append","__call__","scons_current_file","MyPreProcessor","p"]},"acm000003247jsd":{"type":"ClassUnit","id":"acm000003247jsd","name":"fileTestCase","comment":"","compilationUnitId":"acm000003249jsd","parentDatatypeId":null,"startLine":807,"endLine":874,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003241jsd","acm000003242jsd","acm000003243jsd","acm000003244jsd","acm000003245jsd","acm000003246jsd"]},"acm000003248jsd":{"type":"ControlElement","id":"acm000003248jsd","name":"_clean","comment":"","startLine":795,"endLine":798,"calleeNames":["exists","rmtree"]},"acm000003249jsd":{"type":"CodeCompilationUnit","id":"acm000003249jsd","name":"cppTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000004231jsd","content":["acm000003236jsd","acm000003238jsd","acm000003239jsd","acm000003240jsd","acm000003247jsd","acm000003248jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["atexit","unittest","TestUnit","SCons.cpp","os","re","shutil","tempfile"]},"acm000003250jsd":{"type":"ControlElement","id":"acm000003250jsd","name":"__init__","comment":"There's already a suffix on the file name, don't add one.","startLine":104,"endLine":168,"calleeNames":["splitext","geteuid","getegid","stat","int","get","open","read","len","loads","corruption_warning"]},"acm000003251jsd":{"type":"ControlElement","id":"acm000003251jsd","name":"opener","comment":"Database open helper when creation may be needed. The high-level Python open() function cannot specify a file mode for creation. Using this as the opener with the saved mode lets us do that.","startLine":170,"endLine":177,"calleeNames":["open"]},"acm000003252jsd":{"type":"ControlElement","id":"acm000003252jsd","name":"close","comment":"","startLine":179,"endLine":181,"calleeNames":["sync"]},"acm000003253jsd":{"type":"ControlElement","id":"acm000003253jsd","name":"__del__","comment":"","startLine":183,"endLine":184,"calleeNames":["close"]},"acm000003254jsd":{"type":"ControlElement","id":"acm000003254jsd","name":"sync","comment":"Flush the database to disk. This routine *must* succeed, since the in-memory and on-disk copies are out of sync as soon as we do anything that changes the in-memory version. Thus, to be cautious, flush to a temporary file and then move it over with some error handling.\nIf we couldn't replace due to perms, try to change and retry.\nThis is mainly for Windows - on POSIX the file permissions\ndon't matter, the os.replace would have worked anyway.\nWe're giving up if the retry fails, just let the Python\nexception abort us.\ndon't chown to root or -1","startLine":186,"endLine":224,"calleeNames":["_check_writable","_open","_pickle_dump","_os_replace","_os_chmod","_os_chown","_shutil_copyfile"]},"acm000003255jsd":{"type":"ControlElement","id":"acm000003255jsd","name":"_check_writable","comment":"","startLine":226,"endLine":228,"calleeNames":["OSError"]},"acm000003256jsd":{"type":"ControlElement","id":"acm000003256jsd","name":"__getitem__","comment":"","startLine":230,"endLine":231,"calleeNames":[]},"acm000003257jsd":{"type":"ControlElement","id":"acm000003257jsd","name":"__setitem__","comment":"","startLine":233,"endLine":243,"calleeNames":["_check_writable","isinstance","TypeError"]},"acm000003258jsd":{"type":"ControlElement","id":"acm000003258jsd","name":"__delitem__","comment":"","startLine":245,"endLine":246,"calleeNames":[]},"acm000003259jsd":{"type":"ControlElement","id":"acm000003259jsd","name":"keys","comment":"","startLine":248,"endLine":249,"calleeNames":["keys"]},"acm000003260jsd":{"type":"ControlElement","id":"acm000003260jsd","name":"items","comment":"","startLine":251,"endLine":252,"calleeNames":["items"]},"acm000003261jsd":{"type":"ControlElement","id":"acm000003261jsd","name":"values","comment":"","startLine":254,"endLine":255,"calleeNames":["values"]},"acm000003262jsd":{"type":"ControlElement","id":"acm000003262jsd","name":"__contains__","comment":"","startLine":259,"endLine":260,"calleeNames":[]},"acm000003263jsd":{"type":"ControlElement","id":"acm000003263jsd","name":"__len__","comment":"","startLine":262,"endLine":263,"calleeNames":["len"]},"acm000003264jsd":{"type":"ClassUnit","id":"acm000003264jsd","name":"_Dblite","comment":"Lightweight signature database class. Behaves like a dict when in memory, loads from a pickled disk file on open and writes back out to it on close. Open the database file using a path derived from *file_base_name*. The optional *flag* argument can be: +---------+---------------------------------------------------+ | Value | Meaning | +=========+===================================================+ | ``'r'`` | Open existing database for reading only (default) | +---------+---------------------------------------------------+ | ``'w'`` | Open existing database for reading and writing | +---------+---------------------------------------------------+ | ``'c'`` | Open database for reading and writing, creating | | | it if it doesn't exist | +---------+---------------------------------------------------+ | ``'n'`` | Always create a new, empty database, open for | | | reading and writing | +---------+---------------------------------------------------+ The optional *mode* argument is the POSIX mode of the file, used only when the database has to be created. It defaults to octal ``0o666``.\nBecause open() is defined at module level, overwriting builtin open\nin the scope of this module, we use io.open to avoid ambiguity.","compilationUnitId":"acm000003268jsd","parentDatatypeId":null,"startLine":58,"endLine":263,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003250jsd","acm000003251jsd","acm000003252jsd","acm000003253jsd","acm000003254jsd","acm000003255jsd","acm000003256jsd","acm000003257jsd","acm000003258jsd","acm000003259jsd","acm000003260jsd","acm000003261jsd","acm000003262jsd","acm000003263jsd"]},"acm000003265jsd":{"type":"ControlElement","id":"acm000003265jsd","name":"corruption_warning","comment":"Local warning for corrupt db. Used for self-tests. SCons overwrites this with a different warning function in SConsign.py.","startLine":45,"endLine":51,"calleeNames":["print"]},"acm000003266jsd":{"type":"ControlElement","id":"acm000003266jsd","name":"open","comment":"pylint: disable=redefined-builtin","startLine":266,"endLine":267,"calleeNames":["_Dblite"]},"acm000003267jsd":{"type":"ControlElement","id":"acm000003267jsd","name":"_exercise","comment":"","startLine":270,"endLine":341,"calleeNames":["open","len","sync","str","RuntimeError","_open","write","unlink","print"]},"acm000003268jsd":{"type":"CodeCompilationUnit","id":"acm000003268jsd","name":"dblite","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\ndblite.py module contributed by Ralf W. Grosse-Kunstleve. Extended for Unicode by Steven Knight. This is a very simple-minded \"database\" used for saved signature information, with an interface modeled on the Python dbm database interface module.","parentId":"acm000004231jsd","content":["acm000003264jsd","acm000003265jsd","acm000003266jsd","acm000003267jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["io","os","pickle","shutil","time","SCons.compat.PICKLE_PROTOCOL"]},"acm000003269jsd":{"type":"ControlElement","id":"acm000003269jsd","name":"logInstanceCreation","comment":"weakref doesn't seem to work when the instance\ncontains only slots...","startLine":48,"endLine":58,"calleeNames":["hasattr","append","ref"]},"acm000003270jsd":{"type":"ControlElement","id":"acm000003270jsd","name":"string_to_classes","comment":"","startLine":60,"endLine":64,"calleeNames":["sorted","keys","split"]},"acm000003271jsd":{"type":"ControlElement","id":"acm000003271jsd","name":"fetchLoggedInstances","comment":"","startLine":66,"endLine":68,"calleeNames":["string_to_classes","len"]},"acm000003272jsd":{"type":"ControlElement","id":"acm000003272jsd","name":"countLoggedInstances","comment":"","startLine":70,"endLine":72,"calleeNames":["string_to_classes","write","len"]},"acm000003273jsd":{"type":"ControlElement","id":"acm000003273jsd","name":"listLoggedInstances","comment":"","startLine":74,"endLine":83,"calleeNames":["string_to_classes","write","isclass","ref","repr"]},"acm000003274jsd":{"type":"ControlElement","id":"acm000003274jsd","name":"dumpLoggedInstances","comment":"Linux doesn't actually support memory usage stats from getrusage().\nTODO really get memory stats for OS X","startLine":85,"endLine":93,"calleeNames":["string_to_classes","write","ref","items"]},"acm000003275jsd":{"type":"ControlElement","id":"acm000003275jsd","name":"caller_stack","comment":"return caller's stack","startLine":122,"endLine":133,"calleeNames":["extract_stack","append","func_shorten"]},"acm000003276jsd":{"type":"ControlElement","id":"acm000003276jsd","name":"caller_trace","comment":"Trace caller stack and save info into global dicts, which are printed automatically at the end of SCons execution.","startLine":138,"endLine":156,"calleeNames":["extract_stack","reverse","get"]},"acm000003277jsd":{"type":"ControlElement","id":"acm000003277jsd","name":"_dump_one_caller","comment":"","startLine":159,"endLine":164,"calleeNames":["sorted","items","write","func_shorten","_dump_one_caller"]},"acm000003278jsd":{"type":"ControlElement","id":"acm000003278jsd","name":"dump_caller_counts","comment":"","startLine":167,"endLine":171,"calleeNames":["sorted","keys","write","func_shorten","_dump_one_caller"]},"acm000003279jsd":{"type":"ControlElement","id":"acm000003279jsd","name":"func_shorten","comment":"","startLine":182,"endLine":190,"calleeNames":["find","len"]},"acm000003280jsd":{"type":"ControlElement","id":"acm000003280jsd","name":"Trace","comment":"Write a trace message. Write messages when debugging which do not interfere with stdout. Useful in tests, which monitor stdout and would break with unexpected output. Trace messages can go to the console (which is opened as a file), or to a disk file; the tracefile argument persists across calls unless overridden. Args: tracefile: file to write trace message to. If omitted, write to the previous trace file (default: console). mode: file open mode (default: 'w') tstamp: write relative timestamps with trace. Outputs time since scons was started, and time since last trace (default: False)","startLine":202,"endLine":248,"calleeNames":["close","open","register","perf_counter","write","flush"]},"acm000003281jsd":{"type":"CodeCompilationUnit","id":"acm000003281jsd","name":"Debug","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nCode for debugging SCons internal things. Shouldn't be needed by most users. Quick shortcuts: from SCons.Debug import caller_trace caller_trace()\nGlobal variable that gets set to 'True' by the Main script,\nwhen the creation of class instances should get tracked.","parentId":"acm000004231jsd","content":["acm000003269jsd","acm000003270jsd","acm000003271jsd","acm000003272jsd","acm000003273jsd","acm000003274jsd","acm000003275jsd","acm000003276jsd","acm000003277jsd","acm000003278jsd","acm000003279jsd","acm000003280jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["atexit","os","sys","time","weakref","inspect","traceback"]},"acm000003282jsd":{"type":"ControlElement","id":"acm000003282jsd","name":"__init__","comment":"","startLine":631,"endLine":632,"calleeNames":[]},"acm000003283jsd":{"type":"ControlElement","id":"acm000003283jsd","name":"__call__","comment":"","startLine":634,"endLine":635,"calleeNames":[]},"acm000003284jsd":{"type":"ClassUnit","id":"acm000003284jsd","name":"NullCmdGenerator","comment":"Callable class for use as a no-effect command generator. The ``__call__`` method for this class simply returns the thing you instantiated it with. Example usage:: env[\"DO_NOTHING\"] = NullCmdGenerator env[\"LINKCOM\"] = \"${DO_NOTHING('$LINK $SOURCES $TARGET')}\"","compilationUnitId":"acm000003310jsd","parentDatatypeId":null,"startLine":621,"endLine":635,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003282jsd","acm000003283jsd"]},"acm000003285jsd":{"type":"ControlElement","id":"acm000003285jsd","name":"__init__","comment":"","startLine":631,"endLine":632,"calleeNames":[]},"acm000003286jsd":{"type":"ControlElement","id":"acm000003286jsd","name":"__call__","comment":"","startLine":634,"endLine":635,"calleeNames":[]},"acm000003287jsd":{"type":"ClassUnit","id":"acm000003287jsd","name":"Variable_Method_Caller","comment":"A class for finding a construction variable on the stack and calling one of its methods. Used to support \"construction variables\" appearing in string ``eval``s that actually stand in for methods--specifically, the use of \"RDirs\" in a call to :func:`_concat` that should actually execute the ``TARGET.RDirs`` method. Historical note: This was formerly supported by creating a little \"build dictionary\" that mapped RDirs to the method, but this got in the way of Memoizing construction environments, because we had to create new environment objects to hold the variables.","compilationUnitId":"acm000003310jsd","parentDatatypeId":null,"startLine":638,"endLine":672,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003285jsd","acm000003286jsd"]},"acm000003288jsd":{"type":"ControlElement","id":"acm000003288jsd","name":"_fetch_DefaultEnvironment","comment":"Returns the already-created default construction environment.","startLine":61,"endLine":63,"calleeNames":[]},"acm000003289jsd":{"type":"ControlElement","id":"acm000003289jsd","name":"DefaultEnvironment","comment":"Construct the global (\"default\") construction environment. The environment is provisioned with the values from *kwargs*. After the environment is created, this function is replaced with a reference to :func:`_fetch_DefaultEnvironment` which efficiently returns the initialized default construction environment without checking for its existence. Historically, some parts of the code held references to this function. Thus it still has the existence check for :data:`_default_env` rather than just blindly creating the environment and overwriting itself.\nEmitters for setting the shared attribute on object files,\nand an action for checking that all of the source files\ngoing into a shared library are, in fact, shared.","startLine":66,"endLine":87,"calleeNames":["Environment","Decider"]},"acm000003290jsd":{"type":"ControlElement","id":"acm000003290jsd","name":"StaticObjectEmitter","comment":"","startLine":93,"endLine":96,"calleeNames":[]},"acm000003291jsd":{"type":"ControlElement","id":"acm000003291jsd","name":"SharedObjectEmitter","comment":"","startLine":99,"endLine":102,"calleeNames":[]},"acm000003292jsd":{"type":"ControlElement","id":"acm000003292jsd","name":"SharedFlagChecker","comment":"","startLine":105,"endLine":115,"calleeNames":["subst","UserError"]},"acm000003293jsd":{"type":"ControlElement","id":"acm000003293jsd","name":"get_paths_str","comment":"Generates a string from *dest* for use in a strfunction. If *dest* is a list, manually converts each elem to a string.","startLine":159,"endLine":171,"calleeNames":["is_List","quote"]},"acm000003294jsd":{"type":"ControlElement","id":"acm000003294jsd","name":"chmod_func","comment":"Implementation of the Chmod action function. *mode* can be either an integer (normally expressed in octal mode, as in 0o755) or a string following the syntax of the POSIX chmod command (for example \"ugo+w\"). The latter must be converted, since the underlying Python only takes the numeric form.","startLine":193,"endLine":240,"calleeNames":["invalidate_node_memos","is_List","is_String","int","chmod","str","split","SyntaxError","len","strip","replace","stat"]},"acm000003295jsd":{"type":"ControlElement","id":"acm000003295jsd","name":"chmod_strfunc","comment":"strfunction for the Chmod action function.","startLine":243,"endLine":248,"calleeNames":["is_String"]},"acm000003296jsd":{"type":"ControlElement","id":"acm000003296jsd","name":"copy_func","comment":"Implementation of the Copy action function. Copies *src* to *dest*. If *src* is a list, *dest* must be a directory, or not exist (will be created). Since Python :mod:`shutil` methods, which know nothing about SCons Nodes, will be called to perform the actual copying, args are converted to strings first. If *symlinks* evaluates true, then a symbolic link will be shallow copied and recreated as a symbolic link; otherwise, copying a symbolic link will be equivalent to copying the symbolic link's final target regardless of symbolic link depth.","startLine":256,"endLine":305,"calleeNames":["str","is_List","invalidate_node_memos","makedirs","BuildError","copy2","islink","symlink","readlink","copy_func","realpath","isfile","copytree"]},"acm000003297jsd":{"type":"ControlElement","id":"acm000003297jsd","name":"copy_strfunc","comment":"strfunction for the Copy action function.","startLine":308,"endLine":310,"calleeNames":[]},"acm000003298jsd":{"type":"ControlElement","id":"acm000003298jsd","name":"delete_func","comment":"Implementation of the Delete action function. Lets the Python :func:`os.unlink` raise an error if *dest* does not exist, unless *must_exist* evaluates false (the default).\nos.path.exists returns False with broken links that exist\nos.path.isdir returns True when entry is a link to a dir","startLine":316,"endLine":335,"calleeNames":["invalidate_node_memos","is_List","str","exists","islink","isdir","rmtree","unlink"]},"acm000003299jsd":{"type":"ControlElement","id":"acm000003299jsd","name":"delete_strfunc","comment":"strfunction for the Delete action function.","startLine":338,"endLine":340,"calleeNames":[]},"acm000003300jsd":{"type":"ControlElement","id":"acm000003300jsd","name":"mkdir_func","comment":"Implementation of the Mkdir action function.","startLine":346,"endLine":352,"calleeNames":["invalidate_node_memos","is_List","makedirs","str"]},"acm000003301jsd":{"type":"ControlElement","id":"acm000003301jsd","name":"move_func","comment":"Implementation of the Move action function.","startLine":358,"endLine":362,"calleeNames":["invalidate_node_memos","move"]},"acm000003302jsd":{"type":"ControlElement","id":"acm000003302jsd","name":"touch_func","comment":"Implementation of the Touch action function.","startLine":370,"endLine":383,"calleeNames":["invalidate_node_memos","is_List","str","int","time","exists","getatime","open","utime"]},"acm000003303jsd":{"type":"ControlElement","id":"acm000003303jsd","name":"_concat","comment":"Creates a new list from 'items_iter' by first interpolating each element in the list using the 'env' dictionary and then calling f on the list, and finally calling _concat_ixes to concatenate 'prefix' and 'suffix' onto each element of the list.","startLine":392,"endLine":416,"calleeNames":["f","PathList","subst_path","_concat_ixes"]},"acm000003304jsd":{"type":"ControlElement","id":"acm000003304jsd","name":"_concat_ixes","comment":"Creates a new list from 'items_iter' by concatenating the 'prefix' and 'suffix' arguments onto each element of the list. A trailing space on 'prefix' or leading space on 'suffix' will cause them to be put into separate list elements rather than being concatenated.","startLine":420,"endLine":455,"calleeNames":["str","subst","flatten","isinstance","append","len"]},"acm000003305jsd":{"type":"ControlElement","id":"acm000003305jsd","name":"_stripixes","comment":"Returns a list with text added to items after first stripping them. A companion to :func:`_concat_ixes`, used by tools (like the GNU linker) that need to turn something like ``libfoo.a`` into ``-lfoo``. *stripprefixes* and *stripsuffixes* are stripped from *items*. Calls function *c* to postprocess the result. Args: prefix: string to prepend to elements items: string or iterable to transform suffix: string to append to elements stripprefixes: prefix string(s) to strip from elements stripsuffixes: suffix string(s) to strip from elements env: construction environment for variable interpolation c: optional function to perform a transformation on the list. The default is `None`, which will select :func:`_concat_ixes`.\nThere's a custom _concat() method in the construction\nenvironment, and we've allowed people to set that in\nthe past (see test/custom-concat.py), so preserve the\nbackwards compatibility.","startLine":458,"endLine":539,"calleeNames":["callable","list","map","flatten","PathList","subst_path","isinstance","append","is_String","str","startswith","len","c"]},"acm000003306jsd":{"type":"ControlElement","id":"acm000003306jsd","name":"processDefines","comment":"Return list of strings for preprocessor defines from *defs*. Resolves the different forms ``CPPDEFINES`` can be assembled in: if the Append/Prepend routines are used beyond a initial setting it will be a deque, but if written to only once (Environment initializer, or direct write) it can be a multitude of types. Any prefix/suffix is handled elsewhere (usually :func:`_concat_ixes`). .. versionchanged:: 4.5.0 Bare tuples are now treated the same as tuple-in-sequence, assumed to describe a valued macro. Bare strings are now split on space. A dictionary is no longer sorted before handling.","startLine":542,"endLine":611,"calleeNames":["is_List","is_Sequence","len","UserError","append","str","is_Dict","items","is_String","is_Tuple","split"]},"acm000003307jsd":{"type":"ControlElement","id":"acm000003307jsd","name":"_defines","comment":"A wrapper around :func:`_concat_ixes` that turns a list or string into a list of C preprocessor command-line definitions.","startLine":614,"endLine":618,"calleeNames":["c","subst_list","processDefines"]},"acm000003308jsd":{"type":"ControlElement","id":"acm000003308jsd","name":"__libversionflags","comment":"if version_var is not empty, returns env[flags_var], otherwise returns None :param env: :param version_var: :param flags_var: :return:","startLine":675,"endLine":688,"calleeNames":["subst"]},"acm000003309jsd":{"type":"ControlElement","id":"acm000003309jsd","name":"__lib_either_version_flag","comment":"if $version_var1 or $version_var2 is not empty, returns env[flags_var], otherwise returns None :param env: :param version_var1: :param version_var2: :param flags_var: :return:","startLine":691,"endLine":705,"calleeNames":["subst"]},"acm000003310jsd":{"type":"CodeCompilationUnit","id":"acm000003310jsd","name":"Defaults","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\nBuilders and other things for the local site. Here's where we'll duplicate the functionality of autoconf until we move it into the installation procedure or use something like qmconf. The code that reads the registry to find MSVC components was borrowed from distutils.msvccompiler.\nA placeholder for a default Environment (for fetching source files\nfrom source code management systems and the like). This must be\ninitialized later, after the top-level directory is set by the calling\ninterface.","parentId":"acm000004231jsd","content":["acm000003284jsd","acm000003287jsd","acm000003288jsd","acm000003289jsd","acm000003290jsd","acm000003291jsd","acm000003292jsd","acm000003293jsd","acm000003294jsd","acm000003295jsd","acm000003296jsd","acm000003297jsd","acm000003298jsd","acm000003299jsd","acm000003300jsd","acm000003301jsd","acm000003302jsd","acm000003303jsd","acm000003304jsd","acm000003305jsd","acm000003306jsd","acm000003307jsd","acm000003308jsd","acm000003309jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["os","shutil","stat","sys","time","typing.List","typing.Callable","SCons.Action","SCons.Builder","SCons.CacheDir","SCons.Environment","SCons.Errors","SCons.PathList","SCons.Scanner.Dir","SCons.Subst","SCons.Tool","SCons.Util.is_List","SCons.Util.is_String","SCons.Util.is_Sequence","SCons.Util.is_Tuple","SCons.Util.is_Dict","SCons.Util.flatten","string.digits"]},"acm000003311jsd":{"type":"ControlElement","id":"acm000003311jsd","name":"__init__","comment":"","startLine":35,"endLine":37,"calleeNames":["super","__init__","update"]},"acm000003312jsd":{"type":"ControlElement","id":"acm000003312jsd","name":"subst","comment":"","startLine":39,"endLine":42,"calleeNames":[]},"acm000003313jsd":{"type":"ControlElement","id":"acm000003313jsd","name":"subst_list","comment":"","startLine":44,"endLine":47,"calleeNames":[]},"acm000003314jsd":{"type":"ClassUnit","id":"acm000003314jsd","name":"DummyEnvironment","comment":"","compilationUnitId":"acm000003321jsd","parentDatatypeId":null,"startLine":34,"endLine":47,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003311jsd","acm000003312jsd","acm000003313jsd"]},"acm000003315jsd":{"type":"ControlElement","id":"acm000003315jsd","name":"test_mkdir_func0","comment":"","startLine":51,"endLine":57,"calleeNames":["TestCmd","subdir","workpath","mkdir_func"]},"acm000003316jsd":{"type":"ControlElement","id":"acm000003316jsd","name":"test_mkdir_func1","comment":"","startLine":59,"endLine":67,"calleeNames":["TestCmd","subdir","workpath","makedirs","mkdir_func"]},"acm000003317jsd":{"type":"ControlElement","id":"acm000003317jsd","name":"test_mkdir_func2","comment":"","startLine":69,"endLine":85,"calleeNames":["TestCmd","subdir","workpath","makedirs","write","mkdir_func","fail"]},"acm000003318jsd":{"type":"ControlElement","id":"acm000003318jsd","name":"test__defines_no_target_or_source_arg","comment":"Verify that _defines() function can handle either or neither source or target being specified","startLine":87,"endLine":107,"calleeNames":["DummyEnvironment","subTest","_defines","assertEqual"]},"acm000003319jsd":{"type":"ControlElement","id":"acm000003319jsd","name":"test_processDefines","comment":"Verify correct handling in processDefines.","startLine":109,"endLine":153,"calleeNames":["DummyEnvironment","subTest","processDefines","assertEqual","assertRaises"]},"acm000003320jsd":{"type":"ClassUnit","id":"acm000003320jsd","name":"DefaultsTestCase","comment":"","compilationUnitId":"acm000003321jsd","parentDatatypeId":null,"startLine":50,"endLine":153,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003315jsd","acm000003316jsd","acm000003317jsd","acm000003318jsd","acm000003319jsd"]},"acm000003321jsd":{"type":"CodeCompilationUnit","id":"acm000003321jsd","name":"DefaultsTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000004231jsd","content":["acm000003314jsd","acm000003320jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["os","unittest","collections","TestCmd","SCons.Defaults.mkdir_func","SCons.Defaults._defines","SCons.Defaults.processDefines","SCons.Errors.UserError"]},"acm000003322jsd":{"type":"ClassUnit","id":"acm000003322jsd","name":"_Null","comment":"","compilationUnitId":"acm000003472jsd","parentDatatypeId":null,"startLine":81,"endLine":82,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003323jsd":{"type":"ControlElement","id":"acm000003323jsd","name":"__call__","comment":"","startLine":434,"endLine":442,"calleeNames":["is_List","super","__call__"]},"acm000003324jsd":{"type":"ControlElement","id":"acm000003324jsd","name":"__repr__","comment":"","startLine":444,"endLine":445,"calleeNames":["repr"]},"acm000003325jsd":{"type":"ControlElement","id":"acm000003325jsd","name":"__str__","comment":"","startLine":447,"endLine":448,"calleeNames":["__repr__"]},"acm000003326jsd":{"type":"ControlElement","id":"acm000003326jsd","name":"__getattr__","comment":"","startLine":450,"endLine":456,"calleeNames":["AttributeError"]},"acm000003327jsd":{"type":"ControlElement","id":"acm000003327jsd","name":"__setattr__","comment":"This allows a Builder to be executed directly\nthrough the Environment to which it's attached.\nIn practice, we shouldn't need this, because\nbuilders actually get executed through a Node.\nBut we do have a unit test for this, and can't\nyet rule out that it would be useful in the\nfuture, so leave it for now.\ndef execute(self, **kw):\nkw['env'] = self.env\nself.builder.execute(**kw)","startLine":458,"endLine":464,"calleeNames":[]},"acm000003328jsd":{"type":"ClassUnit","id":"acm000003328jsd","name":"BuilderWrapper","comment":"A MethodWrapper subclass that that associates an environment with a Builder. This mainly exists to wrap the __call__() function so that all calls to Builders can have their argument lists massaged in the same way (treat a lone argument as the source, treat two arguments as target then source, make sure both target and source are lists) without having to have cut-and-paste code to do it. As a bit of obsessive backwards compatibility, we also intercept attempts to get or set the \"env\" or \"builder\" attributes, which were the names we used before we put the common functionality into the MethodWrapper base class. We'll keep this around for a while in case people shipped Tool modules that reached into the wrapper (like the Tool/qt.py module does, or did). There shouldn't be a lot attribute fetching or setting on these, so a little extra work shouldn't hurt.","compilationUnitId":"acm000003472jsd","parentDatatypeId":null,"startLine":415,"endLine":464,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003323jsd","acm000003324jsd","acm000003325jsd","acm000003326jsd","acm000003327jsd"]},"acm000003329jsd":{"type":"ControlElement","id":"acm000003329jsd","name":"__init__","comment":"Set self.env before calling the superclass initialization,\nbecause it will end up calling our other methods, which will\nneed to point the values in this dictionary to self.env.","startLine":482,"endLine":487,"calleeNames":["super","__init__"]},"acm000003330jsd":{"type":"ControlElement","id":"acm000003330jsd","name":"__semi_deepcopy__","comment":"These cannot be copied since they would both modify the same builder object, and indeed\njust copying would modify the original builder","startLine":489,"endLine":492,"calleeNames":["TypeError"]},"acm000003331jsd":{"type":"ControlElement","id":"acm000003331jsd","name":"__setitem__","comment":"","startLine":494,"endLine":502,"calleeNames":["getattr","RemoveMethod","super","__setitem__","BuilderWrapper"]},"acm000003332jsd":{"type":"ControlElement","id":"acm000003332jsd","name":"__delitem__","comment":"","startLine":504,"endLine":506,"calleeNames":["super","__delitem__","delattr"]},"acm000003333jsd":{"type":"ControlElement","id":"acm000003333jsd","name":"update","comment":"","startLine":508,"endLine":510,"calleeNames":["items","__setitem__"]},"acm000003334jsd":{"type":"ClassUnit","id":"acm000003334jsd","name":"BuilderDict","comment":"This is a dictionary-like class used by an Environment to hold the Builders. We need to do this because every time someone changes the Builders in the Environment's BUILDERS dictionary, we must update the Environment's attributes.","compilationUnitId":"acm000003472jsd","parentDatatypeId":null,"startLine":477,"endLine":510,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003329jsd","acm000003330jsd","acm000003331jsd","acm000003332jsd","acm000003333jsd"]},"acm000003335jsd":{"type":"ControlElement","id":"acm000003335jsd","name":"__init__","comment":"Set self.env before calling the superclass initialization,\nbecause it will end up calling our other methods, which will\nneed to point the values in this dictionary to self.env.","startLine":482,"endLine":487,"calleeNames":["super","__init__"]},"acm000003336jsd":{"type":"ControlElement","id":"acm000003336jsd","name":"_init_special","comment":"Initial the dispatch tables for special handling of special construction variables.","startLine":558,"endLine":574,"calleeNames":["list","keys"]},"acm000003337jsd":{"type":"ControlElement","id":"acm000003337jsd","name":"__eq__","comment":"","startLine":576,"endLine":577,"calleeNames":[]},"acm000003338jsd":{"type":"ControlElement","id":"acm000003338jsd","name":"__delitem__","comment":"","startLine":504,"endLine":506,"calleeNames":["super","__delitem__","delattr"]},"acm000003339jsd":{"type":"ControlElement","id":"acm000003339jsd","name":"__getitem__","comment":"","startLine":586,"endLine":587,"calleeNames":[]},"acm000003340jsd":{"type":"ControlElement","id":"acm000003340jsd","name":"__setitem__","comment":"","startLine":494,"endLine":502,"calleeNames":["getattr","RemoveMethod","super","__setitem__","BuilderWrapper"]},"acm000003341jsd":{"type":"ControlElement","id":"acm000003341jsd","name":"get","comment":"Emulates the get() method of dictionaries.","startLine":612,"endLine":614,"calleeNames":["get"]},"acm000003342jsd":{"type":"ControlElement","id":"acm000003342jsd","name":"__contains__","comment":"","startLine":616,"endLine":617,"calleeNames":[]},"acm000003343jsd":{"type":"ControlElement","id":"acm000003343jsd","name":"keys","comment":"Emulates the keys() method of dictionaries.","startLine":619,"endLine":621,"calleeNames":["keys"]},"acm000003344jsd":{"type":"ControlElement","id":"acm000003344jsd","name":"values","comment":"Emulates the values() method of dictionaries.","startLine":623,"endLine":625,"calleeNames":["values"]},"acm000003345jsd":{"type":"ControlElement","id":"acm000003345jsd","name":"items","comment":"Emulates the items() method of dictionaries.","startLine":627,"endLine":629,"calleeNames":["items"]},"acm000003346jsd":{"type":"ControlElement","id":"acm000003346jsd","name":"setdefault","comment":"Emulates the setdefault() method of dictionaries.","startLine":631,"endLine":633,"calleeNames":["setdefault"]},"acm000003347jsd":{"type":"ControlElement","id":"acm000003347jsd","name":"arg2nodes","comment":"","startLine":635,"endLine":676,"calleeNames":["flatten","is_String","l","subst","node_factory","is_List","extend","append"]},"acm000003348jsd":{"type":"ControlElement","id":"acm000003348jsd","name":"gvars","comment":"","startLine":678,"endLine":679,"calleeNames":[]},"acm000003349jsd":{"type":"ControlElement","id":"acm000003349jsd","name":"lvars","comment":"","startLine":681,"endLine":682,"calleeNames":[]},"acm000003350jsd":{"type":"ControlElement","id":"acm000003350jsd","name":"subst","comment":"Recursively interpolates construction variables from the Environment into the specified string, returning the expanded result. Construction variables are specified by a $ prefix in the string and begin with an initial underscore or alphabetic character followed by any number of underscores or alphanumeric characters. The construction variable names may be surrounded by curly braces to separate the name from trailing characters.","startLine":684,"endLine":699,"calleeNames":["gvars","lvars","update","get_lvars","scons_subst"]},"acm000003351jsd":{"type":"ControlElement","id":"acm000003351jsd","name":"subst_kw","comment":"","startLine":701,"endLine":708,"calleeNames":["items","subst","is_String"]},"acm000003352jsd":{"type":"ControlElement","id":"acm000003352jsd","name":"subst_list","comment":"Calls through to SCons.Subst.scons_subst_list(). See the documentation for that function.","startLine":710,"endLine":720,"calleeNames":["gvars","lvars","update","get_lvars","scons_subst_list"]},"acm000003353jsd":{"type":"ControlElement","id":"acm000003353jsd","name":"subst_path","comment":"Substitute a path list. Turns EntryProxies into Nodes, leaving Nodes (and other objects) as-is.","startLine":722,"endLine":760,"calleeNames":["is_List","to_String_for_subst","get","is_String","subst","len","join","map","s","append"]},"acm000003354jsd":{"type":"ControlElement","id":"acm000003354jsd","name":"backtick","comment":"Emulate command substitution. Provides behavior conceptually like POSIX Shell notation for running a command in backquotes (backticks) by running ``command`` and returning the resulting output string. This is not really a public API any longer, it is provided for the use of :meth:`ParseFlags` (which supports it using a syntax of !command) and :meth:`ParseConfig`. Raises: OSError: if the external command returned non-zero exit status.\ncommon arguments","startLine":765,"endLine":796,"calleeNames":["is_List","scons_subproc_run","write","OSError"]},"acm000003355jsd":{"type":"ControlElement","id":"acm000003355jsd","name":"AddMethod","comment":"Adds the specified function as a method of this construction environment with the specified name. If the name is omitted, the default name is the name of the function itself.","startLine":799,"endLine":806,"calleeNames":["MethodWrapper","append"]},"acm000003356jsd":{"type":"ControlElement","id":"acm000003356jsd","name":"RemoveMethod","comment":"Removes the specified function's MethodWrapper from the added_methods list, so we don't re-bind it when making a clone.","startLine":808,"endLine":813,"calleeNames":[]},"acm000003357jsd":{"type":"ControlElement","id":"acm000003357jsd","name":"Override","comment":"Produce a modified environment whose variables are overridden by the overrides dictionaries. \"overrides\" is a dictionary that will override the variables of this environment. This function is much more efficient than Clone() or creating a new Environment because it doesn't copy the construction environment dictionary, it just wraps the underlying construction environment, and doesn't even create a wrapper object if there are no overrides.","startLine":815,"endLine":840,"calleeNames":["copy_non_reserved_keywords","items","scons_subst_once","OverrideEnvironment","MergeFlags"]},"acm000003358jsd":{"type":"ControlElement","id":"acm000003358jsd","name":"ParseFlags","comment":"Return a dict of parsed flags. Parse ``flags`` and return a dict with the flags distributed into the appropriate construction variable names. The flags are treated as a typical set of command-line flags for a GNU-style toolchain, such as might have been generated by one of the {foo}-config scripts, and used to populate the entries based on knowledge embedded in this method - the choices are not expected to be portable to other toolchains. If one of the ``flags`` strings begins with a bang (exclamation mark), it is assumed to be a command and the rest of the string is executed; the result of that evaluation is then added to the dict.","startLine":842,"endLine":1033,"calleeNames":["CLVar","is_String","do_parse","backtick","split","len","append","join","append_define","File","startswith"]},"acm000003359jsd":{"type":"ControlElement","id":"acm000003359jsd","name":"MergeFlags","comment":"Merge flags into construction variables. Merges the flags from *args* into this construction environent. If *args* is not a dict, it is first converted to one with flags distributed into appropriate construction variables. See :meth:`ParseFlags`. As a side effect, if *unique* is true, a new object is created for each modified construction variable by the loop at the end. This is silently expected by the :meth:`Override` *parse_flags* functionality, which does not want to share the list (or whatever) with the environment being overridden. Args: args: flags to merge unique: merge flags rather than appending (default: True). When merging, path variables are retained from the front, other construction variables from the end.\nAdd orig and value. The logic here was lifted from\npart of env.Append() (see there for a lot of comments\nabout the order in which things are tried) and is\nused mainly to handle coercion of strings to CLVar to\n\"do the right thing\" given (e.g.) an original CCFLAGS\nstring variable like '-pipe -Wall'.\nIf CPPDEFINES is a deque, adding value (a list)\nresults in TypeError, so we handle that case here.\nJust in case we got called from Override, make\nsure we make a copy, because we don't go through\nthe cleanup loops at the end of the outer for loop,\nwhich implicitly gives us a new object.\n## keep left-most occurence\n## keep right-most occurence","startLine":1035,"endLine":1112,"calleeNames":["is_Dict","ParseFlags","Append","items","Split","isinstance","copy","AppendUnique","insert","add_to_orig","append"]},"acm000003360jsd":{"type":"ClassUnit","id":"acm000003360jsd","name":"SubstitutionEnvironment","comment":"Base class for different flavors of construction environments. This class contains a minimal set of methods that handle construction variable expansion and conversion of strings to Nodes, which may or may not be actually useful as a stand-alone class. Which methods ended up in this class is pretty arbitrary right now. They're basically the ones which we've empirically determined are common to the different construction environment subclasses, and most of the others that use or touch the underlying dictionary of construction variables. Eventually, this class should contain all the methods that we determine are necessary for a \"minimal\" interface to the build engine. A full \"native Python\" SCons environment has gotten pretty heavyweight with all of the methods and Tools and construction variables we've jammed in there, so it would be nice to have a lighter weight alternative for interfaces that don't need all of the bells and whistles. (At some point, we'll also probably rename this class \"Base,\" since that more reflects what we want this class to become, but because we've released comments that tell people to subclass Environment.Base to create their own flavors of construction environment, we'll save that for a future refactoring when this class actually becomes useful.)","compilationUnitId":"acm000003472jsd","parentDatatypeId":null,"startLine":520,"endLine":1112,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003335jsd","acm000003336jsd","acm000003337jsd","acm000003338jsd","acm000003339jsd","acm000003340jsd","acm000003341jsd","acm000003342jsd","acm000003343jsd","acm000003344jsd","acm000003345jsd","acm000003346jsd","acm000003347jsd","acm000003348jsd","acm000003349jsd","acm000003350jsd","acm000003351jsd","acm000003352jsd","acm000003353jsd","acm000003354jsd","acm000003355jsd","acm000003356jsd","acm000003357jsd","acm000003358jsd","acm000003359jsd"]},"acm000003361jsd":{"type":"ControlElement","id":"acm000003361jsd","name":"__init__","comment":"Set self.env before calling the superclass initialization,\nbecause it will end up calling our other methods, which will\nneed to point the values in this dictionary to self.env.","startLine":482,"endLine":487,"calleeNames":["super","__init__"]},"acm000003362jsd":{"type":"ControlElement","id":"acm000003362jsd","name":"get_builder","comment":"Fetch the builder with the specified name from the environment.","startLine":1262,"endLine":1268,"calleeNames":[]},"acm000003363jsd":{"type":"ControlElement","id":"acm000003363jsd","name":"validate_CacheDir_class","comment":"Validate the passed custom CacheDir class, or if no args are passed, validate the custom CacheDir class from the environment.","startLine":1270,"endLine":1279,"calleeNames":["get","issubclass","UserError","str"]},"acm000003364jsd":{"type":"ControlElement","id":"acm000003364jsd","name":"get_CacheDir","comment":"","startLine":1281,"endLine":1302,"calleeNames":["DefaultEnvironment","validate_CacheDir_class","type","cachedir_class"]},"acm000003365jsd":{"type":"ControlElement","id":"acm000003365jsd","name":"get_factory","comment":"Return a factory function for creating Nodes for this construction environment.","startLine":1304,"endLine":1331,"calleeNames":["issubclass","getattr"]},"acm000003366jsd":{"type":"ControlElement","id":"acm000003366jsd","name":"_gsm","comment":"","startLine":1334,"endLine":1364,"calleeNames":["is_List","reverse","get_skeys","lower"]},"acm000003367jsd":{"type":"ControlElement","id":"acm000003367jsd","name":"get_scanner","comment":"Find the appropriate scanner given a key (usually a file suffix).","startLine":1366,"endLine":1371,"calleeNames":["lower","_gsm","get"]},"acm000003368jsd":{"type":"ControlElement","id":"acm000003368jsd","name":"scanner_map_delete","comment":"Delete the cached scanner map (if we need to).","startLine":1373,"endLine":1379,"calleeNames":[]},"acm000003369jsd":{"type":"ControlElement","id":"acm000003369jsd","name":"_update","comment":"Private method to update an environment's consvar dict directly. Bypasses the normal checks that occur when users try to set items.","startLine":1381,"endLine":1386,"calleeNames":["update"]},"acm000003370jsd":{"type":"ControlElement","id":"acm000003370jsd","name":"_update_onlynew","comment":"Private method to add new items to an environment's consvar dict. Only adds items from `other` whose keys do not already appear in the existing dict; values from `other` are not used for replacement. Bypasses the normal checks that occur when users try to set items.\n######################################################################\nPublic methods for manipulating an Environment. These begin with\nupper-case letters. The essential characteristic of methods in\nthis section is that they do *not* have corresponding same-named\nglobal functions. For example, a stand-alone Append() function\nmakes no sense, because Append() is all about appending values to\nan Environment's construction variables.\n######################################################################","startLine":1388,"endLine":1397,"calleeNames":["items"]},"acm000003371jsd":{"type":"ControlElement","id":"acm000003371jsd","name":"Append","comment":"Append values to construction variables in an Environment. The variable is created if it is not already present.","startLine":1408,"endLine":1475,"calleeNames":["copy_non_reserved_keywords","items","_add_cppdefines","insert","add_to_orig","is_List","update_dict","is_Dict","scanner_map_delete"]},"acm000003372jsd":{"type":"ControlElement","id":"acm000003372jsd","name":"_canonicalize","comment":"Allow Dirs and strings beginning with # for top-relative. Note this uses the current env's fs (in self).\ntypically a Dir","startLine":1477,"endLine":1486,"calleeNames":["is_String","str","Dir"]},"acm000003373jsd":{"type":"ControlElement","id":"acm000003373jsd","name":"AppendENVPath","comment":"Append path elements to the path *name* in the *envname* dictionary for this environment. Will only add any particular path once, and will normpath and normcase all paths to help assure this. This can also handle the case where the env variable is a list instead of a string. If *delete_existing* is False, a *newpath* element already in the path will not be moved to the end (it will be left where it is).","startLine":1488,"endLine":1509,"calleeNames":["AppendPath"]},"acm000003374jsd":{"type":"ControlElement","id":"acm000003374jsd","name":"AppendUnique","comment":"Append values to existing construction variables in an Environment, if they're not already there. If delete_existing is True, removes existing values first, so values move to end.","startLine":1511,"endLine":1552,"calleeNames":["copy_non_reserved_keywords","items","_add_cppdefines","is_List","_delete_duplicates","is_Dict","update","list","filter","scanner_map_delete"]},"acm000003375jsd":{"type":"ControlElement","id":"acm000003375jsd","name":"Clone","comment":"Return a copy of a construction Environment. The copy is like a Python \"deep copy\"--that is, independent copies are made recursively of each objects--except that a reference is copied when an object is not deep-copyable (like a function). There are no references to any mutable objects in the original Environment.","startLine":1554,"endLine":1600,"calleeNames":["get","copy","semi_deepcopy_dict","BuilderDict","getattr","append","clone","copy_non_reserved_keywords","items","scons_subst_once","Replace","apply_tools","MergeFlags","logInstanceCreation"]},"acm000003376jsd":{"type":"ControlElement","id":"acm000003376jsd","name":"_changed_build","comment":"","startLine":1602,"endLine":1605,"calleeNames":["changed_state","decide_source"]},"acm000003377jsd":{"type":"ControlElement","id":"acm000003377jsd","name":"_changed_content","comment":"","startLine":1607,"endLine":1608,"calleeNames":["changed_content"]},"acm000003378jsd":{"type":"ControlElement","id":"acm000003378jsd","name":"_changed_timestamp_then_content","comment":"","startLine":1610,"endLine":1611,"calleeNames":["changed_timestamp_then_content"]},"acm000003379jsd":{"type":"ControlElement","id":"acm000003379jsd","name":"_changed_timestamp_newer","comment":"","startLine":1613,"endLine":1614,"calleeNames":["changed_timestamp_newer"]},"acm000003380jsd":{"type":"ControlElement","id":"acm000003380jsd","name":"_changed_timestamp_match","comment":"","startLine":1616,"endLine":1617,"calleeNames":["changed_timestamp_match"]},"acm000003381jsd":{"type":"ControlElement","id":"acm000003381jsd","name":"Decider","comment":"","startLine":1619,"endLine":1638,"calleeNames":["callable","UserError","repr"]},"acm000003382jsd":{"type":"ControlElement","id":"acm000003382jsd","name":"Detect","comment":"Return the first available program from one or more possibilities. Args: progs (str or list): one or more command names to check for","startLine":1641,"endLine":1653,"calleeNames":["is_List","WhereIs"]},"acm000003383jsd":{"type":"ControlElement","id":"acm000003383jsd","name":"Dictionary","comment":"","startLine":1656,"endLine":1676,"calleeNames":["len"]},"acm000003384jsd":{"type":"ControlElement","id":"acm000003384jsd","name":"Dump","comment":"Return construction variables serialized to a string. Args: key (optional): if None, format the whole dict of variables. Else format the value of `key` (Default value = None) format (str, optional): specify the format to serialize to. `\"pretty\"` generates a pretty-printed string, `\"json\"` a JSON-formatted string. (Default value = `\"pretty\"`)","startLine":1679,"endLine":1715,"calleeNames":["Dictionary","lower","PrettyPrinter","pformat","str","type","dumps","ValueError"]},"acm000003385jsd":{"type":"ControlElement","id":"acm000003385jsd","name":"FindIxes","comment":"Search a list of paths for something that matches the prefix and suffix. Args: paths: the list of paths or nodes. prefix: construction variable for the prefix. suffix: construction variable for the suffix. Returns: the matched path or None","startLine":1718,"endLine":1736,"calleeNames":["subst","basename","str","len"]},"acm000003386jsd":{"type":"ControlElement","id":"acm000003386jsd","name":"ParseConfig","comment":"Parse the result of running a command to update construction vars. Use ``function`` to parse the output of running ``command`` in order to modify the current environment. Args: command: a string or a list of strings representing a command and its arguments. function: called to process the result of ``command``, which will be passed as ``args``. If ``function`` is omitted or ``None``, :meth:`MergeFlags` is used. Takes 3 args ``(env, args, unique)`` unique: whether no duplicate values are allowed (default true)","startLine":1739,"endLine":1762,"calleeNames":["MergeFlags","is_List","join","subst","function","backtick"]},"acm000003387jsd":{"type":"ControlElement","id":"acm000003387jsd","name":"ParseDepends","comment":"Parse a mkdep-style file for explicit dependencies. This is completely abusable, and should be unnecessary in the \"normal\" case of proper SCons configuration, but it may help make the transition from a Make hierarchy easier for some people to swallow. It can also be genuinely useful when using a tool that can write a .d file, but for which writing a scanner would be too complicated.","startLine":1765,"endLine":1803,"calleeNames":["subst","open","LogicalLines","readlines","split","append","extend","len","UserError","Depends"]},"acm000003388jsd":{"type":"ControlElement","id":"acm000003388jsd","name":"Platform","comment":"","startLine":1805,"endLine":1807,"calleeNames":["subst","Platform"]},"acm000003389jsd":{"type":"ControlElement","id":"acm000003389jsd","name":"Prepend","comment":"Prepend values to construction variables in an Environment. The variable is created if it is not already present.","startLine":1809,"endLine":1875,"calleeNames":["copy_non_reserved_keywords","items","_add_cppdefines","insert","add_to_val","is_List","update_dict","is_Dict","scanner_map_delete"]},"acm000003390jsd":{"type":"ControlElement","id":"acm000003390jsd","name":"PrependENVPath","comment":"Prepend path elements to the path *name* in the *envname* dictionary for this environment. Will only add any particular path once, and will normpath and normcase all paths to help assure this. This can also handle the case where the env variable is a list instead of a string. If *delete_existing* is False, a *newpath* component already in the path will not be moved to the front (it will be left where it is).","startLine":1877,"endLine":1899,"calleeNames":["PrependPath"]},"acm000003391jsd":{"type":"ControlElement","id":"acm000003391jsd","name":"PrependUnique","comment":"Prepend values to existing construction variables in an Environment, if they're not already there. If delete_existing is True, removes existing values first, so values move to front.","startLine":1901,"endLine":1942,"calleeNames":["copy_non_reserved_keywords","items","_add_cppdefines","is_List","_delete_duplicates","is_Dict","update","scanner_map_delete"]},"acm000003392jsd":{"type":"ControlElement","id":"acm000003392jsd","name":"Replace","comment":"Replace existing construction variables in an Environment with new construction variables and/or values.","startLine":1944,"endLine":1958,"calleeNames":["BuilderDict","__setitem__","copy_non_reserved_keywords","_update","semi_deepcopy","scanner_map_delete"]},"acm000003393jsd":{"type":"ControlElement","id":"acm000003393jsd","name":"ReplaceIxes","comment":"Replace old_prefix with new_prefix and old_suffix with new_suffix. env - Environment used to interpolate variables. path - the path that will be modified. old_prefix - construction variable for the old prefix. old_suffix - construction variable for the old suffix. new_prefix - construction variable for the new prefix. new_suffix - construction variable for the new suffix.","startLine":1960,"endLine":1982,"calleeNames":["subst","split","str","len","join"]},"acm000003394jsd":{"type":"ControlElement","id":"acm000003394jsd","name":"SetDefault","comment":"","startLine":1984,"endLine":1988,"calleeNames":["list","keys","Replace"]},"acm000003395jsd":{"type":"ControlElement","id":"acm000003395jsd","name":"_find_toolpath_dir","comment":"","startLine":1990,"endLine":1991,"calleeNames":["Dir","srcnode","get_abspath","subst"]},"acm000003396jsd":{"type":"ControlElement","id":"acm000003396jsd","name":"Tool","comment":"Find and run tool module *tool*. .. versionchanged:: 4.2 returns the tool module rather than ``None``.","startLine":1993,"endLine":2006,"calleeNames":["is_String","subst","get","list","map","Tool","tool"]},"acm000003397jsd":{"type":"ControlElement","id":"acm000003397jsd","name":"WhereIs","comment":"Find prog in the path.\nnothing to search for, just give up","startLine":2008,"endLine":2030,"calleeNames":["is_String","subst","CLVar","WhereIs"]},"acm000003398jsd":{"type":"ControlElement","id":"acm000003398jsd","name":"Action","comment":"","startLine":2040,"endLine":2047,"calleeNames":["is_String","subst","list","map","subst_kw","Action"]},"acm000003399jsd":{"type":"ControlElement","id":"acm000003399jsd","name":"AddPreAction","comment":"","startLine":2049,"endLine":2057,"calleeNames":["arg2nodes","Action","get_executor","keys","add_pre_action"]},"acm000003400jsd":{"type":"ControlElement","id":"acm000003400jsd","name":"AddPostAction","comment":"","startLine":2059,"endLine":2067,"calleeNames":["arg2nodes","Action","get_executor","keys","add_post_action"]},"acm000003401jsd":{"type":"ControlElement","id":"acm000003401jsd","name":"Alias","comment":"","startLine":2069,"endLine":2120,"calleeNames":["arg2nodes","is_List","get_builder","extend","bld","subst_kw","update","Action","Builder","convert","b"]},"acm000003402jsd":{"type":"ControlElement","id":"acm000003402jsd","name":"AlwaysBuild","comment":"","startLine":2122,"endLine":2128,"calleeNames":["extend","arg2nodes","set_always_build"]},"acm000003403jsd":{"type":"ControlElement","id":"acm000003403jsd","name":"Builder","comment":"","startLine":2130,"endLine":2132,"calleeNames":["subst_kw","Builder"]},"acm000003404jsd":{"type":"ControlElement","id":"acm000003404jsd","name":"CacheDir","comment":"","startLine":2134,"endLine":2147,"calleeNames":["subst","validate_CacheDir_class","get_CacheDir"]},"acm000003405jsd":{"type":"ControlElement","id":"acm000003405jsd","name":"Clean","comment":"","startLine":2149,"endLine":2157,"calleeNames":["arg2nodes","extend"]},"acm000003406jsd":{"type":"ControlElement","id":"acm000003406jsd","name":"Configure","comment":"","startLine":2159,"endLine":2169,"calleeNames":["subst_list","subst_kw","get","SConf"]},"acm000003407jsd":{"type":"ControlElement","id":"acm000003407jsd","name":"Command","comment":"Builds the supplied target files from the supplied source files using the supplied action. Action may be any type that the Builder constructor will accept for an action.","startLine":2171,"endLine":2214,"calleeNames":["Builder","bld"]},"acm000003408jsd":{"type":"ControlElement","id":"acm000003408jsd","name":"Depends","comment":"Explicity specify that 'target's depend on 'dependency'.","startLine":2216,"endLine":2222,"calleeNames":["arg2nodes","add_dependency"]},"acm000003409jsd":{"type":"ControlElement","id":"acm000003409jsd","name":"Dir","comment":"","startLine":2224,"endLine":2233,"calleeNames":["subst","is_Sequence","append","Dir"]},"acm000003410jsd":{"type":"ControlElement","id":"acm000003410jsd","name":"PyPackageDir","comment":"","startLine":2235,"endLine":2242,"calleeNames":["subst","is_Sequence","append","PyPackageDir"]},"acm000003411jsd":{"type":"ControlElement","id":"acm000003411jsd","name":"NoClean","comment":"Tags a target so that it will not be cleaned by -c","startLine":2244,"endLine":2251,"calleeNames":["extend","arg2nodes","set_noclean"]},"acm000003412jsd":{"type":"ControlElement","id":"acm000003412jsd","name":"NoCache","comment":"Tags a target so that it will not be cached","startLine":2253,"endLine":2260,"calleeNames":["extend","arg2nodes","set_nocache"]},"acm000003413jsd":{"type":"ControlElement","id":"acm000003413jsd","name":"Entry","comment":"","startLine":2262,"endLine":2271,"calleeNames":["subst","is_Sequence","append","Entry"]},"acm000003414jsd":{"type":"ControlElement","id":"acm000003414jsd","name":"Environment","comment":"","startLine":2273,"endLine":2274,"calleeNames":["Environment","subst_kw"]},"acm000003415jsd":{"type":"ControlElement","id":"acm000003415jsd","name":"Execute","comment":"Directly execute an action through an Environment","startLine":2276,"endLine":2288,"calleeNames":["Action","action","isinstance","write"]},"acm000003416jsd":{"type":"ControlElement","id":"acm000003416jsd","name":"File","comment":"","startLine":2290,"endLine":2299,"calleeNames":["subst","is_Sequence","append","File"]},"acm000003417jsd":{"type":"ControlElement","id":"acm000003417jsd","name":"FindFile","comment":"","startLine":2301,"endLine":2304,"calleeNames":["subst","arg2nodes","find_file","tuple"]},"acm000003418jsd":{"type":"ControlElement","id":"acm000003418jsd","name":"Flatten","comment":"","startLine":2306,"endLine":2307,"calleeNames":["flatten"]},"acm000003419jsd":{"type":"ControlElement","id":"acm000003419jsd","name":"GetBuildPath","comment":"","startLine":2309,"endLine":2314,"calleeNames":["list","map","arg2nodes","is_List"]},"acm000003420jsd":{"type":"ControlElement","id":"acm000003420jsd","name":"Glob","comment":"","startLine":2316,"endLine":2317,"calleeNames":["Glob","subst"]},"acm000003421jsd":{"type":"ControlElement","id":"acm000003421jsd","name":"Ignore","comment":"Ignore a dependency.","startLine":2319,"endLine":2325,"calleeNames":["arg2nodes","add_ignore"]},"acm000003422jsd":{"type":"ControlElement","id":"acm000003422jsd","name":"Literal","comment":"","startLine":2327,"endLine":2328,"calleeNames":["Literal"]},"acm000003423jsd":{"type":"ControlElement","id":"acm000003423jsd","name":"Local","comment":"","startLine":2330,"endLine":2340,"calleeNames":["isinstance","set_local","append","arg2nodes"]},"acm000003424jsd":{"type":"ControlElement","id":"acm000003424jsd","name":"Precious","comment":"Mark *targets* as precious: do not delete before building.","startLine":2342,"endLine":2349,"calleeNames":["extend","arg2nodes","set_precious"]},"acm000003425jsd":{"type":"ControlElement","id":"acm000003425jsd","name":"Pseudo","comment":"Mark *targets* as pseudo: must not exist.","startLine":2351,"endLine":2358,"calleeNames":["extend","arg2nodes","set_pseudo"]},"acm000003426jsd":{"type":"ControlElement","id":"acm000003426jsd","name":"Repository","comment":"Specify Repository directories to search.","startLine":2360,"endLine":2363,"calleeNames":["arg2nodes","list","Repository"]},"acm000003427jsd":{"type":"ControlElement","id":"acm000003427jsd","name":"Requires","comment":"Specify that *prerequisite* must be built before *target*. Creates an order-only relationship, not a full dependency. *prerequisite* must exist before *target* can be built, but a change to *prerequisite* does not trigger a rebuild of *target*.","startLine":2365,"endLine":2376,"calleeNames":["arg2nodes","add_prerequisite"]},"acm000003428jsd":{"type":"ControlElement","id":"acm000003428jsd","name":"Scanner","comment":"","startLine":2378,"endLine":2385,"calleeNames":["is_String","subst","append","subst_kw","ScannerBase"]},"acm000003429jsd":{"type":"ControlElement","id":"acm000003429jsd","name":"SConsignFile","comment":"","startLine":2387,"endLine":2397,"calleeNames":["subst","isabs","join","str","normpath","dirname","exists","Execute","Mkdir","File"]},"acm000003430jsd":{"type":"ControlElement","id":"acm000003430jsd","name":"SideEffect","comment":"Tell scons that side_effects are built as side effects of building targets.","startLine":2399,"endLine":2419,"calleeNames":["arg2nodes","multiple_side_effect_has_builder","UserError","str","add_source","Precious","append"]},"acm000003431jsd":{"type":"ControlElement","id":"acm000003431jsd","name":"Split","comment":"This function converts a string or list into a list of strings or Nodes. This makes things easier for users by allowing files to be specified as a white-space separated list to be split. The input rules are: - A single string containing names separated by spaces. These will be split apart at the spaces. - A single Node instance - A list containing either strings or Node instances. Any strings in the list are not split at spaces. In all cases, the function returns a list of Nodes and strings.","startLine":2421,"endLine":2440,"calleeNames":["is_List","list","map","is_String","subst","split"]},"acm000003432jsd":{"type":"ControlElement","id":"acm000003432jsd","name":"Value","comment":"Return a Value (Python expression) node. .. versionchanged:: 4.0 the *name* parameter was added.","startLine":2442,"endLine":2448,"calleeNames":["ValueWithMemo"]},"acm000003433jsd":{"type":"ControlElement","id":"acm000003433jsd","name":"VariantDir","comment":"","startLine":2450,"endLine":2453,"calleeNames":["arg2nodes","VariantDir"]},"acm000003434jsd":{"type":"ControlElement","id":"acm000003434jsd","name":"FindSourceFiles","comment":"Return a list of all source files.","startLine":2455,"endLine":2476,"calleeNames":["arg2nodes","isinstance","build_source","all_children","has_builder","disambiguate","append","srcnode","list","map","set"]},"acm000003435jsd":{"type":"ControlElement","id":"acm000003435jsd","name":"FindInstalledFiles","comment":"returns the list of all targets of the Install and InstallAs Builder.","startLine":2478,"endLine":2484,"calleeNames":["uniquer_hashables"]},"acm000003436jsd":{"type":"ClassUnit","id":"acm000003436jsd","name":"Base","comment":"Base class for \"real\" construction Environments. These are the primary objects used to communicate dependency and construction information to the build engine. Keyword arguments supplied when the construction Environment is created are construction variables used to initialize the Environment.\n######################################################################\nThis is THE class for interacting with the SCons build engine,\nand it contains a lot of stuff, so we're going to try to keep this\na little organized by grouping the methods.\n######################################################################\n######################################################################\nMethods that make an Environment act like a dictionary. These have\nthe expected standard names for Python mapping objects. Note that\nwe don't actually make an Environment a subclass of UserDict for\nperformance reasons. Note also that we only supply methods for\ndictionary functionality that we actually need and use.\n######################################################################","compilationUnitId":"acm000003472jsd","parentDatatypeId":null,"startLine":1133,"endLine":2484,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003361jsd","acm000003362jsd","acm000003363jsd","acm000003364jsd","acm000003365jsd","acm000003366jsd","acm000003367jsd","acm000003368jsd","acm000003369jsd","acm000003370jsd","acm000003371jsd","acm000003372jsd","acm000003373jsd","acm000003374jsd","acm000003375jsd","acm000003376jsd","acm000003377jsd","acm000003378jsd","acm000003379jsd","acm000003380jsd","acm000003381jsd","acm000003382jsd","acm000003383jsd","acm000003384jsd","acm000003385jsd","acm000003386jsd","acm000003387jsd","acm000003388jsd","acm000003389jsd","acm000003390jsd","acm000003391jsd","acm000003392jsd","acm000003393jsd","acm000003394jsd","acm000003395jsd","acm000003396jsd","acm000003397jsd","acm000003398jsd","acm000003399jsd","acm000003400jsd","acm000003401jsd","acm000003402jsd","acm000003403jsd","acm000003404jsd","acm000003405jsd","acm000003406jsd","acm000003407jsd","acm000003408jsd","acm000003409jsd","acm000003410jsd","acm000003411jsd","acm000003412jsd","acm000003413jsd","acm000003414jsd","acm000003415jsd","acm000003416jsd","acm000003417jsd","acm000003418jsd","acm000003419jsd","acm000003420jsd","acm000003421jsd","acm000003422jsd","acm000003423jsd","acm000003424jsd","acm000003425jsd","acm000003426jsd","acm000003427jsd","acm000003428jsd","acm000003429jsd","acm000003430jsd","acm000003431jsd","acm000003432jsd","acm000003433jsd","acm000003434jsd","acm000003435jsd"]},"acm000003437jsd":{"type":"ControlElement","id":"acm000003437jsd","name":"__init__","comment":"Set self.env before calling the superclass initialization,\nbecause it will end up calling our other methods, which will\nneed to point the values in this dictionary to self.env.","startLine":482,"endLine":487,"calleeNames":["super","__init__"]},"acm000003438jsd":{"type":"ControlElement","id":"acm000003438jsd","name":"__getattr__","comment":"","startLine":450,"endLine":456,"calleeNames":["AttributeError"]},"acm000003439jsd":{"type":"ControlElement","id":"acm000003439jsd","name":"__setattr__","comment":"This allows a Builder to be executed directly\nthrough the Environment to which it's attached.\nIn practice, we shouldn't need this, because\nbuilders actually get executed through a Node.\nBut we do have a unit test for this, and can't\nyet rule out that it would be useful in the\nfuture, so leave it for now.\ndef execute(self, **kw):\nkw['env'] = self.env\nself.builder.execute(**kw)","startLine":458,"endLine":464,"calleeNames":[]},"acm000003440jsd":{"type":"ControlElement","id":"acm000003440jsd","name":"__getitem__","comment":"","startLine":586,"endLine":587,"calleeNames":[]},"acm000003441jsd":{"type":"ControlElement","id":"acm000003441jsd","name":"__setitem__","comment":"","startLine":494,"endLine":502,"calleeNames":["getattr","RemoveMethod","super","__setitem__","BuilderWrapper"]},"acm000003442jsd":{"type":"ControlElement","id":"acm000003442jsd","name":"__delitem__","comment":"","startLine":504,"endLine":506,"calleeNames":["super","__delitem__","delattr"]},"acm000003443jsd":{"type":"ControlElement","id":"acm000003443jsd","name":"get","comment":"Emulates the get() method of dictionaries.","startLine":612,"endLine":614,"calleeNames":["get"]},"acm000003444jsd":{"type":"ControlElement","id":"acm000003444jsd","name":"__contains__","comment":"","startLine":616,"endLine":617,"calleeNames":[]},"acm000003445jsd":{"type":"ControlElement","id":"acm000003445jsd","name":"Dictionary","comment":"","startLine":1656,"endLine":1676,"calleeNames":["len"]},"acm000003446jsd":{"type":"ControlElement","id":"acm000003446jsd","name":"items","comment":"Emulates the items() method of dictionaries.","startLine":627,"endLine":629,"calleeNames":["items"]},"acm000003447jsd":{"type":"ControlElement","id":"acm000003447jsd","name":"keys","comment":"Emulates the keys() method of dictionaries.","startLine":619,"endLine":621,"calleeNames":["keys"]},"acm000003448jsd":{"type":"ControlElement","id":"acm000003448jsd","name":"values","comment":"Emulates the values() method of dictionaries.","startLine":623,"endLine":625,"calleeNames":["values"]},"acm000003449jsd":{"type":"ControlElement","id":"acm000003449jsd","name":"setdefault","comment":"Emulates the setdefault() method of dictionaries.","startLine":631,"endLine":633,"calleeNames":["setdefault"]},"acm000003450jsd":{"type":"ControlElement","id":"acm000003450jsd","name":"_update","comment":"Private method to update an environment's consvar dict directly. Bypasses the normal checks that occur when users try to set items.","startLine":1381,"endLine":1386,"calleeNames":["update"]},"acm000003451jsd":{"type":"ControlElement","id":"acm000003451jsd","name":"_update_onlynew","comment":"Private method to add new items to an environment's consvar dict. Only adds items from `other` whose keys do not already appear in the existing dict; values from `other` are not used for replacement. Bypasses the normal checks that occur when users try to set items.\n######################################################################\nPublic methods for manipulating an Environment. These begin with\nupper-case letters. The essential characteristic of methods in\nthis section is that they do *not* have corresponding same-named\nglobal functions. For example, a stand-alone Append() function\nmakes no sense, because Append() is all about appending values to\nan Environment's construction variables.\n######################################################################","startLine":1388,"endLine":1397,"calleeNames":["items"]},"acm000003452jsd":{"type":"ControlElement","id":"acm000003452jsd","name":"gvars","comment":"","startLine":678,"endLine":679,"calleeNames":[]},"acm000003453jsd":{"type":"ControlElement","id":"acm000003453jsd","name":"lvars","comment":"","startLine":681,"endLine":682,"calleeNames":[]},"acm000003454jsd":{"type":"ControlElement","id":"acm000003454jsd","name":"Replace","comment":"Replace existing construction variables in an Environment with new construction variables and/or values.","startLine":1944,"endLine":1958,"calleeNames":["BuilderDict","__setitem__","copy_non_reserved_keywords","_update","semi_deepcopy","scanner_map_delete"]},"acm000003455jsd":{"type":"ClassUnit","id":"acm000003455jsd","name":"OverrideEnvironment","comment":"A proxy that overrides variables in a wrapped construction environment by returning values from an overrides dictionary in preference to values from the underlying subject environment. This is a lightweight (I hope) proxy that passes through most use of attributes to the underlying Environment.Base class, but has just enough additional methods defined to act like a real construction environment with overridden values. It can wrap either a Base construction environment, or another OverrideEnvironment, which can in turn nest arbitrary OverrideEnvironments... Note that we do *not* call the underlying base class (SubsitutionEnvironment) initialization, because we get most of those from proxying the attributes of the subject construction environment. But because we subclass SubstitutionEnvironment, this class also has inherited arg2nodes() and subst*() methods; those methods can't be proxied because they need *this* object's methods to fetch the values from the overrides dictionary.","compilationUnitId":"acm000003472jsd","parentDatatypeId":null,"startLine":2487,"endLine":2629,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003437jsd","acm000003438jsd","acm000003439jsd","acm000003440jsd","acm000003441jsd","acm000003442jsd","acm000003443jsd","acm000003444jsd","acm000003445jsd","acm000003446jsd","acm000003447jsd","acm000003448jsd","acm000003449jsd","acm000003450jsd","acm000003451jsd","acm000003452jsd","acm000003453jsd","acm000003454jsd"]},"acm000003456jsd":{"type":"ControlElement","id":"acm000003456jsd","name":"alias_builder","comment":"","startLine":93,"endLine":94,"calleeNames":[]},"acm000003457jsd":{"type":"ControlElement","id":"acm000003457jsd","name":"apply_tools","comment":"Store the toolpath in the Environment.\nThis is expected to work even if no tools are given, so do this first.\nFilter out null tools from the list.\ntoolargs should be a dict of kw args\nThese names are (or will be) controlled by SCons; users should never\nset or override them. The warning can optionally be turned off,\nbut scons will still ignore the illegal variable names even if it's off.","startLine":105,"endLine":120,"calleeNames":["is_List","is_Tuple","Tool"]},"acm000003458jsd":{"type":"ControlElement","id":"acm000003458jsd","name":"copy_non_reserved_keywords","comment":"","startLine":142,"endLine":149,"calleeNames":["semi_deepcopy","copy","keys","warn"]},"acm000003459jsd":{"type":"ControlElement","id":"acm000003459jsd","name":"_set_reserved","comment":"","startLine":151,"endLine":153,"calleeNames":["warn"]},"acm000003460jsd":{"type":"ControlElement","id":"acm000003460jsd","name":"_set_future_reserved","comment":"","startLine":155,"endLine":158,"calleeNames":["warn"]},"acm000003461jsd":{"type":"ControlElement","id":"acm000003461jsd","name":"_set_BUILDERS","comment":"","startLine":160,"endLine":171,"calleeNames":["copy","keys","BuilderDict","items","is_a_Builder","UserError","repr","update"]},"acm000003462jsd":{"type":"ControlElement","id":"acm000003462jsd","name":"_del_SCANNERS","comment":"","startLine":173,"endLine":175,"calleeNames":["scanner_map_delete"]},"acm000003463jsd":{"type":"ControlElement","id":"acm000003463jsd","name":"_set_SCANNERS","comment":"","startLine":177,"endLine":179,"calleeNames":["scanner_map_delete"]},"acm000003464jsd":{"type":"ControlElement","id":"acm000003464jsd","name":"_delete_duplicates","comment":"Delete duplicates from a sequence, keeping the first or last.","startLine":181,"endLine":197,"calleeNames":["set","reverse","append","add"]},"acm000003465jsd":{"type":"ControlElement","id":"acm000003465jsd","name":"_add_cppdefines","comment":"add annotation?\nAdds to ``CPPDEFINES``, using the rules for C preprocessor macros. This is split out from regular construction variable addition because these entries can express either a macro with a replacement value or one without. A macro with replacement value can be supplied as *val* in three ways: as a combined string ``\"name=value\"``; as a tuple ``(name, value)``, or as an entry in a dictionary ``{\"name\": value}``. A list argument with multiple macros can also be given. Additions can be unconditional (duplicates allowed) or uniquing (no dupes). Note if a replacement value is supplied, *unique* requires a full match to decide uniqueness - both the macro name and the replacement. The inner :func:`_is_in` is used to figure that out. Args: env_dict: the dictionary containing the ``CPPDEFINES`` to be modified. val: the value to add, can be string, sequence or dict prepend: whether to put *val* in front or back. unique: whether to add *val* if it already exists. delete_existing: if *unique* is true, add *val* after removing previous. .. versionadded:: 4.5.0","startLine":200,"endLine":396,"calleeNames":["appendleft","append","is_Tuple","list","is_String","split","len","_macro_conv","isinstance","deque","UserError","is_List","is_Dict","extend","items","_is_in","remove","_add_define","is_Scalar","extendleft"]},"acm000003466jsd":{"type":"ControlElement","id":"acm000003466jsd","name":"is_valid_construction_var","comment":"Return True if *varstr* is a legitimate construction variable.","startLine":515,"endLine":517,"calleeNames":["match"]},"acm000003467jsd":{"type":"ControlElement","id":"acm000003467jsd","name":"default_decide_source","comment":"","startLine":1115,"endLine":1117,"calleeNames":["DefaultEnvironment","f"]},"acm000003468jsd":{"type":"ControlElement","id":"acm000003468jsd","name":"default_decide_target","comment":"","startLine":1120,"endLine":1122,"calleeNames":["DefaultEnvironment","f"]},"acm000003469jsd":{"type":"ControlElement","id":"acm000003469jsd","name":"default_copy_from_cache","comment":"","startLine":1125,"endLine":1126,"calleeNames":["copy_from_cache"]},"acm000003470jsd":{"type":"ControlElement","id":"acm000003470jsd","name":"default_copy_to_cache","comment":"","startLine":1129,"endLine":1130,"calleeNames":["copy_to_cache"]},"acm000003471jsd":{"type":"ControlElement","id":"acm000003471jsd","name":"NoSubstitutionProxy","comment":"An entry point for returning a proxy subclass instance that overrides the subst*() methods so they don't actually perform construction variable substitution. This is specifically intended to be the shim layer in between global function calls (which don't want construction variable substitution) and the DefaultEnvironment() (which would substitute variables if left to its own devices). We have to wrap this in a function that allows us to delay definition of the class until it's necessary, so that when it subclasses Environment it will pick up whatever Environment subclass the wrapper interface might have assigned to SCons.Environment.Environment.","startLine":2641,"endLine":2703,"calleeNames":["getattr","setattr","get_lvars","copy","executor_to_lvars","raw_to_mode","scons_subst_list","scons_subst","_NoSubstitutionProxy"]},"acm000003472jsd":{"type":"CodeCompilationUnit","id":"acm000003472jsd","name":"Environment","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nBase class for construction Environments. These are the primary objects used to communicate dependency and construction information to the build engine. Keyword arguments supplied when the construction Environment is created are construction variables used to initialize the Environment.","parentId":"acm000004231jsd","content":["acm000003322jsd","acm000003328jsd","acm000003334jsd","acm000003360jsd","acm000003436jsd","acm000003455jsd","acm000003456jsd","acm000003457jsd","acm000003458jsd","acm000003459jsd","acm000003460jsd","acm000003461jsd","acm000003462jsd","acm000003463jsd","acm000003464jsd","acm000003465jsd