  "claims": [
    {
      "id": "claim_6b4e5f7887b84ecba335d1cc85c5ab97",
      "statement": "The InconsistencyDetection runner extends ArdocoRunner and wires the pipeline TextPreprocessingAgent → ModelProviderAgent → TextExtraction → RecommendationGenerator → ConnectionGenerator → InconsistencyChecker, pinning the architecture Metamodel to ARCHITECTURE_WITH_COMPONENTS_AND_INTERFACES, rejecting blank input text, and reusing the SWATTR TLR stages whose results the checker consumes.",
      "evidence": [
        {
          "resource": "repo://inconsistency-detection/pipeline-id/src/main/java/edu/kit/kastel/mcse/ardoco/id/execution/runner/InconsistencyDetection.java#L47-L66",
          "version": "repo-lines-v1:sha256:356bbe9d1de1a81097dcc98e9a770275cc8d43cdf402ee338c5f859c8333fc85:"
        }
      ]
    },
    {
      "id": "claim_8344957b05fa46019009fa8edac4ab57",
      "statement": "InconsistencyChecker is an AbstractExecutionStage that registers InconsistencyStatesImpl in the DataRepository under InconsistencyStates.ID and runs exactly three agents in order: InitialInconsistencyAgent, TextEntityAbsentFromModelInconsistencyAgent (TEAM), and ModelEntityAbsentFromTextInconsistencyAgent (MEAT).",
      "evidence": [
        {
          "resource": "repo://inconsistency-detection/stages-id/inconsistency-detection/src/main/java/edu/kit/kastel/mcse/ardoco/id/InconsistencyChecker.java#L15-L39",
          "version": "repo-lines-v1:sha256:f51c66a1afc519637f1e6b51032b3d5732f95b1cce21a997496bd7ef35e58d46:"
        }
      ]
    },
    {
      "id": "claim_56cc27c294a64d9e8c0140a9a7b1de74",
      "statement": "InitialInconsistencyAgent copies recommended instances from the per-metamodel RecommendationState into the InconsistencyState and then runs three Filter informants: RecommendedInstanceProbabilityFilter (threshold 0.5, dynamicThreshold true with factor 0.7, name-and-type 0.3, name-or-type 0.8), OccasionFilter (expectedAppearances 2, counting distinct text positions), and UnwantedWordsFilter (custom blacklist plus classpath common blacklist, plural words, number-only references, and common file endings); each filter replaces the state's recommended instances.",
      "evidence": [
        {
          "resource": "repo://inconsistency-detection/stages-id/inconsistency-detection/src/main/java/edu/kit/kastel/mcse/ardoco/id/agents/InitialInconsistencyAgent.java#L22-L36",
