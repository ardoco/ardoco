ementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004852jsd"]},"acm000004854jsd":{"type":"ControlElement","id":"acm000004854jsd","name":"test___init__","comment":"Test ValueNodeInfo initialization","startLine":109,"endLine":112,"calleeNames":["Value","ValueNodeInfo"]},"acm000004855jsd":{"type":"ClassUnit","id":"acm000004855jsd","name":"ValueChildTestCase","comment":"","compilationUnitId":"acm000004861jsd","parentDatatypeId":null,"startLine":122,"endLine":131,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004854jsd"]},"acm000004856jsd":{"type":"ControlElement","id":"acm000004856jsd","name":"test_memo","comment":"Test memoization\nFirst confirm that ValueWithMemo does memoization.","startLine":135,"endLine":146,"calleeNames":["ValueWithMemo","ValueNodeInfo","str_to_node"]},"acm000004857jsd":{"type":"ControlElement","id":"acm000004857jsd","name":"test_built_value","comment":"Confirm that built values are not memoized.","startLine":148,"endLine":152,"calleeNames":["ValueWithMemo"]},"acm000004858jsd":{"type":"ControlElement","id":"acm000004858jsd","name":"test_non_primitive_values","comment":"Confirm that non-primitive values are not memoized.","startLine":154,"endLine":164,"calleeNames":["ValueWithMemo"]},"acm000004859jsd":{"type":"ControlElement","id":"acm000004859jsd","name":"test_value_set_name","comment":"Confirm setting name and caching takes the name into account","startLine":166,"endLine":176,"calleeNames":["ValueWithMemo","assertEqual","assertTrue"]},"acm000004860jsd":{"type":"ClassUnit","id":"acm000004860jsd","name":"ValueMemoTestCase","comment":"","compilationUnitId":"acm000004861jsd","parentDatatypeId":null,"startLine":134,"endLine":176,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004856jsd","acm000004857jsd","acm000004858jsd","acm000004859jsd"]},"acm000004861jsd":{"type":"CodeCompilationUnit","id":"acm000004861jsd","name":"PythonTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000005002jsd","content":["acm000004849jsd","acm000004851jsd","acm000004853jsd","acm000004855jsd","acm000004860jsd"],"pathElements":["Node"],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.Errors","SCons.Node.Python"]},"acm000004862jsd":{"type":"ControlElement","id":"acm000004862jsd","name":"update","comment":"","startLine":358,"endLine":373,"calleeNames":["delattr","getattr","setattr","func"]},"acm000004863jsd":{"type":"ControlElement","id":"acm000004863jsd","name":"convert","comment":"","startLine":375,"endLine":376,"calleeNames":[]},"acm000004864jsd":{"type":"ControlElement","id":"acm000004864jsd","name":"merge","comment":"Merge the fields of another object into this object. Already existing information is overwritten by the other instance's data. WARNING: If a '__dict__' slot is added, it should be updated instead of replaced.","startLine":378,"endLine":386,"calleeNames":["__getstate__","__setstate__"]},"acm000004865jsd":{"type":"ControlElement","id":"acm000004865jsd","name":"format","comment":"","startLine":388,"endLine":409,"calleeNames":["list","getattr","keys","type","mro","append","sort","str"]},"acm000004866jsd":{"type":"ControlElement","id":"acm000004866jsd","name":"__getstate__","comment":"Return all fields that shall be pickled. Walk the slots in the class hierarchy and add those to the state dictionary. If a '__dict__' slot is available, copy all entries to the dictionary. Also include the version id, which is fixed for all instances of a class.","startLine":411,"endLine":429,"calleeNames":["getattr","copy","type","mro","hasattr"]},"acm000004867jsd":{"type":"ControlElement","id":"acm000004867jsd","name":"__setstate__","comment":"Restore the attributes from a pickled state. The version is discarded.\nTODO check or discard version","startLine":431,"endLine":440,"calleeNames":["items","setattr"]},"acm000004868jsd":{"type":"ClassUnit","id":"acm000004868jsd","name":"NodeInfoBase","comment":"The generic base class for signature information for a Node. Node subclasses should subclass NodeInfoBase to provide their own logic for dealing with their own Node-specific signature information.","compilationUnitId":"acm000005001jsd","parentDatatypeId":null,"startLine":348,"endLine":440,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004862jsd","acm000004863jsd","acm000004864jsd","acm000004865jsd","acm000004866jsd","acm000004867jsd"]},"acm000004869jsd":{"type":"ControlElement","id":"acm000004869jsd","name":"__init__","comment":"Create an object attribute from the class attribute so it ends up\nin the pickled data in the .sconsign file.","startLine":457,"endLine":463,"calleeNames":[]},"acm000004870jsd":{"type":"ControlElement","id":"acm000004870jsd","name":"merge","comment":"Merge the fields of another object into this object. Already existing information is overwritten by the other instance's data. WARNING: If a '__dict__' slot is added, it should be updated instead of replaced.","startLine":378,"endLine":386,"calleeNames":["__getstate__","__setstate__"]},"acm000004871jsd":{"type":"ControlElement","id":"acm000004871jsd","name":"__getstate__","comment":"Return all fields that shall be pickled. Walk the slots in the class hierarchy and add those to the state dictionary. If a '__dict__' slot is available, copy all entries to the dictionary. Also include the version id, which is fixed for all instances of a class.","startLine":411,"endLine":429,"calleeNames":["getattr","copy","type","mro","hasattr"]},"acm000004872jsd":{"type":"ControlElement","id":"acm000004872jsd","name":"__setstate__","comment":"Restore the attributes from a pickled state. The version is discarded.\nTODO check or discard version","startLine":431,"endLine":440,"calleeNames":["items","setattr"]},"acm000004873jsd":{"type":"ClassUnit","id":"acm000004873jsd","name":"BuildInfoBase","comment":"The generic base class for build information for a Node. This is what gets stored in a .sconsign file for each target file. It contains a NodeInfo instance for this node (signature information that's specific to the type of Node) and direct attributes for the generic build stuff we have to track: sources, explicit dependencies, implicit dependencies, and action information.","compilationUnitId":"acm000005001jsd","parentDatatypeId":null,"startLine":443,"endLine":503,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004869jsd","acm000004870jsd","acm000004871jsd","acm000004872jsd"]},"acm000004874jsd":{"type":"ClassUnit","id":"acm000004874jsd","name":"Attrs","comment":"","compilationUnitId":"acm000005001jsd","parentDatatypeId":null,"startLine":554,"endLine":555,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000004875jsd":{"type":"ControlElement","id":"acm000004875jsd","name":"__init__","comment":"Create an object attribute from the class attribute so it ends up\nin the pickled data in the .sconsign file.","startLine":457,"endLine":463,"calleeNames":[]},"acm000004876jsd":{"type":"ControlElement","id":"acm000004876jsd","name":"disambiguate","comment":"","startLine":617,"endLine":618,"calleeNames":[]},"acm000004877jsd":{"type":"ControlElement","id":"acm000004877jsd","name":"get_suffix","comment":"","startLine":620,"endLine":621,"calleeNames":[]},"acm000004878jsd":{"type":"ControlElement","id":"acm000004878jsd","name":"get_build_env","comment":"Fetch the appropriate Environment to build this node.","startLine":624,"endLine":633,"calleeNames":["get_executor","get_build_env"]},"acm000004879jsd":{"type":"ControlElement","id":"acm000004879jsd","name":"get_build_scanner_path","comment":"Fetch the appropriate scanner path for this node.","startLine":635,"endLine":637,"calleeNames":["get_executor","get_build_scanner_path"]},"acm000004880jsd":{"type":"ControlElement","id":"acm000004880jsd","name":"set_executor","comment":"Set the action executor for this node.","startLine":639,"endLine":641,"calleeNames":[]},"acm000004881jsd":{"type":"ControlElement","id":"acm000004881jsd","name":"get_executor","comment":"Fetch the action executor for this node. Create one if there isn't already one, and requested to do so.\ntype: ignore","startLine":643,"endLine":662,"calleeNames":["Null","Executor"]},"acm000004882jsd":{"type":"ControlElement","id":"acm000004882jsd","name":"executor_cleanup","comment":"Let the executor clean up any cached information.","startLine":664,"endLine":672,"calleeNames":["get_executor","cleanup"]},"acm000004883jsd":{"type":"ControlElement","id":"acm000004883jsd","name":"reset_executor","comment":"Remove cached executor; forces recompute when needed.","startLine":674,"endLine":679,"calleeNames":["delattr"]},"acm000004884jsd":{"type":"ControlElement","id":"acm000004884jsd","name":"push_to_cache","comment":"Try to push a node into a cache","startLine":681,"endLine":684,"calleeNames":[]},"acm000004885jsd":{"type":"ControlElement","id":"acm000004885jsd","name":"retrieve_from_cache","comment":"Try to retrieve the node's content from a cache This method is called from multiple threads in a parallel build, so only do thread safe stuff here. Do thread unsafe stuff in :meth:`built`. Returns true if the node was successfully retrieved.\n\nTaskmaster interface subsystem\n","startLine":686,"endLine":695,"calleeNames":[]},"acm000004886jsd":{"type":"ControlElement","id":"acm000004886jsd","name":"make_ready","comment":"Get a Node ready for evaluation. This is called before the Taskmaster decides if the Node is up-to-date or not. Overriding this method allows for a Node subclass to be disambiguated if necessary, or for an implicit source builder to be attached.","startLine":701,"endLine":709,"calleeNames":[]},"acm000004887jsd":{"type":"ControlElement","id":"acm000004887jsd","name":"prepare","comment":"Prepare for this Node to be built. This is called after the Taskmaster has decided that the Node is out-of-date and must be rebuilt, but before actually calling the method to build the Node. This default implementation checks that explicit or implicit dependencies either exist or are derived, and initializes the BuildInfo structure that will hold the information about how this node is, uh, built. (The existence of source files is checked separately by the Executor, which aggregates checks for all of the targets built by a specific action.) Overriding this method allows for for a Node subclass to remove the underlying file from the file system. Note that subclass methods should call this base class method to get the child check and the BuildInfo structure.","startLine":711,"endLine":742,"calleeNames":["missing","StopError","get_binfo"]},"acm000004888jsd":{"type":"ControlElement","id":"acm000004888jsd","name":"build","comment":"Actually build the node. This is called by the Taskmaster after it's decided that the Node is out-of-date and must be rebuilt, and after the :meth:`prepare` method has gotten everything, uh, prepared. This method is called from multiple threads in a parallel build, so only do thread safe stuff here. Do thread unsafe stuff in :meth:`built`.","startLine":744,"endLine":760,"calleeNames":["get_executor"]},"acm000004889jsd":{"type":"ControlElement","id":"acm000004889jsd","name":"built","comment":"Called just after this node is successfully built.\nClear the implicit dependency caches of any Nodes\nwaiting for this Node to be built.\nHandle issue where builder emits more than one target and\nthe source file for the builder is generated.\nin that case only the first target was getting it's .implicit\ncleared when the source file is built (second scan).\nleaving only partial implicits from scan before source file is generated\ntypically the compiler only. Then scanned files are appended\nThis is persisted to sconsign and rebuild causes false rebuilds\nbecause the ordering of the implicit list then changes to what it\nshould have been.\nThis is at least the following bugs\nhttps://github.com/SCons/scons/issues/2811\nhttps://jira.mongodb.org/browse/SERVER-33111","startLine":762,"endLine":797,"calleeNames":["clear","exists","UserError","str","warn","update"]},"acm000004890jsd":{"type":"ControlElement","id":"acm000004890jsd","name":"visited","comment":"Called just after this node has been visited (with or without a build).\nApparently this node doesn't need build info, so\ndon't bother calculating or storing it.","startLine":799,"endLine":810,"calleeNames":["update"]},"acm000004891jsd":{"type":"ControlElement","id":"acm000004891jsd","name":"release_target_info","comment":"Called just after this node has been marked up-to-date or was built completely. This is where we try to release as many target node infos as possible for clean builds and update runs, in order to minimize the overall memory consumption. By purging attributes that aren't needed any longer after a Node (=File) got built, we don't have to care that much how many KBytes a Node actually requires...as long as we free the memory shortly afterwards. @see: built() and File.release_target_info()","startLine":812,"endLine":827,"calleeNames":[]},"acm000004892jsd":{"type":"ControlElement","id":"acm000004892jsd","name":"add_to_waiting_s_e","comment":"","startLine":829,"endLine":830,"calleeNames":["add"]},"acm000004893jsd":{"type":"ControlElement","id":"acm000004893jsd","name":"add_to_waiting_parents","comment":"Returns the number of nodes added to our waiting parents list: 1 if we add a unique waiting parent, 0 if not. (Note that the returned values are intended to be used to increment a reference count, so don't think you can \"clean up\" this function by using True and False instead...)","startLine":832,"endLine":844,"calleeNames":["add"]},"acm000004894jsd":{"type":"ControlElement","id":"acm000004894jsd","name":"postprocess","comment":"Clean up anything we don't need to hang onto after we've been built.","startLine":846,"endLine":850,"calleeNames":["executor_cleanup","set"]},"acm000004895jsd":{"type":"ControlElement","id":"acm000004895jsd","name":"clear","comment":"Completely clear a Node of all its cached state (so that it can be re-evaluated by interfaces that do continuous integration builds).\nThe del_binfo() call here isn't necessary for normal execution,\nbut is for interactive mode, where we might rebuild the same\ntarget and need to start from scratch.","startLine":852,"endLine":870,"calleeNames":["del_binfo","clear_memoized_values","new_ninfo","executor_cleanup","delattr"]},"acm000004896jsd":{"type":"ControlElement","id":"acm000004896jsd","name":"clear_memoized_values","comment":"","startLine":872,"endLine":873,"calleeNames":[]},"acm000004897jsd":{"type":"ControlElement","id":"acm000004897jsd","name":"builder_set","comment":"","startLine":875,"endLine":880,"calleeNames":[]},"acm000004898jsd":{"type":"ControlElement","id":"acm000004898jsd","name":"has_builder","comment":"Return whether this Node has a builder or not. In Boolean tests, this turns out to be a *lot* more efficient than simply examining the builder attribute directly (\"if node.builder: ...\"). When the builder attribute is examined directly, it ends up calling __getattr__ for both the __len__ and __bool__ attributes on instances of our Builder Proxy class(es), generating a bazillion extra calls and slowing things down immensely.\nThere was no explicit builder for this Node, so initialize\nthe self.builder attribute to None now.","startLine":882,"endLine":899,"calleeNames":[]},"acm000004899jsd":{"type":"ControlElement","id":"acm000004899jsd","name":"set_explicit","comment":"","startLine":901,"endLine":902,"calleeNames":[]},"acm000004900jsd":{"type":"ControlElement","id":"acm000004900jsd","name":"has_explicit_builder","comment":"Return whether this Node has an explicit builder. This allows an internal Builder created by SCons to be marked non-explicit, so that it can be overridden by an explicit builder that the user supplies (the canonical example being directories).","startLine":904,"endLine":915,"calleeNames":[]},"acm000004901jsd":{"type":"ControlElement","id":"acm000004901jsd","name":"get_builder","comment":"Return the set builder, or a specified default value","startLine":917,"endLine":922,"calleeNames":[]},"acm000004902jsd":{"type":"ControlElement","id":"acm000004902jsd","name":"is_derived","comment":"Returns true if this node is derived (i.e. built). This should return true only for nodes whose path should be in the variant directory when duplicate=0 and should contribute their build signatures when they are used as source files to other derived files. For example: source with source builders are not derived in this sense, and hence should not return true.","startLine":926,"endLine":936,"calleeNames":[]},"acm000004903jsd":{"type":"ControlElement","id":"acm000004903jsd","name":"is_sconscript","comment":"Returns true if this node is an sconscript","startLine":938,"endLine":940,"calleeNames":[]},"acm000004904jsd":{"type":"ControlElement","id":"acm000004904jsd","name":"is_conftest","comment":"Returns true if this node is an conftest node","startLine":942,"endLine":948,"calleeNames":[]},"acm000004905jsd":{"type":"ControlElement","id":"acm000004905jsd","name":"check_attributes","comment":"Simple API to check if the node.attributes for name has been set","startLine":950,"endLine":952,"calleeNames":["getattr"]},"acm000004906jsd":{"type":"ControlElement","id":"acm000004906jsd","name":"alter_targets","comment":"Return a list of alternate targets for this Node.","startLine":955,"endLine":958,"calleeNames":[]},"acm000004907jsd":{"type":"ControlElement","id":"acm000004907jsd","name":"get_found_includes","comment":"Return the scanned include lines (implicit dependencies) found in this node. The default is no implicit dependencies. We expect this method to be overridden by any subclass that can be scanned for implicit dependencies.","startLine":960,"endLine":968,"calleeNames":[]},"acm000004908jsd":{"type":"ControlElement","id":"acm000004908jsd","name":"get_implicit_deps","comment":"Return a list of implicit dependencies for this node. This method exists to handle recursive invocation of the scanner on the implicit dependencies returned by the scanner, if the scanner's recursive flag says that we should.","startLine":970,"endLine":1003,"calleeNames":["set","_get_scanner","pop","path_func","get_found_includes","extend","update","recurse_nodes"]},"acm000004909jsd":{"type":"ControlElement","id":"acm000004909jsd","name":"_get_scanner","comment":"handle explicit scanner case\nhandle implicit scanner case\nno scanner could be found for the given node's scanner key;\nthus, make an attempt at using a default.","startLine":1005,"endLine":1020,"calleeNames":["select","get_env_scanner"]},"acm000004910jsd":{"type":"ControlElement","id":"acm000004910jsd","name":"get_env_scanner","comment":"","startLine":1022,"endLine":1023,"calleeNames":["get_scanner","scanner_key"]},"acm000004911jsd":{"type":"ControlElement","id":"acm000004911jsd","name":"get_target_scanner","comment":"","startLine":1025,"endLine":1026,"calleeNames":[]},"acm000004912jsd":{"type":"ControlElement","id":"acm000004912jsd","name":"get_source_scanner","comment":"Fetch the source scanner for the specified node NOTE: \"self\" is the target being built, \"node\" is the source file for which we want to fetch the scanner. Implies self.has_builder() is true; again, expect to only be called from locations where this is already verified. This function may be called very often; it attempts to cache the scanner found to improve performance.","startLine":1028,"endLine":1052,"calleeNames":["get_env_scanner","get_build_env","select"]},"acm000004913jsd":{"type":"ControlElement","id":"acm000004913jsd","name":"add_to_implicit","comment":"","startLine":1054,"endLine":1059,"calleeNames":["hasattr","set","_children_reset","_add_child"]},"acm000004914jsd":{"type":"ControlElement","id":"acm000004914jsd","name":"scan","comment":"Scan this node's dependents for implicit dependencies.\nDon't bother scanning non-derived files, because we don't\ncare what their dependencies are.\nDon't scan again, if we already have scanned.","startLine":1061,"endLine":1108,"calleeNames":["set","_children_reset","has_builder","get_build_env","get_executor","get_stored_implicit","get_all_targets","add_to_implicit","is_up_to_date","scan_sources","get_target_scanner","scan_targets"]},"acm000004915jsd":{"type":"ControlElement","id":"acm000004915jsd","name":"scanner_key","comment":"","startLine":1110,"endLine":1111,"calleeNames":[]},"acm000004916jsd":{"type":"ControlElement","id":"acm000004916jsd","name":"select_scanner","comment":"Selects a scanner for this Node. This is a separate method so it can be overridden by Node subclasses (specifically, Node.FS.Dir) that *must* use their own Scanner and don't select one the Scanner.Selector that's configured for the target.","startLine":1113,"endLine":1121,"calleeNames":["select"]},"acm000004917jsd":{"type":"ControlElement","id":"acm000004917jsd","name":"env_set","comment":"","startLine":1123,"endLine":1126,"calleeNames":[]},"acm000004918jsd":{"type":"ControlElement","id":"acm000004918jsd","name":"new_ninfo","comment":"","startLine":1135,"endLine":1137,"calleeNames":["NodeInfo"]},"acm000004919jsd":{"type":"ControlElement","id":"acm000004919jsd","name":"get_ninfo","comment":"","startLine":1139,"endLine":1143,"calleeNames":["new_ninfo"]},"acm000004920jsd":{"type":"ControlElement","id":"acm000004920jsd","name":"new_binfo","comment":"","startLine":1145,"endLine":1147,"calleeNames":["BuildInfo"]},"acm000004921jsd":{"type":"ControlElement","id":"acm000004921jsd","name":"get_binfo","comment":"Fetch a node's build information. node - the node whose sources will be collected cache - alternate node to use for the signature cache returns - the build signature This no longer handles the recursive descent of the node's children's signatures. We expect that they're already built and updated by someone else, if that's what's wanted.","startLine":1149,"endLine":1199,"calleeNames":["new_binfo","get_executor","has_builder","str","hash_signature","get_contents","get_unignored_sources","set","add","get_ninfo"]},"acm000004922jsd":{"type":"ControlElement","id":"acm000004922jsd","name":"del_binfo","comment":"Delete the build info from this node.","startLine":1201,"endLine":1206,"calleeNames":["delattr"]},"acm000004923jsd":{"type":"ControlElement","id":"acm000004923jsd","name":"get_csig","comment":"","startLine":1208,"endLine":1214,"calleeNames":["get_ninfo","hash_signature","get_contents"]},"acm000004924jsd":{"type":"ControlElement","id":"acm000004924jsd","name":"get_cachedir_csig","comment":"","startLine":1216,"endLine":1217,"calleeNames":["get_csig"]},"acm000004925jsd":{"type":"ControlElement","id":"acm000004925jsd","name":"get_stored_info","comment":"","startLine":1219,"endLine":1220,"calleeNames":[]},"acm000004926jsd":{"type":"ControlElement","id":"acm000004926jsd","name":"get_stored_implicit","comment":"Fetch the stored implicit dependencies\n\n\n","startLine":1222,"endLine":1224,"calleeNames":[]},"acm000004927jsd":{"type":"ControlElement","id":"acm000004927jsd","name":"set_precious","comment":"Set the Node's precious value.","startLine":1230,"endLine":1232,"calleeNames":[]},"acm000004928jsd":{"type":"ControlElement","id":"acm000004928jsd","name":"set_pseudo","comment":"Set the Node's pseudo value.","startLine":1234,"endLine":1236,"calleeNames":[]},"acm000004929jsd":{"type":"ControlElement","id":"acm000004929jsd","name":"set_noclean","comment":"Set the Node's noclean value.\nMake sure noclean is an integer so the --debug=stree\noutput in Util.py can use it as an index.","startLine":1238,"endLine":1242,"calleeNames":[]},"acm000004930jsd":{"type":"ControlElement","id":"acm000004930jsd","name":"set_nocache","comment":"Set the Node's nocache value.\nMake sure nocache is an integer so the --debug=stree\noutput in Util.py can use it as an index.","startLine":1244,"endLine":1248,"calleeNames":[]},"acm000004931jsd":{"type":"ControlElement","id":"acm000004931jsd","name":"set_always_build","comment":"Set the Node's always_build value.","startLine":1250,"endLine":1252,"calleeNames":[]},"acm000004932jsd":{"type":"ControlElement","id":"acm000004932jsd","name":"exists","comment":"Reports whether node exists.","startLine":1254,"endLine":1256,"calleeNames":[]},"acm000004933jsd":{"type":"ControlElement","id":"acm000004933jsd","name":"rexists","comment":"Does this node exist locally or in a repository?\nThere are no repositories by default:","startLine":1258,"endLine":1261,"calleeNames":[]},"acm000004934jsd":{"type":"ControlElement","id":"acm000004934jsd","name":"get_contents","comment":"Fetch the contents of the entry.","startLine":1263,"endLine":1265,"calleeNames":[]},"acm000004935jsd":{"type":"ControlElement","id":"acm000004935jsd","name":"missing","comment":"","startLine":1267,"endLine":1270,"calleeNames":["is_derived","rexists"]},"acm000004936jsd":{"type":"ControlElement","id":"acm000004936jsd","name":"remove","comment":"Remove this Node: no-op by default.","startLine":1272,"endLine":1274,"calleeNames":[]},"acm000004937jsd":{"type":"ControlElement","id":"acm000004937jsd","name":"add_dependency","comment":"Adds dependencies.","startLine":1276,"endLine":1286,"calleeNames":["_add_child","is_List","list","map","str","UserError","type"]},"acm000004938jsd":{"type":"ControlElement","id":"acm000004938jsd","name":"add_prerequisite","comment":"Adds prerequisites","startLine":1288,"endLine":1293,"calleeNames":["UniqueList","extend","_children_reset"]},"acm000004939jsd":{"type":"ControlElement","id":"acm000004939jsd","name":"add_ignore","comment":"Adds dependencies to ignore.","startLine":1295,"endLine":1305,"calleeNames":["_add_child","is_List","list","map","str","UserError","type"]},"acm000004940jsd":{"type":"ControlElement","id":"acm000004940jsd","name":"add_source","comment":"Adds sources.","startLine":1307,"endLine":1319,"calleeNames":["_add_child","is_List","list","map","str","UserError","type"]},"acm000004941jsd":{"type":"ControlElement","id":"acm000004941jsd","name":"_add_child","comment":"Adds 'child' to 'collection', first checking 'set' to see if it's already present.","startLine":1321,"endLine":1331,"calleeNames":["add","append","_children_reset"]},"acm000004942jsd":{"type":"ControlElement","id":"acm000004942jsd","name":"set_specific_source","comment":"","startLine":1333,"endLine":1335,"calleeNames":["add_source"]},"acm000004943jsd":{"type":"ControlElement","id":"acm000004943jsd","name":"add_wkid","comment":"Add a node to the list of kids waiting to be evaluated","startLine":1337,"endLine":1340,"calleeNames":["append"]},"acm000004944jsd":{"type":"ControlElement","id":"acm000004944jsd","name":"_children_reset","comment":"We need to let the Executor clear out any calculated\nbuild info that it's cached so we can re-calculate it.","startLine":1342,"endLine":1346,"calleeNames":["clear_memoized_values","executor_cleanup"]},"acm000004945jsd":{"type":"ControlElement","id":"acm000004945jsd","name":"_children_get","comment":"The return list may contain duplicate Nodes, especially in\nsource trees where there are a lot of repeated #includes\nof a tangle of .h files. Profiling shows, however, that\neliminating the duplicates with a brute-force approach that\npreserves the order (that is, something like:\n\nu = []\nfor n in list:\nif n not in u:\nu.append(n)\"\n\ntakes more cycles than just letting the underlying methods\nhand back cached values if a Node's information is requested\nmultiple times. (Other methods of removing duplicates, like\nusing dictionary keys, lose the order, and the only ordered\ndictionary patterns I found all ended up using \"not in\"\ninternally anyway...)","startLine":1349,"endLine":1383,"calleeNames":["from_iterable","append","all_children"]},"acm000004946jsd":{"type":"ControlElement","id":"acm000004946jsd","name":"all_children","comment":"Return a list of all the node's direct children.\nThe return list may contain duplicate Nodes, especially in\nsource trees where there are a lot of repeated #includes\nof a tangle of .h files. Profiling shows, however, that\neliminating the duplicates with a brute-force approach that\npreserves the order (that is, something like:\n\nu = []\nfor n in list:\nif n not in u:\nu.append(n)\"\n\ntakes more cycles than just letting the underlying methods\nhand back cached values if a Node's information is requested\nmultiple times. (Other methods of removing duplicates, like\nusing dictionary keys, lose the order, and the only ordered\ndictionary patterns I found all ended up using \"not in\"\ninternally anyway...)","startLine":1385,"endLine":1407,"calleeNames":["scan","list","from_iterable"]},"acm000004947jsd":{"type":"ControlElement","id":"acm000004947jsd","name":"children","comment":"Return a list of the node's direct children, minus those that are ignored by this node.","startLine":1409,"endLine":1414,"calleeNames":["scan","_children_get"]},"acm000004948jsd":{"type":"ControlElement","id":"acm000004948jsd","name":"set_state","comment":"","startLine":1416,"endLine":1417,"calleeNames":[]},"acm000004949jsd":{"type":"ControlElement","id":"acm000004949jsd","name":"get_state","comment":"","startLine":1419,"endLine":1420,"calleeNames":[]},"acm000004950jsd":{"type":"ControlElement","id":"acm000004950jsd","name":"get_env","comment":"","startLine":1422,"endLine":1427,"calleeNames":["DefaultEnvironment"]},"acm000004951jsd":{"type":"ControlElement","id":"acm000004951jsd","name":"Decider","comment":"","startLine":1429,"endLine":1438,"calleeNames":["items","len"]},"acm000004952jsd":{"type":"ControlElement","id":"acm000004952jsd","name":"Tag","comment":"Add a user-defined tag.","startLine":1440,"endLine":1444,"calleeNames":[]},"acm000004953jsd":{"type":"ControlElement","id":"acm000004953jsd","name":"GetTag","comment":"Return a user-defined tag.","startLine":1446,"endLine":1450,"calleeNames":["get"]},"acm000004954jsd":{"type":"ControlElement","id":"acm000004954jsd","name":"changed","comment":"Returns if the node is up-to-date with respect to the BuildInfo stored last time it was built. The default behavior is to compare it against our own previously stored BuildInfo, but the stored BuildInfo from another Node (typically one in a Repository) can be used instead. Note that we now *always* check every dependency. We used to short-circuit the check by returning as soon as we detected any difference, but we now rely on checking every dependency to make sure that any necessary Node information (for example, the content signature of an #included .h file) is updated. The allowcache option was added for supporting the early release of the executor/builder structures, right after a File target was built. When set to true, the return value of this changed method gets cached for File nodes. Like this, the executor isn't needed any longer for subsequent calls to changed(). @see: FS.File.changed(), FS.File.release_target_info()","startLine":1452,"endLine":1514,"calleeNames":["Trace","classname","get_stored_info","children","len","extend","zip","has_builder","get_executor","get_contents","hash_signature"]},"acm000004955jsd":{"type":"ControlElement","id":"acm000004955jsd","name":"is_up_to_date","comment":"Default check for whether the Node is current: unknown Node subtypes are always out of date, so they will always get built.","startLine":1516,"endLine":1519,"calleeNames":[]},"acm000004956jsd":{"type":"ControlElement","id":"acm000004956jsd","name":"children_are_up_to_date","comment":"Alternate check for whether the Node is current: If all of our children were up-to-date, then this Node was up-to-date, too. The SCons.Node.Alias and SCons.Node.Python.Value subclasses rebind their current() method to this method.\nAllow the children to calculate their signatures.","startLine":1521,"endLine":1536,"calleeNames":["get_binfo","children","get_state"]},"acm000004957jsd":{"type":"ControlElement","id":"acm000004957jsd","name":"is_literal","comment":"Always pass the string representation of a Node to the command interpreter literally.","startLine":1538,"endLine":1541,"calleeNames":[]},"acm000004958jsd":{"type":"ControlElement","id":"acm000004958jsd","name":"render_include_tree","comment":"Return a text representation, suitable for displaying to the user, of the include tree for the sources of this node.","startLine":1543,"endLine":1561,"calleeNames":["is_derived","get_build_env","get_source_scanner","get_build_scanner_path","get_found_includes","render_tree"]},"acm000004959jsd":{"type":"ControlElement","id":"acm000004959jsd","name":"get_abspath","comment":"Return an absolute path to the Node. This will return simply str(Node) by default, but for Node types that have a concept of relative path, this might return something different.","startLine":1563,"endLine":1569,"calleeNames":["str"]},"acm000004960jsd":{"type":"ControlElement","id":"acm000004960jsd","name":"for_signature","comment":"Return a string representation of the Node that will always be the same for this particular Node, no matter what. This is by contrast to the __str__() method, which might, for instance, return a relative path for a file Node. The purpose of this method is to generate a value to be used in signature calculation for the command line used to build a target, and we use this method instead of str() to avoid unnecessary rebuilds. This method does not need to return something that would actually work in a command line; it can return any kind of nonsense, so long as it does not change.","startLine":1571,"endLine":1584,"calleeNames":["str"]},"acm000004961jsd":{"type":"ControlElement","id":"acm000004961jsd","name":"get_string","comment":"This is a convenience function designed primarily to be used in command generators (i.e., CommandGeneratorActions or Environment variables that are callable), which are called with a for_signature argument that is nonzero if the command generator is being called to generate a signature for the command line, which determines if we should rebuild or not. Such command generators should use this method in preference to str(Node) when converting a Node to a string, passing in the for_signature parameter, such that we will call Node.for_signature() or str(Node) properly, depending on whether we are calculating a signature or actually constructing a command line.","startLine":1586,"endLine":1602,"calleeNames":["for_signature","str"]},"acm000004962jsd":{"type":"ControlElement","id":"acm000004962jsd","name":"get_subst_proxy","comment":"This method is expected to return an object that will function exactly like this Node, except that it implements any additional special features that we would like to be in effect for Environment variable substitution. The principle use is that some Nodes would like to implement a __getattr__() method, but putting that in the Node type itself has a tendency to kill performance. We instead put it in a proxy and return it from this method. It is legal for this method to return self if no new functionality is needed for Environment substitution.","startLine":1604,"endLine":1616,"calleeNames":[]},"acm000004963jsd":{"type":"ControlElement","id":"acm000004963jsd","name":"explain","comment":"","startLine":1618,"endLine":1711,"calleeNames":["exists","get_stored_info","prepare_dependencies","get_binfo","dict","list","zip","hasattr","str","E","stringify","extend","append","len","zip_longest","split","join","fmt_with_title"]},"acm000004964jsd":{"type":"ClassUnit","id":"acm000004964jsd","name":"Node","comment":"The base Node class, for entities that we know how to build, or use to build other Nodes.","compilationUnitId":"acm000005001jsd","parentDatatypeId":null,"startLine":506,"endLine":1711,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004874jsd","acm000004875jsd","acm000004876jsd","acm000004877jsd","acm000004878jsd","acm000004879jsd","acm000004880jsd","acm000004881jsd","acm000004882jsd","acm000004883jsd","acm000004884jsd","acm000004885jsd","acm000004886jsd","acm000004887jsd","acm000004888jsd","acm000004889jsd","acm000004890jsd","acm000004891jsd","acm000004892jsd","acm000004893jsd","acm000004894jsd","acm000004895jsd","acm000004896jsd","acm000004897jsd","acm000004898jsd","acm000004899jsd","acm000004900jsd","acm000004901jsd","acm000004902jsd","acm000004903jsd","acm000004904jsd","acm000004905jsd","acm000004906jsd","acm000004907jsd","acm000004908jsd","acm000004909jsd","acm000004910jsd","acm000004911jsd","acm000004912jsd","acm000004913jsd","acm000004914jsd","acm000004915jsd","acm000004916jsd","acm000004917jsd","acm000004918jsd","acm000004919jsd","acm000004920jsd","acm000004921jsd","acm000004922jsd","acm000004923jsd","acm000004924jsd","acm000004925jsd","acm000004926jsd","acm000004927jsd","acm000004928jsd","acm000004929jsd","acm000004930jsd","acm000004931jsd","acm000004932jsd","acm000004933jsd","acm000004934jsd","acm000004935jsd","acm000004936jsd","acm000004937jsd","acm000004938jsd","acm000004939jsd","acm000004940jsd","acm000004941jsd","acm000004942jsd","acm000004943jsd","acm000004944jsd","acm000004945jsd","acm000004946jsd","acm000004947jsd","acm000004948jsd","acm000004949jsd","acm000004950jsd","acm000004951jsd","acm000004952jsd","acm000004953jsd","acm000004954jsd","acm000004955jsd","acm000004956jsd","acm000004957jsd","acm000004958jsd","acm000004959jsd","acm000004960jsd","acm000004961jsd","acm000004962jsd","acm000004963jsd"]},"acm000004965jsd":{"type":"ControlElement","id":"acm000004965jsd","name":"__str__","comment":"","startLine":1714,"endLine":1715,"calleeNames":["str","list","map"]},"acm000004966jsd":{"type":"ClassUnit","id":"acm000004966jsd","name":"NodeList","comment":"","compilationUnitId":"acm000005001jsd","parentDatatypeId":null,"startLine":1713,"endLine":1715,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004965jsd"]},"acm000004967jsd":{"type":"ControlElement","id":"acm000004967jsd","name":"__init__","comment":"Create an object attribute from the class attribute so it ends up\nin the pickled data in the .sconsign file.","startLine":457,"endLine":463,"calleeNames":[]},"acm000004968jsd":{"type":"ControlElement","id":"acm000004968jsd","name":"get_next","comment":"Return the next node for this walk of the tree. This function is intentionally iterative, not recursive, to sidestep any issues of stack size limitations.","startLine":1745,"endLine":1773,"calleeNames":["pop","cycle_func","copy","kids_func","append","eval_func"]},"acm000004969jsd":{"type":"ControlElement","id":"acm000004969jsd","name":"is_done","comment":"","startLine":1775,"endLine":1776,"calleeNames":[]},"acm000004970jsd":{"type":"ClassUnit","id":"acm000004970jsd","name":"Walker","comment":"An iterator for walking a Node tree. This is depth-first, children are visited before the parent. The Walker object can be initialized with any node, and returns the next node on the descent with each get_next() call. get the children of a node instead of calling 'children'. 'cycle_func' is an optional function that will be called when a cycle is detected. This class does not get caught in node cycles caused, for example, by C header file include loops.","compilationUnitId":"acm000005001jsd","parentDatatypeId":null,"startLine":1721,"endLine":1776,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004967jsd","acm000004968jsd","acm000004969jsd"]},"acm000004971jsd":{"type":"ControlElement","id":"acm000004971jsd","name":"classname","comment":"Set to false if we're doing a dry run. There's more than one of these\nlittle treats","startLine":58,"endLine":59,"calleeNames":["str","split"]},"acm000004972jsd":{"type":"ControlElement","id":"acm000004972jsd","name":"do_nothing_node","comment":"","startLine":99,"endLine":101,"calleeNames":[]},"acm000004973jsd":{"type":"ControlElement","id":"acm000004973jsd","name":"is_derived_none","comment":"","startLine":111,"endLine":112,"calleeNames":[]},"acm000004974jsd":{"type":"ControlElement","id":"acm000004974jsd","name":"is_derived_node","comment":"Returns true if this node is derived (i.e. built).","startLine":114,"endLine":118,"calleeNames":["has_builder"]},"acm000004975jsd":{"type":"ControlElement","id":"acm000004975jsd","name":"exists_none","comment":"","startLine":123,"endLine":124,"calleeNames":[]},"acm000004976jsd":{"type":"ControlElement","id":"acm000004976jsd","name":"exists_always","comment":"","startLine":126,"endLine":127,"calleeNames":[]},"acm000004977jsd":{"type":"ControlElement","id":"acm000004977jsd","name":"exists_base","comment":"","startLine":129,"endLine":130,"calleeNames":["stat"]},"acm000004978jsd":{"type":"ControlElement","id":"acm000004978jsd","name":"exists_entry","comment":"Return if the Entry exists. Check the file system to see what we should turn into first. Assume a file if there's no directory.","startLine":132,"endLine":137,"calleeNames":["disambiguate"]},"acm000004979jsd":{"type":"ControlElement","id":"acm000004979jsd","name":"exists_file","comment":"Duplicate from source path if we are set up to do this.\nAt this point, src is meant to be copied in a variant directory.\nCan't return 1 here because the duplication might\nnot actually occur if the -n option is being used.\nThe source file does not exist. Make sure no old\ncopy remains in the variant directory.\nReturn None explicitly because the Base.exists() call\nabove will have cached its value if the file existed.","startLine":140,"endLine":162,"calleeNames":["is_derived","srcnode","rfile","get_abspath","exists","do_duplicate","print","exists_base","islink","unlink","get_internal_path"]},"acm000004980jsd":{"type":"ControlElement","id":"acm000004980jsd","name":"rexists_none","comment":"","startLine":171,"endLine":172,"calleeNames":[]},"acm000004981jsd":{"type":"ControlElement","id":"acm000004981jsd","name":"rexists_node","comment":"","startLine":174,"endLine":175,"calleeNames":["exists"]},"acm000004982jsd":{"type":"ControlElement","id":"acm000004982jsd","name":"rexists_base","comment":"","startLine":177,"endLine":178,"calleeNames":["rfile","exists"]},"acm000004983jsd":{"type":"ControlElement","id":"acm000004983jsd","name":"get_contents_none","comment":"","startLine":184,"endLine":185,"calleeNames":[]},"acm000004984jsd":{"type":"ControlElement","id":"acm000004984jsd","name":"get_contents_entry","comment":"Fetch the contents of the entry. Returns the exact binary contents of the file.\nThere was nothing on disk with which to disambiguate\nthis entry. Leave it as an Entry, but return a null\nstring so calls to get_contents() in emitters and the\nlike (e.g. in qt.py) don't have to disambiguate by hand\nor catch the exception.","startLine":187,"endLine":200,"calleeNames":["disambiguate"]},"acm000004985jsd":{"type":"ControlElement","id":"acm000004985jsd","name":"get_contents_dir","comment":"Return content signatures and names of all our children separated by new-lines. Ensure that the nodes are sorted.","startLine":202,"endLine":208,"calleeNames":["sorted","children","append","get_csig","join"]},"acm000004986jsd":{"type":"ControlElement","id":"acm000004986jsd","name":"get_contents_file","comment":"","startLine":210,"endLine":221,"calleeNames":["rexists","rfile","get_abspath","open","read"]},"acm000004987jsd":{"type":"ControlElement","id":"acm000004987jsd","name":"target_from_source_none","comment":"","startLine":228,"endLine":229,"calleeNames":[]},"acm000004988jsd":{"type":"ControlElement","id":"acm000004988jsd","name":"target_from_source_base","comment":"","startLine":231,"endLine":232,"calleeNames":["Entry","splitext"]},"acm000004989jsd":{"type":"ControlElement","id":"acm000004989jsd","name":"changed_since_last_build_node","comment":"Must be overridden in a specific subclass to return True if this Node (a dependency) has changed since the last time it was used to build the specified target. prev_ni is this Node's state (for example, its file timestamp, length, maybe content signature) as of the last time the target was built. Note that this method is called through the dependency, not the target, because a dependency Node must be able to use its own logic to decide if it changed. For example, File Nodes need to obey if we're configured to use timestamps, but Python Value Nodes never use timestamps and always use the content. If this method were called through the target, then each Node's implementation of this method would have to have more complicated logic to handle all the different Node types on which it might depend.","startLine":250,"endLine":268,"calleeNames":[]},"acm000004990jsd":{"type":"ControlElement","id":"acm000004990jsd","name":"changed_since_last_build_alias","comment":"","startLine":271,"endLine":276,"calleeNames":["get_csig"]},"acm000004991jsd":{"type":"ControlElement","id":"acm000004991jsd","name":"changed_since_last_build_entry","comment":"","startLine":279,"endLine":281,"calleeNames":["disambiguate"]},"acm000004992jsd":{"type":"ControlElement","id":"acm000004992jsd","name":"changed_since_last_build_state_changed","comment":"","startLine":284,"endLine":285,"calleeNames":[]},"acm000004993jsd":{"type":"ControlElement","id":"acm000004993jsd","name":"decide_source","comment":"","startLine":288,"endLine":289,"calleeNames":["get_build_env","decide_source"]},"acm000004994jsd":{"type":"ControlElement","id":"acm000004994jsd","name":"decide_target","comment":"","startLine":292,"endLine":293,"calleeNames":["get_build_env","decide_target"]},"acm000004995jsd":{"type":"ControlElement","id":"acm000004995jsd","name":"changed_since_last_build_python","comment":"","startLine":296,"endLine":301,"calleeNames":["get_csig"]},"acm000004996jsd":{"type":"ControlElement","id":"acm000004996jsd","name":"store_info_pass","comment":"","startLine":331,"endLine":332,"calleeNames":[]},"acm000004997jsd":{"type":"ControlElement","id":"acm000004997jsd","name":"store_info_file","comment":"Merge our build information into the already-stored entry.\nThis accommodates \"chained builds\" where a file that's a target\nin one build (SConstruct file) is a source in a different build.\nSee test/chained-build.py for the use case.","startLine":334,"endLine":340,"calleeNames":["sconsign","store_info"]},"acm000004998jsd":{"type":"ControlElement","id":"acm000004998jsd","name":"get_children","comment":"","startLine":1717,"endLine":1718,"calleeNames":["children"]},"acm000004999jsd":{"type":"ControlElement","id":"acm000004999jsd","name":"ignore_cycle","comment":"","startLine":1718,"endLine":1719,"calleeNames":[]},"acm000005000jsd":{"type":"ControlElement","id":"acm000005000jsd","name":"do_nothing","comment":"","startLine":1719,"endLine":1721,"calleeNames":[]},"acm000005001jsd":{"type":"CodeCompilationUnit","id":"acm000005001jsd","name":"__init__","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThe Node package for the SCons software construction utility. This is, in many ways, the heart of SCons. A Node is where we encapsulate all of the dependency information about any thing that SCons can build, or about any thing which SCons can use to build some other thing. The canonical \"thing,\" of course, is a file, but a Node can also represent something remote (like a web page) or something completely abstract (like an Alias). Each specific type of \"thing\" is specifically represented by a subclass of the Node base class: Node.FS.File for files, Node.Alias for aliases, etc. Dependency information is kept here in the base class, and information specific to files/aliases/etc. is in the subclass. The goal, if we've done this correctly, is that any type of \"thing\" should be able to depend on any other type of \"thing.\"","parentId":"acm000005002jsd","content":["acm000004868jsd","acm000004873jsd","acm000004964jsd","acm000004966jsd","acm000004970jsd","acm000004971jsd","acm000004972jsd","acm000004973jsd","acm000004974jsd","acm000004975jsd","acm000004976jsd","acm000004977jsd","acm000004978jsd","acm000004979jsd","acm000004980jsd","acm000004981jsd","acm000004982jsd","acm000004983jsd","acm000004984jsd","acm000004985jsd","acm000004986jsd","acm000004987jsd","acm000004988jsd","acm000004989jsd","acm000004990jsd","acm000004991jsd","acm000004992jsd","acm000004993jsd","acm000004994jsd","acm000004995jsd","acm000004996jsd","acm000004997jsd","acm000004998jsd","acm000004999jsd","acm000005000jsd"],"pathElements":["Node"],"extension":"py","language":"PYTHON3","importedModuleNames":["collections","copy","itertools.chain","itertools.zip_longest","typing.Optional","SCons.Debug","SCons.Executor","SCons.Memoize","SCons.compat.NoSlotsPyPy","SCons.Debug.logInstanceCreation","SCons.Debug.Trace","SCons.Util.hash_signature","SCons.Util.is_List","SCons.Util.UniqueList","SCons.Util.render_tree","SCons.Util.sctyping.ExecutorType"]},"acm000005002jsd":{"type":"CodePackage","id":"acm000005002jsd","name":"Node","comment":"","parentId":null,"content":["acm000004265jsd","acm000004276jsd","acm000004552jsd","acm000004696jsd","acm000004824jsd","acm000004843jsd","acm000004861jsd","acm000005001jsd"]},"acm000005003jsd":{"type":"ControlElement","id":"acm000005003jsd","name":"get_xlc","comment":"Use the AIX package installer tool lslpp to figure out where a\ngiven xl* compiler is installed and what version it is.","startLine":38,"endLine":67,"calleeNames":["get","is_List","scons_subproc_run","splitlines","split","endswith","rpartition"]},"acm000005004jsd":{"type":"ControlElement","id":"acm000005004jsd","name":"generate","comment":"Based on AIX 5.2: ARG_MAX=24576 - 3000 for environment expansion","startLine":69,"endLine":74,"calleeNames":["generate"]},"acm000005005jsd":{"type":"CodeCompilationUnit","id":"acm000005005jsd","name":"aix","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nPlatform-specific initialization for IBM AIX systems. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Platform.Platform() selection method.","parentId":"acm000005102jsd","content":["acm000005003jsd","acm000005004jsd"],"pathElements":["Platform"],"extension":"py","language":"PYTHON3","importedModuleNames":["subprocess.PIPE","posix","SCons.Util","SCons.Action"]},"acm000005006jsd":{"type":"ControlElement","id":"acm000005006jsd","name":"generate","comment":"","startLine":43,"endLine":56,"calleeNames":["generate"]},"acm000005007jsd":{"type":"CodeCompilationUnit","id":"acm000005007jsd","name":"cygwin","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nPlatform-specific initialization for Cygwin systems. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Platform.Platform() selection method.","parentId":"acm000005102jsd","content":["acm000005006jsd"],"pathElements":["Platform"],"extension":"py","language":"PYTHON3","importedModuleNames":["sys","posix","SCons.Platform.TempFileMunge"]},"acm000005008jsd":{"type":"ControlElement","id":"acm000005008jsd","name":"generate","comment":"","startLine":35,"endLine":65,"calleeNames":["generate","listdir","append","isfile","open","readlines","AppendENVPath","strip","get"]},"acm000005009jsd":{"type":"CodeCompilationUnit","id":"acm000005009jsd","name":"darwin","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice 