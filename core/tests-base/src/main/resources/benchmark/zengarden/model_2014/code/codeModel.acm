me":"MessageNotein::toString()","comment":"","startLine":54,"endLine":56,"calleeNames":[]},"acm000001781jsd":{"type":"ControlElement","id":"acm000001781jsd","name":"MessageNotein::getObjectType()","comment":"","startLine":58,"endLine":60,"calleeNames":[]},"acm000001782jsd":{"type":"CodeAssembly","id":"acm000001782jsd","name":"MessageNotein","comment":null,"parentId":null,"content":["acm000001778jsd","acm000001779jsd","acm000001780jsd","acm000001781jsd"],"language":"CPP","importedModuleNames":[]},"acm000001783jsd":{"type":"ClassUnit","id":"acm000001783jsd","name":"MessageNotEquals","comment":"Copyright 2009,2010 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.  You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.\n[!=], [!= float]","compilationUnitId":null,"parentDatatypeId":null,"startLine":29,"endLine":44,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001784jsd":{"type":"ControlElement","id":"acm000001784jsd","name":"*MessageNotEquals::getObjectLabel()","comment":"","startLine":46,"endLine":48,"calleeNames":[]},"acm000001785jsd":{"type":"CodeAssembly","id":"acm000001785jsd","name":"MessageNotEquals","comment":null,"parentId":null,"content":["acm000001783jsd","acm000001784jsd"],"language":"CPP","importedModuleNames":[]},"acm000001786jsd":{"type":"ControlElement","id":"acm000001786jsd","name":"*getObjectLabel()","comment":"The generic entrypoint of a message to an object. This function usually either passes the message directly to <code>processMessage</code> in the case of an object which only processes messages, or queues the message for later processing.\nThe message logic of an object.\nSends the given message to all connected objects at the given outlet index. This function can be overridden in order to take some other action, such as additionally scheduling a new message as in the case of <code>MessageMetro</code>.\nReturns the connection type of the given outlet.\nEstablish a connection from another object to this object.\nEstablish a connection to another object from this object.\nRemove a connection from another object to this object. This function does not remove the  connection reference at the connecting object. It must be removed separately.\nRemove a connection to another object from this object. This function does not remove the  connection reference at the connecting object. It must be removed separately.\nThe destination inlet of an outgoing message connection can change if an [inlet] object in a graph is moved (and the inlet ordering changes). The connection index change has no effect on the graph ordering and thus it is not necessary to remove and readd a connection. However, the connection must be updated such that message will still be addressed to the correct inlet.\nReturns the label for this object.","startLine":105,"endLine":105,"calleeNames":[]},"acm000001787jsd":{"type":"ControlElement","id":"acm000001787jsd","name":"toString()","comment":"","startLine":106,"endLine":106,"calleeNames":[]},"acm000001788jsd":{"type":"ControlElement","id":"acm000001788jsd","name":"doesProcessAudio()","comment":"Returns <code>true</code> if this object processes audio, <code>false</code> otherwise.","startLine":111,"endLine":111,"calleeNames":[]},"acm000001789jsd":{"type":"ClassUnit","id":"acm000001789jsd","name":"MessageObject","commen