rily remember the env here,\nand CommandGeneratorAction will use this env\nwhen it calls its _generate method.","startLine":592,"endLine":602,"calleeNames":["str","split"]},"acm000002780jsd":{"type":"ControlElement","id":"acm000002780jsd","name":"get_varlist","comment":"","startLine":604,"endLine":605,"calleeNames":[]},"acm000002781jsd":{"type":"ControlElement","id":"acm000002781jsd","name":"get_targets","comment":"Returns the type of targets ($TARGETS, $CHANGED_TARGETS) used by this action.","startLine":607,"endLine":612,"calleeNames":[]},"acm000002782jsd":{"type":"ClassUnit","id":"acm000002782jsd","name":"ActionBase","comment":"Base class for all types of action objects that can be held by other objects (Builders, Executors, etc.) This provides the common methods for manipulating and combining those actions.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":516,"endLine":612,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002770jsd","acm000002771jsd","acm000002772jsd","acm000002773jsd","acm000002774jsd","acm000002775jsd","acm000002776jsd","acm000002777jsd","acm000002778jsd","acm000002779jsd","acm000002780jsd","acm000002781jsd"]},"acm000002783jsd":{"type":"ControlElement","id":"acm000002783jsd","name":"__init__","comment":"","startLine":617,"endLine":645,"calleeNames":["callable","id","AddMethod"]},"acm000002784jsd":{"type":"ControlElement","id":"acm000002784jsd","name":"print_cmd_line","comment":"In python 3, and in some of our tests, sys.stdout is a String io object, and it takes unicode strings only This code assumes s is a regular string.","startLine":647,"endLine":653,"calleeNames":["write"]},"acm000002785jsd":{"type":"ControlElement","id":"acm000002785jsd","name":"__call__","comment":"","startLine":522,"endLine":534,"calleeNames":[]},"acm000002786jsd":{"type":"ControlElement","id":"acm000002786jsd","name":"get_presig","comment":"","startLine":548,"endLine":549,"calleeNames":[]},"acm000002787jsd":{"type":"ControlElement","id":"acm000002787jsd","name":"get_implicit_deps","comment":"","startLine":552,"endLine":553,"calleeNames":[]},"acm000002788jsd":{"type":"ClassUnit","id":"acm000002788jsd","name":"_ActionAction","comment":"Base class for actions that create output objects.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":615,"endLine":749,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002783jsd","acm000002784jsd","acm000002785jsd","acm000002786jsd","acm000002787jsd"]},"acm000002789jsd":{"type":"ControlElement","id":"acm000002789jsd","name":"__init__","comment":"","startLine":617,"endLine":645,"calleeNames":["callable","id","AddMethod"]},"acm000002790jsd":{"type":"ControlElement","id":"acm000002790jsd","name":"__str__","comment":"","startLine":1007,"endLine":1010,"calleeNames":["is_List","join","map","str"]},"acm000002791jsd":{"type":"ControlElement","id":"acm000002791jsd","name":"process","comment":"","startLine":1013,"endLine":1032,"calleeNames":["subst_list"]},"acm000002792jsd":{"type":"ControlElement","id":"acm000002792jsd","name":"strfunction","comment":"","startLine":1034,"endLine":1047,"calleeNames":["subst","process","_string_from_cmd_list"]},"acm000002793jsd":{"type":"ControlElement","id":"acm000002793jsd","name":"execute","comment":"Execute a command action. This will handle lists of commands as well as individual commands, because construction variable substitution may turn a single \"command\" into a list. This means that this class can actually handle lists of commands, even though that's not how we use it externally.","startLine":1049,"endLine":1109,"calleeNames":["UserError","is_String","subst","get","_resolve_shell_env","items","is_List","flatten_sequence","join","map","str","get_all_targets","get_all_sources","process","list","filter","escape_list","spawn","BuildError"]},"acm000002794jsd":{"type":"ControlElement","id":"acm000002794jsd","name":"get_presig","comment":"","startLine":548,"endLine":549,"calleeNames":[]},"acm000002795jsd":{"type":"ControlElement","id":"acm000002795jsd","name":"get_implicit_deps","comment":"","startLine":552,"endLine":553,"calleeNames":[]},"acm000002796jsd":{"type":"ControlElement","id":"acm000002796jsd","name":"_get_implicit_deps_lightweight","comment":"Lightweight dependency scanning involves only scanning the first entry in an action string, even if it contains &&.","startLine":1148,"endLine":1167,"calleeNames":["subst_list","str","match","group","WhereIs","append","File"]},"acm000002797jsd":{"type":"ControlElement","id":"acm000002797jsd","name":"_get_implicit_deps_heavyweight","comment":"Heavyweight dependency scanning involves scanning more than just the first entry in an action string. The exact behavior depends on the value of icd_int. Only files are taken as implicit dependencies; directories are ignored. If icd_int is an integer value, it specifies the number of entries to scan for implicit dependencies. Action strings are also scanned after a &&. So for example, if icd_int=2 and the action string is \"cd <some_dir> && $PYTHON $SCRIPT_PATH <another_path>\", the implicit dependencies would be the path to the python binary and the path to the script. If icd_int is None, all entries are scanned for implicit dependencies.\nAvoid circular and duplicate dependencies by not providing source,\ntarget, or executor to subst_list. This causes references to\n$SOURCES, $TARGETS, and all related variables to disappear.","startLine":1169,"endLine":1225,"calleeNames":["subst_list","str","startswith","match","group","abspath","isfile","WhereIs","append","File"]},"acm000002798jsd":{"type":"ClassUnit","id":"acm000002798jsd","name":"CommandAction","comment":"Class for command-execution actions.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":986,"endLine":1225,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002789jsd","acm000002790jsd","acm000002791jsd","acm000002792jsd","acm000002793jsd","acm000002794jsd","acm000002795jsd","acm000002796jsd","acm000002797jsd"]},"acm000002799jsd":{"type":"ControlElement","id":"acm000002799jsd","name":"__init__","comment":"","startLine":617,"endLine":645,"calleeNames":["callable","id","AddMethod"]},"acm000002800jsd":{"type":"ControlElement","id":"acm000002800jsd","name":"_generate","comment":"ensure that target is a list, to make it easier to write\ngenerator functions:","startLine":1237,"endLine":1253,"calleeNames":["is_List","get_all_targets","get_all_sources","generator","Action","UserError","repr"]},"acm000002801jsd":{"type":"ControlElement","id":"acm000002801jsd","name":"__str__","comment":"","startLine":1007,"endLine":1010,"calleeNames":["is_List","join","map","str"]},"acm000002802jsd":{"type":"ControlElement","id":"acm000002802jsd","name":"batch_key","comment":"","startLine":1265,"endLine":1266,"calleeNames":["_generate","batch_key"]},"acm000002803jsd":{"type":"ControlElement","id":"acm000002803jsd","name":"genstring","comment":"","startLine":544,"endLine":545,"calleeNames":["str"]},"acm000002804jsd":{"type":"ControlElement","id":"acm000002804jsd","name":"__call__","comment":"","startLine":522,"endLine":534,"calleeNames":[]},"acm000002805jsd":{"type":"ControlElement","id":"acm000002805jsd","name":"get_presig","comment":"","startLine":548,"endLine":549,"calleeNames":[]},"acm000002806jsd":{"type":"ControlElement","id":"acm000002806jsd","name":"get_implicit_deps","comment":"","startLine":552,"endLine":553,"calleeNames":[]},"acm000002807jsd":{"type":"ControlElement","id":"acm000002807jsd","name":"get_varlist","comment":"","startLine":604,"endLine":605,"calleeNames":[]},"acm000002808jsd":{"type":"ControlElement","id":"acm000002808jsd","name":"get_targets","comment":"Returns the type of targets ($TARGETS, $CHANGED_TARGETS) used by this action.","startLine":607,"endLine":612,"calleeNames":[]},"acm000002809jsd":{"type":"ClassUnit","id":"acm000002809jsd","name":"CommandGeneratorAction","comment":"Class for command-generator actions.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":1228,"endLine":1299,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002799jsd","acm000002800jsd","acm000002801jsd","acm000002802jsd","acm000002803jsd","acm000002804jsd","acm000002805jsd","acm000002806jsd","acm000002807jsd","acm000002808jsd"]},"acm000002810jsd":{"type":"ControlElement","id":"acm000002810jsd","name":"__init__","comment":"","startLine":617,"endLine":645,"calleeNames":["callable","id","AddMethod"]},"acm000002811jsd":{"type":"ControlElement","id":"acm000002811jsd","name":"get_parent_class","comment":"","startLine":1328,"endLine":1332,"calleeNames":["get","is_String"]},"acm000002812jsd":{"type":"ControlElement","id":"acm000002812jsd","name":"_generate_cache","comment":"","startLine":1334,"endLine":1342,"calleeNames":["get","Action","UserError","repr"]},"acm000002813jsd":{"type":"ControlElement","id":"acm000002813jsd","name":"_generate","comment":"ensure that target is a list, to make it easier to write\ngenerator functions:","startLine":1237,"endLine":1253,"calleeNames":["is_List","get_all_targets","get_all_sources","generator","Action","UserError","repr"]},"acm000002814jsd":{"type":"ControlElement","id":"acm000002814jsd","name":"__call__","comment":"","startLine":522,"endLine":534,"calleeNames":[]},"acm000002815jsd":{"type":"ControlElement","id":"acm000002815jsd","name":"get_presig","comment":"","startLine":548,"endLine":549,"calleeNames":[]},"acm000002816jsd":{"type":"ControlElement","id":"acm000002816jsd","name":"get_implicit_deps","comment":"","startLine":552,"endLine":553,"calleeNames":[]},"acm000002817jsd":{"type":"ControlElement","id":"acm000002817jsd","name":"get_varlist","comment":"","startLine":604,"endLine":605,"calleeNames":[]},"acm000002818jsd":{"type":"ClassUnit","id":"acm000002818jsd","name":"LazyAction","comment":"A LazyAction is a kind of hybrid generator and command action for strings of the form \"$VAR\". These strings normally expand to other strings (think \"$CCCOM\" to \"$CC -c -o $TARGET $SOURCE\"), but we also want to be able to replace them with functions in the construction environment. Consequently, we want lazy evaluation and creation of an Action in the case of the function, but that's overkill in the more normal case of expansion to other strings. So we do this with a subclass that's both a generator *and* a command action. The overridden methods all do a quick check of the construction variable, and if it's a string we just call the corresponding CommandAction method to do the heavy lifting. If not, then we call the same-named CommandGeneratorAction method. The CommandGeneratorAction methods work by using the overridden _generate() method, that is, our own way of handling \"generation\" of an action based on what's in the construction variable.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":1302,"endLine":1361,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002810jsd","acm000002811jsd","acm000002812jsd","acm000002813jsd","acm000002814jsd","acm000002815jsd","acm000002816jsd","acm000002817jsd"]},"acm000002819jsd":{"type":"ControlElement","id":"acm000002819jsd","name":"__init__","comment":"","startLine":617,"endLine":645,"calleeNames":["callable","id","AddMethod"]},"acm000002820jsd":{"type":"ControlElement","id":"acm000002820jsd","name":"function_name","comment":"","startLine":1383,"endLine":1390,"calleeNames":[]},"acm000002821jsd":{"type":"ControlElement","id":"acm000002821jsd","name":"strfunction","comment":"","startLine":1034,"endLine":1047,"calleeNames":["subst","process","_string_from_cmd_list"]},"acm000002822jsd":{"type":"ControlElement","id":"acm000002822jsd","name":"__str__","comment":"","startLine":1007,"endLine":1010,"calleeNames":["is_List","join","map","str"]},"acm000002823jsd":{"type":"ControlElement","id":"acm000002823jsd","name":"execute","comment":"Execute a command action. This will handle lists of commands as well as individual commands, because construction variable substitution may turn a single \"command\" into a list. This means that this class can actually handle lists of commands, even though that's not how we use it externally.","startLine":1049,"endLine":1109,"calleeNames":["UserError","is_String","subst","get","_resolve_shell_env","items","is_List","flatten_sequence","join","map","str","get_all_targets","get_all_sources","process","list","filter","escape_list","spawn","BuildError"]},"acm000002824jsd":{"type":"ControlElement","id":"acm000002824jsd","name":"get_presig","comment":"","startLine":548,"endLine":549,"calleeNames":[]},"acm000002825jsd":{"type":"ControlElement","id":"acm000002825jsd","name":"get_implicit_deps","comment":"","startLine":552,"endLine":553,"calleeNames":[]},"acm000002826jsd":{"type":"ClassUnit","id":"acm000002826jsd","name":"FunctionAction","comment":"Class for Python function actions.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":1364,"endLine":1482,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002819jsd","acm000002820jsd","acm000002821jsd","acm000002822jsd","acm000002823jsd","acm000002824jsd","acm000002825jsd"]},"acm000002827jsd":{"type":"ControlElement","id":"acm000002827jsd","name":"__init__","comment":"","startLine":617,"endLine":645,"calleeNames":["callable","id","AddMethod"]},"acm000002828jsd":{"type":"ControlElement","id":"acm000002828jsd","name":"genstring","comment":"","startLine":544,"endLine":545,"calleeNames":["str"]},"acm000002829jsd":{"type":"ControlElement","id":"acm000002829jsd","name":"__str__","comment":"","startLine":1007,"endLine":1010,"calleeNames":["is_List","join","map","str"]},"acm000002830jsd":{"type":"ControlElement","id":"acm000002830jsd","name":"presub_lines","comment":"CommandGeneratorAction needs a real environment\nin order to return the proper string here, since\nit may call LazyAction, which looks up a key\nin that env. So we temporarily remember the env here,\nand CommandGeneratorAction will use this env\nwhen it calls its _generate method.","startLine":592,"endLine":602,"calleeNames":["str","split"]},"acm000002831jsd":{"type":"ControlElement","id":"acm000002831jsd","name":"get_presig","comment":"","startLine":548,"endLine":549,"calleeNames":[]},"acm000002832jsd":{"type":"ControlElement","id":"acm000002832jsd","name":"__call__","comment":"","startLine":522,"endLine":534,"calleeNames":[]},"acm000002833jsd":{"type":"ControlElement","id":"acm000002833jsd","name":"get_implicit_deps","comment":"","startLine":552,"endLine":553,"calleeNames":[]},"acm000002834jsd":{"type":"ControlElement","id":"acm000002834jsd","name":"get_varlist","comment":"","startLine":604,"endLine":605,"calleeNames":[]},"acm000002835jsd":{"type":"ClassUnit","id":"acm000002835jsd","name":"ListAction","comment":"Class for lists of other actions.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":1484,"endLine":1538,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002827jsd","acm000002828jsd","acm000002829jsd","acm000002830jsd","acm000002831jsd","acm000002832jsd","acm000002833jsd","acm000002834jsd"]},"acm000002836jsd":{"type":"ControlElement","id":"acm000002836jsd","name":"__init__","comment":"","startLine":617,"endLine":645,"calleeNames":["callable","id","AddMethod"]},"acm000002837jsd":{"type":"ControlElement","id":"acm000002837jsd","name":"get_contents","comment":"","startLine":555,"endLine":584,"calleeNames":["get_presig","isinstance","bytearray","get_varlist","is_String","extend","to_bytes","subst_target_source","Exception","type"]},"acm000002838jsd":{"type":"ControlElement","id":"acm000002838jsd","name":"subst","comment":"If s is a list, recursively apply subst()\nto every element in the list\nSpecial-case hack: Let a custom function wrapped in an\nActionCaller get at the environment through which the action\nwas called by using this hard-coded value as a special return.","startLine":1571,"endLine":1588,"calleeNames":["is_List","append","subst","convert","is_String"]},"acm000002839jsd":{"type":"ControlElement","id":"acm000002839jsd","name":"subst_args","comment":"","startLine":1590,"endLine":1591,"calleeNames":["subst"]},"acm000002840jsd":{"type":"ControlElement","id":"acm000002840jsd","name":"subst_kw","comment":"","startLine":1593,"endLine":1597,"calleeNames":["list","keys","subst"]},"acm000002841jsd":{"type":"ControlElement","id":"acm000002841jsd","name":"__call__","comment":"","startLine":522,"endLine":534,"calleeNames":[]},"acm000002842jsd":{"type":"ControlElement","id":"acm000002842jsd","name":"strfunction","comment":"","startLine":1034,"endLine":1047,"calleeNames":["subst","process","_string_from_cmd_list"]},"acm000002843jsd":{"type":"ControlElement","id":"acm000002843jsd","name":"__str__","comment":"","startLine":1007,"endLine":1010,"calleeNames":["is_List","join","map","str"]},"acm000002844jsd":{"type":"ClassUnit","id":"acm000002844jsd","name":"ActionCaller","comment":"A class for delaying calling an Action function with specific (positional and keyword) arguments until the Action is actually executed. This class looks to the rest of the world like a normal Action object, but what it's really doing is hanging on to the arguments until we have a target, source and env to use for the expansion.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":1541,"endLine":1610,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002836jsd","acm000002837jsd","acm000002838jsd","acm000002839jsd","acm000002840jsd","acm000002841jsd","acm000002842jsd","acm000002843jsd"]},"acm000002845jsd":{"type":"ControlElement","id":"acm000002845jsd","name":"__init__","comment":"","startLine":617,"endLine":645,"calleeNames":["callable","id","AddMethod"]},"acm000002846jsd":{"type":"ControlElement","id":"acm000002846jsd","name":"__call__","comment":"","startLine":522,"endLine":534,"calleeNames":[]},"acm000002847jsd":{"type":"ClassUnit","id":"acm000002847jsd","name":"ActionFactory","comment":"A factory class that will wrap up an arbitrary function as an SCons-executable Action object. The real heavy lifting here is done by the ActionCaller class. We just collect the (positional and keyword) arguments that we're called with and give them to the ActionCaller object we create, so it can hang onto them until it needs them.","compilationUnitId":"acm000002865jsd","parentDatatypeId":null,"startLine":1613,"endLine":1630,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002845jsd","acm000002846jsd"]},"acm000002848jsd":{"type":"ControlElement","id":"acm000002848jsd","name":"rfile","comment":"","startLine":138,"endLine":142,"calleeNames":["rfile"]},"acm000002849jsd":{"type":"ControlElement","id":"acm000002849jsd","name":"default_exitstatfunc","comment":"","startLine":145,"endLine":146,"calleeNames":[]},"acm000002850jsd":{"type":"ControlElement","id":"acm000002850jsd","name":"_callable_contents","comment":"Return the signature contents of a callable Python object.\nTest if obj is a method.\nTest if obj is a callable object.\nTest if obj is a code object.\nTest if obj is a function object.","startLine":151,"endLine":169,"calleeNames":["_function_contents","_code_contents"]},"acm000002851jsd":{"type":"ControlElement","id":"acm000002851jsd","name":"_object_contents","comment":"Return the signature contents of any Python object. We have to handle the case where object contains a code object since it can be pickled directly.\nTest if obj is a method.\nTest if obj is a callable object.\nTest if obj is a code object.\nTest if obj is a function object.\nShould be a pickle-able Python object.\npickling an Action instance or object doesn't yield a stable\ncontent as instance property may be dumped in different orders\nreturn pickle.dumps(obj, ACTION_SIGNATURE_PICKLE_PROTOCOL)\nThis is weird, but it seems that nested classes\nare unpickable. The Python docs say it should\nalways be a PicklingError, but some Python\nversions seem to return TypeError. Just do\nthe best we can.\nTODO: docstrings for _code_contents and _function_contents\ndo not render well with Sphinx. Consider reworking.","startLine":172,"endLine":210,"calleeNames":["_function_contents","_code_contents","_object_instance_content","bytearray","repr"]},"acm000002852jsd":{"type":"ControlElement","id":"acm000002852jsd","name":"_code_contents","comment":"contents = []\nThe code contents depends on the number of local variables\nbut not their actual names.","startLine":215,"endLine":281,"calleeNames":["bytearray","extend","str","len","_object_contents","join"]},"acm000002853jsd":{"type":"ControlElement","id":"acm000002853jsd","name":"_function_contents","comment":"Return the signature contents of a function. The signature is as follows (should be byte/chars): < _code_contents (see above) from func.__code__ > ,( comma separated _object_contents for function argument defaults) ,( comma separated _object_contents for any closure contents ) See also: https://docs.python.org/3/reference/datamodel.html - func.__code__ - The code object representing the compiled function body. - func.__defaults__ - A tuple containing default argument values for those arguments that have defaults, or None if no arguments have a default value - func.__closure__ - None or a tuple of cells that contain bindings for the function's free variables.","startLine":284,"endLine":326,"calleeNames":["_code_contents","_object_contents","bytearray","extend","join","append"]},"acm000002854jsd":{"type":"ControlElement","id":"acm000002854jsd","name":"_object_instance_content","comment":"Returns consistant content for a action class or an instance thereof :Parameters: - `obj` Should be either and action class or an instance thereof :Returns: bytearray or bytes representing the obj suitable for generating a signature from.","startLine":329,"endLine":379,"calleeNames":["bytearray","isinstance","to_bytes","repr","getclasstree","getattr","dir","ismethod","isbuiltin","sort","join","_function_contents","append","extend"]},"acm000002855jsd":{"type":"ControlElement","id":"acm000002855jsd","name":"_actionAppend","comment":"Joins two actions together. Mainly, it handles ListActions by concatenating into a single ListAction.","startLine":388,"endLine":407,"calleeNames":["Action","isinstance","ListAction"]},"acm000002856jsd":{"type":"ControlElement","id":"acm000002856jsd","name":"_do_create_keywords","comment":"This converts any arguments after the action argument into their equivalent keywords and adds them to the kw argument.","startLine":410,"endLine":435,"calleeNames":["get","is_String","tuple","callable","UserError","len","flatten"]},"acm000002857jsd":{"type":"ControlElement","id":"acm000002857jsd","name":"_do_create_action","comment":"The internal implementation for the Action factory method. This handles the fact that passing lists to :func:`Action` itself has different semantics than passing lists as elements of lists. The former will create a :class:`ListAction`, the latter will create a :class:`CommandAction` by converting the inner list elements to strings.\nThis looks like a string that is purely an Environment\nvariable reference, like \"$FOO\" or \"${FOO}\". We do\nsomething special here...we lazily evaluate the contents\nof that Environment variable, so a user could put something\nlike a function or a CommandGenerator in that variable\ninstead of a string.\nThe list of string commands may include a LazyAction, so we\nreprocess them via _do_create_list_action.\nCatch a common error case with a nice message:\nElse fail silently (???)\nTODO: from __future__ import annotations once we get to Python 3.7 base,\nto avoid quoting the defined-later classname","startLine":438,"endLine":481,"calleeNames":["isinstance","is_String","get_environment_var","LazyAction","str","split","len","CommandAction","_do_create_list_action","is_List","callable","pop","action_type","TypeError"]},"acm000002858jsd":{"type":"ControlElement","id":"acm000002858jsd","name":"_do_create_list_action","comment":"A factory for list actions. Convert the input list *act* into Actions and then wrap them in a :class:`ListAction`. If *act* has only a single member, return that member, not a *ListAction*. This is intended to allow a contained list to specify a command action without being processed into a list action.","startLine":486,"endLine":504,"calleeNames":["_do_create_action","append","ListAction","len"]},"acm000002859jsd":{"type":"ControlElement","id":"acm000002859jsd","name":"Action","comment":"A factory for action objects.\nReally simple: the _do_create_* routines do the heavy lifting.","startLine":507,"endLine":513,"calleeNames":["_do_create_keywords","is_List","_do_create_list_action","_do_create_action"]},"acm000002860jsd":{"type":"ControlElement","id":"acm000002860jsd","name":"_string_from_cmd_list","comment":"Takes a list of command line arguments and returns a pretty representation for printing.","startLine":752,"endLine":760,"calleeNames":["map","append","join"]},"acm000002861jsd":{"type":"ControlElement","id":"acm000002861jsd","name":"get_default_ENV","comment":"Returns an execution environment. If there is one in *env*, just use it, else return the Default Environment, insantiated if necessary. A fiddlin' little function that has an ``import SCons.Environment`` which cannot be moved to the top level without creating an import loop. Since this import creates a local variable named ``SCons``, it blocks access to the global variable, so we move it here to prevent complaints about local variables being used uninitialized.\npylint: disable=import-outside-toplevel,redefined-outer-name\nThis is a hideously expensive way to get a default execution\nenvironment. What it really should do is run the platform\nsetup to get the default ENV. Fortunately, it's incredibly\nrare for an Environment not to have an execution environment,\nso we're not going to worry about it overmuch.","startLine":765,"endLine":790,"calleeNames":["Environment"]},"acm000002862jsd":{"type":"ControlElement","id":"acm000002862jsd","name":"_resolve_shell_env","comment":"Returns a resolved execution environment. First get the execution environment. Then if ``SHELL_ENV_GENERATORS`` is set and is iterable, call each function to allow it to alter the created execution environment, passing each the returned execution environment from the previous call. .. versionadded:: 4.4","startLine":793,"endLine":817,"calleeNames":["get_default_ENV","get","iter","UserError","copy","generator","isinstance"]},"acm000002863jsd":{"type":"ControlElement","id":"acm000002863jsd","name":"scons_subproc_run","comment":"Run an external command using an SCons execution environment. SCons normally runs external build commands using :mod:`subprocess`, but does not harvest any output from such commands. This function is a thin wrapper around :func:`subprocess.run` allowing running a command in an SCons context (i.e. uses an \"execution environment\" rather than the user's existing environment), and provides the ability to return any output in a :class:`subprocess.CompletedProcess` instance (this must be selected by setting ``stdout`` and/or ``stderr`` to ``PIPE``, or setting ``capture_output=True`` - see Keyword Arguments). Typical use case is to run a tool's \"version\" option to find out the installed version. If supplied, the ``env`` keyword argument provides an execution environment to process into appropriate form before it is supplied to :mod:`subprocess`; if omitted, *scons_env* is used to derive a suitable default. The other keyword arguments are passed through, except that the SCons legacy ``error`` keyword is remapped to the subprocess ``check`` keyword; if both are omitted ``check=False`` will be passed. The caller is responsible for setting up the desired arguments for :func:`subprocess.run`. This function retains the legacy behavior of returning something vaguely usable even in the face of complete failure, unless ``check=True`` (in which case an error is allowed to be raised): it synthesizes a :class:`~subprocess.CompletedProcess` instance in this case. A subset of interesting keyword arguments follows; see the Python documentation of :mod:`subprocess` for the complete list. Keyword Arguments: stdout: (and *stderr*, *stdin*) if set to :const:`subprocess.PIPE`. send input to or collect output from the relevant stream in the subprocess; the default ``None`` does no redirection (i.e. output or errors may go to the console or log file, but is not captured); if set to :const:`subprocess.DEVNULL` they are explicitly thrown away. ``capture_output=True`` is a synonym for setting both ``stdout`` and ``stderr`` to :const:`~subprocess.PIPE`. text: open *stdin*, *stdout*, *stderr* in text mode. Default is binary mode. ``universal_newlines`` is a synonym. encoding: specifies an encoding. Changes to text mode. errors: specified error handling. Changes to text mode. input: a byte sequence to be passed to *stdin*, unless text mode is enabled, in which case it must be a string. shell: if true, the command is executed through the shell. check: if true and the subprocess exits with a non-zero exit code, raise a :exc:`subprocess.CalledProcessError` exception. Otherwise (the default) in case of an :exc:`OSError`, report the exit code in the :class:`~Subprocess.CompletedProcess` instance. .. versionadded:: 4.6\nFigure out the execution environment to use","startLine":820,"endLine":919,"calleeNames":["get","get_default_ENV","sanitize_shell_env","ValueError","pop","run","join","CompletedProcess"]},"acm000002864jsd":{"type":"ControlElement","id":"acm000002864jsd","name":"_subproc","comment":"Wrapper for subprocess.Popen which pulls from construction env. Use for calls to subprocess which need to interpolate values from an SCons construction environment into the environment passed to subprocess. Adds an an error-handling argument. Adds ability to specify std{in,out,err} with \"'devnull'\" tag. .. deprecated:: 4.6\nTODO: just uses subprocess.DEVNULL now, we can drop the \"devnull\"\nstring now - it is a holdover from Py2, which didn't have DEVNULL.\nFigure out what execution environment to use","startLine":922,"endLine":983,"calleeNames":["get","is_String","get_default_ENV","sanitize_shell_env","Popen","iter","f","dummyPopen","items","ismethod","getattr","close"]},"acm000002865jsd":{"type":"CodeCompilationUnit","id":"acm000002865jsd","name":"Action","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons Actions. Information about executing any sort of action that can build one or more target Nodes (typically files) from one or more source Nodes (also typically files) given a specific Environment. The base class here is ActionBase. The base class supplies just a few utility methods and some generic methods for displaying information about an Action in response to the various commands that control printing. A second-level base class is _ActionAction. This extends ActionBase by providing the methods that can be used to show and perform an action. True Action objects will subclass _ActionAction; Action factory class objects will subclass ActionBase. The heavy lifting is handled by subclasses for the different types of actions we might execute: CommandAction CommandGeneratorAction FunctionAction ListAction The subclasses supply the following public interface methods used by other modules: __call__() THE public interface, \"calling\" an Action object executes the command or Python function. This also takes care of printing a pre-substitution command for debugging purposes. get_contents() Fetches the \"contents\" of an Action for signature calculation plus the varlist. This is what gets checksummed to decide if a target needs to be rebuilt because its action changed. genstring() Returns a string representation of the Action *without* command substitution, but allows a CommandGeneratorAction to generate the right action based on the specified target, source and env. This is used by the Signature subsystem (through the Executor) to obtain an (imprecise) representation of the Action operation for informative purposes. Subclasses also supply the following methods for internal use within this module: __str__() Returns a string approximation of the Action; no variable substitution is performed. execute() The internal method that really, truly, actually handles the execution of a command or Python function. This is used so that the __call__() methods can take care of displaying any pre-substitution representations, and *then* execute an action without worrying about the specific Actions involved. get_presig() Fetches the \"contents\" of a subclass for signature calculation. The varlist is added to this to produce the Action's contents. TODO(?): Change this to always return bytes and not str? strfunction() Returns a substituted string representation of the Action. This is used by the _ActionAction.show() command to display the command/function that will be executed to generate the target(s). There is a related independent ActionCaller class that looks like a regular Action, and which serves as a wrapper for arbitrary functions that we want to let the user specify the arguments to now, but actually execute later (when an out-of-date check determines that it's needed to be executed, for example). Objects of this class are returned by an ActionFactory class that provides a __call__() method as a convenient way for wrapping up the functions.\nwe use these a lot, so try to optimize them","parentId":"acm000004231jsd","content":["acm000002769jsd","acm000002782jsd","acm000002788jsd","acm000002798jsd","acm000002809jsd","acm000002818jsd","acm000002826jsd","acm000002835jsd","acm000002844jsd","acm000002847jsd","acm000002848jsd","acm000002849jsd","acm000002850jsd","acm000002851jsd","acm000002852jsd","acm000002853jsd","acm000002854jsd","acm000002855jsd","acm000002856jsd","acm000002857jsd","acm000002858jsd","acm000002859jsd","acm000002860jsd","acm000002861jsd","acm000002862jsd","acm000002863jsd","acm000002864jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["inspect","os","pickle","re","subprocess","sys","abc.ABC","abc.abstractmethod","collections.OrderedDict","subprocess.DEVNULL","subprocess.PIPE","typing.List","typing.Optional","typing.Tuple","SCons.Debug","SCons.Errors","SCons.Subst","SCons.Util","SCons.Debug.logInstanceCreation","SCons.Subst.SUBST_CMD","SCons.Subst.SUBST_RAW","SCons.Subst.SUBST_SIG","SCons.Util.is_String","SCons.Util.is_List","SCons.Util.sctyping.ExecutorType"]},"acm000002866jsd":{"type":"ControlElement","id":"acm000002866jsd","name":"__call__","comment":"Initial setup of the common environment for all tests,\na temporary working directory containing a\nscript for writing arguments to an output file.\n\nWe don't do this as a setUp() method because it's\nunnecessary to create a separate directory and script\nfor each test, they can just use the one.","startLine":35,"endLine":36,"calleeNames":[]},"acm000002867jsd":{"type":"ClassUnit","id":"acm000002867jsd","name":"GlobalActFunc","comment":"","compilationUnitId":"acm000002966jsd","parentDatatypeId":null,"startLine":34,"endLine":36,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002866jsd"]},"acm000002868jsd":{"type":"ControlElement","id":"acm000002868jsd","name":"__init__","comment":"","startLine":112,"endLine":114,"calleeNames":["str"]},"acm000002869jsd":{"type":"ControlElement","id":"acm000002869jsd","name":"is_literal","comment":"","startLine":116,"endLine":117,"calleeNames":[]},"acm000002870jsd":{"type":"ControlElement","id":"acm000002870jsd","name":"escape","comment":"Escape the string with the supplied function. The function is expected to take an arbitrary string, then return it with all special characters escaped and ready for passing to the command interpreter. After calling this function, the next call to str() will return the escaped string.","startLine":119,"endLine":135,"calleeNames":["is_literal","escape_func"]},"acm000002871jsd":{"type":"ClassUnit","id":"acm000002871jsd","name":"CmdStringHolder","comment":"","compilationUnitId":"acm000002966jsd","parentDatatypeId":null,"startLine":111,"endLine":135,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002868jsd","acm000002869jsd","acm000002870jsd"]},"acm000002872jsd":{"type":"ControlElement","id":"acm000002872jsd","name":"__init__","comment":"","startLine":112,"endLine":114,"calleeNames":["str"]},"acm000002873jsd":{"type":"ControlElement","id":"acm000002873jsd","name":"subst","comment":"","startLine":149,"endLine":151,"calleeNames":["scons_subst"]},"acm000002874jsd":{"type":"ControlElement","id":"acm000002874jsd","name":"subst_list","comment":"","startLine":155,"endLine":157,"calleeNames":["scons_subst_list"]},"acm000002875jsd":{"type":"ControlElement","id":"acm000002875jsd","name":"__getitem__","comment":"","startLine":159,"endLine":160,"calleeNames":[]},"acm000002876jsd":{"type":"ControlElement","id":"acm000002876jsd","name":"__setitem__","comment":"","startLine":162,"endLine":163,"calleeNames":[]},"acm000002877jsd":{"type":"ControlElement","id":"acm000002877jsd","name":"__contains__","comment":"","startLine":165,"endLine":166,"calleeNames":[]},"acm000002878jsd":{"type":"ControlElement","id":"acm000002878jsd","name":"get","comment":"","startLine":168,"endLine":169,"calleeNames":["get"]},"acm000002879jsd":{"type":"ControlElement","id":"acm000002879jsd","name":"items","comment":"","startLine":171,"endLine":172,"calleeNames":["list","items"]},"acm000002880jsd":{"type":"ControlElement","id":"acm000002880jsd","name":"Dictionary","comment":"","startLine":174,"endLine":175,"calleeNames":[]},"acm000002881jsd":{"type":"ControlElement","id":"acm000002881jsd","name":"Clone","comment":"","startLine":177,"endLine":182,"calleeNames":["Environment","semi_deepcopy","items"]},"acm000002882jsd":{"type":"ControlElement","id":"acm000002882jsd","name":"sig_dict","comment":"","startLine":184,"endLine":191,"calleeNames":["items"]},"acm000002883jsd":{"type":"ClassUnit","id":"acm000002883jsd","name":"Environment","comment":"","compilationUnitId":"acm000002966jsd","parentDatatypeId":null,"startLine":138,"endLine":191,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002872jsd","acm000002873jsd","acm000002874jsd","acm000002875jsd","acm000002876jsd","acm000002877jsd","acm000002878jsd","acm000002879jsd","acm000002880jsd","acm000002881jsd","acm000002882jsd"]},"acm000002884jsd":{"type":"ControlElement","id":"acm000002884jsd","name":"__init__","comment":"","startLine":112,"endLine":114,"calleeNames":["str"]},"acm000002885jsd":{"type":"ControlElement","id":"acm000002885jsd","name":"str_for_display","comment":"","startLine":198,"endLine":199,"calleeNames":[]},"acm000002886jsd":{"type":"ControlElement","id":"acm000002886jsd","name":"__str__","comment":"","startLine":201,"endLine":202,"calleeNames":[]},"acm000002887jsd":{"type":"ControlElement","id":"acm000002887jsd","name":"rfile","comment":"","startLine":204,"endLine":205,"calleeNames":[]},"acm000002888jsd":{"type":"ControlElement","id":"acm000002888jsd","name":"get_subst_proxy","comment":"","startLine":207,"endLine":208,"calleeNames":[]},"acm000002889jsd":{"type":"ClassUnit","id":"acm000002889jsd","name":"DummyNode","comment":"","compilationUnitId":"acm000002966jsd","parentDatatypeId":null,"startLine":194,"endLine":208,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002884jsd","acm000002885jsd","acm000002886jsd","acm000002887jsd","acm000002888jsd"]},"acm000002890jsd":{"type":"ControlElement","id":"acm000002890jsd","name":"test_FunctionAction","comment":"Test the Action() factory's creation of FunctionAction objects.","startLine":317,"endLine":329,"calleeNames":["isinstance","test_positional_args"]},"acm000002891jsd":{"type":"ControlElement","id":"acm000002891jsd","name":"test_CommandAction","comment":"Test the Action() factory's creation of CommandAction objects.","startLine":331,"endLine":346,"calleeNames":["isinstance","test_positional_args"]},"acm000002892jsd":{"type":"ControlElement","id":"acm000002892jsd","name":"test_ListAction","comment":"Test the Action() factory's creation of ListAction objects.","startLine":348,"endLine":407,"calleeNames":["Action","isinstance"]},"acm000002893jsd":{"type":"ControlElement","id":"acm000002893jsd","name":"test_CommandGeneratorAction","comment":"Test the Action factory's creation of CommandGeneratorAction objects.","startLine":409,"endLine":418,"calleeNames":["isinstance","test_positional_args"]},"acm000002894jsd":{"type":"ControlElement","id":"acm000002894jsd","name":"test_LazyCmdGeneratorAction","comment":"Test the Action factory's creation of lazy CommandGeneratorAction objects.","startLine":420,"endLine":429,"calleeNames":["isinstance","test_positional_args"]},"acm000002895jsd":{"type":"ControlElement","id":"acm000002895jsd","name":"test_no_action","comment":"Test when the Action() factory can't create an action object.","startLine":431,"endLine":439,"calleeNames":["Action"]},"acm000002896jsd":{"type":"ControlElement","id":"acm000002896jsd","name":"test_reentrance","comment":"Test the Action factory when the action is already an Action object.","startLine":441,"endLine":446,"calleeNames":["Action"]},"acm000002897jsd":{"type":"ClassUnit","id":"acm000002897jsd","name":"ActionTestCase","comment":"Test the Action() factory function","compilationUnitId":"acm000002966jsd","parentDatatypeId":null,"startLine":314,"endLine":446,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002890jsd","acm000002891jsd","acm000002892jsd","acm000002893jsd","acm000002894jsd","acm000002895jsd","acm000002896jsd"]},"acm000002898jsd":{"type":"ControlElement","id":"acm000002898jsd","name":"test__init__","comment":"Test creation of _ActionAction objects.","startLine":451,"endLine":522,"calleeNames":["_ActionAction","hasattr"]},"acm000002899jsd":{"type":"ControlElement","id":"acm000002899jsd","name":"test_dup_keywords","comment":"Test handling of both cmdstr and strfunction arguments.","startLine":524,"endLine":537,"calleeNames":["Action","str","find","Exception"]},"acm000002900jsd":{"type":"ControlElement","id":"acm000002900jsd","name":"test___cmp__","comment":"Test Action comparison.","startLine":539,"endLine":547,"calleeNames":["Action"]},"acm000002901jsd":{"type":"ControlElement","id":"acm000002901jsd","name":"test_print_cmd_lines","comment":"Test the print_cmd_lines() method.","startLine":549,"endLine":567,"calleeNames":["Action","StringIO","print_cmd_line","getvalue"]},"acm000002902jsd":{"type":"ControlElement","id":"acm000002902jsd","name":"test___call__","comment":"Test calling an Action.","startLine":569,"endLine":755,"calleeNames":["TestCmd","subdir","chdir","workpath","Environment","isinstance","type","Action","StringIO","a","getvalue","repr","b","a2","append"]},"acm000002903jsd":{"type":"ControlElement","id":"acm000002903jsd","name":"test_presub_lines","comment":"Test the presub_lines() method.","startLine":757,"endLine":789,"calleeNames":["Environment","Action","presub_lines","get"]},"acm000002904jsd":{"type":"ControlElement","id":"acm000002904jsd","name":"test_add","comment":"Test adding Actions to stuff.\nAdding actions to other Actions or to stuff that can\nbe converted into an Action should produce a ListAction\ncontaining all the Actions.","startLine":791,"endLine":874,"calleeNames":["Action","isinstance","str","len"]},"acm000002905jsd":{"type":"ClassUnit","id":"acm000002905jsd","name":"_ActionActionTestCase","comment":"","compilationUnitId":"acm000002966jsd","parentDatatypeId":null,"startLine":449,"endLine":874,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002898jsd","acm000002899jsd","acm000002900jsd","acm000002901jsd","acm000002902jsd","acm000002903jsd","acm000002904jsd"]},"acm000002906jsd":{"type":"ControlElement","id":"acm000002906jsd","name":"test___init__","comment":"Test creation of a command Action.","startLine":879,"endLine":888,"calleeNames":["CommandAction"]},"acm000002907jsd":{"type":"ControlElement","id":"acm000002907jsd","name":"test___str__","comment":"Test fetching the pre-substitution string for command Actions.","startLine":890,"endLine":902,"calleeNames":["Environment","CommandAction","str"]},"acm000002908jsd":{"type":"ControlElement","id":"acm000002908jsd","name":"test_genstring","comment":"Test the genstring() method for command Actions.","startLine":904,"endLine":939,"calleeNames":["Environment","DummyNode","CommandActi