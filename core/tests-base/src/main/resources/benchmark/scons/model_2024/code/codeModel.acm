tartLine":366,"endLine":707,"calleeNames":["get","GetOption","update","Exception","items","copy","StringIO","writer_class","comment","variable","get_path","Dir","sorted","pool","min","rule","set","isdisjoint","values","has_generated_sources","is_generated_source","build","keys","append","sort","check_generated_source_deps","ninja_sorted_build","is_List","generate_depfile","pop","str","Path","File","to_escaped_list","format","list","len","default","escape_path","NamedTemporaryFile","write","getvalue","exists","cmp","unlink","gettempdir","md5","hexdigest","encode","open","int","readline","kill","wait_for_process_to_die","move"]},"acm000001852jsd":{"type":"ClassUnit","id":"acm000001852jsd","name":"NinjaState","comment":"Maintains state of Ninja build system as it's translated from SCons.","compilationUnitId":"acm000001858jsd","parentDatatypeId":null,"startLine":52,"endLine":707,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001847jsd","acm000001848jsd","acm000001849jsd","acm000001850jsd","acm000001851jsd"]},"acm000001853jsd":{"type":"ControlElement","id":"acm000001853jsd","name":"__init__","comment":"","startLine":55,"endLine":304,"calleeNames":["get","abspath","join","exists","SConsToNinjaTranslator","dict","makedirs","get_path","str","Path","int","open","read","randint","write","basename","escape","scons_escape","format"]},"acm000001854jsd":{"type":"ControlElement","id":"acm000001854jsd","name":"action_to_ninja_build","comment":"Generate build arguments dictionary for node.","startLine":734,"endLine":787,"calleeNames":["update","get","str","isinstance","handle_func_action","_generate_cache","action_to_ninja_build","handle_list_action","get_command","get_order_only","get_outputs","get_inputs","get_dependencies","is_conftest","check_attributes","callable","node_callback"]},"acm000001855jsd":{"type":"ControlElement","id":"acm000001855jsd","name":"handle_func_action","comment":"Determine how to handle the function action.","startLine":789,"endLine":824,"calleeNames":["function_name","get","handler","str","split","strip","SConsWarning","format","get_order_only","get_outputs","get_inputs","get_dependencies"]},"acm000001856jsd":{"type":"ControlElement","id":"acm000001856jsd","name":"handle_list_action","comment":"TODO write this comment","startLine":827,"endLine":923,"calleeNames":["action_to_ninja_build","len","list","get","strip","get_executor","get_all_targets","hasattr","get_rule","get_command_env","get_inputs","get_order_only","get_outputs","get_dependencies"]},"acm000001857jsd":{"type":"ClassUnit","id":"acm000001857jsd","name":"SConsToNinjaTranslator","comment":"Translates SCons Actions into Ninja build objects.","compilationUnitId":"acm000001858jsd","parentDatatypeId":null,"startLine":710,"endLine":923,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001853jsd","acm000001854jsd","acm000001855jsd","acm000001856jsd"]},"acm000001858jsd":{"type":"CodeCompilationUnit","id":"acm000001858jsd","name":"NinjaState","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\npylint: disable=too-many-instance-attributes","parentId":"acm000001925jsd","content":["acm000001852jsd","acm000001857jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["io","os","pathlib","signal","tempfile","shutil","sys","random","filecmp","os.path.splitext","tempfile.NamedTemporaryFile","ninja","hashlib","SCons","SCons.Script.COMMAND_LINE_TARGETS","SCons.Util.wait_for_process_to_die","SCons.Errors.InternalError","Globals.COMMAND_TYPES","Globals.NINJA_RULES","Globals.NINJA_POOLS","Globals.NINJA_CUSTOM_HANDLERS","Globals.NINJA_DEFAULT_TARGETS","Rules._install_action_function","Rules._mkdir_action_function","Rules._lib_symlink_action_function","Rules._copy_action_function","Utils.get_path","Utils.alias_to_ninja_build","Utils.generate_depfile","Utils.ninja_noop","Utils.get_order_only","Utils.get_outputs","Utils.get_inputs","Utils.get_dependencies","Utils.get_rule","Utils.get_command_env","Utils.to_escaped_list","Utils.ninja_sorted_build","Methods.get_command"]},"acm000001859jsd":{"type":"ControlElement","id":"acm000001859jsd","name":"log_error","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":58,"endLine":60,"calleeNames":["debug","write"]},"acm000001860jsd":{"type":"CodeCompilationUnit","id":"acm000001860jsd","name":"ninja_daemon_build","comment":"!/usr/bin/env python3\n\nMIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThis script is intended to execute a single build target. This script should be called by ninja, passing the port, ninja dir, and build target via arguments. The script then executes a simple get request to the scons daemon which is listening on from localhost on the set port.","parentId":"acm000001925jsd","content":["acm000001859jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["http.client","sys","time","os","logging","pathlib","tempfile","hashlib","traceback","socket"]},"acm000001861jsd":{"type":"ControlElement","id":"acm000001861jsd","name":"log_error","comment":"TODO: Remove the following when Python3.6 support is dropped.\non Windows with Python version 3.6, popen does not do a good job disconnecting\nthe std handles and this make ninja hang because they stay open to the original\nprocess ninja launched. Here we can force the handles to be separated.\nSee: https://docs.python.org/3.6/library/subprocess.html#subprocess.STARTUPINFO\nSee Also: https://docs.python.org/3.6/library/subprocess.html#subprocess.Popen\nNote when you don't specify stdin, stdout, and/or stderr they default to None\nwhich indicates no output redirection will occur.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":64,"endLine":66,"calleeNames":["debug","write"]},"acm000001862jsd":{"type":"CodeCompilationUnit","id":"acm000001862jsd","name":"ninja_run_daemon","comment":"!/usr/bin/env python3\n\nMIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThis script is intended to be called by ninja to start up the scons daemon process. It will launch the server and attempt to connect to it. This process needs to completely detach from the spawned process so ninja can consider the build edge completed. It should be passed the args which should be forwarded to the scons daemon process which could be any number of # arguments. However the first few arguments are required to be port, ninja dir, and keep alive timeout in seconds. The scons_daemon_dirty file acts as a pidfile marker letting this script quickly skip over restarting the server if the server is running. The assumption here is the pidfile should only exist if the server is running.","parentId":"acm000001925jsd","content":["acm000001861jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["subprocess","sys","os","pathlib","tempfile","hashlib","logging","time","http.client","traceback","socket"]},"acm000001863jsd":{"type":"ControlElement","id":"acm000001863jsd","name":"__init__","comment":"","startLine":135,"endLine":142,"calleeNames":[]},"acm000001864jsd":{"type":"ClassUnit","id":"acm000001864jsd","name":"StateInfo","comment":"","compilationUnitId":"acm000001873jsd","parentDatatypeId":null,"startLine":134,"endLine":142,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001863jsd"]},"acm000001865jsd":{"type":"ControlElement","id":"acm000001865jsd","name":"daemon_log","comment":"","startLine":80,"endLine":81,"calleeNames":["debug"]},"acm000001866jsd":{"type":"ControlElement","id":"acm000001866jsd","name":"custom_readlines","comment":"","startLine":84,"endLine":98,"calleeNames":["read","decode","split","pop","endswith"]},"acm000001867jsd":{"type":"ControlElement","id":"acm000001867jsd","name":"custom_readerr","comment":"","startLine":101,"endLine":112,"calleeNames":["read","decode","split","pop"]},"acm000001868jsd":{"type":"ControlElement","id":"acm000001868jsd","name":"enqueue_output","comment":"","startLine":115,"endLine":118,"calleeNames":["iter","custom_readlines","put","close"]},"acm000001869jsd":{"type":"ControlElement","id":"acm000001869jsd","name":"enqueue_error","comment":"","startLine":121,"endLine":124,"calleeNames":["iter","custom_readerr","put","close"]},"acm000001870jsd":{"type":"ControlElement","id":"acm000001870jsd","name":"sigint_func","comment":"","startLine":146,"endLine":148,"calleeNames":[]},"acm000001871jsd":{"type":"ControlElement","id":"acm000001871jsd","name":"daemon_thread_func","comment":"While scons interactive process is stil running...\nwhile there is scons output to process\nbreaks out of the output processing loop\nwhile there is input to process...\nour scons process is done, make sure we are shutting down in this case","startLine":153,"endLine":254,"calleeNames":["daemon_log","Popen","Thread","start","poll","get","strip","notify","clear","empty","write","flush","encode","sleep","format_exc"]},"acm000001872jsd":{"type":"ControlElement","id":"acm000001872jsd","name":"server_thread_func","comment":"","startLine":267,"endLine":337,"calleeNames":["parse_qs","urlparse","get","timer","daemon_log","put","wait_for","send_response","send_header","end_headers","write","encode","format_exc","TCPServer","serve_forever"]},"acm000001873jsd":{"type":"CodeCompilationUnit","id":"acm000001873jsd","name":"ninja_scons_daemon","comment":"!/usr/bin/env python3\n\nMIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThis script primarily consists of two threads, the http server thread and the scons interactive process thread. The http server thread will listen on the passed port for http get request which should indicate some action for the scons interactive process to take. The daemon will keep log files in a tmp directory correlated to the hash of the absolute path of the ninja build dir passed. The daemon will also use a keep alive time to know when to shut itself down after the passed timeout of no activity. Any time the server receives a get request, the keep alive time will be reset.","parentId":"acm000001925jsd","content":["acm000001864jsd","acm000001865jsd","acm000001866jsd","acm000001867jsd","acm000001868jsd","acm000001869jsd","acm000001870jsd","acm000001871jsd","acm000001872jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["http.server","socketserver","urllib.parse.urlparse","urllib.parse.parse_qs","time","threading.Condition","subprocess.PIPE","subprocess.Popen","sys","os","threading","queue","pathlib","logging","timeit.default_timer","traceback","tempfile","hashlib","signal"]},"acm000001874jsd":{"type":"ControlElement","id":"acm000001874jsd","name":"__call__","comment":"","startLine":68,"endLine":69,"calleeNames":[]},"acm000001875jsd":{"type":"ControlElement","id":"acm000001875jsd","name":"_print_cmd_str","comment":"Disable this method","startLine":71,"endLine":73,"calleeNames":[]},"acm000001876jsd":{"type":"ClassUnit","id":"acm000001876jsd","name":"NinjaNoResponseFiles","comment":"Overwrite the __call__ method of SCons' TempFileMunge to not delete.","compilationUnitId":"acm000001882jsd","parentDatatypeId":null,"startLine":65,"endLine":73,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001874jsd","acm000001875jsd"]},"acm000001877jsd":{"type":"ControlElement","id":"acm000001877jsd","name":"__call__","comment":"","startLine":68,"endLine":69,"calleeNames":[]},"acm000001878jsd":{"type":"ClassUnit","id":"acm000001878jsd","name":"AlwaysExecAction","comment":"Override FunctionAction.__call__ to always execute.","compilationUnitId":"acm000001882jsd","parentDatatypeId":null,"startLine":91,"endLine":96,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001877jsd"]},"acm000001879jsd":{"type":"ControlElement","id":"acm000001879jsd","name":"ninja_hack_linkcom","comment":"TODO: change LINKCOM and SHLINKCOM to handle embedding manifest exe checks\nwithout relying on the SCons hacks that SCons uses by default.","startLine":30,"endLine":42,"calleeNames":["get"]},"acm000001880jsd":{"type":"ControlElement","id":"acm000001880jsd","name":"ninja_hack_arcom","comment":"Force ARCOM so use 's' flag on ar instead of separately running ranlib\nThere is no way to translate the ranlib list action into\nNinja so add the s flag and disable ranlib.\n\nThis is equivalent to Meson.\nhttps://github.com/mesonbuild/meson/blob/master/mesonbuild/linkers.py#L143\nDisable running ranlib, since we added 's' above","startLine":45,"endLine":62,"calleeNames":["get","str","CLVar"]},"acm000001881jsd":{"type":"ControlElement","id":"acm000001881jsd","name":"ninja_always_serial","comment":"Replacement for SCons.Job.Jobs constructor which always uses the Serial Job class.\nWe still set self.num_jobs to num even though it's a lie. The\nonly consumer of this attribute is the Parallel Job class AND\nthe Main.py function which instantiates a Jobs class. It checks\nif Jobs.num_jobs is equal to options.num_jobs, so if the user\nprovides -j12 but we set self.num_jobs = 1 they get an incorrect\nwarning about this version of Python not supporting parallel\nbuilds. So here we lie so the Main.py will not give a false\nwarning to users.","startLine":76,"endLine":87,"calleeNames":["Serial"]},"acm000001882jsd":{"type":"CodeCompilationUnit","id":"acm000001882jsd","name":"Overrides","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThis module is to hold logic which overrides default SCons behaviors to enable ninja file generation","parentId":"acm000001925jsd","content":["acm000001876jsd","acm000001878jsd","acm000001879jsd","acm000001880jsd","acm000001881jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons"]},"acm000001883jsd":{"type":"ControlElement","id":"acm000001883jsd","name":"_install_action_function","comment":"Install files using the install or copy commands","startLine":27,"endLine":34,"calleeNames":["get_outputs","get_rule","get_inputs","get_dependencies"]},"acm000001884jsd":{"type":"ControlElement","id":"acm000001884jsd","name":"_mkdir_action_function","comment":"implicit explicitly omitted, we translate these so they can be\nused by anything that depends on these but commonly this is\nhit with a node that will depend on all of the fake\nsrcnode's that SCons will never give us a rule for leading\nto an invalid ninja file.\nOn Windows mkdir \"-p\" is always on","startLine":37,"endLine":52,"calleeNames":["get_outputs","get_rule","format","join"]},"acm000001885jsd":{"type":"ControlElement","id":"acm000001885jsd","name":"_copy_action_function","comment":"","startLine":55,"endLine":63,"calleeNames":["get_outputs","get_inputs","get_rule"]},"acm000001886jsd":{"type":"ControlElement","id":"acm000001886jsd","name":"_lib_symlink_action_function","comment":"Create shared object symlinks if any need to be created","startLine":66,"endLine":81,"calleeNames":["check_attributes","get_dir","rel_path","get_path","get_rule","get_dependencies"]},"acm000001887jsd":{"type":"CodeCompilationUnit","id":"acm000001887jsd","name":"Rules","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000001925jsd","content":["acm000001883jsd","acm000001884jsd","acm000001885jsd","acm000001886jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["Utils.get_outputs","Utils.get_rule","Utils.get_inputs","Utils.get_dependencies"]},"acm000001888jsd":{"type":"ClassUnit","id":"acm000001888jsd","name":"NinjaExperimentalWarning","comment":"","compilationUnitId":"acm000001918jsd","parentDatatypeId":null,"startLine":35,"endLine":36,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001889jsd":{"type":"ControlElement","id":"acm000001889jsd","name":"ninja_add_command_line_options","comment":"Add additional command line arguments to SCons specific to the ninja tool","startLine":39,"endLine":65,"calleeNames":["AddOption"]},"acm000001890jsd":{"type":"ControlElement","id":"acm000001890jsd","name":"is_valid_dependent_node","comment":"Return True if node is not an alias or is an alias that has children This prevents us from making phony targets that depend on other phony targets that will never have an associated ninja build target. We also have to specify that it's an alias when doing the builder check because some nodes (like src files) won't have builders but are valid implicit dependencies.","startLine":68,"endLine":83,"calleeNames":["isinstance","bool","children","get_env","get"]},"acm000001891jsd":{"type":"ControlElement","id":"acm000001891jsd","name":"alias_to_ninja_build","comment":"Convert an Alias node into a Ninja phony target","startLine":86,"endLine":94,"calleeNames":["get_outputs","get_path","src_file","children","is_valid_dependent_node"]},"acm000001892jsd":{"type":"ControlElement","id":"acm000001892jsd","name":"check_invalid_ninja_node","comment":"","startLine":97,"endLine":98,"calleeNames":["isinstance"]},"acm000001893jsd":{"type":"ControlElement","id":"acm000001893jsd","name":"filter_ninja_nodes","comment":"","startLine":101,"endLine":108,"calleeNames":["isinstance","get_env","get","append"]},"acm000001894jsd":{"type":"ControlElement","id":"acm000001894jsd","name":"get_input_nodes","comment":"","startLine":111,"endLine":116,"calleeNames":["get_executor","get_all_sources"]},"acm000001895jsd":{"type":"ControlElement","id":"acm000001895jsd","name":"invalid_ninja_nodes","comment":"","startLine":119,"endLine":124,"calleeNames":["get_input_nodes","children","any","check_invalid_ninja_node"]},"acm000001896jsd":{"type":"ControlElement","id":"acm000001896jsd","name":"get_order_only","comment":"Return a list of order only dependencies for node.","startLine":127,"endLine":131,"calleeNames":["get_path","src_file","filter_ninja_nodes"]},"acm000001897jsd":{"type":"ControlElement","id":"acm000001897jsd","name":"get_dependencies","comment":"Return a list of dependencies for node.","startLine":134,"endLine":142,"calleeNames":["get_path","src_file","filter_ninja_nodes","children"]},"acm000001898jsd":{"type":"ControlElement","id":"acm000001898jsd","name":"get_inputs","comment":"Collect the Ninja inputs for node.","startLine":145,"endLine":147,"calleeNames":["get_path","src_file","filter_ninja_nodes","get_input_nodes"]},"acm000001899jsd":{"type":"ControlElement","id":"acm000001899jsd","name":"get_outputs","comment":"Collect the Ninja outputs for node.","startLine":150,"endLine":163,"calleeNames":["get_executor","get_all_targets","hasattr","get_path","filter_ninja_nodes"]},"acm000001900jsd":{"type":"ControlElement","id":"acm000001900jsd","name":"get_targets_sources","comment":"","startLine":166,"endLine":180,"calleeNames":["get_executor","get_all_targets","get_all_sources","hasattr","rfile"]},"acm000001901jsd":{"type":"ControlElement","id":"acm000001901jsd","name":"get_path","comment":"Return a fake path if necessary. As an example Aliases use this as their target name in Ninja.","startLine":183,"endLine":191,"calleeNames":["hasattr","get_path","str"]},"acm000001902jsd":{"type":"ControlElement","id":"acm000001902jsd","name":"rfile","comment":"Return the repository file for node if it has one. Otherwise return node","startLine":194,"endLine":200,"calleeNames":["hasattr","rfile"]},"acm000001903jsd":{"type":"ControlElement","id":"acm000001903jsd","name":"src_file","comment":"Returns the src code file if it exists.","startLine":203,"endLine":209,"calleeNames":["hasattr","srcnode","stat","get_path"]},"acm000001904jsd":{"type":"ControlElement","id":"acm000001904jsd","name":"get_rule","comment":"","startLine":212,"endLine":217,"calleeNames":["get_targets_sources","invalid_ninja_nodes"]},"acm000001905jsd":{"type":"ControlElement","id":"acm000001905jsd","name":"to_escaped_list","comment":"Ninja tool function for returning an escaped list of strings from a subst generator. env_var arg can be a list or a subst generator which returns a list.\nsubst_list will take in either a raw list or a subst callable which generates\na list, and return a list of CmdStringHolders which can be converted into raw strings.\nIf a raw list was passed in, then scons_list will make a list of lists from the original\nvalues and even subst items in the list if they are substitutable. Flatten will flatten\nthe list in that case, to ensure for either input we have a list of CmdStringHolders.","startLine":220,"endLine":238,"calleeNames":["Flatten","subst_list","sorted","escape","get"]},"acm000001906jsd":{"type":"ControlElement","id":"acm000001906jsd","name":"generate_depfile","comment":"Ninja tool function for writing a depfile. The depfile should include the node path followed by all the dependent files in a makefile format. dependencies arg can be a list or a subst generator which returns a list.","startLine":241,"endLine":263,"calleeNames":["join","get_path","str","to_escaped_list","open","read","makedirs","dirname","write"]},"acm000001907jsd":{"type":"ControlElement","id":"acm000001907jsd","name":"ninja_noop","comment":"A general purpose no-op function. There are many things that happen in SCons that we don't need and also don't return anything. We use this to disable those functions instead of creating multiple definitions of the same thing.","startLine":266,"endLine":274,"calleeNames":[]},"acm000001908jsd":{"type":"ControlElement","id":"acm000001908jsd","name":"ninja_recursive_sorted_dict","comment":"","startLine":276,"endLine":283,"calleeNames":["OrderedDict","sorted","items","isinstance","ninja_recursive_sorted_dict"]},"acm000001909jsd":{"type":"ControlElement","id":"acm000001909jsd","name":"ninja_sorted_build","comment":"","startLine":286,"endLine":288,"calleeNames":["ninja_recursive_sorted_dict","build"]},"acm000001910jsd":{"type":"ControlElement","id":"acm000001910jsd","name":"get_command_env","comment":"Return a string that sets the environment for any environment variables that differ between the OS environment and the SCons command ENV. It will be compatible with the default shell of the operating system.\nScan the ENV looking for any keys which do not exist in\nos.environ or differ from it. We assume if it's a new or\ndiffering key from the process environment then it's\nimportant to pass down to commands in the Ninja file.","startLine":291,"endLine":331,"calleeNames":["_resolve_shell_env","items","get","sanitize_shell_env","replace"]},"acm000001911jsd":{"type":"ControlElement","id":"acm000001911jsd","name":"get_comstr","comment":"Get the un-substituted string for action.\nDespite being having \"list\" in it's name this member is not\nactually a list. It's the pre-subst'd string of the command. We\nuse it to determine if the command we're about to generate needs\nto use a custom Ninja rule. By default this redirects CC, CXX,\nAR, SHLINK, and LINK commands to their respective rules but the\nuser can inject custom Ninja rules and tie them to commands by\nusing their pre-subst'd string.","startLine":334,"endLine":346,"calleeNames":["hasattr","genstring"]},"acm000001912jsd":{"type":"ControlElement","id":"acm000001912jsd","name":"generate_command","comment":"Actions like CommandAction have a method called process that is\nused by SCons to generate the cmd_line they need to run. So\ncheck if it's a thing like CommandAction and call it if we can.\nAnything else works with genstring, this is most commonly hit by\nListActions which essentially call process on all of their\ncommands and concatenate it for us.\nEscape dollars as necessary","startLine":349,"endLine":371,"calleeNames":["hasattr","process","_string_from_cmd_list","genstring","subst","replace","strip","endswith"]},"acm000001913jsd":{"type":"ControlElement","id":"acm000001913jsd","name":"ninja_csig","comment":"Return a dummy csig","startLine":374,"endLine":382,"calleeNames":["isinstance","is_sconscript","original"]},"acm000001914jsd":{"type":"ControlElement","id":"acm000001914jsd","name":"ninja_contents","comment":"Return a dummy content without doing IO","startLine":385,"endLine":393,"calleeNames":["isinstance","is_sconscript","is_conftest","original","bytes"]},"acm000001915jsd":{"type":"ControlElement","id":"acm000001915jsd","name":"ninja_stat","comment":"Eternally memoized stat call. SCons is very aggressive about clearing out cached values. For our purposes everything should only ever call stat once since we're running in a no_exec build the file system state should not change. For these reasons we patch SCons.Node.FS.LocalFS.stat to use our eternal memoized dictionary.","startLine":396,"endLine":416,"calleeNames":["stat"]},"acm000001916jsd":{"type":"ControlElement","id":"acm000001916jsd","name":"ninja_whereis","comment":"Replace env.WhereIs with a much faster version\nOptimize for success, this gets called significantly more often\nwhen the value is already memoized than when it's not.\nTODO: Fix this to respect env['ENV']['PATH']... WPD\nWe do not honor any env['ENV'] or env[*] variables in the\ngenerated ninja file. Ninja passes your raw shell environment\ndown to it's subprocess so the only sane option is to do the\nsame during generation. At some point, if and when we try to\nupstream this, I'm sure a sticking point will be respecting\nenv['ENV'] variables and such but it's actually quite\ncomplicated. I have a naive version but making it always work\nwith shell quoting is nigh impossible. So I've decided to\ncross that bridge when it's absolutely required.","startLine":419,"endLine":439,"calleeNames":["which"]},"acm000001917jsd":{"type":"ControlElement","id":"acm000001917jsd","name":"ninja_print_conf_log","comment":"Command line print only for conftest to generate a correct conf log.","startLine":442,"endLine":446,"calleeNames":["is_conftest","_ActionAction","print_cmd_line"]},"acm000001918jsd":{"type":"CodeCompilationUnit","id":"acm000001918jsd","name":"Utils","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000001925jsd","content":["acm000001888jsd","acm000001889jsd","acm000001890jsd","acm000001891jsd","acm000001892jsd","acm000001893jsd","acm000001894jsd","acm000001895jsd","acm000001896jsd","acm000001897jsd","acm000001898jsd","acm000001899jsd","acm000001900jsd","acm000001901jsd","acm000001902jsd","acm000001903jsd","acm000001904jsd","acm000001905jsd","acm000001906jsd","acm000001907jsd","acm000001908jsd","acm000001909jsd","acm000001910jsd","acm000001911jsd","acm000001912jsd","acm000001913jsd","acm000001914jsd","acm000001915jsd","acm000001916jsd","acm000001917jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","shutil","os.path.join","collections.OrderedDict","typing.Optional","SCons","SCons.Action.get_default_ENV","SCons.Action._string_from_cmd_list","SCons.Script.AddOption","SCons.Util.is_List","SCons.Util.flatten_sequence","SCons.Util.sctyping.ExecutorType"]},"acm000001919jsd":{"type":"ControlElement","id":"acm000001919jsd","name":"ninja_builder","comment":"Generate a build.ninja for source.\nWe have no COMSTR equivalent so print that we're generating\nhere.","startLine":58,"endLine":135,"calleeNames":["isinstance","print","str","get_abspath","generate","BuildError","open","write","format","lower","get","GetOption","split","join","sanitize_shell_env","Popen","iter","close","wait","CalledProcessError","execute_ninja","strip","flush","startswith"]},"acm000001920jsd":{"type":"ControlElement","id":"acm000001920jsd","name":"options","comment":"Add command line Variables for Ninja builder.","startLine":138,"endLine":144,"calleeNames":["AddVariables"]},"acm000001921jsd":{"type":"ControlElement","id":"acm000001921jsd","name":"exists","comment":"Enable if called.\nThis variable disables the tool when storing the SCons command in the\ngenerated ninja file to ensure that the ninja tool is not loaded when\nSCons should do actual work as a subprocess of a ninja build. The ninja\ntool is very invasive into the internals of SCons and so should never be\nenabled when SCons needs to build a target.\npypi ninja module detection done at top of file during import ninja.","startLine":146,"endLine":164,"calleeNames":["GetOption","get","SConsWarning"]},"acm000001922jsd":{"type":"ControlElement","id":"acm000001922jsd","name":"ninja_emitter","comment":"fix up the source/targets","startLine":167,"endLine":185,"calleeNames":["File","subst","len"]},"acm000001923jsd":{"type":"ControlElement","id":"acm000001923jsd","name":"generate","comment":"Generate the NINJA builders.","startLine":188,"endLine":513,"calleeNames":["GetOption","ninja_add_command_line_options","SConsWarning","get","AlwaysExecAction","Builder","Append","Dir","SConsignFile","join","str","Ninja","AlwaysBuild","TargetList","Alias","sorted","AddMethod","ninja_hack_linkcom","gen_get_response_file_command","NinjaRuleMapping","isinstance","robust_rule_mapping","Decider","ninja_hack_arcom","print","exists","ninja_contents","ninja_csig","SetOption","import_module","NinjaState","SCons_Builder_BuilderBase__execute","is_List","check_attributes","is_conftest","Depends","get_env","add_build","build","append","arg2nodes","extend"]},"acm000001924jsd":{"type":"CodeCompilationUnit","id":"acm000001924jsd","name":"__init__","comment":"MIT License\n\nCopyright 2020 MongoDB Inc.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\nGenerate build.ninja files from SCons aliases.","parentId":"acm000001925jsd","content":["acm000001919jsd","acm000001920jsd","acm000001921jsd","acm000001922jsd","acm000001923jsd"],"pathElements":["Tool","ninja"],"extension":"py","language":"PYTHON3","importedModuleNames":["importlib","os","traceback","subprocess","sys","SCons","SCons.Script","SCons.Tool.ninja.Globals","SCons.Script.GetOption","SCons.Util.sanitize_shell_env","Globals.NINJA_RULES","Globals.NINJA_POOLS","Globals.NINJA_CUSTOM_HANDLERS","Globals.NINJA_DEFAULT_TARGETS","Globals.NINJA_CMDLINE_TARGETS","Methods.register_custom_handler","Methods.register_custom_rule_mapping","Methods.register_custom_rule","Methods.register_custom_pool","Methods.set_build_node_callback","Methods.get_generic_shell_command","Methods.CheckNinjaCompdbExpand","Methods.get_command","Methods.gen_get_response_file_command","Overrides.ninja_hack_linkcom","Overrides.ninja_hack_arcom","Overrides.NinjaNoResponseFiles","Overrides.ninja_always_serial","Overrides.AlwaysExecAction","Utils.ninja_add_command_line_options","Utils.ninja_noop","Utils.ninja_print_conf_log","Utils.ninja_csig","Utils.ninja_contents","Utils.ninja_stat","Utils.ninja_whereis","Utils.NinjaExperimentalWarning"]},"acm000001925jsd":{"type":"CodePackage","id":"acm000001925jsd","name":"ninja","comment":"","parentId":"acm000002768jsd","content":["acm000001836jsd","acm000001846jsd","acm000001858jsd","acm000001860jsd","acm000001862jsd","acm000001873jsd","acm000001882jsd","acm000001887jsd","acm000001918jsd","acm000001924jsd"]},"acm000001926jsd":{"type":"ControlElement","id":"acm000001926jsd","name":"package","comment":"This function prepares the packageroot directory for packaging with the ipkg builder.\nsetup the Ipkg builder","startLine":37,"endLine":81,"calleeNames":["Tool","generate","stripinstallbuilder","putintopackageroot","uname","get","locals","update","gen_ipk_dir","str","bld"]},"acm000001927jsd":{"type":"ControlElement","id":"acm000001927jsd","name":"gen_ipk_dir","comment":"make sure the packageroot is a Dir object.\ncreate the specfile builder","startLine":83,"endLine":106,"calleeNames":["is_String","Dir","Builder","append","File","s_bld"]},"acm000001928jsd":{"type":"ControlElement","id":"acm000001928jsd","name":"build_specfiles","comment":"Filter the targets for the needed files and use the variables in env to create the specfile.\n\nAt first we care for the CONTROL/control file, which is the main file for ipk.\n\nFor this we need to open multiple files in random order, so we store into\na dict so they can be easily accessed.\n\n","startLine":108,"endLine":183,"calleeNames":["filter","get_path","rfind","list","open","get_abspath","open_file","replace","write","subst","dir","split","values","close"]},"acm000001929jsd":{"type":"CodeCompilationUnit","id":"acm000001929jsd","name":"ipk","comment":"SCons.Tool.Packaging.ipk\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000001981jsd","content":["acm000001926jsd","acm000001927jsd","acm000001928jsd"],"pathElements":["Tool","packaging"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","SCons.Builder","SCons.Node.FS","SCons.Util","SCons.Tool.packaging.stripinstallbuilder","SCons.Tool.packaging.putintopackageroot"]},"acm000001930jsd":{"type":"ControlElement","id":"acm000001930jsd","name":"convert_to_id","comment":"Some parts of .wxs need an Id attribute (for example: The File and Directory directives. The charset is limited to A-Z, a-z, digits, underscores, periods. Each Id must begin with a letter or with a underscore. Google for \"CNDL0015\" for information about this. Requirements: * the string created must only contain chars from the target charset. * the string created must have a minimal editing distance from the original string. * the string created must be unique for the whole .wxs file. Observation: * There are 62 chars in the charset. Idea: * filter out forbidden characters. Check for a collision with the help of the id_set. Add the number of the number of the collision at the end of the created string. Furthermore care for a correct start of the string.","startLine":39,"endLine":75,"calleeNames":["join","str","len"]},"acm000001931jsd":{"type":"ControlElement","id":"acm000001931jsd","name":"is_dos_short_file_name","comment":"Examine if the given file is in the 8.3 form.","startLine":77,"endLine":83,"calleeNames":["splitext","len","isupper"]},"acm000001932jsd":{"type":"ControlElement","id":"acm000001932jsd","name":"gen_dos_short_file_name","comment":"Return a filename in the 8.3 form. See http://support.microsoft.com/default.aspx?scid=kb;en-us;Q142982 These are no complete 8.3 dos short names. The ~ char is missing and replaced with one character from the filename. WiX warns about such filenames, since a collision might occur. Google for \"CNDL1014\" for more information.\nguard this to not confuse the generation\next contains the dot\nfirst try if it suffices to convert to upper","startLine":85,"endLine":122,"calleeNames":["is_dos_short_file_name","splitext","upper","join","len","str","append"]},"acm000001933jsd":{"type":"ControlElement","id":"acm000001933jsd","name":"create_feature_dict","comment":"X_MSI_FEATURE and doc FileTag's can be used to collect files in a hierarchy. This function collects the files into this hierarchy.","startLine":124,"endLine":148,"calleeNames":["is_List","append","hasattr","add_to_dict"]},"acm000001934jsd":{"type":"ControlElement","id":"acm000001934jsd","name":"generate_guids","comment":"generates globally unique identifiers for parts of the xml which need them. Component tags have a special requirement. Their UUID is only allowed to change if the list of their contained resources has changed. This allows for clean removal and proper updates. To handle this requirement, the uuid is generated with an md5 hashing the whole subtree of a xml node.\nspecify which tags need a guid and in which attribute this should be stored.","startLine":150,"endLine":176,"calleeNames":["items","getElementsByTagName","uuid5","toxml","str"]},"acm000001935jsd":{"type":"ControlElement","id":"acm000001935jsd","name":"string_wxsfile","comment":"","startLine":179,"endLine":180,"calleeNames":[]},"acm000001936jsd":{"type":"ControlElement","id":"acm000001936jsd","name":"build_wxsfile","comment":"Compiles a .wxs file from the keywords given in env['msi_spec'] and by analyzing the tree of source nodes and their tags.","startLine":182,"endLine":216,"calleeNames":["open","get_abspath","Document","createElement","appendChild","build_wxsfile_header_section","build_wxsfile_file_section","generate_guids","build_wxsfile_features_section","build_wxsfile_default_gui","build_license_file","get_dir","write","toprettyxml","UserError","close"]},"acm000001937jsd":{"type":"ControlElement","id":"acm000001937jsd","name":"create_default_directory_layout","comment":"","startLine":221,"endLine":261,"calleeNames":["Document","createElement","escape","gen_dos_short_file_name","append","getElementsByTagName"]},"acm000001938jsd":{"type":"ControlElement","id":"acm000001938jsd","name":"build_wxsfile_file_section","comment":"Builds the Component sections of the wxs file with their included files. Files need to be specified in 8.3 format and in the long name format, long filenames will be converted automatically. Features are specficied with the 'X_MSI_FEATURE' or 'DOC' FileTag.","startLine":266,"endLine":353,"calleeNames":["create_default_directory_layout","create_feature_dict","Document","split","escape","remove","createElement","gen_dos_short_file_name","convert_to_id","append","splitdrive","basename","dirname","get_path","items","hasattr","setattr","get_directory"]},"acm000001939jsd":{"type":"ControlElement","id":"acm000001939jsd","name":"build_wxsfile_features_section","comment":"This function creates the <features> tag based on the supplied xml tree. This is achieved by finding all <component>s and adding them to a default target. It should be called after the tree has been built completly. We assume that a MY_DEFAULT_FOLDER Property is defined in the wxs file tree. Furthermore a top-level with the name and VERSION of the software will be created. An PACKAGING_X_MSI_FEATURE can either be a string, where the feature DESCRIPTION will be the same as its title or a Tuple, where the first part will be its title and the second its DESCRIPTION.","startLine":358,"endLine":411,"calleeNames":["Document","createElement","escape","create_feature_dict","items","is_Tuple","convert_to_id","basename","get_path","append","getElementsByTagName"]},"acm000001940jsd":{"type":"ControlElement","id":"acm000001940jsd","name":"build_wxsfile_default_gui","comment":"This function adds a default GUI to the wxs file","startLine":413,"endLine":425,"calleeNames":["Document","getElementsByTagName","createElement","append"]},"acm000001941jsd":{"type":"ControlElement","id":"acm000001941jsd","name":"build_license_file","comment":"Creates a License.rtf file with the content of \"X_MSI_LICENSE_TEXT\" in the given directory","startLine":427,"endLine":446,"calleeNames":["open","join","get_path","write","replace"]},"acm000001942jsd":{"type":"ControlElement","id":"acm000001942jsd","name":"build_wxsfile_header_section","comment":"Adds the xml file node which define the package meta-data.\nCreate the needed DOM nodes and add them at the correct position in the tree.","startLine":451,"endLine":485,"calleeNames":["Document","createElement","append","escape","getElementsByTagName"]},"acm000001943jsd":{"type":"ControlElement","id":"acm000001943jsd","name":"package","comment":"make sure that the Wix Builder is in the environment\nget put the keywords for the specfile compiler. These are the arguments\ngiven to the package function and all optional ones stored in kw, minus\nthe the source, target and env one.","startLine":492,"endLine":516,"calleeNames":["Tool","generate","locals","update","stripinstallbuilder","wxs_builder","WiX"]},"acm000001944jsd":{"type":"CodeCompilationUnit","id":"acm000001944jsd","name":"msi","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThe msi packager.\n\nUtility functions\n","parentId":"acm000001981jsd","content":["acm000001930jsd","acm000001931jsd","acm000001932jsd","acm000001933jsd","acm000001934jsd","acm000001935jsd","acm000001936jsd","acm000001937jsd","acm000001938jsd","acm000001939jsd","acm000001940jsd","acm000001941jsd","acm000001942jsd","acm000001943jsd"],"pathElements":["Tool","packaging"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","SCons","SCons.Action.Action","SCons.Builder.Builder","xml.dom.minidom.Document","xml.sax.saxutils.escape","SCons.Tool.packaging.stripinstallbuilder","uuid"]},"acm000001945jsd":{"type":"ControlElement","id":"acm000001945jsd","name":"__init__","comment":"","startLine":314,"endLine":316,"calleeNames":[]},"acm000001946jsd":{"type":"ControlElement","id":"acm000001946jsd","name":"compile","comment":"Compiles the tagset and returns a str containing the result","startLine":318,"endLine":352,"calleeNames":["endswith","list","items","is_international","strip_country_code","get_country_code"]},"acm000001947jsd":{"type":"ClassUnit","id":"acm000001947jsd","name":"SimpleTagCompiler","comment":"Compile RPM tags by doing simple string substitution. The replacement specfication is stored in the *tagset* dictionary, something like:: {\"abc\" : \"cdef %s \", \"abc_\": \"cdef %s %s\"} The :func:`compile` function gets a value dictionary, which may look like:: {\"abc\": \"ghij\", \"abc_gh\": \"ij\"} The resulting string will be:: \"cdef ghij cdef gh ij\"","compilationUnitId":"acm000001955jsd","parentDatatypeId":null,"startLine":297,"endLine":352,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001945jsd","acm000001946jsd"]},"acm000001948jsd":{"type":"ControlElement","id":"acm000001948jsd","name":"package","comment":"initialize the rpm tool","startLine":32,"endLine":76,"calleeNames":["Tool","generate","str","UserError","defaultMachine","locals","update","replace","OverrideEnvironment","stripinstallbuilder","addspecfile","collectintargz","bld"]},"acm000001949jsd":{"type":"ControlElement","id":"acm000001949jsd","name":"collectintargz","comment":"Puts all source files into a tar.gz file.\nthe rpm tool depends on a source package, until this is changed\nthis hack needs to be here that tries to pack all sources in.","startLine":78,"endLine":104,"calleeNames":["FindSourceFiles","extend","str","rfind","sort","replace","split","UserError","package"]},"acm000001950jsd":{"type":"ControlElement","id":"acm000001950jsd","name":"addspecfile","comment":"","startLine":106,"endLine":115,"calleeNames":["Builder","extend","bld"]},"acm000001951jsd":{"type":"ControlElement","id":"acm000001951jsd","name":"build_specfile","comment":"Builds a RPM specfile from a dictionary with string metadata and by analyzing a tree of nodes.\ncall a user specified function\n\nmandatory and optional package tag section\n","startLine":117,"endLine":132,"calleeNames":["open","get_abspath","write","build_specfile_header","build_specfile_sections","build_specfile_filesection","UserError"]},"acm000001952jsd":{"type":"ControlElement","id":"acm000001952jsd","name":"build_specfile_sections","comment":"Builds the sections of a rpm specfile.","startLine":138,"endLine":180,"calleeNames":["SimpleTagCompiler","compile"]},"acm000001953jsd":{"type":"ControlElement","id":"acm000001953jsd","name":"build_specfile_header","comment":"Builds all sections but the %file of a rpm specfile","startLine":182,"endLine":251,"calleeNames":["SimpleTagCompiler","compile"]},"acm000001954jsd":{"type":"ControlElement","id":"acm000001954jsd","name":"build_specfile_filesection","comment":"builds the %file section of the specfile","startLine":256,"endLine":295,"calleeNames":["keys","GetTag","SimpleTagCompiler","compile"]},"acm000001955jsd":{"type":"CodeCompilationUnit","id":"acm000001955jsd","name":"rpm","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of