MPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000004231jsd","content":["acm000003631jsd","acm000003635jsd","acm000003637jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["re"]},"acm000003639jsd":{"type":"ControlElement","id":"acm000003639jsd","name":"test_simple_environmentValues","comment":"Test comparing SubstitutionEnvironments","startLine":29,"endLine":34,"calleeNames":["EnvironmentValues"]},"acm000003640jsd":{"type":"ClassUnit","id":"acm000003640jsd","name":"MyTestCase","comment":"","compilationUnitId":"acm000003641jsd","parentDatatypeId":null,"startLine":28,"endLine":34,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003639jsd"]},"acm000003641jsd":{"type":"CodeCompilationUnit","id":"acm000003641jsd","name":"EnvironmentValuesTest","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000004231jsd","content":["acm000003640jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.EnvironmentValues.EnvironmentValues"]},"acm000003642jsd":{"type":"ControlElement","id":"acm000003642jsd","name":"__init__","comment":"py3: errstr should be string and not bytes.","startLine":76,"endLine":95,"calleeNames":["to_String","super","__init__"]},"acm000003643jsd":{"type":"ControlElement","id":"acm000003643jsd","name":"__str__","comment":"","startLine":97,"endLine":101,"calleeNames":[]},"acm000003644jsd":{"type":"ClassUnit","id":"acm000003644jsd","name":"BuildError","comment":"SCons Errors that can occur while building. A :class:`BuildError` exception contains information both about the erorr itself, and what caused the error. Attributes: node: (*cause*) the error occurred while building this target node(s) errstr: (*info*) a description of the error message status: (*info*) the return code of the action that caused the build error. Must be set to a non-zero value even if the build error is not due to an action returning a non-zero returned code. exitstatus: (*info*) SCons exit status due to this build error. Must be nonzero unless due to an explicit :meth:`Exit` call. Not always the same as ``status``, since actions return a status code that should be respected, but SCons typically exits with 2 irrespective of the return value of the failed action. filename: (*info*) The name of the file or directory that caused the build error. Set to ``None`` if no files are associated with this error. This might be different from the target being built. For example, failure to create the directory in which the target file will appear. It can be ``None`` if the error is not due to a particular filename. executor: (*cause*) the executor that caused the build to fail (might be ``None`` if the build failures is not due to the executor failing) action: (*cause*) the action that caused the build to fail (might be ``None`` if the build failures is not due to the an action failure) command: (*cause*) the command line for the action that caused the build to fail (might be ``None`` if the build failures is not due to the an action failure) exc_info: (*info*) Info about exception that caused the build error. Set to ``(None, None, None)`` if this build error is not due to an exception.","compilationUnitId":"acm000003653jsd","parentDatatypeId":null,"startLine":38,"endLine":101,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003642jsd","acm000003643jsd"]},"acm000003645jsd":{"type":"ClassUnit","id":"acm000003645jsd","name":"InternalError","comment":"","compilationUnitId":"acm000003653jsd","parentDatatypeId":null,"startLine":103,"endLine":104,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003646jsd":{"type":"ClassUnit","id":"acm000003646jsd","name":"UserError","comment":"","compilationUnitId":"acm000003653jsd","parentDatatypeId":null,"startLine":106,"endLine":107,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003647jsd":{"type":"ClassUnit","id":"acm000003647jsd","name":"StopError","comment":"","compilationUnitId":"acm000003653jsd","parentDatatypeId":null,"startLine":109,"endLine":110,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003648jsd":{"type":"ClassUnit","id":"acm000003648jsd","name":"SConsEnvironmentError","comment":"","compilationUnitId":"acm000003653jsd","parentDatatypeId":null,"startLine":112,"endLine":113,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003649jsd":{"type":"ClassUnit","id":"acm000003649jsd","name":"MSVCError","comment":"","compilationUnitId":"acm000003653jsd","parentDatatypeId":null,"startLine":115,"endLine":116,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003650jsd":{"type":"ControlElement","id":"acm000003650jsd","name":"__init__","comment":"py3: errstr should be string and not bytes.","startLine":76,"endLine":95,"calleeNames":["to_String","super","__init__"]},"acm000003651jsd":{"type":"ClassUnit","id":"acm000003651jsd","name":"ExplicitExit","comment":"","compilationUnitId":"acm000003653jsd","parentDatatypeId":null,"startLine":118,"endLine":123,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003650jsd"]},"acm000003652jsd":{"type":"ControlElement","id":"acm000003652jsd","name":"convert_to_BuildError","comment":"Convert a return code to a BuildError Exception. The `buildError.status` we set here will normally be used as the exit status of the \"scons\" process. Args: status: can either be a return code or an Exception. exc_info (tuple, optional): explicit exception information.\nalways exit with 2 on build errors\nmight be 0, OK here\nmight be 0, OK here\nPY3 has a exception for when copying file to itself\nIt's object provides info differently than below\nIf an IOError/OSError happens, raise a BuildError.\nReport the name of the file or directory that caused the\nerror, which might be different from the target being built\n(for example, failure to create the directory in which the\ntarget file will appear).\nimport sys\nsys.stderr.write(\"convert_to_BuildError: status %s => (errstr %s, status %s)\\n\"%(status,buildError.errstr, buildError.status))\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":125,"endLine":208,"calleeNames":["isinstance","BuildError","str","getattr","is_String"]},"acm0000036