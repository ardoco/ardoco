ource node linked to this node via VariantDir(), or the directory of this node if not linked.","startLine":518,"endLine":521,"calleeNames":["EntryProxy","get","srcnode"]},"acm000004296jsd":{"type":"ControlElement","id":"acm000004296jsd","name":"__get_rsrcnode","comment":"","startLine":523,"endLine":524,"calleeNames":["EntryProxy","get","srcnode","rfile"]},"acm000004297jsd":{"type":"ControlElement","id":"acm000004297jsd","name":"__get_rsrcdir","comment":"Returns the directory containing the source node linked to this node via VariantDir(), or the directory of this node if not linked.","startLine":526,"endLine":529,"calleeNames":["EntryProxy","get","srcnode","rfile"]},"acm000004298jsd":{"type":"ControlElement","id":"acm000004298jsd","name":"__get_dir","comment":"","startLine":531,"endLine":532,"calleeNames":["EntryProxy","get"]},"acm000004299jsd":{"type":"ControlElement","id":"acm000004299jsd","name":"__getattr__","comment":"This is how we implement the \"special\" attributes\nsuch as base, posix, srcdir, etc.\nRaise our own AttributeError subclass with an\noverridden __str__() method that identifies the\nname of the entry that caused the exception.","startLine":550,"endLine":565,"calleeNames":["__getattr__","EntryProxyAttributeError","attr_function"]},"acm000004300jsd":{"type":"ClassUnit","id":"acm000004300jsd","name":"EntryProxy","comment":"","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":455,"endLine":565,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004286jsd","acm000004287jsd","acm000004288jsd","acm000004289jsd","acm000004290jsd","acm000004291jsd","acm000004292jsd","acm000004293jsd","acm000004294jsd","acm000004295jsd","acm000004296jsd","acm000004297jsd","acm000004298jsd","acm000004299jsd"]},"acm000004301jsd":{"type":"ControlElement","id":"acm000004301jsd","name":"__init__","comment":"","startLine":84,"endLine":87,"calleeNames":["super","__init__"]},"acm000004302jsd":{"type":"ControlElement","id":"acm000004302jsd","name":"str_for_display","comment":"","startLine":632,"endLine":633,"calleeNames":["__str__"]},"acm000004303jsd":{"type":"ControlElement","id":"acm000004303jsd","name":"must_be_same","comment":"This node, which already existed, is being looked up as the specified klass. Raise an exception if it isn't.","startLine":635,"endLine":643,"calleeNames":["isinstance","TypeError","get_internal_path"]},"acm000004304jsd":{"type":"ControlElement","id":"acm000004304jsd","name":"get_dir","comment":"","startLine":645,"endLine":646,"calleeNames":[]},"acm000004305jsd":{"type":"ControlElement","id":"acm000004305jsd","name":"get_suffix","comment":"","startLine":648,"endLine":649,"calleeNames":["splitext"]},"acm000004306jsd":{"type":"ControlElement","id":"acm000004306jsd","name":"rfile","comment":"","startLine":651,"endLine":652,"calleeNames":[]},"acm000004307jsd":{"type":"ControlElement","id":"acm000004307jsd","name":"__getattr__","comment":"This is how we implement the \"special\" attributes\nsuch as base, posix, srcdir, etc.\nRaise our own AttributeError subclass with an\noverridden __str__() method that identifies the\nname of the entry that caused the exception.","startLine":550,"endLine":565,"calleeNames":["__getattr__","EntryProxyAttributeError","attr_function"]},"acm000004308jsd":{"type":"ControlElement","id":"acm000004308jsd","name":"__str__","comment":"","startLine":88,"endLine":93,"calleeNames":["get","repr"]},"acm000004309jsd":{"type":"ControlElement","id":"acm000004309jsd","name":"__lt__","comment":"less than operator used by sorting on py3","startLine":683,"endLine":685,"calleeNames":["str"]},"acm000004310jsd":{"type":"ControlElement","id":"acm000004310jsd","name":"_save_str","comment":"","startLine":688,"endLine":695,"calleeNames":["silent_intern","_get_str"]},"acm000004311jsd":{"type":"ControlElement","id":"acm000004311jsd","name":"_get_str","comment":"","startLine":697,"endLine":720,"calleeNames":["is_derived","get_path","srcnode","stat"]},"acm000004312jsd":{"type":"ControlElement","id":"acm000004312jsd","name":"stat","comment":"","startLine":725,"endLine":736,"calleeNames":["stat","get_abspath"]},"acm000004313jsd":{"type":"ControlElement","id":"acm000004313jsd","name":"lstat","comment":"","startLine":739,"endLine":750,"calleeNames":["lstat","get_abspath"]},"acm000004314jsd":{"type":"ControlElement","id":"acm000004314jsd","name":"exists","comment":"","startLine":752,"endLine":753,"calleeNames":[]},"acm000004315jsd":{"type":"ControlElement","id":"acm000004315jsd","name":"rexists","comment":"","startLine":755,"endLine":756,"calleeNames":[]},"acm000004316jsd":{"type":"ControlElement","id":"acm000004316jsd","name":"getmtime","comment":"","startLine":758,"endLine":764,"calleeNames":["stat"]},"acm000004317jsd":{"type":"ControlElement","id":"acm000004317jsd","name":"getsize","comment":"","startLine":766,"endLine":772,"calleeNames":["stat"]},"acm000004318jsd":{"type":"ControlElement","id":"acm000004318jsd","name":"isdir","comment":"","startLine":774,"endLine":776,"calleeNames":["stat","S_ISDIR"]},"acm000004319jsd":{"type":"ControlElement","id":"acm000004319jsd","name":"isfile","comment":"","startLine":778,"endLine":780,"calleeNames":["stat","S_ISREG"]},"acm000004320jsd":{"type":"ControlElement","id":"acm000004320jsd","name":"is_under","comment":"","startLine":790,"endLine":794,"calleeNames":["is_under"]},"acm000004321jsd":{"type":"ControlElement","id":"acm000004321jsd","name":"set_local","comment":"","startLine":796,"endLine":797,"calleeNames":[]},"acm000004322jsd":{"type":"ControlElement","id":"acm000004322jsd","name":"srcnode","comment":"If this node is in a build path, return the node corresponding to its source file. Otherwise, return ourself.","startLine":799,"endLine":809,"calleeNames":["srcdir_list","Entry","must_be_same"]},"acm000004323jsd":{"type":"ControlElement","id":"acm000004323jsd","name":"get_path","comment":"Return path relative to the current working directory of the Node.FS.Base object that owns us.","startLine":811,"endLine":827,"calleeNames":["getcwd","get_path_elements","index"]},"acm000004324jsd":{"type":"ControlElement","id":"acm000004324jsd","name":"set_src_builder","comment":"Set the source code builder for this node.","startLine":829,"endLine":833,"calleeNames":["has_builder","builder_set"]},"acm000004325jsd":{"type":"ControlElement","id":"acm000004325jsd","name":"src_builder","comment":"Fetch the source code builder for this node. If there isn't one, we cache the source code builder specified for the directory (which in turn will cache the value from its parent directory, and so on up to the file system root).","startLine":835,"endLine":847,"calleeNames":["src_builder"]},"acm000004326jsd":{"type":"ControlElement","id":"acm000004326jsd","name":"get_abspath","comment":"Get the absolute path of the file.","startLine":849,"endLine":851,"calleeNames":["entry_abspath"]},"acm000004327jsd":{"type":"ControlElement","id":"acm000004327jsd","name":"get_labspath","comment":"Get the absolute path of the file.","startLine":853,"endLine":855,"calleeNames":["entry_labspath"]},"acm000004328jsd":{"type":"ControlElement","id":"acm000004328jsd","name":"get_relpath","comment":"Get the path of the file relative to the root SConstruct file's directory.","startLine":857,"endLine":859,"calleeNames":["relpath","entry_abspath","get_abspath"]},"acm000004329jsd":{"type":"ControlElement","id":"acm000004329jsd","name":"get_internal_path","comment":"","startLine":861,"endLine":865,"calleeNames":["entry_path"]},"acm000004330jsd":{"type":"ControlElement","id":"acm000004330jsd","name":"get_tpath","comment":"","startLine":867,"endLine":871,"calleeNames":["entry_tpath"]},"acm000004331jsd":{"type":"ControlElement","id":"acm000004331jsd","name":"get_path_elements","comment":"","startLine":873,"endLine":874,"calleeNames":[]},"acm000004332jsd":{"type":"ControlElement","id":"acm000004332jsd","name":"for_signature","comment":"Return just our name. Even an absolute path would not work,\nbecause that can change thanks to symlinks or remapped network\npaths.","startLine":876,"endLine":880,"calleeNames":[]},"acm000004333jsd":{"type":"ControlElement","id":"acm000004333jsd","name":"get_subst_proxy","comment":"","startLine":882,"endLine":888,"calleeNames":["EntryProxy"]},"acm000004334jsd":{"type":"ControlElement","id":"acm000004334jsd","name":"target_from_source","comment":"Generates a target entry that corresponds to this entry (usually a source file) with the specified prefix and suffix. Note that this method can be overridden dynamically for generated files that need different behavior. See Tool/swig.py for an example.","startLine":890,"endLine":900,"calleeNames":[]},"acm000004335jsd":{"type":"ControlElement","id":"acm000004335jsd","name":"_Rfindalldirs_key","comment":"","startLine":902,"endLine":903,"calleeNames":[]},"acm000004336jsd":{"type":"ControlElement","id":"acm000004336jsd","name":"Rfindalldirs","comment":"Return all of the directories for a given path list, including corresponding \"backing\" directories in any repositories. The Node lookups are relative to this Node (typically a directory), so memoizing result saves cycles from looking up the same path for each target in a given directory.","startLine":906,"endLine":937,"calleeNames":["isinstance","append","create_dir_relative_to_self","extend","get_all_rdirs"]},"acm000004337jsd":{"type":"ControlElement","id":"acm000004337jsd","name":"RDirs","comment":"Search for a list of directories in the Repository list.","startLine":939,"endLine":942,"calleeNames":["Rfindalldirs"]},"acm000004338jsd":{"type":"ControlElement","id":"acm000004338jsd","name":"rentry","comment":"","startLine":945,"endLine":961,"calleeNames":["exists","_my_normcase","get_all_rdirs","entry_exists_on_disk","Entry"]},"acm000004339jsd":{"type":"ControlElement","id":"acm000004339jsd","name":"_glob1","comment":"Dict that provides a simple backward compatibility\nlayer for the Node attributes 'abspath', 'labspath',\n'relpath', 'path', 'tpath' and 'path_elements'.\n@see Base.__getattr__ above","startLine":963,"endLine":964,"calleeNames":[]},"acm000004340jsd":{"type":"ClassUnit","id":"acm000004340jsd","name":"Base","comment":"A generic class for file system entries. This class is for when we don't know yet whether the entry being looked up is a file or a directory. Instances of this class can morph into either Dir or File objects by a later, more precise lookup. Note: this class does not define __cmp__ and __hash__ for efficiency reasons. SCons does a lot of comparing of Node.FS.{Base,Entry,File,Dir} objects, so those operations must be as fast as possible, which means we want to use Python's built-in object identity comparisons.","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":568,"endLine":964,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004301jsd","acm000004302jsd","acm000004303jsd","acm000004304jsd","acm000004305jsd","acm000004306jsd","acm000004307jsd","acm000004308jsd","acm000004309jsd","acm000004310jsd","acm000004311jsd","acm000004312jsd","acm000004313jsd","acm000004314jsd","acm000004315jsd","acm000004316jsd","acm000004317jsd","acm000004318jsd","acm000004319jsd","acm000004320jsd","acm000004321jsd","acm000004322jsd","acm000004323jsd","acm000004324jsd","acm000004325jsd","acm000004326jsd","acm000004327jsd","acm000004328jsd","acm000004329jsd","acm000004330jsd","acm000004331jsd","acm000004332jsd","acm000004333jsd","acm000004334jsd","acm000004335jsd","acm000004336jsd","acm000004337jsd","acm000004338jsd","acm000004339jsd"]},"acm000004341jsd":{"type":"ControlElement","id":"acm000004341jsd","name":"__init__","comment":"","startLine":84,"endLine":87,"calleeNames":["super","__init__"]},"acm000004342jsd":{"type":"ControlElement","id":"acm000004342jsd","name":"diskcheck_match","comment":"","startLine":1006,"endLine":1007,"calleeNames":[]},"acm000004343jsd":{"type":"ControlElement","id":"acm000004343jsd","name":"disambiguate","comment":"There was nothing on-disk at this location, so look in\nthe src directory.\n\nWe can't just use self.srcnode() straight away because\nthat would create an actual Node for this file in the src\ndirectory, and there might not be one. Instead, use the\ndir_on_disk() method to see if there's something on-disk\nwith that name, in which case we can go ahead and call\nself.srcnode() to create the right type of entry.","startLine":1009,"endLine":1042,"calleeNames":["isfile","_morph","clear","isdir","srcnode","entry_exists_on_disk","get_abspath","UserError"]},"acm000004344jsd":{"type":"ControlElement","id":"acm000004344jsd","name":"rfile","comment":"","startLine":651,"endLine":652,"calleeNames":[]},"acm000004345jsd":{"type":"ControlElement","id":"acm000004345jsd","name":"scanner_key","comment":"","startLine":1052,"endLine":1053,"calleeNames":["get_suffix"]},"acm000004346jsd":{"type":"ControlElement","id":"acm000004346jsd","name":"get_contents","comment":"Fetch the contents of the entry. Returns the exact binary contents of the file.","startLine":1055,"endLine":1058,"calleeNames":[]},"acm000004347jsd":{"type":"ControlElement","id":"acm000004347jsd","name":"get_text_contents","comment":"Fetch the decoded text contents of a Unicode encoded Entry. Since this should return the text contents from the file system, we check to see into what sort of subclass we should morph this Entry.\nThere was nothing on disk with which to disambiguate\nthis entry. Leave it as an Entry, but return a null\nstring so calls to get_text_contents() in emitters and\nthe like (e.g. in qt.py) don't have to disambiguate by\nhand or catch the exception.\nnow we're a different node type, call its method to get the text.","startLine":1060,"endLine":1077,"calleeNames":["disambiguate","get_text_contents"]},"acm000004348jsd":{"type":"ControlElement","id":"acm000004348jsd","name":"must_be_same","comment":"This node, which already existed, is being looked up as the specified klass. Raise an exception if it isn't.","startLine":635,"endLine":643,"calleeNames":["isinstance","TypeError","get_internal_path"]},"acm000004349jsd":{"type":"ControlElement","id":"acm000004349jsd","name":"exists","comment":"","startLine":752,"endLine":753,"calleeNames":[]},"acm000004350jsd":{"type":"ControlElement","id":"acm000004350jsd","name":"rel_path","comment":"","startLine":1101,"endLine":1105,"calleeNames":["disambiguate","Exception","rel_path"]},"acm000004351jsd":{"type":"ControlElement","id":"acm000004351jsd","name":"new_ninfo","comment":"","startLine":1107,"endLine":1108,"calleeNames":["disambiguate","new_ninfo"]},"acm000004352jsd":{"type":"ControlElement","id":"acm000004352jsd","name":"_glob1","comment":"Dict that provides a simple backward compatibility\nlayer for the Node attributes 'abspath', 'labspath',\n'relpath', 'path', 'tpath' and 'path_elements'.\n@see Base.__getattr__ above","startLine":963,"endLine":964,"calleeNames":[]},"acm000004353jsd":{"type":"ControlElement","id":"acm000004353jsd","name":"get_subst_proxy","comment":"","startLine":882,"endLine":888,"calleeNames":["EntryProxy"]},"acm000004354jsd":{"type":"ClassUnit","id":"acm000004354jsd","name":"Entry","comment":"This is the class for generic Node.FS entries--that is, things that could be a File or a Dir, but we're just not sure yet. Consequently, the methods in this class really exist just to transform their associated object into the right class when the time comes, and then call the same-named method in the transformed class.","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":978,"endLine":1114,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004341jsd","acm000004342jsd","acm000004343jsd","acm000004344jsd","acm000004345jsd","acm000004346jsd","acm000004347jsd","acm000004348jsd","acm000004349jsd","acm000004350jsd","acm000004351jsd","acm000004352jsd","acm000004353jsd"]},"acm000004355jsd":{"type":"ControlElement","id":"acm000004355jsd","name":"chmod","comment":"","startLine":1139,"endLine":1140,"calleeNames":["chmod"]},"acm000004356jsd":{"type":"ControlElement","id":"acm000004356jsd","name":"copy","comment":"","startLine":1142,"endLine":1143,"calleeNames":["copy"]},"acm000004357jsd":{"type":"ControlElement","id":"acm000004357jsd","name":"copy2","comment":"","startLine":1145,"endLine":1146,"calleeNames":["copy2"]},"acm000004358jsd":{"type":"ControlElement","id":"acm000004358jsd","name":"exists","comment":"","startLine":752,"endLine":753,"calleeNames":[]},"acm000004359jsd":{"type":"ControlElement","id":"acm000004359jsd","name":"getmtime","comment":"","startLine":758,"endLine":764,"calleeNames":["stat"]},"acm000004360jsd":{"type":"ControlElement","id":"acm000004360jsd","name":"getsize","comment":"","startLine":766,"endLine":772,"calleeNames":["stat"]},"acm000004361jsd":{"type":"ControlElement","id":"acm000004361jsd","name":"isdir","comment":"","startLine":774,"endLine":776,"calleeNames":["stat","S_ISDIR"]},"acm000004362jsd":{"type":"ControlElement","id":"acm000004362jsd","name":"isfile","comment":"","startLine":778,"endLine":780,"calleeNames":["stat","S_ISREG"]},"acm000004363jsd":{"type":"ControlElement","id":"acm000004363jsd","name":"link","comment":"","startLine":1163,"endLine":1164,"calleeNames":["link"]},"acm000004364jsd":{"type":"ControlElement","id":"acm000004364jsd","name":"lstat","comment":"","startLine":739,"endLine":750,"calleeNames":["lstat","get_abspath"]},"acm000004365jsd":{"type":"ControlElement","id":"acm000004365jsd","name":"listdir","comment":"","startLine":1169,"endLine":1170,"calleeNames":["listdir"]},"acm000004366jsd":{"type":"ControlElement","id":"acm000004366jsd","name":"scandir","comment":"","startLine":1172,"endLine":1173,"calleeNames":["scandir"]},"acm000004367jsd":{"type":"ControlElement","id":"acm000004367jsd","name":"makedirs","comment":"","startLine":1175,"endLine":1176,"calleeNames":["makedirs"]},"acm000004368jsd":{"type":"ControlElement","id":"acm000004368jsd","name":"mkdir","comment":"","startLine":1178,"endLine":1179,"calleeNames":["mkdir"]},"acm000004369jsd":{"type":"ControlElement","id":"acm000004369jsd","name":"rename","comment":"","startLine":1181,"endLine":1182,"calleeNames":["rename"]},"acm000004370jsd":{"type":"ControlElement","id":"acm000004370jsd","name":"stat","comment":"","startLine":725,"endLine":736,"calleeNames":["stat","get_abspath"]},"acm000004371jsd":{"type":"ControlElement","id":"acm000004371jsd","name":"symlink","comment":"","startLine":1187,"endLine":1188,"calleeNames":["symlink"]},"acm000004372jsd":{"type":"ControlElement","id":"acm000004372jsd","name":"open","comment":"","startLine":1190,"endLine":1191,"calleeNames":["open"]},"acm000004373jsd":{"type":"ControlElement","id":"acm000004373jsd","name":"unlink","comment":"no symlinks","startLine":1193,"endLine":1194,"calleeNames":["unlink"]},"acm000004374jsd":{"type":"ClassUnit","id":"acm000004374jsd","name":"LocalFS","comment":"This class implements an abstraction layer for operations involving a local file system. Essentially, this wraps any function in the os, os.path or shutil modules that we use to actually go do anything with or to the local file system. Note that there's a very good chance we'll refactor this part of the architecture in some way as we really implement the interface(s) for remote file system Nodes. For example, the right architecture might be to have this be a subclass instead of a base class. Nevertheless, we're using this as a first step in that direction. We're not using chdir() yet because the calling subclass method needs to use os.chdir() directly to avoid recursion. Will we really need this one?","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":1121,"endLine":1214,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004355jsd","acm000004356jsd","acm000004357jsd","acm000004358jsd","acm000004359jsd","acm000004360jsd","acm000004361jsd","acm000004362jsd","acm000004363jsd","acm000004364jsd","acm000004365jsd","acm000004366jsd","acm000004367jsd","acm000004368jsd","acm000004369jsd","acm000004370jsd","acm000004371jsd","acm000004372jsd","acm000004373jsd"]},"acm000004375jsd":{"type":"ControlElement","id":"acm000004375jsd","name":"__init__","comment":"","startLine":84,"endLine":87,"calleeNames":["super","__init__"]},"acm000004376jsd":{"type":"ControlElement","id":"acm000004376jsd","name":"set_SConstruct_dir","comment":"","startLine":1251,"endLine":1252,"calleeNames":[]},"acm000004377jsd":{"type":"ControlElement","id":"acm000004377jsd","name":"get_max_drift","comment":"","startLine":1254,"endLine":1255,"calleeNames":[]},"acm000004378jsd":{"type":"ControlElement","id":"acm000004378jsd","name":"set_max_drift","comment":"","startLine":1257,"endLine":1258,"calleeNames":[]},"acm000004379jsd":{"type":"ControlElement","id":"acm000004379jsd","name":"getcwd","comment":"","startLine":1260,"endLine":1264,"calleeNames":["hasattr"]},"acm000004380jsd":{"type":"ControlElement","id":"acm000004380jsd","name":"chdir","comment":"Change the current working directory for lookups. If change_os_dir is true, we will also change the \"real\" cwd to match.","startLine":1266,"endLine":1279,"calleeNames":["chdir","get_abspath"]},"acm000004381jsd":{"type":"ControlElement","id":"acm000004381jsd","name":"get_root","comment":"Returns the root directory for the specified drive, creating it if necessary.","startLine":1281,"endLine":1296,"calleeNames":["_my_normcase","RootDir"]},"acm000004382jsd":{"type":"ControlElement","id":"acm000004382jsd","name":"_lookup","comment":"The generic entry point for Node lookup with user-supplied data. This translates arbitrary input into a canonical Node.FS object of the specified fsclass. The general approach for strings is to turn it into a fully normalized absolute path and then call the root directory's lookup_abs() method for the heavy lifting. If the path name begins with '#', it is unconditionally interpreted relative to the top-level directory of this FS. '#' is treated as a synonym for the top-level SConstruct directory, much like '~' is treated as a synonym for the user's home directory in a UNIX shell. So both '#foo' and '#/foo' refer to the 'foo' subdirectory underneath the top-level SConstruct directory. If the path name is relative, then the path is looked up relative to the specified directory, or the current directory (self._cwd, typically the SConscript directory) if the specified directory is None.\nIt's already a Node.FS object. Make sure it's the right\nclass and return.\nstr(p) in case it's something like a proxy object","startLine":1298,"endLine":1432,"calleeNames":["isinstance","must_be_same","str","replace","_my_splitdrive","get_root","strip","needs_normpath_match","get_labspath","rstrip","Dir","split","pop","append","join","_lookup_abs"]},"acm000004383jsd":{"type":"ControlElement","id":"acm000004383jsd","name":"Entry","comment":"Look up or create a generic Entry node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied.","startLine":1434,"endLine":1441,"calleeNames":["_lookup"]},"acm000004384jsd":{"type":"ControlElement","id":"acm000004384jsd","name":"File","comment":"Look up or create a File node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied. This method will raise TypeError if a directory is found at the specified path.","startLine":1443,"endLine":1453,"calleeNames":["_lookup"]},"acm000004385jsd":{"type":"ControlElement","id":"acm000004385jsd","name":"Dir","comment":"Look up or create a Dir node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied. This method will raise TypeError if a normal file is found at the specified path.","startLine":1455,"endLine":1465,"calleeNames":["_lookup"]},"acm000004386jsd":{"type":"ControlElement","id":"acm000004386jsd","name":"VariantDir","comment":"Link the supplied variant directory to the source directory for purposes of building files.\nWe already did this.","startLine":1467,"endLine":1481,"calleeNames":["isinstance","Dir","is_under","UserError","link"]},"acm000004387jsd":{"type":"ControlElement","id":"acm000004387jsd","name":"Repository","comment":"Specify Repository directories to search.","startLine":1483,"endLine":1488,"calleeNames":["isinstance","Dir","addRepository"]},"acm000004388jsd":{"type":"ControlElement","id":"acm000004388jsd","name":"PyPackageDir","comment":"","startLine":1490,"endLine":1507,"calleeNames":["find_spec","dirname","_lookup"]},"acm000004389jsd":{"type":"ControlElement","id":"acm000004389jsd","name":"variant_dir_target_climb","comment":"Create targets in corresponding variant directories Climb the directory tree, and look up path names relative to any linked variant directories we find. Even though this loops and walks up the tree, we don't memoize the return value because this is really only used to process the command-line targets.","startLine":1510,"endLine":1535,"calleeNames":["is_under","str","join","append","Entry","up","map"]},"acm000004390jsd":{"type":"ControlElement","id":"acm000004390jsd","name":"Glob","comment":"Globs This is mainly a shim layer","startLine":1537,"endLine":1545,"calleeNames":["getcwd","glob"]},"acm000004391jsd":{"type":"ClassUnit","id":"acm000004391jsd","name":"FS","comment":"","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":1217,"endLine":1545,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004375jsd","acm000004376jsd","acm000004377jsd","acm000004378jsd","acm000004379jsd","acm000004380jsd","acm000004381jsd","acm000004382jsd","acm000004383jsd","acm000004384jsd","acm000004385jsd","acm000004386jsd","acm000004387jsd","acm000004388jsd","acm000004389jsd","acm000004390jsd"]},"acm000004392jsd":{"type":"ControlElement","id":"acm000004392jsd","name":"str_to_node","comment":"","startLine":1554,"endLine":1563,"calleeNames":["_my_splitdrive","get_root","isabs","get_labspath","_lookup_abs"]},"acm000004393jsd":{"type":"ClassUnit","id":"acm000004393jsd","name":"DirNodeInfo","comment":"","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":1547,"endLine":1563,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004392jsd"]},"acm000004394jsd":{"type":"ClassUnit","id":"acm000004394jsd","name":"DirBuildInfo","comment":"","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":1565,"endLine":1567,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000004395jsd":{"type":"ControlElement","id":"acm000004395jsd","name":"__init__","comment":"","startLine":84,"endLine":87,"calleeNames":["super","__init__"]},"acm000004396jsd":{"type":"ControlElement","id":"acm000004396jsd","name":"_morph","comment":"Turn a file system Node (either a freshly initialized directory object or a separate Entry object) into a proper directory object. Set up this directory's entries and hook it into the file system tree. Specify that directories (this Node) don't use signatures for calculating whether they're current.","startLine":1601,"endLine":1663,"calleeNames":["silent_intern","entry_abspath","entry_labspath","entry_path","entry_tpath","hasattr","get_MkdirBuilder","get_executor","set_action_list","insert"]},"acm000004397jsd":{"type":"ControlElement","id":"acm000004397jsd","name":"diskcheck_match","comment":"","startLine":1006,"endLine":1007,"calleeNames":[]},"acm000004398jsd":{"type":"ControlElement","id":"acm000004398jsd","name":"__clearRepositoryCache","comment":"Called when we change the repository(ies) for a directory. This clears any cached information that is invalidated by changing the repository.","startLine":1669,"endLine":1685,"calleeNames":["values","isinstance","__clearRepositoryCache","clear"]},"acm000004399jsd":{"type":"ControlElement","id":"acm000004399jsd","name":"__resetDuplicate","comment":"","startLine":1687,"endLine":1689,"calleeNames":["get_dir"]},"acm000004400jsd":{"type":"ControlElement","id":"acm000004400jsd","name":"Entry","comment":"Look up or create a generic Entry node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied.","startLine":1434,"endLine":1441,"calleeNames":["_lookup"]},"acm000004401jsd":{"type":"ControlElement","id":"acm000004401jsd","name":"Dir","comment":"Look up or create a Dir node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied. This method will raise TypeError if a normal file is found at the specified path.","startLine":1455,"endLine":1465,"calleeNames":["_lookup"]},"acm000004402jsd":{"type":"ControlElement","id":"acm000004402jsd","name":"File","comment":"Look up or create a File node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied. This method will raise TypeError if a directory is found at the specified path.","startLine":1443,"endLine":1453,"calleeNames":["_lookup"]},"acm000004403jsd":{"type":"ControlElement","id":"acm000004403jsd","name":"link","comment":"","startLine":1163,"endLine":1164,"calleeNames":["link"]},"acm000004404jsd":{"type":"ControlElement","id":"acm000004404jsd","name":"getRepositories","comment":"Returns a list of repositories for this directory.","startLine":1720,"endLine":1725,"calleeNames":["get_all_rdirs"]},"acm000004405jsd":{"type":"ControlElement","id":"acm000004405jsd","name":"get_all_rdirs","comment":"","startLine":1728,"endLine":1748,"calleeNames":["list","getRepositories","append","Dir","up"]},"acm000004406jsd":{"type":"ControlElement","id":"acm000004406jsd","name":"addRepository","comment":"","startLine":1750,"endLine":1754,"calleeNames":["append","__clearRepositoryCache"]},"acm000004407jsd":{"type":"ControlElement","id":"acm000004407jsd","name":"up","comment":"","startLine":1756,"endLine":1757,"calleeNames":[]},"acm000004408jsd":{"type":"ControlElement","id":"acm000004408jsd","name":"_rel_path_key","comment":"","startLine":1759,"endLine":1760,"calleeNames":["str"]},"acm000004409jsd":{"type":"ControlElement","id":"acm000004409jsd","name":"rel_path","comment":"","startLine":1101,"endLine":1105,"calleeNames":["disambiguate","Exception","rel_path"]},"acm000004410jsd":{"type":"ControlElement","id":"acm000004410jsd","name":"get_env_scanner","comment":"","startLine":1817,"endLine":1819,"calleeNames":[]},"acm000004411jsd":{"type":"ControlElement","id":"acm000004411jsd","name":"get_target_scanner","comment":"","startLine":1821,"endLine":1823,"calleeNames":[]},"acm000004412jsd":{"type":"ControlElement","id":"acm000004412jsd","name":"get_found_includes","comment":"Return this directory's implicit dependencies. We don't bother caching the results because the scan typically shouldn't be requested more than once (as opposed to scanning .h file contents, which can be requested as many times as the files is #included by other files).\nClear cached info for this Dir. If we already visited this\ndirectory on our walk down the tree (because we didn't know at\nthat point it was being used as the source for another Node)\nthen we may have calculated build signature before realizing\nwe had to scan the disk. Now that we have to, though, we need\nto invalidate the old calculated signature so that any node\ndependent on our directory structure gets one that includes\ninfo about everything on disk.\n\nTaskmaster interface subsystem\n","startLine":1825,"endLine":1844,"calleeNames":["clear","scanner"]},"acm000004413jsd":{"type":"ControlElement","id":"acm000004413jsd","name":"prepare","comment":"","startLine":1850,"endLine":1851,"calleeNames":[]},"acm000004414jsd":{"type":"ControlElement","id":"acm000004414jsd","name":"build","comment":"A null \"builder\" for directories.\n\n\n","startLine":1853,"endLine":1857,"calleeNames":["build"]},"acm000004415jsd":{"type":"ControlElement","id":"acm000004415jsd","name":"_create","comment":"Create this directory, silently and without worrying about whether the builder is the default or not.","startLine":1863,"endLine":1893,"calleeNames":["exists","append","up","StopError","reverse","build","get_executor","nullify","clear"]},"acm000004416jsd":{"type":"ControlElement","id":"acm000004416jsd","name":"multiple_side_effect_has_builder","comment":"","startLine":1895,"endLine":1897,"calleeNames":["has_builder"]},"acm000004417jsd":{"type":"ControlElement","id":"acm000004417jsd","name":"alter_targets","comment":"Return any corresponding targets in a variant directory.","startLine":1899,"endLine":1902,"calleeNames":["variant_dir_target_climb"]},"acm000004418jsd":{"type":"ControlElement","id":"acm000004418jsd","name":"scanner_key","comment":"","startLine":1052,"endLine":1053,"calleeNames":["get_suffix"]},"acm000004419jsd":{"type":"ControlElement","id":"acm000004419jsd","name":"get_text_contents","comment":"Fetch the decoded text contents of a Unicode encoded Entry. Since this should return the text contents from the file system, we check to see into what sort of subclass we should morph this Entry.\nThere was nothing on disk with which to disambiguate\nthis entry. Leave it as an Entry, but return a null\nstring so calls to get_text_contents() in emitters and\nthe like (e.g. in qt.py) don't have to disambiguate by\nhand or catch the exception.\nnow we're a different node type, call its method to get the text.","startLine":1060,"endLine":1077,"calleeNames":["disambiguate","get_text_contents"]},"acm000004420jsd":{"type":"ControlElement","id":"acm000004420jsd","name":"get_contents","comment":"Fetch the contents of the entry. Returns the exact binary contents of the file.","startLine":1055,"endLine":1058,"calleeNames":[]},"acm000004421jsd":{"type":"ControlElement","id":"acm000004421jsd","name":"get_csig","comment":"Compute the content signature for Directory nodes. In general, this is not needed and the content signature is not stored in the DirNodeInfo. However, if get_contents on a Dir node is called which has a child directory, the child directory should return the hash of its contents.","startLine":1918,"endLine":1925,"calleeNames":["get_contents","hash_signature"]},"acm000004422jsd":{"type":"ControlElement","id":"acm000004422jsd","name":"do_duplicate","comment":"","startLine":1927,"endLine":1928,"calleeNames":[]},"acm000004423jsd":{"type":"ControlElement","id":"acm000004423jsd","name":"is_up_to_date","comment":"If any child is not up-to-date, then this directory isn't, either.","startLine":1930,"endLine":1938,"calleeNames":["exists","children","get_state"]},"acm000004424jsd":{"type":"ControlElement","id":"acm000004424jsd","name":"rdir","comment":"","startLine":1940,"endLine":1949,"calleeNames":["exists","_my_normcase","get_all_rdirs","dir_on_disk","isinstance"]},"acm000004425jsd":{"type":"ControlElement","id":"acm000004425jsd","name":"sconsign","comment":"Return the .sconsign file info for this directory.","startLine":1951,"endLine":1953,"calleeNames":[]},"acm000004426jsd":{"type":"ControlElement","id":"acm000004426jsd","name":"srcnode","comment":"If this node is in a build path, return the node corresponding to its source file. Otherwise, return ourself.","startLine":799,"endLine":809,"calleeNames":["srcdir_list","Entry","must_be_same"]},"acm000004427jsd":{"type":"ControlElement","id":"acm000004427jsd","name":"get_timestamp","comment":"Return the latest timestamp from among our children","startLine":1962,"endLine":1968,"calleeNames":["children","get_timestamp"]},"acm000004428jsd":{"type":"ControlElement","id":"acm000004428jsd","name":"get_abspath","comment":"Get the absolute path of the file.","startLine":849,"endLine":851,"calleeNames":["entry_abspath"]},"acm000004429jsd":{"type":"ControlElement","id":"acm000004429jsd","name":"get_labspath","comment":"Get the absolute path of the file.","startLine":853,"endLine":855,"calleeNames":["entry_labspath"]},"acm000004430jsd":{"type":"ControlElement","id":"acm000004430jsd","name":"get_internal_path","comment":"","startLine":861,"endLine":865,"calleeNames":["entry_path"]},"acm000004431jsd":{"type":"ControlElement","id":"acm000004431jsd","name":"get_tpath","comment":"","startLine":867,"endLine":871,"calleeNames":["entry_tpath"]},"acm000004432jsd":{"type":"ControlElement","id":"acm000004432jsd","name":"get_path_elements","comment":"","startLine":873,"endLine":874,"calleeNames":[]},"acm000004433jsd":{"type":"ControlElement","id":"acm000004433jsd","name":"entry_abspath","comment":"","startLine":1987,"endLine":1988,"calleeNames":[]},"acm000004434jsd":{"type":"ControlElement","id":"acm000004434jsd","name":"entry_labspath","comment":"","startLine":1990,"endLine":1991,"calleeNames":[]},"acm000004435jsd":{"type":"ControlElement","id":"acm000004435jsd","name":"entry_path","comment":"","startLine":1993,"endLine":1994,"calleeNames":[]},"acm000004436jsd":{"type":"ControlElement","id":"acm000004436jsd","name":"entry_tpath","comment":"","startLine":1996,"endLine":1997,"calleeNames":[]},"acm000004437jsd":{"type":"ControlElement","id":"acm000004437jsd","name":"entry_exists_on_disk","comment":"Searches through the file/dir entries of the current directory, and returns True if a physical entry with the given name could be found. @see rentry_exists_on_disk\nBelt-and-suspenders for Windows: check directly for\n8.3 file names that don't show up in os.listdir().","startLine":1999,"endLine":2028,"calleeNames":["listdir","map","_my_normcase","get","exists"]},"acm000004438jsd":{"type":"ControlElement","id":"acm000004438jsd","name":"rentry_exists_on_disk","comment":"Searches through the file/dir entries of the current *and* all its remote directories (repos), and returns True if a physical entry with the given name could be found. The local directory (self) gets searched first, so repositories take a lower precedence regarding the searching order. @see entry_exists_on_disk","startLine":2030,"endLine":2055,"calleeNames":["entry_exists_on_disk","_my_normcase","get_all_rdirs"]},"acm000004439jsd":{"type":"ControlElement","id":"acm000004439jsd","name":"srcdir_list","comment":"","startLine":2058,"endLine":2076,"calleeNames":["append","Dir","up"]},"acm000004440jsd":{"type":"ControlElement","id":"acm000004440jsd","name":"srcdir_duplicate","comment":"We shouldn't source from something in the build path;\nvariant_dir is probably under src_dir, in which case\nwe are reflecting.","startLine":2078,"endLine":2093,"calleeNames":["srcdir_list","is_under","entry_exists_on_disk","Entry","disambiguate","do_duplicate"]},"acm000004441jsd":{"type":"ControlElement","id":"acm000004441jsd","name":"_srcdir_find_file_key","comment":"","startLine":2095,"endLine":2096,"calleeNames":[]},"acm000004442jsd":{"type":"ControlElement","id":"acm000004442jsd","name":"srcdir_find_file","comment":"","startLine":2099,"endLine":2140,"calleeNames":["isinstance","is_derived","exists","_my_normcase","get_all_rdirs","file_on_disk","func","srcdir_list","File"]},"acm000004443jsd":{"type":"ControlElement","id":"acm000004443jsd","name":"dir_on_disk","comment":"","startLine":2142,"endLine":2149,"calleeNames":["entry_exists_on_disk","Dir","srcdir_duplicate","isinstance"]},"acm000004444jsd":{"type":"ControlElement","id":"acm000004444jsd","name":"file_on_disk","comment":"","startLine":2151,"endLine":2158,"calleeNames":["entry_exists_on_disk","File","srcdir_duplicate","isinstance"]},"acm000004445jsd":{"type":"ControlElement","id":"acm000004445jsd","name":"walk","comment":"Walk this directory tree by calling the specified function for each directory in the tree. This behaves like the os.path.walk() function, but for in-memory Node.FS.Dir objects. The function takes the same arguments as the functions passed to os.path.walk(): func(arg, dirname, fnames) Except that \"dirname\" will actually be the directory *Node*, not the string. The '.' and '..' entries are excluded from fnames. The fnames list may be modified in-place to filter the subdirectories visited or otherwise impose a specific order. The \"arg\" argument is always passed to func() and may be used in any way (or ignored, passing None is common).","startLine":2160,"endLine":2184,"calleeNames":["list","keys","remove","func","isinstance","walk"]},"acm000004446jsd":{"type":"ControlElement","id":"acm000004446jsd","name":"glob","comment":"Returns a list of Nodes (or strings) matching a pathname pattern. Pathname patterns follow POSIX shell syntax:: * matches everything ? matches any single character [seq] matches any character in seq (ranges allowed) [!seq] matches any char not in seq The wildcard characters can be escaped by enclosing in brackets. A leading dot is not matched by a wildcard, and needs to be explicitly included in the pattern to be matched. Matches also do not span directory separators. The matches take into account Repositories, returning a local Node if a corresponding entry exists in a Repository (either an in-memory Node or something on disk). The underlying algorithm is adapted from a rather old version of :func:`glob.glob` function in the Python standard library (heavily modified), and uses :func:`fnmatch.fnmatch` under the covers. This is the internal implementation of the external Glob API. Args: pattern: pathname pattern to match. ondisk: if false, restricts matches to in-memory Nodes. By defafult, matches entries that exist on-disk in addition to in-memory Nodes. source: if true, corresponding source Nodes are returned if globbing in a variant directory. The default behavior is to return Nodes local to the variant directory. strings: if true, returns the matches as strings instead of Nodes. The strings are path names relative to this directory. exclude: if not ``None``, must be a pattern or a list of patterns following the same POSIX shell semantics. Elements matching at least one pattern from *exclude* will be excluded from the result.","startLine":2186,"endLine":2247,"calleeNames":["split","_glob1","has_glob_magic","glob","Dir","join","str","extend","flatten","any","fnmatch","sorted"]},"acm000004447jsd":{"type":"ControlElement","id":"acm000004447jsd","name":"_glob1","comment":"Dict that provides a simple backward compatibility\nlayer for the Node attributes 'abspath', 'labspath',\n'relpath', 'path', 'tpath' and 'path_elements'.\n@see Base.__getattr__ above","startLine":963,"endLine":964,"calleeNames":[]},"acm000004448jsd":{"type":"ClassUnit","id":"acm000004448jsd","name":"Dir","comment":"A class for directories in a file system.","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":1574,"endLine":2315,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004395jsd","acm000004396jsd","acm000004397jsd","acm000004398jsd","acm000004399jsd","acm000004400jsd","acm000004401jsd","acm000004402jsd","acm000004403jsd","acm000004404jsd","acm000004405jsd","acm000004406jsd","acm000004407jsd","acm000004408jsd","acm000004409jsd","acm000004410jsd","acm000004411jsd","acm000004412jsd","acm000004413jsd","acm000004414jsd","acm000004415jsd","acm000004416jsd","acm000004417jsd","acm000004418jsd","acm000004419jsd","acm000004420jsd","acm000004421jsd","acm000004422jsd","acm000004423jsd","acm000004424jsd","acm000004425jsd","acm000004426jsd","acm000004427jsd","acm000004428jsd","acm000004429jsd","acm000004430jsd","acm000004431jsd","acm000004432jsd","acm000004433jsd","acm000004434jsd","acm000004435jsd","acm000004436jsd","acm000004437jsd","acm000004438jsd","acm000004439jsd","acm000004440jsd","acm000004441jsd","acm000004442jsd","acm000004443jsd","acm000004444jsd","acm000004445jsd","acm000004446jsd","acm000004447jsd"]},"acm000004449jsd":{"type":"ControlElement","id":"acm000004449jsd","name":"__init__","comment":"","startLine":84,"endLine":87,"calleeNames":["super","__init__"]},"acm000004450jsd":{"type":"ControlElement","id":"acm000004450jsd","name":"_morph","comment":"Turn a file system Node (either a freshly initialized directory object or a separate Entry object) into a proper directory object. Set up this directory's entries and hook it into the file system tree. Specify that directories (this Node) don't use signatures for calculating whether they're current.","startLine":1601,"endLine":1663,"calleeNames":["silent_intern","entry_abspath","entry_labspath","entry_path","entry_tpath","hasattr","get_MkdirBuilder","get_executor","set_action_list","insert"]},"acm000004451jsd":{"type":"ControlElement","id":"acm000004451jsd","name":"must_be_same","comment":"This node, which already existed, is being looked up as the specified klass. Raise an exception if it isn't.","startLine":635,"endLine":643,"calleeNames":["isinstance","TypeError","get_internal_path"]},"acm000004452jsd":{"type":"ControlElement","id":"acm000004452jsd","name":"_lookup_abs","comment":"Fast (?) lookup of a *normalized* absolute path. This method is intended for use by internal lookups with already-normalized path data. For general-purpose lookups, use the FS.Entry(), FS.Dir() or FS.File() methods. The caller is responsible for making sure we're passed a normalized absolute path; we merely let Python's dictionary look up and return the One True Node.FS object for the path. If a Node for the specified \"p\" doesn't already exist, and \"create\" is specified, the Node may be created after recursive invocation to find or create the parent directory or directories.","startLine":2432,"endLine":2472,"calleeNames":["_my_normcase","str","UserError","rsplit","_lookup_abs","klass","diskcheck_match","must_be_same"]},"acm000004453jsd":{"type":"ControlElement","id":"acm000004453jsd","name":"__str__","comment":"","startLine":88,"endLine":93,"calleeNames":["get","repr"]},"acm000004454jsd":{"type":"ControlElement","id":"acm000004454jsd","name":"entry_abspath","comment":"","startLine":1987,"endLine":1988,"calleeNames":[]},"acm000004455jsd":{"type":"ControlElement","id":"acm000004455jsd","name":"entry_labspath","comment":"","startLine":1990,"endLine":1991,"calleeNames":[]},"acm000004456jsd":{"type":"ControlElement","id":"acm000004456jsd","name":"entry_path","comment":"","startLine":1993,"endLine":1994,"calleeNames":[]},"acm000004457jsd":{"type":"ControlElement","id":"acm000004457jsd","name":"entry_tpath","comment":"","startLine":1996,"endLine":1997,"calleeNames":[]},"acm000004458jsd":{"type":"ControlElement","id":"acm000004458jsd","name":"is_under","comment":"","startLine":790,"endLine":794,"calleeNames":["is_under"]},"acm000004459jsd":{"type":"ControlElement","id":"acm000004459jsd","name":"up","comment":"","startLine":1756,"endLine":1757,"calleeNames":[]},"acm000004460jsd":{"type":"ControlElement","id":"acm000004460jsd","name":"get_dir","comment":"","startLine":645,"endLine":646,"calleeNames":[]},"acm000004461jsd":{"type":"ControlElement","id":"acm000004461jsd","name":"src_builder","comment":"Fetch the source code builder for this node. If there isn't one, we cache the source code builder specified for the directory (which in turn will cache the value from its parent directory, and so on up to the file system root).","startLine":835,"endLine":847,"calleeNames":["src_builder"]},"acm000004462jsd":{"type":"ClassUnit","id":"acm000004462jsd","name":"RootDir","comment":"A class for the root directory of a file system. This is the same as a Dir class, except that the path separator ('/' or '\\\\') is actually part of the name, so we don't need to add a separator when creating the path names of entries within this directory.","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":2317,"endLine":2499,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004449jsd","acm000004450jsd","acm000004451jsd","acm000004452jsd","acm000004453jsd","acm000004454jsd","acm000004455jsd","acm000004456jsd","acm000004457jsd","acm000004458jsd","acm000004459jsd","acm000004460jsd","acm000004461jsd"]},"acm000004463jsd":{"type":"ControlElement","id":"acm000004463jsd","name":"str_to_node","comment":"","startLine":1554,"endLine":1563,"calleeNames":["_my_splitdrive","get_root","isabs","get_labspath","_lookup_abs"]},"acm000004464jsd":{"type":"ControlElement","id":"acm000004464jsd","name":"__getstate__","comment":"Return all fields that shall be pickled. Walk the slots in the class hierarchy and add those to the state dictionary. If a '__dict__' slot is available, copy all entries to the dictionary. Also include the version id, which is fixed for all instances of a class.","startLine":2522,"endLine":2541,"calleeNames":["getattr","copy","type","mro","hasattr"]},"acm000004465jsd":{"type":"ControlElement","id":"acm000004465jsd","name":"__setstate__","comment":"Restore the attributes from a pickled state.\nTODO check or discard version","startLine":2543,"endLine":2551,"calleeNames":["items","setattr"]},"acm000004466jsd":{"type":"ControlElement","id":"acm000004466jsd","name":"__eq__","comment":"","startLine":2553,"endLine":2554,"calleeNames":[]},"acm000004467jsd":{"type":"ControlElement","id":"acm000004467jsd","name":"__ne__","comment":"","startLine":2556,"endLine":2557,"calleeNames":["__eq__"]},"acm000004468jsd":{"type":"ClassUnit","id":"acm000004468jsd","name":"FileNodeInfo","comment":"","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":2502,"endLine":2557,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004463jsd","acm000004464jsd","acm000004465jsd","acm000004466jsd","acm000004467jsd"]},"acm000004469jsd":{"type":"ControlElement","id":"acm000004469jsd","name":"__setattr__","comment":"If any attributes are changed in FileBuildInfo, we need to\ninvalidate the cached map of file name to content signature\nheald in dependency_map. Currently only used with\nMD5-timestamp decider","startLine":2578,"endLine":2587,"calleeNames":["hasattr","super","__setattr__"]},"acm000004470jsd":{"type":"ControlElement","id":"acm000004470jsd","name":"convert_to_sconsign","comment":"Converts this FileBuildInfo object for writing to a .sconsign file This replaces each Node in our various dependency lists with its usual string representation: relative to the top-level SConstruct directory, or an absolute path if it's outside.","startLine":2589,"endLine":2614,"calleeNames":["get_internal_path","str","replace","getattr","setattr","list","map"]},"acm000004471jsd":{"type":"ControlElement","id":"acm000004471jsd","name":"convert_from_sconsign","comment":"Converts a newly-read FileBuildInfo object for in-SCons use For normal up-to-date checking, we don't have any conversion to perform--but we're leaving this method here to make that clear.","startLine":2616,"endLine":2623,"calleeNames":[]},"acm000004472jsd":{"type":"ControlElement","id":"acm000004472jsd","name":"prepare_dependencies","comment":"Prepares a FileBuildInfo object for explaining what changed The bsources, bdepends and bimplicit lists have all been stored on disk as paths relative to the top-level SConstruct directory. Convert the strings to actual Nodes (for use by the --debug=explain code and --implicit-cache).","startLine":2625,"endLine":2652,"calleeNames":["getattr","zip","isinstance","str_to_node","append","setattr"]},"acm000004473jsd":{"type":"ControlElement","id":"acm000004473jsd","name":"format","comment":"","startLine":2654,"endLine":2664,"calleeNames":["zip","append","str","join","format","hasattr"]},"acm000004474jsd":{"type":"ClassUnit","id":"acm000004474jsd","name":"FileBuildInfo","comment":"This is info loaded from sconsign. Attributes unique to FileBuildInfo: dependency_map : Caches file->csig mapping for all dependencies. Currently this is only used when using MD5-timestamp decider. It's used to ensure that we copy the correct csig from the previous build to be written to .sconsign when current build is done. Previously the matching of csig to file was strictly by order they appeared in bdepends, bsources, or bimplicit, and so a change in order or count of any of these could yield writing wrong csig, and then false positive rebuilds","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":2560,"endLine":2664,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004469jsd","acm000004470jsd","acm000004471jsd","acm000004472jsd","acm000004473jsd"]},"acm000004475jsd":{"type":"ControlElement","id":"acm000004475jsd","name":"diskcheck_match","comment":"","startLine":1006,"endLine":1007,"calleeNames":[]},"acm000004476jsd":{"type":"ControlElement","id":"acm000004476jsd","name":"__init__","comment":"","startLine":84,"endLine":87,"calleeNames":["super","__init__"]},"acm000004477jsd":{"type":"ControlElement","id":"acm000004477jsd","name":"Entry","comment":"Look up or create a generic Entry node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied.","startLine":1434,"endLine":1441,"calleeNames":["_lookup"]},"acm000004478jsd":{"type":"ControlElement","id":"acm000004478jsd","name":"Dir","comment":"Look up or create a Dir node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied. This method will raise TypeError if a normal file is found at the specified path.","startLine":1455,"endLine":1465,"calleeNames":["_lookup"]},"acm000004479jsd":{"type":"ControlElement","id":"acm000004479jsd","name":"Dirs","comment":"Create a list of directories relative to the SConscript directory of this file.","startLine":2711,"endLine":2714,"calleeNames":["Dir"]},"acm000004480jsd":{"type":"ControlElement","id":"acm000004480jsd","name":"File","comment":"Look up or create a File node with the specified name. If the name is a relative path (begins with ./, ../, or a file name), then it is looked up relative to the supplied directory node, or to the top level directory of the FS (supplied at construction time) if no directory is supplied. This method will raise TypeError if a directory is found at the specified path.","startLine":1443,"endLine":1453,"calleeNames":["_lookup"]},"acm000004481jsd":{"type":"ControlElement","id":"acm000004481jsd","name":"_morph","comment":"Turn a file system Node (either a freshly initialized directory object or a separate Entry object) into a proper directory object. Set up this directory's entries and hook it into the file system tree. Specify that directories (this Node) don't use signatures for calculating whether they're current.","startLine":1601,"endLine":1663,"calleeNames":["silent_intern","entry_abspath","entry_labspath","entry_path","entry_tpath","hasattr","get_MkdirBuilder","get_executor","set_action_list","insert"]},"acm000004482jsd":{"type":"ControlElement","id":"acm000004482jsd","name":"scanner_key","comment":"","startLine":1052,"endLine":1053,"calleeNames":["get_suffix"]},"acm000004483jsd":{"type":"ControlElement","id":"acm000004483jsd","name":"get_contents","comment":"Fetch the contents of the entry. Returns the exact binary contents of the file.","startLine":1055,"endLine":1058,"calleeNames":[]},"acm000004484jsd":{"type":"ControlElement","id":"acm000004484jsd","name":"get_text_contents","comment":"Fetch the decoded text contents of a Unicode encoded Entry. Since this should return the text contents from the file system, we check to see into what sort of subclass we should morph this Entry.\nThere was nothing on disk with which to disambiguate\nthis entry. Leave it as an Entry, but return a null\nstring so calls to get_text_contents() in emitters and\nthe like (e.g. in qt.py) don't have to disambiguate by\nhand or catch the exception.\nnow we're a different node type, call its method to get the text.","startLine":1060,"endLine":1077,"calleeNames":["disambiguate","get_text_contents"]},"acm000004485jsd":{"type":"ControlElement","id":"acm000004485jsd","name":"get_content_hash","comment":"Compute and return the hash for this file.\nspecial marker to help distinguish from empty file","startLine":2761,"endLine":2773,"calleeNames":["rexists","hash_signature","rfile","get_abspath","hash_file_signature"]},"acm000004486jsd":{"type":"ControlElement","id":"acm000004486jsd","name":"get_size","comment":"sentinel value for doesn't exist, even in repository","startLine":2776,"endLine":2789,"calleeNames":["rexists","rfile","getsize"]},"acm000004487jsd":{"type":"ControlElement","id":"acm000004487jsd","name":"get_timestamp","comment":"Return the latest timestamp from among our children","startLine":1962,"endLine":1968,"calleeNames":["children","get_timestamp"]},"acm000004488jsd":{"type":"ControlElement","id":"acm000004488jsd","name":"convert_old_entry","comment":"Convert a .sconsign entry from before the Big Signature\nRefactoring, doing what we can to convert its information\nto the new .sconsign entry format.\n\nThe old format looked essentially like this:\n\nBuildInfo\n.ninfo (NodeInfo)\n.bsig\n.csig\n.timestamp\n.size\n.bsources\n.bsourcesigs (\"signature\" list)\n.bdepends\n.bdependsigs (\"signature\" list)\n.bimplicit\n.bimplicitsigs (\"signature\" list)\n.bact\n.bactsig\n\nThe new format looks like this:\n\n.ninfo (NodeInfo)\n.bsig\n.csig\n.timestamp\n.size\n.binfo (BuildInfo)\n.bsources\n.bsourcesigs (NodeInfo list)\n.bsig\n.csig\n.timestamp\n.size\n.bdepends\n.bdependsigs (NodeInfo list)\n.bsig\n.csig\n.timestamp\n.size\n.bimplicit\n.bimplicitsigs (NodeInfo list)\n.bsig\n.csig\n.timestamp\n.size\n.bact\n.bactsig\n\nThe basic idea of the new structure is that a NodeInfo always\nholds all available information about the state of a given Node\nat a certain point in time. The various .b*sigs lists can just\nbe a list of pointers to the .ninfo attributes of the different\ndependent nodes, without any copying of information until it's\ntime to pickle it for writing out to a .sconsign file.\n\nThe complicating issue is that the *old* format only stored one\n\"signature\" per dependency, based on however the *last* build\nwas configured. We don't know from just looking at it whether\nit was a build signature, a content signature, or a timestamp\n\"signature\". Since we no longer use build signatures, the\nbest we can do is look at the length and if it's thirty two,\nassume that it was (or might have been) a content signature.\nIf it was actually a build signature, then it will cause a\nrebuild anyway when it doesn't match the new content signature,\nbut that's probably the best we can do.","startLine":2821,"endLine":2915,"calleeNames":["SConsignEntry","new_binfo","getattr","setattr","delattr","new_ninfo","len","append"]},"acm000004489jsd":{"type":"ControlElement","id":"acm000004489jsd","name":"get_stored_info","comment":"This is a .sconsign file from before the Big Signature\nRefactoring; convert it as best we can.","startLine":2918,"endLine":2943,"calleeNames":["sconsign","get_entry","SConsignEntry","new_binfo","new_ninfo","isinstance","convert_old_entry","delattr"]},"acm000004490jsd":{"type":"ControlElement","id":"acm000004490jsd","name":"get_stored_implicit","comment":"","startLine":2945,"endLine":2949,"calleeNames":["get_stored_info","prepare_dependencies"]},"acm000004491jsd":{"type":"ControlElement","id":"acm000004491jsd","name":"rel_path","comment":"","startLine":1101,"endLine":1105,"calleeNames":["disambiguate","Exception","rel_path"]},"acm000004492jsd":{"type":"ControlElement","id":"acm000004492jsd","name":"_get_found_includes_key","comment":"","startLine":2954,"endLine":2955,"calleeNames":["id"]},"acm000004493jsd":{"type":"ControlElement","id":"acm000004493jsd","name":"get_found_includes","comment":"Return this directory's implicit dependencies. We don't bother caching the results because the scan typically shouldn't be requested more than once (as opposed to scanning .h file contents, which can be requested as many times as the files is #included by other files).\nClear cached info for this Dir. If we already visited this\ndirectory on our walk down the tree (because we didn't know at\nthat point it was being used as the source for another Node)\nthen we may have calculated build signature before realizing\nwe had to scan the disk. Now that we have to, though, we need\nto invalidate the old calculated signature so that any node\ndependent on our directory structure gets one that includes\ninfo about everything on disk.\n\nTaskmaster interface subsystem\n","startLine":1825,"endLine":1844,"calleeNames":["clear","scanner"]},"acm000004494jsd":{"type":"ControlElement","id":"acm000004494jsd","name":"_createDir","comment":"ensure that the directories for this node are\ncreated.","startLine":2984,"endLine":2987,"calleeNames":["_create"]},"acm000004495jsd":{"type":"ControlElement","id":"acm000004495jsd","name":"push_to_cache","comment":"Try to push the node into a cache\nThis should get called before the Nodes' .built() method is\ncalled, which would clear the build signature if the file has\na source scanner.\n\nWe have to clear the local memoized values *before* we push\nthe node to cache so that the memoization of the self.exists()\nreturn value doesn't interfere.","startLine":2989,"endLine":3003,"calleeNames":["clear_memoized_values","exists","get_build_env","get_CacheDir","push"]},"acm000004496jsd":{"type":"ControlElement","id":"acm000004496jsd","name":"retrieve_from_cache","comment":"Try to retrieve the node's content from a cache This method is called from multiple threads in a parallel build, so only do thread safe stuff here. Do thread unsafe stuff in built(). Returns True if the node was successfully retrieved.","startLine":3005,"endLine":3018,"calleeNames":["is_derived","get_build_env","get_CacheDir","retrieve"]},"acm000004497jsd":{"type":"ControlElement","id":"acm000004497jsd","name":"visited","comment":"","startLine":3020,"endLine":3041,"calleeNames":["exists","get_build_env","get_CacheDir","push_if_forced","get_ninfo","get_max_drift_csig","get_timestamp","get_size","has_builder","get_stored_info","get_binfo","merge"]},"acm000004498jsd":{"type":"ControlElement","id":"acm000004498jsd","name":"release_target_info","comment":"Called just after this node has been marked up-to-date or was built completely. This is where we try to release as many target node infos as possible for clean builds and update runs, in order to minimize the overall memory consumption. We'd like to remove a lot more attributes like self.sources and self.sources_set, but they might get used in a next build step. For example, during configuration the source files for a built E{*}.o file are used to figure out which linker to use for the resulting Program (gcc vs. g++)! That's why we check for the 'keep_targetinfo' attribute, config Nodes and the Interactive mode just don't allow an early release of most variables. In the same manner, we can't simply remove the self.attributes here. The smart linking relies on the shared flag, and some parts of the java Tool use it to transport information about nodes... @see: built() and Node.release_target_info()\nCache some required values, before releasing\nstuff like env, executor and builder...\nNow purge unneeded stuff to free memory...\nCleanup lists, but only if they're empty\nMark this node as done, we only have to release\nthe memory once...","startLine":3043,"endLine":3093,"calleeNames":["hasattr","changed","get_contents_sig","get_build_env","pop","len"]},"acm000004499jsd":{"type":"ControlElement","id":"acm000004499jsd","name":"find_src_builder","comment":"","startLine":3095,"endLine":3108,"calleeNames":["rexists","src_builder","builder_set"]},"acm000004500jsd":{"type":"ControlElement","id":"acm000004500jsd","name":"has_src_builder","comment":"Return whether this Node has a source builder or not. If this Node doesn't have an explicit source code builder, this is where we figure out, on the fly, if there's a transparent source code builder for it. Note that if we found a source builder, we also set the self.builder attribute, so that all of the methods that actually *build* this file don't have to do anything different.","startLine":3110,"endLine":3125,"calleeNames":["find_src_builder"]},"acm000004501jsd":{"type":"ControlElement","id":"acm000004501jsd","name":"alter_targets","comment":"Return any corresponding targets in a variant directory.","startLine":1899,"endLine":1902,"calleeNames":["variant_dir_target_climb"]},"acm000004502jsd":{"type":"ControlElement","id":"acm000004502jsd","name":"_rmv_existing","comment":"","startLine":3134,"endLine":3140,"calleeNames":["clear_memoized_values","print","Unlink","isinstance"]},"acm000004503jsd":{"type":"ControlElement","id":"acm000004503jsd","name":"make_ready","comment":"","startLine":3146,"endLine":3148,"calleeNames":["has_src_builder","get_binfo"]},"acm000004504jsd":{"type":"ControlElement","id":"acm000004504jsd","name":"prepare","comment":"","startLine":1850,"endLine":1851,"calleeNames":[]},"acm000004505jsd":{"type":"ControlElement","id":"acm000004505jsd","name":"remove","comment":"Remove this file.","startLine":3171,"endLine":3176,"calleeNames":["exists","islink","unlink","get_internal_path"]},"acm000004506jsd":{"type":"ControlElement","id":"acm000004506jsd","name":"do_duplicate","comment":"","startLine":1927,"endLine":1928,"calleeNames":[]},"acm000004507jsd":{"type":"ControlElement","id":"acm000004507jsd","name":"exists","comment":"","startLine":752,"endLine":753,"calleeNames":[]},"acm000004508jsd":{"type":"ControlElement","id":"acm000004508jsd","name":"get_max_drift_csig","comment":"Returns the content signature currently stored for this node if it's been unmodified longer than the max_drift value, or the max_drift value is 0. Returns None otherwise.","startLine":3207,"endLine":3231,"calleeNames":["get_stored_info","get_timestamp","time"]},"acm000004509jsd":{"type":"ControlElement","id":"acm000004509jsd","name":"get_csig","comment":"Compute the content signature for Directory nodes. In general, this is not needed and the content signature is not stored in the DirNodeInfo. However, if get_contents on a Dir node is called which has a child directory, the child directory should return the hash of its contents.","startLine":1918,"endLine":1925,"calleeNames":["get_contents","hash_signature"]},"acm000004510jsd":{"type":"ControlElement","id":"acm000004510jsd","name":"builder_set","comment":"","startLine":3269,"endLine":3271,"calleeNames":["builder_set"]},"acm000004511jsd":{"type":"ControlElement","id":"acm000004511jsd","name":"built","comment":"Called just after this File node is successfully built. Just like for 'release_target_info' we try to release some more target node attributes in order to minimize the overall memory consumption. @see: release_target_info\nEnsure that the build infos get computed and cached...\n... then release some more variables.","startLine":3273,"endLine":3295,"calleeNames":["built","hasattr","_save_str"]},"acm000004512jsd":{"type":"ControlElement","id":"acm000004512jsd","name":"changed","comment":"Returns if the node is up-to-date with respect to the BuildInfo stored last time it was built. For File nodes this is basically a wrapper around Node.changed(), but we allow the return value to get cached after the reference to the Executor got released in release_target_info(). @see: Node.changed()","startLine":3297,"endLine":3317,"calleeNames":["changed"]},"acm000004513jsd":{"type":"ControlElement","id":"acm000004513jsd","name":"changed_content","comment":"","startLine":3319,"endLine":3324,"calleeNames":["get_csig"]},"acm000004514jsd":{"type":"ControlElement","id":"acm000004514jsd","name":"changed_state","comment":"Caching node -> string mapping for the below method","startLine":3326,"endLine":3327,"calleeNames":[]},"acm000004515jsd":{"type":"ControlElement","id":"acm000004515jsd","name":"_build_dependency_map","comment":"Build mapping from file -> signature Args: self - self binfo - buildinfo from node being considered Returns: dictionary of file->signature mappings\nFor an \"empty\" binfo properties like bsources\ndo not exist: check this to avoid exception.","startLine":3335,"endLine":3356,"calleeNames":["len","zip","chain"]},"acm000004516jsd":{"type":"ControlElement","id":"acm000004516jsd","name":"_add_strings_to_dependency_map","comment":"In the case comparing node objects isn't sufficient, we'll add the strings for the nodes to the dependency map :return:","startLine":3359,"endLine":3371,"calleeNames":["str","next","iter","items","update"]},"acm000004517jsd":{"type":"ControlElement","id":"acm000004517jsd","name":"_get_previous_signatures","comment":"Return a list of corresponding csigs from previous build in order of the node/files in children. Args: self - self dmap - Dictionary of file -> csig Returns: List of csigs for provided list of children","startLine":3373,"endLine":3451,"calleeNames":["len","print","str","id","type","get","rfile","append","replace","_add_strings_to_dependency_map","get_path","FileBuildInfoFileToCsigMappingError"]},"acm000004518jsd":{"type":"ControlElement","id":"acm000004518jsd","name":"changed_timestamp_then_content","comment":"Used when decider for file is Timestamp-MD5 NOTE: If the timestamp hasn't changed this will skip md5'ing the file and just copy the prev_ni provided. If the prev_ni is wrong. It will propagate it. See: https://github.com/SCons/scons/issues/2980 Args: self - dependency target - target prev_ni - The NodeInfo object loaded from previous builds .sconsign node - Node instance. Check this node for file existence/timestamp if specified. Returns: Boolean - Indicates if node(File) has changed.\nNow get sconsign name -> csig map and then get proper prev_ni if possible","startLine":3453,"endLine":3512,"calleeNames":["get_stored_info","_build_dependency_map","len","print","get_csig","_get_previous_signatures","changed_timestamp_match","str","get_ninfo","changed_content"]},"acm000004519jsd":{"type":"ControlElement","id":"acm000004519jsd","name":"changed_timestamp_newer","comment":"","startLine":3514,"endLine":3518,"calleeNames":["get_timestamp"]},"acm000004520jsd":{"type":"ControlElement","id":"acm000004520jsd","name":"changed_timestamp_match","comment":"Return True if the timestamps don't match or if there is no previous timestamp :param target: :param prev_ni: Information about the node from the previous build :return:","startLine":3520,"endLine":3530,"calleeNames":["get_timestamp"]},"acm000004521jsd":{"type":"ControlElement","id":"acm000004521jsd","name":"is_up_to_date","comment":"If any child is not up-to-date, then this directory isn't, either.","startLine":1930,"endLine":1938,"calleeNames":["exists","children","get_state"]},"acm000004522jsd":{"type":"ControlElement","id":"acm000004522jsd","name":"rfile","comment":"","startLine":651,"endLine":652,"calleeNames":[]},"acm000004523jsd":{"type":"ControlElement","id":"acm000004523jsd","name":"find_repo_file","comment":"For this node, find if there exists a corresponding file in one or more repositories :return: list of corresponding files in repositories","startLine":3602,"endLine":3621,"calleeNames":["_my_normcase","get_all_rdirs","file_on_disk","exists","isinstance","is_derived","append"]},"acm000004524jsd":{"type":"ControlElement","id":"acm000004524jsd","name":"rstr","comment":"","startLine":3624,"endLine":3625,"calleeNames":["str","rfile"]},"acm000004525jsd":{"type":"ControlElement","id":"acm000004525jsd","name":"get_cachedir_csig","comment":"Fetch a Node's content signature for purposes of computing another Node's cachesig. This is a wrapper around the normal get_csig() method that handles the somewhat obscure case of using CacheDir with the -n option. Any files that don't exist would normally be \"built\" by fetching them from the cache, but the normal get_csig() method will try to open up the local file, which doesn't exist because the -n option meant we didn't actually pull the file from cachedir. But since the file *does* actually exist in the cachedir, we can use its contents for the csig.","startLine":3627,"endLine":3652,"calleeNames":["get_build_env","get_CacheDir","cachepath","exists","get_cachedir_csig","get_csig"]},"acm000004526jsd":{"type":"ControlElement","id":"acm000004526jsd","name":"get_contents_sig","comment":"A helper method for get_cachedir_bsig. It computes and returns the signature for this node's contents.","startLine":3654,"endLine":3670,"calleeNames":["get_executor","hash_signature","get_contents"]},"acm000004527jsd":{"type":"ControlElement","id":"acm000004527jsd","name":"get_cachedir_bsig","comment":"Return the signature for a cached file, including its children. It adds the path of the cached file to the cache signature, because multiple targets built by the same action will all have the same build signature, and we have to differentiate them somehow. Signature should normally be string of hex digits.\nCollect signatures for all children","startLine":3672,"endLine":3701,"calleeNames":["children","get_cachedir_csig","append","get_contents_sig","get_internal_path","hash_collect"]},"acm000004528jsd":{"type":"ClassUnit","id":"acm000004528jsd","name":"File","comment":"A class for files in a file system.","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":2667,"endLine":3701,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004475jsd","acm000004476jsd","acm000004477jsd","acm000004478jsd","acm000004479jsd","acm000004480jsd","acm000004481jsd","acm000004482jsd","acm000004483jsd","acm000004484jsd","acm000004485jsd","acm000004486jsd","acm000004487jsd","acm000004488jsd","acm000004489jsd","acm000004490jsd","acm000004491jsd","acm000004492jsd","acm000004493jsd","acm000004494jsd","acm000004495jsd","acm000004496jsd","acm000004497jsd","acm000004498jsd","acm000004499jsd","acm000004500jsd","acm000004501jsd","acm000004502jsd","acm000004503jsd","acm000004504jsd","acm000004505jsd","acm000004506jsd","acm000004507jsd","acm000004508jsd","acm000004509jsd","acm000004510jsd","acm000004511jsd","acm000004512jsd","acm000004513jsd","acm000004514jsd","acm000004515jsd","acm000004516jsd","acm000004517jsd","acm000004518jsd","acm000004519jsd","acm000004520jsd","acm000004521jsd","acm000004522jsd","acm000004523jsd","acm000004524jsd","acm000004525jsd","acm000004526jsd","acm000004527jsd"]},"acm000004529jsd":{"type":"ControlElement","id":"acm000004529jsd","name":"__init__","comment":"","startLine":84,"endLine":87,"calleeNames":["super","__init__"]},"acm000004530jsd":{"type":"ControlElement","id":"acm000004530jsd","name":"filedir_lookup","comment":"A helper method for find_file() that looks up a directory for a file we're trying to find. This only creates the Dir Node if it exists on-disk, since if the directory doesn't exist we know we won't find any files in it... :-) It would be more compact to just use this as a nested function with a default keyword argument (see the commented-out version below), but that doesn't work unless you have nested scopes, so we define it here just so this work under Python 1.5.2.\nreturn p.fs.get_root(drive).dir_on_disk(name)","startLine":3718,"endLine":3751,"calleeNames":["split","_my_splitdrive","get_root","filedir_lookup","_my_normcase","dir_on_disk","isinstance","must_be_same"]},"acm000004531jsd":{"type":"ControlElement","id":"acm000004531jsd","name":"_find_file_key","comment":"Note: paths could be a list, which is not hashable. If it is, convert\nit to a tuple, which is hashable.","startLine":3753,"endLine":3757,"calleeNames":["tuple","isinstance"]},"acm000004532jsd":{"type":"ControlElement","id":"acm000004532jsd","name":"find_file","comment":"Find a node corresponding to either a derived file or a file that exists already. Only the first file found is returned, and none is returned if no file is found. filename: A filename to find paths: A list of directory path *nodes* to search in. Can be represented as a list, a tuple, or a callable that is called with no arguments and returns the list or tuple. returns The node created from the found file.","startLine":3760,"endLine":3808,"calleeNames":["_find_file_key","callable","is_String","write","split","map","verbose","srcdir_find_file"]},"acm000004533jsd":{"type":"ClassUnit","id":"acm000004533jsd","name":"FileFinder","comment":"","compilationUnitId":"acm000004552jsd","parentDatatypeId":null,"startLine":3711,"endLine":3808,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004529jsd","acm000004530jsd","acm000004531jsd","acm000004532jsd"]},"acm000004534jsd":{"type":"ControlElement","id":"acm000004534jsd","name":"sconsign_none","comment":"","startLine":62,"endLine":63,"calleeNames":[]},"acm000004535jsd":{"type":"ControlElement","id":"acm000004535jsd","name":"sconsign_dir","comment":"Return the .sconsign file info for this directory, creating it first if necessary.","startLine":65,"endLine":71,"calleeNames":["ForDirectory"]},"acm000004536jsd":{"type":"ControlElement","id":"acm000004536jsd","name":"save_strings","comment":"","startLine":119,"endLine":121,"calleeNames":[]},"acm000004537jsd":{"type":"ControlElement","id":"acm000004537jsd","name":"initialize_do_splitdrive","comment":"splitunc is removed from python 3.7 and newer\nso we can also just test if splitdrive works with UNC","startLine":133,"endLine":169,"calleeNames":["splitdrive","hasattr"]},"acm000004538jsd":{"type":"ControlElement","id":"acm000004538jsd","name":"_copy_func","comment":"","startLine":255,"endLine":258,"calleeNames":["copy2","stat","chmod","S_IMODE"]},"acm000004539jsd":{"type":"ControlElement","id":"acm000004539jsd","name":"set_duplicate","comment":"Fill in the Link_Funcs list according to the argument\n(discarding those not available on the platform).\nSet up the dictionary that maps the argument names to the\nunderlying implementations. We do this inside this function,\nnot in the top-level module code, so that we can remap os.link\nand os.symlink for testing purposes.","startLine":266,"endLine":287,"calleeNames":["InternalError","split","append"]},"acm000004540jsd":{"type":"ControlElement","id":"acm000004540jsd","name":"LinkFunc","comment":"Relative paths cause problems with symbolic links, so we use absolute paths, which may be a problem for people who want to move their soft-linked src-trees around. Those people should use the 'hard-copy' mode, softlinks cannot be used for that; at least I have no idea how ...","startLine":289,"endLine":321,"calleeNames":["get_abspath","split","isdir","makedirs","set_duplicate","func"]},"acm000004541jsd":{"type":"ControlElement","id":"acm000004541jsd","name":"LocalString","comment":"","startLine":324,"endLine":325,"calleeNames":[]},"acm000004542jsd":{"type":"ControlElement","id":"acm000004542jsd","name":"UnlinkFunc","comment":"","startLine":329,"endLine":332,"calleeNames":["unlink","get_abspath"]},"acm000004543jsd":{"type":"ControlElement","id":"acm000004543jsd","name":"MkdirFunc","comment":"","startLine":336,"endLine":354,"calleeNames":["exists","get_abspath","mkdir"]},"acm000004544jsd":{"type":"ControlElement","id":"acm000004544jsd","name":"get_MkdirBuilder","comment":"\"env\" will get filled in by Executor.get_build_env()\ncalling SCons.Defaults.DefaultEnvironment() when necessary.","startLine":360,"endLine":373,"calleeNames":["Builder"]},"acm000004545jsd":{"type":"ControlElement","id":"acm000004545jsd","name":"do_diskcheck_match","comment":"","startLine":418,"endLine":432,"calleeNames":["predicate","TypeError","get_abspath"]},"acm000004546jsd":{"type":"ControlElement","id":"acm000004546jsd","name":"ignore_diskcheck_match","comment":"","startLine":435,"endLine":436,"calleeNames":[]},"acm000004547jsd":{"type":"ControlElement","id":"acm000004547jsd","name":"set_diskcheck","comment":"","startLine":446,"endLine":448,"calleeNames":["enable"]},"acm000004548jsd":{"type":"ControlElement","id":"acm000004548jsd","name":"diskcheck_types","comment":"","startLine":451,"endLine":452,"calleeNames":[]},"acm000004549jsd":{"type":"ControlElement","id":"acm000004549jsd","name":"has_glob_magic","comment":"","startLine":1571,"endLine":1572,"calleeNames":["search"]},"acm000004550jsd":{"type":"ControlElement","id":"acm000004550jsd","name":"get_default_fs","comment":"","startLine":3705,"endLine":3709,"calleeNames":["FS"]},"acm000004551jsd":{"type":"ControlElement","id":"acm000004551jsd","name":"invalidate_node_memos","comment":"Invalidate the memoized values of all Nodes (files or directories) that are associated with the given entries. Has been added to clear the cache of nodes affected by a direct execution of an action (e.g. Delete/Copy/Chmod). Existing Node caches become inconsistent if the action is run through Execute(). The argument `targets` can be a single Node object or filename, or a sequence of Nodes/filenames.\nFirst check if the cache really needs to be flushed. Only\nactions run in the SConscript with Execute() seem to be\naffected. XXX The way to check if Execute() is in the stacktrace\nis a very dirty hack and should be replaced by a more sensible\nsolution.\nDont have to invalidate, so return\nIf the target is a Node object, clear the cache. If it is a\nfilename, look up potentially existing Node object first.\nNot a Node object, try to look up Node by filename. XXX\nThis creates Node objects even for those filenames which\ndo not correspond to an existing Node object.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":3813,"endLine":3851,"calleeNames":["extract_stack","is_List","clear_memoized_values","get_default_fs","Entry"]},"acm000004552jsd":{"type":"CodeCompilationUnit","id":"acm000004552jsd","name":"FS","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nFile system nodes. These Nodes represent the canonical external objects that people think of when they think of building software: files and directories. This holds a \"default_fs\" variable that should be initialized with an FS that can be used by scripts or modules looking for the canonical default.","parentId":"acm000005002jsd","content":["acm000004277jsd","acm000004280jsd","acm000004281jsd","acm000004285jsd","acm000004300jsd","acm000004340jsd","acm000004354jsd","acm000004374jsd","acm000004391jsd","acm000004393jsd","acm000004394jsd","acm000004448jsd","acm000004462jsd","acm000004468jsd","acm000004474jsd","acm000004528jsd","acm000004533jsd","acm000004534jsd","acm000004535jsd","acm000004536jsd","acm000004537jsd","acm000004538jsd","acm000004539jsd","acm000004540jsd","acm000004541jsd","acm000004542jsd","acm000004543jsd","acm000004544jsd","acm000004545jsd","acm000004546jsd","acm000004547jsd","acm000004548jsd","acm000004549jsd","acm000004550jsd","acm000004551jsd"],"pathElements":["Node"],"extension":"py","language":"PYTHON3","importedModuleNames":["codecs","fnmatch","importlib.util","os","re","shutil","stat","sys","time","itertools.chain","typing.Optional","SCons.Action","SCons.Debug","SCons.Errors","SCons.Memoize","SCons.Node","SCons.Node.Alias","SCons.Subst","SCons.Util","SCons.Warnings","SCons.Debug.logInstanceCreation","SCons.Debug.Trace","SCons.Util.hash_signature","SCons.Util.hash_file_signature","SCons.Util.hash_collect","SCons.Defaults","SCons.SConsign","traceback.extract_stack"]},"acm000004553jsd":{"type":"ControlElement","id":"acm000004553jsd","name":"__init__","comment":"","startLine":49,"endLine":53,"calleeNames":[]},"acm000004554jsd":{"type":"ControlElement","id":"acm000004554jsd","name":"path","comment":"","startLine":55,"endLine":56,"calleeNames":[]},"acm000004555jsd":{"type":"ControlElement","id":"acm000004555jsd","name":"__call__","comment":"","startLine":58,"endLine":59,"calleeNames":[]},"acm000004556jsd":{"type":"ControlElement","id":"acm000004556jsd","name":"__hash__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000004557jsd":{"type":"ControlElement","id":"acm000004557jsd","name":"select","comment":"","startLine":64,"endLine":65,"calleeNames":[]},"acm0000