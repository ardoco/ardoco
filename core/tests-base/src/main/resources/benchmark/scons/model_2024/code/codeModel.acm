Prefixes","_p","Virtualenv","_msg"]},"acm000005074jsd":{"type":"ControlElement","id":"acm000005074jsd","name":"test_not_none","comment":"","startLine":227,"endLine":239,"calleeNames":["_p","repr","SysPrefixes","Virtualenv","_msg"]},"acm000005075jsd":{"type":"ClassUnit","id":"acm000005075jsd","name":"VirtualenvTestCase","comment":"","compilationUnitId":"acm000005077jsd","parentDatatypeId":null,"startLine":215,"endLine":239,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005073jsd","acm000005074jsd"]},"acm000005076jsd":{"type":"ControlElement","id":"acm000005076jsd","name":"_p","comment":"Converts path string **p** from posix format to os-specific format.","startLine":120,"endLine":126,"calleeNames":["startswith","split","join"]},"acm000005077jsd":{"type":"CodeCompilationUnit","id":"acm000005077jsd","name":"virtualenvTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTODO: issue #4376: since Python 3.12, CPython's posixpath.py does a test\nimport of 'posix', expecting it to fail on win32. However, if\nSCons/Platform is in sys.path, it will find our posix module instead.\nThis happens in this unittest, since it's the script path. Remove\nit before the stdlib imports. Better way to handle this problem?\npylint: disable=wrong-import-position\npylint: enable=wrong-import-position","parentId":"acm000005102jsd","content":["acm000005054jsd","acm000005062jsd","acm000005065jsd","acm000005068jsd","acm000005072jsd","acm000005075jsd","acm000005076jsd"],"pathElements":["Platform"],"extension":"py","language":"PYTHON3","importedModuleNames":["sys","collections","unittest","os","SCons.compat","SCons.Platform.virtualenv","SCons.Util"]},"acm000005078jsd":{"type":"ControlElement","id":"acm000005078jsd","name":"__init__","comment":"","startLine":287,"endLine":289,"calleeNames":[]},"acm000005079jsd":{"type":"ClassUnit","id":"acm000005079jsd","name":"ArchDefinition","comment":"Determine which windows CPU were running on. A class for defining architecture-specific settings and logic.","compilationUnitId":"acm000005088jsd","parentDatatypeId":null,"startLine":282,"endLine":289,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005078jsd"]},"acm000005080jsd":{"type":"ControlElement","id":"acm000005080jsd","name":"piped_spawn","comment":"There is no direct way to do that in python. What we do\nhere should work for most cases:\nIn case stdout (stderr) is not redirected to a file,\nwe redirect it into a temporary file tmpFileStdout\n(tmpFileStderr) and copy the contents of this file\nto stdout (stderr) given in the argument\nNote that because this will paste shell redirection syntax\ninto the cmdline, we have to call a shell to run the command,\neven though that's a bit of a performance hit.\none temporary file for stdout and stderr\ndon't need open until the subproc is done\ncheck if output is redirected","startLine":114,"endLine":184,"calleeNames":["write","mkstemp","close","find","append","escape","join","spawnve","open","read","decode","remove"]},"acm000005081jsd":{"type":"ControlElement","id":"acm000005081jsd","name":"exec_spawn","comment":"","startLine":187,"endLine":204,"calleeNames":["spawnve","write","len","join"]},"acm000005082jsd":{"type":"ControlElement","id":"acm000005082jsd","name":"spawn","comment":"Windows does not allow special characters in file names anyway, so no\nneed for a complex escape function, we will just quote the arg, except\nthat \"cmd /c\" requires that if an argument ends with a backslash it\nneeds to be escaped so as not to interfere with closing double quote\nthat we add.","startLine":207,"endLine":211,"calleeNames":["write","exec_spawn","escape","join"]},"acm000005083jsd":{"type":"ControlElement","id":"acm000005083jsd","name":"escape","comment":"Get the windows system directory name","startLine":218,"endLine":221,"calleeNames":[]},"acm000005084jsd":{"type":"ControlElement","id":"acm000005084jsd","name":"get_system_root","comment":"A resonable default if we can't read the registry","startLine":227,"endLine":253,"calleeNames":["get","RegOpenKeyEx","RegQueryValueEx"]},"acm000005085jsd":{"type":"ControlElement","id":"acm000005085jsd","name":"get_program_files_dir","comment":"Get the location of the program files directory Returns -------\nNow see if we can look in the registry...","startLine":256,"endLine":279,"calleeNames":["RegOpenKeyEx","RegQueryValueEx","join","dirname","get_system_root"]},"acm000005086jsd":{"type":"ControlElement","id":"acm000005086jsd","name":"get_architecture","comment":"Returns the definition for the specified architecture string. If no string is specified, the system default is returned (as defined by the registry PROCESSOR_ARCHITECTURE value, PROCESSOR_ARCHITEW6432 environment variable, PROCESSOR_ARCHITECTURE environment variable, or the platform machine).","startLine":320,"endLine":342,"calleeNames":["RegOpenKeyEx","RegQueryValueEx","get","ArchDefinition","machine"]},"acm000005087jsd":{"type":"ControlElement","id":"acm000005087jsd","name":"generate","comment":"Attempt to find cmd.exe (for WinNT/2k/XP) or\ncommand.com for Win9x","startLine":345,"endLine":440,"calleeNames":["RegOpenKeyEx","RegQueryValueEx","join","get_system_root","WhereIs","Detect","get","AppendENVPath","get_architecture","ImportVirtualenv"]},"acm000005088jsd":{"type":"CodeCompilationUnit","id":"acm000005088jsd","name":"win32","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nPlatform-specific initialization for Win32 systems. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Platform.Platform() selection method.","parentId":"acm000005102jsd","content":["acm000005079jsd","acm000005080jsd","acm000005081jsd","acm000005082jsd","acm000005083jsd","acm000005084jsd","acm000005085jsd","acm000005086jsd","acm000005087jsd"],"pathElements":["Platform"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","os.path","platform","sys","tempfile","SCons.Platform.posix.exitvalmap","SCons.Platform.TempFileMunge","SCons.Platform.virtualenv.ImportVirtualenv","SCons.Platform.virtualenv.ignore_virtualenv","SCons.Platform.virtualenv.enable_virtualenv","SCons.Util"]},"acm000005089jsd":{"type":"ControlElement","id":"acm000005089jsd","name":"__init__","comment":"","startLine":133,"endLine":135,"calleeNames":[]},"acm000005090jsd":{"type":"ControlElement","id":"acm000005090jsd","name":"__call__","comment":"","startLine":137,"endLine":138,"calleeNames":["generate"]},"acm000005091jsd":{"type":"ControlElement","id":"acm000005091jsd","name":"__str__","comment":"","startLine":140,"endLine":141,"calleeNames":[]},"acm000005092jsd":{"type":"ClassUnit","id":"acm000005092jsd","name":"PlatformSpec","comment":"","compilationUnitId":"acm000005101jsd","parentDatatypeId":null,"startLine":132,"endLine":141,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005089jsd","acm000005090jsd","acm000005091jsd"]},"acm000005093jsd":{"type":"ControlElement","id":"acm000005093jsd","name":"__init__","comment":"","startLine":133,"endLine":135,"calleeNames":[]},"acm000005094jsd":{"type":"ControlElement","id":"acm000005094jsd","name":"__call__","comment":"","startLine":137,"endLine":138,"calleeNames":["generate"]},"acm000005095jsd":{"type":"ControlElement","id":"acm000005095jsd","name":"_print_cmd_str","comment":"check if the user has specified a cmd line print function","startLine":326,"endLine":341,"calleeNames":["get","_ActionAction","print_cmd_line","print_func"]},"acm000005096jsd":{"type":"ClassUnit","id":"acm000005096jsd","name":"TempFileMunge","comment":"Convert long command lines to use a temporary file. You can set an Environment variable (usually ``TEMPFILE``) to this, then call it with a string argument, and it will perform temporary file substitution on it. This is used to circumvent limitations on the length of command lines. Example:: env[\"TEMPFILE\"] = TempFileMunge env[\"LINKCOM\"] = \"${TEMPFILE('$LINK $TARGET $SOURCES','$LINKCOMSTR')}\" By default, the name of the temporary file used begins with a prefix of '@'. This may be configured for other tool chains by setting the ``TEMPFILEPREFIX`` variable. Example:: env[\"TEMPFILEPREFIX\"] = '-@' # diab compiler env[\"TEMPFILEPREFIX\"] = '-via' # arm tool chain env[\"TEMPFILEPREFIX\"] = '' # (the empty string) PC Lint You can configure the extension of the temporary file through the ``TEMPFILESUFFIX`` variable, which defaults to '.lnk' (see comments in the code below). Example:: env[\"TEMPFILESUFFIX\"] = '.lnt' # PC Lint Entries in the temporary file are separated by the value of the ``TEMPFILEARGJOIN`` variable, which defaults to an OS-appropriate value. A default argument escape function is ``SCons.Subst.quote_spaces``. If you need to apply extra operations on a command argument before writing to a temporary file(fix Windows slashes, normalize paths, etc.), please set `TEMPFILEARGESCFUNC` variable to a custom function. Example:: import sys import re from SCons.Subst import quote_spaces WINPATHSEP_RE = re.compile(r\"\\\\([^\\\"'\\\\]|$)\") def tempfile_arg_esc_func(arg): arg = quote_spaces(arg) if sys.platform != \"win32\": return arg # GCC requires double Windows slashes, let's use UNIX separator return WINPATHSEP_RE.sub(r\"/\\1\", arg) env[\"TEMPFILEARGESCFUNC\"] = tempfile_arg_esc_func","compilationUnitId":"acm000005101jsd","parentDatatypeId":null,"startLine":144,"endLine":341,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005093jsd","acm000005094jsd","acm000005095jsd"]},"acm000005097jsd":{"type":"ControlElement","id":"acm000005097jsd","name":"platform_default","comment":"","startLine":55,"endLine":83,"calleeNames":["find"]},"acm000005098jsd":{"type":"ControlElement","id":"acm000005098jsd","name":"platform_module","comment":"Return the imported module for the platform. This looks for a module name that matches the specified argument. If the name is unspecified, we fetch the appropriate default for our execution environment.","startLine":86,"endLine":124,"calleeNames":["import_module","zipimporter","hasattr","load_module","find_spec","module_from_spec","exec_module","UserError","setattr"]},"acm000005099jsd":{"type":"ControlElement","id":"acm000005099jsd","name":"DefaultToolList","comment":"Select a default tool list for the specified platform.","startLine":127,"endLine":129,"calleeNames":["tool_list"]},"acm000005100jsd":{"type":"ControlElement","id":"acm000005100jsd","name":"Platform","comment":"Select a canned Platform specification.","startLine":344,"endLine":349,"calleeNames":["platform_module","PlatformSpec"]},"acm000005101jsd":{"type":"CodeCompilationUnit","id":"acm000005101jsd","name":"__init__","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons platform selection. Looks for modules that define a callable object that can modify a construction environment as appropriate for a given platform. Note that we take a more simplistic view of \"platform\" than Python does. We're looking for a single string that determines a set of tool-independent variables with which to initialize a construction environment. Consequently, we'll examine both sys.platform and os.name (and anything else that might come in to play) in order to return some specification which is unique enough for our purposes. Note that because this subsystem just *selects* a callable that can modify a construction environment, it's possible for people to define their own \"platform specification\" in an arbitrary callable function. No one needs to use or tie in to this subsystem in order to roll their own platform definition.","parentId":"acm000005102jsd","content":["acm000005092jsd","acm000005096jsd","acm000005097jsd","acm000005098jsd","acm000005099jsd","acm000005100jsd"],"pathElements":["Platform"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.compat","importlib","os","sys","tempfile","SCons.Errors","SCons.Subst","SCons.Tool"]},"acm000005102jsd":{"type":"CodePackage","id":"acm000005102jsd","name":"Platform","comment":"","parentId":null,"content":["acm000005005jsd","acm000005007jsd","acm000005009jsd","acm000005011jsd","acm000005013jsd","acm000005014jsd","acm000005016jsd","acm000005030jsd","acm000005037jsd","acm000005039jsd","acm000005050jsd","acm000005077jsd","acm000005088jsd","acm000005101jsd"]},"acm000005103jsd":{"type":"ControlElement","id":"acm000005103jsd","name":"__init__","comment":"","startLine":44,"endLine":46,"calleeNames":["super","__init__"]},"acm000005104jsd":{"type":"ControlElement","id":"acm000005104jsd","name":"initialize_result","comment":"","startLine":48,"endLine":49,"calleeNames":["UniqueList"]},"acm000005105jsd":{"type":"ControlElement","id":"acm000005105jsd","name":"finalize_result","comment":"","startLine":51,"endLine":52,"calleeNames":[]},"acm000005106jsd":{"type":"ControlElement","id":"acm000005106jsd","name":"find_include_file","comment":"","startLine":54,"endLine":59,"calleeNames":["find_file","append"]},"acm000005107jsd":{"type":"ControlElement","id":"acm000005107jsd","name":"read_file","comment":"","startLine":61,"endLine":66,"calleeNames":["rfile","get_text_contents","append"]},"acm000005108jsd":{"type":"ClassUnit","id":"acm000005108jsd","name":"SConsCPPScanner","comment":"SCons-specific subclass of the cpp.py module's processing. We subclass this so that: 1) we can deal with files represented by Nodes, not strings; 2) we can keep track of the files that are missing.","compilationUnitId":"acm000005127jsd","parentDatatypeId":null,"startLine":37,"endLine":66,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005103jsd","acm000005104jsd","acm000005105jsd","acm000005106jsd","acm000005107jsd"]},"acm000005109jsd":{"type":"ControlElement","id":"acm000005109jsd","name":"__init__","comment":"","startLine":44,"endLine":46,"calleeNames":["super","__init__"]},"acm000005110jsd":{"type":"ControlElement","id":"acm000005110jsd","name":"__call__","comment":"","startLine":137,"endLine":148,"calleeNames":["SConsCPPScanner","get_dir","dictify_CPPDEFINES","cpp","warn"]},"acm000005111jsd":{"type":"ControlElement","id":"acm000005111jsd","name":"recurse_nodes","comment":"","startLine":150,"endLine":151,"calleeNames":[]},"acm000005112jsd":{"type":"ControlElement","id":"acm000005112jsd","name":"select","comment":"","startLine":152,"endLine":153,"calleeNames":[]},"acm000005113jsd":{"type":"ClassUnit","id":"acm000005113jsd","name":"SConsCPPScannerWrapper","comment":"The SCons wrapper around a cpp.py scanner. This is the actual glue between the calling conventions of generic SCons scanners, and the (subclass of) cpp.py class that knows how to look for #include lines with reasonably real C-preprocessor-like evaluation of #if/#ifdef/#else/#elif lines.","compilationUnitId":"acm000005127jsd","parentDatatypeId":null,"startLine":124,"endLine":153,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005109jsd","acm000005110jsd","acm000005111jsd","acm000005112jsd"]},"acm000005114jsd":{"type":"ControlElement","id":"acm000005114jsd","name":"__init__","comment":"","startLine":44,"endLine":46,"calleeNames":["super","__init__"]},"acm000005115jsd":{"type":"ControlElement","id":"acm000005115jsd","name":"initialize_result","comment":"","startLine":48,"endLine":49,"calleeNames":["UniqueList"]},"acm000005116jsd":{"type":"ControlElement","id":"acm000005116jsd","name":"find_include_file","comment":"","startLine":54,"endLine":59,"calleeNames":["find_file","append"]},"acm000005117jsd":{"type":"ControlElement","id":"acm000005117jsd","name":"read_file","comment":"","startLine":61,"endLine":66,"calleeNames":["rfile","get_text_contents","append"]},"acm000005118jsd":{"type":"ClassUnit","id":"acm000005118jsd","name":"SConsCPPConditionalScanner","comment":"SCons-specific subclass of the cpp.py module's processing. We subclass this so that: 1) we can deal with files represented by Nodes, not strings; 2) we can keep track of the files that are missing.","compilationUnitId":"acm000005127jsd","parentDatatypeId":null,"startLine":179,"endLine":216,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005114jsd","acm000005115jsd","acm000005116jsd","acm000005117jsd"]},"acm000005119jsd":{"type":"ControlElement","id":"acm000005119jsd","name":"__init__","comment":"","startLine":44,"endLine":46,"calleeNames":["super","__init__"]},"acm000005120jsd":{"type":"ControlElement","id":"acm000005120jsd","name":"__call__","comment":"","startLine":137,"endLine":148,"calleeNames":["SConsCPPScanner","get_dir","dictify_CPPDEFINES","cpp","warn"]},"acm000005121jsd":{"type":"ControlElement","id":"acm000005121jsd","name":"recurse_nodes","comment":"","startLine":150,"endLine":151,"calleeNames":[]},"acm000005122jsd":{"type":"ControlElement","id":"acm000005122jsd","name":"select","comment":"","startLine":152,"endLine":153,"calleeNames":[]},"acm000005123jsd":{"type":"ClassUnit","id":"acm000005123jsd","name":"SConsCPPConditionalScannerWrapper","comment":"The SCons wrapper around a cpp.py scanner. This is the actual glue between the calling conventions of generic SCons scanners, and the (subclass of) cpp.py class that knows how to look for #include lines with reasonably real C-preprocessor-like evaluation of #if/#ifdef/#else/#elif lines.","compilationUnitId":"acm000005127jsd","parentDatatypeId":null,"startLine":219,"endLine":252,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005119jsd","acm000005120jsd","acm000005121jsd","acm000005122jsd"]},"acm000005124jsd":{"type":"ControlElement","id":"acm000005124jsd","name":"dictify_CPPDEFINES","comment":"Returns CPPDEFINES converted to a dict. This should be similar to :func:`~SCons.Defaults.processDefines`. Unfortunately, we can't do the simple thing of calling that routine and passing the result to the dict() constructor, because it turns the defines into a list of \"name=value\" pairs, which the dict constructor won't consume correctly. Also cannot just call dict on CPPDEFINES itself - it's fine if it's stored in the converted form (currently deque of tuples), but CPPDEFINES could be in other formats too. So we have to do all the work here - keep concepts in sync with ``processDefines``.","startLine":68,"endLine":122,"calleeNames":["get","is_Tuple","is_Sequence","is_String","split","is_Dict"]},"acm000005125jsd":{"type":"ControlElement","id":"acm000005125jsd","name":"CScanner","comment":"Return a prototype Scanner instance for scanning source files that use the C pre-processor\nHere's how we would (or might) use the CPP scanner code above that\nknows how to evaluate #if/#ifdef/#else/#elif lines when searching\nfor #includes. This is commented out for now until we add the\nright configurability to let users pick between the scanners.\nreturn SConsCPPScannerWrapper(\"CScanner\", \"CPPPATH\")","startLine":155,"endLine":171,"calleeNames":["ClassicCPP"]},"acm000005126jsd":{"type":"ControlElement","id":"acm000005126jsd","name":"CConditionalScanner","comment":"Return an advanced conditional Scanner instance for scanning source files Interprets C/C++ Preprocessor conditional syntax (#ifdef, #if, defined, #else, #elif, etc.).\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":255,"endLine":262,"calleeNames":["SConsCPPConditionalScannerWrapper"]},"acm000005127jsd":{"type":"CodeCompilationUnit","id":"acm000005127jsd","name":"C","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nDependency scanner for C/C++ code. Two scanners are defined here: the default CScanner, and the optional CConditionalScanner, which must be explicitly selected by calling add_scanner() for each affected suffix.","parentId":"acm000005623jsd","content":["acm000005108jsd","acm000005113jsd","acm000005118jsd","acm000005123jsd","acm000005124jsd","acm000005125jsd","acm000005126jsd"],"pathElements":["Scanner"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Node.FS","SCons.cpp","SCons.Util","ClassicCPP","FindPathDirs"]},"acm000005128jsd":{"type":"ControlElement","id":"acm000005128jsd","name":"__init__","comment":"","startLine":204,"endLine":207,"calleeNames":["super","__init__","update","FS","workpath"]},"acm000005129jsd":{"type":"ControlElement","id":"acm000005129jsd","name":"Dictionary","comment":"","startLine":209,"endLine":210,"calleeNames":[]},"acm000005130jsd":{"type":"ControlElement","id":"acm000005130jsd","name":"subst","comment":"","startLine":212,"endLine":215,"calleeNames":[]},"acm000005131jsd":{"type":"ControlElement","id":"acm000005131jsd","name":"subst_list","comment":"","startLine":217,"endLine":220,"calleeNames":[]},"acm000005132jsd":{"type":"ControlElement","id":"acm000005132jsd","name":"subst_path","comment":"","startLine":222,"endLine":225,"calleeNames":["isinstance","list","map"]},"acm000005133jsd":{"type":"ControlElement","id":"acm000005133jsd","name":"get_calculator","comment":"","startLine":227,"endLine":228,"calleeNames":[]},"acm000005134jsd":{"type":"ControlElement","id":"acm000005134jsd","name":"get_factory","comment":"","startLine":230,"endLine":231,"calleeNames":[]},"acm000005135jsd":{"type":"ControlElement","id":"acm000005135jsd","name":"Dir","comment":"","startLine":233,"endLine":234,"calleeNames":["Dir"]},"acm000005136jsd":{"type":"ControlElement","id":"acm000005136jsd","name":"File","comment":"","startLine":236,"endLine":237,"calleeNames":["File"]},"acm000005137jsd":{"type":"ClassUnit","id":"acm000005137jsd","name":"DummyEnvironment","comment":"","compilationUnitId":"acm000005177jsd","parentDatatypeId":null,"startLine":203,"endLine":237,"exten