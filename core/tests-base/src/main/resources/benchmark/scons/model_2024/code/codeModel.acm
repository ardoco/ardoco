E IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000005623jsd","content":["acm000005518jsd","acm000005524jsd","acm000005533jsd","acm000005535jsd","acm000005537jsd","acm000005561jsd","acm000005573jsd","acm000005575jsd","acm000005581jsd","acm000005583jsd","acm000005584jsd"],"pathElements":["Scanner"],"extension":"py","language":"PYTHON3","importedModuleNames":["collections","unittest","TestUnit","SCons.compat","SCons.Scanner","SCons.Scanner.ScannerBase","SCons.Scanner.Selector","SCons.Scanner.Classic","SCons.Scanner.ClassicCPP","SCons.Scanner.Current","SCons.Scanner.FindPathDirs"]},"acm000005586jsd":{"type":"ControlElement","id":"acm000005586jsd","name":"SWIGScanner","comment":"","startLine":30,"endLine":33,"calleeNames":["ClassicCPP"]},"acm000005587jsd":{"type":"CodeCompilationUnit","id":"acm000005587jsd","name":"SWIG","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nDependency scanner for SWIG code.","parentId":"acm000005623jsd","content":["acm000005586jsd"],"pathElements":["Scanner"],"extension":"py","language":"PYTHON3","importedModuleNames":["ClassicCPP"]},"acm000005588jsd":{"type":"ClassUnit","id":"acm000005588jsd","name":"_Null","comment":"This is used instead of None as a default argument value so None can be\nused as an actual argument value.","compilationUnitId":"acm000005622jsd","parentDatatypeId":null,"startLine":33,"endLine":34,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000005589jsd":{"type":"ControlElement","id":"acm000005589jsd","name":"__init__","comment":"","startLine":62,"endLine":63,"calleeNames":[]},"acm000005590jsd":{"type":"ControlElement","id":"acm000005590jsd","name":"__call__","comment":"","startLine":65,"endLine":73,"calleeNames":["PathList","subst_path","tuple","Rfindalldirs"]},"acm000005591jsd":{"type":"ClassUnit","id":"acm000005591jsd","name":"FindPathDirs","comment":"Class to bind a specific E{*}PATH variable name to a function that will return all of the E{*}path directories.","compilationUnitId":"acm000005622jsd","parentDatatypeId":null,"startLine":58,"endLine":73,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005589jsd","acm000005590jsd"]},"acm000005592jsd":{"type":"ControlElement","id":"acm000005592jsd","name":"__init__","comment":"","startLine":62,"endLine":63,"calleeNames":[]},"acm000005593jsd":{"type":"ControlElement","id":"acm000005593jsd","name":"path","comment":"","startLine":191,"endLine":198,"calleeNames":["path_function"]},"acm000005594jsd":{"type":"ControlElement","id":"acm000005594jsd","name":"__call__","comment":"","startLine":65,"endLine":73,"calleeNames":["PathList","subst_path","tuple","Rfindalldirs"]},"acm000005595jsd":{"type":"ControlElement","id":"acm000005595jsd","name":"__eq__","comment":"other probably doesn't have a __dict__","startLine":231,"endLine":236,"calleeNames":[]},"acm000005596jsd":{"type":"ControlElement","id":"acm000005596jsd","name":"__hash__","comment":"","startLine":238,"endLine":239,"calleeNames":["id"]},"acm000005597jsd":{"type":"ControlElement","id":"acm000005597jsd","name":"__str__","comment":"","startLine":241,"endLine":242,"calleeNames":[]},"acm000005598jsd":{"type":"ControlElement","id":"acm000005598jsd","name":"add_skey","comment":"Add a skey to the list of skeys","startLine":244,"endLine":246,"calleeNames":["append"]},"acm000005599jsd":{"type":"ControlElement","id":"acm000005599jsd","name":"get_skeys","comment":"","startLine":248,"endLine":251,"calleeNames":["is_String","subst_list"]},"acm000005600jsd":{"type":"ControlElement","id":"acm000005600jsd","name":"select","comment":"","startLine":253,"endLine":261,"calleeNames":["is_Dict","scanner_key"]},"acm000005601jsd":{"type":"ControlElement","id":"acm000005601jsd","name":"_recurse_all_nodes","comment":"","startLine":264,"endLine":265,"calleeNames":[]},"acm000005602jsd":{"type":"ControlElement","id":"acm000005602jsd","name":"_recurse_no_nodes","comment":"recurse_nodes = _recurse_no_nodes","startLine":268,"endLine":269,"calleeNames":[]},"acm000005603jsd":{"type":"ControlElement","id":"acm000005603jsd","name":"add_scanner","comment":"","startLine":273,"endLine":275,"calleeNames":["add_skey"]},"acm000005604jsd":{"type":"ClassUnit","id":"acm000005604jsd","name":"ScannerBase","comment":"Base class for dependency scanners. Implements straightforward, single-pass scanning of a single file. A Scanner is usually set up with a scanner function (and optionally a path function), but can also be a kind of dispatcher which passes control to other Scanners. A scanner function takes three arguments: a Node to scan for dependecies, the construction environment to use, and an optional tuple of paths (as generated by the optional path function). It must return a list containing the Nodes for all the direct dependencies of the file. The optional path function is called to return paths that can be searched for implicit dependency files. It takes five arguments: a construction environment, a Node for the directory containing the SConscript file that defined the primary target, a list of target nodes, a list of source nodes, and the optional argument for this instance. Examples:: s = Scanner(my_scanner_function) s = Scanner(function=my_scanner_function) s = Scanner(function=my_scanner_function, argument='foo') Args: function: either a scanner function taking two or three arguments and returning a list of File Nodes; or a mapping of keys to other Scanner objects. name: an optional name for identifying this scanner object (defaults to \"NONE\"). argument: an optional argument that will be passed to both *function* and *path_function*. skeys: an optional list argument that can be used to determine if this scanner can be used for a given Node. In the case of File nodes, for example, the *skeys* would be file suffixes. path_function: an optional function which returns a tuple of the directories that can be searched for implicit dependency files. May also return a callable which is called with no args and returns the tuple (supporting Bindable class). node_class: optional class of Nodes which this scan will return. If not specified, defaults to :class:`SCons.Node.FS.Base`. If *node_class* is ``None``, then this scanner will not enforce any Node conversion and will return the raw results from *function*. node_factory: optional factory function to be called to translate the raw results returned by *function* into the expected *node_class* objects. scan_check: optional function to be called to first check whether this node really needs to be scanned. recursive: optional specifier of whether this scanner should be invoked recursively on all of the implicit dependencies it returns (for example `#include` lines in C source files, which may refer to header files which should themselves be scanned). May be a callable, which will be called to filter the list of nodes found to select a subset for recursive scanning (the canonical example being only recursively scanning subdirectories within a directory). The default is to not do recursive scanning.","compilationUnitId":"acm000005622jsd","parentDatatypeId":null,"startLine":76,"endLine":275,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005592jsd","acm000005593jsd","acm000005594jsd","acm000005595jsd","acm000005596jsd","acm000005597jsd","acm000005598jsd","acm000005599jsd","acm000005600jsd","acm000005601jsd","acm000005602jsd","acm000005603jsd"]},"acm000005605jsd":{"type":"ControlElement","id":"acm000005605jsd","name":"__init__","comment":"","startLine":62,"endLine":63,"calleeNames":[]},"acm000005606jsd":{"type":"ControlElement","id":"acm000005606jsd","name":"__call__","comment":"","startLine":65,"endLine":73,"calleeNames":["PathList","subst_path","tuple","Rfindalldirs"]},"acm000005607jsd":{"type":"ControlElement","id":"acm000005607jsd","name":"select","comment":"","startLine":253,"endLine":261,"calleeNames":["is_Dict","scanner_key"]},"acm000005608jsd":{"type":"ControlElement","id":"acm000005608jsd","name":"add_scanner","comment":"","startLine":273,"endLine":275,"calleeNames":["add_skey"]},"acm000005609jsd":{"type":"ClassUnit","id":"acm000005609jsd","name":"Selector","comment":"A class for selecting a more specific scanner based on the :func:`scanner_key` (suffix) for a specific Node. TODO: This functionality has been moved into the inner workings of the ScannerBase class, and this class will be deprecated at some point. (It was never exposed directly as part of the public interface, although it is used by the :func:`Scanner` factory function that was used by various Tool modules and therefore was likely a template for custom modules that may be out there.)","compilationUnitId":"acm000005622jsd","parentDatatypeId":null,"startLine":283,"endLine":311,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005605jsd","acm000005606jsd","acm000005607jsd","acm000005608jsd"]},"acm000005610jsd":{"type":"ControlElement","id":"acm000005610jsd","name":"__init__","comment":"","startLine":62,"endLine":63,"calleeNames":[]},"acm000005611jsd":{"type":"ClassUnit","id":"acm000005611jsd","name":"Current","comment":"A class for scanning files that are source files (have no builder) or are derived files and are current (which implies that they exist, either locally or in a repository).","compilationUnitId":"acm000005622jsd","parentDatatypeId":null,"startLine":314,"endLine":326,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005610jsd"]},"acm000005612jsd":{"type":"ControlElement","id":"acm000005612jsd","name":"__init__","comment":"","startLine":62,"endLine":63,"calleeNames":[]},"acm000005613jsd":{"type":"ControlElement","id":"acm000005613jsd","name":"find_include","comment":"","startLine":363,"endLine":365,"calleeNames":["find_file","tuple"]},"acm000005614jsd":{"type":"ControlElement","id":"acm000005614jsd","name":"sort_key","comment":"","startLine":368,"endLine":369,"calleeNames":["_my_normcase"]},"acm000005615jsd":{"type":"ControlElement","id":"acm000005615jsd","name":"find_include_names","comment":"","startLine":371,"endLine":372,"calleeNames":["findall","get_text_contents"]},"acm000005616jsd":{"type":"ControlElement","id":"acm000005616jsd","name":"scan","comment":"cache the includes list in node so we only scan it once:\nIntern the names of the include files. Saves some memory\nif the same header is included many times.\nThis is a hand-coded DSU (decorate-sort-undecorate, or\nSchwartzian transform) pattern. The sort key is the raw name\nof the file as specifed on the #include line (including the\n\" or <, since that may affect what file is found), which lets\nus keep the sort order constant regardless of whether the file\nis actually found in a Repository or locally.","startLine":374,"endLine":406,"calleeNames":["find_include_names","list","map","get_dir","callable","path","find_include","warn","append","sort_key","sorted"]},"acm000005617jsd":{"type":"ClassUnit","id":"acm000005617jsd","name":"Classic","comment":"A Scanner subclass to contain the common logic for classic CPP-style include scanning, but which can be customized to use different regular expressions to find the includes. Note that in order for this to work \"out of the box\" (without overriding the :meth:`find_include` and :meth:`sort_key1` methods), the regular expression passed to the constructor must return the name of the include file in group 0.","compilationUnitId":"acm000005622jsd","parentDatatypeId":null,"startLine":328,"endLine":406,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005612jsd","acm000005613jsd","acm000005614jsd","acm000005615jsd","acm000005616jsd"]},"acm000005618jsd":{"type":"ControlElement","id":"acm000005618jsd","name":"find_include","comment":"","startLine":363,"endLine":365,"calleeNames":["find_file","tuple"]},"acm000005619jsd":{"type":"ControlElement","id":"acm000005619jsd","name":"sort_key","comment":"","startLine":368,"endLine":369,"calleeNames":["_my_normcase"]},"acm000005620jsd":{"type":"ClassUnit","id":"acm000005620jsd","name":"ClassicCPP","comment":"A Classic Scanner subclass which takes into account the type of bracketing used to include the file, and uses classic CPP rules for searching for the files based on the bracketing. Note that in order for this to work, the regular expression passed to the constructor must return the leading bracket in group 0, and the contained filename in group 1.","compilationUnitId":"acm000005622jsd","parentDatatypeId":null,"startLine":408,"endLine":432,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005618jsd","acm000005619jsd"]},"acm000005621jsd":{"type":"ControlElement","id":"acm000005621jsd","name":"Scanner","comment":"Factory function to create a Scanner Object. Creates the appropriate Scanner based on the type of \"function\". TODO: Deprecate this some day. We've moved the functionality inside the ScannerBase class and really don't need this factory function any more. It was, however, used by some of our Tool modules, so the call probably ended up in various people's custom modules patterned on SCons code.","startLine":40,"endLine":55,"calleeNames":["is_Dict","Selector","ScannerBase"]},"acm000005622jsd":{"type":"CodeCompilationUnit","id":"acm000005622jsd","name":"__init__","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThe Scanner package for the SCons software construction utility.","parentId":"acm000005623jsd","content":["acm000005588jsd","acm000005591jsd","acm000005604jsd","acm000005609jsd","acm000005611jsd","acm000005617jsd","acm000005620jsd","acm000005621jsd"],"pathElements":["Scanner"],"extension":"py","language":"PYTHON3","importedModuleNames":["re","SCons.Node.FS","SCons.PathList","SCons.Util"]},"acm000005623jsd":{"type":"CodePackage","id":"acm000005623jsd","name":"Scanner","comment":"","parentId":null,"content":["acm000005127jsd","acm000005177jsd","acm000005183jsd","acm000005189jsd","acm000005202jsd","acm000005227jsd","acm000005232jsd","acm000005279jsd","acm000005281jsd","acm000005321jsd","acm000005326jsd","acm000005367jsd","acm000005383jsd","acm000005403jsd","acm000005407jsd","acm000005444jsd","acm000005449jsd","acm000005495jsd","acm000005498jsd","acm000005516jsd","acm000005585jsd","acm000005587jsd","acm000005622jsd"]},"acm000005624jsd":{"type":"ControlElement","id":"acm000005624jsd","name":"__init__","comment":"","startLine":115,"endLine":123,"calleeNames":["__init__","items","setattr"]},"acm000005625jsd":{"type":"ControlElement","id":"acm000005625jsd","name":"default","comment":"","startLine":125,"endLine":126,"calleeNames":["print"]},"acm000005626jsd":{"type":"ControlElement","id":"acm000005626jsd","name":"onecmd","comment":"","startLine":128,"endLine":149,"calleeNames":["strip","print","emptyline","replace","split","get","default","getattr","func"]},"acm000005627jsd":{"type":"ControlElement","id":"acm000005627jsd","name":"do_build","comment":"\\ build [TARGETS] Build the specified TARGETS and their dependencies. 'b' is a synonym.","startLine":151,"endLine":266,"calleeNames":["deepcopy","parse_args","_build_targets","extend","alter_targets","progress_display","children","is_unseen","rfile_method","Walker","get_next","keys","clear","set_state"]},"acm000005628jsd":{"type":"ControlElement","id":"acm000005628jsd","name":"do_clean","comment":"\\ clean [TARGETS] Clean (remove) the specified TARGETS and their dependencies. 'c' is a synonym.","startLine":268,"endLine":273,"calleeNames":["do_build"]},"acm000005629jsd":{"type":"ControlElement","id":"acm000005629jsd","name":"do_EOF","comment":"","startLine":275,"endLine":277,"calleeNames":["print","do_exit"]},"acm000005630jsd":{"type":"ControlElement","id":"acm000005630jsd","name":"_do_one_help","comment":"If help_<arg>() exists, then call it.","startLine":279,"endLine":297,"calleeNames":["getattr","_doc_to_help","write","flush","strip_initial_spaces","func"]},"acm000005631jsd":{"type":"ControlElement","id":"acm000005631jsd","name":"_doc_to_help","comment":"","startLine":299,"endLine":303,"calleeNames":["_strip_initial_spaces"]},"acm000005632jsd":{"type":"ControlElement","id":"acm000005632jsd","name":"_strip_initial_spaces","comment":"","startLine":305,"endLine":313,"calleeNames":["split","match","group","len","list","map","join"]},"acm000005633jsd":{"type":"ControlElement","id":"acm000005633jsd","name":"do_exit","comment":"\\ exit Exit SCons interactive mode.","startLine":315,"endLine":319,"calleeNames":["exit"]},"acm000005634jsd":{"type":"ControlElement","id":"acm000005634jsd","name":"do_help","comment":"\\ help [COMMAND] Prints help for the specified COMMAND. 'h' and '?' are synonyms.\nIf bare 'help' is called, print this class's doc\nstring (if it has one).","startLine":321,"endLine":336,"calleeNames":["_do_one_help","_doc_to_help","write","flush"]},"acm000005635jsd":{"type":"ControlElement","id":"acm000005635jsd","name":"do_shell","comment":"\\ shell [COMMANDLINE] Execute COMMANDLINE in a subshell. 'sh' and '!' are synonyms.","startLine":338,"endLine":356,"calleeNames":["Popen","write","wait"]},"acm000005636jsd":{"type":"ControlElement","id":"acm000005636jsd","name":"do_version","comment":"\\ version Prints SCons version information.","startLine":358,"endLine":362,"calleeNames":["write"]},"acm000005637jsd":{"type":"ClassUnit","id":"acm000005637jsd","name":"SConsInteractiveCmd","comment":"\\ build [TARGETS] Build the specified TARGETS and their dependencies. 'b' is a synonym. clean [TARGETS] Clean (remove) the specified TARGETS and their dependencies. 'c' is a synonym. exit Exit SCons interactive mode. help [COMMAND] Prints help for the specified COMMAND. 'h' and '?' are synonyms. shell [COMMANDLINE] Execute COMMANDLINE in a subshell. 'sh' and '!' are synonyms. version Prints SCons version information.","compilationUnitId":"acm000005639jsd","parentDatatypeId":null,"startLine":96,"endLine":362,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005624jsd","acm000005625jsd","acm000005626jsd","acm000005627jsd","acm000005628jsd","acm000005629jsd","acm000005630jsd","acm000005631jsd","acm000005632jsd","acm000005633jsd","acm000005634jsd","acm000005635jsd","acm000005636jsd"]},"acm000005638jsd":{"type":"ControlElement","id":"acm000005638jsd","name":"interact","comment":"","startLine":364,"endLine":371,"calleeNames":["SConsInteractiveCmd","cmdloop"]},"acm000005639jsd":{"type":"CodeCompilationUnit","id":"acm000005639jsd","name":"Interactive","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons interactive mode.\nTODO:\n\nThis has the potential to grow into something with a really big life\nof its own, which might or might not be a good thing. Nevertheless,\nhere are some enhancements that will probably be requested some day\nand are worth keeping in mind (assuming this takes off):\n\n- A command to re-read / re-load the SConscript files. This may\ninvolve allowing people to specify command-line options (e.g. -f,\n-I, --no-site-dir) that affect how the SConscript files are read.\n\n- Additional command-line options on the \"build\" command.\n\nOf the supported options that seemed to make sense (after a quick\npass through the list), the ones that seemed likely enough to be\nused are listed in the man page and have explicit test scripts.\n\nThese had code changed in Script/Main.py to support them, but didn't\nseem likely to be used regularly, so had no test scripts added:\n\nbuild --diskcheck=*\nbuild --implicit-cache=*\nbuild --implicit-deps-changed=*\nbuild --implicit-deps-unchanged=*\n\nThese look like they should \"just work\" with no changes to the\nexisting code, but like those above, look unlikely to be used and\ntherefore had no test scripts added:\n\nbuild --random\n\nThese I'm not sure about. They might be useful for individual\n\"build\" commands, and may even work, but they seem unlikely enough\nthat we'll wait until they're requested before spending any time on\nwriting test scripts for them, or investigating whether they work.\n\nbuild -q [??? is there a useful analog to the exit status?]\nbuild --duplicate=\nbuild --profile=\nbuild --max-drift=\nbuild --warn=*\nbuild --Y\n\n- Most of the SCons command-line options that the \"build\" command\nsupports should be settable as default options that apply to all\nsubsequent \"build\" commands. Maybe a \"set {option}\" command that\nmaps to \"SetOption('{option}')\".\n\n- Need something in the 'help' command that prints the -h output.\n\n- A command to run the configure subsystem separately (must see how\nthis interacts with the new automake model).\n\n- Command-line completion of target names; maybe even of SCons options?\nCompletion is something that's supported by the Python cmd module,\nso this should be doable without too much trouble.\n","parentId":"acm000005786jsd","content":["acm000005637jsd","acm000005638jsd"],"pathElements":["Script"],"extension":"py","language":"PYTHON3","importedModuleNames":["cmd","copy","os","re","shlex","sys","SCons.Node","SCons.SConsign","SCons.Script.Main","subprocess"]},"acm000005640jsd":{"type":"ClassUnit","id":"acm000005640jsd","name":"SConsPrintHelpException","comment":"","compilationUnitId":"acm000005709jsd","parentDatatypeId":null,"startLine":114,"endLine":115,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000005641jsd":{"type":"ControlElement","id":"acm000005641jsd","name":"__init__","comment":"","startLine":127,"endLine":143,"calleeNames":["callable","is_List","find"]},"acm000005642jsd":{"type":"ControlElement","id":"acm000005642jsd","name":"write","comment":"","startLine":145,"endLine":148,"calleeNames":["write","flush"]},"acm000005643jsd":{"type":"ControlElement","id":"acm000005643jsd","name":"erase_previous","comment":"","startLine":150,"endLine":156,"calleeNames":["len","write"]},"acm000005644jsd":{"type":"ControlElement","id":"acm000005644jsd","name":"spinner","comment":"","startLine":158,"endLine":159,"calleeNames":["write","len"]},"acm000005645jsd":{"type":"ControlElement","id":"acm000005645jsd","name":"string","comment":"","startLine":161,"endLine":162,"calleeNames":["write"]},"acm000005646jsd":{"type":"ControlElement","id":"acm000005646jsd","name":"replace_string","comment":"","startLine":164,"endLine":165,"calleeNames":["write","replace","str"]},"acm000005647jsd":{"type":"ControlElement","id":"acm000005647jsd","name":"__call__","comment":"","startLine":167,"endLine":172,"calleeNames":["erase_previous","func"]},"acm000005648jsd":{"type":"ClassUnit","id":"acm000005648jsd","name":"Progressor","comment":"","compilationUnitId":"acm000005709jsd","parentDatatypeId":null,"startLine":122,"endLine":172,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005641jsd","acm000005642jsd","acm000005643jsd","acm000005644jsd","acm000005645jsd","acm000005646jsd","acm000005647jsd"]},"acm000005649jsd":{"type":"ControlElement","id":"acm000005649jsd","name":"display","comment":"","startLine":194,"endLine":195,"calleeNames":["display"]},"acm000005650jsd":{"type":"ControlElement","id":"acm000005650jsd","name":"prepare","comment":"","startLine":197,"endLine":201,"calleeNames":["isinstance","progress","prepare"]},"acm000005651jsd":{"type":"ControlElement","id":"acm000005651jsd","name":"needs_execute","comment":"","startLine":203,"endLine":208,"calleeNames":["needs_execute","has_builder","display","str"]},"acm000005652jsd":{"type":"ControlElement","id":"acm000005652jsd","name":"execute","comment":"","startLine":210,"endLine":236,"calleeNames":["time","execute","write","str","add_command"]},"acm000005653jsd":{"type":"ControlElement","id":"acm000005653jsd","name":"do_failed","comment":"","startLine":238,"endLine":251,"calleeNames":["append","executed","fail_continue","fail_stop"]},"acm000005654jsd":{"type":"ControlElement","id":"acm000005654jsd","name":"executed","comment":"","startLine":253,"endLine":276,"calleeNames":["has_builder","exists","get_abspath","write","BuildError","exception_set","do_failed","print","executed"]},"acm000005655jsd":{"type":"ControlElement","id":"acm000005655jsd","name":"failed","comment":"Handle the failure of a build task. The primary purpose here\nis to display the various types of Errors and Exceptions\nappropriately.","startLine":278,"endLine":332,"calleeNames":["exc_info","convert_to_BuildError","is_List","join","map","write","isinstance","print_tb","print_exception","do_failed","exc_clear"]},"acm000005656jsd":{"type":"ControlElement","id":"acm000005656jsd","name":"postprocess","comment":"","startLine":334,"endLine":344,"calleeNames":["display","render_include_tree","print","postprocess"]},"acm000005657jsd":{"type":"ControlElement","id":"acm000005657jsd","name":"make_ready","comment":"Make a task ready for execution","startLine":346,"endLine":352,"calleeNames":["make_ready","explain","write"]},"acm000005658jsd":{"type":"ClassUnit","id":"acm000005658jsd","name":"BuildTask","comment":"An SCons build task.","compilationUnitId":"acm000005709jsd","parentDatatypeId":null,"startLine":190,"endLine":352,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005649jsd","acm000005650jsd","acm000005651jsd","acm000005652jsd","acm000005653jsd","acm000005654jsd","acm000005655jsd","acm000005656jsd","acm000005657jsd"]},"acm000005659jsd":{"type":"ControlElement","id":"acm000005659jsd","name":"fs_delete","comment":"delete everything in the dir\nthen delete dir itself","startLine":357,"endLine":382,"calleeNames":["lexists","isfile","islink","unlink","display","isdir","sorted","listdir","join","fs_delete","rmdir","UserError","print"]},"acm000005660jsd":{"type":"ControlElement","id":"acm000005660jsd","name":"_get_files_to_clean","comment":"","startLine":384,"endLine":389,"calleeNames":["has_builder"]},"acm000005661jsd":{"type":"ControlElement","id":"acm000005661jsd","name":"_clean_targets","comment":"","startLine":391,"endLine":396,"calleeNames":["fs_delete","get_abspath","str"]},"acm000005662jsd":{"type":"ControlElement","id":"acm000005662jsd","name":"show","comment":"","startLine":398,"endLine":402,"calleeNames":["_get_files_to_clean","isdir","display","str","_clean_targets"]},"acm000005663jsd":{"type":"ControlElement","id":"acm000005663jsd","name":"remove","comment":"An OSError may indicate something like a permissions\nissue, an IOError would indicate something like\nthe file not existing. In either case, print a\nmessage and keep going to try to remove as many\ntargets as possible.","startLine":404,"endLine":418,"calleeNames":["_get_files_to_clean","remove","print","display","str","_clean_targets"]},"acm000005664jsd":{"type":"ControlElement","id":"acm000005664jsd","name":"prepare","comment":"","startLine":197,"endLine":201,"calleeNames":["isinstance","progress","prepare"]},"acm000005665jsd":{"type":"ClassUnit","id":"acm000005665jsd","name":"CleanTask","comment":"An SCons clean task.","compilationUnitId":"acm000005709jsd","parentDatatypeId":null,"startLine":355,"endLine":434,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005659jsd","acm000005660jsd","acm000005661jsd","acm000005662jsd","acm000005663jsd","acm000005664jsd"]},"acm000005666jsd":{"type":"ControlElement","id":"acm000005666jsd","name":"prepare","comment":"","startLine":197,"endLine":201,"calleeNames":["isinstance","progress","prepare"]},"acm000005667jsd":{"type":"ControlElement","id":"acm000005667jsd","name":"execute","comment":"","startLine":210,"endLine":236,"calleeNames":["time","execute","write","str","add_command"]},"acm000005668jsd":{"type":"ControlElement","id":"acm000005668jsd","name":"executed","comment":"","startLine":253,"endLine":276,"calleeNames":["has_builder","exists","get_abspath","write","BuildError","exception_set","do_failed","print","executed"]},"acm000005669jsd":{"type":"ClassUnit","id":"acm000005669jsd","name":"QuestionTask","comment":"An SCons task for the -q (question) option.","compilationUnitId":"acm000005709jsd","parentDatatypeId":null,"startLine":436,"endLine":451,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005666jsd","acm000005667jsd","acm000005668jsd"]},"acm000005670jsd":{"type":"ControlElement","id":"acm000005670jsd","name":"__init__","comment":"","startLine":127,"endLine":143,"calleeNames":["callable","is_List","find"]},"acm000005671jsd":{"type":"ControlElement","id":"acm000005671jsd","name":"get_all_children","comment":"","startLine":460,"endLine":461,"calleeNames":["all_children"]},"acm000005672jsd":{"type":"ControlElement","id":"acm000005672jsd","name":"get_derived_children","comment":"","startLine":462,"endLine":464,"calleeNames":["all_children","has_builder"]},"acm000005673jsd":{"type":"ControlElement","id":"acm000005673jsd","name":"display","comment":"","startLine":194,"endLine":195,"calleeNames":["display"]},"acm000005674jsd":{"type":"ClassUnit","id":"acm000005674jsd","name":"TreePrinter","comment":"","compilationUnitId":"acm000005709jsd","parentDatatypeId":null,"startLine":454,"endLine":471,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005670jsd","acm000005671jsd","acm000005672jsd","acm000005673jsd"]},"acm000005675jsd":{"type":"ControlElement","id":"acm000005675jsd","name":"__getattr__","comment":"","startLine":496,"endLine":497,"calleeNames":[]},"acm000005676jsd":{"type":"ClassUnit","id":"acm000005676jsd","name":"FakeOptionValues","comment":"","compilationUnitId":"acm000005709jsd","parentDatatypeId":null,"startLine":495,"endLine":497,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005675jsd"]},"acm000005677jsd":{"type":"ControlElement","id":"acm000005677jsd","name":"add_local_option","comment":"","startLine":504,"endLine":505,"calleeNames":[]},"acm000005678jsd":{"type":"ClassUnit","id":"acm000005678jsd","name":"FakeOptionParser","comment":"A do-nothing option parser, used for the initial OptionsParser value. During normal SCons operation, the OptionsParser is created right away by the main() function. Certain test scripts however, can introspect on different Tool modules, the initialization of which can try to add a new, local option to an otherwise uninitialized OptionsParser object. This allows that introspection to happen without blowing up.","compilationUnitId":"acm000005709jsd","parentDatatypeId":null,"startLine":484,"endLine":505,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005676jsd","acm000005677jsd"]},"acm000005679jsd":{"type":"ControlElement","id":"acm000005679jsd","name":"revert_io","comment":"This call is added to revert stderr and stdout to the original\nones just in case some build rule or something else in the system\nhas redirected them elsewhere.","startLine":106,"endLine":111,"calleeNames":[]},"acm000005680jsd":{"type":"ControlElement","id":"acm000005680jsd","name":"Progress","comment":"","startLine":176,"endLine":178,"calleeNames":["Progressor"]},"acm000005681jsd":{"type":"ControlElement","id":"acm000005681jsd","name":"GetBuildFailures","comment":"","startLine":186,"endLine":187,"calleeNames":[]},"acm000005682jsd":{"type":"ControlElement","id":"acm000005682jsd","name":"python_version_string","comment":"","startLine":474,"endLine":475,"calleeNames":["split"]},"acm000005683jsd":{"type":"ControlElement","id":"acm000005683jsd","name":"python_version_unsupported","comment":"","startLine":477,"endLine":478,"calleeNames":[]},"acm000005684jsd":{"type":"ControlElement","id":"acm000005684jsd","name":"python_version_deprecated","comment":"","startLine":480,"endLine":481,"calleeNames":[]},"acm000005685jsd":{"type":"ControlElement","id":"acm000005685jsd","name":"AddOption","comment":"","startLine":510,"endLine":514,"calleeNames":["add_local_option"]},"acm000005686jsd":{"type":"ControlElement","id":"acm000005686jsd","name":"GetOption","comment":"","startLine":516,"endLine":517,"calleeNames":["getattr"]},"acm000005687jsd":{"type":"ControlElement","id":"acm000005687jsd","name":"SetOption","comment":"","startLine":519,"endLine":520,"calleeNames":["set_option"]},"acm000005688jsd":{"type":"ControlElement","id":"acm000005688jsd","name":"DebugOptions","comment":"API to allow specifying options to SCons debug logic Currently only json is supported which changes the json file written by --debug=json from the default\nCheck if parent dir to JSON_OUTPUT_FILE exists\nNow try to open file and see if you can..","startLine":522,"endLine":540,"calleeNames":["DefaultEnvironment","arg2nodes","get_abspath","dirname","isdir","makedirs","open","UserError"]},"acm000005689jsd":{"type":"ControlElement","id":"acm000005689jsd","name":"ValidateOptions","comment":"Validate options passed to SCons on the command line. Checks that all options given on the command line are known to this instance of SCons. Call after all of the cli options have been set up through :func:`AddOption` calls. For example, if you added an option ``--xyz`` and you call SCons with ``--xyy`` you can cause SCons to issue an error message and exit by calling this function. Arguments: throw_exception: if an invalid option is present on the command line, raises an exception if this optional parameter evaluates true; if false (the default), issue a message and exit with error status. Raises: SConsBadOptionError: If *throw_exception* is true and there are invalid options on the command line. .. versionadded:: 4.5.0","startLine":543,"endLine":565,"calleeNames":["parse_args"]},"acm000005690jsd":{"type":"ControlElement","id":"acm000005690jsd","name":"PrintHelp","comment":"utility functions","startLine":567,"endLine":571,"calleeNames":["print_local_option_help","print_help"]},"acm000005691jsd":{"type":"ControlElement","id":"acm000005691jsd","name":"_scons_syntax_error","comment":"Handle syntax errors. Print out a message and show where the error occurred.","startLine":576,"endLine":584,"calleeNames":["exc_info","format_exception_only","write","exit"]},"acm000005692jsd":{"type":"ControlElement","id":"acm000005692jsd","name":"find_deepest_user_frame","comment":"Find the deepest stack frame that is not part of SCons. Input is a \"pre-processed\" stack trace in the form returned by traceback.extract_tb() or traceback.extract_stack()\nfind the deepest traceback frame that is not part\nof SCons:","startLine":586,"endLine":602,"calleeNames":["reverse","find"]},"acm000005693jsd":{"type":"ControlElement","id":"acm000005693jsd","name":"_scons_user_error","comment":"Handle user errors. Print out a message and a description of the error, along with the line number and routine where it occured. The file and line number will be the deepest stack frame that is not part of SCons itself.","startLine":604,"endLine":617,"calleeNames":["exc_info","print_exception","find_deepest_user_frame","extract_tb","write","exit"]},"acm000005694jsd":{"type":"ControlElement","id":"acm000005694jsd","name":"_scons_user_warning","comment":"Handle user warnings. Print out a message and a description of the warning, along with the line number and routine where it occured. The file and line number will be the deepest stack frame that is not part of SCons itself.","startLine":619,"endLine":628,"calleeNames":["exc_info","find_deepest_user_frame","extract_tb","write"]},"acm000005695jsd":{"type":"ControlElement","id":"acm000005695jsd","name":"_scons_internal_warning","comment":"Slightly different from _scons_user_warning in that we use the *current call stack* rather than sys.exc_info() to get our stack trace. This is used by the warnings framework to print warnings.","startLine":630,"endLine":636,"calleeNames":["find_deepest_user_frame","extract_stack","write"]},"acm000005696jsd":{"type":"ControlElement","id":"acm000005696jsd","name":"_scons_internal_error","comment":"Handle all errors but user errors. Print out a message telling the user what to do in this case and print a normal trace.","startLine":638,"endLine":644,"calleeNames":["print","print_exc","exit"]},"acm000005697jsd":{"type":"ControlElement","id":"acm000005697jsd","name":"_SConstruct_exists","comment":"Check that an SConstruct file exists in a directory. Arguments: dirname: the directory to search. If empty, look in cwd. repositories: a list of repositories to search in addition to the project directory tree. filelist: names of SConstruct file(s) to search for. If empty list, use the built-in list of names. Returns: The path to the located SConstruct file, or ``None``.","startLine":646,"endLine":672,"calleeNames":["join","isfile","isabs"]},"acm000005698jsd":{"type":"ControlElement","id":"acm000005698jsd","name":"_set_debug_values","comment":"","startLine":675,"endLine":729,"calleeNames":["enable","warn","append","TreePrinter"]},"acm000005699jsd":{"type":"ControlElement","id":"acm000005699jsd","name":"_create_path","comment":"","startLine":731,"endLine":738,"calleeNames":["isabs"]},"acm000005700jsd":{"type":"ControlElement","id":"acm000005700jsd","name":"_load_site_scons_dir","comment":"Load the site directory under topdir. If a site dir name is supplied use it, else use default \"site_scons\" Prepend site dir to sys.path. If a \"site_tools\" subdir exists, prepend to toolpath. Import \"site_init.py\" from site dir if it exists.\nuser specified: err if missing\nscons default: okay to be missing","startLine":740,"endLine":819,"calleeNames":["join","exists","UserError","insert","abspath","InternalError","format","spec_from_file_location","compile","items","match","open","read","exec","write"]},"acm000005701jsd":{"type":"ControlElement","id":"acm000005701jsd","name":"_load_all_site_scons_dirs","comment":"Load all of the predefined site_scons dir. Order is significant; we load them in order from most generic (machine-wide) to most specific (topdir). The verbose argument is only for testing.","startLine":822,"endLine":863,"calleeNames":["platform_default","expanduser","expandvars","append","homedir","print","_load_site_scons_dir"]},"acm000005702jsd":{"type":"ControlElement","id":"acm000005702jsd","name":"test_load_all_site_scons_dirs","comment":"","startLine":865,"endLine":866,"calleeNames":["_load_all_site_scons_dirs"]},"acm000005703jsd":{"type":"ControlElement","id":"acm000005703jsd","name":"version_string","comment":"","startLine":868,"endLine":880,"calleeNames":[]},"acm000005704jsd":{"type":"ControlElement","id":"acm000005704jsd","name":"path_string","comment":"","startLine":882,"endLine":884,"calleeNames":[]},"acm000005705jsd":{"type":"ControlElement","id":"acm000005705jsd","name":"_main","comment":"","startLine":886,"endLine":1178,"calleeNames":["enableWarningClass","process_warn_strings","extend","warn","set_diskcheck","abspath","_create_path","getcwd","_SConstruct_exists","split","join","display","chdir","write","get_default_fs","Repository","append","UserError","File","set_SConstruct_dir","_set_debug_values","SetBuildType","SetCacheMode","SetProgressDisplay","set_mode","_load_all_site_scons_dirs","get_internal_path","_load_site_scons_dir","startswith","_Add_Targets","_Add_Arguments","hasattr","isatty","Unbuffered","progress_display","time","_SConscript","revert_io","exit","python_version_deprecated","map","python_version_string","NeedConfigHBuilder","CreateConfigHBuilder","DefaultEnvironment","parse_args","print","save_strings","set_duplicate","set_max_drift","set_hash_format","platform_module","interact","_build_targets"]},"acm000005706jsd":{"type":"ControlElement","id":"acm000005706jsd","name":"_build_targets","comment":"","startLine":1180,"endLine":1374,"calleeNames":["set_mode","set_diskcheck","Dir","hasattr","srcnode","check_dir","_Get_Default_Targets","write","isinstance","join","getcwd","str","lookup","Entry","is_under","map","shuffle","Taskmaster","python_implementation","get_ident","Jobs","warn","append","were_interrupted","progress_display","run"]},"acm000005707jsd":{"type":"ControlElement","id":"acm000005707jsd","name":"_exec_main","comment":"","startLine":1376,"endLine":1431,"calleeNames":["get","split","parse_args","isinstance","isabs","exists","join","canonic","splitext","islink","readlink","SConsPdb","runcall","Profile","dump_stats","_main"]},"acm000005708jsd":{"type":"ControlElement","id":"acm000005708jsd","name":"main","comment":"Check up front for a Python version we do not support. We\ndelay the check for deprecated Python versions until later,\nafter the SConscript files have been read, in case they\ndisable that warning.","startLine":1434,"endLine":1542,"calleeNames":["python_version_unsupported","write","python_version_string","exit","append","version_string","path_string","join","Parser","SConsValues","get_default_values","_exec_main","revert_io","print","_scons_syntax_error","_scons_internal_error","_scons_user_error","print_help","SConscript_exception","print_stats","listLoggedInstances","Dump","dump_caller_counts","dump_stats","time","total_times","write_scons_stats_file"]},"acm000005709jsd":{"type":"CodeCompilationUnit","id":"acm000005709jsd","name":"Main","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThe main() function used by the scons script. Architecturally, this *is* the scons script, and will likely only be called from the external \"scons\" wrapper. Consequently, anything here should not be, or be considered, part of the build engine. If it's something that we expect other software to want to use, it should go in some other module. If it's specific to the \"scons\" script invocation, it goes here.\nthese define the range of versions SCons supports","parentId":"acm000005786jsd","content":["acm000005640jsd","acm000005648jsd","acm000005658jsd","acm000005665jsd","acm000005669jsd","acm000005674jsd","acm000005678jsd","acm000005679jsd","acm000005680jsd","acm000005681jsd","acm000005682jsd","acm000005683jsd","acm000005684jsd","acm000005685jsd","acm000005686jsd","acm000005687jsd","acm000005688jsd","acm000005689jsd","acm000005690jsd","acm000005691jsd","acm000005692jsd","acm000005693jsd","acm000005694jsd","acm000005695jsd","acm000005696jsd","acm000005697jsd","acm000005698jsd","acm000005699jsd","acm000005700jsd","acm000005701jsd","acm000005702jsd","acm000005703jsd","acm000005704jsd","acm000005705jsd","acm000005706jsd","acm000005707jsd","acm000005708jsd"],"pathElements":["Script"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.compat","importlib.util","os","re","sys","time","traceback","platform","threading","typing.Optional","typing.List","SCons.CacheDir","SCons.Debug","SCons.Defaults","SCons.Environment","SCons.Errors","SCons.Taskmaster.Job","SCons.Node","SCons.Node.FS","SCons.Platform","SCons.Platform.virtualenv","SCons.SConf","SCons.Script","SCons.Taskmaster","SCons.Util","SCons.Warnings","SCons.Script.Interactive","SCons.Util.stats.count_stats","SCons.Util.stats.memory_stats","SCons.Util.stats.time_stats","SCons.Util.stats.ENABLE_JSON","SCons.Util.stats.write_scons_stats_file","SCons.Util.stats.JSON_OUTPUT_FILE","SCons.__version__","SConsOptions"]},"acm000005710jsd":{"type":"CodeCompilationUnit","id":"acm000005710jsd","name":"MainTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nUnit tests of various classes within SCons.Script.Main.py.\n\nMost of the tests of this functionality are actually end-to-end scripts\nin the test/ hierarchy.\n\nThis module is for specific bits of functionality that we can test\nmore effectively here, instead of in an end-to-end test that would\nhave to reach into SCons.Script.Main for various classes or other bits\nof private functionality.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","parentId":"acm000005786jsd","content":[],"pathElements":["Script"],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest"]},"acm000005711jsd":{"type":"ClassUnit","id":"acm000005711jsd","name":"SConscriptReturn","comment":"","compilationUnitId":"acm000005743jsd","parentDatatypeId":null,"startLine":49,"endLine":50,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000005712jsd":{"type":"ControlElement","id":"acm000005712jsd","name":"__init__","comment":"","startLine":107,"endLine":118,"calleeNames":["BuildDefaultGlobals","getcwd","compute_exports","isinstance","File","str"]},"acm000005713jsd":{"type":"ClassUnit","id":"acm000005713jsd","name":"Frame","comment":"A frame on the SConstruct/SConscript call stack","compilationUnitId":"acm000005743jsd","parentDatatypeId":null,"startLine":105,"endLine":118,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005712jsd"]},"acm000005714jsd":{"type":"ControlElement","id":"acm000005714jsd","name":"_get_major_minor_revision","comment":"Split a version string into major, minor and (optionally) revision parts. This is complicated by the fact that a version string can be something like 3.2b1.","startLine":388,"endLine":401,"calleeNames":["split","int","match","group","len"]},"acm000005715jsd":{"type":"ControlElement","id":"acm000005715jsd","name":"_get_SConscript_filenames","comment":"Convert the parameters passed to SConscript() calls into a list of files and export variables. If the parameters are invalid, throws SCons.Errors.UserError. Returns a tuple (l, e) where l is a list of SConscript filenames and e is a list of exports.","startLine":403,"endLine":469,"calleeNames":["len","UserError","is_List","list","map","get","join","Split","extend","split","str","isinstance","Dir","File","is_under","get_path","get_abspath","VariantDir"]},"acm000005716jsd":{"type":"ControlElement","id":"acm000005716jsd","name":"Configure","comment":"","startLine":477,"endLine":481,"calleeNames":["UserError","get","Configure"]},"acm000005717jsd":{"type":"ControlElement","id":"acm000005717jsd","name":"Default","comment":"","startLine":483,"endLine":484,"calleeNames":["_Set_Default_Targets"]},"acm000005718jsd":{"type":"ControlElement","id":"acm000005718jsd","name":"EnsureSConsVersion","comment":"Exit abnormally if the SCons version is not late enough.\nsplit string to avoid replacement during build process","startLine":487,"endLine":502,"calleeNames":["warn","_get_major_minor_revision","print","exit"]},"acm000005719jsd":{"type":"ControlElement","id":"acm000005719jsd","name":"EnsurePythonVersion","comment":"Exit abnormally if the Python version is not late enough.","startLine":505,"endLine":510,"calleeNames":["split","print","exit"]},"acm000005720jsd":{"type":"ControlElement","id":"acm000005720jsd","name":"Exit","comment":"","startLine":513,"endLine":514,"calleeNames":["exit"]},"acm000005721jsd":{"type":"ControlElement","id":"acm000005721jsd","name":"Export","comment":"","startLine":516,"endLine":519,"calleeNames":["update","compute_exports","Split"]},"acm000005722jsd":{"type":"ControlElement","id":"acm000005722jsd","name":"GetLaunchDir","comment":"","startLine":522,"endLine":524,"calleeNames":[]},"acm000005723jsd":{"type":"ControlElement","id":"acm000005723jsd","name":"GetOption","comment":"","startLine":526,"endLine":528,"calleeNames":["subst","GetOption"]},"acm000005724jsd":{"type":"ControlElement","id":"acm000005724jsd","name":"Help","comment":"Update the help text. The previous help text has *text* appended to it, except on the first call. On first call, the values of *append* and *keep_local* are considered to determine what is appended to. Arguments: text: string to add to the help text. append: on first call, if true, keep the existing help text (default False). keep_local: on first call, if true and *append* is also true, keep only the help text from AddOption calls. .. versionchanged:: 4.6.0 The *keep_local* parameter was added.","startLine":530,"endLine":548,"calleeNames":["subst","HelpFunction"]},"acm000005725jsd":{"type":"ControlElement","id":"acm000005725jsd","name":"Import","comment":"","startLine":550,"endLine":567,"calleeNames":["Split","update","UserError"]},"acm000005726jsd":{"type":"ControlElement","id":"acm000005726jsd","name":"SConscript","comment":"Execute SCons configuration files. Parameters: *ls (str or list): configuration file(s) to execute. Keyword arguments: dirs (list): execute SConscript in each listed directory. name (str): execute script 'name' (used only with 'dirs'). exports (list or dict): locally export variables the called script(s) can import. variant_dir (str): mirror sources needed for the build in a variant directory to allow building in it. duplicate (bool): physically duplicate sources instead of just adjusting paths of derived files (used only with 'variant_dir') (default is True). must_exist (bool): fail if a requested script is missing (default is False, default is deprecated). Returns: list of variables returned by the called script Raises: UserError: a script is not found and such exceptions are enabled.","startLine":569,"endLine":612,"calleeNames":["is_List","list","map","subst","items","is_String","_get_SConscript_filenames","_SConscript"]},"acm000005727jsd":{"type":"ControlElement","id":"acm000005727jsd","name":"SConscriptChdir","comment":"","startLine":615,"endLine":617,"calleeNames":[]},"acm000005728jsd":{"type":"ControlElement","id":"acm000005728jsd","name":"SetOption","comment":"","startLine":619,"endLine":621,"calleeNames":["subst","SetOption"]},"acm000005729jsd":{"type":"ClassUnit","id":"acm000005729jsd","name":"SConsEnvironment","comment":"An Environment subclass that contains all of the methods that are particular to the wrapper SCons interface and which aren't (or shouldn't be) part of the build engine itself. Note that not all of the methods of this class have corresponding global functions, there are some private methods.\n\nPrivate methods of an SConsEnvironment.\n","compilationUnitId":"acm000005743jsd","parentDatatypeId":null,"startLine":375,"endLine":621,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005714jsd","acm000005715jsd","acm000005716jsd","acm000005717jsd","acm000005718jsd","acm000005719jsd","acm000005720jsd","acm000005721jsd","acm000005722jsd","acm000005723jsd","acm000005724jsd","acm000005725jsd","acm000005726jsd","acm000005727jsd","acm000005728jsd"]},"acm000005730jsd":{"type":"ControlElement","id":"acm000005730jsd","name":"__init__","comment":"","startLine":107,"endLine":118,"calleeNames":["BuildDefaultGlobals","getcwd","compute_exports","isinstance","File","str"]},"acm000005731jsd":{"type":"ControlElement","id":"acm000005731jsd","name":"__call__","comment":"","startLine":673,"endLine":676,"calleeNames":["factory","getattr","method"]},"acm000005732jsd":{"type":"ClassUnit","id":"acm000005732jsd","name":"DefaultEnvironmentCall","comment":"A class that implements \"global function\" calls of Environment methods by fetching the specified method from the DefaultEnvironment's class. Note that this uses an intermediate proxy class instead of calling the DefaultEnvironment method directly so that the proxy can override the subst() method and thereby prevent expansion of construction variables (since from the user's point of view this was called as a global function, with no associated construction environment).","compilationUnitId":"acm000005743jsd","parentDatatypeId":null,"startLine":658,"endLine":676,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005730jsd","acm000005731jsd"]},"acm000005733jsd":{"type":"ControlElement","id":"acm000005733jsd","name":"get_calling_namespaces","comment":"Return the locals and globals for the function that called into this module in the current call stack.\nDon't start iterating with the current stack-frame to\nprevent creating reference cycles (f_back is safe).\nFind the first frame that *isn't* from this file. This means\nthat we expect all of the SCons frames that implement an Export()\nor SConscript() call to be in this file, so that we can identify\nthe first non-Script.SConscript frame as the user's local calling\nenvironment, and the locals and globals dictionaries from that\nframe as the calling namespaces. See the comment below preceding\nthe DefaultEnvironmentCall block for even more explanation.","startLine":62,"endLine":81,"calleeNames":["exc_info","get"]},"acm000005734jsd":{"type":"ControlElement","id":"acm000005734jsd","name":"compute_exports","comment":"Compute a dictionary of exports given one of the parameters to the Export() function or the exports argument to SConscript().","startLine":84,"endLine":103,"calleeNames":["get_calling_namespaces","is_Dict","update","UserError"]},"acm000005735jsd":{"type":"ControlElement","id":"acm000005735jsd","name":"Return","comment":"","startLine":125,"endLine":143,"calleeNames":["flatten","split","append","UserError","len","tuple","get"]},"acm000005736jsd":{"type":"ControlElement","id":"acm000005736jsd","name":"handle_missing_SConscript","comment":"Take appropriate action on missing file in SConscript() call. Print a warning or raise an exception on missing file, unless missing is explicitly allowed by the *must_exist* parameter or by a global flag. Args: f: path to missing configuration file must_exist: if true (the default), fail. If false do nothing, allowing a build to declare it's okay to be missing. Raises: UserError: if *must_exist* is true or if global :data:`SCons.Script._no_missing_sconscript` is true. .. versionchanged: 4.6.0 Changed default from False.\nexplicitly set False: ok\nsystem default changed: ok","startLine":148,"endLine":172,"calleeNames":["UserError"]},"acm000005737jsd":{"type":"ControlElement","id":"acm000005737jsd","name":"_SConscript","comment":"","startLine":175,"endLine":332,"calleeNames":["rdir","get","append","Frame","exec","read","isinstance","File","str","add","chdir","rexists","rfile","open","get_abspath","srcnode","has_src_builder","build","built","builder_set","exists","Dir","get_path","is_under","update","perf_counter","close","print","compile","handle_missing_SConscript","pop","_create","len","tuple"]},"acm000005738jsd":{"type":"ControlElement","id":"acm000005738jsd","name":"SConscript_exception","comment":"Print an exception stack trace just for the SConscript file(s). This will show users who have Python errors where the problem is, without cluttering the output with all of the internal calls leading up to where we exec the SConscript.","startLine":334,"endLine":357,"calleeNames":["exc_info","extract_tb","str","write"]},"acm000005739jsd":{"type":"ControlElement","id":"acm000005739jsd","name":"annotate","comment":"Annotate a node with the stack frame describing the SConscript file and line number that created it.","startLine":359,"endLine":368,"calleeNames":["exc_info","InternalError","extract_stack"]},"acm000005740jsd":{"type":"ControlElement","id":"acm000005740jsd","name":"Configure","comment":"","startLine":477,"endLine":481,"calleeNames":["UserError","get","Configure"]},"acm000005741jsd":{"type":"ControlElement","id":"acm000005741jsd","name":"get_DefaultEnvironmentProxy","comment":"","startLine":651,"endLine":656,"calleeNames":["DefaultEnvironment","NoSubstitutionProxy"]},"acm000005742jsd":{"type":"ControlElement","id":"acm000005742jsd","name":"BuildDefaultGlobals","comment":"Create a dictionary containing all the default globals for SConstruct and SConscript files.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":679,"endLine":696,"calleeNames":["type","isinstance","filter","dir","copy"]},"acm000005743jsd":{"type":"CodeCompilationUnit","id":"acm000005743jsd","name":"SConscript","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThis module defines the Python API provided to SConscript files.","parentId":"acm000005786jsd","content":["acm000005711jsd","acm000005713jsd","acm000005729jsd","acm000005732jsd","acm000005733jsd","acm000005734jsd","acm000005735jsd","acm000005736jsd","acm000005737jsd","acm000005738jsd","acm000005739jsd","acm000005740jsd","acm000005741jsd","acm000005742jsd"],"pathElements":["Script"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons","SCons.Action","SCons.Builder","SCons.Defaults","SCons.Environment","SCons.Errors","SCons.Node","SCons.Node.Alias","SCons.Node.FS","SCons.Platform","SCons.SConf","SCons.Tool","SCons.Util.is_List","SCons.Util.is_String","SCons.Util.is_Dict","SCons.Util.flatten","SCons.Node.SConscriptNodes","Main","os","os.path","re","sys","traceback","time"]},"acm000005744jsd":{"type":"CodeCompilationUnit","id":"acm000005744jsd","name":"SConscriptTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nall of the SConscript.py tests are in test/SConscript.py\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","parentId":"acm000005786jsd","content":[],"pathElements":["Script"],"extension":"py","language":"PYTHON3","importedModuleNames":[]},"acm000005745jsd":{"type":"ControlElement","id":"acm000005745jsd","name":"__init__","comment":"","startLine":101,"endLine":103,"calleeNames":[]},"acm000005746jsd":{"type":"ControlElement","id":"acm000005746jsd","name":"__getattr__","comment":"Fetches an options value, checking first for explicit settings from the command line (which are direct attributes), then the SConscript file settings, then the default values.\nAdded because with py3 this is a new class,\nnot a classic class, and due to the way\nIn that case it will create an object without\n__defaults__, and then query for __setstate__\nwhich will throw an exception of KeyError\ndeepcopy() is expecting AttributeError if __setstate__\nis not available.\nkeep this list in sync with the SetOption doc in SCons/Script/Main.xml\nsearch for UPDATE_SETOPTION_DOCS there.","startLine":105,"endLine":127,"calleeNames":["getattr","AttributeError"]},"acm000005747jsd":{"type":"ControlElement","id":"acm000005747jsd","name":"set_option","comment":"Sets an option from an SConscript file. Raises: UserError: invalid or malformed option (\"error in your script\")\nthe following are for options that need some extra processing\nSet the duplicate style right away so it can affect linking\nof SConscript files.\nNo --diskcheck= option was specified on the command line.\nSet this right away so it can affect the rest of the\nfile/Node lookups while processing the SConscript files.\nfor now, the old name is used","startLine":161,"endLine":239,"calleeNames":["UserError","int","repr","str","set_duplicate","diskcheck_convert","set_diskcheck","is_String","get","process_warn_strings","set_mode"]},"acm000005748jsd":{"type":"ClassUnit","id":"acm000005748jsd","name":"SConsValues","comment":"Holder class for uniform access to SCons options, regardless of whether they can be set on the command line or in the SConscript files (using the SetOption() function). A SCons option value can originate three different ways: 1) set on the command line; 2) set in an SConscript file; 3) the default setting (from the the op.add_option() calls in the Parser() function, below). The command line always overrides a value set in a SConscript file, which in turn always overrides default settings. Because we want to support user-specified options in the SConscript file itself, though, we may not know about all of the options when the command line is first parsed, so we can't make all the necessary precedence decisions at the time the option is configured. The solution implemented in this class is to keep these different sets of settings separate (command line, SConscript file, and default) and to override the __getattr__() method to check them in turn. This should allow the rest of the code to just fetch values as attributes of an instance of this class, without having to worry about where they came from. Note that not all command line options are settable from SConscript files, and the ones that are must be explicitly added to the \"settable\" list in this class, and optionally validated and coerced in the set_option() method.","compilationUnitId":"acm000005772jsd","parentDatatypeId":null,"startLine":68,"endLine":239,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005745jsd","acm000005746jsd","acm000005747jsd"]},"acm000005749jsd":{"type":"ControlElement","id":"acm000005749jsd","name":"convert_value","comment":"","startLine":243,"endLine":247,"calleeNames":["check_value","tuple"]},"acm000005750jsd":{"type":"ControlElement","id":"acm000005750jsd","name":"process","comment":"First, convert the value(s) to the right type. Howl if any\nvalue(s) are bogus.","startLine":249,"endLine":259,"calleeNames":["convert_value","take_action"]},"acm000005751jsd":{"type":"ControlElement","id":"acm000005751jsd","name":"_check_nargs_optional","comment":"","startLine":261,"endLine":264,"calleeNames":["UserError"]},"acm000005752jsd":{"type":"ClassUnit","id":"acm000005752jsd","name":"SConsOption","comment":"","compilationUnitId":"acm000005772jsd","parentDatatypeId":null,"startLine":242,"endLine":270,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005749jsd","acm000005750jsd","acm000005751jsd"]},"acm000005753jsd":{"type":"ControlElement","id":"acm000005753jsd","name":"format_help","comment":"Format an option group's help text. The title is dedented so it's flush with the \"SCons Options\" title we print at the top.","startLine":281,"endLine":292,"calleeNames":["dedent","format_heading","indent","format_help"]},"acm000005754jsd":{"type":"ClassUnit","id":"acm000005754jsd","name":"SConsOptionGroup","comment":"A subclass for SCons-specific option groups. The only difference between this and the base class is that we print the group's help text flush left, underneath their own title but lined up with the normal \"SCons Options\".","compilationUnitId":"acm000005772jsd","parentDatatypeId":null,"startLine":273,"endLine":292,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005753jsd"]},"acm000005755jsd":{"type":"ControlElement","id":"acm000005755jsd","name":"__init__","comment":"","startLine":101,"endLine":103,"calleeNames":[]},"acm000005756jsd":{"type":"ControlElement","id":"acm000005756jsd","name":"__str__","comment":"","startLine":307,"endLine":308,"calleeNames":["_"]},"acm000005757jsd":{"type":"ClassUnit","id":"acm000005757jsd","name":"SConsBadOptionError","comment":"Exception used to indicate that invalid command line options were specified :ivar str opt_str: The offending option specified on command line which is not recognized :ivar OptionParser parser: The active argument parser","compilationUnitId":"acm000005772jsd","parentDatatypeId":null,"startLine":295,"endLine":308,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005755jsd","acm000005756jsd"]},"acm000005758jsd":{"type":"ControlElement","id":"acm000005758jsd","name":"error","comment":"overridden OptionValueError exception handler","startLine":315,"endLine":324,"calleeNames":["SConsBadOptionError","print_usage","write","exit"]},"acm000005759jsd":{"type":"ControlElement","id":"acm000005759jsd","name":"_process_long_opt","comment":"SCons-specific processing of long options. This is copied directly from the normal ``optparse._process_long_opt()`` method, except that, if configured to do so, we catch the exception thrown when an unknown option is encountered and just stick it back on the \"leftover\" arguments for later (re-)processing. This is because we may see the option definition later, while processing SConscript files.","startLine":326,"endLine":397,"calleeNames":["pop","split","insert","_match_long_opt","BadOptionError","append","takes_value","len","error","_","join","tuple","process"]},"acm000005760jsd":{"type":"ControlElement","id":"acm000005760jsd","name":"reparse_local_options","comment":"Re-parse the leftover command-line options. Parse options stored in `self.largs`, so that any value overridden on the command line is immediately available if the user turns around and does a :func:`GetOption` right away. We mimic the processing of the single args in the original OptionParser :func:`_process_args`, but here we allow exact matches for long-opts only (no partial argument names!). Otherwise there could be problems in :func:`add_local_option` below. When called from there, we try to reparse the command-line arguments that 1. haven't been processed so far (`self.largs`), but 2. are possibly not added to the list of options yet. So, when we only have a value for \"--myargument\" so far, a command-line argument of \"--myarg=test\" would set it, per the behaviour of :func:`_match_long_opt`, which allows for partial matches of the option name, as long as the common prefix appears to be unique. This would lead to further confusion, because we might want to add another option \"--myarg\" later on (see issue #2929).","startLine":399,"endLine":460,"calleeNames":["append","len","split","join","parse_args"]},"acm000005761jsd":{"type":"ControlElement","id":"acm000005761jsd","name":"add_local_option","comment":"Adds a local option to the parser. This is initiated by an :func:`AddOption` call to add a user-defined command-line option. We add the option to a separate option group for the local options, creating the group if necessary.","startLine":462,"endLine":489,"calleeNames":["SConsOptionGroup","add_option_group","add_option","setattr","reparse_local_options"]},"acm000005762jsd":{"type":"ControlElement","id":"acm000005762jsd","name":"format_local_option_help","comment":"Return the help for the project-level (\"local\") options. .. versionadded:: 4.6.0\ndefeat our own cleverness, which starts out by dedenting","startLine":491,"endLine":512,"calleeNames":["store_local_option_strings","format_option_strings","indent","format_help","dedent"]},"acm000005763jsd":{"type":"ControlElement","id":"acm000005763jsd","name":"print_local_option_help","comment":"Print help for just project-defined options. Writes to *file* (default stdout). .. versionadded:: 4.6.0","startLine":514,"endLine":523,"calleeNames":["write","format_local_option_help"]},"acm000005764jsd":{"type":"ClassUnit","id":"acm000005764jsd","name":"SConsOptionParser","comment":"","compilationUnitId":"acm000005772jsd","parentDatatypeId":null,"startLine":311,"endLine":523,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005758jsd","acm000005759jsd","acm000005760jsd","acm000005761jsd","acm000005762jsd","acm000005763jsd"]},"acm000005765jsd":{"type":"ControlElement","id":"acm000005765jsd","name":"format_usage","comment":"Formats the usage message.","startLine":527,"endLine":529,"calleeNames":[]},"acm000005766jsd":{"type":"ControlElement","id":"acm000005766jsd","name":"format_heading","comment":"Translates heading to \"SCons Options\" Heading of \"Options\" changed to \"SCons Options.\" Unfortunately, we have to do this here, because those titles are hard-coded in the optparse calls.","startLine":531,"endLine":540,"calleeNames":["super","format_heading"]},"acm000005767jsd":{"type":"ControlElement","id":"acm000005767jsd","name":"format_option","comment":"Customized option formatter. A copy of the normal ``optparse.IndentedHelpFormatter.format_option()`` method. This has been snarfed so we can modify text wrapping to our liking: * add our own regular expression that doesn't break on hyphens (so things like ``--no-print-directory`` don't get broken). * wrap the list of options themselves when it's too long (the ``wrapper.fill(opts)`` call below). * set the :attr:`subsequent_indent` when wrapping the :attr:`help_text`. The help for each option consists of two parts: * the opt strings and metavars e.g. (\"-x\", or \"-fFILENAME, --file=FILENAME\") * the user-supplied help string e.g. (\"turn on expert mode\", \"read data from FILENAME\") If possible, we write both of these on the same line:: -x turn on expert mode But if the opt string list is too long, we put the help string on a second line, indented to the same column it would start in if it fit on the first line:: -fFILENAME, --file=FILENAME read data from FILENAME","startLine":542,"endLine":611,"calleeNames":["expand_default","len","TextWrapper","fill","append","wrap","join"]},"acm000005768jsd":{"type":"ControlElement","id":"acm000005768jsd","name":"store_local_option_strings","comment":"Local-only version of store_option_strings. We need to replicate this so the formatter will be set up properly if we didn't go through the \"normal\" store_option_strings .. versionadded:: 4.6.0","startLine":613,"endLine":629,"calleeNames":["indent","format_option_strings","max","len","dedent","min"]},"acm000005769jsd":{"type":"ClassUnit","id":"acm000005769jsd","name":"SConsIndentedHelpFormatter","comment":"","compilationUnitId":"acm000005772jsd","parentDatatypeId":null,"startLine":526,"endLine":629,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005765jsd","acm000005766jsd","acm000005767jsd","acm000005768jsd"]},"acm000005770jsd":{"type":"ControlElement","id":"acm000005770jsd","name":"diskcheck_convert","comment":"","startLine":46,"endLine":65,"calleeNames":["is_List","split","lower","append","ValueError"]},"acm000005771jsd":{"type":"ControlElement","id":"acm000005771jsd","name":"Parser","comment":"Returns a parser object initialized with the standard SCons options. Add options in the order we want them to show up in the ``-H`` help text, basically alphabetical. Each ``op.add_option()`` call should have a consistent format:: op.add_option(\"-L\", \"--long-option-name\", nargs=1, type=\"string\", dest=\"long_option_name\", default='foo', action=\"callback\", callback=opt_long_option, help=\"help text goes here\", metavar=\"VAR\") Even though the :mod:`optparse` module constructs reasonable default destination names from the long option names, we're going to be explicit about each one for easier readability and so this code will at least show up when grepping the source for option attribute names, or otherwise browsing the source code.","startLine":632,"endLine":1154,"calleeNames":["get_terminal_size","SConsIndentedHelpFormatter","SConsOptionParser","write","add_option","join","split","append","OptionValueError","opt_invalid_rm","opt_invalid","diskcheck_convert","setattr","set_duplicate","getattr","set","sorted","warn","TreePrinter","exit","is_String","extend"]},"acm000005772jsd":{"type":"CodeCompilationUnit","id":"acm000005772jsd","name":"SConsOptions","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000005786jsd","content":["acm000005748jsd","acm000005752jsd","acm000005754jsd","acm000005757jsd","acm000005764jsd","acm000005769jsd","acm000005770jsd","acm000005771jsd"],"pathElements":["Script"],"extension":"py","language":"PYTHON3","importedModuleNames":["gettext","optparse","re","shutil","sys","textwrap","SCons.Node.FS","SCons.Platform.virtualenv","SCons.Warnings","Main"]},"acm000005773jsd":{"type":"ControlElement","id":"acm000005773jsd","name":"_do_nothing","comment":"","startLine":178,"endLine":179,"calleeNames":[]},"acm000005774jsd":{"type":"ControlElement","id":"acm000005774jsd","name":"_add_Default","comment":"","startLine":180,"endLine":181,"calleeNames":["extend"]},"acm000005775jsd":{"type":"ControlElement","id":"acm000005775jsd","name":"_clear","comment":"","startLine":182,"endLine":183,"calleeNames":[]},"acm000005776jsd":{"type":"ClassUnit","id":"acm000005776jsd","name":"TargetList","comment":"","compilationUnitId":"acm000005785jsd","parentDatatypeId":null,"startLine":177,"endLine":183,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005773jsd","acm000005774jsd","acm000005775jsd"]},"acm000005777jsd":{"type":"ControlElement","id":"acm000005777jsd","name":"_Add_Arguments","comment":"","startLine":202,"endLine":206,"calleeNames":["split","append"]},"acm000005778jsd":{"type":"ControlElement","id":"acm000005778jsd","name":"_Add_Targets","comment":"","startLine":208,"endLine":216,"calleeNames":["extend"]},"acm000005779jsd":{"type":"ControlElement","id":"acm000005779jsd","name":"_Set_Default_Targets_Has_Been_Called","comment":"","startLine":218,"endLine":219,"calleeNames":[]},"acm000005780jsd":{"type":"ControlElement","id":"acm000005780jsd","name":"_Set_Default_Targets_Has_Not_Been_Called","comment":"","startLine":221,"endLine":224,"calleeNames":["Dir"]},"acm000005781jsd":{"type":"ControlElement","id":"acm000005781jsd","name":"_Set_Default_Targets","comment":"","startLine":228,"endLine":248,"calleeNames":["_clear","isinstance","append","_add_Default","arg2nodes","extend"]},"acm000005782jsd":{"type":"ControlElement","id":"acm000005782jsd","name":"HelpFunction","comment":"The implementaion of the the ``Help`` method. See :meth:`~SCons.Script.SConscript.Help`. .. versionchanged:: 4.6.0 The *keep_local* parameter was added.\nWill be non-zero if we are reading an SConscript file.","startLine":254,"endLine":271,"calleeNames":["StringIO","PrintHelp","getvalue"]},"acm000005783jsd":{"type":"ControlElement","id":"acm000005783jsd","name":"set_missing_sconscript_error","comment":"Set behavior on missing file in SConscript() call. Returns: previous value","startLine":280,"endLine":289,"calleeNames":[]},"acm000005784jsd":{"type":"ControlElement","id":"acm000005784jsd","name":"Variables","comment":"Adding global functions to the SConscript name space.\n\nStatic functions that do not trigger initialization of\nDefaultEnvironment() and don't use its state.","startLine":292,"endLine":293,"calleeNames":["Variables"]},"acm000005785jsd":{"type":"CodeCompilationUnit","id":"acm000005785jsd","name":"__init__","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nThe main() function used by the scons script. Architecturally, this *is* the scons script, and will likely only be called from the external \"scons\" wrapper. Consequently, anything here should not be, or be considered, part of the build engine. If it's something that we expect other software to want to use, it should go in some other module. If it's specific to the \"scons\" script invocation, it goes here.","parentId":"acm000005786jsd","content":["acm000005776jsd","acm000005777jsd","acm000005778jsd","acm000005779jsd","acm000005780jsd","acm000005781jsd","acm000005782jsd","acm000005783jsd","acm000005784jsd"],"pathElements":["Script"],"extension":"py","language":"PYTHON3","importedModuleNames":["time","collections","os","io.StringIO","sys","SCons.Action","SCons.Builder","SCons.Environment","SCons.Node.FS","SCons.Platform","SCons.Platform.virtualenv","SCons.Scanner","SCons.SConf","SCons.Subst","SCons.Tool","SCons.Util","SCons.Variables","SCons.Defaults","Main","SConscript"]},"acm000005786jsd":{"type":"CodePackage","id":"acm000005786jsd","name":"Script","comment":"","parentId":null,"content":["acm000005639jsd","acm000005709jsd","acm000005710jsd","acm000005743jsd","acm000005744jsd","acm000005772jsd","acm000005785jsd"]},"acm000005787jsd":{"type":"ControlElement","id":"acm000005787jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005788jsd":{"type":"ControlElement","id":"acm000005788jsd","name":"set","comment":"","startLine":62,"endLine":63,"calleeNames":[]},"acm000005789jsd":{"type":"ControlElement","id":"acm000005789jsd","name":"__call__","comment":"","startLine":65,"endLine":66,"calleeNames":[]},"acm000005790jsd":{"type":"ClassUnit","id":"acm000005790jsd","name":"InterruptState","comment":"","compilationUnitId":"acm000005842jsd","parentDatatypeId":null,"startLine":58,"endLine":66,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005787jsd","acm000005788jsd","acm000005789jsd"]},"acm000005791jsd":{"type":"ControlElement","id":"acm000005791jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005792jsd":{"type":"ControlElement","id":"acm000005792jsd","name":"run","comment":"Run the jobs. postfunc() will be invoked after the jobs has run. It will be invoked even if the jobs are interrupted by a keyboard interrupt (well, in fact by a signal such as either SIGINT, SIGTERM or SIGHUP). The execution of postfunc() is protected against keyboard interrupts and is guaranteed to run to completion.","startLine":101,"endLine":115,"calleeNames":["_setup_sig_handler","start","postfunc","_reset_sig_handler"]},"acm000005793jsd":{"type":"ControlElement","id":"acm000005793jsd","name":"were_interrupted","comment":"Returns whether the jobs were interrupted by a signal.","startLine":117,"endLine":119,"calleeNames":["interrupted"]},"acm000005794jsd":{"type":"ControlElement","id":"acm000005794jsd","name":"_setup_sig_handler","comment":"Setup an interrupt handler so that SCons can shutdown cleanly in various conditions: a) SIGINT: Keyboard interrupt b) SIGTERM: kill or system shutdown c) SIGHUP: Controlling shell exiting We handle all of these cases by stopping the taskmaster. It turns out that it's very difficult to stop the build process by throwing asynchronously an exception such as KeyboardInterrupt. For example, the python Condition variables (threading.Condition) and queues do not seem to be asynchronous-exception-safe. It would require adding a whole bunch of try/finally block and except KeyboardInterrupt all over the place. Note also that we have to be careful to handle the case when SCons forks before executing another process. In that case, we want the child to exit immediately.","startLine":121,"endLine":159,"calleeNames":["getpid","stop","set","_exit","signal","hasattr","warn"]},"acm000005795jsd":{"type":"ControlElement","id":"acm000005795jsd","name":"_reset_sig_handler","comment":"Restore the signal handlers to their previous state (before the call to _setup_sig_handler().","startLine":161,"endLine":172,"calleeNames":["signal"]},"acm000005796jsd":{"type":"ClassUnit","id":"acm000005796jsd","name":"Jobs","comment":"An instance of this class initializes N jobs, and provides methods for starting, stopping, and waiting on all N jobs.","compilationUnitId":"acm000005842jsd","parentDatatypeId":null,"startLine":69,"endLine":172,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005791jsd","acm000005792jsd","acm000005793jsd","acm000005794jsd","acm000005795jsd"]},"acm000005797jsd":{"type":"ControlElement","id":"acm000005797jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005798jsd":{"type":"ControlElement","id":"acm000005798jsd","name":"start","comment":"Start the job. This will begin pulling tasks from the taskmaster and executing them, and return when there are no more tasks. If a task fails to execute (i.e. execute() raises an exception), then the job will stop.\nLet the failed() callback function arrange for the\nbuild to stop if that's appropriate.","startLine":195,"endLine":228,"calleeNames":["next_task","prepare","needs_execute","execute","interrupted","BuildError","exception_set","failed","executed","postprocess","cleanup"]},"acm000005799jsd":{"type":"ClassUnit","id":"acm000005799jsd","name":"Serial","comment":"This class is used to execute tasks in series, and is more efficient than Parallel, but is only appropriate for non-parallel builds. Only one instance of this class should be in existence at a time. This class is not thread safe.","compilationUnitId":"acm000005842jsd","parentDatatypeId":null,"startLine":175,"endLine":228,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005797jsd","acm000005798jsd"]},"acm000005800jsd":{"type":"ControlElement","id":"acm000005800jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005801jsd":{"type":"ControlElement","id":"acm000005801jsd","name":"run","comment":"Run the jobs. postfunc() will be invoked after the jobs has run. It will be invoked even if the jobs are interrupted by a keyboard interrupt (well, in fact by a signal such as either SIGINT, SIGTERM or SIGHUP). The execution of postfunc() is protected against keyboard interrupts and is guaranteed to run to completion.","startLine":101,"endLine":115,"calleeNames":["_setup_sig_handler","start","postfunc","_reset_sig_handler"]},"acm000005802jsd":{"type":"ControlElement","id":"acm000005802jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005803jsd":{"type":"ControlElement","id":"acm000005803jsd","name":"run","comment":"Run the jobs. postfunc() will be invoked after the jobs has run. It will be invoked even if the jobs are interrupted by a keyboard interrupt (well, in fact by a signal such as either SIGINT, SIGTERM or SIGHUP). The execution of postfunc() is protected against keyboard interrupts and is guaranteed to run to completion.","startLine":101,"endLine":115,"calleeNames":["_setup_sig_handler","start","postfunc","_reset_sig_handler"]},"acm000005804jsd":{"type":"ClassUnit","id":"acm000005804jsd","name":"Worker","comment":"A worker thread waits on a task to be posted to its request queue, dequeues the task, executes it, and posts a tuple including the task and a boolean indicating whether the task executed successfully.","compilationUnitId":"acm000005842jsd","parentDatatypeId":null,"startLine":231,"endLine":265,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005800jsd","acm000005801jsd","acm000005802jsd","acm000005803jsd"]},"acm000005805jsd":{"type":"ControlElement","id":"acm000005805jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005806jsd":{"type":"ControlElement","id":"acm000005806jsd","name":"put","comment":"Put task into request queue.","startLine":301,"endLine":303,"calleeNames":["put"]},"acm000005807jsd":{"type":"ControlElement","id":"acm000005807jsd","name":"get","comment":"Remove and return a result tuple from the results queue.","startLine":305,"endLine":307,"calleeNames":["get"]},"acm000005808jsd":{"type":"ControlElement","id":"acm000005808jsd","name":"preparation_failed","comment":"","startLine":309,"endLine":310,"calleeNames":["put"]},"acm000005809jsd":{"type":"ControlElement","id":"acm000005809jsd","name":"cleanup","comment":"Shuts down the thread pool, giving each worker thread a chance to shut down gracefully.\nFor each worker thread, put a sentinel \"None\" value\non the requestQueue (indicating that there's no work\nto be done) so that each worker thread will get one and\nterminate gracefully.\nWait for all of the workers to terminate.\n\nIf we don't do this, later Python versions (2.4, 2.5) often\nseem to raise exceptions during shutdown. This happens\nin requestQueue.get(), as an assertion failure that\nrequestQueue.not_full is notified while not acquired,\nseemingly because the main thread has shut down (or is\nin the process of doing so) while the workers are still\ntrying to pull sentinels off the requestQueue.\n\nNormally these terminations should happen fairly quickly,\nbut we'll stick a one-second timeout on here just in case\nsomeone gets hung.","startLine":312,"endLine":339,"calleeNames":["put","join"]},"acm000005810jsd":{"type":"ClassUnit","id":"acm000005810jsd","name":"ThreadPool","comment":"This class is responsible for spawning and managing worker threads.","compilationUnitId":"acm000005842jsd","parentDatatypeId":null,"startLine":267,"endLine":339,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005805jsd","acm000005806jsd","acm000005807jsd","acm000005808jsd","acm000005809jsd"]},"acm000005811jsd":{"type":"ControlElement","id":"acm000005811jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005812jsd":{"type":"ControlElement","id":"acm000005812jsd","name":"start","comment":"Start the job. This will begin pulling tasks from the taskmaster and executing them, and return when there are no more tasks. If a task fails to execute (i.e. execute() raises an exception), then the job will stop.\nLet the failed() callback function arrange for the\nbuild to stop if that's appropriate.","startLine":195,"endLine":228,"calleeNames":["next_task","prepare","needs_execute","execute","interrupted","BuildError","exception_set","failed","executed","postprocess","cleanup"]},"acm000005813jsd":{"type":"ClassUnit","id":"acm000005813jsd","name":"LegacyParallel","comment":"This class is used to execute tasks in parallel, and is somewhat less efficient than Serial, but is appropriate for parallel builds. This class is thread safe.","compilationUnitId":"acm000005842jsd","parentDatatypeId":null,"startLine":341,"endLine":430,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005811jsd","acm000005812jsd"]},"acm000005814jsd":{"type":"ClassUnit","id":"acm000005814jsd","name":"State","comment":"","compilationUnitId":"acm000005842jsd","parentDatatypeId":null,"startLine":435,"endLine":439,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000005815jsd":{"type":"ControlElement","id":"acm000005815jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005816jsd":{"type":"ControlElement","id":"acm000005816jsd","name":"run","comment":"Run the jobs. postfunc() will be invoked after the jobs has run. It will be invoked even if the jobs are interrupted by a keyboard interrupt (well, in fact by a signal such as either SIGINT, SIGTERM or SIGHUP). The execution of postfunc() is protected against keyboard interrupts and is guaranteed to run to completion.","startLine":101,"endLine":115,"calleeNames":["_setup_sig_handler","start","postfunc","_reset_sig_handler"]},"acm000005817jsd":{"type":"ControlElement","id":"acm000005817jsd","name":"__init__","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005818jsd":{"type":"ControlElement","id":"acm000005818jsd","name":"run","comment":"Run the jobs. postfunc() will be invoked after the jobs has run. It will be invoked even if the jobs are interrupted by a keybo