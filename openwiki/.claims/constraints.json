    {
      "id": "claim_1a4c71919599421a86307ee944dbbf0c",
      "statement": "The determinism contract is annotation-driven: @Deterministic (with an optional value() reviewer comment) marks a class as deterministic by user review and is the per-class opt-out (not inherited) from forbidUnorderedSetsAndMaps, which forbids classes outside ..tests.., ..metrics.., and ..magika.. from accessing or depending on the unordered JDK/Eclipse types and factories (Set/HashSet, Mutable/ImmutableSet, Sets, Map/HashMap, Mutable/ImmutableMap, Maps); @NoHashCodeEquals marks a class that must keep identity semantics, and forbidEqualsAndHashCodeInCertainClasses fails any such class implementing equals or hashCode. forbidHashMapAndHashSetInFavorOfLinkedVersions bans HashMap/HashSet outright outside ..tests.. and ..magika.. in favor of the linked variants.",
      "evidence": [
        {
          "resource": "repo://core/framework/common/src/main/java/edu/kit/kastel/mcse/ardoco/core/architecture/Deterministic.java#L1-L12",
          "version": "repo-lines-v1:sha256:730b5390bbfb509a8108c99de864674c78bfb6565f201b4f8f90516bbd2c0b27:"
