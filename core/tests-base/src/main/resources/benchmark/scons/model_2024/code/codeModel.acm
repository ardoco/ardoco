variables only get applied once.","startLine":952,"endLine":968,"calleeNames":["FakeOptions","Environment"]},"acm000003518jsd":{"type":"ControlElement","id":"acm000003518jsd","name":"test_get","comment":"Test the SubstitutionEnvironment get() method.","startLine":207,"endLine":211,"calleeNames":["SubstitutionEnvironment","get"]},"acm000003519jsd":{"type":"ControlElement","id":"acm000003519jsd","name":"test_Builder_calls","comment":"Test Builder calls through different environments","startLine":983,"endLine":1009,"calleeNames":["Builder","Environment","Replace","builder1","builder2"]},"acm000003520jsd":{"type":"ControlElement","id":"acm000003520jsd","name":"test_BuilderWrapper_attributes","comment":"Test getting and setting of BuilderWrapper attributes.","startLine":1011,"endLine":1031,"calleeNames":["Builder","Environment","Replace","assertRaises"]},"acm000003521jsd":{"type":"ControlElement","id":"acm000003521jsd","name":"_DO_NOT_test_Builder_execs","comment":"Test Builder execution through different environments One environment is initialized with a single Builder object, one with a list of a single Builder object, and one with a list of two Builder objects.","startLine":1037,"endLine":1082,"calleeNames":["Builder","Environment","Replace","execute","Clone","TestEnvironment"]},"acm000003522jsd":{"type":"ControlElement","id":"acm000003522jsd","name":"test_Scanners","comment":"Test setting SCANNERS in various ways One environment is initialized with a single Scanner object, one with a list of a single Scanner object, and one with a list of two Scanner objects.","startLine":1086,"endLine":1183,"calleeNames":["Scanner","Environment","list","map","TestEnvironment","Replace","Append","AppendUnique","Clone","PrependUnique","Prepend","upper"]},"acm000003523jsd":{"type":"ControlElement","id":"acm000003523jsd","name":"test_ENV","comment":"Test setting the external ENV in Environments","startLine":1185,"endLine":1192,"calleeNames":["Environment","Dictionary","TestEnvironment"]