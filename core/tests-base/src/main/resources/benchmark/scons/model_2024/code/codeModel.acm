\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nclass DummyNode:\ndef __init__(self, name, fs):\nself.name = name\nself.abspath = test.workpath(name)\nself.fs = fs\ndef __str__(self):\nreturn self.name\ndef Entry(self, name):\nreturn self.fs.Entry(name)","parentId":"acm000005623jsd","content":["acm000005195jsd","acm000005197jsd","acm000005199jsd","acm000005201jsd"],"pathElements":["Scanner"],"extension":"py","language":"PYTHON3","importedModuleNames":["os.path","unittest","TestCmd","SCons.Node.FS","SCons.Scanner.Dir","SCons.SConsign.current_sconsign_filename"]},"acm000005203jsd":{"type":"ControlElement","id":"acm000005203jsd","name":"__init__","comment":"","startLine":36,"endLine":39,"calleeNames":["super","__init__","update","FS","workpath"]},"acm000005204jsd":{"type":"ControlElement","id":"acm000005204jsd","name":"Dictionary","comment":"","startLine":41,"endLine":42,"calleeNames":[]},"acm000005205jsd":{"type":"ControlElement","id":"acm000005205jsd","name":"subst","comment":"","startLine":44,"endLine":47,"calleeNames":[]},"acm000005206jsd":{"type":"ControlElement","id":"acm000005206jsd","name":"subst_list","comment":"","startLine":49,"endLine":52,"calleeNames":[]},"acm000005207jsd":{"type":"ControlElement","id":"acm000005207jsd","name":"subst_path","comment":"","startLine":54,"endLine":57,"calleeNames":["isinstance","list","map"]},"acm000005208jsd":{"type":"ControlElement","id":"acm000005208jsd","name":"get_calculator","comment":"","startLine":59,"endLine":60,"calleeNames":[]},"acm000005209jsd":{"type":"ControlElement","id":"acm000005209jsd","name":"get_factory","comment":"","startLine":62,"endLine":63,"calleeNames":[]},"acm000005210jsd":{"type":"ControlElement","id":"acm000005210jsd","name":"Dir","comment":"","startLine":65,"endLine":66,"calleeNames":["Dir"]},"acm000005211jsd":{"type":"ControlElement","id":"acm000005211jsd","name":"File","comment":"","startLine":68,"endLine":69,"calleeNames":["File"]},"acm000005212jsd":{"type":"ClassUnit","id":"