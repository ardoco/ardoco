estCmd"]},"acm000002711jsd":{"type":"ControlElement","id":"acm000002711jsd","name":"__init__","comment":"","startLine":54,"endLine":59,"calleeNames":[]},"acm000002712jsd":{"type":"ControlElement","id":"acm000002712jsd","name":"__call__","comment":"","startLine":61,"endLine":75,"calleeNames":["subst","scons_subproc_run","write","str"]},"acm000002713jsd":{"type":"ControlElement","id":"acm000002713jsd","name":"strfunction","comment":"","startLine":77,"endLine":82,"calleeNames":["subst"]},"acm000002714jsd":{"type":"ClassUnit","id":"acm000002714jsd","name":"_CmdRunner","comment":"Callable object, which runs shell command storing its stdout and stderr to variables. It also provides `strfunction()` method, which shall be used by scons Action objects to print command string.","compilationUnitId":"acm000002724jsd","parentDatatypeId":null,"startLine":49,"endLine":82,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002711jsd","acm000002712jsd","acm000002713jsd"]},"acm000002715jsd":{"type":"ControlElement","id":"acm000002715jsd","name":"_execute","comment":"","startLine":162,"endLine":169,"calleeNames":["_execute"]},"acm000002716jsd":{"type":"ClassUnit","id":"acm000002716jsd","name":"_POTBuilder","comment":"","compilationUnitId":"acm000002724jsd","parentDatatypeId":null,"startLine":161,"endLine":169,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002715jsd"]},"acm000002717jsd":{"type":"ControlElement","id":"acm000002717jsd","name":"_update_pot_file","comment":"Action function for `POTUpdate` builder","startLine":85,"endLine":158,"calleeNames":["getcwd","repr","get_abspath","Execute","Action","chdir","_CmdRunner","action","exists","get_text_contents","compile","sub","str","open","write","close"]},"acm000002718jsd":{"type":"ControlElement","id":"acm000002718jsd","name":"_scan_xgettext_from_files","comment":"Parses `POTFILES.in`-like file and returns list of extracted file names.","startLine":172,"endLine":218,"calleeNames":["is_List","flatten","isinstance","is_String","subst","arg2nodes","tuple","getcwd","compile","rexists","get_text_contents","sub","splitlines","find_file","Depends"]},"acm000002719jsd":{"type":"ControlElement","id":"acm000002719jsd","name":"_pot_update_emitter","comment":"Emitter function for `POTUpdate` builder","startLine":221,"endLine":244,"calleeNames":["is_List","flatten","isinstance","is_String","subst","arg2nodes","extend","Depends","_scan_xgettext_from_files"]},"acm000002720jsd":{"type":"ControlElement","id":"acm000002720jsd","name":"_POTUpdateBuilderWrapper","comment":"","startLine":247,"endLine":248,"calleeNames":["_POTUpdateBuilder"]},"acm000002721jsd":{"type":"ControlElement","id":"acm000002721jsd","name":"_POTUpdateBuilder","comment":"Creates `POTUpdate` builder object","startLine":251,"endLine":257,"calleeNames":["Action","_POTargetFactory","_POTBuilder"]},"acm000002722jsd":{"type":"ControlElement","id":"acm000002722jsd","name":"generate","comment":"Generate `xgettext` tool\nXgettextToolWarning, # using this breaks test, so keep:\nNOTE: sources=\"$SOURCES\" would work as well. However, we use following\nconstruction to convert absolute paths provided by scons onto paths\nrelative to current working dir. Note, that scons expands $SOURCE(S) to\nabsolute paths for sources $SOURCE(s) outside of current subtree (e.g. in\n\"../\"). With source=$SOURCE these absolute paths would be written to the\nresultant *.pot file (and its derived *.po files) as references to lines in\nsource code (e.g. referring lines in *.c files). Such references would be\ncorrect (e.g. in poedit) only on machine on which *.pot was generated and\nwould be of no use on other hosts (having a copy of source code located\nin different place in filesystem).","startLine":260,"endLine":322,"calleeNames":["find_program_path","dirname","AppendENVPath","warn","_detect_xgettext","SetDefault","RPaths","Append","_POTUpdateBuilder","AddMethod","AlwaysBuild","Alias"]},"acm000002723jsd":{"type":"ControlElement","id":"acm000002723jsd","name":"exists","comment":"Check, whether the tool exists\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":325,"endLine":330,"calleeNames":["_xgettext_exists"]},"acm000002724jsd":{"type":"CodeCompilationUnit","id":"acm000002724jsd","name":"xgettext","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool specific initialization of `xgettext` tool.\nXgettextToolWarning,","parentId":"acm000002768jsd","content":["acm000002714jsd","acm000002716jsd","acm000002717jsd","acm000002718jsd","acm000002719jsd","acm000002720jsd","acm000002721jsd","acm000002722jsd","acm000002723jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","re","sys","subprocess.PIPE","SCons.Action","SCons.Node.FS","SCons.Tool","SCons.Util","SCons.Warnings","SCons.Builder.BuilderBase","SCons.Environment._null","SCons.Platform.cygwin.CYGWIN_DEFAULT_PATHS","SCons.Platform.mingw.MINGW_DEFAULT_PATHS","SCons.Tool.GettextCommon._detect_xgettext","SCons.Tool.GettextCommon._POTargetFactory","SCons.Tool.GettextCommon.RPaths","SCons.Tool.GettextCommon._xgettext_exists"]},"acm000002725jsd":{"type":"ControlElement","id":"acm000002725jsd","name":"_yaccEmitter","comment":"Adds extra files generated by yacc program to target list.","startLine":59,"endLine":122,"calleeNames":["subst_list","splitext","to_String","append","subst","SideEffect","Clean","len","strip","Replace","File"]},"acm000002726jsd":{"type":"ControlElement","id":"acm000002726jsd","name":"yEmitter","comment":"","startLine":125,"endLine":126,"calleeNames":["_yaccEmitter"]},"acm000002727jsd":{"type":"ControlElement","id":"acm000002727jsd","name":"ymEmitter","comment":"","startLine":129,"endLine":130,"calleeNames":["_yaccEmitter"]},"acm000002728jsd":{"type":"ControlElement","id":"acm000002728jsd","name":"yyEmitter","comment":"","startLine":133,"endLine":134,"calleeNames":["_yaccEmitter"]},"acm000002729jsd":{"type":"ControlElement","id":"acm000002729jsd","name":"get_yacc_path","comment":"Returns the path to the yacc tool, searching several possible names. Only called in the Windows case, so the `default_path` argument to :func:`find_program_path` can be Windows-specific. Args: env: current construction environment append_paths: if true, add the path to the tool to PATH","startLine":137,"endLine":161,"calleeNames":["find_program_path","warn"]},"acm000002730jsd":{"type":"ControlElement","id":"acm000002730jsd","name":"generate","comment":"Add Builders and construction variables for yacc to an Environment.\nC\nObjective-C\nC++\nignore the return, all we need is for the path to be added","startLine":164,"endLine":200,"calleeNames":["createCFileBuilders","add_action","add_emitter","get_yacc_path","SetDefault","Detect","CLVar"]},"acm000002731jsd":{"type":"ControlElement","id":"acm000002731jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":203,"endLine":210,"calleeNames":["Detect","get_yacc_path"]},"acm000002732jsd":{"type":"CodeCompilationUnit","id":"acm000002732jsd","name":"yacc","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool-specific initialization for yacc. This tool should support multiple yacc implementations, but is in actuality biased towards GNU Bison. In particular, it forces the output file name (thus avoiding the default convention of y.tab.c or foo.tab.c), so the tool *must* support the -o option, which pure POSIX yacc does not. byacc should be okay as an alternative to bison. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.","parentId":"acm000002768jsd","content":["acm000002725jsd","acm000002726jsd","acm000002727jsd","acm000002728jsd","acm000002729jsd","acm000002730jsd","acm000002731jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os.path","sys","typing.Optional","SCons.Defaults","SCons.Tool","SCons.Warnings","SCons.Platform.mingw.MINGW_DEFAULT_PATHS","SCons.Platform.cygwin.CYGWIN_DEFAULT_PATHS","SCons.Platform.win32.CHOCO_DEFAULT_PATH","SCons.Util.CLVar","SCons.Util.to_String"]},"acm000002733jsd":{"type":"ControlElement","id":"acm000002733jsd","name":"_create_zipinfo_for_file","comment":"","startLine":48,"endLine":57,"calleeNames":["stat","localtime","ZipInfo"]},"acm000002734jsd":{"type":"ControlElement","id":"acm000002734jsd","name":"zip_builder","comment":"","startLine":60,"endLine":82,"calleeNames":["get","str","isdir","walk","join","isfile","append","ZipFile","relpath","_create_zipinfo_for_file","open","writestr","read"]},"acm000002735jsd":{"type":"ControlElement","id":"acm000002735jsd","name":"generate","comment":"Add Builders and construction variables for zip to an Environment.","startLine":97,"endLine":110,"calleeNames":["CLVar"]},"acm000002736jsd":{"type":"ControlElement","id":"acm000002736jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":113,"endLine":114,"calleeNames":[]},"acm000002737jsd":{"type":"CodeCompilationUnit","id":"acm000002737jsd","name":"zip","comment":"SCons.Tool.zip Tool-specific initialization for zip. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.\nMIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000002768jsd","content":["acm000002733jsd","acm000002734jsd","acm000002735jsd","acm000002736jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","SCons.Builder","SCons.Defaults","SCons.Node.FS","SCons.Util","time","zipfile"]},"acm000002738jsd":{"type":"ControlElement","id":"acm000002738jsd","name":"__init__","comment":"Rename if there's a TOOL_ALIAS for this tool","startLine":108,"endLine":122,"calleeNames":["get","_tool_module","hasattr"]},"acm000002739jsd":{"type":"ControlElement","id":"acm000002739jsd","name":"_tool_module","comment":"Try to load a tool module. This will hunt in the toolpath for both a Python file (toolname.py) and a Python module (toolname directory), then try the regular import machinery, then fallback to try a zipfile.","startLine":124,"endLine":242,"calleeNames":["replace","join","write","isfile","spec_from_file_location","isdir","find_spec","normpath","UserError","module_from_spec","SConsEnvironmentError","get","exec_module","setattr","zipimporter","hasattr","load_module"]},"acm000002740jsd":{"type":"ControlElement","id":"acm000002740jsd","name":"__call__","comment":"Merge call kws into init kws;\nbut don't bash self.init_kw.","startLine":244,"endLine":265,"calleeNames":["copy","update","Append","hasattr","Variables","options","Update","generate"]},"acm000002741jsd":{"type":"ControlElement","id":"acm000002741jsd","name":"__str__","comment":"","startLine":267,"endLine":268,"calleeNames":[]},"acm000002742jsd":{"type":"ClassUnit","id":"acm000002742jsd","name":"Tool","comment":"","compilationUnitId":"acm000002767jsd","parentDatatypeId":null,"startLine":107,"endLine":268,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002738jsd","acm000002739jsd","acm000002740jsd","acm000002741jsd"]},"acm000002743jsd":{"type":"ControlElement","id":"acm000002743jsd","name":"__init__","comment":"Rename if there's a TOOL_ALIAS for this tool","startLine":108,"endLine":122,"calleeNames":["get","_tool_module","hasattr"]},"acm000002744jsd":{"type":"ControlElement","id":"acm000002744jsd","name":"get_builder","comment":"Returns the appropriate real Builder for this method name after having the associated ToolInitializer object apply the appropriate Tool module.","startLine":568,"endLine":588,"calleeNames":["getattr","apply_tools","remove_methods"]},"acm000002745jsd":{"type":"ControlElement","id":"acm000002745jsd","name":"__call__","comment":"Merge call kws into init kws;\nbut don't bash self.init_kw.","startLine":244,"endLine":265,"calleeNames":["copy","update","Append","hasattr","Variables","options","Update","generate"]},"acm000002746jsd":{"type":"ClassUnit","id":"acm000002746jsd","name":"ToolInitializerMethod","comment":"This is added to a construction environment in place of a method(s) normally called for a Builder (env.Object, env.StaticObject, etc.). When called, it has its associated ToolInitializer object search the specified list of tools and apply the first one that exists to the construction environment. It then calls whatever builder was (presumably) added to the construction environment in place of this particular instance.","compilationUnitId":"acm000002767jsd","parentDatatypeId":null,"startLine":549,"endLine":596,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002743jsd","acm000002744jsd","acm000002745jsd"]},"acm000002747jsd":{"type":"ControlElement","id":"acm000002747jsd","name":"__init__","comment":"Rename if there's a TOOL_ALIAS for this tool","startLine":108,"endLine":122,"calleeNames":["get","_tool_module","hasattr"]},"acm000002748jsd":{"type":"ControlElement","id":"acm000002748jsd","name":"remove_methods","comment":"Removes the methods that were added by the tool initialization so we no longer copy and re-bind them when the construction environment gets cloned.","startLine":625,"endLine":632,"calleeNames":["values","RemoveMethod"]},"acm000002749jsd":{"type":"ControlElement","id":"acm000002749jsd","name":"apply_tools","comment":"Searches the list of associated Tool modules for one that exists, and applies that to the construction environment.\nIf we fall through here, there was no tool module found.\nThis is where we can put an informative error message\nabout the inability to find the tool. We'll start doing\nthis as we cut over more pre-defined Builder+Tools to use\nthe ToolInitializer class.","startLine":634,"endLine":643,"calleeNames":["Tool","exists"]},"acm000002750jsd":{"type":"ClassUnit","id":"acm000002750jsd","name":"ToolInitializer","comment":"A class for delayed initialization of Tools modules. Instances of this class associate a list of Tool modules with a list of Builder method names that will be added by those Tool modules. As part of instantiating this object for a particular construction environment, we also add the appropriate ToolInitializerMethod objects for the various Builder methods that we want to use to delay Tool searches until necessary.","compilationUnitId":"acm000002767jsd","parentDatatypeId":null,"startLine":599,"endLine":643,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002747jsd","acm000002748jsd","acm000002749jsd"]},"acm000002751jsd":{"type":"ControlElement","id":"acm000002751jsd","name":"createProgBuilder","comment":"This is a utility function that creates the Program Builder in an Environment if it is not there already. If it is already there, we return the existing one.","startLine":277,"endLine":297,"calleeNames":["Builder"]},"acm000002752jsd":{"type":"ControlElement","id":"acm000002752jsd","name":"createStaticLibBuilder","comment":"This is a utility function that creates the StaticLibrary Builder in an Environment if it is not there already. If it is already there, we return the existing one.","startLine":300,"endLine":324,"calleeNames":["Action","get","Detect","append","Builder"]},"acm000002753jsd":{"type":"ControlElement","id":"acm000002753jsd","name":"createSharedLibBuilder","comment":"This is a utility function that creates the SharedLibrary Builder in an Environment if it is not there already. If it is already there, we return the existing one. Args: shlib_suffix: The suffix specified for the shared library builder","startLine":327,"endLine":354,"calleeNames":["Builder"]},"acm000002754jsd":{"type":"ControlElement","id":"acm000002754jsd","name":"createLoadableModuleBuilder","comment":"This is a utility function that creates the LoadableModule Builder in an Environment if it is not there already. If it is already there, we return the existing one. Args: loadable_module_suffix: The suffix specified for the loadable module builder","startLine":357,"endLine":384,"calleeNames":["Builder"]},"acm000002755jsd":{"type":"ControlElement","id":"acm000002755jsd","name":"createObjBuilders","comment":"This is a utility function that creates the StaticObject and SharedObject Builders in an Environment if they are not there already. If they are there already, we return the existing ones. This is a separate function because soooo many Tools use this functionality. The return is a 2-tuple of (StaticObject, SharedObject)","startLine":387,"endLine":425,"calleeNames":["Builder"]},"acm000002756jsd":{"type":"ControlElement","id":"acm000002756jsd","name":"createCFileBuilders","comment":"This is a utility function that creates the CFile/CXXFile Builders in an Environment if they are not there already. If they are there already, we return the existing ones. This is a separate function because soooo many Tools use this functionality. The return is a 2-tuple of (CFile, CXXFile)\n#########################################################################\nCreate common Java builders","startLine":428,"endLine":460,"calleeNames":["Builder","SetDefault"]},"acm000002757jsd":{"type":"ControlElement","id":"acm000002757jsd","name":"CreateJarBuilder","comment":"The Jar builder expects a list of class files which it can package into a jar file. The jar tool provides an interface for passing other types of java files such as .java, directories or swig interfaces and will build them to class files in which it can package into the jar.","startLine":466,"endLine":486,"calleeNames":["get_default_fs","Action","Builder"]},"acm000002758jsd":{"type":"ControlElement","id":"acm000002758jsd","name":"CreateJavaHBuilder","comment":"","startLine":489,"endLine":501,"calleeNames":["get_default_fs","Action","Builder"]},"acm000002759jsd":{"type":"ControlElement","id":"acm000002759jsd","name":"CreateJavaClassFileBuilder","comment":"suffix = '$JAVACLASSSUFFIX',","startLine":504,"endLine":519,"calleeNames":["get_default_fs","Action","Builder"]},"acm000002760jsd":{"type":"ControlElement","id":"acm000002760jsd","name":"CreateJavaClassDirBuilder","comment":"","startLine":522,"endLine":534,"calleeNames":["get_default_fs","Action","Builder"]},"acm000002761jsd":{"type":"ControlElement","id":"acm000002761jsd","name":"CreateJavaFileBuilder","comment":"","startLine":537,"endLine":546,"calleeNames":["Builder"]},"acm000002762jsd":{"type":"ControlElement","id":"acm000002762jsd","name":"Initializers","comment":"","startLine":652,"endLine":666,"calleeNames":["ToolInitializer","_InternalInstall","_InternalInstallAs","_InternalInstallVersionedLib","AddMethod"]},"acm000002763jsd":{"type":"ControlElement","id":"acm000002763jsd","name":"FindTool","comment":"","startLine":669,"endLine":674,"calleeNames":["Tool","exists"]},"acm000002764jsd":{"type":"ControlElement","id":"acm000002764jsd","name":"FindAllTools","comment":"","startLine":677,"endLine":681,"calleeNames":["Tool","exists","list","filter"]},"acm000002765jsd":{"type":"ControlElement","id":"acm000002765jsd","name":"tool_list","comment":"","startLine":684,"endLine":824,"calleeNames":["str","FindTool","FindAllTools"]},"acm000002766jsd":{"type":"ControlElement","id":"acm000002766jsd","name":"find_program_path","comment":"Find the location of a tool using various means. Mainly for windows where tools aren't all installed in /usr/bin, etc. Args: env: Current Construction Environment. key_program: Tool to locate. default_paths: List of additional paths this tool might be found in. add_path: If true, add path found if it was from *default_paths*.\nFirst search in the SCons path","startLine":827,"endLine":866,"calleeNames":["WhereIs","AppendENVPath","dirname"]},"acm000002767jsd":{"type":"CodeCompilationUnit","id":"acm000002767jsd","name":"__init__","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons tool selection. Looks for modules that define a callable object that can modify a construction environment as appropriate for a given tool (or tool chain). Note that because this subsystem just *selects* a callable that can modify a construction environment, it's possible for people to define their own \"tool specification\" in an arbitrary callable function. No one needs to use or tie in to this subsystem in order to roll their own tool specifications.","parentId":"acm000002768jsd","content":["acm000002742jsd","acm000002746jsd","acm000002750jsd","acm000002751jsd","acm000002752jsd","acm000002753jsd","acm000002754jsd","acm000002755jsd","acm000002756jsd","acm000002757jsd","acm000002758jsd","acm000002759jsd","acm000002760jsd","acm000002761jsd","acm000002762jsd","acm000002763jsd","acm000002764jsd","acm000002765jsd","acm000002766jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["sys","os","importlib.util","typing.Optional","SCons.Builder","SCons.Errors","SCons.Node.FS","SCons.Scanner","SCons.Scanner.C","SCons.Scanner.D","SCons.Scanner.Java","SCons.Scanner.LaTeX","SCons.Scanner.Prog","SCons.Scanner.SWIG","SCons.Tool.linkCommon.LibSymlinksActionFunction","SCons.Tool.linkCommon.LibSymlinksStrFun"]},"acm000002768jsd":{"type":"CodePackage","id":"acm000002768jsd","name":"Tool","comment":"","parentId":null,"content":["acm000001343jsd","acm000001382jsd","acm000001410jsd","acm000001835jsd","acm000001925jsd","acm000001981jsd","acm000001984jsd","acm000001985jsd","acm000001989jsd","acm000001993jsd","acm000001997jsd","acm000002001jsd","acm000002010jsd","acm000002013jsd","acm000002014jsd","acm000002017jsd","acm000002021jsd","acm000002