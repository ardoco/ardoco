e shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons.Tool.gcc Tool-specific initialization for gcc. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.","parentId":"acm000002768jsd","content":["acm000002153jsd","acm000002154jsd","acm000002155jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["cc","re","subprocess.PIPE","SCons.Util"]},"acm000002157jsd":{"type":"ControlElement","id":"acm000002157jsd","name":"generate","comment":"","startLine":57,"endLine":129,"calleeNames":["createObjBuilders","add_action","add_emitter","Detect","addDPATHToEnv","CLVar","format","Builder"]},"acm000002158jsd":{"type":"ControlElement","id":"acm000002158jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":132,"endLine":133,"calleeNames":["Detect"]},"acm000002159jsd":{"type":"CodeCompilationUnit","id":"acm000002159jsd","name":"gdc","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons.Tool.gdc Tool-specific initialization for the GDC compiler. (https://github.com/D-Programming-GDC/GDC) Developed by Russel Winder (russel@winder.org.uk) 2012-05-09 onwards Compiler variables: DC - The name of the D compiler to use. Defaults to gdc. DPATH - List of paths to search for import modules. DVERSIONS - List of version tags to enable when compiling. DDEBUG - List of debug tags to enable when compiling. Linker related variables: LIBS - List of library files to link in. DLINK - Name of the linker to use. Defaults to gdc. DLINKFLAGS - List of linker flags. Lib tool variables: DLIB - Name of the lib tool to use. Defaults to lib. DLIBFLAGS - List of flags to pass to the lib tool. LIBS - Same as for the linker. (libraries to pull into the .lib)","parentId":"acm000002768jsd","content":["acm000002157jsd","acm000002158jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Action","SCons.Defaults","SCons.Tool","SCons.Tool.DCommon","SCons.Tool.linkCommon"]},"acm000002160jsd":{"type":"ClassUnit","id":"acm000002160jsd","name":"XgettextToolWarning","comment":"","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":35,"endLine":36,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002161jsd":{"type":"ClassUnit","id":"acm000002161jsd","name":"XgettextNotFound","comment":"","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":39,"endLine":40,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002162jsd":{"type":"ClassUnit","id":"acm000002162jsd","name":"MsginitToolWarning","comment":"","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":43,"endLine":44,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002163jsd":{"type":"ClassUnit","id":"acm000002163jsd","name":"MsginitNotFound","comment":"","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":47,"endLine":48,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002164jsd":{"type":"ClassUnit","id":"acm000002164jsd","name":"MsgmergeToolWarning","comment":"","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":51,"endLine":52,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002165jsd":{"type":"ClassUnit","id":"acm000002165jsd","name":"MsgmergeNotFound","comment":"","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":55,"endLine":56,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002166jsd":{"type":"ClassUnit","id":"acm000002166jsd","name":"MsgfmtToolWarning","comment":"","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":59,"endLine":60,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002167jsd":{"type":"ClassUnit","id":"acm000002167jsd","name":"MsgfmtNotFound","comment":"","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":63,"endLine":64,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002168jsd":{"type":"ControlElement","id":"acm000002168jsd","name":"__init__","comment":"Object constructor. **Arguments** - *env* (`SCons.Environment.Environment`) - *nodefault* (`boolean`) - if `True`, produced nodes will be ignored from default target `'.'` - *alias* (`string`) - if provided, produced nodes will be automatically added to this alias, and alias will be set as `AlwaysBuild` - *precious* (`boolean`) - if `True`, the produced nodes will be set as `Precious`. - *noclen* (`boolean`) - if `True`, the produced nodes will be excluded from `Clean`.","startLine":85,"endLine":105,"calleeNames":[]},"acm000002169jsd":{"type":"ControlElement","id":"acm000002169jsd","name":"_create_node","comment":"Create node, and set it up to factory settings.","startLine":107,"endLine":116,"calleeNames":["factory","set_noclean","set_precious","Ignore","AlwaysBuild","Alias"]},"acm000002170jsd":{"type":"ControlElement","id":"acm000002170jsd","name":"Entry","comment":"Create `SCons.Node.FS.Entry`","startLine":118,"endLine":120,"calleeNames":["_create_node"]},"acm000002171jsd":{"type":"ControlElement","id":"acm000002171jsd","name":"File","comment":"Create `SCons.Node.FS.File`","startLine":122,"endLine":124,"calleeNames":["_create_node"]},"acm000002172jsd":{"type":"ClassUnit","id":"acm000002172jsd","name":"_POTargetFactory","comment":"A factory of `PO` target files. Factory defaults differ from these of `SCons.Node.FS.FS`. We set `precious` (this is required by builders and actions gettext) and `noclean` flags by default for all produced nodes.","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":77,"endLine":124,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002168jsd","acm000002169jsd","acm000002170jsd","acm000002171jsd"]},"acm000002173jsd":{"type":"ControlElement","id":"acm000002173jsd","name":"__init__","comment":"Object constructor. **Arguments** - *env* (`SCons.Environment.Environment`) - *nodefault* (`boolean`) - if `True`, produced nodes will be ignored from default target `'.'` - *alias* (`string`) - if provided, produced nodes will be automatically added to this alias, and alias will be set as `AlwaysBuild` - *precious* (`boolean`) - if `True`, the produced nodes will be set as `Precious`. - *noclen* (`boolean`) - if `True`, the produced nodes will be excluded from `Clean`.","startLine":85,"endLine":105,"calleeNames":[]},"acm000002174jsd":{"type":"ControlElement","id":"acm000002174jsd","name":"_execute","comment":"Execute builder's actions. Here we append to `target` the languages read from `$LINGUAS_FILE` and apply `SCons.Builder.BuilderBase._execute()` separatelly to each target. The arguments and return value are same as for `SCons.Builder.BuilderBase._execute()`.","startLine":211,"endLine":245,"calleeNames":["_read_linguas_from_files","is_List","extend","_execute","NodeList"]},"acm000002175jsd":{"type":"ClassUnit","id":"acm000002175jsd","name":"_POFileBuilder","comment":"`PO` file builder. This is multi-target single-source builder. In typical situation the source is single `POT` file, e.g. `messages.pot`, and there are multiple `PO` targets to be updated from this `POT`. We must run `SCons.Builder.BuilderBase._execute()` separatelly for each target to track dependencies separatelly for each target file. **NOTE**: if we call `SCons.Builder.BuilderBase._execute(.., target, ...)` with target being list of all targets, all targets would be rebuilt each time one of the targets from this list is missing. This would happen, for example, when new language `ll` enters `LINGUAS_FILE` (at this moment there is no `ll.po` file yet). To avoid this, we override `SCons.Builder.BuilerBase._execute()` and call it separatelly for each target. Here we also append to the target list the languages read from `LINGUAS_FILE`.\n\n* The argument for overriding _execute(): We must use environment with\nbuilder overrides applied (see BuilderBase.__init__(). Here it comes for\nfree.\n* The argument against using 'emitter': The emitter is called too late\nby BuilderBase._execute(). If user calls, for example:\n\nenv.POUpdate(LINGUAS_FILE = 'LINGUAS')\n\nthe builder throws error, because it is called with target=None,\nsource=None and is trying to \"generate\" sources or target list first.\nIf user calls\n\nenv.POUpdate(['foo', 'baz'], LINGUAS_FILE = 'LINGUAS')\n\nthe env.BuilderWrapper() calls our builder with target=None,\nsource=['foo', 'baz']. The BuilderBase._execute() then splits execution\nand execute iterativelly (recursion) self._execute(None, source[i]).\nAfter that it calls emitter (which is quite too late). The emitter is\nalso called in each iteration, what makes things yet worse.","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":155,"endLine":245,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002173jsd","acm000002174jsd"]},"acm000002176jsd":{"type":"ControlElement","id":"acm000002176jsd","name":"__init__","comment":"Object constructor. **Arguments** - *env* (`SCons.Environment.Environment`) - *nodefault* (`boolean`) - if `True`, produced nodes will be ignored from default target `'.'` - *alias* (`string`) - if provided, produced nodes will be automatically added to this alias, and alias will be set as `AlwaysBuild` - *precious* (`boolean`) - if `True`, the produced nodes will be set as `Precious`. - *noclen* (`boolean`) - if `True`, the produced nodes will be excluded from `Clean`.","startLine":85,"endLine":105,"calleeNames":[]},"acm000002177jsd":{"type":"ControlElement","id":"acm000002177jsd","name":"__call__","comment":"Return nodes' paths (strings) relative to current working directory. **Arguments**: - *nodes* ([`SCons.Node.FS.Base`]) - list of nodes. - *args* - currently unused. - *kw* - currently unused. **Returns**: - Tuple of strings, which represent paths relative to current working directory (for given environment).","startLine":315,"endLine":339,"calleeNames":["getcwd","get_abspath","isinstance","relpath"]},"acm000002178jsd":{"type":"ClassUnit","id":"acm000002178jsd","name":"RPaths","comment":"Callable object, which returns pathnames relative to SCons current working directory. It seems like `SCons.Node.FS.Base.get_path()` returns absolute paths for nodes that are outside of current working directory (`env.fs.getcwd()`). Here, we often have `SConscript`, `POT` and `PO` files within `po/` directory and source files (e.g. `*.c`) outside of it. When generating `POT` template file, references to source files are written to `POT` template, so a translator may later quickly jump to appropriate source file and line from its `PO` editor (e.g. `poedit`). Relative paths in `PO` file are usually interpreted by `PO` editor as paths relative to the place, where `PO` file lives. The absolute paths would make resultant `POT` file nonportable, as the references would be correct only on the machine, where `POT` file was recently re-created. For such reason, we need a function, which always returns relative paths. This is the purpose of `RPaths` callable object. The `__call__` method returns paths relative to current working directory, but we assume, that *xgettext(1)* is run from the directory, where target file is going to be created. Note, that this may not work for files distributed over several hosts or across different drives on windows. We assume here, that single local filesystem holds both source files and target `POT` templates. Intended use of `RPaths` - in `xgettext.py`:: def generate(env): from GettextCommon import RPaths ... sources = '$( ${_concat( \"\", SOURCES, \"\", __env__, XgettextRPaths, TARGET, SOURCES)} $)' env.Append( ... XGETTEXTCOM = 'XGETTEXT ... ' + sources, ... XgettextRPaths = RPaths(env) )\nNOTE: This callable object returns pathnames of dirs/files relative to\ncurrent working directory. The pathname remains relative also for entries\nthat are outside of current working directory (node, that\nSCons.Node.FS.File and siblings return absolute path in such case). For\nsimplicity we compute path relative to current working directory, this\nseems be enough for our purposes (don't need TARGET variable and\nSCons.Defaults.Variable_Caller stuff).","compilationUnitId":"acm000002191jsd","parentDatatypeId":null,"startLine":256,"endLine":339,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002176jsd","acm000002177jsd"]},"acm000002179jsd":{"type":"ControlElement","id":"acm000002179jsd","name":"_read_linguas_from_files","comment":"Parse `LINGUAS` file and return list of extracted languages\nIf, linguas_files==True or such, then read 'LINGUAS' file.","startLine":131,"endLine":149,"calleeNames":["is_List","is_String","isinstance","arg2nodes","sub","get_text_contents","findall","extend"]},"acm000002180jsd":{"type":"ControlElement","id":"acm000002180jsd","name":"_translate","comment":"Function for `Translate()` pseudo-builder","startLine":248,"endLine":253,"calleeNames":["POTUpdate","POUpdate"]},"acm000002181jsd":{"type":"ControlElement","id":"acm000002181jsd","name":"_init_po_files","comment":"Action function for `POInit` builder.","startLine":342,"endLine":363,"calleeNames":["exists","Action","repr","str","action"]},"acm000002182jsd":{"type":"ControlElement","id":"acm000002182jsd","name":"_detect_xgettext","comment":"Detects *xgettext(1)* binary","startLine":366,"endLine":374,"calleeNames":["Detect","StopError"]},"acm000002183jsd":{"type":"ControlElement","id":"acm000002183jsd","name":"_xgettext_exists","comment":"","startLine":377,"endLine":378,"calleeNames":["_detect_xgettext"]},"acm000002184jsd":{"type":"ControlElement","id":"acm000002184jsd","name":"_detect_msginit","comment":"Detects *msginit(1)* program.","startLine":381,"endLine":389,"calleeNames":["Detect","StopError"]},"acm000002185jsd":{"type":"ControlElement","id":"acm000002185jsd","name":"_msginit_exists","comment":"","startLine":392,"endLine":393,"calleeNames":["_detect_msginit