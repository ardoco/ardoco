nt":"","startLine":78,"endLine":81,"calleeNames":["isinstance"]},"acm000004038jsd":{"type":"ControlElement","id":"acm000004038jsd","name":"__neq__","comment":"","startLine":83,"endLine":84,"calleeNames":["__eq__"]},"acm000004039jsd":{"type":"ControlElement","id":"acm000004039jsd","name":"__hash__","comment":"","startLine":86,"endLine":87,"calleeNames":["hash"]},"acm000004040jsd":{"type":"ClassUnit","id":"acm000004040jsd","name":"Literal","comment":"A wrapper for a string. If you use this object wrapped around a string, then it will be interpreted as literal. When passed to the command interpreter, all special characters will be escaped.","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":58,"endLine":87,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004032jsd","acm000004033jsd","acm000004034jsd","acm000004035jsd","acm000004036jsd","acm000004037jsd","acm000004038jsd","acm000004039jsd"]},"acm000004041jsd":{"type":"ControlElement","id":"acm000004041jsd","name":"__init__","comment":"","startLine":63,"endLine":64,"calleeNames":[]},"acm000004042jsd":{"type":"ControlElement","id":"acm000004042jsd","name":"__str__","comment":"","startLine":66,"endLine":67,"calleeNames":[]},"acm000004043jsd":{"type":"ControlElement","id":"acm000004043jsd","name":"escape","comment":"","startLine":69,"endLine":70,"calleeNames":["escape_func"]},"acm000004044jsd":{"type":"ControlElement","id":"acm000004044jsd","name":"for_signature","comment":"","startLine":72,"endLine":73,"calleeNames":[]},"acm000004045jsd":{"type":"ControlElement","id":"acm000004045jsd","name":"is_literal","comment":"","startLine":75,"endLine":76,"calleeNames":[]},"acm000004046jsd":{"type":"ClassUnit","id":"acm000004046jsd","name":"SpecialAttrWrapper","comment":"This is a wrapper for what we call a 'Node special attribute.' This is any of the attributes of a Node that we can reference from Environment variable substitution, such as $TARGET.abspath or $SOURCES[1].filebase. We implement the same methods as Literal so we can handle special characters, plus a for_signature method, such that we can return some canonical string during signature calculation to avoid unnecessary rebuilds.","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":89,"endLine":118,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004041jsd","acm000004042jsd","acm000004043jsd","acm000004044jsd","acm000004045jsd"]},"acm000004047jsd":{"type":"ControlElement","id":"acm000004047jsd","name":"__init__","comment":"","startLine":63,"endLine":64,"calleeNames":[]},"acm000004048jsd":{"type":"ControlElement","id":"acm000004048jsd","name":"is_literal","comment":"","startLine":75,"endLine":76,"calleeNames":[]},"acm000004049jsd":{"type":"ControlElement","id":"acm000004049jsd","name":"escape","comment":"","startLine":69,"endLine":70,"calleeNames":["escape_func"]},"acm000004050jsd":{"type":"ClassUnit","id":"acm000004050jsd","name":"CmdStringHolder","comment":"This is a special class used to hold strings generated by scons_subst() and scons_subst_list(). It defines a special method escape(). When passed a function with an escape algorithm for a particular platform, it will return the contained string with the proper escape sequences inserted.","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":128,"endLine":157,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004047jsd","acm000004048jsd","acm000004049jsd"]},"acm000004051jsd":{"type":"ControlElement","id":"acm000004051jsd","name":"__init__","comment":"","startLine":63,"endLine":64,"calleeNames":[]},"acm000004052jsd":{"type":"ControlElement","id":"acm000004052jsd","name":"_return_nodelist","comment":"","startLine":187,"endLine":188,"calleeNames":[]},"acm000004053jsd":{"type":"ControlElement","id":"acm000004053jsd","name":"_gen_nodelist","comment":"","startLine":189,"endLine":199,"calleeNames":["is_Sequence","NodeList","list","map"]},"acm000004054jsd":{"type":"ClassUnit","id":"acm000004054jsd","name":"NLWrapper","comment":"A wrapper class that delays turning a list of sources or targets into a NodeList until it's needed. The specified function supplied when the object is initialized is responsible for turning raw nodes into proxies that implement the special attributes like .abspath, .source, etc. This way, we avoid creating those proxies just \"in case\" someone is going to use $TARGET or the like, and only go through the trouble if we really have to. In practice, this might be a wash performance-wise, but it's a little cleaner conceptually...","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":171,"endLine":200,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004051jsd","acm000004052jsd","acm000004053jsd"]},"acm000004055jsd":{"type":"ControlElement","id":"acm000004055jsd","name":"__init__","comment":"","startLine":63,"endLine":64,"calleeNames":[]},"acm000004056jsd":{"type":"ControlElement","id":"acm000004056jsd","name":"__getattr__","comment":"","startLine":215,"endLine":217,"calleeNames":["_create_nodelist","getattr"]},"acm000004057jsd":{"type":"ControlElement","id":"acm000004057jsd","name":"__getitem__","comment":"","startLine":218,"endLine":220,"calleeNames":["_create_nodelist"]},"acm000004058jsd":{"type":"ControlElement","id":"acm000004058jsd","name":"__str__","comment":"","startLine":66,"endLine":67,"calleeNames":[]},"acm000004059jsd":{"type":"ControlElement","id":"acm000004059jsd","name":"__repr__","comment":"","startLine":224,"endLine":226,"calleeNames":["_create_nodelist","repr"]},"acm000004060jsd":{"type":"ClassUnit","id":"acm000004060jsd","name":"Targets_or_Sources","comment":"A class that implements $TARGETS or $SOURCES expansions by in turn wrapping a NLWrapper. This class handles the different methods used to access the list, calling the NLWrapper to create proxies on demand. Note that we subclass collections.UserList purely so that the is_Sequence() function will identify an object of this class as a list during variable expansion. We're not really using any collections.UserList methods in practice.","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":203,"endLine":226,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004055jsd","acm000004056jsd","acm000004057jsd","acm000004058jsd","acm000004059jsd"]},"acm000004061jsd":{"type":"ControlElement","id":"acm000004061jsd","name":"__init__","comment":"","startLine":63,"endLine":64,"calleeNames":[]},"acm000004062jsd":{"type":"ControlElement","id":"acm000004062jsd","name":"__getattr__","comment":"","startLine":215,"endLine":217,"calleeNames":["_create_nodelist","getattr"]},"acm000004063jsd":{"type":"ControlElement","id":"acm000004063jsd","name":"__str__","comment":"","startLine":66,"endLine":67,"calleeNames":[]},"acm000004064jsd":{"type":"ControlElement","id":"acm000004064jsd","name":"__repr__","comment":"","startLine":224,"endLine":226,"calleeNames":["_create_nodelist","repr"]},"acm000004065jsd":{"type":"ClassUnit","id":"acm000004065jsd","name":"Target_or_Source","comment":"A class that implements $TARGET or $SOURCE expansions by in turn wrapping a NLWrapper. This class handles the different methods used to access an individual proxy Node, calling the NLWrapper to create a proxy on demand.","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":228,"endLine":254,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004061jsd","acm000004062jsd","acm000004063jsd","acm000004064jsd"]},"acm000004066jsd":{"type":"ControlElement","id":"acm000004066jsd","name":"__call__","comment":"","startLine":257,"endLine":258,"calleeNames":[]},"acm000004067jsd":{"type":"ControlElement","id":"acm000004067jsd","name":"__str__","comment":"","startLine":66,"endLine":67,"calleeNames":[]},"acm000004068jsd":{"type":"ClassUnit","id":"acm000004068jsd","name":"NullNodeList","comment":"","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":256,"endLine":258,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004066jsd","acm000004067jsd"]},"acm000004069jsd":{"type":"ControlElement","id":"acm000004069jsd","name":"__init__","comment":"","startLine":63,"endLine":64,"calleeNames":[]},"acm000004070jsd":{"type":"ControlElement","id":"acm000004070jsd","name":"expand","comment":"Expand a single \"token\" as necessary, returning an appropriate string containing the expansion. This handles expanding different types of things (strings, lists, callables) appropriately. It calls the wrapper substitute() method to re-expand things as necessary, so that the results of expansions of side-by-side strings still get re-evaluated separately, not smushed together.\nIn this case keep the double $'s which we'll later\nswap for a single dollar sign as we need to retain\nthis information to properly avoid matching \"$(\"\" when\nthe actual text was \"$$(\"\" (or \"$)\"\" when \"$$)\"\" )\nStore for error messages if we fail to expand the\nvalue\nBefore re-expanding the result, handle\nrecursive expansion by copying the local\nvariable dictionary and overwriting a null\nstring for the value of the variable name\nwe just expanded.\n\nThis could potentially be optimized by only\ncopying lvars when s contains more expansions,\nbut lvars is usually supposed to be pretty\nsmall, and deeply nested variable expansions\nare probably more the exception than the norm,\nso it should be tolerable for now.\nSCons has the unusual Null class where any __getattr__ call returns it's self,\nwhich does not work the signature module, and the Null class returns an empty\nstring if called on, so we make an exception in this condition for Null class\nAlso allow callables where the only non default valued args match the expected defaults\nthis should also allow functools.partial's to work.\nThis probably indicates that it's a callable\nobject that doesn't match our calling arguments\n(like an Action).","startLine":345,"endLine":444,"calleeNames":["is_String","eval","raise_exception","NameError","copy","split","substitute","is_Sequence","conv","list","map","callable","isinstance","signature","items","s"]},"acm000004071jsd":{"type":"ControlElement","id":"acm000004071jsd","name":"substitute","comment":"Substitute expansions in an argument or list of arguments. This serves as a wrapper for splitting up a string into separate tokens.","startLine":446,"endLine":475,"calleeNames":["conv","expand","group","is_String","isinstance","str","sub","findall","append","len","join","map"]},"acm000004072jsd":{"type":"ClassUnit","id":"acm000004072jsd","name":"StringSubber","comment":"A class to construct the results of a scons_subst() call. This binds a specific construction environment, mode, target and source with two methods (substitute() and expand()) that handle the expansion.","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":330,"endLine":475,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004069jsd","acm000004070jsd","acm000004071jsd"]},"acm000004073jsd":{"type":"ControlElement","id":"acm000004073jsd","name":"__init__","comment":"","startLine":63,"endLine":64,"calleeNames":[]},"acm000004074jsd":{"type":"ControlElement","id":"acm000004074jsd","name":"expanded","comment":"Determines if the string s requires further expansion. Due to the implementation of ListSubber expand will call itself 2 additional times for an already expanded string. This method is used to determine if a string is already fully expanded and if so exit the loop early to prevent these recursive calls.","startLine":508,"endLine":521,"calleeNames":["is_String","isinstance","str","findall"]},"acm000004075jsd":{"type":"ControlElement","id":"acm000004075jsd","name":"expand","comment":"Expand a single \"token\" as necessary, returning an appropriate string containing the expansion. This handles expanding different types of things (strings, lists, callables) appropriately. It calls the wrapper substitute() method to re-expand things as necessary, so that the results of expansions of side-by-side strings still get re-evaluated separately, not smushed together.\nIn this case keep the double $'s which we'll later\nswap for a single dollar sign as we need to retain\nthis information to properly avoid matching \"$(\"\" when\nthe actual text was \"$$(\"\" (or \"$)\"\" when \"$$)\"\" )\nStore for error messages if we fail to expand the\nvalue\nBefore re-expanding the result, handle\nrecursive expansion by copying the local\nvariable dictionary and overwriting a null\nstring for the value of the variable name\nwe just expanded.\n\nThis could potentially be optimized by only\ncopying lvars when s contains more expansions,\nbut lvars is usually supposed to be pretty\nsmall, and deeply nested variable expansions\nare probably more the exception than the norm,\nso it should be tolerable for now.\nSCons has the unusual Null class where any __getattr__ call returns it's self,\nwhich does not work the signature module, and the Null class returns an empty\nstring if called on, so we make an exception in this condition for Null class\nAlso allow callables where the only non default valued args match the expected defaults\nthis should also allow functools.partial's to work.\nThis probably indicates that it's a callable\nobject that doesn't match our calling arguments\n(like an Action).","startLine":345,"endLine":444,"calleeNames":["is_String","eval","raise_exception","NameError","copy","split","substitute","is_Sequence","conv","list","map","callable","isinstance","signature","items","s"]},"acm000004076jsd":{"type":"ControlElement","id":"acm000004076jsd","name":"substitute","comment":"Substitute expansions in an argument or list of arguments. This serves as a wrapper for splitting up a string into separate tokens.","startLine":446,"endLine":475,"calleeNames":["conv","expand","group","is_String","isinstance","str","sub","findall","append","len","join","map"]},"acm000004077jsd":{"type":"ControlElement","id":"acm000004077jsd","name":"next_line","comment":"Arrange for the next word to start a new line. This is like starting a new word, except that we have to append another line to the result.","startLine":648,"endLine":653,"calleeNames":["append","next_word"]},"acm000004078jsd":{"type":"ControlElement","id":"acm000004078jsd","name":"this_word","comment":"Arrange for the next word to append to the end of the current last word in the result.","startLine":655,"endLine":658,"calleeNames":[]},"acm000004079jsd":{"type":"ControlElement","id":"acm000004079jsd","name":"next_word","comment":"Arrange for the next word to start a new word.","startLine":660,"endLine":662,"calleeNames":[]},"acm000004080jsd":{"type":"ControlElement","id":"acm000004080jsd","name":"add_to_current_word","comment":"Append the string x to the end of the current last word in the result. If that is not possible, then just add it as a new word. Make sure the entire concatenated string inherits the object attributes of x (in particular, the escape function) by wrapping it as CmdStringHolder.\nAll right, this is a hack and it should probably\nbe refactored out of existence in the future.\nThe issue is that we want to smoosh words together\nand make one file name that gets escaped if\nwe're expanding something like foo$EXTENSION,\nbut we don't want to smoosh them together if\nit's something like >$TARGET, because then we'll\ntreat the '>' like it's part of the file name.\nSo for now, just hard-code looking for the special\ncommand-line redirection characters...\nWe used to treat a word appended to a literal\nas a literal itself, but this caused problems\nwith interpreting quotes around space-separated\ntargets on command lines. Removing this makes\nnone of the \"substantive\" end-to-end tests fail,\nso we'll take this out but leave it commented\nfor now in case there's a problem not covered\nby the test cases and we need to resurrect this.\nliteral1 = self.literal(self[-1][-1])\nliteral2 = self.literal(x)\ny = CmdStringHolder(y, literal1 or literal2)","startLine":664,"endLine":710,"calleeNames":["add_new_word","str","conv","is_String","CmdStringHolder"]},"acm000004081jsd":{"type":"ControlElement","id":"acm000004081jsd","name":"add_new_word","comment":"","startLine":712,"endLine":719,"calleeNames":["literal","conv","is_String","CmdStringHolder","append"]},"acm000004082jsd":{"type":"ControlElement","id":"acm000004082jsd","name":"literal","comment":"","startLine":721,"endLine":727,"calleeNames":["l"]},"acm000004083jsd":{"type":"ControlElement","id":"acm000004083jsd","name":"open_strip","comment":"Handle the \"open strip\" $( token.","startLine":729,"endLine":732,"calleeNames":["add_strip"]},"acm000004084jsd":{"type":"ControlElement","id":"acm000004084jsd","name":"close_strip","comment":"Handle the \"close strip\" $) token.","startLine":734,"endLine":737,"calleeNames":["add_strip"]},"acm000004085jsd":{"type":"ClassUnit","id":"acm000004085jsd","name":"ListSubber","comment":"A class to construct the results of a scons_subst_list() call. Like StringSubber, this class binds a specific construction environment, mode, target and source with two methods (substitute() and expand()) that handle the expansion. In addition, however, this class is used to track the state of the result(s) we're gathering so we can do the appropriate thing whenever we have to append another word to the result--start a new line, start a new word, append to the current word, etc. We do this by setting the \"append\" attribute to the right method so that our wrapper methods only need ever call ListSubber.append(), and the rest of the object takes care of doing the right thing internally.","compilationUnitId":"acm000004096jsd","parentDatatypeId":null,"startLine":478,"endLine":737,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004073jsd","acm000004074jsd","acm000004075jsd","acm000004076jsd","acm000004077jsd","acm000004078jsd","acm000004079jsd","acm000004080jsd","acm000004081jsd","acm000004082jsd","acm000004083jsd","acm000004084jsd"]},"acm000004086jsd":{"type":"ControlElement","id":"acm000004086jsd","name":"SetAllowableExceptions","comment":"","startLine":44,"endLine":46,"calleeNames":[]},"acm000004087jsd":{"type":"ControlElement","id":"acm000004087jsd","name":"raise_exception","comment":"","startLine":49,"endLine":55,"calleeNames":["BuildError","UserError"]},"acm000004088jsd":{"type":"ControlElement","id":"acm000004088jsd","name":"quote_spaces","comment":"Generic function for putting double quotes around any string that has white space in it.","startLine":120,"endLine":126,"calleeNames":["str"]},"acm000004089jsd":{"type":"ControlElement","id":"acm000004089jsd","name":"escape_list","comment":"Escape a list of arguments by running the specified escape_func on every object in the list that has an escape() method.","startLine":159,"endLine":169,"calleeNames":["e","list","map"]},"acm000004090jsd":{"type":"ControlElement","id":"acm000004090jsd","name":"subst_dict","comment":"Create a dictionary for substitution of special construction variables. This translates the following special arguments: target - the target (object or array of objects), used to generate the TARGET and TARGETS construction variables source - the source (object or array of objects), used to generate the SOURCES and SOURCE construction variables","startLine":262,"endLine":325,"calleeNames":["get_subst_proxy","NLWrapper","Targets_or_Sources","Target_or_Source","rfile"]},"acm000004091jsd":{"type":"ControlElement","id":"acm000004091jsd","name":"_rm_list","comment":"","startLine":758,"endLine":759,"calleeNames":[]},"acm000004092jsd":{"type":"ControlElement","id":"acm000004092jsd","name":"_remove_list","comment":"","startLine":761,"endLine":775,"calleeNames":["append"]},"acm000004093jsd":{"type":"ControlElement","id":"acm000004093jsd","name":"scons_subst","comment":"Expand a string or list containing construction variable substitutions. This is the work-horse function for substitutions in file names and the like. The companion scons_subst_list() function (below) handles separating command lines into lists of arguments, so see that function if that's what you're looking for.\nDoing this every time is a bit of a waste, since the Executor\nhas typically already populated the OverrideEnvironment with\n$TARGET/$SOURCE variables. We're keeping this (for now), though,\nbecause it supports existing behavior that allows us to call\nan Action directly with an arbitrary target+source pair, which\nwe use in Tool/tex.py to handle calling $BIBTEX when necessary.\nIf we dropped that behavior (or found another way to cover it),\nwe could get rid of this call completely and just rely on the\nExecutor setting the variables.\nAllow last ditch chance to override lvars\nWe're (most likely) going to eval() things. If Python doesn't\nfind a __builtins__ value in the global dictionary used for eval(),\nit copies the current global values for you. Avoid this by\nsetting it explicitly and then deleting, so we don't pollute the\nconstruction environment Dictionary(ies) that are typically used\nfor expansion.","startLine":810,"endLine":890,"calleeNames":["isinstance","subst_dict","copy","update","StringSubber","substitute","is_String","split","UserError","join","sub","strip","replace","is_Sequence","remove","str"]},"acm000004094jsd":{"type":"ControlElement","id":"acm000004094jsd","name":"scons_subst_list","comment":"Substitute construction variables in a string (or list or other object) and separate the arguments into a command list. The companion scons_subst() function (above) handles basic substitutions within strings, so see that function instead if that's what you're looking for.\nDoing this every time is a bit of a waste, since the Executor\nhas typically already populated the OverrideEnvironment with\n$TARGET/$SOURCE variables. We're keeping this (for now), though,\nbecause it supports existing behavior that allows us to call\nan Action directly with an arbitrary target+source pair, which\nwe use in Tool/tex.py to handle calling $BIBTEX when necessary.\nIf we dropped that behavior (or found another way to cover it),\nwe could get rid of this call completely and just rely on the\nExecutor setting the variables.\nAllow caller to specify last ditch override of lvars\nWe're (most likely) going to eval() things. If Python doesn't\nfind a __builtins__ value in the global dictionary used for eval(),\nit copies the current global values for you. Avoid this by\nsetting it explicitly and then deleting, so we don't pollute the\nconstruction environment Dictionary(ies) that are typically used\nfor expansion.","startLine":892,"endLine":938,"calleeNames":["subst_dict","copy","update","ListSubber","substitute"]},"acm000004095jsd":{"type":"ControlElement","id":"acm000004095jsd","name":"scons_subst_once","comment":"Perform single (non-recursive) substitution of a single construction variable keyword. This is used when setting a variable when copying or overriding values in an Environment. We want to capture (expand) the old value before we override it, so people can do things like: env2 = env.Clone(CCFLAGS = '$CCFLAGS -g') We do this with some straightforward, brute-force code here...","startLine":940,"endLine":984,"calleeNames":["isinstance","find","get","group","is_Sequence","join","map","str","is_String","extend","append","sub"]},"acm000004096jsd":{"type":"CodeCompilationUnit","id":"acm000004096jsd","name":"Subst","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons string substitution.\nIndexed by the SUBST_* constants below.","parentId":"acm000004231jsd","content":["acm000004040jsd","acm000004046jsd","acm000004050jsd","acm000004054jsd","acm000004060jsd","acm000004065jsd","acm000004068jsd","acm000004072jsd","acm000004085jsd","acm000004086jsd","acm000004087jsd","acm000004088jsd","acm000004089jsd","acm000004090jsd","acm000004091jsd","acm000004092jsd","acm000004093jsd","acm000004094jsd","acm000004095jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["collections","re","inspect.signature","inspect.Parameter","typing.Optional","SCons.Errors","SCons.Util.is_String","SCons.Util.is_Sequence"]},"acm000004097jsd":{"type":"ControlElement","id":"acm000004097jsd","name":"__init__","comment":"","startLine":39,"endLine":40,"calleeNames":["normpath"]},"acm000004098jsd":{"type":"ControlElement","id":"acm000004098jsd","name":"__str__","comment":"","startLine":41,"endLine":42,"calleeNames":[]},"acm000004099jsd":{"type":"ControlElement","id":"acm000004099jsd","name":"is_literal","comment":"","startLine":43,"endLine":44,"calleeNames":[]},"acm0