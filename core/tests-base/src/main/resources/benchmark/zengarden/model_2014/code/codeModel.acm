his file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.  You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.","startLine":25,"endLine":27,"calleeNames":[]},"acm000002522jsd":{"type":"ControlElement","id":"acm000002522jsd","name":"::MessageMaximum(PdMessage*initMessage,PdGraph*graph)","comment":"","startLine":29,"endLine":32,"calleeNames":[]},"acm000002523jsd":{"type":"ControlElement","id":"acm000002523jsd","name":"::~MessageMaximum()","comment":"nothing to do","startLine":34,"endLine":36,"calleeNames":[]},"acm000002524jsd":{"type":"ControlElement","id":"acm000002524jsd","name":"MessageMaximum::processMessage(intinletIndex,PdMessage*message)","comment":"","startLine":38,"endLine":68,"calleeNames":[]},"acm000002525jsd":{"type":"CodeAssembly","id":"acm000002525jsd","name":"MessageMaximum","comment":null,"parentId":null,"content":["acm000002521jsd","acm000002522jsd","acm000002523jsd","acm000002524jsd"],"language":"CPP","importedModuleNames":[]},"acm000002526jsd":{"type":"ControlElement","id":"acm000002526jsd","name":"*MessageMessageBox::newObject(PdMessage*initString,PdGraph*graph)","comment":"Copyright 2009,2010,2011 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.","startLine":26,"endLine":28,"calleeNames":[]},"acm000002527jsd":{"type":"ControlElement","id":"acm000002527jsd","name":"::MessageMessageBox(char*initString,PdGraph*graph)","comment":"The message box is overloaded with many kinds of functionality. A) The simplest case is one where only one message is specified, including a list of primitives which should be included in one message. The list may also include variable indicies (in the form of, e.g. $1, $2, etc.) which refer to those locations in the incoming message which triggers the message box. B) A slightly more complicated case is where several messages in the form of A) are separated by a comma (','). Each of the messages is processed and sent independently from the message box when it is triggered. C) The most complex case is where messages in the form of A) are separated by a semicolon (';'). The first symbol is the name of a message receiver. The remainder of the string is converted into a message.\nparse the entire initialisation string","startLine":43,"endLine":82,"calleeNames":[]},"acm000002528jsd":{"type":"ControlElement","id":"acm000002528jsd","name":"::~MessageMessageBox()","comment":"NOTE(mhroth): though this is alloca is in a for loop, it is not expected that the compiler\nwill do anything funny, like unrolling the loop, thereby causing unexpected stack overflows\nStaticUtils::tokenizeString does not remove the trailing \";\" from the\noriginal string. We should not process it because it will result in an empty message.\nparse the remainder of the init list for all remote messages\ntrim any leading spaces. This will otherwise message up the parsing\ndelete the message list and all of the messages in it","startLine":84,"endLine":96,"calleeNames":[]},"acm000002529jsd":{"type":"ControlElement","id":"acm000002529jsd","name":"MessageMessageBox::processMessage(intinletIndex,PdMessage*message)","comment":"delete the remote message list","startLine":98,"endLine":142,"calleeNames":[]},"acm000002530jsd":{"type":"CodeAssembly","id":"acm000002530jsd","name":"MessageMessageBox","comment":null,"parentId":null,"content":["acm000002526jsd","acm000002527jsd","acm000002528jsd","acm000002529jsd"],"language":"CPP","importedModuleNames":[]},"acm000002531jsd":{"type":"ControlElement","id":"acm000002531jsd","name":"*MessageMetro::newObject(PdMessage*initMessage,PdGraph*graph)","comment":"Copyright 2009,2010,2011 Reality Jockey, Ltd.                 info@rjdj.me                 http://rjdj.me/  This file is part of ZenGarden.  ZenGarden is free software: you can redistribute it and/or modify  it under the terms of the GNU Lesser General Public License as published by  the Free Software Foundation, either version 3 of the License, or  (at your option) any later version.  ZenGarden is distributed in the hope that it will be useful,  but WITHOUT ANY WARRANTY; without even the implied warranty of  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the  GNU Lesser General Public License for more details.    You should have received a copy of the GNU Lesser General Public License  along with ZenGarden.  If not, see <http://www.gnu.org/licenses/>.","startLine":26,"endLine":28,"calleeNames":[]},"acm000002532jsd":{"type":"ControlElement","id":"acm000002532jsd","name":"::MessageMetro(PdMessage*initMessage,PdGraph*graph)","comment":"default to interval of one second","startLine":30,"endLine":34,"calleeNames":[]},"acm000002533jsd":{"type":"ControlElement","id":"acm000002533jsd","name":"::~MessageMetro()","comment":"nothign to do. pendingMessage object is owned by 