 LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000005623jsd","content":["acm000005337jsd","acm000005341jsd","acm000005343jsd","acm000005345jsd","acm000005347jsd","acm000005349jsd","acm000005351jsd","acm000005353jsd","acm000005355jsd","acm000005357jsd","acm000005359jsd","acm000005361jsd","acm000005363jsd","acm000005365jsd","acm000005366jsd"],"pathElements":["Scanner"],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","collections","os","TestCmd","SCons.Scanner.Java","SCons.Node.FS","SCons.Warnings"]},"acm000005368jsd":{"type":"ClassUnit","id":"acm000005368jsd","name":"_Null","comment":"","compilationUnitId":"acm000005383jsd","parentDatatypeId":null,"startLine":41,"endLine":42,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000005369jsd":{"type":"ControlElement","id":"acm000005369jsd","name":"__init__","comment":"","startLine":81,"endLine":82,"calleeNames":[]},"acm000005370jsd":{"type":"ControlElement","id":"acm000005370jsd","name":"__call__","comment":"","startLine":84,"endLine":93,"calleeNames":["PathList","subst_path","tuple","Rfindalldirs"]},"acm000005371jsd":{"type":"ClassUnit","id":"acm000005371jsd","name":"FindENVPathDirs","comment":"A class to bind a specific E{*}PATH variable name to a function that will return all of the E{*}path directories.","compilationUnitId":"acm000005383jsd","parentDatatypeId":null,"startLine":76,"endLine":93,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005369jsd","acm000005370jsd"]},"acm000005372jsd":{"type":"ControlElement","id":"acm000005372jsd","name":"__init__","comment":"","startLine":81,"endLine":82,"calleeNames":[]},"acm000005373jsd":{"type":"ControlElement","id":"acm000005373jsd","name":"_latex_names","comment":"return [filename+e for e in self.graphics_extensions + TexGraphics]\nuse the line above to find dependencies for the PDF builder\nwhen only an .eps figure is present. Since it will be found\nif the user tells scons how to make the pdf figure, leave\nit out for now.","startLine":262,"endLine":290,"calleeNames":["splitext"]},"acm000005374jsd":{"type":"ControlElement","id":"acm000005374jsd","name":"sort_key","comment":"","startLine":293,"endLine":294,"calleeNames":["_my_normcase","str"]},"acm000005375jsd":{"type":"ControlElement","id":"acm000005375jsd","name":"find_include","comment":"","startLine":296,"endLine":316,"calleeNames":["_latex_names","list","tuple","Dir","find_file"]},"acm000005376jsd":{"type":"ControlElement","id":"acm000005376jsd","name":"canonical_text","comment":"Standardize an input TeX-file contents. Currently: * removes comments, unwrapping comment-wrapped lines.","startLine":318,"endLine":333,"calleeNames":["splitlines","findall","lstrip","append","len","join","rstrip"]},"acm000005377jsd":{"type":"ControlElement","id":"acm000005377jsd","name":"scan","comment":"Modify the default scan function to allow for the regular\nexpression to return a comma separated list of file names\nas can be the case with the bibliography keyword.\nCache the includes list in node so we only scan it once:\npath_dict = dict(list(path))\nadd option for whitespace (\\s) before the '['","startLine":335,"endLine":373,"calleeNames":["compile","canonical_text","get_text_contents","findall","sub","join","split","append"]},"acm000005378jsd":{"type":"ControlElement","id":"acm000005378jsd","name":"scan_recurse","comment":"do a recursive scan of the top level target file This lets us search for included files based on the directory of the main file just as latex does","startLine":375,"endLine":426,"calleeNames":["dict","list","extend","scan","get_dir","pop","find_include","warn","sort_key","append","sorted"]},"acm000005379jsd":{"type":"ClassUnit","id":"acm000005379jsd","name":"LaTeX","comment":"Class for scanning LaTeX files for included files. Unlike most scanners, which use regular expressions that just return the included file name, this returns a tuple consisting of the keyword for the inclusion (\"include\", \"includegraphics\", \"input\", or \"bibliography\"), and then the file name itself. Based on a quick look at LaTeX documentation, it seems that we should append .tex suffix for the \"include\" keywords, append .tex if there is no extension for the \"input\" keyword, and need to add .bib for the \"bibliography\" keyword that does not accept extensions by itself. Finally, if there is no extension for an \"includegraphics\" keyword latex will append .ps or .eps to find the file, while pdftex may use .pdf, .jpg, .tif, .mps, or .png. The actual subset and search order may be altered by DeclareGraphicsExtensions command. This complication is ignored. The default order corresponds to experimentation with teTeX:: $ latex --version pdfeTeX 3.141592-1.21a-2.2 (Web2C 7.5.4) kpathsea version 3.5.4 The order is: ['.eps', '.ps'] for latex ['.png', '.pdf', '.jpg', '.tif']. Another difference is that the search path is determined by the type of the file being searched: env['TEXINPUTS'] for \"input\" and \"include\" keywords env['TEXINPUTS'] for \"includegraphics\" keyword env['TEXINPUTS'] for \"lstinputlisting\" keyword env['BIBINPUTS'] for \"bibliography\" keyword env['BSTINPUTS'] for \"bibliographystyle\" keyword env['INDEXSTYLE'] for \"makeindex\" keyword, no scanning support needed just allows user to set it if needed. FIXME: also look for the class or style in document[class|style]{} FIXME: also look for the argument of bibliographystyle{}","compilationUnitId":"acm000005383jsd","parentDatatypeId":null,"startLine":122,"endLine":426,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005372jsd","acm000005373jsd","acm000005374jsd","acm000005375jsd","acm000005376jsd","acm000005377jsd","acm000005378jsd"]},"acm000005380jsd":{"type":"ControlElement","id":"acm000005380jsd","name":"modify_env_var","comment":"Split at os.pathsep to convert into absolute path\nConvert into a string explicitly to append \":\" (without which it won't search system\npaths as well). The problem is that env.AppendENVPath(var, \":\")\ndoes not work, refuses to append \":\" (os.pathsep).\nAppend the trailing os.pathsep character here to catch the case with no env[var]","startLine":50,"endLine":74,"calleeNames":["PrependENVPath","is_List","abspath","str","split","join"]},"acm000005381jsd":{"type":"ControlElement","id":"acm000005381jsd","name":"LaTeXScanner","comment":"Return a prototype Scanner instance for scanning LaTeX source files when built with latex.","startLine":96,"endLine":106,"calleeNames":["LaTeX"]},"acm000005382jsd":{"type":"ControlElement","id":"acm000005382jsd","name":"PDFLaTeXScanner","comment":"Return a prototype Scanner instance for scanning LaTeX source files when built with pdflatex.","startLine":109,"endLine":119,"calleeNames":["LaTeX"]},"acm000005383jsd":{"type":"CodeCompilationUnit","id":"acm000005383jsd","name":"LaTeX","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nDependency scanner for LaTeX code.\nlist of graphics file extensions for TeX and LaTeX","parentId":"acm000005623jsd","content":["acm000005368jsd","acm000005371jsd","acm000005379jsd","acm000005380jsd","acm000005381jsd","acm000005382jsd"],"pathElements":["Scanner"],"extension":"py","language":"PYTHON3","importedModuleNames":["os.path","re","SCons.Node.FS","SCons.Util","SCons.Warnings","ScannerBase","FindPathDirs","SCons.PathList"]},"acm000005384jsd":{"type":"ControlElement","id":"acm000005384jsd","name":"__init__","comment":"","startLine":84,"endLine":87,"calleeNames":["super","__init__","update","FS","workpath"]},"acm000005385jsd":{"type":"ControlElement","id":"acm000005385jsd","name":"Dictionary","comment":"","startLine":89,"endLine":90,"calleeNames":[]},"acm000005386jsd":{"type":"ControlElement","id":"acm000005386jsd","name":"subst","comment":"","startLine":92,"endLine":95,"calleeNames":[]},"acm000005387jsd":{"type":"ControlElement","id":"acm000005387jsd","name":"subst_list","comment":"","startLine":97,"endLine":100,"calleeNames":[]},"acm000005388jsd":{"type":"ControlElement","id":"acm000005388jsd","name":"subst_path","comment":"","startLine":102,"endLine":105,"calleeNames":["isinstance","list","map"]},"acm000005389jsd":{"type":"ControlElement","id":"acm000005389jsd","name":"get_calculator","comment":"","startLine":107,"endLine":108,"calleeNames":[]},"acm000005390jsd":{"type":"ControlElement","id":"acm000005390jsd","name":"get_factory","comment":"","startLine":110,"endLine":111,"calleeNames":[]},"acm000005391jsd":{"type":"ControlElement","id":"acm000005391jsd","name":"Dir","comment":"","startLine":113,"endLine":114,"calleeNames":["Dir"]},"acm000005392jsd":{"type":"ControlElement","id":"acm000005392jsd","name":"File","comment":"","startLine":116,"endLine":117,"calleeNames":["File"]},"ac