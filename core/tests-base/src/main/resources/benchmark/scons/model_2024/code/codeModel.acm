e, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000004231jsd","content":["acm000003751jsd","acm000003757jsd","acm000003759jsd","acm000003770jsd","acm000003774jsd","acm000003795jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.Executor"]},"acm000003797jsd":{"type":"ControlElement","id":"acm000003797jsd","name":"_run_exitfuncs","comment":"run any registered exit functions _exithandlers is traversed in reverse order so functions are executed last in, first out.","startLine":31,"endLine":40,"calleeNames":["pop","func"]},"acm000003798jsd":{"type":"ControlElement","id":"acm000003798jsd","name":"register","comment":"register a function to be executed upon normal program termination func - function to be called at exit targs - optional arguments to pass to func kargs - optional keyword arguments to pass to func\nmake our exit function get run by python when it exits\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":42,"endLine":49,"calleeNames":["append"]},"acm000003799jsd":{"type":"CodeCompilationUnit","id":"acm000003799jsd","name":"exitfuncs","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nRegister functions which are executed when SCons exits for any reason.\nThis is obsolete now","parentId":"acm000004231jsd","content":["acm000003797jsd","acm000003798jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["atexit"]},"acm000003800jsd":{"type":"ControlElement","id":"acm000003800jsd","name":"__init__","comment":"","startLine":114,"endLine":120,"calleeNames":[]},"acm000003801jsd":{"type":"ControlElement","id":"acm000003801jsd","name":"key","comment":"","startLine":121,"endLine":122,"calleeNames":[]},"acm000003802jsd":{"type":"ControlElement","id":"acm000003802jsd","name":"display","comment":"","startLine":123,"endLine":124,"calleeNames":["print"]},"acm000003803jsd":{"type":"ControlElement","id":"acm000003803jsd","name":"__eq__","comment":"","startLine":125,"endLine":129,"calleeNames":["key"]},"acm000003804jsd":{"type":"ClassUnit","id":"acm000003804jsd","name":"Counter","comment":"Base class for counting memoization hits and misses. We expect that the initialization in a matching decorator will fill in the correct class name and method name that represents the name of the function being counted.","compilationUnitId":"acm000003814jsd","parentDatatypeId":null,"startLine":106,"endLine":129,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003800jsd","acm000003801jsd","acm000003802jsd","acm000003803jsd"]},"acm000003805jsd":{"type":"ControlElement","id":"acm000003805jsd","name":"count","comment":"Counts whether the memoized value has already been set (a hit) or not (a miss).","startLine":139,"endLine":147,"calleeNames":[]},"acm000003806jsd":{"type":"ClassUnit","id":"acm000003806jsd","name":"CountValue","comment":"A counter class for simple, atomic memoized values. A CountValue object should be instantiated in a decorator for each of the class's methods that memoizes its return value by simply storing the return value in its _memo dictionary.","compilationUnitId":"acm000003814jsd","parentDatatypeId":null,"startLine":131,"endLine":147,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003805jsd"]},"acm000003807jsd":{"type":"ControlElement","id":"acm000003807jsd","name":"__init__","comment":"","startLine":114,"endLine":120,"calleeNames":[]},"acm000003808jsd":{"type":"ControlElement","id":"acm000003808jsd","name":"count","comment":"Counts whether the memoized value has already been set (a hit) or not (a miss).","startLine":139,"endLine":147,"calleeNames":[]},"acm000003809jsd":{"type":"ClassUnit","id":"acm000003809jsd","name":"CountDict","comment":"A counter class for memoized values stored in a dictionary, with keys based on the method's input arguments. A CountDict object is instantiated in a decorator for each of the class's methods that memoizes its return value in a dictionary, indexed by some key that can be computed from one or more of its input arguments.","compilationUnitId":"acm000003814jsd","parentDatatypeId":null,"startLine":149,"endLine":178,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003807jsd","acm000003808jsd"]},"acm000003810jsd":{"type":"ControlElement","id":"acm000003810jsd","name":"Dump","comment":"Dump the hit/miss count for all the counters collected so far.","startLine":180,"endLine":187,"calleeNames":["print","sorted","display"]},"acm000003811jsd":{"type":"ControlElement","id":"acm000003811jsd","name":"EnableMemoization","comment":"","startLine":189,"endLine":191,"calleeNames":[]},"acm000003812jsd":{"type":"ControlElement","id":"acm000003812jsd","name":"CountMethodCall","comment":"Decorator for counting memoizer hits/misses while retrieving a simple value in a class method. It wraps the given method fn and uses a CountValue object to keep track of the caching statistics. Wrapping gets enabled by calling EnableMemoization().","startLine":193,"endLine":211,"calleeNames":["CountValue","count","fn"]},"acm000003813jsd":{"type":"ControlElement","id":"acm000003813jsd","name":"CountDictCall","comment":"Decorator for counting memoizer hits/misses while accessing dictionary values with a key-generating function. Like CountMethodCall above, it wraps the given method fn and uses a CountDict object to keep track of the caching statistics. The dict-key function keyfunc has to get passed in the decorator call and gets stored in the CountDict instance. Wrapping gets enabled by calling EnableMemoization().","startLine":213,"endLine":236,"calleeNames":["CountDict","count","fn"]},"acm000003814jsd":{"type":"CodeCompilationUnit","id":"acm000003814jsd","name":"Memoize","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nDecorator-based memoizer to count caching stats. A decorator-based implementation to count hits and misses of the computed values that various methods cache in memory. Use of this modules assumes that wrapped methods be coded to cache their values in a consistent way. In particular, it requires that the class uses a dictionary named \"_memo\" to store the cached values. Here is an example of wrapping a method that returns a computed value, with no input parameters:: @SCons.Memoize.CountMethodCall def foo(self): try: # Memoization return self._memo['foo'] # Memoization except KeyError: # Memoization pass # Memoization result = self.compute_foo_value() self._memo['foo'] = result # Memoization return result Here is an example of wrapping a method that will return different values based on one or more input arguments:: def _bar_key(self, argument): # Memoization return argument # Memoization @SCons.Memoize.CountDictCall(_bar_key) def bar(self, argument): memo_key = argument # Memoization try: # Memoization memo_dict = self._memo['bar'] # Memoization except KeyError: # Memoization memo_dict = {} # Memoization self._memo['dict'] = memo_dict # Memoization else: # Memoization try: # Memoization return memo_dict[memo_key] # Memoization except KeyError: # Memoization pass # Memoization result = self.compute_bar_value(argument) memo_dict[memo_key] = result # Memoization return result Deciding what to cache is tricky, because different configurations can have radically different performance tradeoffs, and because the tradeoffs involved are often so non-obvious. Consequently, deciding whether or not to cache a given method will likely be more of an art than a science, but should still be based on available data from this module. Here are some VERY GENERAL guidelines about deciding whether or not to cache return values from a method that's being called a lot: -- The first question to ask is, \"Can we change the calling code so this method isn't called so often?\" Sometimes this can be done by changing the algorithm. Sometimes the *caller* should be memoized, not the method you're looking at. -- The memoized function should be timed with multiple configurations to make sure it doesn't inadvertently slow down some other configuration. -- When memoizing values based on a dictionary key composed of input arguments, you don't need to use all of the arguments if some of them don't affect the return values.\nA flag controlling whether or not we actually use memoization.","parentId":"acm000004231jsd","content":["acm000003804jsd","acm000003806jsd","acm000003809jsd","acm000003810jsd","acm000003811jsd","acm000003812jsd","acm000003813jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":[]},"acm000003815jsd":{"type":"ControlElement","id":"acm000003815jsd","name":"__init__","comment":"","startLine":32,"endLine":33,"calleeNames":[]},"acm000003816jsd":{"type":"ControlElement","id":"acm000003816jsd","name":"_dict_key","comment":"","startLine":35,"endLine":36,"calleeNames":[]},"acm000003817jsd":{"type":"ControlElement","id":"acm000003817jsd","name":"dict","comment":"","startLine":39,"endLine":57,"calleeNames":["compute_dict"]},"acm000003818jsd":{"type":"ControlElement","id":"acm000003818jsd","name":"value","comment":"","startLine":60,"endLine":71,"calleeNames":["compute_value"]},"acm000003819jsd":{"type":"ControlElement","id":"acm000003819jsd","name":"get_memoizer_counter","comment":"","startLine":73,"endLine":74,"calleeNames":["get"]},"acm000003820jsd":{"type":"ClassUnit","id":"acm000003820jsd","name":"FakeObject","comment":"","compilationUnitId":"acm000003828jsd","parentDatatypeId":null,"startLine":31,"endLine":74,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003815jsd","acm000003816jsd","acm000003817jsd","acm000003818jsd","acm000003819jsd"]},"acm000003821jsd":{"type":"ControlElement","id":"acm000003821jsd","name":"__init__","comment":"","startLine":32,"endLine":33,"calleeNames":[]},"acm000003822jsd":{"type":"ControlElement","id":"acm000003822jsd","name":"__call__","comment":"","startLine":80,"endLine":82,"calleeNames":[]},"acm000003823jsd":{"type":"ClassUnit","id":"acm000003823jsd","name":"Returner","comment":"","compilationUnitId":"acm000003828jsd","parentDatatypeId":null,"startLine":76,"endLine":82,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003821jsd","acm000003822jsd"]},"acm000003824jsd":{"type":"ControlElement","id":"acm000003824jsd","name":"test___call__","comment":"Calling a Memoized dict method","startLine":87,"endLine":124,"calleeNames":["FakeObject","Returner","dict","get_memoizer_counter"]},"acm000003825jsd":{"type":"ClassUnit","id":"acm000003825jsd","name":"CountDictTestCase","comment":"","compilationUnitId":"acm000003828jsd","parentDatatypeId":null,"startLine":85,"endLine":124,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003824jsd"]},"acm000003826jsd":{"type":"ControlElement","id":"acm000003826jsd","name":"test___call__","comment":"Calling a Memoized dict method","startLine":87,"endLine":124,"calleeNames":["FakeObject","Returner","dict","get_memoizer_counter"]},"acm000003827jsd":{"type":"ClassUnit","id":"acm000003827jsd","name":"CountValueTestCase","comment":"","compilationUnitId":"acm000003828jsd","parentDatatypeId":null,"startLine":127,"endLine":159,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003826jsd"]},"acm000003828jsd":{"type":"CodeCompilationUnit","id":"acm000003828jsd","name":"MemoizeTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nEnable memoization counting","parentId":"acm000004231jsd","content":["acm000003820jsd","acm000003823jsd","acm000003825jsd","acm000003827jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.Memoize"]},"acm000003829jsd":{"type":"ControlElement","id":"acm000003829jsd","name":"__init__","comment":"Initializes a PathList object, canonicalizing the input and pre-processing it for quicker substitution later. The stored representation of the PathList is a list of tuples containing (type, value), where the \"type\" is one of the TYPE_* variables defined above. We distinguish between: strings that contain no '$' and therefore need no delayed-evaluation string substitution (we expect that there will be many of these and that we therefore get a pretty big win from avoiding string substitution) strings that contain '$' and therefore need substitution (the hard case is things like '${TARGET.dir}/include', which require re-evaluation for every target + source) other objects (which may be something like an EntryProxy that needs a method called to return a Node) Pre-identifying the type of each element in the PathList up-front and storing the type in the list of tuples is intended to reduce the amount of calculation when we actually do the substitution over and over for each target.\nno splitting, but still need a list","startLine":69,"endLine":116,"calleeNames":["is_String","split","is_Sequence","append","tuple"]},"acm000003830jsd":{"type":"ControlElement","id":"acm000003830jsd","name":"__len__","comment":"","startLine":118,"endLine":120,"calleeNames":["len"]},"acm000003831jsd":{"type":"ControlElement","id":"acm000003831jsd","name":"__getitem__","comment":"","startLine":120,"endLine":122,"calleeNames":[]},"acm000003832jsd":{"type":"ControlElement","id":"acm000003832jsd","name":"subst_path","comment":"Performs construction variable substitution on a pre-digested PathList for a specific target and source.","startLine":122,"endLine":142,"calleeNames":["subst","is_Sequence","extend","flatten","append","node_conv","tuple"]},"acm000003833jsd":{"type":"ClassUnit","id":"acm000003833jsd","name":"_PathList","comment":"An actual PathList object.","compilationUnitId":"acm000003839jsd","parentDatatypeId":null,"startLine":66,"endLine":142,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003829jsd","acm000003830jsd","acm000003831jsd","acm000003832jsd"]},"acm000003834jsd":{"type":"ControlElement","id":"acm000003834jsd","name":"__init__","comment":"Initializes a PathList object, canonicalizing the input and pre-processing it for quicker substitution later. The stored representation of the PathList is a list of tuples containing (type, value), where the \"type\" is one of the TYPE_* variables defined above. We distinguish between: strings that contain no '$' and therefore need no delayed-evaluation string substitution (we expect that there will be many of these and that we therefore get a pretty big win from avoiding string substitution) strings that contain '$' and therefore need substitution (the hard case is things like '${TARGET.dir}/include', which require re-evaluation for every target + source) other objects (which may be something like an EntryProxy that needs a method called to return a Node) Pre-identifying the type of each element in the PathList up-front and storing the type in the list of tuples is intended to reduce the amount of calculation when we actually do the substitution over and over for each target.\nno splitting, but still need a list","startLine":69,"endLine":116,"calleeNames":["is_String","split","is_Sequence","append","tuple"]},"acm000003835jsd":{"type":"ControlElement","id":"acm000003835jsd","name":"_PathList_key","comment":"Returns the key for memoization of PathLists. Note that we want this to be pretty quick, so we don't completely canonicalize all forms of the same list. For example, 'dir1:$ROOT/dir2' and ['$ROOT/dir1', 'dir'] may logically represent the same list if you're executing from $ROOT, but we're not going to bother splitting strings into path elements, or massaging strings into Nodes, to identify that equivalence. We just want to eliminate obvious redundancy from the normal case of re-using exactly the same cloned value for a path.","startLine":175,"endLine":190,"calleeNames":["is_Sequence","tuple","flatten"]},"acm000003836jsd":{"type":"ControlElement","id":"acm000003836jsd","name":"PathList","comment":"Returns the cached _PathList object for the specified pathlist, creating and caching a new object as necessary.","startLine":193,"endLine":214,"calleeNames":["_PathList_key","_PathList"]},"acm000003837jsd":{"type":"ClassUnit","id":"acm000003837jsd","name":"PathListCache","comment":"A class to handle caching of PathList lookups. This class gets instantiated once and then deleted from the namespace, so it's used as a Singleton (although we don't enforce that in the usual Pythonic ways). We could have just made the cache a dictionary in the module namespace, but putting it in this class allows us to use the same Memoizer pattern that we use elsewhere to count cache hits and misses, which is very valuable. Lookup keys in the cache are computed by the _PathList_key() method. Cache lookup should be quick, so we don't spend cycles canonicalizing all forms of the same lookup key. For example, 'x:y' and ['x', 'y'] logically represent the same list, but we don't bother to split string representations and treat those two equivalently. (Note, however, that we do, treat lists and tuples the same.) The main type of duplication we're trying to catch will come from looking up the same path list from two different clones of the same construction environment. That is, given env2 = env1.Clone() both env1 and env2 will have the same CPPPATH value, and we can cheaply avoid re-parsing both values of CPPPATH by using the common value from this cache.","compilationUnitId":"acm000003839jsd","parentDatatypeId":null,"startLine":145,"endLine":214,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003834jsd","acm000003835jsd","acm000003836jsd"]},"acm000003838jsd":{"type":"ControlElement","id":"acm000003838jsd","name":"node_conv","comment":"This is the \"string conversion\" routine that we have our substitutions use to return Nodes, not strings. This relies on the fact that an EntryProxy object has a get() method that returns the underlying Node that it wraps, which is a bit of architectural dependence that we might need to break or modify in the future in response to additional requirements.","startLine":46,"endLine":64,"calleeNames":["isinstance","is_Sequence","str","get"]},"acm000003839jsd":{"type":"CodeCompilationUnit","id":"acm000003839jsd","name":"PathList","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nHandle lists of directory paths. These are the path lists that get set as CPPPATH, LIBPATH, etc.) with as much caching of data and efficiency as we can, while still keeping the evaluation delayed so that we Do the Right Thing (almost) regardless of how the variable is specified.\n\nVariables to specify the different types of entries in a PathList object:\n","parentId":"acm000004231jsd","content":["acm000003833jsd","acm000003837jsd","acm000003838jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["os","SCons.Memoize","SCons.Node","SCons.Util"]},"acm000003840jsd":{"type":"ControlElement","id":"acm000003840jsd","name":"setUp","comment":"","startLine":31,"endLine":49,"calleeNames":["FakeEnvironment","Environment"]},"acm000003841jsd":{"type":"ControlElement","id":"acm000003841jsd","name":"test_node","comment":"Test the subst_path() method on a Node","startLine":51,"endLine":66,"calleeNames":["Node","PathList","subst_path"]},"acm000003842jsd":{"type":"ControlElement","id":"acm000003842jsd","name":"test_object","comment":"Test the subst_path() method on a non-Node object","startLine":68,"endLine":82,"calleeNames":["A","PathList","subst_path"]},"acm000003843jsd":{"type":"ControlElement","id":"acm000003843jsd","name":"test_object_get","comment":"Test the subst_path() method on an object with a get() method","startLine":84,"endLine":98,"calleeNames":["B","PathList","subst_path"]},"acm000003844jsd":{"type":"ControlElement","id":"acm000003844jsd","name":"test_string","comment":"Test the subst_path() method on a non-substitution string","startLine":100,"endLine":110,"calleeNames":["PathList","subst_path"]},"acm000003845jsd":{"type":"ControlElement","id":"acm000003845jsd","name":"test_subst","comment":"Test the subst_path() method on substitution strings","startLine":112,"endLine":120,"calleeNames":["PathList","subst_path"]},"acm000003846jsd":{"type":"ControlElement","id":"acm000003846jsd","name":"test_list_of_lists","comment":"Test the subst_path() method on substitution of nested lists.","startLine":122,"endLine":127,"calleeNames":["PathList","subst_path"]},"acm000003847jsd":{"type":"ControlElement","id":"acm000003847jsd","name":"test_subst_nested","comment":"Test the subst_path() method on nested substitution of strings.","startLine":129,"endLine":145,"calleeNames":["Append","PathList","subst_path"]},"acm000003848jsd":{"type":"ControlElement","id":"acm000003848jsd","name":"test_another_env","comment":"Test the subst_path does lazy evaluation.","startLine":147,"endLine":155,"calleeNames":["PathList","subst_path","Clone"]},"acm000003849jsd":{"type":"ClassUnit","id":"acm000003849jsd","name":"subst_pathTestCase","comment":"","compilationUnitId":"acm000003854jsd","parentDatatypeId":null,"startLine":29,"endLine":155,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003840jsd","acm000003841jsd","acm000003842jsd","acm000003843jsd","acm000003844jsd","acm000003845jsd","acm000003846jsd","acm000003847jsd","acm000003848jsd"]},"acm000003850jsd":{"type":"ControlElement","id":"acm000003850jsd","name":"test_no_PathListCache","comment":"Make sure the PathListCache class is not visible","startLine":159,"endLine":167,"calleeNames":["fail"]},"acm000003851jsd":{"type":"ClassUnit","id":"acm000003851jsd","name":"PathListCacheTestCase","comment":"","compilationUnitId":"acm000003854jsd","parentDatatypeId":null,"startLine":157,"endLine":167,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003850jsd"]},"acm000003852jsd":{"type":"ControlElement","id":"acm000003852jsd","name":"test_PathList","comment":"Test the PathList() entry point","startLine":172,"endLine":183,"calleeNames":["PathList"]},"acm000003853jsd":{"type":"ClassUnit","id":"acm000003853jsd","name":"PathListTestCase","comment":"","compilationUnitId":"acm000003854jsd","parentDatatypeId":null,"startLine":170,"endLine":183,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003852jsd"]},"acm000003854jsd":{"type":"CodeCompilationUnit","id":"acm000003854jsd","name":"PathListTests","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000004231jsd","content":["acm000003849jsd","acm000003851jsd","acm000003853jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.PathList","SCons.Environment.Environment","SCons.Node"]},"acm000003855jsd":{"type":"ClassUnit","id":"acm000003855jsd","name":"SConfWarning","comment":"some error definitions","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":139,"endLine":140,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000003856jsd":{"type":"ControlElement","id":"acm000003856jsd","name":"__init__","comment":"","startLine":145,"endLine":146,"calleeNames":["super","__init__"]},"acm000003857jsd":{"type":"ClassUnit","id":"acm000003857jsd","name":"SConfError","comment":"","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":144,"endLine":146,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003856jsd"]},"acm000003858jsd":{"type":"ControlElement","id":"acm000003858jsd","name":"__init__","comment":"","startLine":145,"endLine":146,"calleeNames":["super","__init__"]},"acm000003859jsd":{"type":"ClassUnit","id":"acm000003859jsd","name":"ConfigureDryRunError","comment":"Raised when a file or directory needs to be updated during a Configure process, but the user requested a dry-run","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":148,"endLine":156,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003858jsd"]},"acm000003860jsd":{"type":"ControlElement","id":"acm000003860jsd","name":"__init__","comment":"","startLine":145,"endLine":146,"calleeNames":["super","__init__"]},"acm000003861jsd":{"type":"ClassUnit","id":"acm000003861jsd","name":"ConfigureCacheError","comment":"Raised when a use explicitely requested the cache feature, but the test is run the first time.","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":158,"endLine":162,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003860jsd"]},"acm000003862jsd":{"type":"ControlElement","id":"acm000003862jsd","name":"__init__","comment":"","startLine":145,"endLine":146,"calleeNames":["super","__init__"]},"acm000003863jsd":{"type":"ControlElement","id":"acm000003863jsd","name":"set_build_result","comment":"","startLine":188,"endLine":190,"calleeNames":[]},"acm000003864jsd":{"type":"ClassUnit","id":"acm000003864jsd","name":"SConfBuildInfo","comment":"Special build info for targets of configure tests. Additional members are result (did the builder succeed last time?) and string, which contains messages of the original build phase.","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":176,"endLine":190,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003862jsd","acm000003863jsd"]},"acm000003865jsd":{"type":"ControlElement","id":"acm000003865jsd","name":"__init__","comment":"","startLine":145,"endLine":146,"calleeNames":["super","__init__"]},"acm000003866jsd":{"type":"ControlElement","id":"acm000003866jsd","name":"write","comment":"\"unicode argument expected\" bug in IOStream (python 2.x)","startLine":201,"endLine":208,"calleeNames":["write","decode"]},"acm000003867jsd":{"type":"ControlElement","id":"acm000003867jsd","name":"writelines","comment":"","startLine":210,"endLine":212,"calleeNames":["write"]},"acm000003868jsd":{"type":"ControlElement","id":"acm000003868jsd","name":"getvalue","comment":"Return everything written to orig since the Streamer was created.","startLine":214,"endLine":218,"calleeNames":["getvalue"]},"acm000003869jsd":{"type":"ControlElement","id":"acm000003869jsd","name":"flush","comment":"","startLine":220,"endLine":223,"calleeNames":["flush"]},"acm000003870jsd":{"type":"ClassUnit","id":"acm000003870jsd","name":"Streamer","comment":"'Sniffer' for a file-like writable object. Similar to the unix tool tee.","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":193,"endLine":223,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003865jsd","acm000003866jsd","acm000003867jsd","acm000003868jsd","acm000003869jsd"]},"acm000003871jsd":{"type":"ControlElement","id":"acm000003871jsd","name":"display","comment":"","startLine":233,"endLine":235,"calleeNames":["write"]},"acm000003872jsd":{"type":"ControlElement","id":"acm000003872jsd","name":"display_cached_string","comment":"Logs the original builder messages, given the SConfBuildInfo instance bi.","startLine":237,"endLine":249,"calleeNames":["isinstance","warn","display","replace","str"]},"acm000003873jsd":{"type":"ControlElement","id":"acm000003873jsd","name":"failed","comment":"check, if the reason was a ConfigureDryRunError or a\nConfigureCacheError and if yes, reraise the exception\nwe ignore Build Errors (occurs, when a test doesn't pass)\nClear the exception to prevent the contained traceback\nto build a reference cycle.","startLine":251,"endLine":266,"calleeNames":["exc_info","issubclass","exc_clear","display","excepthook","failed"]},"acm000003874jsd":{"type":"ControlElement","id":"acm000003874jsd","name":"collect_node_states","comment":"returns (is_up_to_date, cached_error, cachable)\nwhere is_up_to_date is True if the node(s) are up_to_date\ncached_error is True if the node(s) are up_to_date, but the\nbuild will fail\ncachable is False if some nodes are not in our cache","startLine":268,"endLine":301,"calleeNames":["Trace","get_stored_info","isinstance","set_state","get_state","changed"]},"acm000003875jsd":{"type":"ControlElement","id":"acm000003875jsd","name":"execute","comment":"","startLine":303,"endLine":379,"calleeNames":["has_builder","collect_node_states","ConfigureCacheError","display","str","get_stored_info","display_cached_string","ConfigureDryRunError","Streamer","get_build_env","build","exc_info","ExplicitExit","SConfBuildInfo","merge","get_binfo","set_build_result","getvalue","SConsignEntry","sconsign","set_entry"]},"acm000003876jsd":{"type":"ControlElement","id":"acm000003876jsd","name":"make_ready_current","comment":"We're overriding make_ready_current() call to add to the list\nof nodes used by this task, filtering out any nodes created\nby the checker for it's own purpose.","startLine":381,"endLine":386,"calleeNames":["update","is_conftest","super","make_ready_current"]},"acm000003877jsd":{"type":"ControlElement","id":"acm000003877jsd","name":"postprocess","comment":"We're done executing this task, so now we'll go through all the\nnodes used by this task which aren't nodes created for\nConfigure checkers, but rather are existing or built files\nand reset their node info.\nIf we do not reset their node info, any changes in these\nnodes will not trigger builds in the normal build process","startLine":389,"endLine":398,"calleeNames":["new_ninfo","super","postprocess"]},"acm000003878jsd":{"type":"ClassUnit","id":"acm000003878jsd","name":"SConfBuildTask","comment":"This is almost the same as SCons.Script.BuildTask. Handles SConfErrors correctly and knows about the current cache_mode.","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":226,"endLine":398,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003871jsd","acm000003872jsd","acm000003873jsd","acm000003874jsd","acm000003875jsd","acm000003876jsd","acm000003877jsd"]},"acm000003879jsd":{"type":"ControlElement","id":"acm000003879jsd","name":"__init__","comment":"","startLine":145,"endLine":146,"calleeNames":["super","__init__"]},"acm000003880jsd":{"type":"ControlElement","id":"acm000003880jsd","name":"__call__","comment":"","startLine":736,"endLine":744,"calleeNames":["CheckContext","test","Result"]},"acm000003881jsd":{"type":"ClassUnit","id":"acm000003881jsd","name":"TestWrapper","comment":"A wrapper around Tests (to ensure sanity)","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":731,"endLine":744,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003879jsd","acm000003880jsd"]},"acm000003882jsd":{"type":"ControlElement","id":"acm000003882jsd","name":"__init__","comment":"","startLine":145,"endLine":146,"calleeNames":["super","__init__"]},"acm000003883jsd":{"type":"ControlElement","id":"acm000003883jsd","name":"Finish","comment":"Call this method after finished with your tests: env = sconf.Finish()","startLine":491,"endLine":497,"calleeNames":["_shutdown"]},"acm000003884jsd":{"type":"ControlElement","id":"acm000003884jsd","name":"Define","comment":"Define a pre processor symbol name, with the optional given value in the current config header. If value is None (default), then #define name is written. If value is not none, then #define name value is written. comment is a string which will be put as a C comment in the header, to explain the meaning of the value (appropriate C comments will be added automatically).","startLine":499,"endLine":522,"calleeNames":["append","join"]},"acm000003885jsd":{"type":"ControlElement","id":"acm000003885jsd","name":"BuildNodes","comment":"Tries to build the given nodes immediately. Returns 1 on success, 0 on error.\noverride stdout / stderr to write in log file\nthe engine assumes the current path is the SConstruct directory ...","startLine":524,"endLine":591,"calleeNames":["getcwd","chdir","_set_conftest_node","hasattr","Attrs","children","has_builder","get_max_drift","set_max_drift","Taskmaster","Jobs","run","get_state"]},"acm000003886jsd":{"type":"ControlElement","id":"acm000003886jsd","name":"pspawn_wrapper","comment":"Wrapper function for handling piped spawns. This looks to the calling interface (in Action.py) like a \"normal\" spawn, but associates the call with the PSPAWN variable from the construction environment and with the streams to which we want the output logged. This gets slid into the construction environment as the SPAWN variable so Action.py doesn't have to know or care whether it's spawning a piped command or not.","startLine":593,"endLine":603,"calleeNames":["pspawn"]},"acm000003887jsd":{"type":"ControlElement","id":"acm000003887jsd","name":"TryBuild","comment":"Low level TryBuild implementation. Normally you don't need to call that - you can use TryCompile / TryLink / TryRun instead\nMake sure we have a PSPAWN value, and save the current\nSPAWN value.","startLine":605,"endLine":674,"calleeNames":["UserError","Value","_set_conftest_node","hash_signature","str","join","File","SConfSourceBuilder","extend","get_contents","subst","builder","is_List","BuildNodes"]},"acm000003888jsd":{"type":"ControlElement","id":"acm000003888jsd","name":"TryAction","comment":"Tries to execute the given action with optional source file contents <text> and optional source file extension <extension>, Returns the status (0 : failed, 1 : ok) and the contents of the output file.","startLine":676,"endLine":689,"calleeNames":["Builder","Append","TryBuild","get_text_contents"]},"acm000003889jsd":{"type":"ControlElement","id":"acm000003889jsd","name":"TryCompile","comment":"Compiles the program given in text to an env.Object, using extension as file extension (e.g. '.c'). Returns 1, if compilation was successful, 0 otherwise. The target is saved in self.lastTarget (for further processing).","startLine":691,"endLine":697,"calleeNames":["TryBuild"]},"acm000003890jsd":{"type":"ControlElement","id":"acm000003890jsd","name":"TryLink","comment":"Compiles the program given in text to an executable env.Program, using extension as file extension (e.g. '.c'). Returns 1, if compilation was successful, 0 otherwise. The target is saved in self.lastTarget (for further processing).","startLine":699,"endLine":705,"calleeNames":["TryBuild"]},"acm000003891jsd":{"type":"ControlElement","id":"acm000003891jsd","name":"TryRun","comment":"Compiles and runs the program given in text, using extension as file extension (e.g. '.c'). Returns (1, outputStr) on success, (0, '') otherwise. The target (a file containing the program's stdout) is saved in self.lastTarget (for further processing).","startLine":707,"endLine":729,"calleeNames":["TryLink","get_internal_path","replace","File","basename","Command","BuildNodes","to_str","get_contents"]},"acm000003892jsd":{"type":"ControlElement","id":"acm000003892jsd","name":"AddTest","comment":"Adds test_class to this SConf instance. It can be called with self.test_name(...)","startLine":746,"endLine":749,"calleeNames":["setattr","TestWrapper"]},"acm000003893jsd":{"type":"ControlElement","id":"acm000003893jsd","name":"AddTests","comment":"Adds all the tests given in the tests dictionary to this SConf instance","startLine":751,"endLine":756,"calleeNames":["keys","AddTest"]},"acm000003894jsd":{"type":"ControlElement","id":"acm000003894jsd","name":"_createDir","comment":"","startLine":758,"endLine":765,"calleeNames":["str","isdir","ConfigureDryRunError","makedirs"]},"acm000003895jsd":{"type":"ControlElement","id":"acm000003895jsd","name":"_startup","comment":"Private method. Set up logstream, and set the environment variables necessary for a piped build","startLine":767,"endLine":816,"calleeNames":["_createDir","up","add_ignore","open","str","close","register","Unbuffered","extract_stack","getcwd","chdir","write","Action","Builder","Append","get"]},"acm000003896jsd":{"type":"ControlElement","id":"acm000003896jsd","name":"_shutdown","comment":"Private method. Reset to non-piped spawn\nNow reset the decider if we changed it due to --config=force\nWe saved original Environment passed in and cloned it to isolate\nit from being changed.\nremove the SConfSourceBuilder from the environment","startLine":818,"endLine":844,"calleeNames":["UserError","write","close","Decider","Replace"]},"acm000003897jsd":{"type":"ClassUnit","id":"acm000003897jsd","name":"SConfBase","comment":"This is simply a class to represent a configure context. After creating a SConf object, you can call any tests. After finished with your tests, be sure to call the Finish() method, which returns the modified environment. Some words about caching: In most cases, it is not necessary to cache Test results explicitly. Instead, we use the scons dependency checking mechanism. For example, if one wants to compile a test program (SConf.TryLink), the compiler is only called, if the program dependencies have changed. However, if the program could not be compiled in a former SConf run, we need to explicitly cache this error.","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":400,"endLine":844,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003881jsd","acm000003882jsd","acm000003883jsd","acm000003884jsd","acm000003885jsd","acm000003886jsd","acm000003887jsd","acm000003888jsd","acm000003889jsd","acm000003890jsd","acm000003891jsd","acm000003892jsd","acm000003893jsd","acm000003894jsd","acm000003895jsd","acm000003896jsd"]},"acm000003898jsd":{"type":"ControlElement","id":"acm000003898jsd","name":"__init__","comment":"","startLine":145,"endLine":146,"calleeNames":["super","__init__"]},"acm000003899jsd":{"type":"ControlElement","id":"acm000003899jsd","name":"Message","comment":"Inform about what we are doing right now, e.g. 'Checking for SOMETHING ... '","startLine":882,"endLine":888,"calleeNames":["Display"]},"acm000003900jsd":{"type":"ControlElement","id":"acm000003900jsd","name":"Result","comment":"Inform about the result of the test. If res is not a string, displays 'yes' or 'no' depending on whether res is evaluated as true or false. The result is only displayed when self.did_show_result is not set.\nDidn't show result yet, do it now.","startLine":890,"endLine":905,"calleeNames":["isinstance","Display"]},"acm000003901jsd":{"type":"ControlElement","id":"acm000003901jsd","name":"TryBuild","comment":"Low level TryBuild implementation. Normally you don't need to call that - you can use TryCompile / TryLink / TryRun instead\nMake sure we have a PSPAWN value, and save the current\nSPAWN value.","startLine":605,"endLine":674,"calleeNames":["UserError","Value","_set_conftest_node","hash_signature","str","join","File","SConfSourceBuilder","extend","get_contents","subst","builder","is_List","BuildNodes"]},"acm000003902jsd":{"type":"ControlElement","id":"acm000003902jsd","name":"TryAction","comment":"Tries to execute the given action with optional source file contents <text> and optional source file extension <extension>, Returns the status (0 : failed, 1 : ok) and the contents of the output file.","startLine":676,"endLine":689,"calleeNames":["Builder","Append","TryBuild","get_text_contents"]},"acm000003903jsd":{"type":"ControlElement","id":"acm000003903jsd","name":"TryCompile","comment":"Compiles the program given in text to an env.Object, using extension as file extension (e.g. '.c'). Returns 1, if compilation was successful, 0 otherwise. The target is saved in self.lastTarget (for further processing).","startLine":691,"endLine":697,"calleeNames":["TryBuild"]},"acm000003904jsd":{"type":"ControlElement","id":"acm000003904jsd","name":"TryLink","comment":"Compiles the program given in text to an executable env.Program, using extension as file extension (e.g. '.c'). Returns 1, if compilation was successful, 0 otherwise. The target is saved in self.lastTarget (for further processing).","startLine":699,"endLine":705,"calleeNames":["TryBuild"]},"acm000003905jsd":{"type":"ControlElement","id":"acm000003905jsd","name":"TryRun","comment":"Compiles and runs the program given in text, using extension as file extension (e.g. '.c'). Returns (1, outputStr) on success, (0, '') otherwise. The target (a file containing the program's stdout) is saved in self.lastTarget (for further processing).","startLine":707,"endLine":729,"calleeNames":["TryLink","get_internal_path","replace","File","basename","Command","BuildNodes","to_str","get_contents"]},"acm000003906jsd":{"type":"ControlElement","id":"acm000003906jsd","name":"__getattr__","comment":"### Stuff used by Conftest.py (look there for explanations).","startLine":922,"endLine":928,"calleeNames":["AttributeError"]},"acm000003907jsd":{"type":"ControlElement","id":"acm000003907jsd","name":"BuildProg","comment":"","startLine":932,"endLine":935,"calleeNames":["TryBuild"]},"acm000003908jsd":{"type":"ControlElement","id":"acm000003908jsd","name":"CompileProg","comment":"","startLine":937,"endLine":940,"calleeNames":["TryBuild"]},"acm000003909jsd":{"type":"ControlElement","id":"acm000003909jsd","name":"CompileSharedObject","comment":"","startLine":942,"endLine":945,"calleeNames":["TryBuild"]},"acm000003910jsd":{"type":"ControlElement","id":"acm000003910jsd","name":"RunProg","comment":"","startLine":947,"endLine":951,"calleeNames":["TryRun"]},"acm000003911jsd":{"type":"ControlElement","id":"acm000003911jsd","name":"AppendLIBS","comment":"","startLine":953,"endLine":959,"calleeNames":["get","AppendUnique","Append"]},"acm000003912jsd":{"type":"ControlElement","id":"acm000003912jsd","name":"PrependLIBS","comment":"","startLine":961,"endLine":967,"calleeNames":["get","PrependUnique","Prepend"]},"acm000003913jsd":{"type":"ControlElement","id":"acm000003913jsd","name":"SetLIBS","comment":"","startLine":969,"endLine":972,"calleeNames":["get","Replace"]},"acm000003914jsd":{"type":"ControlElement","id":"acm000003914jsd","name":"Display","comment":"We assume that Display is called twice for each test here\nonce for the Checking for ... message and once for the result.\nThe self.sconf.cached flag can only be set between those calls","startLine":974,"endLine":982,"calleeNames":["progress_display","Log"]},"acm000003915jsd":{"type":"ControlElement","id":"acm000003915jsd","name":"Log","comment":"### End of stuff used by Conftest.py.","startLine":984,"endLine":986,"calleeNames":["write"]},"acm000003916jsd":{"type":"ClassUnit","id":"acm000003916jsd","name":"CheckContext","comment":"Provides a context for configure tests. Defines how a test writes to the screen and log file. A typical test is just a callable with an instance of CheckContext as first argument: def CheckCustom(context, ...): context.Message('Checking my weird test ... ') ret = myWeirdTestFunction(...) context.Result(ret) Often, myWeirdTestFunction will be one of context.TryCompile/context.TryLink/context.TryRun. The results of those are cached, for they are only rebuild, if the dependencies have changed.","compilationUnitId":"acm000003944jsd","parentDatatypeId":null,"startLine":846,"endLine":986,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000003898jsd","acm000003899jsd","acm000003900jsd","acm000003901jsd","acm000003902jsd","acm000003903jsd","acm000003904jsd","acm000003905jsd","acm000003906jsd","acm000003907jsd","acm000003908jsd","acm000003909jsd","acm000003910jsd","acm000003911jsd","acm000003912jsd","acm000003913jsd","acm000003914jsd","acm000003915jsd"]},"acm000003917jsd":{"type":"ControlElement","id":"acm000003917jsd","name":"SetBuildType","comment":"","startLine":65,"endLine":67,"calleeNames":[]},"acm000003918jsd":{"type":"ControlElement","id":"acm000003918jsd","name":"_set_conftest_node","comment":"","startLine":77,"endLine":78,"calleeNames":[]},"acm000003919jsd":{"type":"ControlElement","id":"acm000003919jsd","name":"SetCacheMode","comment":"Set the Configure cache mode. mode must be one of \"auto\", \"force\", or \"cache\".","startLine":80,"endLine":91,"calleeNames":["ValueError"]},"acm000003920jsd":{"type":"ControlElement","id":"acm000003920jsd","name":"SetProgressDisplay","comment":"Set the progress display to use (called from SCons.Script)","startLine":94,"endLine":97,"calleeNames":[]},"acm000003921jsd":{"type":"ControlElement","id":"acm000003921jsd","name":"_createConfigH","comment":"","startLine":106,"endLine":117,"calleeNames":["open","str","sub","upper","write","get_contents","decode","close"]},"acm000003922jsd":{"type":"ControlElement","id":"acm000003922jsd","name":"_stringConfigH","comment":"","startLine":119,"endLine":120,"calleeNames":["str"]},"acm000003923jsd":{"type":"ControlElement","id":"acm000003923jsd","name":"NeedConfigHBuilder","comment":"","startLine":123,"endLine":127,"calleeNames":["len"]},"acm000003924jsd":{"type":"ControlElement","id":"acm000003924jsd","name":"CreateConfigHBuilder","comment":"Called if necessary just before the building targets phase begins.","startLine":129,"endLine":136,"calleeNames":["Action","Builder","Append","items","SConfigHBuilder","Value"]},"acm000003925jsd":{"type":"ControlElement","id":"acm000003925jsd","name":"_createSource","comment":"","startLine":166,"endLine":169,"calleeNames":["open","str","write","get_contents","decode","close"]},"acm000003926jsd":{"type":"ControlElement","id":"acm000003926jsd","name":"_stringSource","comment":"","startLine":172,"endLine":174,"calleeNames":["str","get_contents","decode","replace"]},"acm000003927jsd":{"type":"ControlElement","id":"acm000003927jsd","name":"SConf","comment":"","startLine":991,"endLine":1001,"calleeNames":["get","SConfBase","Null"]},"acm000003928jsd":{"type":"ControlElement","id":"acm000003928jsd","name":"CheckFunc","comment":"","startLine":1004,"endLine":1007,"calleeNames":["CheckFunc"]},"acm000003929jsd":{"type":"ControlElement","id":"acm000003929jsd","name":"CheckType","comment":"","startLine":1009,"endLine":1013,"calleeNames":["CheckType"]},"acm000003930jsd":{"type":"ControlElement","id":"acm000003930jsd","name":"CheckTypeSize","comment":"","startLine":1015,"endLine":1020,"calleeNames":["CheckTypeSize"]},"acm000003931jsd":{"type":"ControlElement","id":"acm000003931jsd","name":"CheckDeclaration","comment":"","startLine":1022,"endLine":1027,"calleeNames":["CheckDeclaration"]},"acm000003932jsd":{"type":"ControlElement","id":"acm000003932jsd","name":"CheckMember","comment":"Returns the status (False : failed, True : ok).","startLine":1029,"endLine":1033,"calleeNames":["CheckMember"]},"acm000003933jsd":{"type":"ControlElement","id":"acm000003933jsd","name":"createIncludesFromHeaders","comment":"used by CheckHeader and CheckLibWithHeader to produce C - #include\nstatements from the specified header (list)","startLine":1036,"endLine":1050,"calleeNames":["is_List","append","join"]},"acm000003934jsd":{"type":"ControlElement","id":"acm000003934jsd","name":"CheckHeader","comment":"A test for a C or C++ header file.","startLine":1052,"endLine":1062,"calleeNames":["createIncludesFromHeaders","CheckHeader"]},"acm000003935jsd":{"type":"ControlElement","id":"acm000003935jsd","name":"CheckCC","comment":"","startLine":1064,"endLine":1067,"calleeNames":["CheckCC"]},"acm000003936jsd":{"type":"ControlElement","id":"acm000003936jsd","name":"CheckCXX","comment":"","startLine":1069,"endLine":1072,"calleeNames":["CheckCXX"]},"acm000003937jsd":{"type":"ControlElement","id":"acm000003937jsd","name":"CheckSHCC","comment":"","startLine":1074,"endLine":1077,"calleeNames":["CheckSHCC"]},"acm000003938jsd":{"type":"ControlElement","id":"acm000003938jsd","name":"CheckSHCXX","comment":"","startLine":1079,"endLine":1082,"calleeNames":["CheckSHCXX"]},"acm000003939jsd":{"type":"ControlElement","id":"acm000003939jsd","name":"CheckCHeader","comment":"A test for a C header file.\nBram: Make this function obsolete? CheckHeader() is more generic.","startLine":1086,"endLine":1090,"calleeNames":["CheckHeader"]},"acm000003940jsd":{"type":"ControlElement","id":"acm000003940jsd","name":"CheckCXXHeader","comment":"A test for a C++ header file.","startLine":1095,"endLine":1099,"calleeNames":["CheckHeader"]},"acm000003941jsd":{"type":"ControlElement","id":"acm000003941jsd","name":"CheckLib","comment":"A test for a library. See also CheckLibWithHeader. Note that library may also be None to test whether the given symbol compiles without flags.\nToDo: accept path for the library","startLine":1102,"endLine":1122,"calleeNames":["is_List","CheckLib"]},"acm000003942jsd":{"type":"ControlElement","id":"acm000003942jsd","name":"CheckLibWithHeader","comment":"ToDo: accept path for library. Support system header files.\nAnother (more sophisticated) test for a library. Checks, if library and header is available for language (may be 'C' or 'CXX'). Call maybe be a valid expression _with_ a trailing ';'. As in CheckLib, we support library=None, to test if the call compiles without extra link flags.","startLine":1127,"endLine":1148,"calleeNames":["createIncludesFromHeaders","is_List","CheckLib"]},"acm000003943jsd":{"type":"ControlElement","id":"acm000003943jsd","name":"CheckProg","comment":"Simple check if a program exists in the path. Returns the path for the application, or None if not found.","startLine":1150,"endLine":1156,"calleeNames":["CheckProg"]},"acm000003944jsd":{"type":"CodeCompilationUnit","id":"acm000003944jsd","name":"SConf","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nAutoconf-like configuration support. In other words, SConf allows to run tests on the build machine to detect capabilities of system and do some things based on result: generate config files, header files for C/C++, update variables in environment. Tests on the build system can detect if compiler sees header files, if libraries are installed, if some command line options are supported etc.\nTurn off the Conftest error logging","parentId":"acm000004231jsd","content":["acm000003855jsd","acm000003857jsd","acm000003859jsd","acm000003861jsd","acm000003864jsd","acm000003870jsd","acm000003878jsd","acm000003897jsd","acm000003916jsd","acm000003917jsd","acm000003918jsd","acm000003919jsd","acm000003920jsd","acm000003921jsd","acm000003922jsd","acm000003923jsd","acm000003924jsd","acm000003925jsd","acm000003926jsd","acm000003927jsd","acm000003928jsd","acm000003929jsd","acm000003930jsd","acm000003931jsd","acm000003932jsd","acm000003933jsd","acm000003934jsd","acm000003935jsd","acm000003936jsd","acm000003937jsd","acm000003938jsd","acm000003939jsd","acm000003940jsd","acm000003941jsd","acm000003942jsd","acm000003943jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.compat","atexit","io","os","re","sys","traceback","typing.Tuple","SCons.Action","SCons.Builder","SCons.Errors","SCons.Taskmaster.Job","SCons.Node.FS","SCons.Taskmaster","SCons.Util","SCons.Warnings","SCons.Conftest","SCons.Debug.Trace","collections.defaultdict"]},"acm000003945jsd":{"type":"ControlElement","id":"acm000003945jsd","name":"setUp","comment":"we always want to start with a clean directory","startLine":43,"endLine":47,"calleeNames":["getcwd","TestCmd","chdir","workpath"]},"acm000003946jsd":{"type":"ControlElement","id":"acm000003946jsd","name":"tearDown","comment":"","startLine":49,"endLine":53,"calleeNames":["cleanup","Reset","chdir"]},"acm000003947jsd":{"type":"ControlElement","id":"acm000003947jsd","name":"_resetSConfState","comment":"Ok, this is tricky, and i do not know, if everything is sane.\nWe try to reset scons' state (including all global variables)\nsimulate normal scons-finish\nif this is really a scons module, clear its namespace\nwe only use SCons.Environment and SCons.SConf for these tests.","startLine":55,"endLine":92,"calleeNames":["write","list","keys","split","isinstance","clear","Environment","AppendENVPath","all","Detect","subst","Exception"]},"acm000003948jsd":{"type":"ControlElement","id":"acm000003948jsd","name":"_baseTryXXX","comment":"TryCompile and TryLink are much the same, so we can test them\nin one method, we pass the function as a string ('TryCompile',\n'TryLink'), so we are aware of reloading modules.","startLine":94,"endLine":149,"calleeNames":["TryFunc","_resetSConfState","SConf","workpath","checks","Finish","str","read","compile","match","end","write"]},"acm000003949jsd":{"type":"ControlElement","id":"acm000003949jsd","name":"test_TryBuild","comment":"Test SConf.TryBuild\n1 test that we can try a builder that returns a list of nodes","startLine":151,"endLine":234,"calleeNames":["_resetSConfState","SConf","workpath","MyAction","set","Attrs","Executor","MyNode","Append","MyBuilder","TryBuild","Finish"]},"acm000003950jsd":{"type":"ControlElement","id":"acm000003950jsd","name":"test_TryCompile","comment":"Test SConf.TryCompile\nself.SConf.SConf.TryCompile )","startLine":236,"endLine":239,"calleeNames":["_baseTryXXX"]},"acm0000