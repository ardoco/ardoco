mment":"Test the to_Bytes method","startLine":350,"endLine":354,"calleeNames":["assertEqual","to_bytes","bytearray"]},"acm000006122jsd":{"type":"ControlElement","id":"acm000006122jsd","name":"test_to_String","comment":"Test the to_String() method.\ntest low level string converters too","startLine":356,"endLine":375,"calleeNames":["to_String","str","to_str","to_bytes","UserString","Derived"]},"acm000006123jsd":{"type":"ControlElement","id":"acm000006123jsd","name":"test_WhereIs","comment":"","startLine":378,"endLine":456,"calleeNames":["TestCmd","workpath","subdir","write","mkdir","chmod","split","join","WhereIs","lower"]},"acm000006124jsd":{"type":"ControlElement","id":"acm000006124jsd","name":"test_get_env_var","comment":"Testing get_environment_var().","startLine":458,"endLine":469,"calleeNames":["get_environment_var"]},"acm000006125jsd":{"type":"ControlElement","id":"acm000006125jsd","name":"test_Proxy","comment":"Test generic Proxy class.","startLine":471,"endLine":498,"calleeNames":["Subject","ProxyTest","meth","other","get"]},"acm000006126jsd":{"type":"ControlElement","id":"acm000006126jsd","name":"test_display","comment":"","startLine":500,"endLine":514,"calleeNames":["OutBuffer","display","set_mode"]},"acm000006127jsd":{"type":"ControlElement","id":"acm000006127jsd","name":"test_get_native_path","comment":"Test the get_native_path() function.","startLine":516,"endLine":531,"calleeNames":["mkstemp","close","open","write","get_native_path","read","unlink"]},"acm000006128jsd":{"type":"ControlElement","id":"acm000006128jsd","name":"test_PrependPath","comment":"Test prepending to a path\nhave to include the pathsep here so that the test will work on UNIX too.","startLine":533,"endLine":549,"calleeNames":["PrependPath"]},"acm000006129jsd":{"type":"ControlElement","id":"acm000006129jsd","name":"test_AppendPath","comment":"Test appending to a path.\nhave to include the pathsep here so that the test will work on UNIX too.","startLine":551,"endLine":567,"calleeNames":["AppendPath"]},"acm000006130jsd":{"type":"ControlElement","id":"acm000006130jsd","name":"test_PrependPathPreserveOld","comment":"Test prepending to a path while preserving old paths\nhave to include the pathsep here so that the test will work on UNIX too.","startLine":569,"endLine":575,"calleeNames":["PrependPath"]},"acm000006131jsd":{"type":"ControlElement","id":"acm000006131jsd","name":"test_AppendPathPreserveOld","comment":"Test appending to a path while preserving old paths\nhave to include the pathsep here so that the test will work on UNIX too.","startLine":577,"endLine":583,"calleeNames":["AppendPath"]},"acm000006132jsd":{"type":"ControlElement","id":"acm000006132jsd","name":"test_addPathIfNotExists","comment":"Test the AddPathIfNotExists() function","startLine":585,"endLine":607,"calleeNames":["normpath","AddPathIfNotExists"]},"acm000006133jsd":{"type":"ControlElement","id":"acm000006133jsd","name":"test_CLVar","comment":"Test the command-line construction variable class\nthe default value should be an empty list","startLine":609,"endLine":729,"calleeNames":["CLVar","isinstance","type","str"]},"acm000006134jsd":{"type":"ControlElement","id":"acm000006134jsd","name":"test_Selector","comment":"Test the Selector class","startLine":732,"endLine":784,"calleeNames":["splitext","Selector","DummyEnv","s","MyNode"]},"acm000006135jsd":{"type":"ControlElement","id":"acm000006135jsd","name":"test_adjustixes","comment":"Test the adjustixes() function","startLine":786,"endLine":804,"calleeNames":["adjustixes","join"]},"acm000006136jsd":{"type":"ControlElement","id":"acm000006136jsd","name":"test_containsAny","comment":"Test the containsAny() function","startLine":806,"endLine":809,"calleeNames":["containsAny"]},"acm000006137jsd":{"type":"ControlElement","id":"acm000006137jsd","name":"test_containsAll","comment":"Test the containsAll() function","startLine":811,"endLine":814,"calleeNames":["containsAll"]},"acm000006138jsd":{"type":"ControlElement","id":"acm000006138jsd","name":"test_containsOnly","comment":"Test the containsOnly() function","startLine":816,"endLine":819,"calleeNames":["containsOnly"]},"acm000006139jsd":{"type":"ControlElement","id":"acm000006139jsd","name":"test_LogicalLines","comment":"Test the LogicalLines class","startLine":821,"endLine":840,"calleeNames":["StringIO","LogicalLines","readlines"]},"acm000006140jsd":{"type":"ControlElement","id":"acm000006140jsd","name":"test_intern","comment":"","startLine":842,"endLine":846,"calleeNames":["silent_intern","id"]},"acm000006141jsd":{"type":"ClassUnit","id":"acm000006141jsd","name":"UtilTestCase","comment":"","compilationUnitId":"acm000006179jsd","parentDatatypeId":null,"startLine":108,"endLine":846,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006111jsd","acm000006112jsd","acm000006113jsd","acm000006114jsd","acm000006115jsd","acm000006116jsd","acm000006117jsd","acm000006118jsd","acm000006119jsd","acm000006120jsd","acm000006121jsd","acm000006122jsd","acm000006123jsd","acm000006124jsd","acm000006125jsd","acm000006126jsd","acm000006127jsd","acm000006128jsd","acm000006129jsd","acm000006130jsd","acm000006131jsd","acm000006132jsd","acm000006133jsd","acm000006134jsd","acm000006135jsd","acm000006136jsd","acm000006137jsd","acm000006138jsd","acm000006139jsd","acm000006140jsd"]},"acm000006142jsd":{"type":"ControlElement","id":"acm000006142jsd","name":"test_collect","comment":"Test collecting a list of signatures into a new signature value\nif the current platform does not support the algorithm we're looking at,\nskip the test steps for that algorithm, but display a warning to the user","startLine":851,"endLine":875,"calleeNames":["items","warn","format","partial","list","map","hash_collect"]},"acm000006143jsd":{"type":"ControlElement","id":"acm000006143jsd","name":"test_MD5signature","comment":"Test generating a signature\nif the current platform does not support the algorithm we're looking at,\nskip the test steps for that algorithm, but display a warning to the user\nthis uses mocking out, which is platform specific, however, the FIPS\nbehavior this is testing is also platform-specific, and only would be\nvisible in hosts running Linux with the fips_mode kernel flag along\nwith using OpenSSL.","startLine":877,"endLine":896,"calleeNames":["items","warn","format","hash_signature"]},"acm000006144jsd":{"type":"ClassUnit","id":"acm000006144jsd","name":"HashTestCase","comment":"","compilationUnitId":"acm000006179jsd","parentDatatypeId":null,"startLine":849,"endLine":896,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000006142jsd","acm000006143jsd"]},"acm000006145jsd":{"type":"ControlElement","id":"acm000006145jsd","name":"__init__","comment":"","startLine":88,"endLine":89,"calleeNames":[]},"acm000006146jsd":{"type":"ControlElement","id":"acm000006146jsd","name":"test_basic_failover_bad_hashlib_hash_init","comment":"Tests that if the hashing function is entirely missing from hashlib (hashlib returns None), the hash init function returns None","startLine":962,"endLine":965,"calleeNames":["_attempt_init_of_python_3_9_hash_object"]},"acm000006147jsd":{"type":"ControlElement","id":"acm000006147jsd","name":"test_basic_failover_bad_hashlib_hash_get","comment":"Tests that if the hashing function is entirely missing from hashlib (hashlib returns None), the hash get function returns None","startLine":967,"endLine":970,"calleeNames":["_attempt_get_hash_function"]},"acm000006148jsd":{"type":"ControlElement","id":"acm000006148jsd","name":"test_usedforsecurity_flag_behavior","comment":"Test usedforsecurity flag -> should be set to 'True' on older versions of python, and 'False' on Python >= 3.9","startLine":972,"endLine":979,"calleeNames":["items","_attempt_init_of_python_3_9_hash_object"]},"acm000006149jsd":{"type":"ControlElement","id":"acm000006149jsd","name":"test_automatic_default_to_md5","comment":"Test automatic default to md5 even if sha1 available","startLine":981,"endLine":990,"calleeNames":["items","_set_allowed_viable_default_hashes","set_hash_format","_get_hash_object"]},"acm000006150jsd":{"type":"ControlElement","id":"acm000006150jsd","name":"test_automatic_default_to_sha256","comment":"Test automatic default to sha256 if other algorithms available but throw","startLine":992,"endLine":1001,"calleeNames":["items","_set_allowed_viable_default_hashes","set_hash_format","_get_hash_object"]},"acm000006151jsd":{"type":"ControlElement","id":"acm000006151jsd","name":"test_automatic_default_to_sha1","comment":"Test automatic default to sha1 if md5 is missing from hashlib entirely","startLine":1003,"endLine":1012,"calleeNames":["items","_set_allowed_viable_default_hashes","set_hash_format","_get_hash_object"]},"acm000006152jsd":{"type":"ControlElement","id":"acm000006152jsd","name":"test_no_available_algorithms","comment":"expect exceptions on no available algorithms or when all algorithms throw","startLine":1014,"endLine":1018,"calleeNames":["assertRaises"]},"acm000006153jsd":{"type":"ControlElement","id":"acm000006153jsd","name":"test_bad_algorithm_set_attempt","comment":"expect exceptions on user setting an unsupported algorithm selections, either by host or by SCons\nnonexistant hash algorithm, not supported by SCons\nmd5 is default-allowed, but in this case throws when we attempt to use it\nuser attempts to use an algorithm that isn't supported by their current system but is supported by SCons\nuser attempts to use an algorithm that is supported by their current system but isn't supported by SCons","startLine":1020,"endLine":1037,"calleeNames":["_set_allowed_viable_default_hashes","assertRaises"]},"acm000006154jsd":{"type":"ControlElement","id":"acm000006154jsd","name":"tearDown","comment":"Return SCons back to the normal global state for the hashing functions.","startLine":1039,"endLine":1042,"calleeNames":["_set_allowed_viable_default_hashes","set_hash_format"]},"acm000006155jsd":{"type":"ClassUnit","id"