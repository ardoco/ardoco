nv"]},"acm000002226jsd":{"type":"ControlElement","id":"acm000002226jsd","name":"generate","comment":"Add Builders and construction variables for ifort to an Environment.\nifort supports Fortran 90 and Fortran 95\nAdditionally, ifort recognizes more file extensions.","startLine":38,"endLine":76,"calleeNames":["FortranScan","add_scanner","append","add_all_to_env","CLVar","replace"]},"acm000002227jsd":{"type":"ControlElement","id":"acm000002227jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":79,"endLine":80,"calleeNames":["Detect"]},"acm000002228jsd":{"type":"CodeCompilationUnit","id":"acm000002228jsd","name":"ifort","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool-specific initialization for newer versions of the Intel Fortran Compiler for Linux/Windows (and possibly Mac OS X). There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.","parentId":"acm000002768jsd","content":["acm000002226jsd","acm000002227jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Defaults","SCons.Scanner.Fortran.FortranScan","FortranCommon.add_all_to_env"]},"acm000002229jsd":{"type":"ControlElement","id":"acm000002229jsd","name":"generate","comment":"Add Builders and construction variables for ilink to an Environment.","startLine":36,"endLine":46,"calleeNames":["createProgBuilder","CLVar"]},"acm000002230jsd":{"type":"ControlElement","id":"acm000002230jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":48,"endLine":49,"calleeNames":["Detect"]},"acm000002231jsd":{"type":"CodeCompilationUnit","id":"acm000002231jsd","name":"ilink","comment":"SCons.Tool.ilink Tool-specific initialization for the OS/2 ilink linker. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000002768jsd","content":["acm000002229jsd","acm000002230jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Defaults","SCons.Tool","SCons.Util"]},"acm000002232jsd":{"type":"ControlElement","id":"acm000002232jsd","name":"generate","comment":"Add Builders and construction variables for Borland ilink to an Environment.","startLine":36,"endLine":48,"calleeNames":["createSharedLibBuilder","createProgBuilder","CLVar"]},"acm000002233jsd":{"type":"ControlElement","id":"acm000002233jsd","name":"exists","comment":"Uses bcc32 to do linking as it generally knows where the standard\nLIBS are and set up the linking correctly\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":51,"endLine":54,"calleeNames":["findIt"]},"acm000002234jsd":{"type":"CodeCompilationUnit","id":"acm000002234jsd","name":"ilink32","comment":"SCons.Tool.ilink32 XXX\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000002768jsd","content":["acm000002232jsd","acm000002233jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Tool","SCons.Tool.bcc32","SCons.Util"]},"acm000002235jsd":{"type":"ClassUnit","id":"acm000002235jsd","name":"CopytreeError","comment":"","compilationUnitId":"acm000002255jsd","parentDatatypeId":null,"startLine":49,"endLine":50,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002236jsd":{"type":"ControlElement","id":"acm000002236jsd","name":"__init__","comment":"","startLine":340,"endLine":342,"calleeNames":["arg2nodes"]},"acm000002237jsd":{"type":"ControlElement","id":"acm000002237jsd","name":"Entry","comment":"","startLine":344,"endLine":346,"calleeNames":["make_path_relative","Entry"]},"acm000002238jsd":{"type":"ControlElement","id":"acm000002238jsd","name":"Dir","comment":"","startLine":348,"endLine":350,"calleeNames":["make_path_relative","Dir"]},"acm000002239jsd":{"type":"ClassUnit","id":"acm000002239jsd","name":"DESTDIR_factory","comment":"A node factory, where all files will be relative to the dir supplied in the constructor.","compilationUnitId":"acm000002255jsd","parentDatatypeId":null,"startLine":336,"endLine":350,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002236jsd","acm000002237jsd","acm000002238jsd"]},"acm000002240jsd":{"type":"ControlElement","id":"acm000002240jsd","name":"scons_copytree","comment":"Recursively copy a directory tree, SCons version. This is a modified copy of the Python 3.7 shutil.copytree function. SCons update: dirs_exist_ok dictates whether to raise an exception in case dst or any missing parent directory already exists. Implementation depends on os.makedirs having a similar flag, which it has since Python 3.2. This version also raises an SCons-defined exception rather than the one defined locally to shtuil. This version uses a change from Python 3.8. TODO: we can remove this forked copy once the minimum Py version is 3.8. If exception(s) occur, an Error is raised with a list of reasons. If the optional symlinks flag is true, symbolic links in the source tree result in symbolic links in the destination tree; if it is false, the contents of the files pointed to by symbolic links are copied. If the file pointed by the symlink doesn't exist, an exception will be added in the list of errors raised in an Error exception at the end of the copy process. You can set the optional ignore_dangling_symlinks flag to true if you want to silence this exception. Notice that this has no effect on platforms that don't support os.symlink. The optional ignore argument is a callable. If given, it is called with the `src` parameter, which is the directory being visited by copytree(), and `names` which is the list of `src` contents, as returned by os.listdir(): callable(src, names) -> ignored_names Since copytree() is called recursively, the callable will be called once for each directory that is copied. It returns a list of names relative to the `src` directory that should not be copied. The optional copy_function argument is a callable that will be used to copy each file. It will be called with the source path and the destination path as arguments. By default, copy2() is used, but any function that supports the same signature (like copy()) can be used.","startLine":53,"endLine":153,"calleeNames":["listdir","ignore","set","makedirs","join","islink","readlink","symlink","copystat","exists","isdir","scons_copytree","copy_function","extend","append","str","getattr","CopytreeError"]},"acm000002241jsd":{"type":"ControlElement","id":"acm000002241jsd","name":"copyFunc","comment":"Install a source file or directory into a destination by copying. Mode/permissions bits will be copied as well, except that the target will be made writable. Returns: POSIX-style error code - 0 for success, non-zero for fail\n\nFunctions doing the actual work of the InstallVersionedLib Builder.\n","startLine":158,"endLine":181,"calleeNames":["isdir","exists","UserError","str","split","makedirs","scons_copytree","copy2","stat","chmod","S_IMODE"]},"acm000002242jsd":{"type":"ControlElement","id":"acm000002242jsd","name":"copyFuncVersionedLib","comment":"Install a versioned library into a destination by copying. Any required symbolic links for other library names are created. Mode/permissions bits will be copied as well, except that the target will be made writable. Returns: POSIX-style error code - 0 for success, non-zero for fail\nremove the link if it is already there","startLine":186,"endLine":210,"calleeNames":["isdir","UserError","str","remove","copy2","stat","chmod","S_IMODE","installShlibLinks"]},"acm000002243jsd":{"type":"ControlElement","id":"acm000002243jsd","name":"listShlibLinksToInstall","comment":"","startLine":212,"endLine":226,"calleeNames":["arg2nodes","File","get_dir","getattr","basename","get_path","append"]},"acm000002244jsd":{"type":"ControlElement","id":"acm000002244jsd","name":"installShlibLinks","comment":"If we are installing a versioned shared library create the required links.","startLine":228,"endLine":236,"calleeNames":["listShlibLinksToInstall","print","CreateLibSymlinks"]},"acm000002245jsd":{"type":"ControlElement","id":"acm000002245jsd","name":"installFunc","comment":"Install a source file into a target. Uses the function specified in the INSTALL construction variable. Returns: POSIX-style error code - 0 for success, non-zero for fail","startLine":238,"endLine":261,"calleeNames":["UserError","len","list","map","zip","install","get_path"]},"acm000002246jsd":{"type":"ControlElement","id":"acm000002246jsd","name":"installFuncVersionedLib","comment":"Install a versioned library into a target. Uses the function specified in the INSTALL construction variable. Returns: POSIX-style error code - 0 for success, non-zero for fail","startLine":263,"endLine":292,"calleeNames":["UserError","len","list","map","zip","hasattr","join","get_dir","get_path","install"]},"acm000002247jsd":{"type":"ControlElement","id":"acm000002247jsd","name":"stringFunc","comment":"","startLine":294,"endLine":304,"calleeNames":["get","subst_target_source","str","isdir"]},"acm000002248jsd":{"type":"ControlElement","id":"acm000002248jsd","name":"add_targets_to_INSTALLED_FILES","comment":"An emitter that adds all target files to the list stored in the _INSTALLED_FILES global variable. This way all installed files of one scons call will be collected.","startLine":309,"endLine":318,"calleeNames":["extend"]},"acm000002249jsd":{"type":"ControlElement","id":"acm000002249jsd","name":"add_versioned_targets_to_INSTALLED_FILES","comment":"An emitter that adds all target files to the list stored in the _INSTALLED_FILES global variable. This way all installed files of one scons call will be collected.","startLine":320,"endLine":334,"calleeNames":["extend","print","listShlibLinksToInstall","EmitLibSymlinks"]},"acm000002250jsd":{"type":"ControlElement","id":"acm000002250jsd","name":"InstallBuilderWrapper","comment":"","startLine":361,"endLine":388,"calleeNames":["UserError","GetOption","DESTDIR_factory","arg2nodes","str","Entry","extend","BaseInstallBuilder"]},"acm000002251jsd":{"type":"ControlElement","id":"acm000002251jsd","name":"InstallAsBuilderWrapper","comment":"","startLine":391,"endLine":395,"calleeNames":["map","extend","BaseInstallBuilder"]},"acm000002252jsd":{"type":"ControlElement","id":"acm000002252jsd","name":"InstallVersionedBuilderWrapper","comment":"","startLine":400,"endLine":427,"calleeNames":["UserError","GetOption","DESTDIR_factory","arg2nodes","str","Entry","extend","BaseVersionedInstallBuilder"]},"acm000002253jsd":{"type":"ControlElement","id":"acm000002253jsd","name":"generate","comment":"","startLine":432,"endLine":501,"calleeNames":["AddOption","GetOption","DESTDIR_factory","Builder","ScannerBase"]},"acm000002254jsd":{"type":"ControlElement","id":"acm000002254jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":503,"endLine":504,"calleeNames":[]},"acm000002255jsd":{"type":"CodeCompilationUnit","id":"acm000002255jsd","name":"install","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool-specific initialization for the install tool. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.\nWe keep track of *all* installed files.","parentId":"acm000002768jsd","content":["acm000002235jsd","acm000002239jsd","acm000002240jsd","acm000002241jsd","acm000002242jsd","acm000002243jsd","acm000002244jsd","acm000002245jsd","acm000002246jsd","acm000002247jsd","acm000002248jsd","acm000002249jsd","acm000002250jsd","acm000002251jsd","acm000002252jsd","acm000002253jsd","acm000002254jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","stat","shutil.copy2","shutil.copystat","SCons.Action","SCons.Tool","SCons.Util","SCons.Subst.SUBST_RAW","SCons.Tool.linkCommon.StringizeLibSymlinks","SCons.Tool.linkCommon.CreateLibSymlinks","SCons.Tool.linkCommon.EmitLibSymlinks","SCons.Script","SCons.Script.AddOption","SCons.Script.GetOption"]},"acm000002256jsd":{"type":"ClassUnit","id":"acm000002256jsd","name":"IntelCError","comment":"","compilationUnitId":"acm000002268jsd","parentDatatypeId":null,"startLine":56,"endLine":57,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002257jsd":{"type":"ClassUnit","id":"acm000002257jsd","name":"MissingRegistryError","comment":"missing registry entry","compilationUnitId":"acm000002268jsd","parentDatatypeId":null,"startLine":58,"endLine":59,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002258jsd":{"type":"ClassUnit","id":"acm000002258jsd","name":"MissingDirError","comment":"dir not found","compilationUnitId":"acm000002268jsd","parentDatatypeId":null,"startLine":60,"endLine":61,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002259jsd":{"type":"ClassUnit","id":"acm000002259jsd","name":"NoRegistryModuleError","comment":"can't read registry at all","compilationUnitId":"acm000002268jsd","parentDatatypeId":null,"startLine":62,"endLine":63,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000002260jsd":{"type":"ControlElement","id":"acm000002260jsd","name":"linux_ver_normalize","comment":"Normalize a Linux compiler version number. Intel changed from \"80\" to \"9.0\" in 2005, so we assume if the number is greater than 60 it's an old-style number and otherwise new-style. Always returns an old-style float like 80 or 90 for compatibility with Windows. Shades of Y2K!\nCheck for version number like 9.1.026: return 91.026\nXXX needs to be updated for 2011+ versions (like 2011.11.344 which is compiler v12.1.5)","startLine":65,"endLine":83,"calleeNames":["match","groups","float"]},"acm000002261jsd":{"type":"ControlElement","id":"acm000002261jsd","name":"check_abi","comment":"Check for valid ABI (application binary interface) name, and map into canonical one","startLine":85,"endLine":114,"calleeNames":["lower","UserError","list","keys"]},"acm000002262jsd":{"type":"ControlElement","id":"acm000002262jsd","name":"get_version_from_list","comment":"See if we can match v (string) in vlist (list of strings) Linux has to match in a fuzzy way.\nSimple case, just find it in the list\nFuzzy match: normalize version number first, but still return\noriginal non-normalized form.\nNot found","startLine":116,"endLine":131,"calleeNames":["fabs","linux_ver_normalize"]},"acm000002263jsd":{"type":"ControlElement","id":"acm000002263jsd","name":"get_intel_registry_value","comment":"Return a value from the Intel compiler registry tree. (Windows only)\nOpen the key:\nFor version 13 and later, check UUID subkeys for valuename\nor v.encode('iso-8859-1', 'replace') to remove unicode?\nor v.encode('iso-8859-1', 'replace') to remove unicode?\nGet the value:\nor v.encode('iso-8859-1', 'replace') to remove unicode?","startLine":133,"endLine":186,"calleeNames":["upper","RegOpenKeyEx","RegQueryValueEx","MissingRegistryError"]},"acm000002264jsd":{"type":"ControlElement","id":"acm000002264jsd","name":"get_all_compiler_versions","comment":"Returns a sorted list of strings, like \"70\" or \"80\" or \"9.0\" with most recent compiler version first.","startLine":189,"endLine":294,"calleeNames":["RegOpenKeyEx","RegEnumKey","get_intel_registry_value","exists","append","print","str","glob","search","group","int","split","sorted","unique"]},"acm000002265jsd":{"type":"ControlElement","id":"acm000002265jsd","name":"get_intel_compiler_top","comment":"Return the main path to the top-level dir of the Intel compiler, using the given version. The compiler will be in <top>/bin/icl.exe (icc on linux), the include dir is <top>/include, etc.\nfor v11 and greater\npre-11, icl was in Bin. 11 and later, it's in Bin/<abi> apparently.\nfirst dir is new (>=9.0) style, second is old (8.0) style.\n'e' stands for 'em64t', aka x86_64 aka amd64\ntypically /opt/intel/Compiler/11.1/064 (then bin/intel64/icc)\nfind highest sub-version number by reverse sorting and picking first existing one.\nThe 2011 (compiler v12) dirs are inconsistent, so just redo the search from\nget_all_compiler_versions and look for a match (search the newest form first)\nTypical dir here is /opt/intel/composer_xe_2011_sp1.11.344\nThe _sp1 is useless, the installers are named 2011.9.x, 2011.10.x, 2011.11.x\nTypical dir here is /opt/intel/composerxe-2011.4.184\nThe 2016 (compiler v16) dirs are inconsistent from previous.\nprint \"INTELC: top=\",top","startLine":296,"endLine":384,"calleeNames":["NoRegistryModuleError","get_intel_registry_value","exists","join","MissingDirError","glob","sort","reverse","search","group","find_in_2016style_dir","find_in_2011style_dir","find_in_2010style_dir","find_in_2008style_dir"]},"acm000002266jsd":{"type":"ControlElement","id":"acm000002266jsd","name":"generate","comment":"can't handle this platform\nif version is unspecified, use latest","startLine":387,"endLine":589,"calleeNames":["generate","get_all_compiler_versions","get_version_from_list","UserError","join","check_abi","uname","get_intel_compiler_top","Detect","enableWarningClass","warn","str","exists","print","repr","linux_ver_normalize","system","items","PrependENVPath","get_intel_registry_value","replace","split","get","RegOpenKeyEx","RegQueryValueEx","find"]},"acm000002267jsd":{"type":"ControlElement","id":"acm000002267jsd","name":"exists","comment":"can't handle this platform","startLine":591,"endLine":609,"calleeNames":["get_all_compiler_versions","len","Detect"]},"acm000002268jsd":{"type":"CodeCompilationUnit","id":"acm000002268jsd","name":"intelc","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool-specific initialization for the Intel C/C++ compiler. Supports Linux and Windows compilers, v7 and up. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.","parentId":"acm000002768jsd","content":["acm000002256jsd","acm000002257jsd","acm000002258jsd","acm000002259jsd","acm000002260jsd","acm000002261jsd","acm000002262jsd","acm000002263jsd","acm000002264jsd","acm000002265jsd","acm000002266jsd","acm000002267jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["glob","math","os.path","re","sys","SCons.Util","SCons.Warnings"]},"acm000002269jsd":{"type":"ControlElement","id":"acm000002269jsd","name":"generate","comment":"Add Builders and construction variables for ipkg to an Environment.","startLine":42,"endLine":63,"calleeNames":["Builder","WhereIs","popen","read","strip","CLVar"]},"acm000002270jsd":{"type":"ControlElement","id":"acm000002270jsd","name":"exists","comment":"Can we find the tool\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":65,"endLine":69,"calleeNames":["Detect"]},"acm000002271jsd":{"type":"CodeCompilationUnit","id":"acm000002271jsd","name":"ipkg","comment":"SCons.Tool.ipkg Tool-specific initialization for ipkg. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method. The ipkg tool calls the ipkg-build. Its only argument should be the packages fake_root.\n\n__COPYRIGHT__\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n","parentId":"acm000002768jsd","content":["acm000002269jsd","acm000002270jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","SCons.Builder"]},"acm000002272jsd":{"type":"ControlElement","id":"acm000002272jsd","name":"jarSources","comment":"Only include sources that are not a manifest file.","startLine":44,"endLine":74,"calleeNames":["subst","Dir","get_text_contents","startswith","Literal","get_path","append"]},"acm000002273jsd":{"type":"ControlElement","id":"acm000002273jsd","name":"jarManifest","comment":"Look in sources for a manifest file, if any.","startLine":76,"endLine":82,"calleeNames":["get_text_contents","startswith"]},"acm000002274jsd":{"type":"ControlElement","id":"acm000002274jsd","name":"jarFlags","comment":"If we have a manifest, make sure that the 'm' flag is specified.","startLine":84,"endLine":94,"calleeNames":["subst","get_text_contents","startswith"]},"acm000002275jsd":{"type":"ControlElement","id":"acm000002275jsd","name":"Jar","comment":"The Jar Builder. This is a pseudo-Builder wrapper around the separate jar builders depending on whether the sources are a file list or a directory.\nTODO: W1113: Keyword argument before variable positional arguments list in the definition of Jar function\nTODO: W0102: Dangerous default value [] as argument\njar target should not be a list so assume they passed\nno target and want implicit target to be made and the arg\nwas actaully the list of sources\nmutiple targets passed so build each target the same from the\nsame source\nTODO Maybe this should only be done once, and the result copied\nfor each target since it should result in the same?\nthey passed no target so make a target implicitly\nmake target from the first source file\nTODO: W0702: No exception type(s) specified\nsomething strange is happening but attempt anyways\nmake lists out of our target and sources\nsetup for checking through all the sources and handle accordingly","startLine":96,"endLine":214,"calleeNames":["is_List","warn","Jar","splitext","str","subst","basename","Dir","_my_normcase","endswith","JavaClassFile","File","JavaClassDir","flatten","isinstance","extend","file_to_class","dir_to_class","JarFile"]},"acm000002276jsd":{"type":"ControlElement","id":"acm000002276jsd","name":"generate","comment":"Add Builders and construction variables for jar to an Environment.\nEnsure that we have a proper path for jar","startLine":216,"endLine":241,"calleeNames":["CreateJarBuilder","CreateJavaFileBuilder","CreateJavaClassFileBuilder","CreateJavaClassDirBuilder","AddMethod","get_java_install_dirs","find_program_path","dirname","AppendENVPath","CLVar"]},"acm000002277jsd":{"type":"ControlElement","id":"acm000002277jsd","name":"exists","comment":"As reported by Jan Nijtmans in issue #2730, the simple\nreturn env.Detect('jar')\ndoesn't always work during initialization. For now, we\nstop trying to detect an executable (analogous to the\njavac Builder).\nTODO: Come up with a proper detect() routine...and enable it.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":243,"endLine":250,"calleeNames":[]},"acm000002278jsd":{"type":"CodeCompilationUnit","id":"acm000002278jsd","name":"jar","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool-specific initialization for jar. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.","parentId":"acm000002768jsd","content":["acm000002272jsd","acm000002273jsd","acm000002274jsd","acm000002275jsd","acm000002276jsd","acm000002277jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","typing.List","SCons.Node","SCons.Node.FS","SCons.Subst","SCons.Tool","SCons.Util","SCons.Warnings","SCons.Node.FS._my_normcase","SCons.Tool.JavaCommon.get_java_install_dirs"]},"acm000002279jsd":{"type":"ControlElement","id":"acm000002279jsd","name":"__init__","comment":"","startLine":140,"endLine":143,"calleeNames":[]},"acm000002280jsd":{"type":"ControlElement","id":"acm000002280jsd","name":"__call__","comment":"","startLine":145,"endLine":159,"calleeNames":["is_List","flatten","join","map"]},"acm000002281jsd":{"type":"ClassUnit","id":"acm000002281jsd","name":"pathopt","comment":"Callable object for generating javac-style path options from a construction variable (e.g. -classpath, -sourcepath).","compilationUnitId":"acm000002287jsd","parentDatatypeId":null,"startLine":135,"endLine":159,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000002279jsd","acm000002280jsd"]},"acm000002282jsd":{"type":"ControlElement","id":"acm000002282jsd","name":"classname","comment":"Turn a string (path name) into a Java class name.","startLine":41,"endLine":43,"calleeNames":["normpath","replace"]},"acm000002283jsd":{"type":"ControlElement","id":"acm000002283jsd","name":"emit_java_classes","comment":"Create and return lists of source java files and their corresponding target class files.","startLine":45,"endLine":126,"calleeNames":["get","must_be_same","rentry","disambiguate","isinstance","rdir","UserError","_my_normcase","append","OrderedDict","sorted","endswith","Dir","File","walk","get_abspath","find_java_files","extend","list","keys","is_derived","parse_java_file","rfile","classname","len","set_specific_source"]},"acm000002284jsd":{"type":"ControlElement","id":"acm000002284jsd","name":"Java","comment":"A pseudo-Builder wrapper around the separate JavaClass{File,Dir} Builders.\nPad the target list with repetitions of the last element in the\nlist so we have a target for every source element.","startLine":161,"endLine":195,"calleeNames":["is_List","len","subst","zip","isinstance","isfile","isdir","extend","b"]},"acm000002285jsd":{"type":"ControlElement","id":"acm000002285jsd","name":"generate","comment":"Add Builders and construction variables for javac to an Environment.","startLine":197,"endLine":239,"calleeNames":["CreateJavaFileBuilder","CreateJavaClassFileBuilder","CreateJavaClassDirBuilder","add_emitter","subst","AddMethod","get","get_java_install_dirs","find_program_path","dirname","AppendENVPath","SetDefault","CLVar","get_java_include_paths"]},"acm000002286jsd":{"type":"ControlElement","id":"acm000002286jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":241,"endLine":242,"calleeNames":[]},"acm000002287jsd":{"type":"CodeCompilationUnit","id":"acm000002287jsd","name":"javac","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool-specific initialization for javac. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.","parentId":"acm000002768jsd","content":["acm000002281jsd","acm000002282jsd","acm000002283jsd","acm000002284jsd","acm000002285jsd","acm000002286jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","os.path","collections.OrderedDict","SCons.Action","SCons.Builder","SCons.Node.FS._my_normcase","SCons.Tool.JavaCommon.parse_java_file","SCons.Tool.JavaCommon.get_java_install_dirs","SCons.Tool.JavaCommon.get_java_include_paths","SCons.Util"]},"acm000002288jsd":{"type":"ControlElement","id":"acm000002288jsd","name":"get_java_install_dirs","comment":"Find possible java jdk installation directories. Returns a list for use as `default_paths` when looking up actual java binaries with :meth:`SCons.Tool.find_program_path`. The paths are sorted by version, latest first. Args: platform: selector for search algorithm. version: if not None, restrict the search to this version. Returns: list of default paths for jdk.\nGenerates a sort key for win32 jdk versions. We'll have gotten a path like ...something/*jdk*/bin because that is the pattern we glob for. To generate the sort key, extracts the next-to-last component, then trims it further if it had a complex name, like 'java-1.8.0-openjdk-1.8.0.312-1', to try and put it on a common footing with the more common style, which looks like 'jdk-11.0.2'. This is certainly fragile, and if someone has a 9.0 it won't sort right since this will still be alphabetic, BUT 9.0 was not an LTS release and is 30 mos out of support as this note is written so just assume it will be okay.\nother platforms, do nothing for now: we expect the standard\npaths to be enough to find a jdk (e.g. use alternatives system)","startLine":494,"endLine":540,"calleeNames":["glob","Path","startswith","rsplit","sorted"]},"acm000002289jsd":{"type":"ControlElement","id":"acm000002289jsd","name":"get_java_include_paths","comment":"Find java include paths for JNI building. Cannot be called in isolation - `javac` refers to an already detected compiler. Normally would would call :func:`get_java_install_dirs` first and then do lookups on the paths it returns before calling us. Args: env: construction environment, used to extract platform. javac: path to detected javac. version: if not None, restrict the search to this version. Returns: list of include directory paths.\non Windows, we have a path to the actual javac, so look locally\nfor the others, we probably found something which isn't in the JDK dir,\nso use the predefined patterns to glob for an include directory.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":543,"endLine":588,"calleeNames":["dirname","normpath","join","sorted","glob","extend"]},"acm000002290jsd":{"type":"CodeCompilationUnit","id":"acm000002290jsd","name":"JavaCommon","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nCommon routines for processing Java.","parentId":"acm000002768jsd","content":["acm000002288jsd","acm000002289jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","re","glob","pathlib.Path","typing.List","SCons.Util"]},"acm000002291jsd":{"type":"ControlElement","id":"acm000002291jsd","name":"test_bare_bones","comment":"Test a bare-bones class","startLine":44,"endLine":65,"calleeNames":["parse_java","join"]},"acm000002292jsd":{"type":"ControlElement","id":"acm000002292jsd","name":"test_file_parser","comment":"Test the file parser","startLine":68,"endLine":91,"calleeNames":["open","print","parse_java_file","exists","remove","join"]},"acm000002293jsd":{"type":"ControlElement","id":"acm000002293jsd","name":"test_dollar_sign","comment":"Test class names with $ in them","startLine":94,"endLine":104,"calleeNames":["parse_java"]},"acm000002294jsd":{"type":"ControlElement","id":"acm000002294jsd","name":"test_inner_classes","comment":"Test parsing various forms of inner classes","startLine":108,"endLine":227,"calleeNames":["parse_java"]},"acm000002295jsd":{"type":"ControlElement","id":"acm000002295jsd","name":"test_comments","comment":"Test a class with comments","startLine":231,"endLine":273,"calleeNames":["parse_java","join"]},"acm000002296jsd":{"type":"ControlElement","id":"acm000002296jsd","name":"test_arrays","comment":"Test arrays of class instances","startLine":276,"endLine":292,"calleeNames":["parse_java"]},"acm000002297jsd":{"type":"ControlElement","id":"acm000002297jsd","name":"test_backslash","comment":"Test backslash handling","startLine":296,"endLine":311,"calleeNames":["parse_java"]},"acm000002298jsd":{"type":"ControlElement","id":"acm000002298jsd","name":"test_enum","comment":"Test the Java 1.5 enum keyword","startLine":314,"endLine":324,"calleeNames":["parse_java"]},"acm000002299jsd":{"type":"ControlElement","id":"acm000002299jsd","name":"test_anon_classes","comment":"Test anonymous classes","startLine":327,"endLine":348,"calleeNames":["parse_java"]},"acm000002300jsd":{"type":"ControlElement","id":"acm000002300jsd","name":"test_closing_bracket","comment":"Test finding a closing bracket instead of an anonymous class","startLine":351,"endLine":366,"calleeNames":["parse_java"]},"acm000002301jsd":{"type":"ControlElement","id":"acm000002301jsd","name":"test_dot_class_attributes","comment":"Test handling \".class\" attributes","startLine":369,"endLine":400,"calleeNames":["parse_java"]},"acm000002302jsd":{"type":"ControlElement","id":"acm000002302jsd","name":"test_anonymous_classes_with_parentheses","comment":"Test finding anonymous classes marked by parentheses","startLine":402,"endLine":432,"calleeNames":["parse_java"]},"acm000002303jsd":{"type":"ControlElement","id":"acm000002303jsd","name":"test_nested_anonymous_inner_classes","comment":"Test finding nested anonymous inner classes","startLine":436,"endLine":483,"calleeNames":["parse_java"]},"acm000002304jsd":{"type":"ControlElement","id":"acm000002304jsd","name":"test_lambda_after_new","comment":"Test lamdas after new","startLine":485,"endLine":520,"calleeNames":["parse_java"]},"acm0000