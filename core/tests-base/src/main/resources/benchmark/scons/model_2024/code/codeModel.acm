ckage x, you expect to get x/__init__.py as a dependency. The relative path tests that reach into ancestor directories do have some ambiguity in whether to depend upon __init__.py in those referenced ancestor directories. Python only allows these kinds of relative imports if the file is part of a package, in which case those ancestor directories' __init__.py files have already been imported.","parentId":"acm000005623jsd","content":["acm000005459jsd","acm000005461jsd","acm000005463jsd","acm000005465jsd","acm000005467jsd","acm000005469jsd","acm000005471jsd","acm000005473jsd","acm000005475jsd","acm000005477jsd","acm000005479jsd","acm000005481jsd","acm000005483jsd","acm000005485jsd","acm000005487jsd","acm000005489jsd","acm000005491jsd","acm000005493jsd","acm000005494jsd"],"pathElements":["Scanner"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.compat","collections","os","unittest","TestCmd","SCons.Node.FS","SCons.Scanner.Python"]},"acm000005496jsd":{"type":"ControlElement","id":"acm000005496jsd","name":"no_tlb","comment":"Filter out .tlb files as they are binary and shouldn't be scanned.\nprint(\"Nodes:%s\"%[str(n) for n in nodes])","startLine":31,"endLine":35,"calleeNames":["str"]},"acm000005497jsd":{"type":"ControlElement","id":"acm000005497jsd","name":"RCScan","comment":"Return a prototype Scanner instance for scanning RC source files","startLine":38,"endLine":51,"calleeNames":["ClassicCPP"]},"acm000005498jsd":{"type":"CodeCompilationUnit","id":"acm000005498jsd","name":"RC","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe f