d string here that is\nactually longer than the substituted one. This is to ensure\nthat the TempFileMunge class internally really takes the\nlength of the expanded string into account.","startLine":209,"endLine":242,"calleeNames":["TempFileMunge","SubstitutionEnvironment","subst","len","t","open","read","join"]},"acm000005025jsd":{"type":"ControlElement","id":"acm000005025jsd","name":"test_TEMPFILEARGESCFUNC","comment":"Test a custom TEMPFILEARGESCFUNC","startLine":244,"endLine":272,"calleeNames":["str","replace","TempFileMunge","SubstitutionEnvironment","t","open","read"]},"acm000005026jsd":{"type":"ControlElement","id":"acm000005026jsd","name":"test_tempfilecreation_once","comment":"Init class with cmd, such that the fully expanded string reads \"a test command line\". Note, how we're using a command string here that is actually longer than the substituted one. This is to ensure that the TempFileMunge class internally really takes the length of the expanded string into account.","startLine":274,"endLine":308,"calleeNames":["TempFileMunge","SubstitutionEnvironment","subst","len","Attrs","Node","t"]},"acm000005027jsd":{"type":"ClassUnit","id":"acm000005027jsd","name":"TempFileMungeTestCase","comment":"","compilationUnitId":"acm000005030jsd","parentDatatypeId":null,"startLine":172,"endLine":308,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005023jsd","acm000005024jsd","acm000005025jsd","acm000005026jsd"]},"acm000005028jsd":{"type":"ControlElement","id":"acm000005028jsd","name":"test_posix_escape","comment":"Check that paths with parens are escaped properly.\npylint: disable=import-outside-toplevel","startLine":313,"endLine":324,"calleeNames":["escape"]},"acm000005029jsd":{"type":"ClassUnit","id":"acm000005029jsd","name":"PlatformEscapeTestCase","comment":"","compilationUnitId":"acm000005030jsd","parentDatatypeId":null,"startLine":312,"endLine":324,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeRe