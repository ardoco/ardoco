,"acm000002340jsd":{"type":"ControlElement","id":"acm000002340jsd","name":"generate","comment":"","startLine":61,"endLine":145,"calleeNames":["createObjBuilders","add_action","add_emitter","Detect","addDPATHToEnv","CLVar","format","Builder"]},"acm000002341jsd":{"type":"ControlElement","id":"acm000002341jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":148,"endLine":149,"calleeNames":["Detect"]},"acm000002342jsd":{"type":"CodeCompilationUnit","id":"acm000002342jsd","name":"ldc","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSCons.Tool.ldc Tool-specific initialization for the LDC compiler. (https://github.com/ldc-developers/ldc) Developed by Russel Winder (russel@winder.org.uk) 2012-05-09 onwards Compiler variables: DC - The name of the D compiler to use. Defaults to ldc2. DPATH - List of paths to search for import modules. DVERSIONS - List of version tags to enable when compiling. DDEBUG - List of debug tags to enable when compiling. Linker related variables: LIBS - List of library files to link in. DLINK - Name of the linker to use. Defaults to ldc2. DLINKFLAGS - List of linker flags. Lib tool variables: DLIB - Name of the lib tool to use. Defaults to lib. DLIBFLAGS - List of flags to pass to the lib tool. LIBS - Same as for the linker. (libraries to pull into the .lib)","parentId":"acm000002768jsd","content":["acm000002340jsd","acm000002341jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Action","SCons.Builder","SCons.Defaults","SCons.Scanner.D","SCons.Tool","SCons.Tool.DCommon"]},"acm000002343jsd":{"type":"ControlElement","id":"acm000002343jsd","name":"lexEmitter","comment":"Adds extra files generated by lex program to target list.\nIf using Objective-C\nthe extension is \".m\".\nWith --header-file and ----tables-file, the file to write is defined\nby the option argument. Extract this and include in the list of targets.\nNOTE: a filename passed to the command this way is not modified by SCons,\nand so will be interpreted relative to the project top directory at\nexecution time, while the name added to the target list will be\ninterpreted relative to the SConscript directory - a possible mismatch.\n\nThese are GNU flex-only options.\nTODO: recognize --outfile also?","startLine":56,"endLine":95,"calleeNames":["splitext","to_String","subst_list","len","strip","append","subst","Replace","File"]},"acm000002344jsd":{"type":"ControlElement","id":"acm000002344jsd","name":"get_lex_path","comment":"Returns the path to the lex tool, searching several possible names. Only called in the Windows case, so the `default_path` argument to :func:`find_program_path` can be Windows-specific. Args: env: current construction environment append_paths: if set, add the path to the tool to PATH","startLine":98,"endLine":122,"calleeNames":["find_program_path","warn"]},"acm000002345jsd":{"type":"ControlElement","id":"acm000002345jsd","name":"generate","comment":"Add Builders and construction variables for lex to an Environment.\nC\nObjective-C\nC++\nignore the return, all we need is for the path to be added","startLine":125,"endLine":162,"calleeNames":["createCFileBuilders","add_action","add_emitter","get_lex_path","SetDefault","Detect","CLVar"]},"acm000002346jsd":{"type":"ControlElement","id":"acm000002346jsd","name":"exists","comment":"Local Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":165,"endLine":169,"calleeNames":["get_lex_path","Detect"]},"acm000002347jsd":{"type":"CodeCompilationUnit","id":"acm000002347jsd","name":"lex","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTool-specific initialization for lex. This tool should support multiple lex implementations, but is in actuality biased towards GNU Flex. There normally shouldn't be any need to import this module directly. It will usually be imported through the generic SCons.Tool.Tool() selection method.","parentId":"acm000002768jsd","content":["acm000002343jsd","acm000002344jsd","acm000002345jsd","acm000002346jsd"],"pathElements":["Tool"],"extension":"py","language":"PYTHON3","importedModuleNames":["os.path","sys","typing.Optional","SCons.Action","SCons.Tool","SCons.Warnings","SCons.Platform.mingw.MINGW_DEFAULT_PATHS","SCons.Platform.cygwin.CYGWIN_DEFAULT_PATHS","SCons.Platform.win32.CHOCO_DEFAULT_PATH","SCons.Util.CLVar","SCons.Util.to_String"]},"acm000002348jsd":{"type":"ControlElement","id":"acm000002348jsd","name":"generate","comment":"Add Builders and construction variables for gnulink to an Environment.","startLine":43,"endLine":60,"calleeNames":["createProgBuilder","setup_shared_lib_logic","setup_loadable_module_logic","CLVar"]},"acm000002349jsd":{"type":"ControlElement","id":"acm000002349jsd","name":"exists","comment":"This module isn't really a Tool on its own, it's common logic for\nother linkers.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":63,"endLine":66,"calleeNames":[]},"acm000002350jsd":{"type":"CodeCompilationUnit","id":"acm000002350jsd","name":"link","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR I