{"id":"acm000002009jsd","codeItemRepository":{"repository":{"acm000001338jsd":{"type":"ControlElement","id":"acm000001338jsd","name":"__init__","comment":"","startLine":58,"endLine":90,"calleeNames":[]},"acm000001339jsd":{"type":"ControlElement","id":"acm000001339jsd","name":"decode","comment":"Ensure that all string attributes on this object, and the constituent `TrackInfo` objects, are decoded to Unicode.","startLine":95,"endLine":108,"calleeNames":["getattr","isinstance","setattr","decode"]},"acm000001340jsd":{"type":"ClassUnit","id":"acm000001340jsd","name":"AlbumInfo","comment":"Describes a canonical release that may be used to match a release in the library. Consists of these data members: - ``album``: the release title - ``album_id``: MusicBrainz ID; UUID fragment only - ``artist``: name of the release's primary artist - ``artist_id`` - ``tracks``: list of TrackInfo objects making up the release - ``asin``: Amazon ASIN - ``albumtype``: string describing the kind of release - ``va``: boolean: whether the release has \"various artists\" - ``year``: release year - ``month``: release month - ``day``: release day - ``label``: music label responsible for the release - ``mediums``: the number of discs in this release - ``artist_sort``: name of the release's artist for sorting - ``releasegroup_id``: MBID for the album's release group - ``catalognum``: the label's catalog number for the release - ``script``: character set used for metadata - ``language``: human language of the metadata - ``country``: the release country - ``albumstatus``: MusicBrainz release status (Official, etc.) - ``media``: delivery mechanism (Vinyl, etc.) - ``albumdisambig``: MusicBrainz release disambiguation comment - ``artist_credit``: Release-specific artist name The fields up through ``tracks`` are required. The others are optional and may be None.","compilationUnitId":"acm000001348jsd","parentDatatypeId":null,"startLine":27,"endLine":108,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001338jsd","acm000001339jsd"]},"acm000001341jsd":{"type":"ControlElement","id":"acm000001341jsd","name":"__init__","comment":"","startLine":58,"endLine":90,"calleeNames":[]},"acm000001342jsd":{"type":"ControlElement","id":"acm000001342jsd","name":"decode","comment":"Ensure that all string attributes on this object, and the constituent `TrackInfo` objects, are decoded to Unicode.","startLine":95,"endLine":108,"calleeNames":["getattr","isinstance","setattr","decode"]},"acm000001343jsd":{"type":"ClassUnit","id":"acm000001343jsd","name":"TrackInfo","comment":"Describes a canonical track present on a release. Appears as part of an AlbumInfo's ``tracks`` list. Consists of these data members: - ``title``: name of the track - ``track_id``: MusicBrainz ID; UUID fragment only - ``artist``: individual track artist name - ``artist_id`` - ``length``: float: duration of the track in seconds - ``index``: position on the entire release - ``medium``: the disc number this track appears on in the album - ``medium_index``: the track's position on the disc - ``artist_sort``: name of the track artist for sorting - ``disctitle``: name of the individual medium (subtitle) - ``artist_credit``: Recording-specific artist name Only ``title`` and ``track_id`` are required. The rest of the fields may be None. The indices ``index``, ``medium``, and ``medium_index`` are all 1-based.","compilationUnitId":"acm000001348jsd","parentDatatypeId":null,"startLine":110,"endLine":154,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001341jsd","acm000001342jsd"]},"acm000001344jsd":{"type":"ControlElement","id":"acm000001344jsd","name":"_album_for_id","comment":"Get an album corresponding to a MusicBrainz release ID.","startLine":164,"endLine":169,"calleeNames":["album_for_id","log"]},"acm000001345jsd":{"type":"ControlElement","id":"acm000001345jsd","name":"_track_for_id","comment":"Get an item for a recording MBID.","startLine":171,"endLine":176,"calleeNames":["track_for_id","log"]},"acm000001346jsd":{"type":"ControlElement","id":"acm000001346jsd","name":"_album_candidates","comment":"Search for album matches. ``items`` is a list of Item objects that make up the album. ``artist`` and ``album`` are the respective names (strings), which may be derived from the item list or may be entered by the user. ``va_likely`` is a boolean indicating whether the album is likely to be a \"various artists\" release.","startLine":178,"endLine":204,"calleeNames":["extend","match_album","len","log","candidates"]},"acm000001347jsd":{"type":"ControlElement","id":"acm000001347jsd","name":"_item_candidates","comment":"Search for item matches. ``item`` is the Item to be matched. ``artist`` and ``title`` are strings and either reflect the item or are specified by the user.","startLine":206,"endLine":223,"calleeNames":["extend","match_track","log","item_candidates"]},"acm000001348jsd":{"type":"CodeCompilationUnit","id":"acm000001348jsd","name":"hooks","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nGlue between metadata sources and the matching logic.","parentId":"acm000001379jsd","content":["acm000001340jsd","acm000001343jsd","acm000001344jsd","acm000001345jsd","acm000001346jsd","acm000001347jsd"],"pathElements":["autotag"],"extension":"py","language":"PYTHON3","importedModuleNames":["logging","collections.namedtuple","beets.plugins","beets.autotag.mb"]},"acm000001349jsd":{"type":"ControlElement","id":"acm000001349jsd","name":"_string_dist_basic","comment":"Basic edit distance between two strings, ignoring non-alphanumeric characters and case. Comparisons are based on a transliteration/lowering to ASCII characters. Normalized by string length.","startLine":90,"endLine":102,"calleeNames":["unidecode","sub","lower","levenshtein","float","max","len"]},"acm000001350jsd":{"type":"ControlElement","id":"acm000001350jsd","name":"string_dist","comment":"Gives an \"intuitive\" edit distance between two strings. This is an edit distance, normalized by the string length, with a number of tweaks that reflect intuition about text.","startLine":104,"endLine":155,"calleeNames":["lower","endswith","len","sub","_string_dist_basic","max"]},"acm000001351jsd":{"type":"ControlElement","id":"acm000001351jsd","name":"current_metadata","comment":"Returns the most likely artist and album for a set of Items. Each is determined by tag reflected by the plurality of the Items.","startLine":157,"endLine":173,"calleeNames":["getattr","plurality","len"]},"acm000001352jsd":{"type":"ControlElement","id":"acm000001352jsd","name":"assign_items","comment":"Given a list of Items and a list of TrackInfo objects, find the best mapping between them. Returns a mapping from Items to TrackInfo objects, a set of extra Items, and a set of extra TrackInfo objects. These \"extra\" objects occur when there is an unequal number of objects of the two types.\nConstruct the cost matrix.","startLine":175,"endLine":197,"calleeNames":["enumerate","append","track_distance","Munkres","compute","dict","set","keys","values"]},"acm000001353jsd":{"type":"ControlElement","id":"acm000001353jsd","name":"track_distance","comment":"Determines the significance of a track metadata change. Returns a float in [0.0,1.0]. `incl_artist` indicates that a distance component should be included for the track artist (i.e., for various-artist releases).\nDistance and normalization accumulators.","startLine":199,"endLine":248,"calleeNames":["abs","max","min","string_dist","lower","track_distance"]},"acm000001354jsd":{"type":"ControlElement","id":"acm000001354jsd","name":"distance","comment":"Determines how \"significant\" an album metadata change would be. Returns a float in [0.0,1.0]. `album_info` is an AlbumInfo object reflecting the album to be compared. `items` is a sequence of all Item objects that will be matched (order is not important). `mapping` is a dictionary mapping Items to TrackInfo objects; the keys are a subset of `items` and the values are a subset of `album_info.tracks`.","startLine":250,"endLine":297,"calleeNames":["current_metadata","string_dist","iteritems","track_distance","set","values","keys","album_distance"]},"acm000001355jsd":{"type":"ControlElement","id":"acm000001355jsd","name":"match_by_id","comment":"If the items are tagged with a MusicBrainz album ID, returns an AlbumInfo object for the corresponding album. Otherwise, returns None.\nIs there a consensus on the MB album ID?","startLine":299,"endLine":317,"calleeNames":["debug","bool","reduce","_album_for_id"]},"acm000001356jsd":{"type":"ControlElement","id":"acm000001356jsd","name":"_recommendation","comment":"Given a sorted list of AlbumMatch or TrackMatch objects, return a recommendation based on the results' distances. If the recommendation is higher than the configured maximum for certain situations, the recommendation will be downgraded to the configured maximum.\nNo candidates: no recommendation.\nBasic distance thresholding.","startLine":319,"endLine":381,"calleeNames":["as_number","len","isinstance","as_choice","items","abs"]},"acm000001357jsd":{"type":"ControlElement","id":"acm000001357jsd","name":"_add_candidate","comment":"Given a candidate AlbumInfo object, attempt to add the candidate to the output dictionary of AlbumMatch objects. This involves checking the track count, ordering the items, checking for duplicates, and calculating the distance.\nDon't duplicate.\nFind mapping between the items and the track info.\nGet the change distance.","startLine":383,"endLine":404,"calleeNames":["debug","assign_items","distance","AlbumMatch"]},"acm000001358jsd":{"type":"ControlElement","id":"acm000001358jsd","name":"tag_album","comment":"Bundles together the functionality used to infer tags for a set of items comprised by an album. Returns everything relevant: - The current artist. - The current album. - A list of AlbumMatch objects. The candidates are sorted by distance (i.e., best match first). - A recommendation. If search_artist and search_album or search_id are provided, then they are used as search terms in place of the current metadata.\nGet current metadata.\nThe output result (distance, AlbumInfo) tuples (keyed by MB album\nID).","startLine":406,"endLine":473,"calleeNames":["current_metadata","debug","_album_for_id","match_by_id","_add_candidate","_recommendation","values","str","lower","any","_album_candidates","len","sorted","itervalues"]},"acm000001359jsd":{"type":"ControlElement","id":"acm000001359jsd","name":"tag_item","comment":"Attempts to find metadata for a single track. Returns a `(candidates, recommendation)` pair where `candidates` is a list of TrackMatch objects. `search_artist` and `search_title` may be used to override the current metadata for the purposes of the MusicBrainz title; likewise `search_id`.\nHolds candidates found so far: keys are MBIDs; values are\n(distance, TrackInfo) pairs.","startLine":475,"endLine":523,"calleeNames":["debug","_track_for_id","track_distance","TrackMatch","_recommendation","values","_item_candidates","len","sorted","itervalues"]},"acm000001360jsd":{"type":"CodeCompilationUnit","id":"acm000001360jsd","name":"match","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nMatches existing metadata with canonical information to identify releases and tracks.\nDistance parameters.\nText distance weights: proportions on the normalized intuitive edit\ndistance.","parentId":"acm000001379jsd","content":["acm000001349jsd","acm000001350jsd","acm000001351jsd","acm000001352jsd","acm000001353jsd","acm000001354jsd","acm000001355jsd","acm000001356jsd","acm000001357jsd","acm000001358jsd","acm000001359jsd"],"pathElements":["autotag"],"extension":"py","language":"PYTHON3","importedModuleNames":["__future__.division","logging","re","munkres.Munkres","unidecode.unidecode","beets.plugins","beets.config","beets.util.levenshtein","beets.util.plurality","beets.util.enumeration.enum","beets.autotag.hooks"]},"acm000001361jsd":{"type":"ControlElement","id":"acm000001361jsd","name":"__init__","comment":"","startLine":36,"endLine":38,"calleeNames":["super","__init__"]},"acm000001362jsd":{"type":"ControlElement","id":"acm000001362jsd","name":"get_message","comment":"","startLine":40,"endLine":43,"calleeNames":["format","_reasonstr","repr"]},"acm000001363jsd":{"type":"ClassUnit","id":"acm000001363jsd","name":"MusicBrainzAPIError","comment":"An error while talking to MusicBrainz. The `query` field is the parameter to the action and may have any type.","compilationUnitId":"acm000001374jsd","parentDatatypeId":null,"startLine":32,"endLine":43,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001361jsd","acm000001362jsd"]},"acm000001364jsd":{"type":"ControlElement","id":"acm000001364jsd","name":"configure","comment":"Set up the python-musicbrainz-ngs module according to settings from the beets configuration. This should be called at startup.","startLine":56,"endLine":64,"calleeNames":["set_hostname","get","set_rate_limit","as_number"]},"acm000001365jsd":{"type":"ControlElement","id":"acm000001365jsd","name":"_preferred_alias","comment":"Given an list of alias structures for an artist credit, select and return the user's preferred alias alias or None if no matching alias is found.\nOnly consider aliases that have locales set.","startLine":66,"endLine":92,"calleeNames":["as_str_seq"]},"acm000001366jsd":{"type":"ControlElement","id":"acm000001366jsd","name":"_flatten_artist_credit","comment":"Given a list representing an ``artist-credit`` block, flatten the data into a triple of joined artist name strings: canonical, sort, and credit.","startLine":94,"endLine":137,"calleeNames":["isinstance","append","_preferred_alias","get","join"]},"acm000001367jsd":{"type":"ControlElement","id":"acm000001367jsd","name":"track_info","comment":"Translates a MusicBrainz recording result dictionary into a beets ``TrackInfo`` object. Three parameters are optional and are used only for tracks that appear on releases (non-singletons): ``index``, the overall track number; ``medium``, the disc number; ``medium_index``, the track's index on its medium. Each number is a 1-based index.","startLine":139,"endLine":166,"calleeNames":["TrackInfo","get","_flatten_artist_credit","int","decode"]},"acm000001368jsd":{"type":"ControlElement","id":"acm000001368jsd","name":"_set_date_str","comment":"Given a (possibly partial) YYYY-MM-DD string and an AlbumInfo object, set the object's release date fields appropriately. If `original`, then set the original_year, etc., fields.","startLine":168,"endLine":185,"calleeNames":["split","pop","int","setattr"]},"acm000001369jsd":{"type":"ControlElement","id":"acm000001369jsd","name":"album_info","comment":"Takes a MusicBrainz release result dictionary and returns a beets AlbumInfo object containing the interesting data about that release.\nGet artist name using join phrases.\nBasic info.","startLine":187,"endLine":272,"calleeNames":["_flatten_artist_credit","get","track_info","int","append","AlbumInfo","len","join","lower","_set_date_str","decode"]},"acm000001370jsd":{"type":"ControlElement","id":"acm000001370jsd","name":"match_album","comment":"Searches for a single album (\"release\" in MusicBrainz parlance) and returns an iterator over AlbumInfo objects. May raise a MusicBrainzAPIError. The query consists of an artist name, an album name, and, optionally, a number of tracks on the album.\nBuild search criteria.","startLine":274,"endLine":306,"calleeNames":["lower","str","any","itervalues","search_releases","MusicBrainzAPIError","format_exc","album_for_id"]},"acm000001371jsd":{"type":"ControlElement","id":"acm000001371jsd","name":"match_track","comment":"Searches for a single track and returns an iterable of TrackInfo objects. May raise a MusicBrainzAPIError.","startLine":308,"endLine":326,"calleeNames":["lower","any","itervalues","search_recordings","MusicBrainzAPIError","format_exc","track_info"]},"acm000001372jsd":{"type":"ControlElement","id":"acm000001372jsd","name":"album_for_id","comment":"Fetches an album by its MusicBrainz ID and returns an AlbumInfo object or None if the album is not found. May raise a MusicBrainzAPIError.","startLine":328,"endLine":341,"calleeNames":["get_release_by_id","debug","MusicBrainzAPIError","format_exc","album_info"]},"acm000001373jsd":{"type":"ControlElement","id":"acm000001373jsd","name":"track_for_id","comment":"Fetches a track by its MusicBrainz ID. Returns a TrackInfo object or None if no track is found. May raise a MusicBrainzAPIError.","startLine":343,"endLine":355,"calleeNames":["get_recording_by_id","debug","MusicBrainzAPIError","format_exc","track_info"]},"acm000001374jsd":{"type":"CodeCompilationUnit","id":"acm000001374jsd","name":"mb","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nSearches for albums in the MusicBrainz database.","parentId":"acm000001379jsd","content":["acm000001363jsd","acm000001364jsd","acm000001365jsd","acm000001366jsd","acm000001367jsd","acm000001368jsd","acm000001369jsd","acm000001370jsd","acm000001371jsd","acm000001372jsd","acm000001373jsd"],"pathElements":["autotag"],"extension":"py","language":"PYTHON3","importedModuleNames":["logging","musicbrainzngs","traceback","beets.autotag.hooks","beets","beets.util","beets.config"]},"acm000001375jsd":{"type":"ControlElement","id":"acm000001375jsd","name":"albums_in_dir","comment":"Recursively searches the given directory and returns an iterable of (paths, items) where paths is a list of directories and items is a list of Items that is probably an album. Specifically, any folder containing any media files is an album.","startLine":39,"endLine":144,"calleeNames":["sorted_walk","as_str_seq","from_path","join","warn","format","displayable_path","append","ancestry","match","basename","compile","escape","group"]},"acm000001376jsd":{"type":"ControlElement","id":"acm000001376jsd","name":"apply_item_metadata","comment":"Set an item's metadata from its matched TrackInfo object.","startLine":146,"endLine":155,"calleeNames":[]},"acm000001377jsd":{"type":"ControlElement","id":"acm000001377jsd","name":"apply_metadata","comment":"Set the items' metadata to match an AlbumInfo object using a mapping from Items to TrackInfo objects.\nAlbum, artist, track count.\nArtist sort and credit names.\nRelease date.\nIgnore specific release date.\nIf we're using original release date for both\nfields, set item.year = info.original_year,\netc.\nTitle.\nDisc and disc count.\nMusicBrainz IDs.\nCompilation flag.\nMiscellaneous metadata.","startLine":159,"endLine":234,"calleeNames":["iteritems","len","getattr","setattr"]},"acm000001378jsd":{"type":"CodeCompilationUnit","id":"acm000001378jsd","name":"__init__","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nFacilities for automatically determining files' correct metadata.\nParts of external interface.\nGlobal logger.","parentId":"acm000001379jsd","content":["acm000001375jsd","acm000001376jsd","acm000001377jsd"],"pathElements":["autotag"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","logging","re","beets.library","beets.mediafile","beets.config","beets.util.sorted_walk","beets.util.ancestry","beets.util.displayable_path","hooks.AlbumInfo","hooks.TrackInfo","hooks.AlbumMatch","hooks.TrackMatch","match.tag_item","match.tag_album","match.recommendation"]},"acm000001379jsd":{"type":"CodePackage","id":"acm000001379jsd","name":"autotag","comment":"","parentId":null,"content":["acm000001348jsd","acm000001360jsd","acm000001374jsd","acm000001378jsd"]},"acm000001380jsd":{"type":"ClassUnit","id":"acm000001380jsd","name":"ImportAbort","comment":"Raised when the user aborts the tagging operation.\nUtilities.","compilationUnitId":"acm000001429jsd","parentDatatypeId":null,"startLine":47,"endLine":50,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001381jsd":{"type":"ControlElement","id":"acm000001381jsd","name":"__init__","comment":"Create a session. `lib` is a Library object. `logfile` is a file-like object open for writing or None if no logging is to be performed. Either `paths` or `query` is non-null and indicates the source of files to be imported.","startLine":221,"endLine":234,"calleeNames":["map"]},"acm000001382jsd":{"type":"ControlElement","id":"acm000001382jsd","name":"_amend_config","comment":"Make implied changes the importer configuration.\nFIXME: Maybe this function should not exist and should instead\nprovide \"decision wrappers\" like \"should_resume()\", etc.","startLine":236,"endLine":259,"calleeNames":[]},"acm000001383jsd":{"type":"ControlElement","id":"acm000001383jsd","name":"tag_log","comment":"Log a message about a given album to logfile. The status should reflect the reason the album couldn't be tagged.","startLine":261,"endLine":268,"calleeNames":["print","format","displayable_path","flush"]},"acm000001384jsd":{"type":"ControlElement","id":"acm000001384jsd","name":"log_choice","comment":"Logs the task's current choice if it should be logged. If ``duplicate``, then this is a secondary choice after a duplicate was detected and a decision was made.","startLine":270,"endLine":289,"calleeNames":["tag_log"]},"acm000001385jsd":{"type":"ControlElement","id":"acm000001385jsd","name":"should_resume","comment":"","startLine":291,"endLine":292,"calleeNames":[]},"acm000001386jsd":{"type":"ControlElement","id":"acm000001386jsd","name":"choose_match","comment":"","startLine":294,"endLine":295,"calleeNames":[]},"acm000001387jsd":{"type":"ControlElement","id":"acm000001387jsd","name":"resolve_duplicate","comment":"","startLine":297,"endLine":298,"calleeNames":[]},"acm000001388jsd":{"type":"ControlElement","id":"acm000001388jsd","name":"choose_item","comment":"","startLine":300,"endLine":301,"calleeNames":[]},"acm000001389jsd":{"type":"ControlElement","id":"acm000001389jsd","name":"run","comment":"Run the import task.\nSet up the pipeline.\nSingleton importer.\nWhole-album importer.\nOnly look up and query the user when autotagging.\nWhen not autotagging, just display progress.","startLine":303,"endLine":342,"calleeNames":["_amend_config","read_tasks","query_tasks","item_lookup","item_query","item_progress","initial_lookup","user_query","show_progress","apply_choices","import_stages","append","plugin_stage","manipulate_files","finalize","Pipeline","run_parallel","run_sequential"]},"acm000001390jsd":{"type":"ClassUnit","id":"acm000001390jsd","name":"ImportSession","comment":"Controls an import action. Subclasses should implement methods to communicate with the user or otherwise make decisions.","compilationUnitId":"acm000001429jsd","parentDatatypeId":null,"startLine":217,"endLine":342,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001381jsd","acm000001382jsd","acm000001383jsd","acm000001384jsd","acm000001385jsd","acm000001386jsd","acm000001387jsd","acm000001388jsd","acm000001389jsd"]},"acm000001391jsd":{"type":"ControlElement","id":"acm000001391jsd","name":"__init__","comment":"Create a session. `lib` is a Library object. `logfile` is a file-like object open for writing or None if no logging is to be performed. Either `paths` or `query` is non-null and indicates the source of files to be imported.","startLine":221,"endLine":234,"calleeNames":["map"]},"acm000001392jsd":{"type":"ControlElement","id":"acm000001392jsd","name":"done_sentinel","comment":"Create an ImportTask that indicates the end of a top-level directory import.","startLine":360,"endLine":366,"calleeNames":["cls"]},"acm000001393jsd":{"type":"ControlElement","id":"acm000001393jsd","name":"progress_sentinel","comment":"Create a task indicating that a single directory in a larger import has finished. This is only required for singleton imports; progress is implied for album imports.","startLine":369,"endLine":376,"calleeNames":["cls"]},"acm000001394jsd":{"type":"ControlElement","id":"acm000001394jsd","name":"item_task","comment":"Creates an ImportTask for a single item.","startLine":379,"endLine":384,"calleeNames":["cls"]},"acm000001395jsd":{"type":"ControlElement","id":"acm000001395jsd","name":"set_candidates","comment":"Sets the candidates for this album matched by the `autotag.tag_album` method.","startLine":386,"endLine":395,"calleeNames":[]},"acm000001396jsd":{"type":"ControlElement","id":"acm000001396jsd","name":"set_null_candidates","comment":"Set the candidates to indicate no album match was found.","startLine":397,"endLine":403,"calleeNames":[]},"acm000001397jsd":{"type":"ControlElement","id":"acm000001397jsd","name":"set_item_candidates","comment":"Set the match for a single-item task.","startLine":405,"endLine":410,"calleeNames":[]},"acm000001398jsd":{"type":"ControlElement","id":"acm000001398jsd","name":"set_choice","comment":"Given an AlbumMatch or TrackMatch object or an action constant, indicates that an action has been selected for this task.\nNot part of the task structure:\nOnly used internally.\nImplicit choice.","startLine":412,"endLine":429,"calleeNames":["isinstance"]},"acm000001399jsd":{"type":"ControlElement","id":"acm000001399jsd","name":"save_progress","comment":"Updates the progress state to indicate that this album has finished.\n\"Done\" sentinel.\n\"Directory progress\" sentinel for singletons or a real\nalbum task, which implies the same.","startLine":431,"endLine":441,"calleeNames":["progress_set"]},"acm000001400jsd":{"type":"ControlElement","id":"acm000001400jsd","name":"save_history","comment":"Save the directory in the history for incremental imports.\nLogical decisions.","startLine":443,"endLine":447,"calleeNames":["history_add"]},"acm000001401jsd":{"type":"ControlElement","id":"acm000001401jsd","name":"should_write_tags","comment":"Should new info be written to the files' metadata?","startLine":452,"endLine":459,"calleeNames":[]},"acm000001402jsd":{"type":"ControlElement","id":"acm000001402jsd","name":"should_skip","comment":"After a choice has been made, returns True if this is a sentinel or it has been marked for skipping.\nConvenient data.","startLine":461,"endLine":465,"calleeNames":[]},"acm000001403jsd":{"type":"ControlElement","id":"acm000001403jsd","name":"chosen_ident","comment":"Returns identifying metadata about the current choice. For albums, this is an (artist, album) pair. For items, this is (artist, title). May only be called when the choice flag is ASIS (in which case the data comes from the files' current metadata) or APPLY (data comes from the choice).","startLine":470,"endLine":487,"calleeNames":[]},"acm000001404jsd":{"type":"ControlElement","id":"acm000001404jsd","name":"imported_items","comment":"Return a list of Items that should be added to the library. If this is an album task, return the list of items in the selected match or everything if the choice is ASIS. If this is a singleton task, return a list containing the item.\nUtilities.","startLine":489,"endLine":503,"calleeNames":["list","keys"]},"acm000001405jsd":{"type":"ControlElement","id":"acm000001405jsd","name":"prune","comment":"Prune any empty directories above the given file. If this task has no `toppath` or the file path provided is not within the `toppath`, then this function has no effect. Similarly, if the file still exists, no pruning is performed, so it's safe to call when the file in question may not have been removed.\nFull-album pipeline stages.","startLine":508,"endLine":518,"calleeNames":["exists","prune_dirs","dirname","get"]},"acm000001406jsd":{"type":"ClassUnit","id":"acm000001406jsd","name":"ImportTask","comment":"Represents a single set of items to be imported along with its intermediate state. May represent an album or a single item.","compilationUnitId":"acm000001429jsd","parentDatatypeId":null,"startLine":347,"endLine":518,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001391jsd","acm000001392jsd","acm000001393jsd","acm000001394jsd","acm000001395jsd","acm000001396jsd","acm000001397jsd","acm000001398jsd","acm000001399jsd","acm000001400jsd","acm000001401jsd","acm000001402jsd","acm000001403jsd","acm000001404jsd","acm000001405jsd"]},"acm000001407jsd":{"type":"ControlElement","id":"acm000001407jsd","name":"_duplicate_check","comment":"Check whether an album already exists in the library. Returns a list of Album objects (empty if no duplicates are found).\nAs-is import with no artist. Skip check.","startLine":55,"endLine":76,"calleeNames":["chosen_ident","set","albums","items","append"]},"acm000001408jsd":{"type":"ControlElement","id":"acm000001408jsd","name":"_item_duplicate_check","comment":"Check whether an item already exists in the library. Returns a list of Item objects.","startLine":78,"endLine":91,"calleeNames":["chosen_ident","items","append"]},"acm000001409jsd":{"type":"ControlElement","id":"acm000001409jsd","name":"_infer_album_fields","comment":"Given an album and an associated import task, massage the album-level metadata. This ensures that the album artist is set and that the \"compilation\" flag is set automatically.","startLine":93,"endLine":137,"calleeNames":["plurality","len","float","iteritems","setattr"]},"acm000001410jsd":{"type":"ControlElement","id":"acm000001410jsd","name":"_resume","comment":"Check whether an import should resume and return a boolean or the string 'ask' indicating that the user should be queried.","startLine":139,"endLine":143,"calleeNames":["as_choice"]},"acm000001411jsd":{"type":"ControlElement","id":"acm000001411jsd","name":"_open_state","comment":"Reads the state file, returning a dictionary.","startLine":145,"endLine":151,"calleeNames":["open","as_filename","load"]},"acm000001412jsd":{"type":"ControlElement","id":"acm000001412jsd","name":"_save_state","comment":"Writes the state dictionary out to disk.\nUtilities for reading and writing the beets progress file, which\nallows long tagging tasks to be resumed when they pause (or crash).","startLine":152,"endLine":158,"calleeNames":["open","as_filename","dump","error","unicode"]},"acm000001413jsd":{"type":"ControlElement","id":"acm000001413jsd","name":"progress_set","comment":"Record that tagging for the given `toppath` was successful up to `paths`. If paths is None, then clear the progress value (indicating that the tagging completed).","startLine":164,"endLine":180,"calleeNames":["_open_state","_save_state"]},"acm000001414jsd":{"type":"ControlElement","id":"acm000001414jsd","name":"progress_get","comment":"Get the last successfully tagged subpath of toppath. If toppath has no progress information, returns None.","startLine":181,"endLine":188,"calleeNames":["_open_state","get"]},"acm000001415jsd":{"type":"ControlElement","id":"acm000001415jsd","name":"history_add","comment":"Indicate that the import of the album in `paths` is completed and should not be repeated in incremental imports.","startLine":195,"endLine":205,"calleeNames":["_open_state","set","add","tuple","_save_state"]},"acm000001416jsd":{"type":"ControlElement","id":"acm000001416jsd","name":"history_get","comment":"Get the set of completed path tuples in incremental imports.","startLine":206,"endLine":212,"calleeNames":["_open_state","set"]},"acm000001417jsd":{"type":"ControlElement","id":"acm000001417jsd","name":"read_tasks","comment":"A generator yielding all the albums (as ImportTask objects) found in the user-specified list of paths. In the case of a singleton import, yields single-item tasks instead.\nLook for saved progress.\nEither accept immediately or prompt for input to decide.\nClear progress; we're starting from the top.\nLook for saved incremental directories.\nCheck whether the path is to a file.\nA flat album import merges all items into one album.\nProduce paths under this directory.\nSkip according to progress.\nWe're fast-forwarding to resume a previous tagging.\nWe've hit the last good path! Turn off the\nfast-forwarding.\nWhen incremental, skip paths in the history.\nYield all the necessary tasks.\nIndicate the directory is finished.\nShow skipped directories.","startLine":523,"endLine":610,"calleeNames":["_resume","progress_get","warn","should_resume","progress_set","history_get","isdir","syspath","from_path","format","displayable_path","item_task","albums_in_dir","ImportTask","done_sentinel","get","tuple","debug","progress_sentinel","info"]},"acm000001418jsd":{"type":"ControlElement","id":"acm000001418jsd","name":"query_tasks","comment":"A generator that works as a drop-in-replacement for read_tasks. Instead of finding files from the filesystem, a query is used to match items from the library.\nSearch for items.\nSearch for albums.","startLine":612,"endLine":628,"calleeNames":["items","item_task","albums","debug","list","ImportTask","item_dir"]},"acm000001419jsd":{"type":"ControlElement","id":"acm000001419jsd","name":"initial_lookup","comment":"A coroutine for performing the initial MusicBrainz lookup for an album. It accepts lists of Items and yields (items, cur_artist, cur_album, candidates, rec) tuples. If no match is found, all of the yielded parameters (except items) are None.","startLine":630,"endLine":647,"calleeNames":["send","debug","displayable_path","set_candidates","tag_album"]},"acm000001420jsd":{"type":"ControlElement","id":"acm000001420jsd","name":"user_query","comment":"A coroutine for interfacing with the user about the tagging process. lib is the Library to import into and logfile may be a file-like object for logging the import process. The coroutine accepts and yields ImportTask objects.","startLine":649,"endLine":695,"calleeNames":["set","choose_match","set_choice","log_choice","send","item_task","progress_sentinel","append","Pipeline","emitter","item_lookup","item_query","collector","run_sequential","multiple","chosen_ident","_duplicate_check","resolve_duplicate","add"]},"acm000001421jsd":{"type":"ControlElement","id":"acm000001421jsd","name":"show_progress","comment":"This stage replaces the initial_lookup and user_query stages when the importer is run without autotagging. It displays the album name and artist as the files are added.","startLine":697,"endLine":712,"calleeNames":["info","displayable_path","set_null_candidates","set_choice"]},"acm000001422jsd":{"type":"ControlElement","id":"acm000001422jsd","name":"apply_choices","comment":"A coroutine for applying changes to albums and singletons during the autotag process.","startLine":714,"endLine":798,"calleeNames":["should_skip","imported_items","should_write_tags","apply_metadata","apply_item_metadata","send","_infer_album_fields","defaultdict","items","MatchQuery","append","debug","displayable_path","len","_duplicate_check","_item_duplicate_check","ancestry","remove","prune_dirs","dirname","transaction","itervalues","add_album","add"]},"acm000001423jsd":{"type":"ControlElement","id":"acm000001423jsd","name":"plugin_stage","comment":"A coroutine (pipeline stage) that calls the given function with each non-skipped import task. These stages occur between applying metadata changes and moving/copying/writing files.","startLine":800,"endLine":814,"calleeNames":["should_skip","func","imported_items","load"]},"acm000001424jsd":{"type":"ControlElement","id":"acm000001424jsd","name":"manipulate_files","comment":"A coroutine (pipeline stage) that performs necessary file manipulations *after* items have been added to the library.","startLine":816,"endLine":864,"calleeNames":["should_skip","imported_items","move","prune","ancestry","remove","should_write_tags","write","transaction","store","send"]},"acm000001425jsd":{"type":"ControlElement","id":"acm000001425jsd","name":"finalize","comment":"A coroutine that finishes up importer tasks. In particular, the coroutine sends plugin events, deletes old files, and saves progress. This is a \"terminal\" coroutine (it yields None).\nAnnounce that we've added an album.\nFinally, delete old files.\nOnly delete files that were actually copied.\nUpdate progress.\nSingleton pipeline stages.","startLine":866,"endLine":905,"calleeNames":["should_skip","_resume","save_progress","save_history","imported_items","get_album","send","realpath","remove","syspath","prune"]},"acm000001426jsd":{"type":"ControlElement","id":"acm000001426jsd","name":"item_lookup","comment":"A coroutine used to perform the initial MusicBrainz lookup for an item task.","startLine":910,"endLine":922,"calleeNames":["send","set_item_candidates","tag_item"]},"acm000001427jsd":{"type":"ControlElement","id":"acm000001427jsd","name":"item_query","comment":"A coroutine that queries the user for input on single-item lookups.","startLine":924,"endLine":946,"calleeNames":["set","choose_item","set_choice","log_choice","send","chosen_ident","_item_duplicate_check","resolve_duplicate","add"]},"acm000001428jsd":{"type":"ControlElement","id":"acm000001428jsd","name":"item_progress","comment":"Skips the lookup and query stages in a non-autotagged singleton import. Just shows progress.","startLine":948,"endLine":961,"calleeNames":["info","displayable_path","set_null_candidates","set_choice"]},"acm000001429jsd":{"type":"CodeCompilationUnit","id":"acm000001429jsd","name":"importer","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nProvides the basic, interface-agnostic workflow for importing and autotagging music files.","parentId":"acm000001643jsd","content":["acm000001380jsd","acm000001390jsd","acm000001406jsd","acm000001407jsd","acm000001408jsd","acm000001409jsd","acm000001410jsd","acm000001411jsd","acm000001412jsd","acm000001413jsd","acm000001414jsd","acm000001415jsd","acm000001416jsd","acm000001417jsd","acm000001418jsd","acm000001419jsd","acm000001420jsd","acm000001421jsd","acm000001422jsd","acm000001423jsd","acm000001424jsd","acm000001425jsd","acm000001426jsd","acm000001427jsd","acm000001428jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["__future__.print_function","os","logging","pickle","collections.defaultdict","beets.autotag","beets.library","beets.plugins","beets.util","beets.config","beets.util.pipeline","beets.util.syspath","beets.util.normpath","beets.util.displayable_path","beets.util.enumeration.enum","beets.mediafile.UnreadableFileError"]},"acm000001430jsd":{"type":"ClassUnit","id":"acm000001430jsd","name":"InvalidFieldError","comment":"Library items (songs).","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":231,"endLine":232,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001431jsd":{"type":"ControlElement","id":"acm000001431jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001432jsd":{"type":"ControlElement","id":"acm000001432jsd","name":"from_path","comment":"Creates a new item from the media file at the specified path.\nInitiate with values that aren't read from files.","startLine":244,"endLine":253,"calleeNames":["cls","read","current_mtime"]},"acm000001433jsd":{"type":"ControlElement","id":"acm000001433jsd","name":"_fill_record","comment":"","startLine":255,"endLine":261,"calleeNames":["setattr"]},"acm000001434jsd":{"type":"ControlElement","id":"acm000001434jsd","name":"_clear_dirty","comment":"","startLine":263,"endLine":266,"calleeNames":[]},"acm000001435jsd":{"type":"ControlElement","id":"acm000001435jsd","name":"__repr__","comment":"Item field accessors.","startLine":268,"endLine":269,"calleeNames":["repr"]},"acm000001436jsd":{"type":"ControlElement","id":"acm000001436jsd","name":"__getattr__","comment":"If key is an item attribute (i.e., a column in the database), returns the record entry for that key.","startLine":274,"endLine":281,"calleeNames":["AttributeError"]},"acm000001437jsd":{"type":"ControlElement","id":"acm000001437jsd","name":"__setattr__","comment":"If key is an item attribute (i.e., a column in the database), sets the record entry for that key to value. Note that to change the attribute in the database or in the file's tags, one must call store() or write(). Otherwise, performs an ordinary setattr.\nEncode unicode paths and read buffers.\nIf the value changed, mark the field as dirty.\nReset mtime on dirty.\nInteraction with file metadata.","startLine":283,"endLine":306,"calleeNames":["isinstance","bytestring_path","str","super","__setattr__"]},"acm000001438jsd":{"type":"ControlElement","id":"acm000001438jsd","name":"read","comment":"Read the metadata from the associated file. If read_path is specified, read metadata from that file instead.\nDatabase's mtime should now reflect the on-disk value.","startLine":311,"endLine":334,"calleeNames":["normpath","MediaFile","syspath","debug","format","displayable_path","setattr","getattr","current_mtime"]},"acm000001439jsd":{"type":"ControlElement","id":"acm000001439jsd","name":"write","comment":"Writes the item's metadata to the associated file.","startLine":336,"endLine":352,"calleeNames":["send","MediaFile","syspath","setattr","getattr","save","FilesystemError","format_exc","current_mtime"]},"acm000001440jsd":{"type":"ControlElement","id":"acm000001440jsd","name":"move","comment":"Moves or copies the item's file, updating the path value if the move succeeds. If a file exists at ``dest``, then it is slightly modified to be unique.\nEither copying or moving succeeded, so update the stored path.","startLine":357,"endLine":370,"calleeNames":["samefile","unique_path","copy","move"]},"acm000001441jsd":{"type":"ControlElement","id":"acm000001441jsd","name":"current_mtime","comment":"Returns the current mtime of the file, rounded to the nearest integer.\nTemplating.","startLine":372,"endLine":376,"calleeNames":["int","getmtime","syspath"]},"acm000001442jsd":{"type":"ControlElement","id":"acm000001442jsd","name":"evaluate_template","comment":"Evaluates a Template object using the item's fields. If `lib` is provided, it is used to map some fields to the item's album (if available) and is made available to template functions. If `sanitize`, then each value will be sanitized for inclusion in a file path.","startLine":381,"endLine":431,"calleeNames":["get_album","getattr","format_for_path","displayable_path","template_values","iteritems","DefaultTemplateFunctions","functions","update","template_funcs","substitute"]},"acm000001443jsd":{"type":"ClassUnit","id":"acm000001443jsd","name":"Item","comment":"","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":237,"endLine":431,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001431jsd","acm000001432jsd","acm000001433jsd","acm000001434jsd","acm000001435jsd","acm000001436jsd","acm000001437jsd","acm000001438jsd","acm000001439jsd","acm000001440jsd","acm000001441jsd","acm000001442jsd"]},"acm000001444jsd":{"type":"ControlElement","id":"acm000001444jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001445jsd":{"type":"ControlElement","id":"acm000001445jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001446jsd":{"type":"ControlElement","id":"acm000001446jsd","name":"statement","comment":"Returns (query, subvals) where clause is a sqlite SELECT statement to enact this query and subvals is a list of values to substitute in for ?s in the query.","startLine":452,"endLine":458,"calleeNames":["clause"]},"acm000001447jsd":{"type":"ControlElement","id":"acm000001447jsd","name":"count","comment":"Returns `(num, length)` where `num` is the number of items in the library matching this query and `length` is their total length in seconds.","startLine":460,"endLine":468,"calleeNames":["clause","query"]},"acm000001448jsd":{"type":"ClassUnit","id":"acm000001448jsd","name":"Query","comment":"An abstract class representing a query into the item database.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":436,"endLine":468,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001444jsd","acm000001445jsd","acm000001446jsd","acm000001447jsd"]},"acm000001449jsd":{"type":"ControlElement","id":"acm000001449jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001450jsd":{"type":"ClassUnit","id":"acm000001450jsd","name":"FieldQuery","comment":"An abstract query that searches in a specific field for a pattern.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":470,"endLine":476,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001449jsd"]},"acm000001451jsd":{"type":"ControlElement","id":"acm000001451jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001452jsd":{"type":"ControlElement","id":"acm000001452jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001453jsd":{"type":"ClassUnit","id":"acm000001453jsd","name":"MatchQuery","comment":"A query that looks for exact matches in an item field.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":478,"endLine":487,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001451jsd","acm000001452jsd"]},"acm000001454jsd":{"type":"ControlElement","id":"acm000001454jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001455jsd":{"type":"ControlElement","id":"acm000001455jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001456jsd":{"type":"ClassUnit","id":"acm000001456jsd","name":"SubstringQuery","comment":"A query that matches a substring in a specific item field.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":489,"endLine":500,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001454jsd","acm000001455jsd"]},"acm000001457jsd":{"type":"ControlElement","id":"acm000001457jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001458jsd":{"type":"ControlElement","id":"acm000001458jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001459jsd":{"type":"ControlElement","id":"acm000001459jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001460jsd":{"type":"ClassUnit","id":"acm000001460jsd","name":"RegexpQuery","comment":"A query that matches a regular expression in a specific item field.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":502,"endLine":515,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001457jsd","acm000001458jsd","acm000001459jsd"]},"acm000001461jsd":{"type":"ControlElement","id":"acm000001461jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001462jsd":{"type":"ClassUnit","id":"acm000001462jsd","name":"BooleanQuery","comment":"Matches a boolean field. Pattern should either be a boolean or a string reflecting a boolean.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":517,"endLine":525,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001461jsd"]},"acm000001463jsd":{"type":"ControlElement","id":"acm000001463jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001464jsd":{"type":"ControlElement","id":"acm000001464jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001465jsd":{"type":"ControlElement","id":"acm000001465jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001466jsd":{"type":"ClassUnit","id":"acm000001466jsd","name":"SingletonQuery","comment":"Matches either singleton or non-singleton items.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":527,"endLine":539,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001463jsd","acm000001464jsd","acm000001465jsd"]},"acm000001467jsd":{"type":"ControlElement","id":"acm000001467jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001468jsd":{"type":"ControlElement","id":"acm000001468jsd","name":"__len__","comment":"","startLine":549,"endLine":550,"calleeNames":["len"]},"acm000001469jsd":{"type":"ControlElement","id":"acm000001469jsd","name":"__getitem__","comment":"","startLine":550,"endLine":551,"calleeNames":[]},"acm000001470jsd":{"type":"ControlElement","id":"acm000001470jsd","name":"__iter__","comment":"","startLine":551,"endLine":552,"calleeNames":["iter"]},"acm000001471jsd":{"type":"ControlElement","id":"acm000001471jsd","name":"__contains__","comment":"","startLine":552,"endLine":554,"calleeNames":[]},"acm000001472jsd":{"type":"ControlElement","id":"acm000001472jsd","name":"clause_with_joiner","comment":"Returns a clause created by joining together the clauses of all subqueries with the string joiner (padded by spaces).","startLine":554,"endLine":565,"calleeNames":["clause","append","join"]},"acm000001473jsd":{"type":"ControlElement","id":"acm000001473jsd","name":"_parse_query_part","comment":"Takes a query in the form of a key/value pair separated by a colon. An additional colon before the value indicates that the value is a regular expression. Returns tuple (key, term, is_regexp) where key is None if the search term has no key and is_regexp indicates whether term is a regular expression or an ordinary substring match. For instance, parse_query('stapler') == (None, 'stapler', false) parse_query('color:red') == ('color', 'red', false) parse_query(':^Quiet') == (None, '^Quiet', true) parse_query('color::b..e') == ('color', 'b..e', true) Colons may be 'escaped' with a backslash to disable the keying behavior.","startLine":581,"endLine":605,"calleeNames":["strip","match","group","replace"]},"acm000001474jsd":{"type":"ControlElement","id":"acm000001474jsd","name":"from_strings","comment":"Creates a query from a list of strings in the format used by _parse_query_part. If default_fields are specified, they are the fields to be searched by unqualified search terms. Otherwise, all fields are searched for those terms.","startLine":608,"endLine":660,"calleeNames":["_parse_query_part","append","PathQuery","AnyRegexpQuery","AnySubstringQuery","lower","BooleanQuery","RegexpQuery","SubstringQuery","SingletonQuery","str2bool","warn","format","TrueQuery","cls"]},"acm000001475jsd":{"type":"ControlElement","id":"acm000001475jsd","name":"from_string","comment":"Creates a query based on a single string. The string is split into query parts using shell-style syntax.\nA bug in Python < 2.7.3 prevents correct shlex splitting of\nUnicode strings.\nhttp://bugs.python.org/issue6988","startLine":663,"endLine":674,"calleeNames":["isinstance","encode","decode","split","from_strings"]},"acm000001476jsd":{"type":"ClassUnit","id":"acm000001476jsd","name":"CollectionQuery","comment":"An abstract query class that aggregates other queries. Can be indexed like a list to access the sub-queries.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":541,"endLine":674,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001467jsd","acm000001468jsd","acm000001469jsd","acm000001470jsd","acm000001471jsd","acm000001472jsd","acm000001473jsd","acm000001474jsd","acm000001475jsd"]},"acm000001477jsd":{"type":"ControlElement","id":"acm000001477jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001478jsd":{"type":"ControlElement","id":"acm000001478jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001479jsd":{"type":"ControlElement","id":"acm000001479jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001480jsd":{"type":"ClassUnit","id":"acm000001480jsd","name":"AnySubstringQuery","comment":"A query that matches a substring in any of a list of metadata fields.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":676,"endLine":705,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001477jsd","acm000001478jsd","acm000001479jsd"]},"acm000001481jsd":{"type":"ControlElement","id":"acm000001481jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001482jsd":{"type":"ControlElement","id":"acm000001482jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001483jsd":{"type":"ControlElement","id":"acm000001483jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001484jsd":{"type":"ClassUnit","id":"acm000001484jsd","name":"AnyRegexpQuery","comment":"A query that matches a regexp in any of a list of metadata fields.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":707,"endLine":736,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001481jsd","acm000001482jsd","acm000001483jsd"]},"acm000001485jsd":{"type":"ControlElement","id":"acm000001485jsd","name":"__setitem__","comment":"","startLine":742,"endLine":743,"calleeNames":[]},"acm000001486jsd":{"type":"ControlElement","id":"acm000001486jsd","name":"__delitem__","comment":"","startLine":743,"endLine":745,"calleeNames":[]},"acm000001487jsd":{"type":"ClassUnit","id":"acm000001487jsd","name":"MutableCollectionQuery","comment":"A collection query whose subqueries may be modified after the query is initialized.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":738,"endLine":743,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001485jsd","acm000001486jsd"]},"acm000001488jsd":{"type":"ControlElement","id":"acm000001488jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001489jsd":{"type":"ControlElement","id":"acm000001489jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001490jsd":{"type":"ClassUnit","id":"acm000001490jsd","name":"AndQuery","comment":"A conjunction of a list of other queries.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":745,"endLine":751,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001488jsd","acm000001489jsd"]},"acm000001491jsd":{"type":"ControlElement","id":"acm000001491jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001492jsd":{"type":"ControlElement","id":"acm000001492jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001493jsd":{"type":"ClassUnit","id":"acm000001493jsd","name":"TrueQuery","comment":"A query that always matches.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":753,"endLine":759,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001491jsd","acm000001492jsd"]},"acm000001494jsd":{"type":"ControlElement","id":"acm000001494jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001495jsd":{"type":"ControlElement","id":"acm000001495jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001496jsd":{"type":"ClassUnit","id":"acm000001496jsd","name":"FalseQuery","comment":"A query that never matches.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":761,"endLine":767,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001494jsd","acm000001495jsd"]},"acm000001497jsd":{"type":"ControlElement","id":"acm000001497jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001498jsd":{"type":"ControlElement","id":"acm000001498jsd","name":"match","comment":"Check whether this query matches a given Item. Can be used to perform queries on arbitrary sets of Items.","startLine":446,"endLine":450,"calleeNames":[]},"acm000001499jsd":{"type":"ControlElement","id":"acm000001499jsd","name":"clause","comment":"Returns (clause, subvals) where clause is a valid sqlite WHERE clause implementing the query and subvals is a list of items to be substituted for ?s in the clause.","startLine":439,"endLine":444,"calleeNames":[]},"acm000001500jsd":{"type":"ClassUnit","id":"acm000001500jsd","name":"PathQuery","comment":"A query that matches all items under a given path.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":769,"endLine":784,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001497jsd","acm000001498jsd","acm000001499jsd"]},"acm000001501jsd":{"type":"ControlElement","id":"acm000001501jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001502jsd":{"type":"ControlElement","id":"acm000001502jsd","name":"__iter__","comment":"","startLine":551,"endLine":552,"calleeNames":["iter"]},"acm000001503jsd":{"type":"ControlElement","id":"acm000001503jsd","name":"next","comment":"May raise StopIteration.","startLine":797,"endLine":799,"calleeNames":["next","Item"]},"acm000001504jsd":{"type":"ClassUnit","id":"acm000001504jsd","name":"ResultIterator","comment":"An iterator into an item query result set. The iterator lazily constructs Item objects that reflect database rows.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":786,"endLine":799,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001501jsd","acm000001502jsd","acm000001503jsd"]},"acm000001505jsd":{"type":"ControlElement","id":"acm000001505jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001506jsd":{"type":"ControlElement","id":"acm000001506jsd","name":"_get_query","comment":"Takes a value which may be None, a query string, a query string list, or a Query object, and returns a suitable Query object. album determines whether the query is to match items or albums.\nConvert a single string into a list of space-separated\ncriteria.\nBasic operations.","startLine":815,"endLine":840,"calleeNames":["isinstance","split","TrueQuery","from_strings","ValueError"]},"acm000001507jsd":{"type":"ControlElement","id":"acm000001507jsd","name":"add","comment":"Add the item as a new object to the library database. The id field will be updated; the new id is returned. If copy, then each item is copied to the destination location before it is added.","startLine":845,"endLine":851,"calleeNames":[]},"acm000001508jsd":{"type":"ControlElement","id":"acm000001508jsd","name":"load","comment":"Refresh the item's metadata from the library database. If fetch_id is not specified, use the item's current id.","startLine":853,"endLine":857,"calleeNames":[]},"acm000001509jsd":{"type":"ControlElement","id":"acm000001509jsd","name":"store","comment":"Save the item's metadata into the library database. If store_id is specified, use it instead of the item's current id. If store_all is true, save the entire record instead of just the dirty fields.","startLine":859,"endLine":865,"calleeNames":[]},"acm000001510jsd":{"type":"ControlElement","id":"acm000001510jsd","name":"remove","comment":"Removes the item from the database (leaving the file on disk).\nBrowsing operations.\nNaive implementations are provided, but these methods should be\noverridden if a better implementation exists.","startLine":867,"endLine":871,"calleeNames":[]},"acm000001511jsd":{"type":"ControlElement","id":"acm000001511jsd","name":"_get","comment":"Returns a sequence of the items matching query, which may be None (match the entire library), a Query object, or a query string. If default_fields is specified, it restricts the fields that may be matched by unqualified query string terms.","startLine":878,"endLine":884,"calleeNames":[]},"acm000001512jsd":{"type":"ControlElement","id":"acm000001512jsd","name":"albums","comment":"Returns a sorted list of BaseAlbum objects, possibly filtered by an artist name or an arbitrary query. Unqualified query string terms only match fields that apply at an album granularity: artist, album, and genre.\nGather the unique album/artist names and associated example\nItems.","startLine":886,"endLine":907,"calleeNames":["_get","sorted","keys","getattr","BaseAlbum"]},"acm000001513jsd":{"type":"ControlElement","id":"acm000001513jsd","name":"items","comment":"Returns a sequence of the items matching the given artist, album, title, and query (if present). Sorts in such a way as to group albums appropriately. Unqualified query string terms only match intuitively relevant fields: artist, album, genre, title, and comments.","startLine":909,"endLine":929,"calleeNames":["_get","append","cmp","sorted"]},"acm000001514jsd":{"type":"ClassUnit","id":"acm000001514jsd","name":"BaseLibrary","comment":"Abstract base class for music libraries, which are loosely defined as sets of Items.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":804,"endLine":929,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001505jsd","acm000001506jsd","acm000001507jsd","acm000001508jsd","acm000001509jsd","acm000001510jsd","acm000001511jsd","acm000001512jsd","acm000001513jsd"]},"acm000001515jsd":{"type":"ControlElement","id":"acm000001515jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001516jsd":{"type":"ControlElement","id":"acm000001516jsd","name":"__getattr__","comment":"If key is an item attribute (i.e., a column in the database), returns the record entry for that key.","startLine":274,"endLine":281,"calleeNames":["AttributeError"]},"acm000001517jsd":{"type":"ControlElement","id":"acm000001517jsd","name":"__setattr__","comment":"If key is an item attribute (i.e., a column in the database), sets the record entry for that key to value. Note that to change the attribute in the database or in the file's tags, one must call store() or write(). Otherwise, performs an ordinary setattr.\nEncode unicode paths and read buffers.\nIf the value changed, mark the field as dirty.\nReset mtime on dirty.\nInteraction with file metadata.","startLine":283,"endLine":306,"calleeNames":["isinstance","bytestring_path","str","super","__setattr__"]},"acm000001518jsd":{"type":"ControlElement","id":"acm000001518jsd","name":"load","comment":"Refresh the item's metadata from the library database. If fetch_id is not specified, use the item's current id.","startLine":853,"endLine":857,"calleeNames":[]},"acm000001519jsd":{"type":"ClassUnit","id":"acm000001519jsd","name":"BaseAlbum","comment":"Represents an album in the library, which in turn consists of a collection of items in the library. This base version just reflects the metadata of the album's items and therefore isn't particularly useful. The items are referenced by the record's album and artist fields. Implementations can add album-level metadata or use distinct backing stores.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":931,"endLine":974,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001515jsd","acm000001516jsd","acm000001517jsd","acm000001518jsd"]},"acm000001520jsd":{"type":"ControlElement","id":"acm000001520jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001521jsd":{"type":"ControlElement","id":"acm000001521jsd","name":"__enter__","comment":"Begin a transaction. This transaction may be created while another is active in a different thread.\nBeginning a \"root\" transaction, which corresponds to an\nSQLite transaction.","startLine":986,"endLine":997,"calleeNames":["_tx_stack","append","acquire"]},"acm000001522jsd":{"type":"ControlElement","id":"acm000001522jsd","name":"__exit__","comment":"Complete a transaction. This must be the most recently entered but not yet exited transaction. If it is the last active transaction, the database updates are committed.\nEnding a \"root\" transaction. End the SQLite transaction.","startLine":999,"endLine":1010,"calleeNames":["_tx_stack","pop","_connection","commit","release"]},"acm000001523jsd":{"type":"ControlElement","id":"acm000001523jsd","name":"query","comment":"Execute an SQL statement with substitution values and return a list of rows from the database.","startLine":1012,"endLine":1017,"calleeNames":["_connection","execute","fetchall"]},"acm000001524jsd":{"type":"ControlElement","id":"acm000001524jsd","name":"mutate","comment":"Execute an SQL statement with substitution values and return the row ID of the last affected row.","startLine":1019,"endLine":1025,"calleeNames":["_connection","execute","send"]},"acm000001525jsd":{"type":"ControlElement","id":"acm000001525jsd","name":"script","comment":"Execute a string containing multiple SQL statements.","startLine":1027,"endLine":1029,"calleeNames":["_connection","executescript"]},"acm000001526jsd":{"type":"ClassUnit","id":"acm000001526jsd","name":"Transaction","comment":"A context manager for safe, concurrent access to the database. All SQL commands should be executed through a transaction.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":979,"endLine":1029,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001520jsd","acm000001521jsd","acm000001522jsd","acm000001523jsd","acm000001524jsd","acm000001525jsd"]},"acm000001527jsd":{"type":"ControlElement","id":"acm000001527jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001528jsd":{"type":"ControlElement","id":"acm000001528jsd","name":"_make_table","comment":"Set up the schema of the library file. fields is a list of all the fields that should be present in the indicated table. Columns are added if necessary.\nGet current schema.","startLine":1073,"endLine":1114,"calleeNames":["transaction","query","set","issuperset","join","script"]},"acm000001529jsd":{"type":"ControlElement","id":"acm000001529jsd","name":"_connection","comment":"Get a SQLite connection object to the underlying database. One connection object is created per thread.","startLine":1116,"endLine":1134,"calleeNames":["current_thread","connect","create_function"]},"acm000001530jsd":{"type":"ControlElement","id":"acm000001530jsd","name":"_tx_stack","comment":"A context manager providing access to the current thread's transaction stack. The context manager synchronizes access to the stack map. Transactions should never migrate across threads.","startLine":1137,"endLine":1144,"calleeNames":["current_thread"]},"acm000001531jsd":{"type":"ControlElement","id":"acm000001531jsd","name":"transaction","comment":"Get a transaction object for interacting with the database. This should *always* be used as a context manager.","startLine":1146,"endLine":1150,"calleeNames":["Transaction"]},"acm000001532jsd":{"type":"ControlElement","id":"acm000001532jsd","name":"destination","comment":"Returns the path in the library directory designated for item item (i.e., where the file ought to be). fragment makes this method return just the path fragment underneath the root library directory; the path is also returned as Unicode instead of encoded as a bytestring. basedir can override the library's base directory for the destination.","startLine":1152,"endLine":1218,"calleeNames":["from_string","match","isinstance","Template","evaluate_template","normalize","sanitize_path","bytestring_path","splitext","decode","lower","get","max_filename_length","truncate_path","normpath","join"]},"acm000001533jsd":{"type":"ControlElement","id":"acm000001533jsd","name":"add","comment":"Add the item as a new object to the library database. The id field will be updated; the new id is returned. If copy, then each item is copied to the destination location before it is added.","startLine":845,"endLine":851,"calleeNames":[]},"acm000001534jsd":{"type":"ControlElement","id":"acm000001534jsd","name":"load","comment":"Refresh the item's metadata from the library database. If fetch_id is not specified, use the item's current id.","startLine":853,"endLine":857,"calleeNames":[]},"acm000001535jsd":{"type":"ControlElement","id":"acm000001535jsd","name":"store","comment":"Save the item's metadata into the library database. If store_id is specified, use it instead of the item's current id. If store_all is true, save the entire record instead of just the dirty fields.","startLine":859,"endLine":865,"calleeNames":[]},"acm000001536jsd":{"type":"ControlElement","id":"acm000001536jsd","name":"remove","comment":"Removes the item from the database (leaving the file on disk).\nBrowsing operations.\nNaive implementations are provided, but these methods should be\noverridden if a better implementation exists.","startLine":867,"endLine":871,"calleeNames":[]},"acm000001537jsd":{"type":"ControlElement","id":"acm000001537jsd","name":"move","comment":"Moves or copies the item's file, updating the path value if the move succeeds. If a file exists at ``dest``, then it is slightly modified to be unique.\nEither copying or moving succeeded, so update the stored path.","startLine":357,"endLine":370,"calleeNames":["samefile","unique_path","copy","move"]},"acm000001538jsd":{"type":"ControlElement","id":"acm000001538jsd","name":"albums","comment":"Returns a sorted list of BaseAlbum objects, possibly filtered by an artist name or an arbitrary query. Unqualified query string terms only match fields that apply at an album granularity: artist, album, and genre.\nGather the unique album/artist names and associated example\nItems.","startLine":886,"endLine":907,"calleeNames":["_get","sorted","keys","getattr","BaseAlbum"]},"acm000001539jsd":{"type":"ControlElement","id":"acm000001539jsd","name":"items","comment":"Returns a sequence of the items matching the given artist, album, title, and query (if present). Sorts in such a way as to group albums appropriately. Unqualified query string terms only match intuitively relevant fields: artist, album, genre, title, and comments.","startLine":909,"endLine":929,"calleeNames":["_get","append","cmp","sorted"]},"acm000001540jsd":{"type":"ControlElement","id":"acm000001540jsd","name":"get_item","comment":"Fetch an Item by its ID. Returns None if no match is found.","startLine":1397,"endLine":1406,"calleeNames":["transaction","query","ResultIterator","next"]},"acm000001541jsd":{"type":"ControlElement","id":"acm000001541jsd","name":"get_album","comment":"Given an album ID or an item associated with an album, return an Album object for the album. If no such album exists, returns None.","startLine":1408,"endLine":1426,"calleeNames":["isinstance","transaction","query","Album","dict"]},"acm000001542jsd":{"type":"ControlElement","id":"acm000001542jsd","name":"add_album","comment":"Create a new album in the database with metadata derived from its items. The items are added to the database if they don't yet have an ID. Returns an Album object.\nSet the metadata from the first item.","startLine":1428,"endLine":1463,"calleeNames":["dict","getattr","transaction","join","len","mutate","add","store","Album"]},"acm000001543jsd":{"type":"ClassUnit","id":"acm000001543jsd","name":"Library","comment":"A music library using an SQLite database as a metadata store.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":1031,"endLine":1463,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001527jsd","acm000001528jsd","acm000001529jsd","acm000001530jsd","acm000001531jsd","acm000001532jsd","acm000001533jsd","acm000001534jsd","acm000001535jsd","acm000001536jsd","acm000001537jsd","acm000001538jsd","acm000001539jsd","acm000001540jsd","acm000001541jsd","acm000001542jsd"]},"acm000001544jsd":{"type":"ControlElement","id":"acm000001544jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001545jsd":{"type":"ControlElement","id":"acm000001545jsd","name":"__setattr__","comment":"If key is an item attribute (i.e., a column in the database), sets the record entry for that key to value. Note that to change the attribute in the database or in the file's tags, one must call store() or write(). Otherwise, performs an ordinary setattr.\nEncode unicode paths and read buffers.\nIf the value changed, mark the field as dirty.\nReset mtime on dirty.\nInteraction with file metadata.","startLine":283,"endLine":306,"calleeNames":["isinstance","bytestring_path","str","super","__setattr__"]},"acm000001546jsd":{"type":"ControlElement","id":"acm000001546jsd","name":"__getattr__","comment":"If key is an item attribute (i.e., a column in the database), returns the record entry for that key.","startLine":274,"endLine":281,"calleeNames":["AttributeError"]},"acm000001547jsd":{"type":"ControlElement","id":"acm000001547jsd","name":"items","comment":"Returns a sequence of the items matching the given artist, album, title, and query (if present). Sorts in such a way as to group albums appropriately. Unqualified query string terms only match intuitively relevant fields: artist, album, genre, title, and comments.","startLine":909,"endLine":929,"calleeNames":["_get","append","cmp","sorted"]},"acm000001548jsd":{"type":"ControlElement","id":"acm000001548jsd","name":"remove","comment":"Removes the item from the database (leaving the file on disk).\nBrowsing operations.\nNaive implementations are provided, but these methods should be\noverridden if a better implementation exists.","startLine":867,"endLine":871,"calleeNames":[]},"acm000001549jsd":{"type":"ControlElement","id":"acm000001549jsd","name":"move_art","comment":"Move or copy any existing album art so that it remains in the same directory as the items.","startLine":1552,"endLine":1575,"calleeNames":["art_destination","unique_path","debug","copy","move","prune_dirs","dirname"]},"acm000001550jsd":{"type":"ControlElement","id":"acm000001550jsd","name":"move","comment":"Moves or copies the item's file, updating the path value if the move succeeds. If a file exists at ``dest``, then it is slightly modified to be unique.\nEither copying or moving succeeded, so update the stored path.","startLine":357,"endLine":370,"calleeNames":["samefile","unique_path","copy","move"]},"acm000001551jsd":{"type":"ControlElement","id":"acm000001551jsd","name":"item_dir","comment":"Returns the directory containing the album's first item, provided that such an item exists.","startLine":1592,"endLine":1600,"calleeNames":["items","next","ValueError","dirname"]},"acm000001552jsd":{"type":"ControlElement","id":"acm000001552jsd","name":"art_destination","comment":"Returns a path to the destination for the album art image for the album. `image` is the path of the image that will be moved there (used for its extension). The path construction uses the existing path of the album's items, so the album must contain at least one item or item_dir must be provided.","startLine":1602,"endLine":1625,"calleeNames":["bytestring_path","item_dir","isinstance","Template","sanitize_path","format_for_path","evaluate_template","splitext","join"]},"acm000001553jsd":{"type":"ControlElement","id":"acm000001553jsd","name":"set_art","comment":"Sets the album's cover art to the image at the given path. The image is copied (or moved) into place, replacing any existing art.","startLine":1627,"endLine":1652,"calleeNames":["bytestring_path","art_destination","samefile","remove","unique_path","copy","move"]},"acm000001554jsd":{"type":"ControlElement","id":"acm000001554jsd","name":"evaluate_template","comment":"Evaluates a Template object using the item's fields. If `lib` is provided, it is used to map some fields to the item's album (if available) and is made available to template functions. If `sanitize`, then each value will be sanitized for inclusion in a file path.","startLine":381,"endLine":431,"calleeNames":["get_album","getattr","format_for_path","displayable_path","template_values","iteritems","DefaultTemplateFunctions","functions","update","template_funcs","substitute"]},"acm000001555jsd":{"type":"ClassUnit","id":"acm000001555jsd","name":"Album","comment":"Provides access to information about albums stored in a library. Reflects the library's \"albums\" table, including album art.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":1465,"endLine":1670,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001544jsd","acm000001545jsd","acm000001546jsd","acm000001547jsd","acm000001548jsd","acm000001549jsd","acm000001550jsd","acm000001551jsd","acm000001552jsd","acm000001553jsd","acm000001554jsd"]},"acm000001556jsd":{"type":"ControlElement","id":"acm000001556jsd","name":"__init__","comment":"","startLine":238,"endLine":241,"calleeNames":["_fill_record","_clear_dirty"]},"acm000001557jsd":{"type":"ControlElement","id":"acm000001557jsd","name":"functions","comment":"Returns a dictionary containing the functions defined in this object. The keys are function names (as exposed in templates) and the values are Python functions.","startLine":1698,"endLine":1706,"calleeNames":["len","getattr"]},"acm000001558jsd":{"type":"ControlElement","id":"acm000001558jsd","name":"tmpl_lower","comment":"Convert a string to lower case.","startLine":1709,"endLine":1711,"calleeNames":["lower"]},"acm000001559jsd":{"type":"ControlElement","id":"acm000001559jsd","name":"tmpl_upper","comment":"Covert a string to upper case.","startLine":1714,"endLine":1716,"calleeNames":["upper"]},"acm000001560jsd":{"type":"ControlElement","id":"acm000001560jsd","name":"tmpl_title","comment":"Convert a string to title case.","startLine":1719,"endLine":1721,"calleeNames":["title"]},"acm000001561jsd":{"type":"ControlElement","id":"acm000001561jsd","name":"tmpl_left","comment":"Get the leftmost characters of a string.","startLine":1724,"endLine":1726,"calleeNames":["_int_arg"]},"acm000001562jsd":{"type":"ControlElement","id":"acm000001562jsd","name":"tmpl_right","comment":"Get the rightmost characters of a string.","startLine":1729,"endLine":1731,"calleeNames":["_int_arg"]},"acm000001563jsd":{"type":"ControlElement","id":"acm000001563jsd","name":"tmpl_if","comment":"If ``condition`` is nonempty and nonzero, emit ``trueval``; otherwise, emit ``falseval`` (if provided).","startLine":1734,"endLine":1745,"calleeNames":["_int_arg","strip"]},"acm000001564jsd":{"type":"ControlElement","id":"acm000001564jsd","name":"tmpl_asciify","comment":"Translate non-ASCII characters to their ASCII equivalents.","startLine":1748,"endLine":1751,"calleeNames":["unidecode"]},"acm000001565jsd":{"type":"ControlElement","id":"acm000001565jsd","name":"tmpl_aunique","comment":"Generate a string that is guaranteed to be unique among all albums in the library who share the same set of keys. A fields from \"disam\" is used in the string if one is sufficient to disambiguate the albums. Otherwise, a fallback opaque value is used. Both \"keys\" and \"disam\" should be given as whitespace-separated lists of field names.\nFast paths: no album, no item or library, or memoized value.","startLine":1753,"endLine":1817,"calleeNames":["get","split","get_album","getattr","append","MatchQuery","albums","AndQuery","len","set","format","format_for_path"]},"acm000001566jsd":{"type":"ClassUnit","id":"acm000001566jsd","name":"DefaultTemplateFunctions","comment":"A container class for the default functions provided to path templates. These functions are contained in an object to provide additional context to the functions -- specifically, the Item being evaluated.","compilationUnitId":"acm000001571jsd","parentDatatypeId":null,"startLine":1681,"endLine":1817,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001556jsd","acm000001557jsd","acm000001558jsd","acm000001559jsd","acm000001560jsd","acm000001561jsd","acm000001562jsd","acm000001563jsd","acm000001564jsd","acm000001565jsd"]},"acm000001567jsd":{"type":"ControlElement","id":"acm000001567jsd","name":"_orelse","comment":"Generates an SQLite expression that evaluates to exp1 if exp1 is non-null and non-empty or exp2 otherwise.\nAn SQLite function for regular expression matching.","startLine":170,"endLine":176,"calleeNames":["format"]},"acm000001568jsd":{"type":"ControlElement","id":"acm000001568jsd","name":"_regexp","comment":"Return a boolean indicating whether the regular expression `expr` matches `val`.","startLine":179,"endLine":191,"calleeNames":["as_string","search"]},"acm000001569jsd":{"type":"ControlElement","id":"acm000001569jsd","name":"format_for_path","comment":"Sanitize the value for inclusion in a path: replace separators with _, etc. Doesn't guarantee that the whole path will be valid; you should still call `util.sanitize_path` on the complete path.","startLine":194,"endLine":226,"calleeNames":["isinstance","replace","get","unicode"]},"acm000001570jsd":{"type":"ControlElement","id":"acm000001570jsd","name":"_int_arg","comment":"Convert a string argument to an integer for use in a template function. May raise a ValueError.","startLine":1675,"endLine":1679,"calleeNames":["int","strip"]},"acm000001571jsd":{"type":"CodeCompilationUnit","id":"acm000001571jsd","name":"library","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nThe core data store and collection logic for beets.","parentId":"acm000001643jsd","content":["acm000001430jsd","acm000001443jsd","acm000001448jsd","acm000001450jsd","acm000001453jsd","acm000001456jsd","acm000001460jsd","acm000001462jsd","acm000001466jsd","acm000001476jsd","acm000001480jsd","acm000001484jsd","acm000001487jsd","acm000001490jsd","acm000001493jsd","acm000001496jsd","acm000001500jsd","acm000001504jsd","acm000001514jsd","acm000001519jsd","acm000001526jsd","acm000001543jsd","acm000001555jsd","acm000001566jsd","acm000001567jsd","acm000001568jsd","acm000001569jsd","acm000001570jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["sqlite3","os","re","sys","logging","shlex","unicodedata","threading","contextlib","traceback","collections.defaultdict","unidecode.unidecode","beets.mediafile.MediaFile","beets.plugins","beets.util","beets.util.bytestring_path","beets.util.syspath","beets.util.normpath","beets.util.samefile","beets.util.displayable_path","beets.util.functemplate.Template","beets"]},"acm000001572jsd":{"type":"ClassUnit","id":"acm000001572jsd","name":"UnreadableFileError","comment":"Raised for files that don't seem to have a type MediaFile supports.","compilationUnitId":"acm000001610jsd","parentDatatypeId":null,"startLine":59,"endLine":60,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001573jsd":{"type":"ClassUnit","id":"acm000001573jsd","name":"FileTypeError","comment":"Constants.\nHuman-readable type names.","compilationUnitId":"acm000001610jsd","parentDatatypeId":null,"startLine":63,"endLine":64,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001574jsd":{"type":"ControlElement","id":"acm000001574jsd","name":"__init__","comment":"","startLine":282,"endLine":300,"calleeNames":["as_type"]},"acm000001575jsd":{"type":"ClassUnit","id":"acm000001575jsd","name":"StorageStyle","comment":"Parameterizes the storage behavior of a single field for a certain tag format. - key: The Mutagen key used to access the field's data. - list_elem: Store item as a single object or as first element of a list. - as_type: Which type the value is stored as (unicode, int, bool, or str). - packing: If this value is packed in a multiple-value storage unit, which type of packing (in the packing enum). Otherwise, None. (Makes as_type irrelevant). - pack_pos: If the value is packed, in which position it is stored. - suffix: When `as_type` is a string type, append this before storing the value. - float_places: When the value is a floating-point number and encoded as a string, the number of digits to store after the point. For MP3 only: - id3_desc: match against this 'desc' field as well as the key. - id3_frame_field: store the data in this field of the frame object. - id3_lang: set the language field of the frame object.","compilationUnitId":"acm000001610jsd","parentDatatypeId":null,"startLine":256,"endLine":300,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001574jsd"]},"acm000001576jsd":{"type":"ControlElement","id":"acm000001576jsd","name":"__init__","comment":"","startLine":282,"endLine":300,"calleeNames":["as_type"]},"acm000001577jsd":{"type":"ControlElement","id":"acm000001577jsd","name":"__getitem__","comment":"","startLine":326,"endLine":357,"calleeNames":["isinstance","TypeError","sub","unicode","split","_sc_decode","_safe_cast"]},"acm000001578jsd":{"type":"ControlElement","id":"acm000001578jsd","name":"__setitem__","comment":"Interpret null values.\nSLASHED, TUPLE and SC are always two-item packings\nDATE can have up to three fields\nmake a list of the items we'll pack","startLine":359,"endLine":399,"calleeNames":["range","append","enumerate","join","map","format","int","_sc_encode"]},"acm000001579jsd":{"type":"ClassUnit","id":"acm000001579jsd","name":"Packed","comment":"Makes a packed list of values subscriptable. To access the packed output after making changes, use packed_thing.items.","compilationUnitId":"acm000001610jsd","parentDatatypeId":null,"startLine":305,"endLine":399,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001576jsd","acm000001577jsd","acm000001578jsd"]},"acm000001580jsd":{"type":"ControlElement","id":"acm000001580jsd","name":"__init__","comment":"","startLine":282,"endLine":300,"calleeNames":["as_type"]},"acm000001581jsd":{"type":"ControlElement","id":"acm000001581jsd","name":"_fetchdata","comment":"Get the value associated with this descriptor's field stored with the given StorageStyle. Unwraps from a list if necessary.\nfetch the value, which may be a scalar or a list\nalso match on 'desc' field\nno desc match\nGet the metadata frame object.\nNot MP3.\nPossibly index the list.\nList must have at least one value.\nHandle Mutagen bugs when reading values (#356).","startLine":423,"endLine":466,"calleeNames":["getall","lower","getattr","error"]},"acm000001582jsd":{"type":"ControlElement","id":"acm000001582jsd","name":"_storedata","comment":"Store val for this descriptor's field in the tag dictionary according to the provided StorageStyle. Store it as a single-item list if necessary.\nWrap as a list if necessary.\nTry to match on \"desc\" field.\ntry modifying in place\nneed to make a new frame?\nKeyword.\nTry to match on \"owner\" field.\nReplace existing frame data.\nNew frame.\nKeyword.\nJust replace based on key.\nKeyword.\nNot MP3.","startLine":468,"endLine":528,"calleeNames":["getall","lower","setattr","isinstance","add","startswith","split","UFID","setall"]},"acm000001583jsd":{"type":"ControlElement","id":"acm000001583jsd","name":"_styles","comment":"Sane styles.\nMake sure we always return a list of styles, even when given\na single style for convenience.","startLine":530,"endLine":541,"calleeNames":["isinstance"]},"acm000001584jsd":{"type":"ControlElement","id":"acm000001584jsd","name":"__get__","comment":"Retrieve the value of this metadata field.\nFetch the data using the various StorageStyles.","startLine":543,"endLine":571,"calleeNames":["_styles","_fetchdata","Packed","isinstance","endswith","len","startswith","decode","_safe_cast"]},"acm000001585jsd":{"type":"ControlElement","id":"acm000001585jsd","name":"__set__","comment":"Set the value of this metadata field.\nStore using every StorageStyle available.","startLine":573,"endLine":640,"calleeNames":["_styles","Packed","_fetchdata","format","as_type","unicode","int","bool","isinstance","decode","startswith","encode","_storedata"]},"acm000001586jsd":{"type":"ClassUnit","id":"acm000001586jsd","name":"MediaField","comment":"A descriptor providing access to a particular (abstract) metadata field. out_type is the type that users of MediaFile should see and can be unicode, int, or bool. id3, mp4, and flac are StorageStyle instances parameterizing the field's storage for each type.","compilationUnitId":"acm000001610jsd","parentDatatypeId":null,"startLine":404,"endLine":640,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001580jsd","acm000001581jsd","acm000001582jsd","acm000001583jsd","acm000001584jsd","acm000001585jsd"]},"acm000001587jsd":{"type":"ControlElement","id":"acm000001587jsd","name":"__init__","comment":"","startLine":282,"endLine":300,"calleeNames":["as_type"]},"acm000001588jsd":{"type":"ControlElement","id":"acm000001588jsd","name":"__get__","comment":"Retrieve the value of this metadata field.\nFetch the data using the various StorageStyles.","startLine":543,"endLine":571,"calleeNames":["_styles","_fetchdata","Packed","isinstance","endswith","len","startswith","decode","_safe_cast"]},"acm000001589jsd":{"type":"ControlElement","id":"acm000001589jsd","name":"__set__","comment":"Set the value of this metadata field.\nStore using every StorageStyle available.","startLine":573,"endLine":640,"calleeNames":["_styles","Packed","_fetchdata","format","as_type","unicode","int","bool","isinstance","decode","startswith","encode","_storedata"]},"acm000001590jsd":{"type":"ClassUnit","id":"acm000001590jsd","name":"CompositeDateField","comment":"A MediaFile field for conveniently accessing the year, month, and day fields as a datetime.date object. Allows both getting and setting of the component fields.","compilationUnitId":"acm000001610jsd","parentDatatypeId":null,"startLine":642,"endLine":678,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001587jsd","acm000001588jsd","acm000001589jsd"]},"acm000001591jsd":{"type":"ControlElement","id":"acm000001591jsd","name":"_mime","comment":"Return the MIME type (either image/png or image/jpeg) of the image data (a bytestring).","startLine":687,"endLine":696,"calleeNames":["what"]},"acm000001592jsd":{"type":"ControlElement","id":"acm000001592jsd","name":"_mp4kind","comment":"Return the MPEG-4 image type code of the data. If the image is not a PNG or JPEG, JPEG is assumed.","startLine":699,"endLine":707,"calleeNames":["what"]},"acm000001593jsd":{"type":"ControlElement","id":"acm000001593jsd","name":"__get__","comment":"Retrieve the value of this metadata field.\nFetch the data using the various StorageStyles.","startLine":543,"endLine":571,"calleeNames":["_styles","_fetchdata","Packed","isinstance","endswith","len","startswith","decode","_safe_cast"]},"acm000001594jsd":{"type":"ControlElement","id":"acm000001594jsd","name":"__set__","comment":"Set the value of this metadata field.\nStore using every StorageStyle available.","startLine":573,"endLine":640,"calleeNames":["_styles","Packed","_fetchdata","format","as_type","unicode","int","bool","isinstance","decode","startswith","encode","_storedata"]},"acm000001595jsd":{"type":"ClassUnit","id":"acm000001595jsd","name":"ImageField","comment":"A descriptor providing access to a file's embedded album art. Holds a bytestring reflecting the image data. The image should either be a JPEG or a PNG for cross-format compatibility. It's probably a bad idea to use anything but these two formats.","compilationUnitId":"acm000001610jsd","parentDatatypeId":null,"startLine":680,"endLine":839,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001591jsd","acm000001592jsd","acm000001593jsd","acm000001594jsd"]},"acm000001596jsd":{"type":"ControlElement","id":"acm000001596jsd","name":"__init__","comment":"","startLine":282,"endLine":300,"calleeNames":["as_type"]},"acm000001597jsd":{"type":"ControlElement","id":"acm000001597jsd","name":"save","comment":"Field definitions.","startLine":903,"endLine":904,"calleeNames":["save"]},"acm000001598jsd":{"type":"ControlElement","id":"acm000001598jsd","name":"length","comment":"The duration of the audio in seconds (a float).","startLine":1275,"endLine":1277,"calleeNames":[]},"acm000001599jsd":{"type":"ControlElement","id":"acm000001599jsd","name":"samplerate","comment":"The audio's sample rate (an int).","startLine":1280,"endLine":1284,"calleeNames":["hasattr"]},"acm000001600jsd":{"type":"ControlElement","id":"acm000001600jsd","name":"bitdepth","comment":"The number of bits per sample in the audio encoding (an int). Only available for certain file formats (zero where unavailable).","startLine":1287,"endLine":1294,"calleeNames":["hasattr"]},"acm000001601jsd":{"type":"ControlElement","id":"acm000001601jsd","name":"channels","comment":"The number of channels in the audio (an int).","startLine":1297,"endLine":1308,"calleeNames":["isinstance","hasattr"]},"acm000001602jsd":{"type":"ControlElement","id":"acm000001602jsd","name":"bitrate","comment":"The number of bits per seconds used in the audio coding (an int). If this is provided explicitly by the compressed file format, this is a precise reflection of the encoding. Otherwise, it is estimated from the on-disk file size. In this case, some imprecision is possible because the file header is incorporated in the file size.\nMany formats provide it explicitly.\nOtherwise, we calculate bitrate from the file size. (This\nis the case for all of the lossless formats.)\nAvoid division by zero if length is not available.","startLine":1311,"endLine":1329,"calleeNames":["hasattr","getsize","int"]},"acm000001603jsd":{"type":"ControlElement","id":"acm000001603jsd","name":"format","comment":"A string describing the file format/codec.","startLine":1332,"endLine":1334,"calleeNames":[]},"acm000001604jsd":{"type":"ClassUnit","id":"acm000001604jsd","name":"MediaFile","comment":"Represents a multimedia file on disk and provides access to its metadata.","compilationUnitId":"acm000001610jsd","parentDatatypeId":null,"startLine":844,"endLine":1334,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001596jsd","acm000001597jsd","acm000001598jsd","acm000001599jsd","acm000001600jsd","acm000001601jsd","acm000001602jsd","acm000001603jsd"]},"acm000001605jsd":{"type":"ControlElement","id":"acm000001605jsd","name":"_safe_cast","comment":"Tries to covert val to out_type but will never raise an exception. If the value can't be converted, then a sensible default value is returned. out_type should be bool, int, or unicode; otherwise, the value is just passed through.\nJust a number.\nProcess any other type as a string.\nGet a number from the front of the string.\nShould work for strings, bools, ints:\nImage coding for ASF/WMA.","startLine":84,"endLine":146,"calleeNames":["isinstance","int","unicode","match","group","strip","bool","decode","float"]},"acm000001606jsd":{"type":"ControlElement","id":"acm000001606jsd","name":"_unpack_asf_image","comment":"Unpack image data from a WM/Picture tag. Return a tuple containing the MIME type, the raw image data, a type indicator, and the image's description. This function is treated as \"untrusted\" and could throw all manner of exceptions (out-of-bounds, etc.). We should clean this up sometime so that the failure modes are well-defined.","startLine":151,"endLine":174,"calleeNames":["unpack_from","decode"]},"acm000001607jsd":{"type":"ControlElement","id":"acm000001607jsd","name":"_pack_asf_image","comment":"Pack image data for a WM/Picture tag.","startLine":176,"endLine":183,"calleeNames":["pack","len","encode"]},"acm000001608jsd":{"type":"ControlElement","id":"acm000001608jsd","name":"_sc_decode","comment":"Convert a Sound Check string value to a (gain, peak) tuple as used by ReplayGain.\nSoundCheck tags consist of 10 numbers, each represented by 8\ncharacters of ASCII hex preceded by a space.\nSoundCheck isn't in the format we expect, so return default\nvalues.\nSoundCheck stores absolute calculated/measured RMS value in an\nunknown unit. We need to find the ratio of this measurement\ncompared to a reference value of 1000 to get our gain in dB. We\nplay it safe by using the larger of the two values (i.e., the most\nattenuation).","startLine":188,"endLine":221,"calleeNames":["replace","decode","unpack","max","log10","round"]},"acm000001609jsd":{"type":"ControlElement","id":"acm000001609jsd","name":"_sc_encode","comment":"Encode ReplayGain gain/peak values as a Sound Check string.\nSoundCheck stores the peak value as the actual value of the\nsample, rather than the percentage of full scale that RG uses, so\nwe do a simple conversion assuming 16 bit samples.\nSoundCheck stores absolute RMS values in some unknown units rather\nthan the dB values RG uses. We can calculate these absolute values\nfrom the gain ratio using a reference value of 1000 units. We also\nenforce the maximum value here, which is equivalent to about\n-18.2dB.","startLine":223,"endLine":244,"calleeNames":["min","round"]},"acm000001610jsd":{"type":"CodeCompilationUnit","id":"acm000001610jsd","name":"mediafile","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nHandles low-level interfacing for files' tags. Wraps Mutagen to automatically detect file types and provide a unified interface for a useful subset of music files' tags. Usage: >>> f = MediaFile('Lucy.mp3') >>> f.title u'Lucy in the Sky with Diamonds' >>> f.artist = 'The Beatles' >>> f.save() A field will always return a reasonable value of the correct type, even if no tag is present. If no value is available, the value will be false (e.g., zero or the empty string).","parentId":"acm000001643jsd","content":["acm000001572jsd","acm000001573jsd","acm000001575jsd","acm000001579jsd","acm000001586jsd","acm000001590jsd","acm000001595jsd","acm000001604jsd","acm000001605jsd","acm000001606jsd","acm000001607jsd","acm000001608jsd","acm000001609jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["mutagen","mutagen.mp3","mutagen.oggvorbis","mutagen.mp4","mutagen.flac","mutagen.monkeysaudio","mutagen.asf","datetime","re","base64","math","struct","imghdr","os","logging","traceback","beets.util.enumeration.enum"]},"acm000001611jsd":{"type":"ControlElement","id":"acm000001611jsd","name":"__init__","comment":"Perform one-time plugin setup.","startLine":40,"endLine":50,"calleeNames":["_add_media_fields","item_fields","split"]},"acm000001612jsd":{"type":"ControlElement","id":"acm000001612jsd","name":"commands","comment":"Should return a list of beets.ui.Subcommand objects for commands that should be added to beets' CLI.","startLine":52,"endLine":56,"calleeNames":[]},"acm000001613jsd":{"type":"ControlElement","id":"acm000001613jsd","name":"track_distance","comment":"Should return a (distance, distance_max) pair to be added to the distance value for every track comparison.","startLine":58,"endLine":62,"calleeNames":[]},"acm000001614jsd":{"type":"ControlElement","id":"acm000001614jsd","name":"album_distance","comment":"Should return a (distance, distance_max) pair to be added to the distance value for every album-level comparison.","startLine":64,"endLine":68,"calleeNames":[]},"acm000001615jsd":{"type":"ControlElement","id":"acm000001615jsd","name":"candidates","comment":"Should return a sequence of AlbumInfo objects that match the album whose items are provided.","startLine":70,"endLine":74,"calleeNames":[]},"acm000001616jsd":{"type":"ControlElement","id":"acm000001616jsd","name":"item_candidates","comment":"Should return a sequence of TrackInfo objects that match the item provided.","startLine":76,"endLine":80,"calleeNames":[]},"acm000001617jsd":{"type":"ControlElement","id":"acm000001617jsd","name":"configure","comment":"This method is called with the ConfigParser object after the CLI starts up.","startLine":82,"endLine":86,"calleeNames":[]},"acm000001618jsd":{"type":"ControlElement","id":"acm000001618jsd","name":"item_fields","comment":"Returns field descriptors to be added to the MediaFile class, in the form of a dictionary whose keys are field names and whose values are descriptor (e.g., MediaField) instances. The Library database schema is not (currently) extended.","startLine":88,"endLine":94,"calleeNames":[]},"acm000001619jsd":{"type":"ControlElement","id":"acm000001619jsd","name":"register_listener","comment":"Add a function as a listener for the specified event. (An imperative alternative to the @listen decorator.)","startLine":99,"endLine":105,"calleeNames":["defaultdict","append"]},"acm000001620jsd":{"type":"ControlElement","id":"acm000001620jsd","name":"listen","comment":"Decorator that adds a function as an event handler for the specified event (as a string). The parameters passed to function will vary depending on what event occurred. The function should respond to named parameters. function(**kwargs) will trap all arguments in a dictionary. Example: >>> @MyPlugin.listen(\"imported\") >>> def importListener(**kwargs): >>> pass","startLine":108,"endLine":126,"calleeNames":["defaultdict","append"]},"acm000001621jsd":{"type":"ControlElement","id":"acm000001621jsd","name":"template_func","comment":"Decorator that registers a path template function. The function will be invoked as ``%name{}`` from path format strings.","startLine":132,"endLine":142,"calleeNames":[]},"acm000001622jsd":{"type":"ControlElement","id":"acm000001622jsd","name":"template_field","comment":"Decorator that registers a path template field computation. The value will be referenced as ``$name`` from path format strings. The function must accept a single parameter, the Item being formatted.","startLine":145,"endLine":156,"calleeNames":[]},"acm000001623jsd":{"type":"ClassUnit","id":"acm000001623jsd","name":"BeetsPlugin","comment":"The base class for all beets plugins. Plugins provide functionality by defining a subclass of BeetsPlugin and overriding the abstract methods defined here.","compilationUnitId":"acm000001638jsd","parentDatatypeId":null,"startLine":35,"endLine":156,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001611jsd","acm000001612jsd","acm000001613jsd","acm000001614jsd","acm000001615jsd","acm000001616jsd","acm000001617jsd","acm000001618jsd","acm000001619jsd","acm000001620jsd","acm000001621jsd","acm000001622jsd"]},"acm000001624jsd":{"type":"ControlElement","id":"acm000001624jsd","name":"load_plugins","comment":"Imports the modules for a sequence of plugin names. Each name must be the name of a Python module under the \"beetsplug\" namespace package in sys.path; the module indicated should contain the BeetsPlugin subclasses desired.\nAgain, this is hacky:","startLine":159,"endLine":184,"calleeNames":["__import__","endswith","warn","getattr","values","isinstance","issubclass","append","format_exc"]},"acm000001625jsd":{"type":"ControlElement","id":"acm000001625jsd","name":"find_plugins","comment":"Returns a list of BeetsPlugin subclass instances from all currently loaded beets plugins. Loads the default plugin set first.","startLine":187,"endLine":199,"calleeNames":["load_plugins","cls","append"]},"acm000001626jsd":{"type":"ControlElement","id":"acm000001626jsd","name":"commands","comment":"Should return a list of beets.ui.Subcommand objects for commands that should be added to beets' CLI.","startLine":52,"endLine":56,"calleeNames":[]},"acm000001627jsd":{"type":"ControlElement","id":"acm000001627jsd","name":"track_distance","comment":"Should return a (distance, distance_max) pair to be added to the distance value for every track comparison.","startLine":58,"endLine":62,"calleeNames":[]},"acm000001628jsd":{"type":"ControlElement","id":"acm000001628jsd","name":"album_distance","comment":"Should return a (distance, distance_max) pair to be added to the distance value for every album-level comparison.","startLine":64,"endLine":68,"calleeNames":[]},"acm000001629jsd":{"type":"ControlElement","id":"acm000001629jsd","name":"candidates","comment":"Should return a sequence of AlbumInfo objects that match the album whose items are provided.","startLine":70,"endLine":74,"calleeNames":[]},"acm000001630jsd":{"type":"ControlElement","id":"acm000001630jsd","name":"item_candidates","comment":"Should return a sequence of TrackInfo objects that match the item provided.","startLine":76,"endLine":80,"calleeNames":[]},"acm000001631jsd":{"type":"ControlElement","id":"acm000001631jsd","name":"configure","comment":"This method is called with the ConfigParser object after the CLI starts up.","startLine":82,"endLine":86,"calleeNames":[]},"acm000001632jsd":{"type":"ControlElement","id":"acm000001632jsd","name":"template_funcs","comment":"Get all the template functions declared by plugins as a dictionary.","startLine":255,"endLine":263,"calleeNames":["find_plugins","update"]},"acm000001633jsd":{"type":"ControlElement","id":"acm000001633jsd","name":"template_values","comment":"Get all the template values computed for a given Item by registered field computations.","startLine":265,"endLine":274,"calleeNames":["find_plugins","iteritems","unicode","func"]},"acm000001634jsd":{"type":"ControlElement","id":"acm000001634jsd","name":"_add_media_fields","comment":"Adds a {name: descriptor} dictionary of fields to the MediaFile class. Called during the plugin initialization.","startLine":276,"endLine":281,"calleeNames":["iteritems","setattr"]},"acm000001635jsd":{"type":"ControlElement","id":"acm000001635jsd","name":"import_stages","comment":"Get a list of import stage functions defined by plugins.","startLine":283,"endLine":289,"calleeNames":["find_plugins","hasattr"]},"acm000001636jsd":{"type":"ControlElement","id":"acm000001636jsd","name":"event_handlers","comment":"Find all event handlers from plugins as a dictionary mapping event names to sequences of callables.","startLine":294,"endLine":303,"calleeNames":["defaultdict","find_plugins","items"]},"acm000001637jsd":{"type":"ControlElement","id":"acm000001637jsd","name":"send","comment":"Sends an event to all assigned event listeners. Event is the name of the event to send, all other named arguments go to the event handler(s). Returns the number of handlers called.","startLine":305,"endLine":316,"calleeNames":["debug","event_handlers","handler","len"]},"acm000001638jsd":{"type":"CodeCompilationUnit","id":"acm000001638jsd","name":"plugins","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nSupport for beets plugins.","parentId":"acm000001643jsd","content":["acm000001623jsd","acm000001624jsd","acm000001625jsd","acm000001626jsd","acm000001627jsd","acm000001628jsd","acm000001629jsd","acm000001630jsd","acm000001631jsd","acm000001632jsd","acm000001633jsd","acm000001634jsd","acm000001635jsd","acm000001636jsd","acm000001637jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["logging","traceback","collections.defaultdict","beets","beets.mediafile"]},"acm000001639jsd":{"type":"ControlElement","id":"acm000001639jsd","name":"_insert","comment":"Insert an item into a virtual filesystem node.\nLast component. Insert file.\nIn a directory.","startLine":23,"endLine":34,"calleeNames":["len","Node","_insert"]},"acm000001640jsd":{"type":"ControlElement","id":"acm000001640jsd","name":"libtree","comment":"Generates a filesystem-like directory tree for the files contained in `lib`. Filesystem nodes are (files, dirs) named tuples in which both components are dictionaries. The first maps filenames to Item ids. The second maps directory names to child node tuples.","startLine":36,"endLine":48,"calleeNames":["Node","items","destination","components","_insert"]},"acm000001641jsd":{"type":"CodeCompilationUnit","id":"acm000001641jsd","name":"vfs","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nA simple utility for constructing filesystem-like trees from beets libraries.","parentId":"acm000001643jsd","content":["acm000001639jsd","acm000001640jsd"],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["collections.namedtuple","beets.util"]},"acm000001642jsd":{"type":"CodeCompilationUnit","id":"acm000001642jsd","name":"__init__","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.","parentId":"acm000001643jsd","content":[],"pathElements":[],"extension":"py","language":"PYTHON3","importedModuleNames":["beets.library","beets.util.confit"]},"acm000001643jsd":{"type":"CodePackage","id":"acm000001643jsd","name":"","comment":"","parentId":null,"content":["acm000001429jsd","acm000001571jsd","acm000001610jsd","acm000001638jsd","acm000001641jsd","acm000001642jsd"]},"acm000001644jsd":{"type":"ControlElement","id":"acm000001644jsd","name":"choose_match","comment":"Given an initial autotagging of items, go through an interactive dance with the user to ask for a choice of metadata. Returns an AlbumMatch object, ASIS, or SKIP.\nShow what we're tagging.\nTake immediate action if appropriate.","startLine":513,"endLine":560,"calleeNames":["print_","displayable_path","_summary_judment","show_change","choose_candidate","len","manual_search","tag_album","manual_id","isinstance"]},"acm000001645jsd":{"type":"ControlElement","id":"acm000001645jsd","name":"choose_item","comment":"Ask the user for a choice about tagging a single item. Returns either an action constant or a TrackMatch object.","startLine":562,"endLine":601,"calleeNames":["print_","_summary_judment","show_item_change","choose_candidate","manual_search","tag_item","manual_id","isinstance"]},"acm000001646jsd":{"type":"ControlElement","id":"acm000001646jsd","name":"resolve_duplicate","comment":"Decide what to do when a new album or item seems similar to one that's already in the library.\nIn quiet mode, don't prompt -- just skip.\nSkip new.\nKeep both. Do nothing; leave the choice intact.\nRemove old.","startLine":603,"endLine":629,"calleeNames":["warn","info","input_options","set_choice"]},"acm000001647jsd":{"type":"ControlElement","id":"acm000001647jsd","name":"should_resume","comment":"The import command.","startLine":631,"endLine":634,"calleeNames":["input_yn","format","displayable_path"]},"acm000001648jsd":{"type":"ClassUnit","id":"acm000001648jsd","name":"TerminalImportSession","comment":"An import session that runs in a terminal.","compilationUnitId":"acm000001674jsd","parentDatatypeId":null,"startLine":510,"endLine":634,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001644jsd","acm000001645jsd","acm000001646jsd","acm000001647jsd"]},"acm000001649jsd":{"type":"ControlElement","id":"acm000001649jsd","name":"_do_query","comment":"For commands that operate on matched items, performs a query and returns a list of matching items and a list of matching albums. (The latter is only nonempty when album is True.) Raises a UserError if no items match. also_items controls whether, when fetching albums, the associated items should be fetched also.","startLine":49,"endLine":72,"calleeNames":["list","albums","items","UserError"]},"acm000001650jsd":{"type":"ControlElement","id":"acm000001650jsd","name":"_showdiff","comment":"Prints out a human-readable field difference line.\nConsidering floats incomparable for perfect equality, introduce\nan epsilon tolerance.\nfields: Shows a list of available fields for queries and format strings.","startLine":75,"endLine":85,"calleeNames":["isinstance","abs","colordiff","print_"]},"acm000001651jsd":{"type":"ControlElement","id":"acm000001651jsd","name":"fields_func","comment":"","startLine":92,"endLine":96,"calleeNames":["print","join"]},"acm000001652jsd":{"type":"ControlElement","id":"acm000001652jsd","name":"dist_string","comment":"Formats a distance (a float) as a colorized similarity percentage string.","startLine":110,"endLine":121,"calleeNames":["as_number","colorize"]},"acm000001653jsd":{"type":"ControlElement","id":"acm000001653jsd","name":"show_change","comment":"Print out a representation of the changes that will be made if an album's tags are changed according to `match`, which must be an AlbumMatch object.","startLine":123,"endLine":254,"calleeNames":["colorize","print_","get","format","unicode","colordiff","show_album","dist_string","items","sort","strip","displayable_path","basename","len","format_index","color_diff_suffix","abs","as_number","human_seconds_short","append","term_width","join","max"]},"acm000001654jsd":{"type":"ControlElement","id":"acm000001654jsd","name":"show_item_change","comment":"Print out the change that would occur by tagging `item` with the metadata from `match`, a TrackMatch object.","startLine":256,"endLine":275,"calleeNames":["colordiff","print_","dist_string"]},"acm000001655jsd":{"type":"ControlElement","id":"acm000001655jsd","name":"_summary_judment","comment":"Determines whether a decision should be made without even asking the user. This occurs in quiet mode and when an action is chosen for NONE recommendations. Return an action or None if the user should be queried. May also print to the console if a summary judgment is made.","startLine":277,"endLine":307,"calleeNames":["as_choice","print_"]},"acm000001656jsd":{"type":"ControlElement","id":"acm000001656jsd","name":"choose_candidate","comment":"Given a sorted list of candidates, ask the user for a selection of which candidate to use. Applies to both full albums and singletons (tracks). Candidates are either AlbumMatch or TrackMatch objects depending on `singleton`. for albums, `cur_artist`, `cur_album`, and `itemcount` must be provided. For singletons, `item` must be provided. Returns the result of the choice, which may SKIP, ASIS, TRACKS, or MANUAL or a candidate (an AlbumMatch/TrackMatch object).\nSanity check.\nZero candidates.\nIs the change good enough?","startLine":309,"endLine":484,"calleeNames":["print_","format","input_options","ImportAbort","enumerate","dist_string","append","unicode","join","colorize","len","show_item_change","show_change","as_choice"]},"acm000001657jsd":{"type":"ControlElement","id":"acm000001657jsd","name":"manual_search","comment":"Input either an artist and album (for full albums) or artist and track name (for singletons) for manual search.","startLine":486,"endLine":492,"calleeNames":["input_","strip"]},"acm000001658jsd":{"type":"ControlElement","id":"acm000001658jsd","name":"manual_id","comment":"Input a MusicBrainz ID, either for an album (\"release\") or a track (\"recording\"). If no valid ID is entered, returns None.","startLine":494,"endLine":508,"calleeNames":["input_","strip","search","group","error"]},"acm000001659jsd":{"type":"ControlElement","id":"acm000001659jsd","name":"import_files","comment":"Import the files in the given list of paths or matching the query.\nCheck the user-specified directories.\nCheck parameter consistency.\nOpen the log.\nNever ask for input in quiet mode.","startLine":638,"endLine":681,"calleeNames":["syspath","normpath","isdir","UserError","exists","get","as_filename","open","displayable_path","print","asctime","TerminalImportSession","run","close","send"]},"acm000001660jsd":{"type":"ControlElement","id":"acm000001660jsd","name":"import_func","comment":"Special case: --copy flag suppresses import_move (which would\notherwise take precedence).","startLine":718,"endLine":735,"calleeNames":["set_args","decargs","UserError","import_files"]},"acm000001661jsd":{"type":"ControlElement","id":"acm000001661jsd","name":"list_items","comment":"Print out items in lib matching query. If album, then search for albums instead of single items.","startLine":742,"endLine":752,"calleeNames":["Template","_pick_format","albums","print_obj","items"]},"acm000001662jsd":{"type":"ControlElement","id":"acm000001662jsd","name":"list_func","comment":"","startLine":761,"endLine":766,"calleeNames":["list_items","decargs"]},"acm000001663jsd":{"type":"ControlElement","id":"acm000001663jsd","name":"update_items","comment":"For all the items matched by the query, update the library to reflect the item's embedded tags.\nWalk through the items and pick up their changes.\nItem deleted?\nDid the item change since last checked?\nRead new data.\nSpecial-case album artist when it matches track artist. (Hacky\nbut necessary for preserving album-level metadata for non-\nautotagged imports.)\nGet and save metadata changes.\nSomething changed.\nIf we're just pretending, then don't move or save.\nMove the item if it's in the library.\nThe file's mtime was different, but there were no changes\nto the metadata. Store the new mtime, which is set in the\ncall to read(), so we don't check this again in the\nfuture.\nSkip album changes while pretending.\nModify affected albums to reflect changes in their items.\nSingletons.\nEmpty albums have already been removed.\nUpdate album structure to reflect an item in it.\nMove album art (and any inconsistent items).","startLine":773,"endLine":859,"calleeNames":["transaction","_do_query","set","exists","syspath","print_obj","remove","add","current_mtime","debug","displayable_path","dict","read","getattr","iteritems","_showdiff","ancestry","move","store","get_album","list","items","setattr"]},"acm000001664jsd":{"type":"ControlElement","id":"acm000001664jsd","name":"update_func","comment":"","startLine":871,"endLine":872,"calleeNames":["update_items","decargs"]},"acm000001665jsd":{"type":"ControlElement","id":"acm000001665jsd","name":"remove_items","comment":"Remove items matching query from lib. If album, then match and remove whole albums. If delete, also remove files from disk.\nGet the matching items.\nShow all the items.\nConfirm with user.\nRemove (and possibly delete) items.","startLine":879,"endLine":907,"calleeNames":["_do_query","print_obj","print_","len","input_yn","transaction","remove"]},"acm000001666jsd":{"type":"ControlElement","id":"acm000001666jsd","name":"remove_func","comment":"","startLine":915,"endLine":916,"calleeNames":["remove_items","decargs"]},"acm000001667jsd":{"type":"ControlElement","id":"acm000001667jsd","name":"show_stats","comment":"Shows some statistics about the matched items.","startLine":923,"endLine":952,"calleeNames":["items","set","getsize","int","add","human_bytes","format","print_","human_seconds","len"]},"acm000001668jsd":{"type":"ControlElement","id":"acm000001668jsd","name":"stats_func","comment":"","startLine":958,"endLine":959,"calleeNames":["show_stats","decargs"]},"acm000001669jsd":{"type":"ControlElement","id":"acm000001669jsd","name":"show_version","comment":"Show plugins.","startLine":966,"endLine":973,"calleeNames":["print_","find_plugins","join"]},"acm000001670jsd":{"type":"ControlElement","id":"acm000001670jsd","name":"modify_items","comment":"Modifies matching items according to key=value assignments.\nParse key=value specifications into a dictionary.","startLine":982,"endLine":1038,"calleeNames":["split","UserError","_do_query","print_","len","print_obj","iteritems","getattr","_showdiff","input_yn","transaction","setattr","item_dir","ancestry","debug","move","store","chain","items","write"]},"acm000001671jsd":{"type":"ControlElement","id":"acm000001671jsd","name":"modify_func","comment":"","startLine":1054,"endLine":1062,"calleeNames":["decargs","UserError","get","modify_items"]},"acm000001672jsd":{"type":"ControlElement","id":"acm000001672jsd","name":"move_items","comment":"Moves or copies items to a new base directory, given by dest. If dest is None, then the library's base directory is used, making the command \"consolidate\" files.","startLine":1069,"endLine":1088,"calleeNames":["_do_query","info","len","item_dir","debug","move","store"]},"acm000001673jsd":{"type":"ControlElement","id":"acm000001673jsd","name":"move_func","comment":"","startLine":1098,"endLine":1105,"calleeNames":["normpath","isdir","UserError","move_items","decargs"]},"acm000001674jsd":{"type":"CodeCompilationUnit","id":"acm000001674jsd","name":"commands","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nThis module provides the default commands for beets' command-line interface.\nGlobal logger.","parentId":"acm000001722jsd","content":["acm000001648jsd","acm000001649jsd","acm000001650jsd","acm000001651jsd","acm000001652jsd","acm000001653jsd","acm000001654jsd","acm000001655jsd","acm000001656jsd","acm000001657jsd","acm000001658jsd","acm000001659jsd","acm000001660jsd","acm000001661jsd","acm000001662jsd","acm000001663jsd","acm000001664jsd","acm000001665jsd","acm000001666jsd","acm000001667jsd","acm000001668jsd","acm000001669jsd","acm000001670jsd","acm000001671jsd","acm000001672jsd","acm000001673jsd"],"pathElements":["ui"],"extension":"py","language":"PYTHON3","importedModuleNames":["__future__.print_function","logging","os","time","itertools","re","codecs","beets","beets.ui","beets.ui.print_","beets.ui.input_","beets.ui.decargs","beets.autotag","beets.autotag.recommendation","beets.plugins","beets.importer","beets.util.syspath","beets.util.normpath","beets.util.ancestry","beets.util.displayable_path","beets.util.functemplate.Template","beets.library","beets.config"]},"acm000001675jsd":{"type":"ControlElement","id":"acm000001675jsd","name":"represent_mapping","comment":"","startLine":222,"endLine":245,"calleeNames":["MappingNode","hasattr","list","items","represent_data","isinstance","append"]},"acm000001676jsd":{"type":"ClassUnit","id":"acm000001676jsd","name":"Dumper","comment":"A PyYAML Dumper that represents OrderedDicts as ordinary mappings (in order, of course).\nFrom http://pyyaml.org/attachment/ticket/161/use_ordered_dict.py","compilationUnitId":"acm000001689jsd","parentDatatypeId":null,"startLine":217,"endLine":245,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001675jsd"]},"acm000001677jsd":{"type":"ControlElement","id":"acm000001677jsd","name":"grouper","comment":"","startLine":61,"endLine":63,"calleeNames":["iter","izip_longest"]},"acm000001678jsd":{"type":"ControlElement","id":"acm000001678jsd","name":"_displace","comment":"Move a file aside using a timestamp suffix so a new file can be put in its place.","startLine":65,"endLine":73,"calleeNames":["move","format","int","time"]},"acm000001679jsd":{"type":"ControlElement","id":"acm000001679jsd","name":"default_paths","comment":"Produces the appropriate default config and library database paths for the current system. On Unix, this is always in ~. On Windows, tries ~ first and then $APPDATA for the config and library files (for backwards compatibility).","startLine":75,"endLine":97,"calleeNames":["get","expanduser","join","exp","exists"]},"acm000001680jsd":{"type":"ControlElement","id":"acm000001680jsd","name":"get_config","comment":"Using the same logic as beets 1.0, locate and read the .beetsconfig file. Return a ConfigParser instance or None if no config is found.","startLine":99,"endLine":116,"calleeNames":["default_paths","expanduser","SafeConfigParser","exists","syspath","open","readfp"]},"acm000001681jsd":{"type":"ControlElement","id":"acm000001681jsd","name":"flatten_config","comment":"Given a ConfigParser, flatten the values into a dict-of-dicts representation where each section gets its own dictionary of values.","startLine":118,"endLine":127,"calleeNames":["OrderedDict","sections","options","get"]},"acm000001682jsd":{"type":"ControlElement","id":"acm000001682jsd","name":"transform_value","comment":"Given a string read as the value of a config option, return a massaged version of that value (possibly with a different type).\nBooleans.\nIntegers.\nFloats.","startLine":129,"endLine":151,"calleeNames":["lower","int","float"]},"acm000001683jsd":{"type":"ControlElement","id":"acm000001683jsd","name":"transform_data","comment":"Given a dict-of-dicts representation of legacy config data, tweak the data into a new form. This new form is suitable for dumping as YAML.","startLine":153,"endLine":215,"calleeNames":["OrderedDict","items","transform_value","startswith","split","get","join","grouper","replace","len"]},"acm000001684jsd":{"type":"ControlElement","id":"acm000001684jsd","name":"migrate_config","comment":"Migrate a legacy beetsconfig file to a new-style config.yaml file in an appropriate place. If `replace` is enabled, then any existing config.yaml will be moved aside. Otherwise, the process is aborted when the file exists.\nGet the new configuration file path and possibly move it out of\nthe way.","startLine":248,"endLine":301,"calleeNames":["join","config_dir","exists","debug","format","displayable_path","_displace","get_config","transform_data","flatten_config","dump","sub","open","write"]},"acm000001685jsd":{"type":"ControlElement","id":"acm000001685jsd","name":"migrate_db","comment":"Copy the beets library database file to the new location (e.g., from ~/.beetsmusic.blb to ~/.config/beets/library.db).","startLine":303,"endLine":328,"calleeNames":["default_paths","as_filename","exists","debug","format","displayable_path","_displace","copy"]},"acm000001686jsd":{"type":"ControlElement","id":"acm000001686jsd","name":"migrate_state","comment":"Copy the beets runtime state file from the old path (i.e., ~/.beetsstate) to the new path (i.e., ~/.config/beets/state.pickle).","startLine":330,"endLine":349,"calleeNames":["expanduser","join","exists","as_filename","_displace","debug","format","displayable_path","copy"]},"acm000001687jsd":{"type":"ControlElement","id":"acm000001687jsd","name":"automigrate","comment":"Migrate the configuration, database, and state files. If any migration occurs, print out a notice with some helpful next steps.","startLine":354,"endLine":374,"calleeNames":["migrate_config","migrate_db","migrate_state","print_","colorize","format","displayable_path","input_"]},"acm000001688jsd":{"type":"ControlElement","id":"acm000001688jsd","name":"migrate_func","comment":"Explicit command for migrating files. Existing files in each destination are moved aside.","startLine":380,"endLine":398,"calleeNames":["migrate_config","info","format","displayable_path","migrate_db","migrate_state"]},"acm000001689jsd":{"type":"CodeCompilationUnit","id":"acm000001689jsd","name":"migrate","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nConversion from legacy (pre-1.1) configuration to Confit/YAML configuration.","parentId":"acm000001722jsd","content":["acm000001676jsd","acm000001677jsd","acm000001678jsd","acm000001679jsd","acm000001680jsd","acm000001681jsd","acm000001682jsd","acm000001683jsd","acm000001684jsd","acm000001685jsd","acm000001686jsd","acm000001687jsd","acm000001688jsd"],"pathElements":["ui"],"extension":"py","language":"PYTHON3","importedModuleNames":["os","ConfigParser","codecs","yaml","logging","time","itertools","re","beets","beets.util","beets.ui","beets.util.confit"]},"acm000001690jsd":{"type":"ClassUnit","id":"acm000001690jsd","name":"UserError","comment":"Main logger.","compilationUnitId":"acm000001721jsd","parentDatatypeId":null,"startLine":61,"endLine":62,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001691jsd":{"type":"ControlElement","id":"acm000001691jsd","name":"__init__","comment":"Creates a new subcommand. name is the primary way to invoke the subcommand; aliases are alternate names. parser is an OptionParser responsible for parsing the subcommand's options. help is a short description of the command. If no parser is given, it defaults to a new, empty OptionParser.","startLine":538,"endLine":548,"calleeNames":["OptionParser"]},"acm000001692jsd":{"type":"ClassUnit","id":"acm000001692jsd","name":"Subcommand","comment":"A subcommand of a root command-line application that may be invoked by a SubcommandOptionParser.","compilationUnitId":"acm000001721jsd","parentDatatypeId":null,"startLine":534,"endLine":548,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001691jsd"]},"acm000001693jsd":{"type":"ControlElement","id":"acm000001693jsd","name":"__init__","comment":"Creates a new subcommand. name is the primary way to invoke the subcommand; aliases are alternate names. parser is an OptionParser responsible for parsing the subcommand's options. help is a short description of the command. If no parser is given, it defaults to a new, empty OptionParser.","startLine":538,"endLine":548,"calleeNames":["OptionParser"]},"acm000001694jsd":{"type":"ControlElement","id":"acm000001694jsd","name":"add_subcommand","comment":"Adds a Subcommand object to the parser's list of commands.\nAdd the list of subcommands to the help message.","startLine":585,"endLine":588,"calleeNames":["append"]},"acm000001695jsd":{"type":"ControlElement","id":"acm000001695jsd","name":"format_help","comment":"Get the original help message, to which we will append.","startLine":591,"endLine":638,"calleeNames":["format_help","append","format_heading","indent","join","len","max","zip","wrap","extend","dedent"]},"acm000001696jsd":{"type":"ControlElement","id":"acm000001696jsd","name":"_subcommand_for_name","comment":"Return the subcommand in self.subcommands matching the given name. The name may either be the name of a subcommand or an alias. If no subcommand matches, returns None.","startLine":640,"endLine":649,"calleeNames":[]},"acm000001697jsd":{"type":"ControlElement","id":"acm000001697jsd","name":"parse_args","comment":"Like OptionParser.parse_args, but returns these four items: - options: the options passed to the root parser - subcommand: the Subcommand object that was invoked - suboptions: the options passed to the subcommand parser - subargs: the positional arguments passed to the subcommand\nNo command given.\nparticular\ngeneral\nThe root parser and its main function.","startLine":651,"endLine":686,"calleeNames":["parse_args","print_help","exit","pop","_subcommand_for_name","error","format"]},"acm000001698jsd":{"type":"ClassUnit","id":"acm000001698jsd","name":"SubcommandsOptionParser","comment":"A variant of OptionParser that parses subcommands and their arguments.\nA singleton command used to give help on other subcommands.","compilationUnitId":"acm000001721jsd","parentDatatypeId":null,"startLine":550,"endLine":686,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001693jsd","acm000001694jsd","acm000001695jsd","acm000001696jsd","acm000001697jsd"]},"acm000001699jsd":{"type":"ControlElement","id":"acm000001699jsd","name":"_encoding","comment":"Tries to guess the encoding used by the terminal.\nConfigured override?","startLine":70,"endLine":83,"calleeNames":["get","getdefaultlocale"]},"acm000001700jsd":{"type":"ControlElement","id":"acm000001700jsd","name":"decargs","comment":"Given a list of command-line argument bytestrings, attempts to decode them to Unicode strings.","startLine":85,"endLine":89,"calleeNames":["decode","_encoding"]},"acm000001701jsd":{"type":"ControlElement","id":"acm000001701jsd","name":"print_","comment":"Like print, but rather than raising an error when a character is not in the terminal's encoding's character set, just silently replaces it.","startLine":91,"endLine":105,"calleeNames":["isinstance","join","encode","_encoding","print"]},"acm000001702jsd":{"type":"ControlElement","id":"acm000001702jsd","name":"input_","comment":"Like `raw_input`, but decodes the result to a Unicode string. Raises a UserError if stdin is not available. The prompt is sent to stdout rather than stderr. A printed between the prompt and the input cursor.\nraw_input incorrectly sends prompts to stderr, not stdout, so we\nuse print() explicitly to display prompts.\nhttp://bugs.python.org/issue1927","startLine":107,"endLine":126,"calleeNames":["isinstance","encode","_encoding","print","raw_input","UserError","decode"]},"acm000001703jsd":{"type":"ControlElement","id":"acm000001703jsd","name":"input_options","comment":"Prompts a user for input. The sequence of `options` defines the choices the user has. A single-letter shortcut is inferred for each option; the user's choice is returned as that single, lower-case letter. The options should be provided as lower-case strings unless a particular shortcut is desired; in that case, only that letter should be capitalized. By default, the first option is the default. `default` can be provided to override this. If `require` is provided, then there is no default. The prompt and fallback prompt are also inferred but can be overridden. If numrange is provided, it is a pair of `(high, low)` (both ints) indicating that, in addition to `options`, the user may enter an integer in that inclusive range. `max_width` specifies the maximum number of columns in the automatically generated prompt string.\nAssign single letters to each option. Also capitalize the options\nto indicate the letter.","startLine":128,"endLine":284,"calleeNames":["isalpha","upper","ValueError","lower","index","isinstance","colorize","append","str","len","enumerate","zip","join","input_","strip","int"]},"acm000001704jsd":{"type":"ControlElement","id":"acm000001704jsd","name":"input_yn","comment":"Prompts the user for a \"yes\" or \"no\" response. The default is \"yes\" unless `require` is `True`, in which case there is no default.","startLine":286,"endLine":293,"calleeNames":["input_options"]},"acm000001705jsd":{"type":"ControlElement","id":"acm000001705jsd","name":"human_bytes","comment":"Formats size, a number of bytes, in a human-readable way.","startLine":295,"endLine":302,"calleeNames":[]},"acm000001706jsd":{"type":"ControlElement","id":"acm000001706jsd","name":"human_seconds","comment":"Formats interval, a number of seconds, as a human-readable time interval using English words.","startLine":304,"endLine":328,"calleeNames":["range","len","float"]},"acm000001707jsd":{"type":"ControlElement","id":"acm000001707jsd","name":"human_seconds_short","comment":"Formats a number of seconds as a short human-readable M:SS string.","startLine":330,"endLine":335,"calleeNames":["int"]},"acm000001708jsd":{"type":"ControlElement","id":"acm000001708jsd","name":"_colorize","comment":"Returns a string that prints the given text in the given color in a terminal that is ANSI color-aware. The color must be something in DARK_COLORS or LIGHT_COLORS.","startLine":346,"endLine":357,"calleeNames":["index","ValueError"]},"acm000001709jsd":{"type":"ControlElement","id":"acm000001709jsd","name":"colorize","comment":"Colorize text if colored output is enabled. (Like _colorize but conditional.)","startLine":359,"endLine":366,"calleeNames":["_colorize"]},"acm000001710jsd":{"type":"ControlElement","id":"acm000001710jsd","name":"_colordiff","comment":"Given two values, return the same pair of strings except with their differences highlighted in the specified color. Strings are highlighted intelligently to show differences; other values are stringified and highlighted in their entirety.\nNon-strings: use ordinary equality.","startLine":368,"endLine":405,"calleeNames":["isinstance","unicode","colorize","SequenceMatcher","get_opcodes","append","join"]},"acm000001711jsd":{"type":"ControlElement","id":"acm000001711jsd","name":"colordiff","comment":"Colorize differences between two values if color is enabled. (Like _colordiff but conditional.)","startLine":407,"endLine":414,"calleeNames":["_colordiff","unicode"]},"acm000001712jsd":{"type":"ControlElement","id":"acm000001712jsd","name":"color_diff_suffix","comment":"Colorize the differing suffix between two strings.","startLine":416,"endLine":437,"calleeNames":["unicode","range","min","len","colorize"]},"acm000001713jsd":{"type":"ControlElement","id":"acm000001713jsd","name":"get_path_formats","comment":"Get the configuration's path formats as a list of query/template pairs.","startLine":439,"endLine":447,"calleeNames":["items","get","append","Template"]},"acm000001714jsd":{"type":"ControlElement","id":"acm000001714jsd","name":"get_replacements","comment":"Confit validation function that reads regex/string pairs.","startLine":449,"endLine":461,"calleeNames":["get","items","append","compile","UserError","format"]},"acm000001715jsd":{"type":"ControlElement","id":"acm000001715jsd","name":"get_plugin_paths","comment":"Get the list of search paths for plugins from the config file. The value for \"pluginpath\" may be a single string or a list of strings.","startLine":463,"endLine":475,"calleeNames":["get","isinstance","ConfigTypeError","map"]},"acm000001716jsd":{"type":"ControlElement","id":"acm000001716jsd","name":"_pick_format","comment":"Pick a format string for printing Album or Item objects, falling back to config options and defaults.","startLine":477,"endLine":486,"calleeNames":["get"]},"acm000001717jsd":{"type":"ControlElement","id":"acm000001717jsd","name":"print_obj","comment":"Print an Album or Item object. If `fmt` is specified, use that format string. Otherwise, use the configured template.","startLine":488,"endLine":501,"calleeNames":["isinstance","_pick_format","Template","print_","evaluate_template"]},"acm000001718jsd":{"type":"ControlElement","id":"acm000001718jsd","name":"term_width","comment":"Get the width (columns) of the terminal.","startLine":503,"endLine":523,"calleeNames":["get","ioctl","unpack"]},"acm000001719jsd":{"type":"ControlElement","id":"acm000001719jsd","name":"_raw_main","comment":"A helper function for `main` without top-level exception handling.\nLoad global configuration files.\nTemporary: Migrate from 1.0-style configuration.\nGet the default subcommands.\nAdd plugin paths.\nLoad requested plugins.\nConstruct the root parser.","startLine":691,"endLine":764,"calleeNames":["read","automigrate","get_plugin_paths","load_plugins","as_str_seq","send","list","commands","append","SubcommandsOptionParser","add_option","parse_args","set_args","as_filename","Library","get_path_formats","Template","get","as_number","get_replacements","UserError","format","displayable_path","setLevel","debug","config_dir","configure","func"]},"acm000001720jsd":{"type":"ControlElement","id":"acm000001720jsd","name":"main","comment":"Run the main command-line interface for beets. Includes top-level exception handlers that print friendly error messages.\n\"Broken pipe\". End silently.\nSilently ignore ^C.","startLine":766,"endLine":789,"calleeNames":["_raw_main","error","format","exit","log"]},"acm000001721jsd":{"type":"CodeCompilationUnit","id":"acm000001721jsd","name":"__init__","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nThis module contains all of the core logic for beets' command-line interface. To invoke the CLI, just call beets.ui.main(). The actual CLI commands are implemented in the ui.commands module.\nOn Windows platforms, use colorama to support \"ANSI\" terminal colors.\nConstants.","parentId":"acm000001722jsd","content":["acm000001690jsd","acm000001692jsd","acm000001698jsd","acm000001699jsd","acm000001700jsd","acm000001701jsd","acm000001702jsd","acm000001703jsd","acm000001704jsd","acm000001705jsd","acm000001706jsd","acm000001707jsd","acm000001708jsd","acm000001709jsd","acm000001710jsd","acm000001711jsd","acm000001712jsd","acm000001713jsd","acm000001714jsd","acm000001715jsd","acm000001716jsd","acm000001717jsd","acm000001718jsd","acm000001719jsd","acm000001720jsd"],"pathElements":["ui"],"extension":"py","language":"PYTHON3","importedModuleNames":["__future__.print_function","locale","optparse","textwrap","sys","difflib.SequenceMatcher","logging","sqlite3","errno","re","struct","beets.library","beets.plugins","beets.util","beets.util.functemplate.Template","beets.config","beets.util.confit","beets.autotag.mb","beets.ui.migrate","beets.ui.commands.default_commands"]},"acm000001722jsd":{"type":"CodePackage","id":"acm000001722jsd","name":"ui","comment":"","parentId":null,"content":["acm000001674jsd","acm000001689jsd","acm000001721jsd"]},"acm000001723jsd":{"type":"ClassUnit","id":"acm000001723jsd","name":"ArtResizerError","comment":"Raised when an error occurs during image resizing.","compilationUnitId":"acm000001738jsd","parentDatatypeId":null,"startLine":35,"endLine":36,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001724jsd":{"type":"ControlElement","id":"acm000001724jsd","name":"__init__","comment":"","startLine":127,"endLine":129,"calleeNames":["super","__init__"]},"acm000001725jsd":{"type":"ControlElement","id":"acm000001725jsd","name":"shared","comment":"","startLine":132,"endLine":135,"calleeNames":["cls"]},"acm000001726jsd":{"type":"ClassUnit","id":"acm000001726jsd","name":"Shareable","comment":"A pseudo-singleton metaclass that allows both shared and non-shared instances. The ``MyClass.shared`` property holds a lazily-created shared instance of ``MyClass`` while calling ``MyClass()`` to construct a new object works as usual.","compilationUnitId":"acm000001738jsd","parentDatatypeId":null,"startLine":121,"endLine":135,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001724jsd","acm000001725jsd"]},"acm000001727jsd":{"type":"ControlElement","id":"acm000001727jsd","name":"__init__","comment":"","startLine":127,"endLine":129,"calleeNames":["super","__init__"]},"acm000001728jsd":{"type":"ControlElement","id":"acm000001728jsd","name":"resize","comment":"Manipulate an image file according to the method, returning a new path. For PIL or IMAGEMAGIC methods, resizes the image to a temporary file. For WEBPROXY, returns `path_in` unmodified.","startLine":150,"endLine":159,"calleeNames":["func"]},"acm000001729jsd":{"type":"ControlElement","id":"acm000001729jsd","name":"proxy_url","comment":"Modifies an image URL according the method, returning a new URL. For WEBPROXY, a URL on the proxy server is returned. Otherwise, the URL is returned unmodified.","startLine":161,"endLine":169,"calleeNames":["resize_url"]},"acm000001730jsd":{"type":"ControlElement","id":"acm000001730jsd","name":"local","comment":"A boolean indicating whether the resizing method is performed locally (i.e., PIL or IMAGEMAGICK).","startLine":172,"endLine":176,"calleeNames":[]},"acm000001731jsd":{"type":"ControlElement","id":"acm000001731jsd","name":"_guess_method","comment":"Determine which resizing method to use. Returns PIL, IMAGEMAGICK, or WEBPROXY depending on available dependencies.\nTry importing PIL.\nTry invoking ImageMagick's \"convert\".\nsystem32/convert.exe may be interfering\nFall back to Web proxy method.","startLine":179,"endLine":199,"calleeNames":["__import__","check_output","lower"]},"acm000001732jsd":{"type":"ClassUnit","id":"acm000001732jsd","name":"ArtResizer","comment":"A singleton class that performs image resizes.","compilationUnitId":"acm000001738jsd","parentDatatypeId":null,"startLine":138,"endLine":199,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001727jsd","acm000001728jsd","acm000001729jsd","acm000001730jsd","acm000001731jsd"]},"acm000001733jsd":{"type":"ControlElement","id":"acm000001733jsd","name":"call","comment":"Execute the command indicated by `args` (a list of strings) and return the command's output. The stderr stream is ignored. If the command exits abnormally, a ArtResizerError is raised.","startLine":40,"endLine":50,"calleeNames":["command_output","ArtResizerError","format"]},"acm000001734jsd":{"type":"ControlElement","id":"acm000001734jsd","name":"resize_url","comment":"Return a proxied image URL that resizes the original image to maxwidth (preserving aspect ratio).","startLine":53,"endLine":60,"calleeNames":["format","urlencode","replace","str"]},"acm000001735jsd":{"type":"ControlElement","id":"acm000001735jsd","name":"temp_file_for","comment":"Return an unused filename with the same extension as the specified path.","startLine":63,"endLine":69,"calleeNames":["splitext","NamedTemporaryFile"]},"acm000001736jsd":{"type":"ControlElement","id":"acm000001736jsd","name":"pil_resize","comment":"Resize using Python Imaging Library (PIL). Return the output path of resized image.","startLine":72,"endLine":92,"calleeNames":["temp_file_for","debug","format","displayable_path","open","syspath","thumbnail","save","error"]},"acm000001737jsd":{"type":"ControlElement","id":"acm000001737jsd","name":"im_resize","comment":"Resize using ImageMagick's ``convert`` tool. tool. Return the output path of resized image.","startLine":95,"endLine":112,"calleeNames":["temp_file_for","debug","format","displayable_path","call","syspath"]},"acm000001738jsd":{"type":"CodeCompilationUnit","id":"acm000001738jsd","name":"artresizer","comment":"This file is part of beets.\nCopyright 2013, Fabrice Laporte\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nAbstraction layer to resize images using PIL, ImageMagick, or a public resizing proxy if neither is available.\nResizing methods","parentId":"acm000001984jsd","content":["acm000001723jsd","acm000001726jsd","acm000001732jsd","acm000001733jsd","acm000001734jsd","acm000001735jsd","acm000001736jsd","acm000001737jsd"],"pathElements":["util"],"extension":"py","language":"PYTHON3","importedModuleNames":["urllib","subprocess","os","tempfile.NamedTemporaryFile","logging","beets.util","PIL.Image"]},"acm000001739jsd":{"type":"ClassUnit","id":"acm000001739jsd","name":"Event","comment":"Just a base class identifying Bluelet events. An event is an object yielded from a Bluelet thread coroutine to suspend operation and communicate with the scheduler.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":33,"endLine":38,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001740jsd":{"type":"ControlElement","id":"acm000001740jsd","name":"waitables","comment":"Return \"waitable\" objects to pass to select(). Should return three iterables for input readiness, output readiness, and exceptional conditions (i.e., the three lists passed to select()).","startLine":45,"endLine":51,"calleeNames":[]},"acm000001741jsd":{"type":"ControlElement","id":"acm000001741jsd","name":"fire","comment":"Called when an assoicated file descriptor becomes ready (i.e., is returned from a select() call).","startLine":53,"endLine":57,"calleeNames":[]},"acm000001742jsd":{"type":"ClassUnit","id":"acm000001742jsd","name":"WaitableEvent","comment":"A waitable event is one encapsulating an action that can be waited for using a select() call. That is, it's an event with an associated file descriptor.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":40,"endLine":57,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001740jsd","acm000001741jsd"]},"acm000001743jsd":{"type":"ControlElement","id":"acm000001743jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001744jsd":{"type":"ClassUnit","id":"acm000001744jsd","name":"ValueEvent","comment":"An event that does nothing but return a fixed value.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":59,"endLine":62,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001743jsd"]},"acm000001745jsd":{"type":"ControlElement","id":"acm000001745jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001746jsd":{"type":"ClassUnit","id":"acm000001746jsd","name":"ExceptionEvent","comment":"Raise an exception at the yield point. Used internally.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":64,"endLine":67,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001745jsd"]},"acm000001747jsd":{"type":"ControlElement","id":"acm000001747jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001748jsd":{"type":"ClassUnit","id":"acm000001748jsd","name":"SpawnEvent","comment":"Add a new coroutine thread to the scheduler.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":69,"endLine":72,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001747jsd"]},"acm000001749jsd":{"type":"ControlElement","id":"acm000001749jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001750jsd":{"type":"ClassUnit","id":"acm000001750jsd","name":"JoinEvent","comment":"Suspend the thread until the specified child thread has completed.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":74,"endLine":79,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001749jsd"]},"acm000001751jsd":{"type":"ControlElement","id":"acm000001751jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001752jsd":{"type":"ClassUnit","id":"acm000001752jsd","name":"DelegationEvent","comment":"Suspend execution of the current thread, start a new thread and, once the child thread finished, return control to the parent thread.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":81,"endLine":87,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001751jsd"]},"acm000001753jsd":{"type":"ControlElement","id":"acm000001753jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001754jsd":{"type":"ClassUnit","id":"acm000001754jsd","name":"ReturnEvent","comment":"Return a value the current thread's delegator at the point of delegation. Ends the current (delegate) thread.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":89,"endLine":94,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001753jsd"]},"acm000001755jsd":{"type":"ControlElement","id":"acm000001755jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001756jsd":{"type":"ControlElement","id":"acm000001756jsd","name":"time_left","comment":"","startLine":102,"endLine":103,"calleeNames":["max","time"]},"acm000001757jsd":{"type":"ClassUnit","id":"acm000001757jsd","name":"SleepEvent","comment":"Suspend the thread for a given duration.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":96,"endLine":103,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001755jsd","acm000001756jsd"]},"acm000001758jsd":{"type":"ControlElement","id":"acm000001758jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001759jsd":{"type":"ControlElement","id":"acm000001759jsd","name":"waitables","comment":"Return \"waitable\" objects to pass to select(). Should return three iterables for input readiness, output readiness, and exceptional conditions (i.e., the three lists passed to select()).","startLine":45,"endLine":51,"calleeNames":[]},"acm000001760jsd":{"type":"ControlElement","id":"acm000001760jsd","name":"fire","comment":"Called when an assoicated file descriptor becomes ready (i.e., is returned from a select() call).","startLine":53,"endLine":57,"calleeNames":[]},"acm000001761jsd":{"type":"ClassUnit","id":"acm000001761jsd","name":"ReadEvent","comment":"Reads from a file-like object.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":105,"endLine":115,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001758jsd","acm000001759jsd","acm000001760jsd"]},"acm000001762jsd":{"type":"ControlElement","id":"acm000001762jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001763jsd":{"type":"ControlElement","id":"acm000001763jsd","name":"waitable","comment":"","startLine":123,"endLine":124,"calleeNames":[]},"acm000001764jsd":{"type":"ControlElement","id":"acm000001764jsd","name":"fire","comment":"Called when an assoicated file descriptor becomes ready (i.e., is returned from a select() call).","startLine":53,"endLine":57,"calleeNames":[]},"acm000001765jsd":{"type":"ClassUnit","id":"acm000001765jsd","name":"WriteEvent","comment":"Writes to a file-like object.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":117,"endLine":127,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001762jsd","acm000001763jsd","acm000001764jsd"]},"acm000001766jsd":{"type":"ControlElement","id":"acm000001766jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001767jsd":{"type":"ControlElement","id":"acm000001767jsd","name":"reraise","comment":"","startLine":193,"endLine":194,"calleeNames":["_reraise"]},"acm000001768jsd":{"type":"ClassUnit","id":"acm000001768jsd","name":"ThreadException","comment":"","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":189,"endLine":194,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001766jsd","acm000001767jsd"]},"acm000001769jsd":{"type":"ControlElement","id":"acm000001769jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001770jsd":{"type":"ControlElement","id":"acm000001770jsd","name":"accept","comment":"An event that waits for a connection on the listening socket. When a connection is made, the event returns a Connection object.","startLine":360,"endLine":365,"calleeNames":["AcceptEvent"]},"acm000001771jsd":{"type":"ControlElement","id":"acm000001771jsd","name":"close","comment":"Immediately close the listening socket. (Not an event.)","startLine":367,"endLine":370,"calleeNames":["close"]},"acm000001772jsd":{"type":"ClassUnit","id":"acm000001772jsd","name":"Listener","comment":"A socket wrapper object for listening sockets.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":347,"endLine":370,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001769jsd","acm000001770jsd","acm000001771jsd"]},"acm000001773jsd":{"type":"ControlElement","id":"acm000001773jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001774jsd":{"type":"ControlElement","id":"acm000001774jsd","name":"close","comment":"Immediately close the listening socket. (Not an event.)","startLine":367,"endLine":370,"calleeNames":["close"]},"acm000001775jsd":{"type":"ControlElement","id":"acm000001775jsd","name":"recv","comment":"Read at most size bytes of data from the socket.\nWe already have data read previously.","startLine":384,"endLine":392,"calleeNames":["ValueEvent","ReceiveEvent"]},"acm000001776jsd":{"type":"ControlElement","id":"acm000001776jsd","name":"send","comment":"Sends data on the socket, returning the number of bytes successfully sent.","startLine":394,"endLine":398,"calleeNames":["SendEvent"]},"acm000001777jsd":{"type":"ControlElement","id":"acm000001777jsd","name":"sendall","comment":"Send all of data on the socket.","startLine":400,"endLine":402,"calleeNames":["SendEvent"]},"acm000001778jsd":{"type":"ControlElement","id":"acm000001778jsd","name":"readline","comment":"Reads a line (delimited by terminator) from the socket.","startLine":404,"endLine":419,"calleeNames":["split","ReturnEvent","ReceiveEvent"]},"acm000001779jsd":{"type":"ClassUnit","id":"acm000001779jsd","name":"Connection","comment":"A socket wrapper object for connected sockets.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":372,"endLine":419,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001773jsd","acm000001774jsd","acm000001775jsd","acm000001776jsd","acm000001777jsd","acm000001778jsd"]},"acm000001780jsd":{"type":"ControlElement","id":"acm000001780jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001781jsd":{"type":"ControlElement","id":"acm000001781jsd","name":"waitables","comment":"Return \"waitable\" objects to pass to select(). Should return three iterables for input readiness, output readiness, and exceptional conditions (i.e., the three lists passed to select()).","startLine":45,"endLine":51,"calleeNames":[]},"acm000001782jsd":{"type":"ControlElement","id":"acm000001782jsd","name":"fire","comment":"Called when an assoicated file descriptor becomes ready (i.e., is returned from a select() call).","startLine":53,"endLine":57,"calleeNames":[]},"acm000001783jsd":{"type":"ClassUnit","id":"acm000001783jsd","name":"AcceptEvent","comment":"An event for Listener objects (listening sockets) that suspends execution until the socket gets a connection.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":421,"endLine":433,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001780jsd","acm000001781jsd","acm000001782jsd"]},"acm000001784jsd":{"type":"ControlElement","id":"acm000001784jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001785jsd":{"type":"ControlElement","id":"acm000001785jsd","name":"waitables","comment":"Return \"waitable\" objects to pass to select(). Should return three iterables for input readiness, output readiness, and exceptional conditions (i.e., the three lists passed to select()).","startLine":45,"endLine":51,"calleeNames":[]},"acm000001786jsd":{"type":"ControlElement","id":"acm000001786jsd","name":"fire","comment":"Called when an assoicated file descriptor becomes ready (i.e., is returned from a select() call).","startLine":53,"endLine":57,"calleeNames":[]},"acm000001787jsd":{"type":"ClassUnit","id":"acm000001787jsd","name":"ReceiveEvent","comment":"An event for Connection objects (connected sockets) for asynchronously reading data.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":435,"endLine":447,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001784jsd","acm000001785jsd","acm000001786jsd"]},"acm000001788jsd":{"type":"ControlElement","id":"acm000001788jsd","name":"__init__","comment":"","startLine":61,"endLine":62,"calleeNames":[]},"acm000001789jsd":{"type":"ControlElement","id":"acm000001789jsd","name":"waitables","comment":"Return \"waitable\" objects to pass to select(). Should return three iterables for input readiness, output readiness, and exceptional conditions (i.e., the three lists passed to select()).","startLine":45,"endLine":51,"calleeNames":[]},"acm000001790jsd":{"type":"ControlElement","id":"acm000001790jsd","name":"fire","comment":"Called when an assoicated file descriptor becomes ready (i.e., is returned from a select() call).","startLine":53,"endLine":57,"calleeNames":[]},"acm000001791jsd":{"type":"ClassUnit","id":"acm000001791jsd","name":"SendEvent","comment":"An event for Connection objects (connected sockets) for asynchronously writing data.","compilationUnitId":"acm000001804jsd","parentDatatypeId":null,"startLine":449,"endLine":465,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001788jsd","acm000001789jsd","acm000001790jsd"]},"acm000001792jsd":{"type":"ControlElement","id":"acm000001792jsd","name":"_event_select","comment":"Perform a select() over all the Events provided, returning the ones ready to be fired. Only WaitableEvents (including SleepEvents) matter here; all other events are ignored (and thus postponed).\nGather waitables and wakeup times.","startLine":132,"endLine":187,"calleeNames":["isinstance","min","waitables","max","time","select","sleep","set","add","time_left"]},"acm000001793jsd":{"type":"ControlElement","id":"acm000001793jsd","name":"run","comment":"Schedules a coroutine, running it to completion. This encapsulates the Bluelet scheduler, which the root coroutine can add to by spawning new coroutines.\nThe \"threads\" dictionary keeps track of all the currently-\nexecuting and suspended coroutines. It maps coroutines to their\ncurrently \"blocking\" event. The event value may be SUSPENDED if\nthe coroutine is waiting on some other condition: namely, a\ndelegated coroutine or a joined coroutine. In this case, the\ncoroutine should *also* appear as a value in one of the below\ndictionaries `delegators` or `joiners`.","startLine":198,"endLine":342,"calleeNames":["ValueEvent","defaultdict","throw","send","complete_thread","ThreadException","exc_info","isinstance","DelegationEvent","list","items","advance_thread","append","dict","_event_select","values","fire","print_exc","ReturnEvent","ExceptionEvent","close","reraise"]},"acm000001794jsd":{"type":"ControlElement","id":"acm000001794jsd","name":"null","comment":"Event: yield to the scheduler without doing anything special.","startLine":471,"endLine":474,"calleeNames":["ValueEvent"]},"acm000001795jsd":{"type":"ControlElement","id":"acm000001795jsd","name":"spawn","comment":"Event: add another coroutine to the scheduler. Both the parent and child coroutines run concurrently.","startLine":476,"endLine":482,"calleeNames":["isinstance","ValueError","str","SpawnEvent"]},"acm000001796jsd":{"type":"ControlElement","id":"acm000001796jsd","name":"call","comment":"Event: delegate to another coroutine. The current coroutine is resumed once the sub-coroutine finishes. If the sub-coroutine returns a value using end(), then this event returns that value.","startLine":484,"endLine":491,"calleeNames":["isinstance","ValueError","str","DelegationEvent"]},"acm000001797jsd":{"type":"ControlElement","id":"acm000001797jsd","name":"end","comment":"Event: ends the coroutine and returns a value to its delegator.","startLine":493,"endLine":497,"calleeNames":["ReturnEvent"]},"acm000001798jsd":{"type":"ControlElement","id":"acm000001798jsd","name":"read","comment":"Event: read from a file descriptor asynchronously.\nRead all.","startLine":499,"endLine":514,"calleeNames":["read","append","ReturnEvent","join","DelegationEvent","reader","ReadEvent"]},"acm000001799jsd":{"type":"ControlElement","id":"acm000001799jsd","name":"write","comment":"Event: write to a file descriptor asynchronously.","startLine":516,"endLine":518,"calleeNames":["WriteEvent"]},"acm000001800jsd":{"type":"ControlElement","id":"acm000001800jsd","name":"connect","comment":"Event: connect to a network address and return a Connection object for communicating on the socket.","startLine":520,"endLine":526,"calleeNames":["create_connection","ValueEvent","Connection"]},"acm000001801jsd":{"type":"ControlElement","id":"acm000001801jsd","name":"sleep","comment":"Event: suspend the thread for ``duration`` seconds.","startLine":528,"endLine":531,"calleeNames":["SleepEvent"]},"acm000001802jsd":{"type":"ControlElement","id":"acm000001802jsd","name":"join","comment":"Suspend the thread until another, previously `spawn`ed thread completes.\nConvenience function for running socket servers.","startLine":533,"endLine":537,"calleeNames":["JoinEvent"]},"acm000001803jsd":{"type":"ControlElement","id":"acm000001803jsd","name":"server","comment":"A coroutine that runs a network server. Host and port specify the listening address. func should be a coroutine that takes a single parameter, a Connection object. The coroutine is invoked for every incoming connection on the listening socket.","startLine":542,"endLine":562,"calleeNames":["func","close","Listener","accept","spawn","handler"]},"acm000001804jsd":{"type":"CodeCompilationUnit","id":"acm000001804jsd","name":"bluelet","comment":"Extremely simple pure-Python implementation of coroutine-style asynchronous socket I/O. Inspired by, but inferior to, Eventlet. Bluelet can also be thought of as a less-terrible replacement for asyncore. Bluelet: easy concurrency without all the messy parallelism.\nA little bit of \"six\" (Python 2/3 compatibility): cope with PEP 3109 syntax\nchanges.","parentId":"acm000001984jsd","content":["acm000001739jsd","acm000001742jsd","acm000001744jsd","acm000001746jsd","acm000001748jsd","acm000001750jsd","acm000001752jsd","acm000001754jsd","acm000001757jsd","acm000001761jsd","acm000001765jsd","acm000001768jsd","acm000001772jsd","acm000001779jsd","acm000001783jsd","acm000001787jsd","acm000001791jsd","acm000001792jsd","acm000001793jsd","acm000001794jsd","acm000001795jsd","acm000001796jsd","acm000001797jsd","acm000001798jsd","acm000001799jsd","acm000001800jsd","acm000001801jsd","acm000001802jsd","acm000001803jsd"],"pathElements":["util"],"extension":"py","language":"PYTHON3","importedModuleNames":["socket","select","sys","types","errno","traceback","time","collections"]},"acm000001805jsd":{"type":"ClassUnit","id":"acm000001805jsd","name":"ConfigError","comment":"Base class for exceptions raised when querying a configuration.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":66,"endLine":67,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001806jsd":{"type":"ClassUnit","id":"acm000001806jsd","name":"NotFoundError","comment":"A requested value could not be found in the configuration trees.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":70,"endLine":71,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001807jsd":{"type":"ClassUnit","id":"acm000001807jsd","name":"ConfigTypeError","comment":"The value in the configuration did not match the expected type.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":74,"endLine":75,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001808jsd":{"type":"ClassUnit","id":"acm000001808jsd","name":"ConfigValueError","comment":"The value in the configuration is illegal.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":78,"endLine":79,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001809jsd":{"type":"ControlElement","id":"acm000001809jsd","name":"__init__","comment":"","startLine":83,"endLine":99,"calleeNames":["format","isinstance","super","__init__"]},"acm000001810jsd":{"type":"ClassUnit","id":"acm000001810jsd","name":"ConfigReadError","comment":"A configuration file could not be read.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":81,"endLine":99,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001809jsd"]},"acm000001811jsd":{"type":"ControlElement","id":"acm000001811jsd","name":"__init__","comment":"","startLine":83,"endLine":99,"calleeNames":["format","isinstance","super","__init__"]},"acm000001812jsd":{"type":"ControlElement","id":"acm000001812jsd","name":"__repr__","comment":"","startLine":115,"endLine":120,"calleeNames":["format","super","__repr__","repr"]},"acm000001813jsd":{"type":"ControlElement","id":"acm000001813jsd","name":"of","comment":"Given either a dictionary or a `ConfigSource` object, return a `ConfigSource` object. This lets a function accept either type of object as an argument.","startLine":123,"endLine":133,"calleeNames":["isinstance","ConfigSource","TypeError"]},"acm000001814jsd":{"type":"ClassUnit","id":"acm000001814jsd","name":"ConfigSource","comment":"A dictionary augmented with metadata about the source of the configuration.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":104,"endLine":133,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001811jsd","acm000001812jsd","acm000001813jsd"]},"acm000001815jsd":{"type":"ControlElement","id":"acm000001815jsd","name":"resolve","comment":"The core (internal) data retrieval method. Generates (value, source) pairs for each source that contains a value for this view. May raise ConfigTypeError if a type error occurs while traversing a source.","startLine":149,"endLine":155,"calleeNames":[]},"acm000001816jsd":{"type":"ControlElement","id":"acm000001816jsd","name":"first","comment":"Returns a (value, source) pair for the first object found for this view. This amounts to the first element returned by `resolve`. If no values are available, a NotFoundError is raised.","startLine":157,"endLine":167,"calleeNames":["resolve","iter_first","NotFoundError","format"]},"acm000001817jsd":{"type":"ControlElement","id":"acm000001817jsd","name":"add","comment":"Set the *default* value for this configuration view. The specified value is added as the lowest-priority configuration data source.","startLine":169,"endLine":174,"calleeNames":[]},"acm000001818jsd":{"type":"ControlElement","id":"acm000001818jsd","name":"set","comment":"*Override* the value for this configuration view. The specified value is added as the highest-priority configuration data source.","startLine":176,"endLine":181,"calleeNames":[]},"acm000001819jsd":{"type":"ControlElement","id":"acm000001819jsd","name":"root","comment":"The RootView object from which this view is descended.","startLine":183,"endLine":186,"calleeNames":[]},"acm000001820jsd":{"type":"ControlElement","id":"acm000001820jsd","name":"__repr__","comment":"","startLine":115,"endLine":120,"calleeNames":["format","super","__repr__","repr"]},"acm000001821jsd":{"type":"ControlElement","id":"acm000001821jsd","name":"__getitem__","comment":"Get a subview of this view.","startLine":191,"endLine":193,"calleeNames":["Subview"]},"acm000001822jsd":{"type":"ControlElement","id":"acm000001822jsd","name":"__setitem__","comment":"Create an overlay source to assign a given key under this view.","startLine":195,"endLine":199,"calleeNames":["set"]},"acm000001823jsd":{"type":"ControlElement","id":"acm000001823jsd","name":"set_args","comment":"Overlay parsed command-line arguments, generated by a library like argparse or optparse, onto this view's value.","startLine":201,"endLine":209,"calleeNames":["items","set"]},"acm000001824jsd":{"type":"ControlElement","id":"acm000001824jsd","name":"__str__","comment":"Gets the value for this view as a byte string.","startLine":216,"endLine":218,"calleeNames":["str","get"]},"acm000001825jsd":{"type":"ControlElement","id":"acm000001825jsd","name":"__unicode__","comment":"Gets the value for this view as a unicode string. (Python 2 only.)","startLine":220,"endLine":224,"calleeNames":["unicode","get"]},"acm000001826jsd":{"type":"ControlElement","id":"acm000001826jsd","name":"__nonzero__","comment":"Gets the value for this view as a boolean. (Python 2 only.)","startLine":226,"endLine":229,"calleeNames":["__bool__"]},"acm000001827jsd":{"type":"ControlElement","id":"acm000001827jsd","name":"__bool__","comment":"Gets the value for this view as a boolean. (Python 3 only.)\nDictionary emulation methods.","startLine":231,"endLine":234,"calleeNames":["bool","get"]},"acm000001828jsd":{"type":"ControlElement","id":"acm000001828jsd","name":"keys","comment":"Returns a list containing all the keys available as subviews of the current views. This enumerates all the keys in *all* dictionaries matching the current view, in contrast to ``view.get(dict).keys()``, which gets all the keys for the *first* dict matching the view. If the object for this view in any source is not a dict, then a ConfigTypeError is raised. The keys are ordered according to how they appear in each source.","startLine":238,"endLine":263,"calleeNames":["resolve","keys","ConfigTypeError","format","type","append"]},"acm000001829jsd":{"type":"ControlElement","id":"acm000001829jsd","name":"items","comment":"Iterates over (key, subview) pairs contained in dictionaries from *all* sources at this view. If the object for this view in any source is not a dict, then a ConfigTypeError is raised.","startLine":265,"endLine":271,"calleeNames":["keys"]},"acm000001830jsd":{"type":"ControlElement","id":"acm000001830jsd","name":"values","comment":"Iterates over all the subviews contained in dictionaries from *all* sources at this view. If the object for this view in any source is not a dict, then a ConfigTypeError is raised.\nList/sequence emulation.","startLine":273,"endLine":279,"calleeNames":["keys"]},"acm000001831jsd":{"type":"ControlElement","id":"acm000001831jsd","name":"all_contents","comment":"Iterates over all subviews from collections at this view from *all* sources. If the object for this view in any source is not iterable, then a ConfigTypeError is raised. This method is intended to be used when the view indicates a list; this method will concatenate the contents of the list from all sources.\nValidation and conversion.","startLine":283,"endLine":300,"calleeNames":["resolve","iter","ConfigTypeError","format","type"]},"acm000001832jsd":{"type":"ControlElement","id":"acm000001832jsd","name":"get","comment":"Returns the canonical value for the view, checked against the passed-in type. If the value is not an instance of the given type, a ConfigTypeError is raised. May also raise a NotFoundError.","startLine":304,"endLine":323,"calleeNames":["first","isinstance","TypeError","ConfigTypeError","format","type"]},"acm000001833jsd":{"type":"ControlElement","id":"acm000001833jsd","name":"as_filename","comment":"Get a string as a normalized filename, made absolute and with tilde expanded. If the value comes from a default source, the path is considered relative to the application's config directory. If it comes from another file source, the filename is expanded as if it were relative to that directory. Otherwise, it is relative to the current working directory.","startLine":325,"endLine":348,"calleeNames":["first","isinstance","ConfigTypeError","format","type","expanduser","STRING","join","root","config_dir","dirname","abspath"]},"acm000001834jsd":{"type":"ControlElement","id":"acm000001834jsd","name":"as_choice","comment":"Ensure that the value is among a collection of choices and return it. If `choices` is a dictionary, then return the corresponding value rather than the value itself (the key).","startLine":350,"endLine":367,"calleeNames":["get","ConfigValueError","format","repr","list","isinstance"]},"acm000001835jsd":{"type":"ControlElement","id":"acm000001835jsd","name":"as_number","comment":"Ensure that a value is of numeric type.","startLine":369,"endLine":378,"calleeNames":["get","isinstance","ConfigTypeError","format","type"]},"acm000001836jsd":{"type":"ControlElement","id":"acm000001836jsd","name":"as_str_seq","comment":"Get the value as a list of strings. The underlying configured value can be a sequence or a single string. In the latter case, the string is treated as a white-space separated list of words.","startLine":380,"endLine":398,"calleeNames":["get","isinstance","decode","split","list","ConfigTypeError","format"]},"acm000001837jsd":{"type":"ClassUnit","id":"acm000001837jsd","name":"ConfigView","comment":"A configuration \"view\" is a query into a program's configuration data. A view represents a hypothetical location in the configuration tree; to extract the data from the location, a client typically calls the ``view.get()`` method. The client can access children in the tree (subviews) by subscripting the parent view (i.e., ``view[key]``).","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":135,"endLine":398,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001815jsd","acm000001816jsd","acm000001817jsd","acm000001818jsd","acm000001819jsd","acm000001820jsd","acm000001821jsd","acm000001822jsd","acm000001823jsd","acm000001824jsd","acm000001825jsd","acm000001826jsd","acm000001827jsd","acm000001828jsd","acm000001829jsd","acm000001830jsd","acm000001831jsd","acm000001832jsd","acm000001833jsd","acm000001834jsd","acm000001835jsd","acm000001836jsd"]},"acm000001838jsd":{"type":"ControlElement","id":"acm000001838jsd","name":"__init__","comment":"","startLine":83,"endLine":99,"calleeNames":["format","isinstance","super","__init__"]},"acm000001839jsd":{"type":"ControlElement","id":"acm000001839jsd","name":"add","comment":"Set the *default* value for this configuration view. The specified value is added as the lowest-priority configuration data source.","startLine":169,"endLine":174,"calleeNames":[]},"acm000001840jsd":{"type":"ControlElement","id":"acm000001840jsd","name":"set","comment":"*Override* the value for this configuration view. The specified value is added as the highest-priority configuration data source.","startLine":176,"endLine":181,"calleeNames":[]},"acm000001841jsd":{"type":"ControlElement","id":"acm000001841jsd","name":"resolve","comment":"The core (internal) data retrieval method. Generates (value, source) pairs for each source that contains a value for this view. May raise ConfigTypeError if a type error occurs while traversing a source.","startLine":149,"endLine":155,"calleeNames":[]},"acm000001842jsd":{"type":"ControlElement","id":"acm000001842jsd","name":"clear","comment":"Remove all sources from this configuration.","startLine":421,"endLine":423,"calleeNames":[]},"acm000001843jsd":{"type":"ControlElement","id":"acm000001843jsd","name":"root","comment":"The RootView object from which this view is descended.","startLine":183,"endLine":186,"calleeNames":[]},"acm000001844jsd":{"type":"ClassUnit","id":"acm000001844jsd","name":"RootView","comment":"The base of a view hierarchy. This view keeps track of the sources that may be accessed by subviews.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":400,"endLine":426,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001838jsd","acm000001839jsd","acm000001840jsd","acm000001841jsd","acm000001842jsd","acm000001843jsd"]},"acm000001845jsd":{"type":"ControlElement","id":"acm000001845jsd","name":"__init__","comment":"","startLine":83,"endLine":99,"calleeNames":["format","isinstance","super","__init__"]},"acm000001846jsd":{"type":"ControlElement","id":"acm000001846jsd","name":"resolve","comment":"The core (internal) data retrieval method. Generates (value, source) pairs for each source that contains a value for this view. May raise ConfigTypeError if a type error occurs while traversing a source.","startLine":149,"endLine":155,"calleeNames":[]},"acm000001847jsd":{"type":"ControlElement","id":"acm000001847jsd","name":"set","comment":"*Override* the value for this configuration view. The specified value is added as the highest-priority configuration data source.","startLine":176,"endLine":181,"calleeNames":[]},"acm000001848jsd":{"type":"ControlElement","id":"acm000001848jsd","name":"add","comment":"Set the *default* value for this configuration view. The specified value is added as the lowest-priority configuration data source.","startLine":169,"endLine":174,"calleeNames":[]},"acm000001849jsd":{"type":"ControlElement","id":"acm000001849jsd","name":"root","comment":"The RootView object from which this view is descended.","startLine":183,"endLine":186,"calleeNames":[]},"acm000001850jsd":{"type":"ClassUnit","id":"acm000001850jsd","name":"Subview","comment":"A subview accessed via a subscript of a parent view.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":428,"endLine":476,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001845jsd","acm000001846jsd","acm000001847jsd","acm000001848jsd","acm000001849jsd"]},"acm000001851jsd":{"type":"ControlElement","id":"acm000001851jsd","name":"_construct_unicode","comment":"Use ordered dictionaries for every YAML map.\nFrom https://gist.github.com/844388","startLine":537,"endLine":538,"calleeNames":["construct_scalar"]},"acm000001852jsd":{"type":"ControlElement","id":"acm000001852jsd","name":"construct_yaml_map","comment":"","startLine":542,"endLine":546,"calleeNames":["OrderedDict","construct_mapping","update"]},"acm000001853jsd":{"type":"ControlElement","id":"acm000001853jsd","name":"construct_mapping","comment":"","startLine":548,"endLine":571,"calleeNames":["isinstance","flatten_mapping","ConstructorError","OrderedDict","construct_object","hash"]},"acm000001854jsd":{"type":"ControlElement","id":"acm000001854jsd","name":"check_plain","comment":"","startLine":574,"endLine":576,"calleeNames":["super","check_plain","peek"]},"acm000001855jsd":{"type":"ClassUnit","id":"acm000001855jsd","name":"Loader","comment":"A customized YAML loader. This loader deviates from the official YAML spec in a few convenient ways: - All strings as are Unicode objects. - All maps are OrderedDicts. - Strings can begin with % without quotation.\nAll strings should be Unicode objects, regardless of contents.","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":528,"endLine":576,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001851jsd","acm000001852jsd","acm000001853jsd","acm000001854jsd"]},"acm000001856jsd":{"type":"ControlElement","id":"acm000001856jsd","name":"__init__","comment":"","startLine":83,"endLine":99,"calleeNames":["format","isinstance","super","__init__"]},"acm000001857jsd":{"type":"ControlElement","id":"acm000001857jsd","name":"_search_dirs","comment":"Yield directories that will be searched for configuration files for this application.\nApplication's environment variable.\nStandard configuration directories.","startLine":616,"endLine":627,"calleeNames":["abspath","expanduser","config_dirs","join"]},"acm000001858jsd":{"type":"ControlElement","id":"acm000001858jsd","name":"_user_sources","comment":"Generate `ConfigSource` objects for each user configuration file in the program's search directories.","startLine":629,"endLine":636,"calleeNames":["_search_dirs","join","isfile","ConfigSource","load_yaml"]},"acm000001859jsd":{"type":"ControlElement","id":"acm000001859jsd","name":"_default_source","comment":"Return the default-value source for this program or `None` if it does not exist.","startLine":638,"endLine":647,"calleeNames":["_package_path","join","isfile","ConfigSource","load_yaml"]},"acm000001860jsd":{"type":"ControlElement","id":"acm000001860jsd","name":"read","comment":"Find and read the files for this configuration and set them as the sources for this configuration. To disable either discovered user configuration files or the in-package defaults, set `user` or `defaults` to `False`.","startLine":649,"endLine":661,"calleeNames":["_user_sources","add","_default_source"]},"acm000001861jsd":{"type":"ControlElement","id":"acm000001861jsd","name":"config_dir","comment":"Get the path to the directory containing the highest-priority user configuration. If no user configuration is present, create a suitable directory before returning it.","startLine":663,"endLine":679,"calleeNames":["list","_search_dirs","isfile","join","isdir","makedirs"]},"acm000001862jsd":{"type":"ClassUnit","id":"acm000001862jsd","name":"Configuration","comment":"","compilationUnitId":"acm000001867jsd","parentDatatypeId":null,"startLine":595,"endLine":679,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001856jsd","acm000001857jsd","acm000001858jsd","acm000001859jsd","acm000001860jsd","acm000001861jsd"]},"acm000001863jsd":{"type":"ControlElement","id":"acm000001863jsd","name":"iter_first","comment":"Get the first element from an iterable or raise a ValueError if the iterator generates no values.","startLine":50,"endLine":61,"calleeNames":["iter","next","ValueError"]},"acm000001864jsd":{"type":"ControlElement","id":"acm000001864jsd","name":"_package_path","comment":"Returns the path to the package containing the named module or None if the path could not be identified (e.g., if ``name == \"__main__\"``).","startLine":483,"endLine":499,"calleeNames":["get_loader","hasattr","get_filename","__import__","dirname","abspath"]},"acm000001865jsd":{"type":"ControlElement","id":"acm000001865jsd","name":"config_dirs","comment":"Returns a list of user configuration directories to be searched.\nAssume Unix.\nExpand and deduplicate paths.","startLine":501,"endLine":523,"calleeNames":["system","insert","abspath","expanduser","append"]},"acm000001866jsd":{"type":"ControlElement","id":"acm000001866jsd","name":"load_yaml","comment":"Read a YAML document from a file. If the file cannot be read or parsed, a ConfigReadError is raised.\nMain interface.","startLine":582,"endLine":590,"calleeNames":["open","load","ConfigReadError"]},"acm000001867jsd":{"type":"CodeCompilationUnit","id":"acm000001867jsd","name":"confit","comment":"This file is part of Confit.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nWorry-free YAML configuration files.","parentId":"acm000001984jsd","content":["acm000001805jsd","acm000001806jsd","acm000001807jsd","acm000001808jsd","acm000001810jsd","acm000001814jsd","acm000001837jsd","acm000001844jsd","acm000001850jsd","acm000001855jsd","acm000001862jsd","acm000001863jsd","acm000001864jsd","acm000001865jsd","acm000001866jsd"],"pathElements":["util"],"extension":"py","language":"PYTHON3","importedModuleNames":["__future__.unicode_literals","platform","os","pkgutil","sys","yaml","types"]},"acm000001868jsd":{"type":"ControlElement","id":"acm000001868jsd","name":"__init__","comment":"Do nothing if no values are provided (i.e., with\nEnumerated itself).\nMay be called with a single string, in which case we split on\nwhitespace for convenience.","startLine":59,"endLine":80,"calleeNames":["super","__init__","isinstance","split","__setattr__","cls","len","append"]},"acm000001869jsd":{"type":"ControlElement","id":"acm000001869jsd","name":"__getattr__","comment":"","startLine":82,"endLine":87,"calleeNames":["AttributeError"]},"acm000001870jsd":{"type":"ControlElement","id":"acm000001870jsd","name":"__setattr__","comment":"","startLine":89,"endLine":90,"calleeNames":["TypeError"]},"acm000001871jsd":{"type":"ControlElement","id":"acm000001871jsd","name":"__getitem__","comment":"","startLine":92,"endLine":96,"calleeNames":["isinstance","getattr"]},"acm000001872jsd":{"type":"ControlElement","id":"acm000001872jsd","name":"__len__","comment":"","startLine":98,"endLine":99,"calleeNames":["len"]},"acm000001873jsd":{"type":"ControlElement","id":"acm000001873jsd","name":"__iter__","comment":"","startLine":101,"endLine":102,"calleeNames":["iter"]},"acm000001874jsd":{"type":"ControlElement","id":"acm000001874jsd","name":"__nonzero__","comment":"Ensures that __len__ doesn't get called before __init__ by\npydoc.","startLine":104,"endLine":107,"calleeNames":[]},"acm000001875jsd":{"type":"ClassUnit","id":"acm000001875jsd","name":"Enumeration","comment":"A metaclass whose classes are enumerations. The `values` attribute of the class is used to populate the enumeration. Values may either be a list of enumerated names or a string containing a space-separated list of names. When the class is created, it is instantiated for each name value in `values`. Each such instance is the name of the enumerated item as the sole argument. The `Enumerated` class is a good choice for a superclass.","compilationUnitId":"acm000001882jsd","parentDatatypeId":null,"startLine":46,"endLine":107,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001868jsd","acm000001869jsd","acm000001870jsd","acm000001871jsd","acm000001872jsd","acm000001873jsd","acm000001874jsd"]},"acm000001876jsd":{"type":"ControlElement","id":"acm000001876jsd","name":"__init__","comment":"Do nothing if no values are provided (i.e., with\nEnumerated itself).\nMay be called with a single string, in which case we split on\nwhitespace for convenience.","startLine":59,"endLine":80,"calleeNames":["super","__init__","isinstance","split","__setattr__","cls","len","append"]},"acm000001877jsd":{"type":"ControlElement","id":"acm000001877jsd","name":"__str__","comment":"","startLine":135,"endLine":136,"calleeNames":["type"]},"acm000001878jsd":{"type":"ControlElement","id":"acm000001878jsd","name":"__repr__","comment":"","startLine":138,"endLine":139,"calleeNames":["str"]},"acm000001879jsd":{"type":"ControlElement","id":"acm000001879jsd","name":"__cmp__","comment":"Note that we're assuming that the items are direct\ninstances of the same Enumeration (i.e., no fancy\nsubclassing), which is probably okay.","startLine":141,"endLine":148,"calleeNames":["type","cmp"]},"acm000001880jsd":{"type":"ClassUnit","id":"acm000001880jsd","name":"Enumerated","comment":"An item in an enumeration. Contains instance methods inherited by enumerated objects. The metaclass is preset to `Enumeration` for your convenience. Instance attributes: name -- The name of the item. index -- The index of the item in its enumeration. >>> from enumeration import Enumerated >>> class Garment(Enumerated): ... values = 'hat glove belt poncho lederhosen suspenders' ... def wear(self): ... print('now wearing a ' + self.name) ... >>> Garment.poncho.wear() now wearing a poncho","compilationUnitId":"acm000001882jsd","parentDatatypeId":null,"startLine":109,"endLine":148,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001876jsd","acm000001877jsd","acm000001878jsd","acm000001879jsd"]},"acm000001881jsd":{"type":"ControlElement","id":"acm000001881jsd","name":"enum","comment":"Shorthand for creating a new Enumeration class. Call with enumeration values as a list, a space-delimited string, or just an argument list. To give the class a name, pass it as the `name` keyword argument. Otherwise, a name will be chosen for you. The following are all equivalent: enum('pinkie ring middle index thumb') enum('pinkie', 'ring', 'middle', 'index', 'thumb') enum(['pinkie', 'ring', 'middle', 'index', 'thumb'])\nCreate a probably-unique name. It doesn't really have to be\nunique, but getting distinct names each time helps with\nidentification in debugging.\nIf there's only one value, we have a couple of alternate calling\nstyles.","startLine":150,"endLine":178,"calleeNames":["hex","upper","randint","len","isinstance","hasattr","type"]},"acm000001882jsd":{"type":"CodeCompilationUnit","id":"acm000001882jsd","name":"enumeration","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nA metaclass for enumerated types that really are types. You can create enumerations with `enum(values, [name])` and they work how you would expect them to. >>> from enumeration import enum >>> Direction = enum('north east south west', name='Direction') >>> Direction.west Direction.west >>> Direction.west == Direction.west True >>> Direction.west == Direction.east False >>> isinstance(Direction.west, Direction) True >>> Direction[3] Direction.west >>> Direction['west'] Direction.west >>> Direction.west.name 'west' >>> Direction.north < Direction.west True Enumerations are classes; their instances represent the possible values of the enumeration. Because Python classes must have names, you may provide a `name` parameter to `enum`; if you don't, a meaningless one will be chosen for you.","parentId":"acm000001984jsd","content":["acm000001875jsd","acm000001880jsd","acm000001881jsd"],"pathElements":["util"],"extension":"py","language":"PYTHON3","importedModuleNames":["random"]},"acm000001883jsd":{"type":"ControlElement","id":"acm000001883jsd","name":"__init__","comment":"","startLine":49,"endLine":51,"calleeNames":[]},"acm000001884jsd":{"type":"ClassUnit","id":"acm000001884jsd","name":"Environment","comment":"Contains the values and functions to be substituted into a template.","compilationUnitId":"acm000001921jsd","parentDatatypeId":null,"startLine":45,"endLine":51,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001883jsd"]},"acm000001885jsd":{"type":"ControlElement","id":"acm000001885jsd","name":"__init__","comment":"","startLine":49,"endLine":51,"calleeNames":[]},"acm000001886jsd":{"type":"ControlElement","id":"acm000001886jsd","name":"__repr__","comment":"","startLine":141,"endLine":142,"calleeNames":["repr"]},"acm000001887jsd":{"type":"ControlElement","id":"acm000001887jsd","name":"evaluate","comment":"Evaluate the symbol in the environment, returning a Unicode string.\nSubstitute for a value.\nKeep original text.","startLine":144,"endLine":153,"calleeNames":[]},"acm000001888jsd":{"type":"ControlElement","id":"acm000001888jsd","name":"translate","comment":"Compile the variable lookup.","startLine":155,"endLine":158,"calleeNames":["ex_rvalue","encode","set"]},"acm000001889jsd":{"type":"ClassUnit","id":"acm000001889jsd","name":"Symbol","comment":"A variable-substitution symbol in a template.","compilationUnitId":"acm000001921jsd","parentDatatypeId":null,"startLine":135,"endLine":158,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001885jsd","acm000001886jsd","acm000001887jsd","acm000001888jsd"]},"acm000001890jsd":{"type":"ControlElement","id":"acm000001890jsd","name":"__init__","comment":"","startLine":49,"endLine":51,"calleeNames":[]},"acm000001891jsd":{"type":"ControlElement","id":"acm000001891jsd","name":"__repr__","comment":"","startLine":141,"endLine":142,"calleeNames":["repr"]},"acm000001892jsd":{"type":"ControlElement","id":"acm000001892jsd","name":"evaluate","comment":"Evaluate the symbol in the environment, returning a Unicode string.\nSubstitute for a value.\nKeep original text.","startLine":144,"endLine":153,"calleeNames":[]},"acm000001893jsd":{"type":"ControlElement","id":"acm000001893jsd","name":"translate","comment":"Compile the variable lookup.","startLine":155,"endLine":158,"calleeNames":["ex_rvalue","encode","set"]},"acm000001894jsd":{"type":"ClassUnit","id":"acm000001894jsd","name":"Call","comment":"A function call in a template.","compilationUnitId":"acm000001921jsd","parentDatatypeId":null,"startLine":160,"endLine":215,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001890jsd","acm000001891jsd","acm000001892jsd","acm000001893jsd"]},"acm000001895jsd":{"type":"ControlElement","id":"acm000001895jsd","name":"__init__","comment":"","startLine":49,"endLine":51,"calleeNames":[]},"acm000001896jsd":{"type":"ControlElement","id":"acm000001896jsd","name":"__repr__","comment":"","startLine":141,"endLine":142,"calleeNames":["repr"]},"acm000001897jsd":{"type":"ControlElement","id":"acm000001897jsd","name":"evaluate","comment":"Evaluate the symbol in the environment, returning a Unicode string.\nSubstitute for a value.\nKeep original text.","startLine":144,"endLine":153,"calleeNames":[]},"acm000001898jsd":{"type":"ControlElement","id":"acm000001898jsd","name":"translate","comment":"Compile the variable lookup.","startLine":155,"endLine":158,"calleeNames":["ex_rvalue","encode","set"]},"acm000001899jsd":{"type":"ClassUnit","id":"acm000001899jsd","name":"Expression","comment":"Top-level template construct: contains a list of text blobs, Symbols, and Calls.","compilationUnitId":"acm000001921jsd","parentDatatypeId":null,"startLine":217,"endLine":254,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001895jsd","acm000001896jsd","acm000001897jsd","acm000001898jsd"]},"acm000001900jsd":{"type":"ClassUnit","id":"acm000001900jsd","name":"ParseError","comment":"","compilationUnitId":"acm000001921jsd","parentDatatypeId":null,"startLine":259,"endLine":260,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001901jsd":{"type":"ControlElement","id":"acm000001901jsd","name":"__init__","comment":"","startLine":49,"endLine":51,"calleeNames":[]},"acm000001902jsd":{"type":"ControlElement","id":"acm000001902jsd","name":"parse_expression","comment":"Parse a template expression starting at ``pos``. Resulting components (Unicode strings, Symbols, and Calls) are added to the ``parts`` field, a list. The ``pos`` field is updated to be the next character after the expression.","startLine":286,"endLine":352,"calleeNames":["len","search","start","append","join","parse_symbol","parse_call"]},"acm000001903jsd":{"type":"ControlElement","id":"acm000001903jsd","name":"parse_symbol","comment":"Parse a variable reference (like ``$foo`` or ``${foo}``) starting at ``pos``. Possibly appends a Symbol object (or, failing that, text) to the ``parts`` field and updates ``pos``. The character at ``pos`` must, as a precondition, be ``$``.\nLast character.","startLine":354,"endLine":396,"calleeNames":["len","append","find","Symbol","_parse_ident"]},"acm000001904jsd":{"type":"ControlElement","id":"acm000001904jsd","name":"parse_call","comment":"Parse a function call (like ``%foo{bar,baz}``) starting at ``pos``. Possibly appends a Call object to ``parts`` and update ``pos``. The character at ``pos`` must be ``%``.","startLine":398,"endLine":435,"calleeNames":["len","_parse_ident","append","parse_argument_list","Call"]},"acm000001905jsd":{"type":"ControlElement","id":"acm000001905jsd","name":"parse_argument_list","comment":"Parse a list of arguments starting at ``pos``, returning a list of Expression objects. Does not modify ``parts``. Should leave ``pos`` pointing to a } character or the end of the string.\nTry to parse a subexpression in a subparser.","startLine":437,"endLine":464,"calleeNames":["len","Parser","parse_expression","append","Expression"]},"acm000001906jsd":{"type":"ControlElement","id":"acm000001906jsd","name":"_parse_ident","comment":"Parse an identifier and return it (possibly an empty string). Updates ``pos``.","startLine":466,"endLine":473,"calleeNames":["group","len"]},"acm000001907jsd":{"type":"ClassUnit","id":"acm000001907jsd","name":"Parser","comment":"Parses a template expression string. Instantiate the class with the template source and call ``parse_expression``. The ``pos`` field will indicate the character after the expression finished and ``parts`` will contain a list of Unicode strings, Symbols, and Calls reflecting the concatenated portions of the expression. This is a terrible, ad-hoc parser implementation based on a left-to-right scan with no lexing step to speak of; it's probably both inefficient and incorrect. Maybe this should eventually be replaced with a real, accepted parsing technique (PEG, parser generator, etc.).","compilationUnitId":"acm000001921jsd","parentDatatypeId":null,"startLine":262,"endLine":473,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001901jsd","acm000001902jsd","acm000001903jsd","acm000001904jsd","acm000001905jsd","acm000001906jsd"]},"acm000001908jsd":{"type":"ControlElement","id":"acm000001908jsd","name":"__init__","comment":"","startLine":49,"endLine":51,"calleeNames":[]},"acm000001909jsd":{"type":"ControlElement","id":"acm000001909jsd","name":"__eq__","comment":"","startLine":499,"endLine":500,"calleeNames":[]},"acm000001910jsd":{"type":"ControlElement","id":"acm000001910jsd","name":"interpret","comment":"Like `substitute`, but forces the interpreter (rather than the compiled version) to be used. The interpreter includes exception-handling code for missing variables and buggy template functions but is much slower.","startLine":502,"endLine":508,"calleeNames":["evaluate","Environment"]},"acm000001911jsd":{"type":"ControlElement","id":"acm000001911jsd","name":"substitute","comment":"Evaluate the template given the values and functions.\nHandle any exceptions thrown by compiled version.","startLine":510,"endLine":517,"calleeNames":["compiled","interpret"]},"acm000001912jsd":{"type":"ControlElement","id":"acm000001912jsd","name":"translate","comment":"Compile the variable lookup.","startLine":155,"endLine":158,"calleeNames":["ex_rvalue","encode","set"]},"acm000001913jsd":{"type":"ClassUnit","id":"acm000001913jsd","name":"Template","comment":"A string template, including text, Symbols, and Calls.","compilationUnitId":"acm000001921jsd","parentDatatypeId":null,"startLine":491,"endLine":543,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001908jsd","acm000001909jsd","acm000001910jsd","acm000001911jsd","acm000001912jsd"]},"acm000001914jsd":{"type":"ControlElement","id":"acm000001914jsd","name":"ex_lvalue","comment":"A variable load expression.","startLine":56,"endLine":58,"calleeNames":["Name","Store"]},"acm000001915jsd":{"type":"ControlElement","id":"acm000001915jsd","name":"ex_rvalue","comment":"A variable store expression.","startLine":60,"endLine":62,"calleeNames":["Name","Load"]},"acm000001916jsd":{"type":"ControlElement","id":"acm000001916jsd","name":"ex_literal","comment":"An int, float, long, bool, string, or None literal with the given value.","startLine":64,"endLine":76,"calleeNames":["Name","Load","isinstance","Num","str","Str","TypeError","format","type"]},"acm000001917jsd":{"type":"ControlElement","id":"acm000001917jsd","name":"ex_varassign","comment":"Assign an expression into a single variable. The expression may either be an `ast.expr` object or a value to be used as a literal.","startLine":78,"endLine":84,"calleeNames":["isinstance","ex_literal","Assign","ex_lvalue"]},"acm000001918jsd":{"type":"ControlElement","id":"acm000001918jsd","name":"ex_call","comment":"A function-call expression with only positional parameters. The function may be an expression or the name of a function. Each argument may be an expression or a value to be used as a literal.","startLine":86,"endLine":99,"calleeNames":["isinstance","ex_rvalue","list","range","len","ex_literal","Call"]},"acm000001919jsd":{"type":"ControlElement","id":"acm000001919jsd","name":"compile_func","comment":"Compile a list of statements as the body of a function and return the resulting Python function. If `debug`, then print out the bytecode of the compiled function.","startLine":101,"endLine":130,"calleeNames":["FunctionDef","arguments","Name","Param","ex_literal","Module","fix_missing_locations","compile","dis","isinstance"]},"acm000001920jsd":{"type":"ControlElement","id":"acm000001920jsd","name":"_parse","comment":"Parse a top-level template string Expression. Any extraneous text is considered literal text.","startLine":475,"endLine":486,"calleeNames":["Parser","parse_expression","append","Expression"]},"acm000001921jsd":{"type":"CodeCompilationUnit","id":"acm000001921jsd","name":"functemplate","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nThis module implements a string formatter based on the standard PEP 292 string.Template class extended with function calls. Variables, as with string.Template, are indicated with $ and functions are delimited with %. This module assumes that everything is Unicode: the template and the substitution values. Bytestrings are not supported. Also, the templates always behave like the ``safe_substitute`` method in the standard library: unknown symbols are left intact. This is sort of like a tiny, horrible degeneration of a real templating engine like Jinja2 or Mustache.","parentId":"acm000001984jsd","content":["acm000001884jsd","acm000001889jsd","acm000001894jsd","acm000001899jsd","acm000001900jsd","acm000001907jsd","acm000001913jsd","acm000001914jsd","acm000001915jsd","acm000001916jsd","acm000001917jsd","acm000001918jsd","acm000001919jsd","acm000001920jsd"],"pathElements":["util"],"extension":"py","language":"PYTHON3","importedModuleNames":["__future__.print_function","re","ast","dis","types"]},"acm000001922jsd":{"type":"ControlElement","id":"acm000001922jsd","name":"__init__","comment":"","startLine":78,"endLine":81,"calleeNames":["__init__"]},"acm000001923jsd":{"type":"ControlElement","id":"acm000001923jsd","name":"acquire","comment":"Indicate that a thread will start putting into this queue. Should not be called after the queue is already poisoned.","startLine":83,"endLine":90,"calleeNames":[]},"acm000001924jsd":{"type":"ControlElement","id":"acm000001924jsd","name":"release","comment":"Indicate that a thread that was putting into this queue has exited. If this is the last thread using the queue, the queue is poisoned.\nAll threads are done adding to this queue. Poison it\nwhen it becomes empty.\nReplacement _get invalidates when no items remain.\nItems remain.\nNo items. Invalidate immediately.","startLine":92,"endLine":118,"calleeNames":["_old_get","_invalidate_queue"]},"acm000001925jsd":{"type":"ClassUnit","id":"acm000001925jsd","name":"CountedQueue","comment":"A queue that keeps track of the number of threads that are still feeding into it. The queue is poisoned when all threads are finished with the queue.","compilationUnitId":"acm000001948jsd","parentDatatypeId":null,"startLine":73,"endLine":118,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001922jsd","acm000001923jsd","acm000001924jsd"]},"acm000001926jsd":{"type":"ControlElement","id":"acm000001926jsd","name":"__init__","comment":"","startLine":78,"endLine":81,"calleeNames":["__init__"]},"acm000001927jsd":{"type":"ClassUnit","id":"acm000001927jsd","name":"MultiMessage","comment":"A message yielded by a pipeline stage encapsulating multiple values to be sent to the next stage.","compilationUnitId":"acm000001948jsd","parentDatatypeId":null,"startLine":120,"endLine":125,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001926jsd"]},"acm000001928jsd":{"type":"ControlElement","id":"acm000001928jsd","name":"__init__","comment":"","startLine":78,"endLine":81,"calleeNames":["__init__"]},"acm000001929jsd":{"type":"ControlElement","id":"acm000001929jsd","name":"abort","comment":"Shut down the thread at the next chance possible.\nEnsure that we are not blocking on a queue read or write.","startLine":153,"endLine":163,"calleeNames":["hasattr","_invalidate_queue"]},"acm000001930jsd":{"type":"ControlElement","id":"acm000001930jsd","name":"abort_all","comment":"Abort all other threads in the system for an exception.","startLine":165,"endLine":170,"calleeNames":["abort"]},"acm000001931jsd":{"type":"ClassUnit","id":"acm000001931jsd","name":"PipelineThread","comment":"Abstract base class for pipeline-stage threads.","compilationUnitId":"acm000001948jsd","parentDatatypeId":null,"startLine":144,"endLine":170,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001928jsd","acm000001929jsd","acm000001930jsd"]},"acm000001932jsd":{"type":"ControlElement","id":"acm000001932jsd","name":"__init__","comment":"","startLine":78,"endLine":81,"calleeNames":["__init__"]},"acm000001933jsd":{"type":"ControlElement","id":"acm000001933jsd","name":"run","comment":"Get the value from the generator.\nSend messages to the next stage.\nGenerator finished; shut down the pipeline.","startLine":185,"endLine":210,"calleeNames":["next","_allmsgs","put","abort_all","exc_info","release"]},"acm000001934jsd":{"type":"ClassUnit","id":"acm000001934jsd","name":"FirstPipelineThread","comment":"The thread running the first stage in a parallel pipeline setup. The coroutine should just be a generator.","compilationUnitId":"acm000001948jsd","parentDatatypeId":null,"startLine":172,"endLine":210,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001932jsd","acm000001933jsd"]},"acm000001935jsd":{"type":"ControlElement","id":"acm000001935jsd","name":"__init__","comment":"","startLine":78,"endLine":81,"calleeNames":["__init__"]},"acm000001936jsd":{"type":"ControlElement","id":"acm000001936jsd","name":"run","comment":"Get the value from the generator.\nSend messages to the next stage.\nGenerator finished; shut down the pipeline.","startLine":185,"endLine":210,"calleeNames":["next","_allmsgs","put","abort_all","exc_info","release"]},"acm000001937jsd":{"type":"ClassUnit","id":"acm000001937jsd","name":"MiddlePipelineThread","comment":"A thread running any stage in the pipeline except the first or last.","compilationUnitId":"acm000001948jsd","parentDatatypeId":null,"startLine":212,"endLine":257,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001935jsd","acm000001936jsd"]},"acm000001938jsd":{"type":"ControlElement","id":"acm000001938jsd","name":"__init__","comment":"","startLine":78,"endLine":81,"calleeNames":["__init__"]},"acm000001939jsd":{"type":"ControlElement","id":"acm000001939jsd","name":"run","comment":"Get the value from the generator.\nSend messages to the next stage.\nGenerator finished; shut down the pipeline.","startLine":185,"endLine":210,"calleeNames":["next","_allmsgs","put","abort_all","exc_info","release"]},"acm000001940jsd":{"type":"ClassUnit","id":"acm000001940jsd","name":"LastPipelineThread","comment":"A thread running the last stage in a pipeline. The coroutine should yield nothing.","compilationUnitId":"acm000001948jsd","parentDatatypeId":null,"startLine":259,"endLine":292,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001938jsd","acm000001939jsd"]},"acm000001941jsd":{"type":"ControlElement","id":"acm000001941jsd","name":"__init__","comment":"","startLine":78,"endLine":81,"calleeNames":["__init__"]},"acm000001942jsd":{"type":"ControlElement","id":"acm000001942jsd","name":"run_sequential","comment":"Run the pipeline sequentially in the current thread. The stages are run one after the other. Only the first coroutine in each stage is used.","startLine":313,"endLine":332,"calleeNames":["next","_allmsgs","send","extend"]},"acm000001943jsd":{"type":"ControlElement","id":"acm000001943jsd","name":"run_parallel","comment":"Run the pipeline in parallel using one thread per stage. The messages between the stages are stored in queues of the given size.","startLine":334,"endLine":387,"calleeNames":["CountedQueue","range","len","append","FirstPipelineThread","MiddlePipelineThread","LastPipelineThread","start","isAlive","join","abort"]},"acm000001944jsd":{"type":"ClassUnit","id":"acm000001944jsd","name":"Pipeline","comment":"Represents a staged pattern of work. Each stage in the pipeline is a coroutine that receives messages from the previous stage and yields messages to be sent to the next stage.","compilationUnitId":"acm000001948jsd","parentDatatypeId":null,"startLine":294,"endLine":387,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001941jsd","acm000001942jsd","acm000001943jsd"]},"acm000001945jsd":{"type":"ControlElement","id":"acm000001945jsd","name":"_invalidate_queue","comment":"Breaks a Queue such that it never blocks, always has size 1, and has no maximum size. get()ing from the queue returns `val`, which defaults to None. `sync` controls whether a lock is required (because it's not reentrant!).","startLine":45,"endLine":71,"calleeNames":["acquire","notifyAll","release"]},"acm000001946jsd":{"type":"ControlElement","id":"acm000001946jsd","name":"multiple","comment":"Yield multiple([message, ..]) from a pipeline stage to send multiple values to the next pipeline stage.","startLine":126,"endLine":130,"calleeNames":["MultiMessage"]},"acm000001947jsd":{"type":"ControlElement","id":"acm000001947jsd","name":"_allmsgs","comment":"Returns a list of all the messages encapsulated in obj. If obj is a MultiMessage, returns its enclosed messages. If obj is BUBBLE, returns an empty list. Otherwise, returns a list containing obj.","startLine":132,"endLine":142,"calleeNames":["isinstance"]},"acm000001948jsd":{"type":"CodeCompilationUnit","id":"acm000001948jsd","name":"pipeline","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nSimple but robust implementation of generator/coroutine-based pipelines in Python. The pipelines may be run either sequentially (single-threaded) or in parallel (one thread per pipeline stage). This implementation supports pipeline bubbles (indications that the processing for a certain item should abort). To use them, yield the BUBBLE constant from any stage coroutine except the last. In the parallel case, the implementation transparently handles thread shutdown when the processing is complete and when a stage raises an exception. KeyboardInterrupts (^C) are also handled. When running a parallel pipeline, it is also possible to use multiple coroutines for the same pipeline stage; this lets you speed up a bottleneck stage by dividing its work among multiple threads. To do so, pass an iterable of coroutines to the Pipeline constructor in place of any single coroutine.","parentId":"acm000001984jsd","content":["acm000001925jsd","acm000001927jsd","acm000001931jsd","acm000001934jsd","acm000001937jsd","acm000001940jsd","acm000001944jsd","acm000001945jsd","acm000001946jsd","acm000001947jsd"],"pathElements":["util"],"extension":"py","language":"PYTHON3","importedModuleNames":["__future__.print_function","Queue","threading.Thread","threading.Lock","sys","types"]},"acm000001949jsd":{"type":"ControlElement","id":"acm000001949jsd","name":"__init__","comment":"","startLine":45,"endLine":49,"calleeNames":["super","__init__","get_message"]},"acm000001950jsd":{"type":"ControlElement","id":"acm000001950jsd","name":"_gerund","comment":"Generate a (likely) gerund form of the English verb.","startLine":51,"endLine":58,"calleeNames":["endswith"]},"acm000001951jsd":{"type":"ControlElement","id":"acm000001951jsd","name":"_reasonstr","comment":"Get the reason as a string.\nByte string.\ni.e., EnvironmentError","startLine":60,"endLine":69,"calleeNames":["isinstance","decode","hasattr","format","unicode"]},"acm000001952jsd":{"type":"ControlElement","id":"acm000001952jsd","name":"get_message","comment":"Create the human-readable description of the error, sans introduction.","startLine":71,"endLine":75,"calleeNames":[]},"acm000001953jsd":{"type":"ControlElement","id":"acm000001953jsd","name":"log","comment":"Log to the provided `logger` a human-readable message as an error and a verbose traceback as a debug message.","startLine":77,"endLine":83,"calleeNames":["debug","error","format"]},"acm000001954jsd":{"type":"ClassUnit","id":"acm000001954jsd","name":"HumanReadableException","comment":"An Exception that can include a human-readable error message to be logged without a traceback. Can preserve a traceback for debugging purposes as well. Has at least two fields: `reason`, the underlying exception or a string describing the problem; and `verb`, the action being performed during the error. If `tb` is provided, it is a string containing a traceback for the associated exception. (Note that this is not necessary in Python 3.x and should be removed when we make the transition.)","compilationUnitId":"acm000001983jsd","parentDatatypeId":null,"startLine":30,"endLine":83,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001949jsd","acm000001950jsd","acm000001951jsd","acm000001952jsd","acm000001953jsd"]},"acm000001955jsd":{"type":"ControlElement","id":"acm000001955jsd","name":"__init__","comment":"","startLine":45,"endLine":49,"calleeNames":["super","__init__","get_message"]},"acm000001956jsd":{"type":"ControlElement","id":"acm000001956jsd","name":"get_message","comment":"Create the human-readable description of the error, sans introduction.","startLine":71,"endLine":75,"calleeNames":[]},"acm000001957jsd":{"type":"ClassUnit","id":"acm000001957jsd","name":"FilesystemError","comment":"An error that occurred while performing a filesystem manipulation via a function in this module. The `paths` field is a sequence of pathnames involved in the operation.","compilationUnitId":"acm000001983jsd","parentDatatypeId":null,"startLine":85,"endLine":109,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001955jsd","acm000001956jsd"]},"acm000001958jsd":{"type":"ControlElement","id":"acm000001958jsd","name":"normpath","comment":"Provide the canonical form of the path suitable for storing in the database.","startLine":111,"endLine":117,"calleeNames":["syspath","normpath","abspath","expanduser","bytestring_path"]},"acm000001959jsd":{"type":"ControlElement","id":"acm000001959jsd","name":"ancestry","comment":"Return a list consisting of path's parent directory, its grandparent, and so on. For instance: >>> ancestry('/a/b/c') ['/', '/a', '/a/b'] The argument should *not* be the result of a call to `syspath`.","startLine":119,"endLine":140,"calleeNames":["dirname","insert"]},"acm000001960jsd":{"type":"ControlElement","id":"acm000001960jsd","name":"sorted_walk","comment":"Like `os.walk`, but yields things in case-insensitive sorted, breadth-first order. Directory and file names matching any glob pattern in `ignore` are skipped. If `logger` is provided, then warning messages are logged there when a directory cannot be listed.\nMake sure the path isn't a Unicode string.","startLine":142,"endLine":192,"calleeNames":["bytestring_path","listdir","syspath","print","bool","warn","format","displayable_path","fnmatch","join","isdir","append","sort","sorted_walk"]},"acm000001961jsd":{"type":"ControlElement","id":"acm000001961jsd","name":"mkdirall","comment":"Make all the enclosing directories of path (like mkdir -p on the parent).","startLine":194,"endLine":204,"calleeNames":["ancestry","isdir","syspath","mkdir","FilesystemError","format_exc"]},"acm000001962jsd":{"type":"ControlElement","id":"acm000001962jsd","name":"fnmatch_all","comment":"Determine whether all strings in `names` match at least one of the `patterns`, which should be shell glob expressions.","startLine":206,"endLine":218,"calleeNames":["fnmatch"]},"acm000001963jsd":{"type":"ControlElement","id":"acm000001963jsd","name":"prune_dirs","comment":"If path is an empty directory, then remove it. Recursively remove path's ancestry up to root (which is never removed) where there are empty directories. If path is not contained in root, then nothing is removed. Glob patterns in clutter are ignored when determining emptiness. If root is not provided, then only path may be removed (i.e., no recursive removal).","startLine":220,"endLine":258,"calleeNames":["normpath","ancestry","index","append","reverse","syspath","exists","fnmatch_all","listdir","rmtree"]},"acm000001964jsd":{"type":"ControlElement","id":"acm000001964jsd","name":"components","comment":"Return a list of the path components in path. For instance: >>> components('/a/b/c') ['a', 'b', 'c'] The argument should *not* be the result of a call to `syspath`.","startLine":260,"endLine":282,"calleeNames":["ancestry","basename","append"]},"acm000001965jsd":{"type":"ControlElement","id":"acm000001965jsd","name":"_fsencoding","comment":"Get the system's filesystem encoding. On Windows, this is always UTF-8 (not MBCS).","startLine":284,"endLine":296,"calleeNames":["getfilesystemencoding","getdefaultencoding"]},"acm000001966jsd":{"type":"ControlElement","id":"acm000001966jsd","name":"bytestring_path","comment":"Given a path, which is either a str or a unicode, returns a str path (ensuring that we never deal with Unicode pathnames).","startLine":298,"endLine":319,"calleeNames":["isinstance","startswith","len","encode","_fsencoding"]},"acm000001967jsd":{"type":"ControlElement","id":"acm000001967jsd","name":"displayable_path","comment":"Attempts to decode a bytestring path to a unicode object for the purpose of displaying it to the user. If the `path` argument is a list or a tuple, the elements are joined with `separator`.\nA non-string object: just get its unicode representation.","startLine":321,"endLine":337,"calleeNames":["isinstance","join","displayable_path","unicode","decode","_fsencoding"]},"acm000001968jsd":{"type":"ControlElement","id":"acm000001968jsd","name":"syspath","comment":"Convert a path for use by the operating system. In particular, paths on Windows must receive a magic prefix and must be converted to Unicode before they are sent to the OS. To disable the magic prefix on Windows, set `prefix` to False---but only do this if you *really* know what you're doing.","startLine":339,"endLine":369,"calleeNames":["isinstance","decode","getfilesystemencoding","getdefaultencoding","startswith"]},"acm000001969jsd":{"type":"ControlElement","id":"acm000001969jsd","name":"samefile","comment":"Safer equality for paths.","startLine":371,"endLine":373,"calleeNames":["_samefile","syspath"]},"acm000001970jsd":{"type":"ControlElement","id":"acm000001970jsd","name":"remove","comment":"Remove the file. If `soft`, then no error will be raised if the file does not exist.","startLine":375,"endLine":385,"calleeNames":["syspath","exists","remove","FilesystemError","format_exc"]},"acm000001971jsd":{"type":"ControlElement","id":"acm000001971jsd","name":"copy","comment":"Copy a plain file. Permissions are not copied. If `dest` already exists, raises a FilesystemError unless `replace` is True. Has no effect if `path` is the same as `dest`. Paths are translated to system paths before the syscall.","startLine":387,"endLine":403,"calleeNames":["samefile","syspath","exists","FilesystemError","copyfile","format_exc"]},"acm000001972jsd":{"type":"ControlElement","id":"acm000001972jsd","name":"move","comment":"Rename a file. `dest` may not be a directory. If `dest` already exists, raises an OSError unless `replace` is True. Has no effect if `path` is the same as `dest`. If the paths are on different filesystems (or the rename otherwise fails), a copy is attempted instead, in which case metadata will *not* be preserved. Paths are translated to system paths.","startLine":405,"endLine":431,"calleeNames":["samefile","syspath","exists","FilesystemError","format_exc","rename","copyfile","remove"]},"acm000001973jsd":{"type":"ControlElement","id":"acm000001973jsd","name":"unique_path","comment":"Returns a version of ``path`` that does not exist on the filesystem. Specifically, if ``path` itself already exists, then something unique is appended to the path.","startLine":433,"endLine":452,"calleeNames":["exists","syspath","splitext","search","int","group","start"]},"acm000001974jsd":{"type":"ControlElement","id":"acm000001974jsd","name":"sanitize_path","comment":"Takes a path (as a Unicode string) and makes sure that it is legal. Returns a new path. Only works with fragments; won't work reliably on Windows when a path begins with a drive letter. Path separators (including altsep!) should already be cleaned from the path components. If replacements is specified, it is used *instead* of the default set of replacements for the platform; it must be a list of (compiled regex, replacement string) pairs.","startLine":466,"endLine":488,"calleeNames":["list","components","enumerate","sub","join"]},"acm000001975jsd":{"type":"ControlElement","id":"acm000001975jsd","name":"truncate_path","comment":"Given a bytestring path or a Unicode path fragment, truncate the components to a legal length. In the last component, the extension is preserved.","startLine":490,"endLine":505,"calleeNames":["components","splitext","len","join"]},"acm000001976jsd":{"type":"ControlElement","id":"acm000001976jsd","name":"str2bool","comment":"Returns a boolean reflecting a human-entered string.","startLine":507,"endLine":512,"calleeNames":["lower"]},"acm000001977jsd":{"type":"ControlElement","id":"acm000001977jsd","name":"as_string","comment":"Convert a value to a Unicode object for matching with a query. None becomes the empty string. Bytestrings are silently decoded.","startLine":514,"endLine":525,"calleeNames":["isinstance","str","decode","unicode"]},"acm000001978jsd":{"type":"ControlElement","id":"acm000001978jsd","name":"levenshtein","comment":"A nice DP edit distance implementation from Wikibooks: http://en.wikibooks.org/wiki/Algorithm_implementation/Strings/ Levenshtein_distance#Python","startLine":527,"endLine":547,"calleeNames":["len","levenshtein","xrange","enumerate","append","min"]},"acm000001979jsd":{"type":"ControlElement","id":"acm000001979jsd","name":"plurality","comment":"Given a sequence of comparable objects, returns the object that is most common in the set and the frequency of that object. The sequence must contain at least one object.\nCalculate frequencies.","startLine":549,"endLine":570,"calleeNames":["defaultdict","ValueError","items"]},"acm000001980jsd":{"type":"ControlElement","id":"acm000001980jsd","name":"cpu_count","comment":"Return the number of hardware thread contexts (cores or SMT threads) in the system.\nAdapted from the soundconverter project:\nhttps://github.com/kassoulet/soundconverter","startLine":572,"endLine":596,"calleeNames":["int","popen","read","sysconf"]},"acm000001981jsd":{"type":"ControlElement","id":"acm000001981jsd","name":"command_output","comment":"Wraps the `subprocess` module to invoke a command (given as a list of arguments starting with the command name) and collect stdout. The stderr stream is ignored. May raise `subprocess.CalledProcessError` or an `OSError`. This replaces `subprocess.check_output`, which isn't available in Python 2.6 and which can have problems if lots of output is sent to stderr.","startLine":598,"endLine":613,"calleeNames":["open","Popen","communicate","CalledProcessError"]},"acm000001982jsd":{"type":"ControlElement","id":"acm000001982jsd","name":"max_filename_length","comment":"Attempt to determine the maximum filename length for the filesystem containing `path`. If it cannot be determined, return a predetermined fallback value.","startLine":615,"endLine":627,"calleeNames":["hasattr","statvfs"]},"acm000001983jsd":{"type":"CodeCompilationUnit","id":"acm000001983jsd","name":"__init__","comment":"This file is part of beets.\nCopyright 2013, Adrian Sampson.\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be\nincluded in all copies or substantial portions of the Software.\nMiscellaneous utility functions.","parentId":"acm000001984jsd","content":["acm000001954jsd","acm000001957jsd","acm000001958jsd","acm000001959jsd","acm000001960jsd","acm000001961jsd","acm000001962jsd","acm000001963jsd","acm000001964jsd","acm000001965jsd","acm000001966jsd","acm000001967jsd","acm000001968jsd","acm000001969jsd","acm000001970jsd","acm000001971jsd","acm000001972jsd","acm000001973jsd","acm000001974jsd","acm000001975jsd","acm000001976jsd","acm000001977jsd","acm000001978jsd","acm000001979jsd","acm000001980jsd","acm000001981jsd","acm000001982jsd"],"pathElements":["util"],"extension":"py","language":"PYTHON3","importedModuleNames":["__future__.division","os","sys","re","shutil","fnmatch","collections.defaultdict","traceback","subprocess"]},"acm000001984jsd":{"type":"CodePackage","id":"acm000001984jsd","name":"util","comment":"","parentId":null,"content":["acm000001738jsd","acm000001804jsd","acm000001867jsd","acm000001882jsd","acm000001921jsd","acm000001948jsd","acm000001983jsd"]}}},"content":["acm000001379jsd","acm000001643jsd","acm000001722jsd","acm000001984jsd"],"codeFiles":[{"id":"acm000001988jsd","name":"hooks","pathElements":["autotag"],"extension":"py","compilationUnitId":"acm000001348jsd"},{"id":"acm000001989jsd","name":"match","pathElements":["autotag"],"extension":"py","compilationUnitId":"acm000001360jsd"},{"id":"acm000001990jsd","name":"mb","pathElements":["autotag"],"extension":"py","compilationUnitId":"acm000001374jsd"},{"id":"acm000001991jsd","name":"__init__","pathElements":["autotag"],"extension":"py","compilationUnitId":"acm000001378jsd"},{"id":"acm000001992jsd","name":"importer","pathElements":[],"extension":"py","compilationUnitId":"acm000001429jsd"},{"id":"acm000001993jsd","name":"library","pathElements":[],"extension":"py","compilationUnitId":"acm000001571jsd"},{"id":"acm000001994jsd","name":"mediafile","pathElements":[],"extension":"py","compilationUnitId":"acm000001610jsd"},{"id":"acm000001995jsd","name":"plugins","pathElements":[],"extension":"py","compilationUnitId":"acm000001638jsd"},{"id":"acm000001996jsd","name":"vfs","pathElements":[],"extension":"py","compilationUnitId":"acm000001641jsd"},{"id":"acm000001997jsd","name":"__init__","pathElements":[],"extension":"py","compilationUnitId":"acm000001642jsd"},{"id":"acm000001998jsd","name":"commands","pathElements":["ui"],"extension":"py","compilationUnitId":"acm000001674jsd"},{"id":"acm000001999jsd","name":"migrate","pathElements":["ui"],"extension":"py","compilationUnitId":"acm000001689jsd"},{"id":"acm000002000jsd","name":"__init__","pathElements":["ui"],"extension":"py","compilationUnitId":"acm000001721jsd"},{"id":"acm000002001jsd","name":"artresizer","pathElements":["util"],"extension":"py","compilationUnitId":"acm000001738jsd"},{"id":"acm000002002jsd","name":"bluelet","pathElements":["util"],"extension":"py","compilationUnitId":"acm000001804jsd"},{"id":"acm000002003jsd","name":"confit","pathElements":["util"],"extension":"py","compilationUnitId":"acm000001867jsd"},{"id":"acm000002004jsd","name":"enumeration","pathElements":["util"],"extension":"py","compilationUnitId":"acm000001882jsd"},{"id":"acm000002005jsd","name":"functemplate","pathElements":["util"],"extension":"py","compilationUnitId":"acm000001921jsd"},{"id":"acm000002006jsd","name":"pipeline","pathElements":["util"],"extension":"py","compilationUnitId":"acm000001948jsd"},{"id":"acm000002007jsd","name":"__init__","pathElements":["util"],"extension":"py","compilationUnitId":"acm000001983jsd"},{"id":"acm000002008jsd","name":"config_default","pathElements":[],"extension":"yaml","compilationUnitId":null}]}