    {
      "id": "claim_e20fd95afa1748e3ab8e82b8da7cec9b",
      "statement": "Two Maven profiles control the build and are defined in the root POM and each module POM: the default `complete` profile (activeByDefault=true) builds everything including the test modules (root: core, inconsistency-detection, tlr), while the `deployment` profile restricts each tree to publishable modules, skips test compilation, and GPG-signs artifacts with the pinned KIT key; the root POM also carries a `deployment-parent` profile for the root POM itself.",
      "evidence": [
        {
          "resource": "repo://core/pom.xml#L138-L185",
          "version": "repo-lines-v1:sha256:d69637fab3f00a21f6d32b7d550263e1bc267f2aedd058266a1821029083771a:"
