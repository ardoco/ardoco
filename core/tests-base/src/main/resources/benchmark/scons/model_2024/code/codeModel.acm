are.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.","parentId":"acm000005002jsd","content":["acm000004699jsd","acm000004703jsd","acm000004710jsd","acm000004713jsd","acm000004722jsd","acm000004727jsd","acm000004729jsd","acm000004732jsd","acm000004734jsd","acm000004736jsd","acm000004738jsd","acm000004743jsd","acm000004749jsd","acm000004751jsd","acm000004755jsd","acm000004758jsd","acm000004820jsd","acm000004822jsd","acm000004823jsd"],"pathElements":["Node"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.compat","collections","re","unittest","typing.Optional","SCons.Errors","SCons.Node","SCons.Util","SCons.Util.sctyping.ExecutorType"]},"acm000004825jsd":{"type":"ControlElement","id":"acm000004825jsd","name":"str_to_node","comment":"","startLine":37,"endLine":38,"calleeNames":["ValueWithMemo"]},"acm000004826jsd":{"type":"ControlElement","id":"acm000004826jsd","name":"__getstate__","comment":"Return all fields that shall be pickled. Walk the slots in the class hierarchy and add those to the state dictionary. If a '__dict__' slot is available, copy all entries to the dictionary. Also include the version id, which is fixed for all instances of a class.","startLine":40,"endLine":59,"calleeNames":["getattr","copy","type","mro","hasattr"]},"acm000004827jsd":{"type":"ControlElement","id":"acm000004827jsd","name":"__setstate__","comment":"Restore the attributes from a pickled state.\nTODO check or discard version","startLine":61,"endLine":69,"calleeNames":["items","setattr"]},"acm000004828jsd":{"type":"ClassUnit","id":"acm000004828jsd","name":"ValueNodeInfo","comment":"","compilationUnitId":"acm000004843jsd","parentDatatypeId":null,"startLine":31,"endLine":69,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004825jsd","acm000004826jsd","acm000004827jsd"]},"acm000004829jsd":{"type":"ClassUnit","id":"acm000004829jsd","name":"ValueBuildInfo","comment":"","compilationUnitId":"acm000004843jsd","parentDatatypeId":null,"startLine":72,"endLine":74,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000004830jsd":{"type":"ControlElement","id":"acm000004830jsd","name":"__init__","comment":"","startLine":90,"endLine":103,"calleeNames":["super","__init__","str"]},"acm000004831jsd":{"type":"ControlElement","id":"acm000004831jsd","name":"str_for_display","comment":"","startLine":105,"endLine":106,"calleeNames":["repr"]},"acm000004832jsd":{"type":"ControlElement","id":"acm000004832jsd","name":"__str__","comment":"","startLine":108,"endLine":109,"calleeNames":["str"]},"acm000004833jsd":{"type":"ControlElement","id":"acm000004833jsd","name":"make_ready","comment":"","startLine":111,"endLine":112,"calleeNames":["get_csig"]},"acm000004834jsd":{"type":"ControlElement","id":"acm000004834jsd","name":"build","comment":"","startLine":114,"endLine":116,"calleeNames":["hasattr","build"]},"acm000004835jsd":{"type":"ControlElement","id":"acm000004835jsd","name":"is_under","comment":"Make Value nodes get built regardless of\nwhat directory scons was run from. Value nodes\nare outside the filesystem:","startLine":120,"endLine":124,"calleeNames":[]},"acm000004836jsd":{"type":"ControlElement","id":"acm000004836jsd","name":"write","comment":"Set the value of the node.","startLine":126,"endLine":128,"calleeNames":[]},"acm000004837jsd":{"type":"ControlElement","id":"acm000004837jsd","name":"read","comment":"Return the value. If necessary, the value is built.","startLine":130,"endLine":135,"calleeNames":["build","hasattr"]},"acm000004838jsd":{"type":"ControlElement","id":"acm000004838jsd","name":"get_text_contents","comment":"By the assumption that the node.built_value is a deterministic product of the sources, the contents of a Value are the concatenation of all the contents of its sources. As the value need not be built when get_contents() is called, we cannot use the actual node.built_value.\n##TODO: something reasonable about universal newlines","startLine":137,"endLine":148,"calleeNames":["str","children","get_csig"]},"acm000004839jsd":{"type":"ControlElement","id":"acm000004839jsd","name":"get_contents","comment":"Get contents for signature calculations.","startLine":150,"endLine":152,"calleeNames":["get_text_contents","encode"]},"acm000004840jsd":{"type":"ControlElement","id":"acm000004840jsd","name":"get_csig","comment":"Because we're a Python value node and don't have a real timestamp, we get to ignore the calculator and just use the value contents. Returns string. Ideally string of hex digits. (Not bytes)","startLine":154,"endLine":169,"calleeNames":["get_text_contents","get_ninfo"]},"acm000004841jsd":{"type":"ClassUnit","id":"acm000004841jsd","name":"Value","comment":"A Node class for values represented by Python expressions. Values are typically passed on the command line or generated by a script, but not from a file or some other source. .. versionchanged:: 4.0 the *name* parameter was added.","compilationUnitId":"acm000004843jsd","parentDatatypeId":null,"startLine":77,"endLine":169,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000004830jsd","acm000004831jsd","acm000004832jsd","acm000004833jsd","acm000004834jsd","acm000004835jsd","acm000004836jsd","acm000004837jsd","acm000004838jsd","acm000004839jsd","acm000004840jsd"]},"acm000004842jsd":{"type":"ControlElement","id":"acm000004842jsd","name":"ValueWithMemo","comment":"Memoized :class:`Value` node factory. .. versionchanged:: 4.0 the *name* parameter was added.\nNo current support for memoizing a value that needs to be built.\nNon-primitive types will hit this codepath.\nLocal Variables:\ntab-width:4\nindent-tabs-mode:nil\nEnd:\nvim: set expandtab tabstop=4 shiftwidth=4:","startLine":172,"endLine":195,"calleeNames":["Value","hash"]},"acm000004843jsd":{"type":"CodeCompilationUnit","id":"acm000004843jsd","name":"Python","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nPython nodes.","parentId":"acm000005002jsd","content":["acm000004828jsd","acm000004829jsd","acm000004841jsd","acm000004842jsd"],"pathElements":["Node"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.Node"]},"acm000004844jsd":{"type":"ControlElement","id":"acm000004844jsd","name":"test_Value","comment":"Test creating a Value() object","startLine":31,"endLine":46,"calleeNames":["Value"]},"acm000004845jsd":{"type":"ControlElement","id":"acm000004845jsd","name":"test_build","comment":"Test \"building\" a Value Node","startLine":48,"end