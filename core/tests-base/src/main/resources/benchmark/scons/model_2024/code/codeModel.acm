at's appropriate.","startLine":195,"endLine":228,"calleeNames":["next_task","prepare","needs_execute","execute","interrupted","BuildError","exception_set","failed","executed","postprocess","cleanup"]},"acm000005836jsd":{"type":"ControlElement","id":"acm000005836jsd","name":"_maybe_start_worker","comment":"","startLine":530,"endLine":533,"calleeNames":["len","_start_worker"]},"acm000005837jsd":{"type":"ControlElement","id":"acm000005837jsd","name":"_start_worker","comment":"","startLine":535,"endLine":540,"calleeNames":["_adjust_stack_size","trace_message","append","Worker","_restore_stack_size"]},"acm000005838jsd":{"type":"ControlElement","id":"acm000005838jsd","name":"_adjust_stack_size","comment":"Only print a warning if the stack size has been\nexplicitly set.","startLine":542,"endLine":557,"calleeNames":["stack_size","warn","str"]},"acm000005839jsd":{"type":"ControlElement","id":"acm000005839jsd","name":"_restore_stack_size","comment":"","startLine":559,"endLine":561,"calleeNames":["stack_size"]},"acm000005840jsd":{"type":"ControlElement","id":"acm000005840jsd","name":"_work","comment":"","startLine":563,"endLine":751,"calleeNames":["trace_message","wait","executed","interrupted","BuildError","exception_set","failed","postprocess","clear","next_task","prepare","needs_execute","notify","_maybe_start_worker","notify_all","execute","append"]},"acm000005841jsd":{"type":"ClassUnit","id":"acm000005841jsd","name":"NewParallel","comment":"","compilationUnitId":"acm000005842jsd","parentDatatypeId":null,"startLine":433,"endLine":751,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005814jsd","acm000005819jsd","acm000005824jsd","acm000005831jsd","acm000005832jsd","acm000005833jsd","acm000005834jsd","acm000005835jsd","acm000005836jsd","acm000005837jsd","acm000005838jsd","acm000005839jsd","acm000005840jsd"]},"acm000005842jsd":{"type":"CodeCompilationUnit","id":"acm000005842jsd","name":"Job","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nSerial and Parallel classes to execute build tasks. The Jobs class provides a higher level interface to start, stop, and wait on jobs.\nThe default stack size (in kilobytes) of the threads used to execute\njobs in parallel.\n\nWe use a stack size of 256 kilobytes. The default on some platforms\nis too large and prevents us from creating enough threads to fully\nparallelized the build. For example, the default stack size on linux\nis 8 MBytes.","parentId":"acm000006009jsd","content":["acm000005790jsd","acm000005796jsd","acm000005799jsd","acm000005804jsd","acm000005810jsd","acm000005813jsd","acm000005841jsd"],"pathElements":["Taskmaster"],"extension":"py","language":"PYTHON3","importedModuleNames":["SCons.compat","logging","os","queue","signal","sys","threading","enum.Enum","SCons.Errors","SCons.Warnings","SCons.Script.GetOption"]},"acm000005843jsd":{"type":"ControlElement","id":"acm000005843jsd","name":"acquire","comment":"","startLine":66,"endLine":67,"calleeNames":[]},"acm000005844jsd":{"type":"ControlElement","id":"acm000005844jsd","name":"release","comment":"","startLine":69,"endLine":70,"calleeNames":[]},"acm000005845jsd":{"type":"ClassUnit","id":"acm000005845jsd","name":"DummyLock","comment":"fake lock class to use if threads are not supported","compilationUnitId":"acm000005911jsd","parentDatatypeId":null,"startLine":64,"endLine":70,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005843jsd","acm000005844jsd"]},"acm000005846jsd":{"type":"ControlElement","id":"acm000005846jsd","name":"__str__","comment":"","startLine":75,"endLine":76,"calleeNames":[]},"acm000005847jsd":{"type":"ClassUnit","id":"acm000005847jsd","name":"NoThreadsException","comment":"raised by the ParallelTestCase if threads are not supported","compilationUnitId":"acm000005911jsd","parentDatatypeId":null,"startLine":72,"endLine":76,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000005846jsd"]},"acm000005848jsd":{"type":"ControlElement","id":"acm000005848jsd","name":"__init__","comment":"","startLine":81,"endLine":85,"calleeNames":[]},"acm000005849jsd":{"type":"ControlElement","id":"acm000005849jsd","name":"prepare","comment":"","startLine":87,"endLine":88,"calleeNames":[]},"acm000005850jsd":{"type":"ControlElement","id":"acm000005850jsd","name":"_do_something","comment":"","startLine":90,"endLine":91,"calleeNames":[]},"acm000005851jsd":{"type":"ControlElement","id":"acm000005851jsd","name":"needs_execute","comment":"","startLine":93,"endLine":94,"calleeNames":[]},"acm000005852jsd":{"type":"ControlElement","id":"acm000005852jsd","name":"execute","comment":"while task is executing, represent this in the parallel_list\nand then turn it off","startLine":96,"endLine":120,"calleeNames":["assertTrue","acquire","append","release","_do_something","range"]},"acm000005853jsd":{"type":"ControlElement","id":"acm000005853