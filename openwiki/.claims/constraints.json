    {
      "id": "claim_0692d2850dcc44de989cb9e3f0e69086",
      "statement": "AbstractConfigurable implements the configuration contract: the final applyConfiguration(ImmutableSortedMap<String, String>) reflects over declared fields of the class hierarchy (stopping at Object/AbstractConfigurable, skipping levels marked @NoConfiguration), applies values for matching keys, delegates the same map to internal child objects, and stores it as lastAppliedConfiguration. Keys default to <SimpleClassName>::<fieldName> (:: connector), can be overridden via @Configurable(key=...), and with @ChildClassConfigurable use the concrete subclass name so inherited fields are configurable per subclass (combining @ChildClassConfigurable with an explicit key throws). Supported field types are Integer, Double, Boolean, enums, and List<String> (comma-separated); unsupported types are logged as errors and the field keeps its default.",
      "evidence": [
        {
          "resource": "repo://core/framework/common/src/main/java/edu/kit/kastel/mcse/ardoco/core/configuration/AbstractConfigurable.java#L41-L100",
