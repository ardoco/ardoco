BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nTest Windows SDK functions for Microsoft Visual C/C++.","parentId":"acm000001678jsd","content":["acm000001662jsd","acm000001673jsd"],"pathElements":["Tool","MSCommon","MSVC"],"extension":"py","language":"PYTHON3","importedModuleNames":["unittest","SCons.Tool.MSCommon.MSVC.Config","SCons.Tool.MSCommon.MSVC.WinSDK","SCons.Tool.MSCommon.MSVC.Registry","SCons.Tool.MSCommon.MSVC.Exceptions.MSVCInternalError"]},"acm000001675jsd":{"type":"ControlElement","id":"acm000001675jsd","name":"_reset","comment":"","startLine":51,"endLine":52,"calleeNames":["reset"]},"acm000001676jsd":{"type":"ControlElement","id":"acm000001676jsd","name":"_verify","comment":"","startLine":54,"endLine":55,"calleeNames":["verify"]},"acm000001677jsd":{"type":"CodeCompilationUnit","id":"acm000001677jsd","name":"__init__","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nFunctions for Microsoft Visual C/C++. The _reset method is used to restore MSVC module data structures to their initial state for testing purposes. The _verify method is used as a sanity check that MSVC module data structures are internally consistent. Currently: * _reset is invoked from reset_installed_vcs in the vc module. * _verify is invoked from the last line in the vc module.\nnoqa: F401\nnoqa: F401\nnoqa: F401\nnoqa: F401\nnoqa: F401\nnoqa: F401\nnoqa: F401\nnoqa: F401\nnoqa: F401","parentId":"acm000001678jsd","content":["acm000001675jsd","acm000001676jsd"],"pathElements":["Tool","MSCommon","MSVC"],"extension":"py","language":"PYTHON3","importedModuleNames":["Exceptions","Config","Util","Registry","Kind","SetupEnvDefault","Policy","WinSDK","ScriptArguments","Dispatcher"]},"acm000001678jsd":{"type":"CodePackage","id":"acm000001678jsd","name":"MSVC","comment":"","parentId":"acm000001835jsd","content":["acm000001412jsd","acm000001426jsd","acm000001431jsd","acm000001449jsd","acm000001459jsd","acm000001479jsd","acm000001488jsd","acm000001505jsd","acm000001517jsd","acm000001526jsd","acm000001569jsd","acm000001594jsd","acm000001603jsd","acm000001616jsd","acm000001632jsd","acm000001636jsd","acm000001652jsd","acm000001674jsd","acm000001677jsd"]},"acm000001679jsd":{"type":"ControlElement","id":"acm000001679jsd","name":"__init__","comment":"","startLine":33,"endLine":35,"calleeNames":[]},"acm000001680jsd":{"type":"ClassUnit","id":"acm000001680jsd","name":"ArchDefinition","comment":"A class for defining architecture-specific settings and logic.","compilationUnitId":"acm000001681jsd","parentDatatypeId":null,"startLine":29,"endLine":35,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":["acm000001679jsd"]},"acm000001681jsd":{"type":"CodeCompilationUnit","id":"acm000001681jsd","name":"arch","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nMS compilers: Supported Windows chip architectures.","parentId":"acm000001835jsd","content":["acm000001680jsd"],"pathElements":["Tool","MSCommon"],"extension":"py","language":"PYTHON3","importedModuleNames":[]},"acm000001682jsd":{"type":"ClassUnit","id":"acm000001682jsd","name":"MSVCCacheInvalidWarning","comment":"SCONS_MSCOMMON_DEBUG is internal-use so undocumented:\nset to '-' to print to console, else set to filename to log to","compilationUnitId":"acm000001693jsd","parentDatatypeId":null,"startLine":40,"endLine":41,"extendedDataTypesIds":[],"implementedDataTypesIds":[],"datatypeReferencesIds":[],"content":[]},"acm000001683jsd":{"type":"ControlElement","id":"acm000001683jsd","name":"read_script_env_cache","comment":"fetch cached msvc env vars if requested, else return empty dict","startLine":170,"endLine":200,"calleeNames":["Path","is_file","FileLock","open","load","suppress","unlink","warn","debug","isinstance","tuple"]},"acm000001684jsd":{"type":"ControlElement","id":"acm000001684jsd","name":"write_script_env_cache","comment":"write out cache of msvc env vars if requested","startLine":203,"endLine":226,"calleeNames":["Path","FileLock","open","list","items","dump","suppress","unlink"]},"acm000001685jsd":{"type":"ControlElement","id":"acm000001685jsd","name":"is_win64","comment":"Return true if running on windows 64 bits. Works whether python itself runs in 64 bits or 32 bits.\nUnfortunately, python does not provide a useful way to determine\nif the underlying Windows OS is 32-bit or 64-bit. Worse, whether\nthe Python itself is 32-bit or 64-bit affects what it returns,\nso nothing in sys.* or os.* help.\nApparently the best solution is to use env vars that Windows\nsets. If PROCESSOR_ARCHITECTURE is not x86, then the python\nprocess is running in 64 bit mode (on a 64-bit OS, 64-bit\nhardware, obviously).\nIf this python is 32-bit but the OS is 64, Windows will set\nProgramW6432 and PROCESSOR_ARCHITEW6432 to non-null.\n(Checking for HKLM\\Software\\Wow6432Node in the registry doesn't\nwork, because some 32-bit installers create it.)\nI structured these tests to make it easy to add new ones or\nadd exceptions in the future, because this is a bit fragile.","startLine":232,"endLine":260,"calleeNames":["get"]},"acm000001686jsd":{"type":"ControlElement","id":"acm000001686jsd","name":"read_reg","comment":"","startLine":263,"endLine":264,"calleeNames":["RegGetValue"]},"acm000001687jsd":{"type":"ControlElement","id":"acm000001687jsd","name":"has_reg","comment":"Return True if the given key exists in HKEY_LOCAL_MACHINE.\nFunctions for fetching environment variable settings from batch files.","startLine":267,"endLine":274,"calleeNames":["RegOpenKeyEx"]},"acm000001688jsd":{"type":"ControlElement","id":"acm000001688jsd","name":"_force_vscmd_skip_sendtelemetry","comment":"","startLine":279,"endLine":287,"calleeNames":["debug"]},"acm000001689jsd":{"type":"ControlElement","id":"acm000001689jsd","name":"normalize_env","comment":"Given a dictionary representing a shell environment, add the variables from os.environ needed for the processing of .bat files; the keys are controlled by the keys argument. It also makes sure the environment values are correctly encoded. If force=True, then all of the key values that exist are copied into the returned dictionary. If force=false, values are only copied if the key does not already exist in the copied dictionary. Note: the environment is copied.","startLine":290,"endLine":335,"calleeNames":["items","deepcopy","join","get","debug"]},"acm000001690jsd":{"type":"ControlElement","id":"acm000001690jsd","name":"get_output","comment":"Parse the output of given bat file, with given args.\nCreate a blank environment, for use in launching the tools\nTODO: Hard-coded list of the variables that (may) need to be\nimported from os.environ[] for the chain of development batch\nfiles to execute correctly. One call to vcvars*.bat may\nend up running a dozen or more scripts, changes not only with\neach release but with what is installed at the time. We think\nin modern installations most are set along the way and don't\nneed to be picked from the env, but include these for safety's sake.\nAny VSCMD variables definitely are picked from the env and\ncontrol execution in interesting ways.\nNote these really should be unified - either controlled by vs.py,\nor synced with the the common_tools_var # settings in vs.py.","startLine":338,"endLine":406,"calleeNames":["Environment","normalize_env","_force_vscmd_skip_sendtelemetry","debug","scons_subproc_run","write","decode","OSError"]},"acm000001691jsd":{"type":"ControlElement","id":"acm000001691jsd","name":"parse_output","comment":"Parse output from running visual c++/studios vcvarsall.bat and running set To capture the values listed in keep\ndkeep is a dict associating key: path_list, where key is one item from\nkeep, and path_list the associated list of paths","startLine":420,"endLine":452,"calleeNames":["compile","group","split","strip","append","str","splitlines","items","match","add_env"]},"acm000001692jsd":{"type":"ControlElement","id":"acm000001692jsd","name":"get_pch_node","comment":"Get the actual PCH file node","startLine":454,"endLine":466,"calleeNames":["get","subst","is_String","File"]},"acm000001693jsd":{"type":"CodeCompilationUnit","id":"acm000001693jsd","name":"common","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nCommon helper functions for working with the Microsoft tool chain.","parentId":"acm000001835jsd","content":["acm000001682jsd","acm000001683jsd","acm000001684jsd","acm000001685jsd","acm000001686jsd","acm000001687jsd","acm000001688jsd","acm000001689jsd","acm000001690jsd","acm000001691jsd","acm000001692jsd"],"pathElements":["Tool","MSCommon"],"extension":"py","language":"PYTHON3","importedModuleNames":["copy","json","os","re","sys","contextlib.suppress","subprocess.DEVNULL","subprocess.PIPE","pathlib.Path","SCons.Util","SCons.Warnings"]},"acm000001694jsd":{"type":"ControlElement","id":"acm000001694jsd","name":"find_framework_root","comment":"XXX: find it from environment (FrameworkDir)","startLine":38,"endLine":51,"calleeNames":["read_reg","debug","exists"]},"acm000001695jsd":{"type":"ControlElement","id":"acm000001695jsd","name":"query_versions","comment":"","startLine":53,"endLine":76,"calleeNames":["find_framework_root","listdir","compile","match","split","sort"]},"acm000001696jsd":{"type":"CodeCompilationUnit","id":"acm000001696jsd","name":"netframework","comment":"MIT License\n\nCopyright The SCons Foundation\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software and associated documentation files (the\n\"Software\"), to deal in the Software without restriction, including\nwithout limitation the rights to use, copy, modify, merge, publish,\ndistribute, sublicense, and/or sell copies of the Software, and to\npermit persons to whom the Software is furnished to do so, subject to\nthe following conditions:\n\nThe above copyright notice and this permission notice shall be included\nin all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY\nKIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE\nWARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\nNONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\nLIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\nOF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\nWITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\nMS Compilers: .Net Framework support\nOriginal value recorded by dcournapeau","parentId":"acm000001835jsd","content":["acm000001694jsd","acm000001695js